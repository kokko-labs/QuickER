<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcOrderSample</RootNamespace>
    <!-- The samples mimic a consumer project, so they opt out of the repository's central package
         management (CPM) and keep their versions pinned inline (a real consumer project is not
         under QuickER's CPM) -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      To mimic a consumer project, this references NuGet packages only and never the QuickER projects themselves.
      The Microsoft.Data.Sqlite / SQLitePCLRaw versions match the pins used by src/QuickER.Runtime.Sqlite.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- SQLitePCLRaw, which Microsoft.Data.Sqlite brings in transitively, has a known vulnerability
         (GHSA-2m69-gcr7-jv3q), so the fixed version is referenced explicitly to override it -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the DDL to the output directory; the sample creates a file database from it at startup -->
    <None Include="../EcOrder.sql" Link="EcOrder.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

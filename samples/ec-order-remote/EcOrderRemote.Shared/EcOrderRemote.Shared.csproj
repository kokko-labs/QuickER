<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcOrderRemoteSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      利用者のプロジェクトを模すため、QuickER 本体プロジェクトへは参照せず NuGet パッケージのみを参照する。
      Microsoft.Data.Sqlite / SQLitePCLRaw のバージョンは src/QuickER.Runtime.Sqlite と同一のピンに揃える。
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Microsoft.Data.Sqlite 10.0.9 が推移的に持ち込む SQLitePCLRaw 2.1.11 には既知の脆弱性
         (GHSA-2m69-gcr7-jv3q) があるため、修正済みの 3.0.3 を明示参照して上書きする -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!--
      本体生成物のみをリンクする。Entity・SQLite 方言の QuickER 版 Repository・リモート面契約・HTTP クライアント・DI 拡張を含み、
      BCL＋上記 NuGet だけでコンパイルできる（クライアント／サーバー双方が共有する土台）。
      サーバー生成物（EcOrderRemote.RemoteServer.g.cs）はここではリンクしない。CLI は 2 ファイルを同一 out ディレクトリへ
      出力するが、サーバー実装は ASP.NET Core の FrameworkReference を必要とするため Server プロジェクト側でリンクする。
    -->
    <Compile Include="../Generated/EcOrderRemote.g.cs" Link="Generated/EcOrderRemote.g.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcOrderRemoteSample</RootNamespace>
    <!-- The samples mimic a consumer project, so they opt out of the repository's central package
         management (CPM) and keep their versions pinned inline (a real consumer project is not
         under QuickER's CPM) -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      To mimic a consumer project, this references NuGet packages only and never the QuickER projects themselves.
      The Microsoft.Data.Sqlite / SQLitePCLRaw versions match the pins used by src/QuickER.Runtime.Sqlite.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- SQLitePCLRaw, which Microsoft.Data.Sqlite brings in transitively, has a known vulnerability
         (GHSA-2m69-gcr7-jv3q), so the fixed version is referenced explicitly to override it -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Link the main generated file only. It holds the entities, the SQLite-dialect QuickER repositories, the remote
      contracts, the HTTP client and the DI extensions, and it compiles against the BCL plus the NuGet packages above
      (the foundation shared by both the client and the server).
      The server output (EcOrderRemote.RemoteServer.g.cs) is not linked here. The CLI writes both files into the same
      out directory, but the server implementation needs the ASP.NET Core FrameworkReference, so the Server project
      links it instead.
    -->
    <Compile Include="../Generated/EcOrderRemote.g.cs" Link="Generated/EcOrderRemote.g.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcOrderRemoteSample.Client</RootNamespace>
    <!-- The samples mimic a consumer project, so they opt out of the repository's central package management (CPM) (see the note in the Shared project) -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The client references only the shared main generated code (the remote contracts, the HTTP client implementation
      and the DI extensions). The HTTP client runs on the BCL HttpClient alone, so it depends neither on the server
      output nor on ASP.NET Core.
    -->
    <ProjectReference Include="../EcOrderRemote.Shared/EcOrderRemote.Shared.csproj" />
  </ItemGroup>
</Project>

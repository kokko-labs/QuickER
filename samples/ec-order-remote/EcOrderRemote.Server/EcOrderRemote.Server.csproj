<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcOrderRemoteSample.Server</RootNamespace>
    <!-- The samples mimic a consumer project, so they opt out of the repository's central package management (CPM) (see the note in the Shared project) -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the shared main generated code (entities, SQLite-dialect QuickER repositories, remote contracts, DI extensions) -->
    <ProjectReference Include="../EcOrderRemote.Shared/EcOrderRemote.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Link the server output. MapGeneratedRemoteEndpoints (Minimal API) needs the ASP.NET Core FrameworkReference,
      so only this project, which uses the Web SDK, links it (the Shared project does not).
    -->
    <Compile
      Include="../Generated/EcOrderRemote.RemoteServer.g.cs"
      Link="Generated/EcOrderRemote.RemoteServer.g.cs"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the DDL to the output directory; the sample creates a file database from it at startup -->
    <None
      Include="../EcOrderRemote.sql"
      Link="EcOrderRemote.sql"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>

###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# Scriban テンプレート（埋め込みリソース）は生成コードのバイト単位一致を保証するため、
# 改行コードを CRLF に固定する（チェックアウト環境による改行変換を防ぐ）。
###############################################################################
*.scriban text eol=crlf

###############################################################################
# ランタイムパッケージのチェックイン済み生成ソース（RuntimePackageSourceRenderer 出力）は、
# ドリフト検知がレンダラー出力（CRLF）とのバイト単位一致を前提とするため CRLF に固定する。
###############################################################################
src/QuickER.Runtime*/Runtime*.g.cs text eol=crlf

###############################################################################
# samples/ec-order のチェックイン済み生成物・図 JSON は、ドリフト検知が生成器出力
# （CRLF）とのバイト単位一致を前提とするため CRLF に固定する（チェックアウト環境の改行変換を防ぐ）。
###############################################################################
samples/ec-order/EcOrder.json text eol=crlf
samples/ec-order/EcOrder.sql text eol=crlf
samples/ec-order/EcOrderSample/Generated/EcOrder.g.cs text eol=crlf
samples/ec-order/EcOrderSample/Generated/EcOrder.g.md text eol=crlf
samples/ec-order/EcOrderSample/Generated/EcOrder.ja.g.md text eol=crlf

###############################################################################
# samples/ec-order-remote（3 階層構成サンプル）のチェックイン済み生成物・図 JSON も
# 同様にドリフト検知がバイト単位一致を前提とするため CRLF に固定する。
###############################################################################
samples/ec-order-remote/EcOrderRemote.json text eol=crlf
samples/ec-order-remote/EcOrderRemote.sql text eol=crlf
samples/ec-order-remote/Generated/EcOrderRemote.g.cs text eol=crlf
samples/ec-order-remote/Generated/EcOrderRemote.RemoteServer.g.cs text eol=crlf

###############################################################################
# ランタイム 6 パッケージの公開 API 面スナップショット（承認ファイル）は、リフレクションからの
# レンダリング結果（CRLF）との完全一致で判定するため CRLF に固定する。
###############################################################################
tests/QuickER.Tests/PublicApi/*.approved.txt text eol=crlf

###############################################################################
# チェックイン済みの生成物は GitHub 上で「生成コード」として扱う（linguist-generated）。
#
# 追跡下の *.g.cs は手書きコードの 2 倍以上の行数があり、テンプレートを 1 行変えた PR が
# 十数万行の差分に化けてレビューを実質不能にしていた。この属性を付けると GitHub の
# 差分表示で既定折りたたみになり、言語統計からも除外される。
# 属性が効くのは GitHub の表示だけで、Git の内容・ドリフト検知・ビルドには一切影響しない。
###############################################################################
tests/QuickER.Tests/GeneratedFixture/*.g.cs linguist-generated=true
src/QuickER.Runtime*/Runtime*.g.cs linguist-generated=true
samples/**/*.g.cs linguist-generated=true
samples/**/*.g.md linguist-generated=true

###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# diff behavior for common document formats
# 
# Convert binary document formats to text before diffing them. This feature
# is only available from the command line. Turn it on by uncommenting the 
# entries below.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain

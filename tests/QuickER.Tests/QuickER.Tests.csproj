<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickER.Cli\QuickER.Cli.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Document\QuickER.Document.csproj" />
    <ProjectReference Include="..\..\src\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\..\src\QuickER.CodeReverse.CSharp\QuickER.CodeReverse.CSharp.csproj" />
    <ProjectReference Include="..\..\src\QuickER.MySql\QuickER.MySql.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Oracle\QuickER.Oracle.csproj" />
    <ProjectReference Include="..\..\src\QuickER.PostgreSql\QuickER.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Sqlite\QuickER.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Mcp\QuickER.Mcp.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Mcp.Tools\QuickER.Mcp.Tools.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Gui\QuickER.Gui.csproj" />
    <!--
      配布ランタイム 6 パッケージ。公開 API 面のスナップショット検証（PublicApi/）が
      リフレクションで実アセンブリを読むためだけに参照する（プロダクションコードは参照しない）。
    -->
    <ProjectReference Include="..\..\src\QuickER.Runtime\QuickER.Runtime.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.SqlServer\QuickER.Runtime.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.Sqlite\QuickER.Runtime.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.EntityFrameworkCore\QuickER.Runtime.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.InMemory\QuickER.Runtime.InMemory.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.AspNetCore\QuickER.Runtime.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.Sync\QuickER.Runtime.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- 方言ランタイムテスト（PostgreSQL / MySQL / Oracle）用の EF Core プロバイダ -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <!-- SQLite 方言ランタイムテスト用の EF Core プロバイダ（インプロセス・Docker 不要） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <!--
      SSH.NET は Testcontainers の推移的依存（下限指定 [2025.1.0, )）だが、既定で解決される版には
      GHSA-q939-rpr3-3284（ScpClient の再帰ダウンロードにおけるパストラバーサル・High）がある。
      修正版（Directory.Packages.props）を直接参照して推移的解決を上書きし、NU1903 を発生源から消す
      （Testcontainers 側の要求は下限のみのため、上書きしても依存の整合は崩れない）。
    -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

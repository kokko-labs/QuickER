<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      テストホストをサーバー GC で動かす（runtimeconfig 経由で testhost に効く）。並列の全件実行では、生成コードのコンパイルと
      総当たりが大量に割り当て、既定のワークステーション GC だと CPU を余したまま GC の待ちで 2〜8 倍に伸びる。
      ソースの規則 test-host-server-gc が、この設定が残っていることを確かめる。
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!--
      テストを Microsoft.Testing.Platform（MTP）の実行ファイルとして作る（xunit.v3.mtp-v2 の入口はこの値で MTP になる）。
      dotnet test を MTP で動かす指定は global.json の test.runner。Integration も同じ形にする（混在すると dotnet test
      QuickER.slnx が VSTest のプロジェクトを黙って飛ばす）。Stryker.NET の MTP の実行器もこの形を前提にする。
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <OutputType>Exe</OutputType>
    <!-- テストのプロジェクトの印（以前は Microsoft.NET.Test.Sdk が付けていた。Stryker.NET はこの値でテストのプロジェクトを見分ける） -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickER.Cli\QuickER.Cli.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Document\QuickER.Document.csproj" />
    <ProjectReference Include="..\..\src\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\..\src\QuickER.CodeReverse.CSharp\QuickER.CodeReverse.CSharp.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.MySql\QuickER.Provider.MySql.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.Oracle\QuickER.Provider.Oracle.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.PostgreSql\QuickER.Provider.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.Sqlite\QuickER.Provider.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Mcp\QuickER.Mcp.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Mcp.Tools\QuickER.Mcp.Tools.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Gui\QuickER.Gui.csproj" />
    <!-- CodexAppServerClient のテストが実プロセスとして起動する偽の app-server（出力へ一緒にコピーされる） -->
    <ProjectReference Include="..\QuickER.Tests.FakeCodexAppServer\QuickER.Tests.FakeCodexAppServer.csproj" />
    <!--
      配布ランタイム 6 パッケージ。公開 API 面のスナップショット検証（PublicApi/）が
      リフレクションで実アセンブリを読むためだけに参照する（プロダクションコードは参照しない）。
    -->
    <ProjectReference Include="..\..\src\QuickER.Runtime\QuickER.Runtime.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.SqlServer\QuickER.Runtime.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.Sqlite\QuickER.Runtime.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.EntityFrameworkCore\QuickER.Runtime.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.InMemory\QuickER.Runtime.InMemory.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.AspNetCore\QuickER.Runtime.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Runtime.Sync\QuickER.Runtime.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- 方言ランタイムテスト（PostgreSQL / MySQL / Oracle）用の EF Core プロバイダ -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <!-- SQLite 方言ランタイムテスト用の EF Core プロバイダ（インプロセス・Docker 不要） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Integration の生成器の作らない形の宣言（実体は Integration の生成器の隣）。受け持つ守りの照合（影響の地図の名前・テストの名前・
      行 Id）はこのプロジェクトにしか無いので、宣言のファイルを逆向きにリンクして両方の宣言を照合する。宣言は Engines の型と BCL だけを
      参照する純粋なデータにする（Integration の型を参照するとこのプロジェクトのビルドが止まる）
    -->
    <Compile
      Include="..\QuickER.Tests.Integration\**\*NotGenerated.cs"
      Exclude="..\QuickER.Tests.Integration\bin\**;..\QuickER.Tests.Integration\obj\**"
      LinkBase="IntegrationDeclarations"
    />
  </ItemGroup>

  <!--
    生成コードへ掛けるカルチャのアナライザ（GeneratedCodeCultureAnalyzerTests）の場所を、テストアセンブリの
    AssemblyMetadata として渡す。src のビルドが使うのと同じ SDK 同梱の DLL を使う（パッケージを足すと、テストだけ版が変わる）。
  -->
  <Target Name="EmbedNetAnalyzerPaths" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_QuickERNetAnalyzer
        Include="@(Analyzer)"
        Condition="'%(Filename)' == 'Microsoft.CodeAnalysis.NetAnalyzers' Or '%(Filename)' == 'Microsoft.CodeAnalysis.CSharp.NetAnalyzers'"
      />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>QuickER.NetAnalyzers</_Parameter1>
        <_Parameter2>@(_QuickERNetAnalyzer->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    実 DB 統合テスト＋生成コードのランタイムテスト（クロスプラットフォーム）。

    QuickER.Tests（net10.0-windows / WPF）から切り出した net10.0 プロジェクトで、CI の ubuntu ジョブが
    実コンテナ（Testcontainers）でこのプロジェクトだけを実行する（windows-latest は Linux コンテナを
    起動できないため、実 DB 検証はここが唯一の CI 経路になる）。WPF・GUI への依存を持ち込まないこと。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 名前空間はテスト規約（QuickER.Tests.{フォルダ}）に従い QuickER.Tests を根とする -->
    <RootNamespace>QuickER.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickER.Cli\QuickER.Cli.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.MySql\QuickER.Provider.MySql.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.Oracle\QuickER.Provider.Oracle.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.PostgreSql\QuickER.Provider.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.Sqlite\QuickER.Provider.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\QuickER.Provider.SqlServer\QuickER.Provider.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RemoteServer フィクスチャ（Minimal API）と in-process Kestrel テストが ASP.NET Core を要求する -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- 方言ランタイムテスト（PostgreSQL / MySQL / Oracle）用の EF Core プロバイダ -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <!-- SQLite 方言ランタイムテスト用の EF Core プロバイダ（インプロセス・Docker 不要） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <!--
      生成フィクスチャの共有（実体パス不動の二重コンパイル）。

      実体は tests/QuickER.Tests/GeneratedFixture/ のまま動かさない（ドリフト検知・再生成ハーネスの
      「パス不動」不変条件）。QuickER.Tests 側は構造検証（ドリフト・EditModel・翻訳器）のため、
      本プロジェクトは実行時挙動検証のために、同じソースをそれぞれのアセンブリへコンパイルする。
      manual partial（*ManualImplementations / *CustomCheck）は生成側が契約宣言のみを出す設計のため、
      .g.cs と同一アセンブリでなければコンパイルが通らない＝必ずセットでリンクする。
    -->
    <Compile Include="..\QuickER.Tests\GeneratedFixture\*.g.cs" LinkBase="GeneratedFixture" />
    <Compile
      Include="..\QuickER.Tests\GeneratedFixture\*FixtureDefinition.cs"
      LinkBase="GeneratedFixture"
    />
    <!-- 複数のフィクスチャ定義が共有する図の部品（自己参照テーブル）。定義本体と同じアセンブリに要る -->
    <Compile
      Include="..\QuickER.Tests\GeneratedFixture\SelfReferenceTableDefinition.cs"
      LinkBase="GeneratedFixture"
    />
    <Compile
      Include="..\QuickER.Tests\GeneratedFixture\*ManualImplementations.cs"
      LinkBase="GeneratedFixture"
    />
    <Compile
      Include="..\QuickER.Tests\GeneratedFixture\InMemoryFixtureCustomUniquenessCheck.cs"
      LinkBase="GeneratedFixture"
    />
    <Compile
      Include="..\QuickER.Tests\GeneratedFixture\UniquenessSqlServerFixtureCustomCheck.cs"
      LinkBase="GeneratedFixture"
    />
    <!-- DbContext の構成の共通の設定（内部のサービスプロバイダの数の警告を無視する）。QuickER.Tests と同じ 1 ファイルを使う -->
    <Compile Include="..\QuickER.Tests\TestSupport\EfCoreTestOptions.cs" LinkBase="TestSupport" />
    <!-- テストが使う能力の宣言の共有の値（製品の宣言は既定値を持たない）。QuickER.Tests と同じ 1 ファイルを使う -->
    <Compile
      Include="..\QuickER.Tests\TestSupport\TestDialectCapabilities.cs"
      LinkBase="TestSupport"
    />
  </ItemGroup>

  <ItemGroup>
    <!--
      名前の総当たりの生成器・既知の失敗の一覧・図の部品（実体は QuickER.Tests の TestSupport。
      DDL の往復を実 DB で確かめるテストだけがこのプロジェクトにあり、期待値と一覧は 1 か所で持つ）
    -->
    <Compile Include="..\QuickER.Tests\TestSupport\NameFuzz*.cs" LinkBase="TestSupport" />
    <Compile Include="..\QuickER.Tests\TestSupport\LongNameDiagrams.cs" LinkBase="TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <!--
      簡易 DSL の条件の総当たり（実体は QuickER.Tests の TestSupport と CodeGen.CSharp。
      生成器・オラクル・既知の失敗の一覧・生成→コンパイル→照合の本体を 1 か所で持ち、ここでは SQL Server の実装先だけを足す）
    -->
    <Compile Include="..\QuickER.Tests\TestSupport\DslFuzz*.cs" LinkBase="TestSupport" />
    <Compile Include="..\QuickER.Tests\CodeGen.CSharp\DslFuzzRunner.cs" LinkBase="CodeGen.CSharp" />
    <Compile
      Include="..\QuickER.Tests\CodeGen.CSharp\DslFuzzExecution.cs"
      LinkBase="CodeGen.CSharp"
    />
    <Compile
      Include="..\QuickER.Tests\CodeGen.CSharp\GeneratedCodeCompiler.cs"
      LinkBase="CodeGen.CSharp"
    />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

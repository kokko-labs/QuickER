<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AI の CLI バックエンドのテストが実プロセスとして起動する偽物（QuickER.Tests が参照し、出力へ一緒にコピーされる）。
    Codex の app-server（1 行 1 JSON）と Copilot のランタイム（LSP の枠でプロトコル 3 を名乗る）の 2 つの型を、起動の引数で分ける。
    製品のコードは参照しない小さな console exe。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>

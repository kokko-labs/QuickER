<Window x:Class="ERDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ERDesigner.ViewModels"
        xmlns:models="clr-namespace:ERDesigner.Models"
        xmlns:beh="clr-namespace:ERDesigner.Behaviors"
        Title="ER図作成ツール"
        Height="760" Width="1200"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        FontSize="13"
        Background="#F5F7FA">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDiagramCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedEntityCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#FAFBFD"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="HeaderText" Color="#374151"/>
        <SolidColorBrush x:Key="MutedText" Color="#6B7280"/>
        <SolidColorBrush x:Key="EntityHeaderBlue" Color="#DCEBFF"/>
        <SolidColorBrush x:Key="EntityBorder" Color="#9DB7DD"/>
        <SolidColorBrush x:Key="EntityBorderSelected" Color="#1A73E8"/>
        <SolidColorBrush x:Key="LineBrush" Color="#5F6B7A"/>

        <Style x:Key="ToolBarLabelButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBarIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style x:Key="ToolBarCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ToolboxItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 上部: ツールバー -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button Style="{StaticResource ToolBarLabelButton}" Command="{Binding NewDiagramCommand}" ToolTip="新規 (Ctrl+N)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolBarIcon}" Text="🗒"/>
                        <TextBlock Style="{StaticResource ToolBarCaption}" Text="新規"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBarLabelButton}" Command="{Binding OpenCommand}" ToolTip="開く (Ctrl+O)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolBarIcon}" Text="📂"/>
                        <TextBlock Style="{StaticResource ToolBarCaption}" Text="開く"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBarLabelButton}" Command="{Binding SaveCommand}" ToolTip="保存 (Ctrl+S)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolBarIcon}" Text="💾"/>
                        <TextBlock Style="{StaticResource ToolBarCaption}" Text="保存"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,4"/>
                <Button Style="{StaticResource ToolBarLabelButton}" Command="{Binding UndoCommand}"
                        IsEnabled="{Binding UndoRedo.CanUndo}" ToolTip="元に戻す (Ctrl+Z)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolBarIcon}" Text="↶"/>
                        <TextBlock Style="{StaticResource ToolBarCaption}" Text="元に戻す"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBarLabelButton}" Command="{Binding RedoCommand}"
                        IsEnabled="{Binding UndoRedo.CanRedo}" ToolTip="やり直す (Ctrl+Y)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolBarIcon}" Text="↷"/>
                        <TextBlock Style="{StaticResource ToolBarCaption}" Text="やり直す"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 下部: ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="準備完了" Foreground="{StaticResource MutedText}"/>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}">
                    <Run Text="エンティティ:"/>
                    <Run Text="{Binding Entities.Count, Mode=OneWay}"/>
                    <Run Text="   リレーション:"/>
                    <Run Text="{Binding Relationships.Count, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左: ツールボックス -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock Text="ツールボックス" FontWeight="Bold" Foreground="{StaticResource HeaderText}" Margin="0,0,0,8"/>

                        <TextBlock Text="エンティティ" Foreground="{StaticResource MutedText}" Margin="0,4,0,2"/>
                        <Button Style="{StaticResource ToolboxItemButton}" Command="{Binding AddEntityCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▭" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="エンティティを追加" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolboxItemButton}" Command="{Binding RemoveSelectedEntityCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="選択を削除" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="リレーションシップ" Foreground="{StaticResource MutedText}" Margin="0,12,0,2"/>
                        <Button Style="{StaticResource ToolboxItemButton}" Command="{Binding StartAddOneToOneCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="○─○" Margin="0,0,8,0"/>
                                <TextBlock Text="1対1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolboxItemButton}" Command="{Binding StartAddOneToManyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="○─≪" Margin="0,0,8,0"/>
                                <TextBlock Text="1対多" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolboxItemButton}" Command="{Binding StartAddManyToManyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="≫─≪" Margin="0,0,8,0"/>
                                <TextBlock Text="多対多" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolboxItemButton}" Command="{Binding RemoveSelectedRelationshipCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="リレーション削除" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Margin="0,12,0,0" Padding="8" CornerRadius="4" Background="#FFF7E0"
                                Visibility="{Binding IsRelationshipMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#7A5F00" FontSize="11"
                                           Text="リレーション作成中: 2つのエンティティを順番にクリックしてください。"/>
                                <Button Margin="0,6,0,0" Content="キャンセル"
                                        Command="{Binding CancelRelationshipModeCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中央: キャンバス -->
            <Border Grid.Column="1" Background="#F2F4F8">
                <Border.Resources>
                    <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#E2E6EC" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="20,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,20"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Resources>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid Width="2400" Height="1600" Background="{StaticResource GridBrush}">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CanvasClickCommand}"/>
                        </Grid.InputBindings>

                        <ItemsControl ItemsSource="{Binding Relationships}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RelationshipViewModel}">
                                    <Canvas>
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                              X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="{StaticResource LineBrush}" StrokeThickness="1.5"/>
                                        <Border CornerRadius="3" Padding="4,1" Background="White"
                                                BorderBrush="#9AA0A6" BorderThickness="1"
                                                Canvas.Left="{Binding X1}" Canvas.Top="{Binding Y1}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.RelationshipClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#374151"/>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Entities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EntityViewModel}">
                                    <Border Width="{Binding Width}" Background="White" CornerRadius="6"
                                            beh:DragBehavior.IsEnabled="True"
                                            beh:DragBehavior.UndoRedoManager="{Binding DataContext.UndoRedo, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#88AABB" BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource EntityBorder}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource EntityBorderSelected}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Background="{StaticResource EntityHeaderBlue}"
                                                    CornerRadius="6,6,0,0" Padding="10,6">
                                                <TextBlock FontWeight="SemiBold" Foreground="#1F3A66">
                                                    <Run Text="{Binding DisplayName}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding TableName}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Columns}" Margin="6,4,6,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value=""/>
                                                                        <Setter Property="Foreground" Value="#374151"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPrimaryKey}" Value="True">
                                                                                <Setter Property="Text" Value="PK"/>
                                                                                <Setter Property="Foreground" Value="#D93025"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsForeignKey}" Value="True">
                                                                                <Setter Property="Text" Value="FK"/>
                                                                                <Setter Property="Foreground" Value="#1A73E8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#1F2937"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DataType}" Foreground="#6B7280"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 右: プロパティパネル -->
            <Border Grid.Column="2" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="プロパティ" FontWeight="Bold"
                                   Foreground="{StaticResource HeaderText}" Margin="0,0,0,8"/>

                        <StackPanel Visibility="{Binding SelectedEntity, Converter={StaticResource NullToVisibilityConverter}}"
                                    DataContext="{Binding SelectedEntity}">
                            <TextBlock Text="エンティティ" FontWeight="SemiBold" Margin="0,4,0,6" Foreground="{StaticResource HeaderText}"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名前" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="テーブル名" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <DockPanel Margin="0,12,0,4">
                                <TextBlock Text="項目" FontWeight="SemiBold" Foreground="{StaticResource HeaderText}"/>
                                <Button Content="+" Width="22" Height="22" DockPanel.Dock="Right"
                                        Command="{Binding DataContext.AddColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Columns}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EEF1F5"
                                      Background="White" BorderBrush="{StaticResource DividerBrush}"
                                      Height="240">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                                    <DataGridCheckBoxColumn Header="FK" Binding="{Binding IsForeignKey, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                                    <DataGridTextColumn Header="名前" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="型" Binding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="メモ" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource HeaderText}"/>
                            <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedRelationship, Converter={StaticResource NullToVisibilityConverter}}"
                                    DataContext="{Binding SelectedRelationship}">
                            <TextBlock Text="リレーション" FontWeight="SemiBold" Margin="0,4,0,6" Foreground="{StaticResource HeaderText}"/>
                            <TextBlock Text="種別"/>
                            <ComboBox SelectedValue="{Binding Type}" SelectedValuePath="Tag" Margin="0,4,0,6">
                                <ComboBoxItem Content="1対1" Tag="{x:Static models:RelationshipType.OneToOne}"/>
                                <ComboBoxItem Content="1対多" Tag="{x:Static models:RelationshipType.OneToMany}"/>
                                <ComboBoxItem Content="多対多" Tag="{x:Static models:RelationshipType.ManyToMany}"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>

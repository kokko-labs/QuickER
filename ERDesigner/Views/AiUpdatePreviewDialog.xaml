<Window
  x:Class="ERDesigner.Views.AiUpdatePreviewDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:svc="clr-namespace:ERDesigner.Services"
  Title="AI更新の差分プレビュー"
  Width="1080"
  Height="720"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="適用" Width="110" Margin="0,0,8,0" IsDefault="True" Command="{Binding ApplyCommand}" />
          <Button Content="キャンセル" Width="90" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="AI更新の差分プレビュー" FontSize="18" FontWeight="Bold" />
          <TextBlock Margin="0,6,0,0" Text="{Binding SummaryMessage}" Foreground="#374151" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="差分一覧" FontWeight="Bold" Margin="0,0,0,6" />
        <Border BorderBrush="#E5E7EB" BorderThickness="1" Padding="6">
          <TreeView x:Name="DiffTreeView" SelectedItemChanged="DiffTreeView_SelectedItemChanged" ItemsSource="{Binding DiffGroups}">
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type svc:AiUpdateDiffGroup}" ItemsSource="{Binding Items}">
                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
              </HierarchicalDataTemplate>
              <DataTemplate DataType="{x:Type svc:AiUpdateDiffItem}">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
              </DataTemplate>
            </TreeView.Resources>
          </TreeView>
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#F3F4F6" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="選択中の差分" FontWeight="Bold" />
          <TextBlock Margin="0,4,0,0" Text="{Binding SelectedItemTitle}" Foreground="#374151" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid
          Grid.Row="1"
          ItemsSource="{Binding SelectedDetails}"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          IsReadOnly="True"
          CanUserSortColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserResizeRows="False"
          GridLinesVisibility="Horizontal"
        >
          <DataGrid.Columns>
            <DataGridTextColumn Header="項目" Binding="{Binding Name}" Width="180" CanUserSort="False" />
            <DataGridTextColumn Header="現在" Binding="{Binding Before}" Width="*" CanUserSort="False" />
            <DataGridTextColumn Header="更新後" Binding="{Binding After}" Width="*" CanUserSort="False" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>

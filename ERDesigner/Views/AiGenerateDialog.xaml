<Window
  x:Class="ERDesigner.Views.AiGenerateDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:ERDesigner.ViewModels"
  xmlns:svc="clr-namespace:ERDesigner.Services"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  Title="AI でスキーマを生成"
  Width="560"
  Height="540"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
>
  <Window.Resources>
    <ObjectDataProvider x:Key="AiProviders" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="svc:AiProvider" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="プロバイダ" VerticalAlignment="Center" Margin="0,4" />
    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Source={StaticResource AiProviders}}" SelectedItem="{Binding Provider}" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="モデル" VerticalAlignment="Center" Margin="0,4" />
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" IsEditable="True" ItemsSource="{Binding ModelCandidates}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock
      Grid.Row="2"
      Grid.Column="0"
      Text="API キー"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowApiKey, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <Grid Grid.Row="2" Grid.Column="1" Margin="0,4" Visibility="{Binding ShowApiKey, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
      <CheckBox
        Grid.Column="1"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Content="保存"
        IsChecked="{Binding SaveApiKey}"
        ToolTip="Windows DPAPI で暗号化してユーザープロファイルに保存"
      />
    </Grid>

    <TextBlock
      Grid.Row="3"
      Grid.Column="0"
      Text="エンドポイント"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowEndpoint, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <TextBox
      Grid.Row="3"
      Grid.Column="1"
      Margin="0,4"
      Text="{Binding EndpointOverride, UpdateSourceTrigger=PropertyChanged}"
      Visibility="{Binding ShowEndpoint, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,4" Text="要件 (自然言語)" FontWeight="SemiBold" />

    <TextBox
      Grid.Row="5"
      Grid.ColumnSpan="2"
      Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
      AcceptsReturn="True"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto"
    />

    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6" TextWrapping="Wrap" Foreground="#374151" Text="{Binding StatusMessage}" />

    <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="生成" Width="100" Margin="0,0,8,0" IsDefault="True" Command="{Binding GenerateCommand}" />
      <Button Content="キャンセル" Width="80" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>

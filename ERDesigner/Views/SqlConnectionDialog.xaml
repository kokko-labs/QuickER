<Window x:Class="ERDesigner.Views.SqlConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ERDesigner.ViewModels"
        xmlns:svc="clr-namespace:ERDesigner.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="SQL Server から取り込み"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo" FontSize="13">
    <Window.Resources>
        <ObjectDataProvider x:Key="AuthModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="svc:SqlAuthMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="サーバ" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox  Grid.Row="0" Grid.Column="1" Margin="0,4"
                  Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="データベース" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox  Grid.Row="1" Grid.Column="1" Margin="0,4"
                  Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="認証方式" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                  ItemsSource="{Binding Source={StaticResource AuthModes}}"
                  SelectedItem="{Binding AuthMode}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="ユーザー名" VerticalAlignment="Center" Margin="0,4"
                   Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBox  Grid.Row="3" Grid.Column="1" Margin="0,4"
                  Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                  Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="パスワード" VerticalAlignment="Center" Margin="0,4"
                   Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" Margin="0,4" x:Name="PasswordBoxControl"
                     Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisibilityConverter}}"
                     PasswordChanged="PasswordBoxControl_PasswordChanged"/>

        <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,8"
                  IsChecked="{Binding TrustServerCertificate}"
                  Content="サーバ証明書を信頼する (TrustServerCertificate)"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6"
                   TextWrapping="Wrap" Foreground="#374151"
                   Text="{Binding StatusMessage}"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="接続テスト" Width="100" Margin="0,0,8,0"
                    Command="{Binding TestConnectionCommand}"/>
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True"
                    Command="{Binding OkCommand}"/>
            <Button Content="キャンセル" Width="80" IsCancel="True"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>

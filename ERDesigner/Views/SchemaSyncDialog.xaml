<Window
  x:Class="ERDesigner.Views.SchemaSyncDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="DB スキーマ同期 (差分実行)"
  Width="900"
  Height="600"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
>
  <DockPanel Margin="10">
    <!-- 上部ツールバー -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="🔄 差分を再計算" Margin="0,0,8,0" Padding="8,3" Command="{Binding RefreshCommand}" />
      <Button Content="✓ 全選択" Margin="0,0,4,0" Padding="8,3" Command="{Binding SelectAllCommand}" />
      <Button Content="✗ 全解除" Margin="0,0,16,0" Padding="8,3" Command="{Binding DeselectAllCommand}" />
      <Button Content="🛢 実行" Padding="14,3" Background="#DCFCE7" FontWeight="Bold" Command="{Binding ExecuteCommand}" />
    </StackPanel>

    <!-- 下部ステータス -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,8,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="閉じる" Width="80" Command="{Binding CloseCommand}" IsCancel="True" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="#374151" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- 中央: 差分リスト + プレビュー -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="差分一覧" FontWeight="Bold" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding DiffItems}" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Kind}" Width="110" Foreground="#6B7280" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#F3F4F6" />

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="生成 SQL プレビュー" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox
          Text="{Binding ScriptPreview, Mode=OneWay}"
          IsReadOnly="True"
          FontFamily="Consolas, Courier New"
          FontSize="12"
          AcceptsReturn="True"
          TextWrapping="NoWrap"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
        />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

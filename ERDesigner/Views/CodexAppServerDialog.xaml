<Window
  x:Class="ERDesigner.Views.CodexAppServerDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:ERDesigner.Converters"
  xmlns:services="clr-namespace:ERDesigner.Services"
  Title="Codex チャット"
  Width="800"
  Height="680"
  MinWidth="600"
  MinHeight="480"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Topmost="True"
>
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- チャットメッセージのロール別テンプレート -->
    <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type services:CodexChatMessage}">
      <Border Margin="60,4,4,4" Padding="10,6" Background="#DCF8C6" CornerRadius="10" HorizontalAlignment="Right">
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
          FontSize="13"
        />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type services:CodexChatMessage}">
      <Border Margin="4,4,60,4" Padding="10,6" Background="#DBEAFE" CornerRadius="10" HorizontalAlignment="Left">
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="#1E3A5F"
          FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
          FontSize="13"
        />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SystemMessageTemplate" DataType="{x:Type services:CodexChatMessage}">
      <Border Margin="4,2" Padding="8,4" Background="#FFF9C4" CornerRadius="6" HorizontalAlignment="Stretch">
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="#795548"
          FontSize="12"
          FontStyle="Italic"
        />
      </Border>
    </DataTemplate>

    <!-- ツール呼び出し作業内容（折り畳み可能） -->
    <DataTemplate x:Key="ToolCallMessageTemplate" DataType="{x:Type services:CodexChatMessage}">
      <Border Margin="4,2" CornerRadius="6" BorderBrush="#B0BEC5" BorderThickness="1">
        <Expander IsExpanded="{Binding IsExpanded}" Header="AI 作業内容" Background="#ECEFF1">
          <TextBox
            Margin="4,4,4,8"
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="#37474F"
            FontSize="12"
            FontFamily="Consolas, Courier New"
          />
        </Expander>
      </Border>
    </DataTemplate>

    <!-- ロール別にテンプレートを切り替えるセレクター -->
    <local:ChatMessageTemplateSelector
      xmlns:local="clr-namespace:ERDesigner.Views"
      x:Key="ChatMessageTemplateSelector"
      UserTemplate="{StaticResource UserMessageTemplate}"
      AssistantTemplate="{StaticResource AssistantMessageTemplate}"
      SystemTemplate="{StaticResource SystemMessageTemplate}"
      ToolCallTemplate="{StaticResource ToolCallMessageTemplate}"
    />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="117*" />
      <ColumnDefinition Width="683*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <!-- 設定・認証エリア -->
      <RowDefinition Height="Auto" />
      <!-- チャットエリア -->
      <RowDefinition Height="*" />
      <!-- 入力エリア -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── 上部: 設定・認証エリア ── -->
    <StackPanel Grid.Row="0" Margin="8,8,8,4" Grid.ColumnSpan="2">
      <!-- モデル設定（常時表示） -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="モデルプロバイダー" />
        <ComboBox
          Grid.Column="1"
          Margin="0,0,16,0"
          IsEditable="True"
          Text="{Binding ModelProvider, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding ModelProviderCandidates}"
          ToolTip="openai 以外は OpenAI 認証不要です"
        />

        <TextBlock Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" Text="モデル名" />
        <ComboBox
          Grid.Column="3"
          IsEditable="True"
          Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding ModelCandidates}"
          ToolTip="使用するモデルを選択または入力します。空欄にすると Codex の既定モデルが使われます。"
        />
      </Grid>

      <!-- openai プロバイダー選択時のみ表示する認証エリア -->
      <Border
        Margin="0,8,0,0"
        Padding="10,8"
        Background="#F0F4FF"
        CornerRadius="6"
        BorderBrush="#C7D2FE"
        BorderThickness="1"
        Visibility="{Binding ShowAuthSection, Converter={StaticResource BoolToVisibilityConverter}}"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- ログイン済みの場合は非表示 -->
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- アカウント状態行（ログイン済み・未ログイン共通） -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding AccountSummary}" TextWrapping="Wrap" />
            <Button Grid.Column="1" Width="80" Content="ログアウト" Command="{Binding LogoutCommand}" IsEnabled="{Binding CanLogout}" />
          </Grid>

          <!-- ログインフォーム（openai かつ未ログイン時のみ表示） -->
          <StackPanel Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding ShowLoginPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- API キーログイン行 -->
            <Grid Visibility="{Binding ShowApiKeyInput, Converter={StaticResource BoolToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="API キー" />
              <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Margin="0,0,8,0" ToolTip="OpenAI API キー（sk-...）を入力してください" PasswordChanged="ApiKeyBox_PasswordChanged" />
              <CheckBox Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Content="保存" IsChecked="{Binding SaveApiKey}" />
              <Button Grid.Column="3" Width="120" Content="API キーでログイン" Command="{Binding LoginWithApiKeyCommand}" />
            </Grid>

            <!-- ChatGPT ブラウザログインボタン -->
            <Button
              Margin="0,6,0,0"
              HorizontalAlignment="Left"
              Width="200"
              Content="ChatGPT ブラウザでログイン"
              Command="{Binding StartChatGptLoginCommand}"
              ToolTip="ブラウザで ChatGPT アカウントにログインします"
            />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ── 中部: チャットエリア ── -->
    <Grid Grid.Row="1" Margin="8,4,8,4" Grid.ColumnSpan="2">
      <Grid.RowDefinitions>
        <!-- スレッド操作バー -->
        <RowDefinition Height="Auto" />
        <!-- メッセージ一覧 -->
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- スレッド操作バー -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
        <Button Width="160" Margin="0,0,8,0" Content="新しい会話を開始" Command="{Binding StartNewThreadCommand}" />
        <Button
          Width="120"
          Content="ターンを中断"
          Command="{Binding InterruptTurnCommand}"
          Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
        />
        <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Text="処理中..."
          Foreground="#1565C0"
          FontStyle="Italic"
          Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
        />
      </StackPanel>

      <!-- メッセージ一覧 -->
      <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ── 下部: 入力エリア ── -->
    <Grid Grid.Row="2" Margin="8,0,8,8" Grid.ColumnSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          x:Name="UserInputBox"
          Grid.Column="0"
          Margin="0,0,8,0"
          MinHeight="60"
          MaxHeight="120"
          TextWrapping="Wrap"
          AcceptsReturn="True"
          VerticalScrollBarVisibility="Auto"
          Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
          KeyDown="UserInputBox_KeyDown"
          ToolTip="Ctrl+Enter で送信"
        />
        <Button Grid.Column="1" Width="80" VerticalAlignment="Bottom" Content="送信" Command="{Binding SendMessageCommand}" />
      </Grid>

      <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
    </Grid>
  </Grid>
</Window>

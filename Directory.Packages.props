<Project>
  <!--
    中央パッケージ管理（CPM）: NuGet 依存のバージョンはこのファイルの 1 箇所で宣言し、
    src/ と tests/ の csproj の PackageReference は Version 属性を持たない。同一パッケージを
    複数プロジェクトが参照するもの（CommunityToolkit.Mvvm ×6・Microsoft.Data.Sqlite ×2 など）の
    更新が 1 箇所で済み、上げ忘れによるバージョンの食い違いが構造的に起きなくなる。

    samples/ 配下は対象外＝各サンプル csproj が ManagePackageVersionsCentrally=false で
    オプトアウトし、利用者のプロジェクトを模した直書きピンを維持する
    （実際の利用者プロジェクトは QuickER リポジトリの CPM 管理下に無いため）。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- csproj 側の VersionOverride は禁止＝個別上書きでバージョンの食い違いが再侵入する経路を塞ぐ -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Anthropic" Version="12.44.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.11" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <PackageVersion Include="Scriban" Version="7.2.6" />
    <!-- Microsoft.Data.Sqlite が推移的に持ち込む SQLitePCLRaw 2.1.11 には既知の脆弱性
         (GHSA-2m69-gcr7-jv3q) があるため、修正済みの版へ明示参照で上書きする（参照側＝
         QuickER.Sqlite / QuickER.Runtime.Sqlite / サンプル。サンプルは CPM 外のため個別ピン） -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Testcontainers の推移的依存（下限指定 [2025.1.0, )）の既定解決 2025.1.0 には
         GHSA-q939-rpr3-3284（ScpClient のパストラバーサル・High）があるため、修正済みの版へ
         明示参照で上書きし NU1903 を発生源から消す（下限のみの要求のため依存の整合は崩れない） -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.0" />
  </ItemGroup>
</Project>

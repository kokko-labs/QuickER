<Project>
  <!--
    中央パッケージ管理（CPM）: NuGet 依存のバージョンはこのファイルの 1 箇所で宣言し、
    src/ と tests/ の csproj の PackageReference は Version 属性を持たない。同一パッケージを
    複数プロジェクトが参照するもの（CommunityToolkit.Mvvm ×6・Microsoft.Data.Sqlite ×2 など）の
    更新が 1 箇所で済み、上げ忘れによるバージョンの食い違いが構造的に起きなくなる。

    samples/ 配下は対象外＝各サンプル csproj が ManagePackageVersionsCentrally=false で
    オプトアウトし、利用者のプロジェクトを模した直書きピンを維持する
    （実際の利用者プロジェクトは QuickER リポジトリの CPM 管理下に無いため）。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- csproj 側の VersionOverride は禁止＝個別上書きでバージョンの食い違いが再侵入する経路を塞ぐ -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Anthropic" Version="12.60.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.26" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.13"
    />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageVersion Include="Scriban" Version="7.5.3" />
    <!-- Microsoft.Data.Sqlite が推移的に持ち込む SQLitePCLRaw（2.1 系）でなく、3.0 系を明示参照して
         SQLite の版をそろえる（同梱の SQLite は実測 3.53.4＝取込・同期・生成コードのテストで確かめた版。
         取込が前提にする PRAGMA table_list は 3.37 以降）。2.1.11 以前には既知の脆弱性
         (GHSA-2m69-gcr7-jv3q) もある（参照側＝QuickER.Provider.Sqlite / QuickER.Runtime.Sqlite / サンプル /
         SQLite のモックプロジェクト。サンプルは CPM 外のため個別ピン） -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- Microsoft.Data.SqlClient が推移的に持ち込む System.Security.Cryptography.Pkcs 9.0.18 と、
         Oracle.ManagedDataAccess.Core が持ち込む 8.0.1 には既知の脆弱性（GHSA-846f-f764-76mx・
         GHSA-2fmv-rv2c-59x7）があるため、修正済みの版へ明示参照で上書きする（参照側＝
         QuickER.Provider.SqlServer / QuickER.Provider.Oracle / QuickER.Runtime.SqlServer / Blazor の SQL Server のモックプロジェクト。
         WPF の共有フレームワークはこのパッケージを刈り込むので、WPF のプロジェクトでは参照しない＝書くと NU1510） -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
  </ItemGroup>
</Project>

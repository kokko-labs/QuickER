<Project>
  <!--
    QuickER 全プロジェクト共有のバージョン一元化（ロックステップ版管理）。

    ランタイム NuGet パッケージ（QuickER.Runtime / .SqlServer / .Sqlite / .EntityFrameworkCore / .InMemory / .AspNetCore / .Sync）と、CLI／本体ツールの
    バージョンをこの VersionPrefix 単一ソースで一元管理する。パッケージ版＝ツール版として発行し、
    同一メジャー内では生成コードとランタイムパッケージが互換であることを SemVer で宣言する運用とする。
    バージョンを上げるときはここ 1 箇所を変更する。
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    警告をエラーとして扱う（全プロジェクト共通）。

    本リポジトリはコード警告 0 を維持してきたが、それを守っていたのは規約だけで仕掛けが無く、
    「1 件くらいなら」で積み上がると回帰の予兆（未使用変数・null 許容の綻び・古い API）が
    ビルドログのノイズに埋もれる。0 の状態を仕掛けで固定する。

    セキュリティ advisory（NU1901-NU1904）は「コードの誤り」ではなく「依存の更新要求」であり、
    新しい advisory が出た日にビルドが止まるとリポジトリの作業が全面的に塞がる。エラーにはせず
    警告のまま残して気づける状態を保つ（個別 advisory の NoWarn による握り潰しはしない
    ＝別パッケージの新しい advisory まで一緒に消えてしまうため）。
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    NuGet ロックファイルによる依存グラフの固定（全プロジェクト共通）。

    各プロジェクトの packages.lock.json をチェックインし、CI（GitHub Actions は常に環境変数
    CI=true を設定する）では locked-mode で復元する＝ロックファイルと解決結果の不一致
    （推移的依存の変動・改竄）を復元エラーとして検出する。配布物（NuGet パッケージ・GUI）の
    依存グラフをリリースビルドで再現・検証可能にするのが目的。依存を更新したときは
    dotnet restore がロックファイルを書き換えるので、変更をコミットに含めること。
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!--
      release.yml の GUI publish は RID 指定（-r win-x64）で復元するため、ロックファイルには
      win-x64 のグラフも必要（無いと locked-mode が NU1004 で拒否する＝初回 dry_run で実測）。
      RuntimeIdentifiers を全プロジェクトへ宣言し、どの restore でも RID グラフ込みで
      ロックファイルを評価・生成させる（restore のみに作用し、RuntimeIdentifier〔単数〕は
      設定しないため通常ビルド・pack の出力は不変。これが無いと開発機の再 restore が
      RID セクションを落とし、次のリリースで再発する）。
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    NuGet パッケージ・アセンブリ共通メタデータ（発行パッケージ＝CLI とランタイム各種が継承。
    パックしないプロジェクトにもアセンブリ情報として適用される）。
    nuget.org に表示される文字列（Description / PackageTags 等）は各 csproj 側で英語に統一する。
  -->
  <PropertyGroup>
    <Authors>kokko-labs</Authors>
    <Company>kokko-labs</Company>
    <Copyright>Copyright (c) 2026 kokko-labs</Copyright>
    <PackageProjectUrl>https://github.com/kokko-labs/QuickER</PackageProjectUrl>
  </PropertyGroup>
</Project>

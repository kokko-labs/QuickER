<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Claude Code 接続タブ: プロセス内 MCP サーバー（HTTP/SSE）をホストするため ASP.NET Core を参照する -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.30.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Generator\QuickER.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ViewModels\CSharpGenerationDialogViewModel.cs" />
    <Compile Update="Views\CSharpGenerationDialog.xaml.cs">
      <DependentUpon>CSharpGenerationDialog.xaml</DependentUpon>
    </Compile>
    <Page Update="Views\CSharpGenerationDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime.Sync</PackageId>
    <Description>Runtime for C# code generated by QuickER (an ER diagram designer): the bidirectional sync engine for a server (SQL Server) plus local (SQLite) hybrid setup, working entirely through the dialect-neutral contracts of QuickER.Runtime.</Description>
    <PackageTags>quicker;runtime;repository;data-access;sync;offline;sql-server;sqlite;code-generation</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>quicker-icon-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None
      Include="../../assets/quicker-icon-128.png"
      Pack="true"
      PackagePath="quicker-icon-128.png"
      Visible="false"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- 同期エンジンは中立契約（IRepository / ISqlExecutor / ConcurrencyMode）だけを使い、ADO にも EF Core にも
         DI にも触れない（BCL のみ）。DI 登録拡張（AddGeneratedSyncSupport）と per-entity の記述子・デコレータ・
         直結差分ソースはスキーマ依存物として生成側に出力されるため、本パッケージは
         Microsoft.Extensions.DependencyInjection 系にも依存しない（依存排他ガードテストで検証） -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Runtime\QuickER.Runtime.csproj" />
  </ItemGroup>
</Project>

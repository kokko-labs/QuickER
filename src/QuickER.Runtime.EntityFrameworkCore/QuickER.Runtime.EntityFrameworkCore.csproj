<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime.EntityFrameworkCore</PackageId>
    <Description>Runtime for C# code generated by QuickER (an ER diagram designer): the shared EF Core components (a TContext-generic Repository base and value-object translation plugins), implementing the dialect-neutral contracts of QuickER.Runtime.</Description>
    <PackageTags>quicker;runtime;repository;data-access;entity-framework-core;efcore</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF 版 Repository 基底・翻訳プラグインは Relational 層の型（RelationalTypeMapping / ISqlExpressionFactory 等）を使う。
         Microsoft.EntityFrameworkCore 本体は Relational が推移的に持ち込むため、Relational のみを直接参照する。
         DI 登録拡張（AddGeneratedEfCoreRepositories）は具象 QuickErDbContext を参照するスキーマ依存物として生成側に
         出力されるため、本パッケージは Microsoft.Extensions.DependencyInjection 系・ADO（SqlClient / Sqlite）へ依存しない
         （依存排他ガードテストで検証） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Runtime\QuickER.Runtime.csproj" />
  </ItemGroup>
</Project>

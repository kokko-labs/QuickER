<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime.Sqlite</PackageId>
    <Description>Runtime for C# code generated by QuickER (an ER diagram designer): the SQLite dialect engine for the QuickER Repository, implementing the dialect-neutral contracts of QuickER.Runtime.</Description>
    <PackageTags>quicker;runtime;repository;data-access;sqlite;code-generation</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>quicker-icon-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../assets/quicker-icon-128.png" Pack="true" PackagePath="quicker-icon-128.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Microsoft.Data.Sqlite が推移的に持ち込む SQLitePCLRaw には既知の脆弱性
         (GHSA-2m69-gcr7-jv3q) があるため、修正済みの版（Directory.Packages.props）を明示参照して上書きする -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- DI 登録拡張（AddGenerated*Repositories）はスキーマ依存物として生成側に出力されるため、
         本パッケージは Microsoft.Extensions.DependencyInjection 系へ依存しない（依存排他ガードテストで検証） -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Runtime\QuickER.Runtime.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime.Sqlite</PackageId>
    <Description>QuickER が生成するコードのランタイム（自作 SQLite 方言エンジン）。QuickER.Runtime の共通契約を実装する。</Description>
    <!-- TODO: 公開時に実リポジトリ URL へ差し替える -->
    <RepositoryUrl>https://github.com/QuickER/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Microsoft.Data.Sqlite 10.0.9 が推移的に持ち込む SQLitePCLRaw 2.1.11 には既知の脆弱性
         (GHSA-2m69-gcr7-jv3q) があるため、修正済みの 3.0.3 を明示参照して上書きする -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- DI 登録拡張（AddGenerated*Repositories）はスキーマ依存物として生成側に出力されるため、
         本パッケージは Microsoft.Extensions.DependencyInjection 系へ依存しない（依存排他ガードテストで検証） -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Runtime\QuickER.Runtime.csproj" />
  </ItemGroup>
</Project>

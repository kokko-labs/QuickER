/// <summary>
/// EF Core method call translator that translates Contains/StartsWith/EndsWith of string value objects
/// (the members of <see cref="IStringMatchValueObject{TSelf}"/>) into SQL LIKE.
/// </summary>
/// <remarks>
/// <para>
/// Value object columns are projected onto string columns by a converter, but by default EF Core cannot translate these instance methods.
/// It generates <c>ISqlExpressionFactory.Like</c> with the same semantics as the QuickER SQL Server implementation
/// (ordinal substring match → LIKE, escaping of the wildcards <c>\ % _ [</c>, <c>ESCAPE '\'</c>, and treating a null argument as an empty string).
/// </para>
/// <para>
/// The argument accepts both the string overload and the TSelf (value object) overload. Constants are escaped on the client side,
/// while parameters are escaped on the SQL side with a chain of REPLACE calls (dialect-independent).
/// </para>
/// <para>
/// The receiver is usually the column. When it is a value object parameter matched against a column
/// (<c>term.Contains(c.Name)</c>), it has no type mapping of its own and takes the column's, so that the value object is
/// sent as its raw value. The pattern, the escape character and a string argument are written as non-Unicode text when
/// the column is not Unicode (a <c>varchar</c> column configured with <c>IsUnicode(false)</c> or <c>HasColumnType</c>), so
/// that the database does not convert the column to compare it; they never take the column's own length or fixed-length
/// store type, which would truncate or pad the pattern.
/// </para>
/// </remarks>
{{ infra_visibility }} sealed class ValueObjectStringMethodTranslator : IMethodCallTranslator
{
    private readonly ISqlExpressionFactory _sqlExpressionFactory;
    private readonly RelationalTypeMapping _stringTypeMapping;
    private readonly RelationalTypeMapping _nonUnicodeStringTypeMapping;
    private readonly LikeEscapeBehavior _escapeBehavior;

    /// <summary>Builds the translator, writing every pattern with <paramref name="stringTypeMapping"/>.</summary>
    public ValueObjectStringMethodTranslator(
        ISqlExpressionFactory sqlExpressionFactory,
        RelationalTypeMapping stringTypeMapping,
        LikeEscapeBehavior escapeBehavior
    )
        : this(sqlExpressionFactory, stringTypeMapping, stringTypeMapping, escapeBehavior) { }

    /// <summary>
    /// Builds the translator, writing the patterns for a column whose Unicode-ness differs from
    /// <paramref name="stringTypeMapping"/> with <paramref name="nonUnicodeStringTypeMapping"/>.
    /// </summary>
    public ValueObjectStringMethodTranslator(
        ISqlExpressionFactory sqlExpressionFactory,
        RelationalTypeMapping stringTypeMapping,
        RelationalTypeMapping nonUnicodeStringTypeMapping,
        LikeEscapeBehavior escapeBehavior
    )
    {
        _sqlExpressionFactory = sqlExpressionFactory;
        _stringTypeMapping = stringTypeMapping;
        _nonUnicodeStringTypeMapping = nonUnicodeStringTypeMapping;
        _escapeBehavior = escapeBehavior;
    }

    /// <summary>
    /// The (original, replacement) pairs to escape in order with REPLACE. The escape character itself is doubled first.
    /// <c>[</c> starts a character class only on SQL Server and is therefore escaped there; on other dialects (where <c>[</c> is not a wildcard)
    /// it is not escaped. In particular, Oracle rejects escaping of a non-wildcard character with ORA-01424, so <c>[</c> must not be included.
    /// The escape character is dialect-dependent: MySQL uses something other than <c>\</c> (<see cref="LikeEscapeBehavior.EscapeChar"/>)
    /// because a backslash in a string literal is misinterpreted as a quote-cancelling escape.
    /// </summary>
    private IEnumerable<(string From, string To)> EscapePairs()
    {
        var e = _escapeBehavior.EscapeChar;

        // The escape character itself → doubled (must be processed first).
        yield return (e, e + e);
        yield return ("%", e + "%");
        yield return ("_", e + "_");

        if (_escapeBehavior.EscapeBracket)
        {
            yield return ("[", e + "[");
        }
    }

    /// <summary>Returns a LIKE expression for a target method, or null otherwise (deferring to other translators).</summary>
    public SqlExpression? Translate(
        SqlExpression? instance,
        MethodInfo method,
        IReadOnlyList<SqlExpression> arguments,
        IDiagnosticsLogger<DbLoggerCategory.Query> logger
    )
    {
        // Only handle single-argument Contains / StartsWith / EndsWith of string value objects.
        if (
            instance is null
            || arguments.Count != 1
            || method.Name is not ("Contains" or "StartsWith" or "EndsWith")
            || StringMatchContract(method) is not { } contract
        )
        {
            return null;
        }

        var parameterType = method.GetParameters()[0].ParameterType;
        var isValueObjectArgument = parameterType == contract.GetGenericArguments()[0];

        if (parameterType != typeof(string) && !isValueObjectArgument)
        {
            return null;
        }

        // The receiver carries the column's converter-backed mapping (value object → raw value). A receiver that is a value
        // object parameter or constant has no mapping; it takes the one of the column it is matched against, which only the
        // TSelf overload can name (a plain string column cannot convert a value object).
        var receiverMapping = instance.TypeMapping;

        if (receiverMapping is null)
        {
            if (
                !isValueObjectArgument
                || arguments[0].TypeMapping is not { } columnMapping
                || arguments[0].Type != instance.Type
            )
            {
                return null;
            }

            receiverMapping = columnMapping;
        }

        var receiver = _sqlExpressionFactory.ApplyTypeMapping(instance, receiverMapping);

        // The text of the pattern follows the column's Unicode-ness (see the class remarks); a column that matches the
        // default string mapping keeps it, so the SQL for the usual columns is unchanged.
        var textMapping =
            receiverMapping.IsUnicode == _stringTypeMapping.IsUnicode
                ? _stringTypeMapping
                : _nonUnicodeStringTypeMapping;

        // A string argument binds as text, while a TSelf argument binds with the column's converter-backed mapping.
        var argument = isValueObjectArgument
            ? _sqlExpressionFactory.ApplyTypeMapping(arguments[0], receiverMapping)
            : _sqlExpressionFactory.ApplyTypeMapping(arguments[0], textMapping);
        var pattern = BuildLikePattern(method.Name, argument, textMapping);

        // Whether to emit ESCAPE explicitly is dialect-dependent. PostgreSQL, whose default escape character is already a backslash, omits it.
        // SQL Server / Oracle have no default escape character, so they emit it. MySQL emits it after choosing an escape character
        // other than \ to avoid misinterpretation of the backslash in a string literal.
        var escapeChar = _escapeBehavior.EmitEscapeClause
            ? _sqlExpressionFactory.Constant(_escapeBehavior.EscapeChar, textMapping)
            : null;

        var like = _sqlExpressionFactory.Like(receiver, pattern, escapeChar);

        // Where concatenating NULL yields the rest of the string (Oracle), a NULL parameter would turn the pattern into '%%' and
        // match every row; testing it keeps such a pattern matching no row, as elsewhere. EF Core decides whether a parameter
        // is null from its .NET value, so an empty string (which Oracle receives as NULL) still matches every row: the test is
        // removed from the SQL for a non-null value.
        return _escapeBehavior.ConcatenationSkipsNull && argument is not SqlConstantExpression
            ? _sqlExpressionFactory.AndAlso(like, _sqlExpressionFactory.IsNotNull(argument))
            : like;
    }

    /// <summary>Returns the closed <see cref="IStringMatchValueObject{TSelf}"/> the method implements, or null when it is not one of those substring matches.</summary>
    /// <remarks>
    /// The judgement goes through the interface map, so only the type that actually implements those members qualifies:
    /// testing the name against a type that merely implements the interface would also claim a <c>Contains</c> a concrete
    /// value object declares for itself. The methods are compared by handle, so a <see cref="MethodInfo"/> taken from the
    /// concrete value object type (whose <see cref="MemberInfo.ReflectedType"/> differs from the one the compiler uses) is
    /// recognized as well. The contract is returned rather than a bool because its type argument is the value object type
    /// the TSelf overload takes.
    /// </remarks>
    private static Type? StringMatchContract(MethodInfo method) =>
        StringMatchContractCache.GetOrAdd(
            method,
            static m =>
            {
                if (m.DeclaringType is not { IsInterface: false } declaring)
                {
                    return null;
                }

                var contract = Array.Find(
                    declaring.GetInterfaces(),
                    i =>
                        i.IsGenericType
                        && i.GetGenericTypeDefinition() == typeof(IStringMatchValueObject<>)
                );

                return contract is not null
                    && Array.Exists(
                        declaring.GetInterfaceMap(contract).TargetMethods,
                        target => target.MethodHandle == m.MethodHandle
                    )
                    ? contract
                    : null;
            }
        );

    /// <summary>Cache of the judgement per method: the interface probe allocates, and query translation asks for the same methods repeatedly.</summary>
    private static readonly ConcurrentDictionary<MethodInfo, Type?> StringMatchContractCache =
        new();

    /// <summary>Builds the LIKE pattern expression for the given method name (e.g. '%' + escaped argument + '%').</summary>
    private SqlExpression BuildLikePattern(
        string methodName,
        SqlExpression argument,
        RelationalTypeMapping textMapping
    )
    {
        // Escape constants on the client side and fold them into a single constant pattern (the same shape as the QuickER version).
        // A TSelf overload constant (which EF Core folded from Create(...) into a constant) is unwrapped to its raw value first.
        if (argument is SqlConstantExpression { Value: var constantValue })
        {
            // A null pattern is unreachable when the query was built through SqlQuery.Where (the guard rejects it up front); kept as defense in depth.
            var raw =
                SqlParameterValue.Unwrap(constantValue) as string
                ?? throw new ArgumentNullException(
                    "value",
                    "The pattern argument of Contains/StartsWith/EndsWith in a query predicate must not be null."
                );
            var escaped = EscapeLikePattern(raw);
            var constantPattern = methodName switch
            {
                "Contains" => "%" + escaped + "%",
                "StartsWith" => escaped + "%",
                _ => "%" + escaped,
            };
            return _sqlExpressionFactory.Constant(constantPattern, textMapping);
        }

        // Parameters and the like are escaped on the SQL side. A null parameter cannot be detected at translation time; SqlQuery.Where
        // rejects it up front. One that slips through (a predicate run on the DbContext directly) makes the pattern NULL, which
        // matches no row. On Oracle, where concatenating NULL yields the rest of the string, the pattern would become '%%' and
        // match every row, so Translate adds an IS NOT NULL test there (see LikeEscapeBehavior.ConcatenationSkipsNull).
        SqlExpression escapedArgument = argument;

        foreach (var (from, to) in EscapePairs())
        {
            escapedArgument = _sqlExpressionFactory.Function(
                "REPLACE",
                [
                    escapedArgument,
                    _sqlExpressionFactory.Constant(from, textMapping),
                    _sqlExpressionFactory.Constant(to, textMapping),
                ],
                nullable: true,
                argumentsPropagateNullability: [true, false, false],
                typeof(string),
                textMapping
            );
        }

        var wildcard = _sqlExpressionFactory.Constant("%", textMapping);
        return methodName switch
        {
            "Contains" => _sqlExpressionFactory.Add(
                wildcard,
                _sqlExpressionFactory.Add(escapedArgument, wildcard)
            ),
            "StartsWith" => _sqlExpressionFactory.Add(escapedArgument, wildcard),
            _ => _sqlExpressionFactory.Add(wildcard, escapedArgument),
        };
    }

    /// <summary>
    /// Escapes LIKE wildcards (for constant patterns) with the same pairs, in the same order, as the REPLACE chain of a
    /// parameter pattern (<see cref="EscapePairs"/>), so that a constant and a parameter escape the same input alike.
    /// </summary>
    private string EscapeLikePattern(string value) =>
        EscapePairs().Aggregate(value, (escaped, pair) => escaped.Replace(pair.From, pair.To));
}

/// <summary>
/// EF Core member translator that translates a <c>.Value</c> member access of a value object
/// (derived from <see cref="ValueObjectBaseCore{TSelf, TValue}"/>) as a column of the raw value.
/// </summary>
/// <remarks>
/// This lets EF Core translate predicates that unwrap the raw value, such as <c>string.IsNullOrEmpty(x.Col.Value)</c>
/// or <c>x.Col.Value &gt; 100</c> (the same treatment as the QuickER SQL Server implementation's "a column may be a plain column or a value object's .Value").
/// Since the column is already projected onto the raw value by a converter, it is explicitly coerced to the raw value type with CONVERT
/// so that downstream translation does not re-read through the converter (an invalid cast). The target of the conversion is the
/// column's own store type, so the comparison neither rounds nor widens the stored value.
/// </remarks>
{{ infra_visibility }} sealed class ValueObjectValueMemberTranslator(
    ISqlExpressionFactory sqlExpressionFactory,
    IRelationalTypeMappingSource typeMappingSource
) : IMemberTranslator
{
    private readonly ISqlExpressionFactory _sqlExpressionFactory = sqlExpressionFactory;
    private readonly IRelationalTypeMappingSource _typeMappingSource = typeMappingSource;

    /// <summary>Returns a column of the raw value for a value object's .Value, or null otherwise.</summary>
    public SqlExpression? Translate(
        SqlExpression? instance,
        MemberInfo member,
        Type returnType,
        IDiagnosticsLogger<DbLoggerCategory.Query> logger
    )
    {
        if (
            instance is null
            || member.Name != "Value"
            || member.DeclaringType is not { IsGenericType: true } declaring
            || declaring.GetGenericTypeDefinition() != typeof(ValueObjectBaseCore<,>)
        )
        {
            return null;
        }

        // The conversion keeps the column's own store type (the precision, scale and length the model configured), so the
        // comparison runs on the value as stored: converting to the raw type's default mapping would round a decimal(10,4)
        // column to decimal(18,2) and widen a string column to its unbounded type. Only when the store type has no mapping
        // for the raw type does it fall back to the default one; a raw value type (string / int / decimal, etc.) with no
        // mapping at all is skipped (deferred to other translators).
        var typeMapping =
            (
                instance.TypeMapping?.StoreType is { } storeType
                    ? _typeMappingSource.FindMapping(returnType, storeType)
                    : null
            ) ?? _typeMappingSource.FindMapping(returnType);

        if (typeMapping is null)
        {
            return null;
        }

        return _sqlExpressionFactory.Convert(instance, returnType, typeMapping);
    }
}

/// <summary>
/// Behavior that absorbs dialect differences in LIKE predicates (escape character, <c>[</c> escaping, explicit ESCAPE clause).
/// </summary>
/// <remarks>
/// <list type="bullet">
///   <item><see cref="EscapeChar"/>: The LIKE escape character. The default is <c>\</c>. However, MySQL uses <c>!</c>
///   because a backslash in a string literal is misinterpreted as a quote-cancelling escape (used consistently in literals, REPLACE, and the ESCAPE clause).</item>
///   <item><see cref="EscapeBracket"/>: Whether to escape <c>[</c>. True only on SQL Server, where <c>[</c> starts a character class.</item>
///   <item><see cref="EmitEscapeClause"/>: Whether to emit <c>ESCAPE</c> explicitly. True for SQL Server / Oracle / SQLite, which have no default
///   escape character, and for MySQL, which uses a non-default character. False only for PostgreSQL (Npgsql), whose default is <c>\</c>
///   (no explicit clause needed). A provider it does not recognize gets the explicit clause, which the SQL standard defines and
///   which does not depend on a default escape character the database may not have.</item>
///   <item><see cref="ConcatenationSkipsNull"/>: Whether concatenating NULL yields the rest of the string instead of NULL. True
///   only on Oracle, where a NULL pattern parameter therefore needs an explicit test so that it matches no row.</item>
/// </list>
/// </remarks>
{{ infra_visibility }} readonly record struct LikeEscapeBehavior(
    string EscapeChar,
    bool EscapeBracket,
    bool EmitEscapeClause
)
{
    /// <summary>Whether concatenating NULL yields the rest of the string instead of NULL (Oracle).</summary>
    public bool ConcatenationSkipsNull { get; init; }

    /// <summary>Determines the dialect-specific LIKE escape behavior from the EF Core provider name.</summary>
    public static LikeEscapeBehavior FromProviderName(string? providerName)
    {
        var name = providerName ?? string.Empty;

        // SQL Server: [ starts a character class and must be escaped. No default escape character, so ESCAPE is emitted.
        if (name.Contains("SqlServer", StringComparison.Ordinal))
        {
            return new LikeEscapeBehavior("\\", EscapeBracket: true, EmitEscapeClause: true);
        }

        // Oracle: [ is not a wildcard and is not escaped (avoids ORA-01424). No default escape character, so ESCAPE is emitted.
        // Concatenating NULL yields the rest of the string.
        if (name.Contains("Oracle", StringComparison.Ordinal))
        {
            return new LikeEscapeBehavior("\\", EscapeBracket: false, EmitEscapeClause: true)
            {
                ConcatenationSkipsNull = true,
            };
        }

        // MySQL: uses ! as the escape character to avoid misinterpretation of \ in a string literal, and emits ESCAPE '!'.
        if (name.Contains("MySql", StringComparison.OrdinalIgnoreCase))
        {
            return new LikeEscapeBehavior("!", EscapeBracket: false, EmitEscapeClause: true);
        }

        // SQLite: LIKE has no default escape character, so ESCAPE is emitted. [ is not a wildcard.
        if (name.Contains("Sqlite", StringComparison.OrdinalIgnoreCase))
        {
            return new LikeEscapeBehavior("\\", EscapeBracket: false, EmitEscapeClause: true);
        }

        // PostgreSQL (Npgsql): [ is not a wildcard. The default escape character is \, so ESCAPE is not emitted.
        if (name.Contains("Npgsql", StringComparison.OrdinalIgnoreCase))
        {
            return new LikeEscapeBehavior("\\", EscapeBracket: false, EmitEscapeClause: false);
        }

        // Any other provider: [ is taken as a literal, and the standard ESCAPE clause is emitted rather than relying on a
        // default escape character the database may not have (without one, the escaped wildcards would match literally
        // as backslash + wildcard).
        return new LikeEscapeBehavior("\\", EscapeBracket: false, EmitEscapeClause: true);
    }
}

/// <summary>EF Core plugin that bundles the value object string translators (method and member).</summary>
{{ infra_visibility }} sealed class ValueObjectTranslatorPlugin
    : IMethodCallTranslatorPlugin,
        IMemberTranslatorPlugin
{
    private readonly IReadOnlyList<IMemberTranslator> _memberTranslators;

    /// <summary>Builds the translators from the SQL expression factory, type mapping source, and dialect provider.</summary>
    public ValueObjectTranslatorPlugin(
        ISqlExpressionFactory sqlExpressionFactory,
        IRelationalTypeMappingSource typeMappingSource,
        IDatabaseProvider databaseProvider
    )
    {
        var stringTypeMapping = typeMappingSource.FindMapping(typeof(string))!;
        var nonUnicodeStringTypeMapping =
            typeMappingSource.FindMapping(typeof(string), storeTypeName: null, unicode: false)
            ?? stringTypeMapping;
        var escapeBehavior = LikeEscapeBehavior.FromProviderName(databaseProvider.Name);
        Translators =
        [
            new ValueObjectStringMethodTranslator(
                sqlExpressionFactory,
                stringTypeMapping,
                nonUnicodeStringTypeMapping,
                escapeBehavior
            ),
        ];
        _memberTranslators =
        [
            new ValueObjectValueMemberTranslator(sqlExpressionFactory, typeMappingSource),
        ];
    }

    /// <summary>The method call translators.</summary>
    public IEnumerable<IMethodCallTranslator> Translators { get; }

    /// <summary>The member translators.</summary>
    IEnumerable<IMemberTranslator> IMemberTranslatorPlugin.Translators => _memberTranslators;
}

/// <summary>
/// DbContext options extension that registers the value object string translation plugin into EF Core's internal service container.
/// </summary>
/// <remarks>
/// Because <see cref="IMethodCallTranslatorPlugin"/> / <see cref="IMemberTranslatorPlugin"/> are services defined by EF Core,
/// they are added with <c>TryAddEnumerable</c> (without clobbering existing plugins) rather than as provider-specific services.
/// </remarks>
{{ infra_visibility }} sealed class ValueObjectTranslationDbContextOptionsExtension : IDbContextOptionsExtension
{
    private DbContextOptionsExtensionInfo? _info;

    /// <summary>The extension information (log fragment, contribution to the service provider cache key).</summary>
    public DbContextOptionsExtensionInfo Info => _info ??= new ExtensionInfo(this);

    /// <summary>Registers the translation plugin into EF Core's internal service container.</summary>
    public void ApplyServices(IServiceCollection services)
    {
        services.AddScoped<ValueObjectTranslatorPlugin>();
        services.TryAddEnumerable(
            ServiceDescriptor.Scoped<IMethodCallTranslatorPlugin, ValueObjectTranslatorPlugin>(
                sp => sp.GetRequiredService<ValueObjectTranslatorPlugin>()
            )
        );
        services.TryAddEnumerable(
            ServiceDescriptor.Scoped<IMemberTranslatorPlugin, ValueObjectTranslatorPlugin>(
                sp => sp.GetRequiredService<ValueObjectTranslatorPlugin>()
            )
        );
    }

    /// <summary>No validation is needed (there are no configuration-dependent constraints).</summary>
    public void Validate(IDbContextOptions options) { }

    /// <summary>Metadata for the extension. It changes the service configuration but is not a dialect provider.</summary>
    private sealed class ExtensionInfo(IDbContextOptionsExtension extension)
        : DbContextOptionsExtensionInfo(extension)
    {
        /// <summary>This is not a database provider extension.</summary>
        public override bool IsDatabaseProvider => false;

        /// <summary>The fragment to write to the log.</summary>
        public override string LogFragment => "using ValueObjectTranslation ";

        /// <summary>Contribution to the service provider cache key (a constant means the configuration is considered identical).</summary>
        public override int GetServiceProviderHashCode() => 0;

        /// <summary>The same service provider may be reused for an identical service configuration.</summary>
        public override bool ShouldUseSameServiceProvider(DbContextOptionsExtensionInfo other) =>
            other is ExtensionInfo;

        /// <summary>Adds the enabled flag to the debug information.</summary>
        public override void PopulateDebugInfo(IDictionary<string, string> debugInfo) =>
            debugInfo["ValueObjectTranslation"] = "1";
    }
}
{{~ end ~}}

/// <summary>
/// Connection interceptor that sets SQLite's busy timeout on every connection EF Core opens, so that a write waits for a
/// lock held by another connection up to the command timeout instead of failing at once.
/// </summary>
/// <remarks>
/// <para>
/// Microsoft.Data.Sqlite waits for a lock only on the first step of a statement. EF Core writes updates and deletes as
/// <c>UPDATE … RETURNING 1</c> / <c>DELETE … RETURNING 1</c>, which commit on a later step when no transaction is open, so
/// without a busy timeout they fail with "database is locked" as soon as another connection is reading. With the busy
/// timeout SQLite itself waits on every step.
/// </para>
/// <para>
/// The limit is the DbContext's command timeout when one is configured, otherwise the connection's <c>Default Timeout</c>
/// (30 seconds unless the connection string sets it); <c>0</c> waits without a limit. It is set when the connection
/// opens, so a command timeout changed on a context whose connection is open (<c>Database.SetCommandTimeout</c>) takes
/// effect from the next connection the context opens.
/// </para>
/// <para>
/// Connections of other providers are left untouched, so the interceptor can be added whatever the provider.
/// <c>AddGeneratedEfCoreRepositories</c> adds it; when building the options yourself, add <see cref="Instance"/> with
/// <c>AddInterceptors</c>.
/// </para>
/// </remarks>
public sealed class SqliteBusyTimeoutInterceptor : DbConnectionInterceptor
{
    /// <summary>The full name of the connection type the interceptor applies to (Microsoft.Data.Sqlite is not referenced).</summary>
    private const string SqliteConnectionTypeName = "Microsoft.Data.Sqlite.SqliteConnection";

    private SqliteBusyTimeoutInterceptor() { }

    /// <summary>The shared instance (the interceptor holds no state).</summary>
    public static SqliteBusyTimeoutInterceptor Instance { get; } = new();

    /// <summary>Sets the busy timeout on the SQLite connection that has just opened.</summary>
    public override void ConnectionOpened(DbConnection connection, ConnectionEndEventData eventData)
    {
        using var command = CreateBusyTimeoutCommand(connection, eventData);
        command?.ExecuteNonQuery();
    }

    /// <summary>Sets the busy timeout on the SQLite connection that has just opened.</summary>
    public override async Task ConnectionOpenedAsync(
        DbConnection connection,
        ConnectionEndEventData eventData,
        CancellationToken cancellationToken = default
    )
    {
        var command = CreateBusyTimeoutCommand(connection, eventData);

        if (command is null)
        {
            return;
        }

        await using (command.ConfigureAwait(false))
        {
            await command.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>Creates the <c>PRAGMA busy_timeout</c> command for a SQLite connection, or returns <c>null</c> for any other connection.</summary>
    private static DbCommand? CreateBusyTimeoutCommand(DbConnection connection, ConnectionEndEventData eventData)
    {
        if (!IsSqliteConnection(connection))
        {
            return null;
        }

        // A new command carries the connection's Default Timeout, the timeout a command runs with when the context sets none
        var command = connection.CreateCommand();
        var timeoutSeconds = eventData.Context?.Database.GetCommandTimeout() ?? command.CommandTimeout;
        command.CommandText =
            "PRAGMA busy_timeout = " + ResolveBusyTimeout(timeoutSeconds).ToString(CultureInfo.InvariantCulture);
        return command;
    }

    /// <summary>Whether the connection is a Microsoft.Data.Sqlite connection (or derives from one).</summary>
    private static bool IsSqliteConnection(DbConnection connection)
    {
        for (var type = connection.GetType(); type is not null; type = type.BaseType)
        {
            if (type.FullName == SqliteConnectionTypeName)
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>The busy timeout for a timeout in seconds: <c>0</c> (no timeout) and values too large for milliseconds wait without a limit.</summary>
    private static int ResolveBusyTimeout(int timeoutSeconds) =>
        timeoutSeconds <= 0 || timeoutSeconds > int.MaxValue / 1000
            ? int.MaxValue
            : timeoutSeconds * 1000;
}

/// <summary>
/// Command interceptor that, on SQL Server, binds a compared value with its own type when it does not fit the SQL type EF Core
/// gave its parameter, so that a query answers as C# does.
/// </summary>
/// <remarks>
/// <para>
/// EF Core types a parameter after the column it is compared with: a <c>decimal(10,2)</c> column gives its precision and
/// scale, a column configured with <c>IsUnicode(false)</c> makes the parameter non-Unicode text, and an integer column compared
/// with a decimal is cast to EF Core's default decimal type (<c>decimal(38,19)</c> with the generated <c>QuickErDbContext</c>,
/// <c>decimal(18,2)</c> otherwise). SqlClient then converts the value before sending it: against <c>decimal(10,2)</c>, <c>1.234</c>
/// becomes <c>1.23</c>, a value beyond the precision throws <see cref="ArgumentException"/>, and a character outside ASCII becomes
/// <c>?</c>. The query then returns other rows than C# would, or fails.
/// </para>
/// <para>
/// Before a query runs, a decimal parameter whose value has more fractional digits than the scale or more integral digits than
/// the precision allows loses its precision and scale, and a non-Unicode text parameter whose value holds a character outside
/// ASCII becomes Unicode text; SqlClient then takes the type from the value, and the server converts the column instead.
/// A value that fits keeps the type EF Core gave it, so the SQL and an index on the column are used as before. The rule is the one
/// the QuickER Repository for SQL Server applies to the values it compares.
/// </para>
/// <para>
/// Only the commands of LINQ queries and of <c>ExecuteDelete</c> / <c>ExecuteUpdate</c> are changed. The commands of
/// <c>SaveChanges</c> are left as they are, so a value that does not fit is still converted the way the column stores it.
/// Connections of other providers are left untouched, so the interceptor can be added whatever the provider.
/// <c>AddGeneratedEfCoreRepositories</c> adds it; when building the options yourself, add <see cref="Instance"/> with
/// <c>AddInterceptors</c>.
/// </para>
/// </remarks>
public sealed class SqlServerQueryParameterInterceptor : DbCommandInterceptor
{
    /// <summary>The full name of the connection type the interceptor applies to (Microsoft.Data.SqlClient is not referenced).</summary>
    private const string SqlConnectionTypeName = "Microsoft.Data.SqlClient.SqlConnection";

    private SqlServerQueryParameterInterceptor() { }

    /// <summary>The shared instance (the interceptor holds no state).</summary>
    public static SqlServerQueryParameterInterceptor Instance { get; } = new();

    /// <summary>Retypes the parameters whose value does not fit before the reader runs.</summary>
    public override InterceptionResult<DbDataReader> ReaderExecuting(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult<DbDataReader> result
    )
    {
        Retype(command, eventData);
        return result;
    }

    /// <summary>Retypes the parameters whose value does not fit before the reader runs.</summary>
    public override ValueTask<InterceptionResult<DbDataReader>> ReaderExecutingAsync(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult<DbDataReader> result,
        CancellationToken cancellationToken = default
    )
    {
        Retype(command, eventData);
        return ValueTask.FromResult(result);
    }

    /// <summary>Retypes the parameters whose value does not fit before the scalar command runs.</summary>
    public override InterceptionResult<object> ScalarExecuting(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult<object> result
    )
    {
        Retype(command, eventData);
        return result;
    }

    /// <summary>Retypes the parameters whose value does not fit before the scalar command runs.</summary>
    public override ValueTask<InterceptionResult<object>> ScalarExecutingAsync(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult<object> result,
        CancellationToken cancellationToken = default
    )
    {
        Retype(command, eventData);
        return ValueTask.FromResult(result);
    }

    /// <summary>Retypes the parameters whose value does not fit before the command runs (<c>ExecuteDelete</c> / <c>ExecuteUpdate</c>).</summary>
    public override InterceptionResult<int> NonQueryExecuting(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult<int> result
    )
    {
        Retype(command, eventData);
        return result;
    }

    /// <summary>Retypes the parameters whose value does not fit before the command runs (<c>ExecuteDelete</c> / <c>ExecuteUpdate</c>).</summary>
    public override ValueTask<InterceptionResult<int>> NonQueryExecutingAsync(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult<int> result,
        CancellationToken cancellationToken = default
    )
    {
        Retype(command, eventData);
        return ValueTask.FromResult(result);
    }

    /// <summary>Retypes every parameter of a query command on a SQL Server connection whose value does not fit its type.</summary>
    private static void Retype(DbCommand command, CommandEventData eventData)
    {
        if (
            !IsSqlServerConnection(command.Connection)
            || eventData.CommandSource
                is not (CommandSource.LinqQuery or CommandSource.ExecuteDelete or CommandSource.ExecuteUpdate)
        )
        {
            return;
        }

        foreach (DbParameter parameter in command.Parameters)
        {
            if (parameter.Value is null or DBNull)
            {
                continue;
            }

            if (
                parameter.DbType == System.Data.DbType.Decimal
                && parameter.Precision > 0
                && !FitsDecimal(parameter.Value, parameter.Precision, parameter.Scale)
            )
            {
                parameter.Precision = 0;
                parameter.Scale = 0;
            }
            else if (
                parameter.DbType
                    is System.Data.DbType.AnsiString
                        or System.Data.DbType.AnsiStringFixedLength
                && parameter.Value is string text
                && !text.All(char.IsAscii)
            )
            {
                parameter.DbType = System.Data.DbType.String;
                parameter.Size = 0;
            }
        }
    }

    /// <summary>Whether the connection is a Microsoft.Data.SqlClient connection (or derives from one).</summary>
    private static bool IsSqlServerConnection(DbConnection? connection)
    {
        for (var type = connection?.GetType(); type is not null; type = type.BaseType)
        {
            if (type.FullName == SqlConnectionTypeName)
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>Whether a number fits decimal(precision, scale): its significant fractional digits and its integral digits.</summary>
    /// <remarks>Judged on the value itself, as the QuickER Repository for SQL Server judges it: 1.500m fits decimal(10,2).</remarks>
    private static bool FitsDecimal(object value, byte precision, byte scale)
    {
        if (!TryExactDecimal(value, out var number))
        {
            return false;
        }

        // Dividing by 1 with trailing zeros drops the trailing zeros of the scale (1.500m becomes 1.5m)
        var normalized = number / 1.000000000000000000000000000000000m;
        var fractionalDigits = (decimal.GetBits(normalized)[3] >> 16) & 0xFF;
        var integral = Math.Abs(decimal.Truncate(normalized));
        var integralDigits = integral == 0m ? 0 : integral.ToString(CultureInfo.InvariantCulture).Length;

        return fractionalDigits <= scale && integralDigits <= precision - scale;
    }

    /// <summary>The number as a decimal when the conversion is exact (a double outside decimal's range, NaN, or an infinity is not).</summary>
    private static bool TryExactDecimal(object value, out decimal number)
    {
        switch (value)
        {
            case decimal d:
                number = d;
                return true;
            case double d when double.IsFinite(d) && Math.Abs(d) < 7.9e28:
                number = (decimal)d;
                return (double)number == d;
            case float f when float.IsFinite(f) && Math.Abs(f) < 7.9e28f:
                number = (decimal)f;
                return (float)number == f;
            case sbyte or byte or short or ushort or int or uint or long or ulong:
                number = Convert.ToDecimal(value, CultureInfo.InvariantCulture);
                return true;
            default:
                number = 0m;
                return false;
        }
    }
}

/// <summary>EF Core version of the entity-agnostic raw SQL executor (runs ADO directly on the DbContext's connection).</summary>
/// <remarks>
/// <para>
/// Because the mapping rules of EF Core's FromSqlRaw / SqlQueryRaw do not match the existing SQL Server version
/// (strict all-columns-required, lenient projection, single-value mode), it executes a <see cref="DbCommand"/> directly
/// on the <see cref="DbConnection"/> of <typeparamref name="TContext"/> and shares the mapping and binding implementation with the existing version
/// (the semantics are as defined by <see cref="ISqlExecutor"/>).
/// </para>
/// <para>
/// It does not depend on a concrete DbContext and takes <typeparamref name="TContext"/> (derived from <see cref="DbContext"/>).
/// The concrete type is closed over on the generation side (DI registration, per-entity implementations).
/// </para>
/// <para>Because it is stateless (it holds only the context factory), it can be registered as a Singleton in DI.</para>
/// </remarks>
/// <typeparam name="TContext">The concrete type of the DbContext that provides the connection.</typeparam>
public sealed partial class EfCoreSqlExecutor<TContext>(IDbContextFactory<TContext> contextFactory)
    : ISqlExecutor
    where TContext : DbContext
{
    /// <summary>The source that creates the DbContext.</summary>
    private readonly IDbContextFactory<TContext> _contextFactory = contextFactory;

    /// <summary>Executes a raw SQL SELECT and returns the result rows mapped strictly (all columns required) to {TEntity}.</summary>
    /// <remarks>
    /// The unbounded binary columns are required too, unlike in the QuickER repositories: EF Core writes every column when it
    /// saves an entity, so an entity read without them would carry them in their unread state, and its next save would
    /// write that state over the stored value. A result set that leaves one out is refused, naming the column.
    /// </remarks>
    public async Task<IReadOnlyList<TEntity>> QueryBySqlAsync<TEntity>(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    )
        where TEntity : EntityBaseCore, new()
    {
        ArgumentNullException.ThrowIfNull(sql);

        var metadata = EntitySaveMetadata.For(typeof(TEntity));
        var items = new List<TEntity>();

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);
        await using var command = await CreateCommandAsync(
            context,
            sql,
            parameters,
            cancellationToken
        ).ConfigureAwait(false);
        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        // The column ordinals are resolved once for the result set (on the first row, because some providers only
        // expose the result schema after a successful Read) and reused for every row
        EntitySaveMetadata.RawSqlRowPlan? plan = null;

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            if (plan is null)
            {
                plan = metadata.CreateRawSqlRowPlan(reader);
                RequireUnboundedBinaryColumns(metadata, plan, typeof(TEntity));
            }

            items.Add(metadata.MapEntityFromRawSql<TEntity>(reader, plan));
        }

        return items;
    }

    /// <summary>Refuses a raw SQL result set that leaves out an unbounded binary column of the entity (see <see cref="QueryBySqlAsync{TEntity}"/>).</summary>
    private static void RequireUnboundedBinaryColumns(
        EntitySaveMetadata metadata,
        EntitySaveMetadata.RawSqlRowPlan plan,
        Type entityType
    )
    {
        if (plan.ExcludedOrdinals.Length == metadata.ExcludedProperties.Count)
        {
            return;
        }

        var missing = metadata
            .ExcludedProperties.Where(property =>
                plan.ExcludedOrdinals.All(found => found.Property != property)
            )
            .Select(property => metadata.ColumnNameByProperty[property]);

        throw new InvalidOperationException(
            $"The raw SQL SELECT for {entityType.Name} must include its unbounded binary columns too ({string.Join(", ", missing)}): EF Core writes every column when it saves the entity, so an entity read without them would have the stored values overwritten. Use SELECT * or list them."
        );
    }

    /// <summary>Executes a raw SQL SELECT and returns the result rows leniently projected onto an arbitrary <typeparamref name="TResult"/>.</summary>
    public async Task<IReadOnlyList<TResult>> QueryProjectionBySqlAsync<TResult>(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(sql);

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);
        await using var command = await CreateCommandAsync(
            context,
            sql,
            parameters,
            cancellationToken
        ).ConfigureAwait(false);
        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        // Projection mapping (single-value mode, DTO mode) uses the single shared helper path.
        return await RawSqlMapper.ReadProjectionRowsAsync<TResult>(reader, cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Executes raw SQL (UPDATE/DELETE/any DML) and returns the number of affected rows.</summary>
    /// <remarks>
    /// Opens and closes a DbContext (connection) per call (no transaction argument). To execute multiple statements atomically,
    /// write the transaction into the SQL of a single call on SQL Server (<c>SET XACT_ABORT ON; BEGIN TRAN ... COMMIT</c>). On
    /// SQLite do not: when a statement of a <c>BEGIN; ... COMMIT;</c> in one call fails, the transaction stays open on a
    /// connection that goes back to the pool. Run the statements inside a transaction of your own DbContext
    /// (<c>Database.BeginTransaction</c>) instead.
    /// </remarks>
    public async Task<int> ExecuteSqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(sql);

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);
        await using var command = await CreateCommandAsync(
            context,
            sql,
            parameters,
            cancellationToken
        ).ConfigureAwait(false);

        return await command.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Executes raw SQL and returns a single scalar value (no match / DBNull yields <c>default</c>).</summary>
    public async Task<TResult?> ExecuteScalarSqlAsync<TResult>(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(sql);

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);
        await using var command = await CreateCommandAsync(
            context,
            sql,
            parameters,
            cancellationToken
        ).ConfigureAwait(false);

        var scalar = await command.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false);
        return RawSqlMapper.ConvertSingleValue<TResult>(scalar is DBNull ? null : scalar);
    }

    /// <summary>Opens the connection and creates a DbCommand with the SQL and parameters bound (the binding convention is identical to the SQL Server version).</summary>
    private static async Task<DbCommand> CreateCommandAsync(
        TContext context,
        string sql,
        object? parameters,
        CancellationToken cancellationToken
    )
    {
        // The connection is owned by the DbContext and is closed when the DbContext is disposed.
        await context.Database.OpenConnectionAsync(cancellationToken).ConfigureAwait(false);

        return EfCoreCommands.Create(context.Database, sql, parameters);
    }
}

/// <summary>Creates the raw SQL commands EF Core mode runs on a DbContext's own connection.</summary>
internal static class EfCoreCommands
{
    /// <summary>
    /// Creates a command on the context's connection (which the caller has opened) with the SQL and parameters bound.
    /// </summary>
    /// <remarks>
    /// The command joins the context's current transaction, if any, and carries over the command timeout configured on
    /// the context: a command created from the connection sees neither (with no timeout configured, it keeps the
    /// connection's own default). When binding the parameters fails, the command is disposed before the exception
    /// propagates, since the caller never receives it.
    /// </remarks>
    internal static DbCommand Create(DatabaseFacade database, string sql, object? parameters)
    {
        var command = database.GetDbConnection().CreateCommand();

        try
        {
            command.CommandText = sql;
            command.Transaction = database.CurrentTransaction?.GetDbTransaction();

            if (database.GetCommandTimeout() is { } timeout)
            {
                command.CommandTimeout = timeout;
            }

            RawSqlMapper.BindParameters(command, parameters);
            return command;
        }
        catch
        {
            command.Dispose();
            throw;
        }
    }
}

/// <summary>
/// Rewrites, for EF Core's SQLite provider, an equality or an IN between an integer and a <c>decimal</c> into a comparison of
/// integers, so that it answers as C# does.
/// </summary>
/// <remarks>
/// <para>
/// C# widens an integer to <c>decimal</c> when it is compared with one (<c>x.Qty == 10m</c>). EF Core's SQLite provider stores a
/// <c>decimal</c> as text and writes such an equality as a comparison of text, <c>CAST("qty" AS TEXT) = '10.0'</c>, so an integer
/// value never matches: <c>==</c> returns no row, <c>!=</c> returns every row, and an IN list drops the integer elements.
/// Its ordering comparisons compare numbers and are left as they are.
/// </para>
/// <para>
/// An equality between such a widened integer and a value that does not depend on the row (a variable, a constant) becomes
/// <c>Matches(value) &amp;&amp; (long?)x == KeyOf(value)</c>, its negation for <c>!=</c>, and <c>Contains</c> over such values becomes
/// <c>KeysOf(values).Contains((long?)x)</c>. The helpers look at the values only, so EF Core evaluates them on the client and sends
/// their results as parameters: a <c>null</c> stays <c>null</c>, an integral value within <c>long</c> becomes that integer, and any
/// other value matches no row. The rewritten condition means what C# means, nulls included.
/// </para>
/// </remarks>
internal static class SqliteIntegralDecimalEquality
{
    /// <summary>The name EF Core's SQLite provider reports (Microsoft.EntityFrameworkCore.Sqlite is not referenced).</summary>
    private const string SqliteProviderName = "Microsoft.EntityFrameworkCore.Sqlite";

    private static readonly MethodInfo MatchesMethod = typeof(SqliteIntegralDecimalEquality).GetMethod(
        nameof(Matches),
        BindingFlags.NonPublic | BindingFlags.Static
    )!;

    private static readonly MethodInfo KeyOfMethod = typeof(SqliteIntegralDecimalEquality).GetMethod(
        nameof(KeyOf),
        BindingFlags.NonPublic | BindingFlags.Static
    )!;

    private static readonly MethodInfo KeysOfMethod = typeof(SqliteIntegralDecimalEquality).GetMethod(
        nameof(KeysOf),
        BindingFlags.NonPublic | BindingFlags.Static
    )!;

    private static readonly MethodInfo ListContainsMethod = typeof(List<long?>).GetMethod(
        nameof(List<long?>.Contains),
        [typeof(long?)]
    )!;

    /// <summary>Whether the context runs on EF Core's SQLite provider.</summary>
    internal static bool AppliesTo(DbContext context) => context.Database.ProviderName == SqliteProviderName;

    /// <summary>Returns the predicate with every such equality and IN rewritten (the same instance when there is none).</summary>
    internal static Expression<Func<TEntity, bool>> Rewrite<TEntity>(Expression<Func<TEntity, bool>> predicate)
    {
        var body = new Rewriter().Visit(predicate.Body)!;

        return ReferenceEquals(body, predicate.Body)
            ? predicate
            : Expression.Lambda<Func<TEntity, bool>>(body, predicate.Parameters);
    }

    /// <summary>Whether a compared value can equal an integer: <c>null</c>, or an integral value within <c>long</c>.</summary>
    private static bool Matches(decimal? value) =>
        value is not { } number
        || (number == decimal.Truncate(number) && number >= long.MinValue && number <= long.MaxValue);

    /// <summary>The integer a compared value equals, or <c>null</c> (a <c>null</c> value, or one <see cref="Matches"/> rejects).</summary>
    private static long? KeyOf(decimal? value) => value is { } number && Matches(number) ? (long)number : null;

    /// <summary>The integers (and <c>null</c>) an integer can equal among the values of a list; the other values are dropped.</summary>
    private static List<long?> KeysOf(System.Collections.IEnumerable values)
    {
        var keys = new List<long?>();

        foreach (var item in values)
        {
            var value = item is null ? (decimal?)null : Convert.ToDecimal(item, CultureInfo.InvariantCulture);

            if (Matches(value))
            {
                keys.Add(KeyOf(value));
            }
        }

        return keys;
    }

    /// <summary>The integer widened to <c>decimal</c> (a <c>Convert</c> from sbyte, byte, short, ushort, int, uint or long), or null.</summary>
    private static Expression? WidenedInteger(Expression expression)
    {
        if (
            expression is not UnaryExpression { NodeType: ExpressionType.Convert } convert
            || (Nullable.GetUnderlyingType(convert.Type) ?? convert.Type) != typeof(decimal)
        )
        {
            return null;
        }

        var source = Nullable.GetUnderlyingType(convert.Operand.Type) ?? convert.Operand.Type;

        return source == typeof(sbyte)
            || source == typeof(byte)
            || source == typeof(short)
            || source == typeof(ushort)
            || source == typeof(int)
            || source == typeof(uint)
            || source == typeof(long)
            ? convert.Operand
            : null;
    }

    /// <summary>Whether the expression reads no lambda parameter (so EF Core evaluates it on the client).</summary>
    private static bool IsRowFree(Expression expression)
    {
        var finder = new ParameterFinder();
        finder.Visit(expression);

        return !finder.Found;
    }

    private sealed class ParameterFinder : ExpressionVisitor
    {
        public bool Found { get; private set; }

        protected override Expression VisitParameter(ParameterExpression node)
        {
            Found = true;
            return node;
        }
    }

    private sealed class Rewriter : ExpressionVisitor
    {
        protected override Expression VisitBinary(BinaryExpression node)
        {
            if (node.NodeType is ExpressionType.Equal or ExpressionType.NotEqual)
            {
                foreach (var (widened, other) in new[] { (node.Left, node.Right), (node.Right, node.Left) })
                {
                    if (WidenedInteger(widened) is { } integer && IsRowFree(other))
                    {
                        var value = Expression.Convert(other, typeof(decimal?));
                        Expression equal = Expression.AndAlso(
                            Expression.Call(MatchesMethod, value),
                            Expression.Equal(
                                Expression.Convert(integer, typeof(long?)),
                                Expression.Call(KeyOfMethod, value)
                            )
                        );

                        return node.NodeType == ExpressionType.Equal ? equal : Expression.Not(equal);
                    }
                }
            }

            return base.VisitBinary(node);
        }

        protected override Expression VisitMethodCall(MethodCallExpression node)
        {
            if (
                node.Method.Name == nameof(Enumerable.Contains)
                && ContainsOperands(node) is var (values, item)
                && WidenedInteger(item) is { } integer
                && typeof(System.Collections.IEnumerable).IsAssignableFrom(values.Type)
                && IsRowFree(values)
            )
            {
                return Expression.Call(
                    Expression.Call(KeysOfMethod, values),
                    ListContainsMethod,
                    Expression.Convert(integer, typeof(long?))
                );
            }

            return base.VisitMethodCall(node);
        }

        /// <summary>
        /// The values and the item of a <c>Contains</c> call: an instance call (<c>list.Contains(item)</c>), or a static one
        /// (<c>Enumerable.Contains</c>, and <c>MemoryExtensions.Contains</c>, to which C# 14 binds <c>array.Contains(item)</c> in an
        /// expression tree, with the span conversion of the array taken off). A call with a comparer other than the default is
        /// left alone.
        /// </summary>
        private static (Expression Values, Expression Item)? ContainsOperands(MethodCallExpression node)
        {
            if (node.Object is not null)
            {
                return node.Arguments.Count == 1 ? (node.Object, node.Arguments[0]) : null;
            }

            if (
                node.Arguments.Count is < 2 or > 3
                || (node.Arguments.Count == 3 && node.Arguments[2] is not ConstantExpression { Value: null })
            )
            {
                return null;
            }

            var values = node.Arguments[0] switch
            {
                MethodCallExpression { Method.Name: "op_Implicit", Arguments: [var source] } => source,
                UnaryExpression { NodeType: ExpressionType.Convert, Method.Name: "op_Implicit" } convert => convert.Operand,
                var other => other,
            };

            return (values, node.Arguments[1]);
        }
    }
}

/// <summary>
/// EF Core executor for <see cref="SqlQuery{TEntity}"/>. Composes the captured expression trees into a LINQ query
/// and executes it on a short-lived <typeparamref name="TContext"/> (AsNoTracking).
/// </summary>
/// <remarks>
/// Where applies the captured predicate expressions as-is and leaves translation to each dialect to the EF Core provider.
/// OrderBy strips the boxing to object? (Convert) and composes OrderBy / ThenBy with the actual key type.
/// Include builds dot paths such as "Orders.Details" from the <see cref="IncludeNode"/> tree and applies them.
/// The retrieved graph is normalized to RowState=Unchanged, the same as the existing SQL Server version's mapping.
/// It does not depend on a concrete DbContext and takes <typeparamref name="TContext"/> (derived from <see cref="DbContext"/>).
/// </remarks>
/// <typeparam name="TEntity">The entity type being queried.</typeparam>
/// <typeparam name="TContext">The concrete type of the DbContext that executes the query.</typeparam>
{{ infra_visibility }} sealed class EfCoreSqlQueryExecutor<TEntity, TContext>(
    IDbContextFactory<TContext> contextFactory
) : ISqlQueryExecutor<TEntity>
    where TEntity : EntityBaseCore
    where TContext : DbContext
{
    /// <summary>The source that creates the DbContext.</summary>
    private readonly IDbContextFactory<TContext> _contextFactory = contextFactory;

    /// <summary>Retrieves the list of entities matching the conditions (together with the specified Includes).</summary>
    public async Task<IReadOnlyList<TEntity>> ToListAsync(
        SqlQueryPlan<TEntity> plan,
        CancellationToken cancellationToken
    )
    {
        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        var query = ApplyOrderings(
            ApplyIncludes(ApplyPredicates(context, context.Set<TEntity>().AsNoTracking(), plan), plan),
            plan
        );
        var items = await ApplyPaging(query, plan).ToListAsync(cancellationToken).ConfigureAwait(false);

        foreach (var item in items)
        {
            MarkGraphUnchanged(item, plan.Includes);
        }

        return items;
    }

    /// <summary>Retrieves entities matching the conditions as a projection (when column references only and no Include, EF Core performs a server-side projection).</summary>
    /// <remarks>
    /// If there are Includes, or column references cannot be safely extracted from the selector, it falls back to the
    /// conventional path (fetch all columns → project in memory). When pruning is possible, <c>Select(selector)</c> is applied
    /// directly to the <see cref="IQueryable{T}"/> with filters, orderings, and paging applied, letting EF Core narrow the columns.
    /// </remarks>
    public async Task<IReadOnlyList<TResult>> ToProjectionListAsync<TResult>(
        SqlQueryPlan<TEntity> plan,
        Expression<Func<TEntity, TResult>> selector,
        CancellationToken cancellationToken
    )
    {
        // Server-side projection via direct EF Core Select applies only when there is no Include and the selector has column references only
        // (feasibility is determined by the same collector as ADO).
        var prunable =
            plan.Includes.Count == 0
            && ProjectionColumnCollector.TryCollect(selector, out var referenced)
            && EntitySaveMetadata.For(typeof(TEntity)).CanPruneProjection(referenced);

        if (!prunable)
        {
            // Fallback: fetch all columns (including Includes), then project in memory.
            var entities = await ToListAsync(plan, cancellationToken).ConfigureAwait(false);
            return entities.Select(QuerySelectorCache.GetOrCompile(selector)).ToList();
        }

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        // Includes are assumed absent, so none are applied. Apply orderings and paging, then apply Select directly.
        var query = ApplyPaging(
            ApplyOrderings(ApplyPredicates(context, context.Set<TEntity>().AsNoTracking(), plan), plan),
            plan
        );

        return await query.Select(selector).ToListAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Retrieves the first entity matching the conditions (together with the specified Includes), or null when there is no match.</summary>
    public async Task<TEntity?> FirstOrDefaultAsync(
        SqlQueryPlan<TEntity> plan,
        CancellationToken cancellationToken
    )
    {
        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        var query = ApplyOrderings(
            ApplyIncludes(ApplyPredicates(context, context.Set<TEntity>().AsNoTracking(), plan), plan),
            plan
        );

        // As in the existing version, Take is fixed at 1 and only Skip is honored.
        if (plan.Skip is int skip)
        {
            query = query.Skip(skip);
        }

        var item = await query.FirstOrDefaultAsync(cancellationToken).ConfigureAwait(false);

        if (item is not null)
        {
            MarkGraphUnchanged(item, plan.Includes);
        }

        return item;
    }

    /// <summary>Retrieves the number of matching records within the plan's page (Includes are not involved).</summary>
    public async Task<int> CountAsync(
        SqlQueryPlan<TEntity> plan,
        CancellationToken cancellationToken
    )
    {
        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        return await ApplyPaging(ApplyOrderings(ApplyPredicates(context, context.Set<TEntity>().AsNoTracking(), plan), plan), plan)
            .CountAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Retrieves whether any matching record exists within the plan's page (Includes are not involved).</summary>
    public async Task<bool> AnyAsync(
        SqlQueryPlan<TEntity> plan,
        CancellationToken cancellationToken
    )
    {
        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        return await ApplyPaging(ApplyOrderings(ApplyPredicates(context, context.Set<TEntity>().AsNoTracking(), plan), plan), plan)
            .AnyAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Bulk-deletes the rows matching the conditions. When cascadeDelete=true, descendants are also deleted following the FK chain.</summary>
    /// <returns>The number of rows deleted, the matching rows and (with cascadeDelete) their descendants together.</returns>
    /// <remarks>
    /// With cascadeDelete, the rows to delete are the ones the conditions match before anything is deleted: their keys are
    /// read first, inside the transaction, and the descendants and then the rows themselves are deleted by those keys. The
    /// conditions are not evaluated again after the descendants are gone, so a condition that reads a cascade navigation
    /// (<c>o =&gt; o.OrderLines.Any()</c>) deletes the matching rows together with their descendants rather than only the
    /// descendants. A cyclic cascade is refused before any statement runs.
    /// </remarks>
    public async Task<int> ExecuteDeleteAsync(
        SqlQueryPlan<TEntity> plan,
        bool cascadeDelete,
        CancellationToken cancellationToken
    )
    {
        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);
        var roots = ApplyPredicates(context, context.Set<TEntity>(), plan);

        if (!cascadeDelete)
        {
            return await roots.ExecuteDeleteAsync(cancellationToken).ConfigureAwait(false);
        }

        // Whether the cascade is cyclic depends on the navigation metadata alone, so it is settled before a transaction is
        // opened and any statement runs
        ThrowIfCascadeIsCyclic(typeof(TEntity), new HashSet<Type> { typeof(TEntity) });

        // Cascade: run ExecuteDelete in descendants → root order within a single transaction (same DELETE statement order as
        // the existing version). The transaction is opened inside the execution strategy, which a retrying strategy requires;
        // an attempt that fails rolls back as a whole, so running the deletes again on a retry is safe.
        return await context
            .Database.CreateExecutionStrategy()
            .ExecuteAsync(
                async attemptToken =>
                {
                    await using var transaction = await context.Database.BeginTransactionAsync(
                        attemptToken
                    ).ConfigureAwait(false);
                    var deleteTask = (Task<int>)
                        _deleteByRootKeysMethod
                            .MakeGenericMethod(_metadata.KeyProperty.PropertyType)
                            .Invoke(null, new object[] { context, roots, attemptToken })!;
                    var rows = await deleteTask.ConfigureAwait(false);
                    await transaction.CommitAsync(attemptToken).ConfigureAwait(false);
                    return rows;
                },
                cancellationToken
            ).ConfigureAwait(false);
    }

    /// <summary>The metadata of the root entity type.</summary>
    private static readonly EntitySaveMetadata _metadata = EntitySaveMetadata.For(typeof(TEntity));

    /// <summary>How many root keys one round of deletes names (each key is one parameter of the round's condition).</summary>
    /// <remarks>
    /// The keys go out as separate parameters rather than as one collection parameter: EF Core sends a collection parameter
    /// to SQL Server through OPENJSON, which a database below compatibility level 130 does not have. 500 keys stay well below
    /// SQL Server's 2,100 parameters per statement.
    /// </remarks>
    private const int RootKeyChunkSize = 500;

    /// <summary>Method info used to expand DeleteByRootKeysAsync generically with the runtime key type.</summary>
    private static readonly MethodInfo _deleteByRootKeysMethod = typeof(
        EfCoreSqlQueryExecutor<TEntity, TContext>
    ).GetMethod(nameof(DeleteByRootKeysAsync), BindingFlags.NonPublic | BindingFlags.Static)!;

    /// <summary>
    /// Reads the keys of the rows the conditions match, then deletes those rows with their descendants, one chunk of keys
    /// at a time (returns the number of deleted rows).
    /// </summary>
    private static async Task<int> DeleteByRootKeysAsync<TKey>(
        TContext context,
        IQueryable<TEntity> roots,
        CancellationToken cancellationToken
    )
    {
        var parameter = Expression.Parameter(typeof(TEntity), "e");
        var key = Expression.Property(parameter, _metadata.KeyProperty);
        var keys = await roots
            .Select(Expression.Lambda<Func<TEntity, TKey>>(key, parameter))
            .ToListAsync(cancellationToken).ConfigureAwait(false);
        var rows = 0;

        for (var start = 0; start < keys.Count; start += RootKeyChunkSize)
        {
            var chunk = new KeyChunk<TKey>(
                keys.GetRange(start, Math.Min(RootKeyChunkSize, keys.Count - start)).ToArray()
            );
            var values = Expression.Field(Expression.Constant(chunk), nameof(KeyChunk<TKey>.Keys));
            var comparisons = Enumerable
                .Range(0, chunk.Keys.Length)
                .Select(i => (Expression)Expression.Equal(key, Expression.ArrayIndex(values, Expression.Constant(i))))
                .ToList();
            var predicate = Expression.Lambda<Func<TEntity, bool>>(OrBalanced(comparisons, 0, comparisons.Count), parameter);

            rows += await DeleteSubtreeAsync(
                context,
                context.Set<TEntity>().Where(predicate),
                new HashSet<Type> { typeof(TEntity) },
                cancellationToken
            ).ConfigureAwait(false);
        }

        return rows;
    }

    /// <summary>Joins the comparisons with OR as a balanced tree (a left-deep chain of hundreds would nest that deep).</summary>
    private static Expression OrBalanced(List<Expression> comparisons, int start, int count) =>
        count == 1
            ? comparisons[start]
            : Expression.OrElse(
                OrBalanced(comparisons, start, count / 2),
                OrBalanced(comparisons, start + count / 2, count - count / 2)
            );

    /// <summary>Carries one chunk of root keys into the condition as members EF Core turns into parameters.</summary>
    private sealed class KeyChunk<TKey>(TKey[] keys)
    {
        /// <summary>The keys of the chunk.</summary>
        public readonly TKey[] Keys = keys;
    }

    /// <summary>Throws when the cascade below <paramref name="type"/> comes back to a type already on the path.</summary>
    private static void ThrowIfCascadeIsCyclic(Type type, HashSet<Type> path)
    {
        foreach (var navigation in EntitySaveMetadata.For(type).CascadeNavigations)
        {
            if (!path.Add(navigation.ChildType))
            {
                throw new NotSupportedException(
                    $"Cyclic cascade ({navigation.ChildType.Name}) is not supported by ExecuteDeleteAsync. Load the graph and use SaveAsync, or rely on the database's ON DELETE CASCADE."
                );
            }

            ThrowIfCascadeIsCyclic(navigation.ChildType, path);
            path.Remove(navigation.ChildType);
        }
    }

    /// <summary>Method info used to expand DeleteSubtreeAsync generically with the runtime child type.</summary>
    private static readonly MethodInfo _deleteSubtreeMethod = typeof(
        EfCoreSqlQueryExecutor<TEntity, TContext>
    ).GetMethod(nameof(DeleteSubtreeAsync), BindingFlags.NonPublic | BindingFlags.Static)!;

    /// <summary>Deletes the descendants of the rows matching the query starting from the leaves (grandchildren), then deletes the rows themselves (returns the number of deleted rows).</summary>
    /// <remarks>
    /// <see cref="ThrowIfCascadeIsCyclic"/> has refused a cyclic cascade before the transaction, so the check on the path here
    /// does not fire; it stays so that the walk cannot recurse for ever should that order ever change.
    /// </remarks>
    private static async Task<int> DeleteSubtreeAsync<TCurrent>(
        TContext context,
        IQueryable<TCurrent> query,
        ISet<Type> visited,
        CancellationToken cancellationToken
    )
        where TCurrent : class
    {
        var rows = 0;

        foreach (var navigation in EntitySaveMetadata.For(typeof(TCurrent)).CascadeNavigations)
        {
            if (!visited.Add(navigation.ChildType))
            {
                throw new NotSupportedException(
                    $"Cyclic cascade ({navigation.ChildType.Name}) is not supported by ExecuteDeleteAsync. Load the graph and use SaveAsync, or rely on the database's ON DELETE CASCADE."
                );
            }

            // Child query: child => parent query's primary key set.Contains(child.FK) (EF Core translates this into an IN subquery).
            var childQuery = BuildChildQuery(context, query, typeof(TCurrent), navigation);
            var subtreeTask = (Task<int>)
                _deleteSubtreeMethod
                    .MakeGenericMethod(navigation.ChildType)
                    .Invoke(null, new object[] { context, childQuery, visited, cancellationToken })!;
            rows += await subtreeTask.ConfigureAwait(false);

            visited.Remove(navigation.ChildType);
        }

        rows += await query.ExecuteDeleteAsync(cancellationToken).ConfigureAwait(false);
        return rows;
    }

    /// <summary>Method info used to invoke DbContext.Set&lt;T&gt;() with a runtime type.</summary>
    private static readonly MethodInfo _setMethod = typeof(DbContext).GetMethod(
        nameof(DbContext.Set),
        Type.EmptyTypes
    )!;

    /// <summary>Builds the child query that references the parent query's primary key set (child => parentKeys.Contains(child.FK)).</summary>
    private static IQueryable BuildChildQuery(
        TContext context,
        IQueryable parentQuery,
        Type parentType,
        CascadeNavigation navigation
    )
    {
        var parentKeyProperty = EntitySaveMetadata
            .For(parentType)
            .PropertyByColumn[navigation.PrincipalColumn];
        var childForeignKeyProperty = EntitySaveMetadata
            .For(navigation.ChildType)
            .PropertyByColumn[navigation.DependentColumn];

        // parentKeys = parentQuery.Select(parent => parent.Key)
        var parentParameter = Expression.Parameter(parentType, "parent");
        var keySelector = Expression.Lambda(
            Expression.Property(parentParameter, parentKeyProperty),
            parentParameter
        );
        var parentKeys = parentQuery.Provider.CreateQuery(
            Expression.Call(
                typeof(Queryable),
                nameof(Queryable.Select),
                new[] { parentType, parentKeyProperty.PropertyType },
                parentQuery.Expression,
                Expression.Quote(keySelector)
            )
        );

        // childSet.Where(child => parentKeys.Contains(child.FK)). When the FK is nullable, it is converted to the key type for comparison.
        var childParameter = Expression.Parameter(navigation.ChildType, "child");
        var foreignKeyAccess = (Expression)
            Expression.Property(childParameter, childForeignKeyProperty);

        if (foreignKeyAccess.Type != parentKeyProperty.PropertyType)
        {
            foreignKeyAccess = Expression.Convert(foreignKeyAccess, parentKeyProperty.PropertyType);
        }

        var predicate = Expression.Lambda(
            Expression.Call(
                typeof(Queryable),
                nameof(Queryable.Contains),
                new[] { parentKeyProperty.PropertyType },
                Expression.Constant(
                    parentKeys,
                    typeof(IQueryable<>).MakeGenericType(parentKeyProperty.PropertyType)
                ),
                foreignKeyAccess
            ),
            childParameter
        );
        var childSet = (IQueryable)
            _setMethod.MakeGenericMethod(navigation.ChildType).Invoke(context, null)!;

        return childSet.Provider.CreateQuery(
            Expression.Call(
                typeof(Queryable),
                nameof(Queryable.Where),
                new[] { navigation.ChildType },
                childSet.Expression,
                Expression.Quote(predicate)
            )
        );
    }

    /// <summary>Applies the captured Where expressions (combined with AND).</summary>
    /// <remarks>
    /// On SQLite, an equality or an IN between an integer and a <c>decimal</c> is rewritten into a comparison of integers first
    /// (<see cref="SqliteIntegralDecimalEquality"/>).
    /// </remarks>
    private static IQueryable<TEntity> ApplyPredicates(
        DbContext context,
        IQueryable<TEntity> query,
        SqlQueryPlan<TEntity> plan
    )
    {
        var sqlite = SqliteIntegralDecimalEquality.AppliesTo(context);

        foreach (var predicate in plan.Predicates)
        {
            var typed = (Expression<Func<TEntity, bool>>)predicate;
            query = query.Where(sqlite ? SqliteIntegralDecimalEquality.Rewrite(typed) : typed);
        }

        return query;
    }

    /// <summary>Applies the captured orderings (strips the boxing and composes OrderBy / ThenBy with the actual key type).</summary>
    private static IQueryable<TEntity> ApplyOrderings(
        IQueryable<TEntity> query,
        SqlQueryPlan<TEntity> plan
    )
    {
        var first = true;

        foreach (var ordering in plan.Orderings)
        {
            var body = ordering.KeySelector.Body;

            while (
                body is UnaryExpression
                {
                    NodeType: ExpressionType.Convert or ExpressionType.ConvertChecked
                } unary
            )
            {
                body = unary.Operand;
            }

            var keyLambda = Expression.Lambda(body, ordering.KeySelector.Parameters);
            var methodName = (first, ordering.Descending) switch
            {
                (true, false) => nameof(Queryable.OrderBy),
                (true, true) => nameof(Queryable.OrderByDescending),
                (false, false) => nameof(Queryable.ThenBy),
                (false, true) => nameof(Queryable.ThenByDescending),
            };
            query = query.Provider.CreateQuery<TEntity>(
                Expression.Call(
                    typeof(Queryable),
                    methodName,
                    new[] { typeof(TEntity), body.Type },
                    query.Expression,
                    Expression.Quote(keyLambda)
                )
            );
            first = false;
        }

        return query;
    }

    /// <summary>Builds dot paths (e.g. "Orders.Details") from the Include tree and applies them.</summary>
    private static IQueryable<TEntity> ApplyIncludes(
        IQueryable<TEntity> query,
        SqlQueryPlan<TEntity> plan
    )
    {
        foreach (var node in plan.Includes)
        {
            foreach (var path in EnumerateIncludePaths(node, node.Property.Name))
            {
                query = query.Include(path);
            }
        }

        return query;
    }

    /// <summary>Enumerates root-to-leaf dot paths from an Include node (a node with no children yields its own path).</summary>
    private static IEnumerable<string> EnumerateIncludePaths(IncludeNode node, string path)
    {
        if (node.Children.Count == 0)
        {
            yield return path;
            yield break;
        }

        foreach (var child in node.Children)
        {
            foreach (var childPath in EnumerateIncludePaths(child, $"{path}.{child.Property.Name}"))
            {
                yield return childPath;
            }
        }
    }

    /// <summary>Applies Skip / Take (the same meaning as the existing version's OFFSET / FETCH).</summary>
    private static IQueryable<TEntity> ApplyPaging(
        IQueryable<TEntity> query,
        SqlQueryPlan<TEntity> plan
    )
    {
        if (plan.Skip is int skip)
        {
            query = query.Skip(skip);
        }

        if (plan.Take is int take)
        {
            query = query.Take(take);
        }

        return query;
    }

    /// <summary>Normalizes the retrieved graph (root plus what was read via Include) to RowState=Unchanged (the same post-mapping state as the existing version).</summary>
    private static void MarkGraphUnchanged(EntityBaseCore entity, IReadOnlyList<IncludeNode> includes)
    {
        entity.MarkUnchanged();

        foreach (var node in includes)
        {
            var value = node.Property.GetValue(entity);

            if (value is null)
            {
                continue;
            }

            if (value is IEnumerable<EntityBaseCore> children)
            {
                foreach (var child in children)
                {
                    if (child is not null)
                    {
                        MarkGraphUnchanged(child, node.Children);
                    }
                }
            }
            else if (value is EntityBaseCore child)
            {
                MarkGraphUnchanged(child, node.Children);
            }
        }
    }
}

/// <summary>Repository base class that implements CRUD with metadata and EF Core (<typeparamref name="TContext"/>).</summary>
/// <remarks>
/// <para>
/// Implements the same contract as QuickER's SQL Server implementation{{ if repositories }} (<see cref="{{ repository_base_class }}Core{TEntity, TKey}"/>){{ end }} on top of a DbContext.
/// The DbContext is created short-lived per call (the same unit as opening a connection per call);
/// reads use AsNoTracking, and a graph save registers the cascade closure entity by entity, converting each RowState to an
/// EntityState (<c>Entry(...).State</c>; the navigations to parents are never followed).
/// </para>
/// <para>
/// It does not depend on a concrete DbContext and takes <typeparamref name="TContext"/> (derived from <see cref="DbContext"/>).
/// The concrete type (QuickErDbContext, etc.) is closed over on the generation side (per-entity implementations, DI registration).
/// </para>
/// <para>Dialect selection such as UseSqlServer / UseNpgsql is left to the application's DbContextOptions configuration (dialect-independent).</para>
/// </remarks>
/// <typeparam name="TEntity">The target entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
/// <typeparam name="TContext">The concrete type of the DbContext that performs CRUD.</typeparam>
public abstract class EfCoreRepositoryCore<TEntity, TKey, TContext>(
    IDbContextFactory<TContext> contextFactory,
    ISaveHookRegistry? saveHooks = null,
    ISqlExecutor? sqlExecutor = null
) : IRepositoryCore<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
    where TContext : DbContext
{
    /// <summary>Metadata built once per entity type (reused via a static field).</summary>
    private static readonly EntitySaveMetadata _metadata = EntitySaveMetadata.For(typeof(TEntity));

    /// <summary>The source that creates the DbContext.</summary>
    private readonly IDbContextFactory<TContext> _contextFactory = contextFactory;

    /// <summary>
    /// Delegation target of the raw SQL methods (consolidates binding and mapping into a single path).
    /// Unspecified = null builds the default EF Core implementation over the same context factory, which keeps
    /// hand-constructed repositories working; the DI registration passes the registered implementation instead.
    /// </summary>
    private readonly ISqlExecutor _sqlExecutor =
        sqlExecutor ?? new EfCoreSqlExecutor<TContext>(contextFactory);

    /// <summary>The save hook registry (unspecified = null = no hooks, a complete no-op).</summary>
    private readonly ISaveHookRegistry? _saveHooks = saveHooks;

    /// <summary>One record of "entity to save, EF Core entry, operation to perform" recorded by <see cref="TrackNode"/> (the operation is updated when switched by a retry).</summary>
    private sealed class TrackedOperation(
        EntityBaseCore entity,
        EntityEntry? entry,
        SaveOperation operation
    )
    {
        /// <summary>The entity to save.</summary>
        public EntityBaseCore Entity { get; } = entity;

        /// <summary>
        /// The corresponding EF Core tracking entry (used for applying State and for type checks on retry). <c>null</c> for
        /// an Added descendant of a deleted entity, which has no row to delete and is recorded for the delete hooks only.
        /// </summary>
        public EntityEntry? Entry { get; } = entry;

        /// <summary>The operation actually performed (updated from Update to Insert when <c>insertWhenUpdateMissing</c> switches it).</summary>
        public SaveOperation Operation { get; set; } = operation;
    }

    /// <summary>
    /// The navigations of the entities a save registers, as they were before EF Core tracked them, so the save can put them
    /// back. A save does not change the navigations of the entities it is given; the one change it makes is taking the
    /// children it deleted out of the cascade collections of a parent it kept (done afterwards by
    /// <see cref="CascadeCollections.RemoveDeletedChildren"/>).
    /// </summary>
    /// <remarks>
    /// EF Core fixes up the navigations of the entities it tracks: registering an entity sets the references and fills the
    /// collections that its foreign keys and the other tracked entities imply, and detaching a deleted entity after the save
    /// clears the references to it and takes it out of the collections. The QuickER repositories write the rows only, so
    /// without this the same save would leave a different graph in memory depending on the backend. A save hook that edits
    /// a navigation during an EF Core graph save has its edit put back as well.
    /// </remarks>
    private sealed class NavigationSnapshot
    {
        /// <summary>The navigation properties per entity type (every property carrying a navigation reference, in both directions).</summary>
        private static readonly ConcurrentDictionary<Type, PropertyInfo[]> _navigations = new();

        private readonly List<(EntityBaseCore Entity, PropertyInfo Navigation, object? Value, object?[]? Items)> _values = [];

        private NavigationSnapshot() { }

        /// <summary>Records the navigations of the given entities and of their cascade descendants.</summary>
        public static NavigationSnapshot Take(IEnumerable<EntityBaseCore> roots)
        {
            var snapshot = new NavigationSnapshot();
            var visited = new HashSet<EntityBaseCore>(ReferenceEqualityComparer.Instance);
            var pending = new Stack<EntityBaseCore>(roots.Where(root => root is not null));

            while (pending.Count > 0)
            {
                var entity = pending.Pop();

                if (!visited.Add(entity))
                {
                    continue;
                }

                snapshot.Record(entity);

                foreach (var child in entity.EnumerateCascadeChildren())
                {
                    pending.Push(child);
                }
            }

            return snapshot;
        }

        /// <summary>Records the navigations of the given rows only (a bulk insert writes the rows it is given, nothing below them).</summary>
        public static NavigationSnapshot TakeRows(IEnumerable<EntityBaseCore> rows)
        {
            var snapshot = new NavigationSnapshot();
            var visited = new HashSet<EntityBaseCore>(ReferenceEqualityComparer.Instance);

            foreach (var row in rows)
            {
                if (visited.Add(row))
                {
                    snapshot.Record(row);
                }
            }

            return snapshot;
        }

        /// <summary>
        /// Empties every recorded navigation (a reference becomes null, a collection is cleared in place), so that EF Core
        /// writes the foreign keys as they are and fixes up nothing from the navigations; <see cref="Restore"/> puts them back.
        /// </summary>
        public void Clear()
        {
            foreach (var (entity, navigation, value, items) in _values)
            {
                if (items is not null)
                {
                    if (items.Length > 0)
                    {
                        CollectionEditor.For(value!).Clear(value!);
                    }
                }
                else if (value is not null)
                {
                    navigation.SetValue(entity, null);
                }
            }
        }

        private void Record(EntityBaseCore entity)
        {
            foreach (var navigation in NavigationsOf(entity.GetType()))
            {
                var value = navigation.GetValue(entity);
                var items = value is IEnumerable<EntityBaseCore> collection ? collection.ToArray<object?>() : null;
                _values.Add((entity, navigation, value, items));
            }
        }

        /// <summary>Puts every recorded navigation back: the same reference, and a collection with the same items in the same order.</summary>
        public void Restore()
        {
            foreach (var (entity, navigation, value, items) in _values)
            {
                if (!ReferenceEquals(navigation.GetValue(entity), value))
                {
                    navigation.SetValue(entity, value);
                }

                if (items is not null && !SameItems((System.Collections.IEnumerable)value!, items))
                {
                    var editor = CollectionEditor.For(value!);
                    editor.Clear(value!);

                    foreach (var item in items)
                    {
                        editor.Add(value!, item);
                    }
                }
            }
        }

        private static bool SameItems(System.Collections.IEnumerable collection, object?[] items)
        {
            var index = 0;

            foreach (var item in collection)
            {
                if (index >= items.Length || !ReferenceEquals(item, items[index]))
                {
                    return false;
                }

                index++;
            }

            return index == items.Length;
        }

        /// <summary>
        /// Clears and fills a collection navigation in place: through <see cref="System.Collections.IList"/> when it is one,
        /// and otherwise through its <c>ICollection&lt;T&gt;</c> (a <c>HashSet&lt;T&gt;</c> assigned to the navigation, for example).
        /// </summary>
        private sealed class CollectionEditor
        {
            /// <summary>Caches the editor per collection type.</summary>
            private static readonly ConcurrentDictionary<Type, CollectionEditor> _editors = new();

            private readonly MethodInfo? _clear;
            private readonly MethodInfo? _add;

            private CollectionEditor(Type type)
            {
                if (typeof(System.Collections.IList).IsAssignableFrom(type))
                {
                    return;
                }

                var collection = type.GetInterfaces()
                    .First(i => i.IsGenericType && i.GetGenericTypeDefinition() == typeof(ICollection<>));
                _clear = collection.GetMethod(nameof(ICollection<object>.Clear));
                _add = collection.GetMethod(nameof(ICollection<object>.Add));
            }

            /// <summary>The editor of the collection's type.</summary>
            public static CollectionEditor For(object collection) =>
                _editors.GetOrAdd(collection.GetType(), static type => new CollectionEditor(type));

            /// <summary>Empties the collection.</summary>
            public void Clear(object collection)
            {
                if (_clear is null)
                {
                    ((System.Collections.IList)collection).Clear();
                }
                else
                {
                    _clear.Invoke(collection, null);
                }
            }

            /// <summary>Adds an item at the end of the collection.</summary>
            public void Add(object collection, object? item)
            {
                if (_add is null)
                {
                    ((System.Collections.IList)collection).Add(item);
                }
                else
                {
                    _add.Invoke(collection, [item]);
                }
            }
        }

        private static PropertyInfo[] NavigationsOf(Type type) =>
            _navigations.GetOrAdd(
                type,
                static resolvedType =>
                    resolvedType
                        .GetProperties(BindingFlags.Public | BindingFlags.Instance)
                        .Where(property =>
                            property.CanWrite && EntitySaveMetadata.NavigationAttribute(property) is not null
                        )
                        .ToArray()
            );
    }

    /// <summary>Retrieves a single entity by primary key (null when there is no match).</summary>
    /// <remarks>As in the existing version, only the single table is read (navigations are loaded via Include on <see cref="Query"/>).</remarks>
    public async Task<TEntity?> GetByIdAsync(TKey id, CancellationToken cancellationToken = default)
    {
        if (id is null)
        {
            throw new ArgumentNullException(nameof(id));
        }

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        var entity = await context
            .Set<TEntity>()
            .AsNoTracking()
            .FirstOrDefaultAsync(BuildKeyPredicate(id), cancellationToken).ConfigureAwait(false);
        // Rows read from the database are treated as unchanged (the same post-state as the existing version's MapEntity).
        entity?.MarkUnchanged();
        return entity;
    }

    /// <summary>Retrieves all entities.</summary>
    public async Task<IReadOnlyList<TEntity>> GetAllAsync(
        CancellationToken cancellationToken = default
    )
    {
        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        var items = await context.Set<TEntity>().AsNoTracking().ToListAsync(cancellationToken).ConfigureAwait(false);

        foreach (var item in items)
        {
            item.MarkUnchanged();
        }

        return items;
    }

    /// <summary>Inserts an entity.</summary>
    public async Task InsertAsync(TEntity entity, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entity);

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        // Add marks navigation targets as Added too, so assign Entry.State to add only the single target (the same scope as the existing version's single INSERT).
        context.Entry(entity).State = EntityState.Added;
        await context.SaveChangesAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Bulk-inserts a collection of entities.</summary>
    /// <remarks>
    /// The EF Core version tracks all items as Added and saves them with a single SaveChanges (batched INSERT statements).
    /// Its performance characteristics differ from the existing SQL Server version, which uses SqlBulkCopy, and it may be slower for large volumes.
    /// As in the existing version, only the given entities are inserted; navigation targets are not traversed. The rows
    /// are written with the foreign keys they carry, as the QuickER repositories write them: the navigations of the rows are
    /// emptied while EF Core tracks them and put back afterwards, whether the save succeeds or fails, so EF Core neither
    /// takes a foreign key from a navigation between two rows of the batch nor fixes up the navigations of the caller's
    /// entities.
    /// </remarks>
    public async Task<int> BulkInsertAsync(
        IEnumerable<TEntity> entities,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entities);
        cancellationToken.ThrowIfCancellationRequested();

        // If a collection with a known count is empty, return without creating a DbContext.
        if (entities is ICollection<TEntity> { Count: 0 })
        {
            return 0;
        }

        // A null element is skipped rather than rejected (the shared BulkInsert contract).
        var rows = entities.Where(entity => entity is not null).ToList();

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        // Taken and emptied before EF Core tracks anything (registering an entity already fixes up the navigations)
        var navigations = NavigationSnapshot.TakeRows(rows);
        navigations.Clear();

        try
        {
            foreach (var entity in rows)
            {
                // AddRange marks navigation targets as Added too, so assign Entry.State to add only the targets.
                context.Entry(entity).State = EntityState.Added;
            }

            return await context.SaveChangesAsync(cancellationToken).ConfigureAwait(false);
        }
        finally
        {
            navigations.Restore();
        }
    }

    /// <summary>Updates an entity (true when a target row was updated).</summary>
    /// <remarks>
    /// When the entity carries a concurrency token (a rowversion column), <paramref name="mode"/> decides whether the update
    /// is guarded by the version the entity was read with. A guarded update that finds the row changed by someone else throws
    /// a <see cref="SaveConflictException"/>; a row that no longer exists still returns <c>false</c>.
    /// </remarks>
    /// <param name="entity">The entity to update.</param>
    /// <param name="mode">How a concurrent modification is handled when the entity carries a concurrency token (no effect otherwise). An undefined value throws <see cref="ArgumentOutOfRangeException"/>.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task<bool> UpdateAsync(
        TEntity entity,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entity);
        mode = ConcurrencyModes.Validated(mode);

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        // An alternate key, or a row SaveChanges would send no UPDATE for, is written by the save itself first
        if (WritesOwnColumns(context.Model.FindEntityType(typeof(TEntity))!))
        {
            return await UpdateWritingOwnColumnsAsync(context, entity, mode, cancellationToken).ConfigureAwait(false);
        }

        var entry = context.Entry(entity);
        entry.State = EntityState.Modified;
        var adoptions = NewAdoptions();

        while (true)
        {
            try
            {
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
                KeepStoredUnboundedBinaries(context);
{{~ end ~}}
                await context.SaveChangesAsync(cancellationToken).ConfigureAwait(false);
                return true;
            }
            catch (DbUpdateConcurrencyException ex)
            {
                // A row that is gone keeps the pre-existing "0 affected rows → false" contract
                if (await IsRowGoneAsync(entry, mode, adoptions, ex, cancellationToken).ConfigureAwait(false))
                {
                    return false;
                }
            }
        }
    }

    /// <summary>
    /// Updates an entity the save writes itself before SaveChanges (see <see cref="WriteOwnColumnsAsync"/>): its alternate
    /// key, or the whole row when SaveChanges would send no UPDATE for it, then the rest by SaveChanges, within one
    /// transaction per attempt.
    /// </summary>
    /// <remarks>
    /// The transaction runs inside the execution strategy, which refuses a transaction opened outside it, and every attempt
    /// registers the entity again, so that a retry does not start from the version an earlier attempt read back. A
    /// statement that matched no row rolls the transaction back before it is classified, so the retry never runs on top of
    /// what the earlier attempt wrote, and the row version read back after the write goes back to the original one with it
    /// (see <see cref="OwnWriteAttempt"/>). The generated values reach the entity only after the commit.
    /// </remarks>
    private static Task<bool> UpdateWritingOwnColumnsAsync(
        TContext context,
        TEntity entity,
        ConcurrencyMode mode,
        CancellationToken cancellationToken
    ) =>
        context
            .Database.CreateExecutionStrategy()
            .ExecuteAsync(
                async attemptToken =>
                {
                    context.ChangeTracker.Clear();
                    var entry = context.Entry(entity);
                    entry.State = EntityState.Modified;
                    var adoptions = NewAdoptions();
                    var attempt = new OwnWriteAttempt();

                    while (true)
                    {
                        await using var transaction = await context
                            .Database.BeginTransactionAsync(attemptToken)
                            .ConfigureAwait(false);
                        MissedStatements? conflict = null;

                        try
                        {
                            await WriteOwnColumnsAsync(context, [entry], mode, attempt, attemptToken)
                                .ConfigureAwait(false);
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
                            KeepStoredUnboundedBinaries(context);
{{~ end ~}}
                            await context
                                .SaveChangesAsync(acceptAllChangesOnSuccess: false, attemptToken)
                                .ConfigureAwait(false);
                        }
                        catch (DbUpdateConcurrencyException ex)
                        {
                            conflict = new(ex.Entries, ex);
                        }
                        catch (OwnWriteMissedException ex)
                        {
                            conflict = new(ex.Entries, ex);
                        }

                        if (conflict is not null)
                        {
                            await transaction.RollbackAsync(attemptToken).ConfigureAwait(false);

                            // The version read back after the write rolled back with the transaction
                            attempt.RollBack();

                            if (await IsRowGoneAsync(entry, mode, adoptions, conflict.Cause, attemptToken).ConfigureAwait(false))
                            {
                                return false;
                            }

                            continue;
                        }

                        await transaction.CommitAsync(attemptToken).ConfigureAwait(false);
                        attempt.Commit();
                        context.ChangeTracker.AcceptAllChanges();

                        return true;
                    }
                },
                cancellationToken
            );

    /// <summary>Caches the alternate key columns of each entity type (empty when the type has none).</summary>
    private static readonly ConcurrentDictionary<Type, (string Name, Type ClrType)[]> _alternateKeyColumns = new();

    /// <summary>
    /// The columns of the keys other than the primary key: the principal keys of the foreign keys that reference a unique
    /// constraint (the principal key the model configures for them).
    /// </summary>
    private static (string Name, Type ClrType)[] AlternateKeyColumns(Microsoft.EntityFrameworkCore.Metadata.IEntityType entityType) =>
        _alternateKeyColumns.GetOrAdd(
            entityType.ClrType,
            _ =>
                entityType
                    .GetKeys()
                    .Where(key => !key.IsPrimaryKey())
                    .SelectMany(key => key.Properties)
                    .Distinct()
                    .Select(property => (property.Name, property.ClrType))
                    .ToArray()
        );

    /// <summary>
    /// Whether SaveChanges writes a column of an updated row of the type. EF Core sends no UPDATE for a Modified entry whose
    /// every property is part of a key, generated by the database (a row version, a computed or an identity column) or,
    /// within a request of the generated remote endpoints, an excluded unbounded binary column (left as it is stored).
    /// </summary>
    private static bool SaveChangesWritesColumn(Microsoft.EntityFrameworkCore.Metadata.IEntityType entityType)
    {
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
        var excluded = UnboundedBinaryColumns.InRemoteRequest
            ? UnboundedBinaryColumns.For(entityType.ClrType).Select(column => column.Name).ToHashSet(StringComparer.Ordinal)
            : null;

{{~ end ~}}
        return entityType
            .GetProperties()
            .Any(property =>
                !property.IsKey()
                && property.GetAfterSaveBehavior() == Microsoft.EntityFrameworkCore.Metadata.PropertySaveBehavior.Save
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
                && excluded?.Contains(property.Name) != true
{{~ end ~}}
            );
    }

    /// <summary>Whether the save writes columns of an updated row of the type itself (see <see cref="WriteOwnColumnsAsync"/>).</summary>
    private static bool WritesOwnColumns(Microsoft.EntityFrameworkCore.Metadata.IEntityType entityType) =>
        AlternateKeyColumns(entityType).Length > 0 || !SaveChangesWritesColumn(entityType);

    /// <summary>Whether an operation updates a row the save writes itself (see <see cref="WriteOwnColumnsAsync"/>).</summary>
    private static bool WritesOwnColumns(TrackedOperation op) =>
        op.Operation == SaveOperation.Update && op.Entry is not null && WritesOwnColumns(op.Entry.Metadata);

    /// <summary>
    /// Writes, before SaveChanges and within its transaction, what SaveChanges would not write for each updated entry: an
    /// alternate key whose value differs from the stored one, and the row itself when SaveChanges would send no UPDATE for
    /// it. Makes the original values of the alternate key the current ones.
    /// </summary>
    /// <remarks>
    /// <para>
    /// EF Core never writes a key column in an UPDATE: an alternate key changed on an entity marked Modified would be dropped
    /// while the save reports success, and an alternate key a save hook changes after the entity was registered makes the
    /// change detection throw ("part of a key"). The QuickER repositories write every column, so a changed alternate key is
    /// written there and a referenced one is refused by the foreign key. Here the key is written with ExecuteUpdate, which the
    /// foreign key refuses in the same way; the database exception stops the save and the transaction rolls back.
    /// </para>
    /// <para>
    /// EF Core also sends no UPDATE for an entry without a column it writes (see <see cref="SaveChangesWritesColumn"/>): the
    /// update would neither find a row that is gone nor check the version, and the version an alternate key write produced
    /// would never reach the entity. Such a row is written here (its changed alternate key, or its primary key set to itself
    /// as the QuickER repositories do), and when that statement matches no row the entry is reported through an
    /// <see cref="OwnWriteMissedException"/>, which the save classifies the way it classifies a statement of SaveChanges that
    /// matched no row (a row that is gone, or a version that moved on).
    /// </para>
    /// <para>
    /// Change detection is off until the original values of the alternate key are made the current ones, so it never sees
    /// a key change: it would throw, and it would move the foreign keys of the tracked dependents to the new value. The
    /// stored alternate key and row version are read first, and an unchanged key is not written (the row version does not
    /// move). The UPDATE is guarded by the version under Optimistic, and the version it produces is read back as the
    /// original one, so that the UPDATE of SaveChanges matches the row.
    /// </para>
    /// <para>
    /// The entries are written in the order of the save, and the first one whose row is gone or (under
    /// <see cref="ConcurrencyMode.Optimistic"/>) whose version moved on is reported through an
    /// <see cref="OwnWriteMissedException"/> at once, before the entries after it are written: those would otherwise run
    /// ahead of SaveChanges, and the database could refuse one of them (taking the alternate key the missed row still
    /// holds) before the save reports the conflict of the missed row, which the QuickER repositories, writing in the same
    /// order, report first.
    /// </para>
    /// <para>
    /// The version read back exists only inside the attempt's transaction, so <paramref name="attempt"/> records the original
    /// version it replaces: when a statement of the attempt matches no row and the transaction rolls back, the caller puts
    /// it back before the retry, which would otherwise expect a version the database no longer holds and fail as a conflict
    /// nobody caused. The original values of the alternate key are not put back: the next attempt writes the key again,
    /// deciding from the stored key (which the rollback restored) and the current one, and makes the original values the
    /// current ones again before anything runs the change detection.
    /// </para>
    /// </remarks>
    private static async Task<int> WriteOwnColumnsAsync(
        DbContext context,
        IEnumerable<EntityEntry> entries,
        ConcurrencyMode mode,
        OwnWriteAttempt attempt,
        CancellationToken cancellationToken
    )
    {
        var detectChanges = context.ChangeTracker.AutoDetectChangesEnabled;
        context.ChangeTracker.AutoDetectChangesEnabled = false;
        var targets = entries
            .Where(entry => entry.State == EntityState.Modified && WritesOwnColumns(entry.Metadata))
            .ToList();
        var rows = 0;

        try
        {
            for (var index = 0; index < targets.Count; index++)
            {
                var entry = targets[index];
                var alternateKeys = AlternateKeyColumns(entry.Metadata);
                var write = CloseOver(_writeOwnColumnsDefinition, _writeOwnColumns, entry.Metadata.ClrType);
                var writesRow = !SaveChangesWritesColumn(entry.Metadata);
                var outcome = await write(context, entry, alternateKeys, writesRow, mode, attempt, cancellationToken)
                    .ConfigureAwait(false);

                // Reported before the entries after it are written, as SaveChanges reports a statement that matched no
                // row (see the remarks). The change detection the classification may run must not see a key change on
                // this entry or on the entries not written yet
                if (outcome == OwnWriteOutcome.Missed)
                {
                    foreach (var unwritten in targets.Skip(index))
                    {
                        MarkAlternateKeysUnchanged(unwritten);
                    }

                    throw new OwnWriteMissedException([entry]);
                }

                if (outcome == OwnWriteOutcome.WroteRow)
                {
                    rows++;
                }

                MarkAlternateKeysUnchanged(entry);
            }
        }
        finally
        {
            context.ChangeTracker.AutoDetectChangesEnabled = detectChanges;
        }

        return rows;
    }

    /// <summary>
    /// Makes the original values of the alternate key of an entry the current ones, so that the change detection never sees
    /// a key change (see <see cref="WriteOwnColumnsAsync"/>).
    /// </summary>
    private static void MarkAlternateKeysUnchanged(EntityEntry entry)
    {
        foreach (var column in AlternateKeyColumns(entry.Metadata))
        {
            var property = entry.Property(column.Name);
            property.OriginalValue = property.CurrentValue;
        }
    }

    /// <summary>What writing the columns of one entry itself did (see <see cref="WriteEntryOwnColumnsAsync{TRow}"/>).</summary>
    private enum OwnWriteOutcome
    {
        /// <summary>Wrote no row SaveChanges would not write (an alternate key of a row SaveChanges writes, or nothing)</summary>
        LeftToSaveChanges,

        /// <summary>Wrote a row SaveChanges would not write (it counts among the rows of the save)</summary>
        WroteRow,

        /// <summary>The row is gone or (under Optimistic) its version moved on</summary>
        Missed,
    }

    /// <summary>Writes the columns of one entry the save writes itself (see <see cref="WriteOwnColumnsAsync"/>).</summary>
    private delegate Task<OwnWriteOutcome> OwnColumnsWriter(
        DbContext context,
        EntityEntry entry,
        (string Name, Type ClrType)[] alternateKeys,
        bool writesRow,
        ConcurrencyMode mode,
        OwnWriteAttempt attempt,
        CancellationToken cancellationToken
    );

    /// <summary>The open definition of <see cref="WriteEntryOwnColumnsAsync{TRow}"/>.</summary>
    private static readonly MethodInfo _writeOwnColumnsDefinition = typeof(EfCoreRepositoryCore<TEntity, TKey, TContext>).GetMethod(
        nameof(WriteEntryOwnColumnsAsync),
        BindingFlags.NonPublic | BindingFlags.Static
    )!;

    /// <summary>Caches <see cref="WriteEntryOwnColumnsAsync{TRow}"/> closed over each entity type.</summary>
    private static readonly ConcurrentDictionary<Type, OwnColumnsWriter> _writeOwnColumns = new();

    /// <summary>
    /// Writes the columns of one entry the save writes itself (see <see cref="WriteOwnColumnsAsync"/>). A row that is gone or
    /// whose version moved on (under <see cref="ConcurrencyMode.Optimistic"/>) is <see cref="OwnWriteOutcome.Missed"/>, for
    /// the caller to report, whether or not SaveChanges writes the row.
    /// </summary>
    private static async Task<OwnWriteOutcome> WriteEntryOwnColumnsAsync<TRow>(
        DbContext context,
        EntityEntry entry,
        (string Name, Type ClrType)[] alternateKeys,
        bool writesRow,
        ConcurrencyMode mode,
        OwnWriteAttempt attempt,
        CancellationToken cancellationToken
    )
        where TRow : class
    {
        var (keys, keyValues) = KeyColumnsOf(entry);
        var token = TokenOf(entry.Metadata);
        (string Name, Type ClrType)[] columns = token is null
            ? alternateKeys
            : [.. alternateKeys, (token.Name, token.ClrType)];
        var stored = await ReadStoredValuesAsync<TRow>(context, keys, keyValues, columns, cancellationToken)
            .ConfigureAwait(false);

        // A row that is gone is reported by the caller
        if (stored is null)
        {
            return OwnWriteOutcome.Missed;
        }

        var guarded = token is not null && mode == ConcurrencyMode.Optimistic;

        // A row whose version moved on is reported the same way, as a conflict
        if (guarded && !StoredValueEquals(stored[^1], entry.Property(token!.Name).OriginalValue))
        {
            return OwnWriteOutcome.Missed;
        }

        var setters = alternateKeys
            .Where((column, index) => !StoredValueEquals(stored[index], entry.Property(column.Name).CurrentValue))
            .Select(column => new ColumnSetter(column, entry.Property(column.Name).CurrentValue, ToItself: false))
            .ToList();

        if (setters.Count == 0)
        {
            if (!writesRow)
            {
                return OwnWriteOutcome.LeftToSaveChanges;
            }

            // Nothing else to write: the primary key set to itself still matches the row, checks the version and moves it on
            setters.Add(new ColumnSetter(keys[0], null, ToItself: true));
        }

        var row = Expression.Parameter(typeof(TRow), "row");
        var match = MatchColumns(row, keys, keyValues);

        if (guarded)
        {
            match = Expression.AndAlso(
                match,
                MatchColumns(row, [(token!.Name, token.ClrType)], [entry.Property(token.Name).OriginalValue])
            );
        }

        var written = await context
            .Set<TRow>()
            .Where(Expression.Lambda<Func<TRow, bool>>(match, row))
            .ExecuteUpdateAsync(builder => SetColumns(builder, setters), cancellationToken)
            .ConfigureAwait(false);

        // A statement that matched no row means the row is gone or its version moved on (see above)
        if (written == 0)
        {
            return OwnWriteOutcome.Missed;
        }

        if (token is not null)
        {
            var version = await ReadStoredValuesAsync<TRow>(
            context,
            keys,
            keyValues,
            [(token.Name, token.ClrType)],
            cancellationToken
            ).ConfigureAwait(false);

            if (version is not null)
            {
                // SaveChanges produces the final version of a row it writes; a row it does not write keeps this one
                attempt.ReadBack(entry.Property(token.Name), version[0], toEntity: writesRow);
            }
        }

        return writesRow ? OwnWriteOutcome.WroteRow : OwnWriteOutcome.LeftToSaveChanges;
    }

    /// <summary>
    /// The row versions one attempt of a save read back after writing columns itself (see <see cref="WriteOwnColumnsAsync"/>),
    /// each put in place of the original version of its entry. They exist only inside the attempt's transaction.
    /// </summary>
    /// <remarks>
    /// When the transaction rolls back, <see cref="RollBack"/> puts the original versions back, so that the retry expects the
    /// version the database holds again. After the commit, <see cref="Commit"/> gives the versions of the rows SaveChanges
    /// did not write to their entities (SaveChanges hands the versions of the rows it wrote over through AcceptAllChanges).
    /// </remarks>
    private sealed class OwnWriteAttempt
    {
        private readonly List<(PropertyEntry Property, object? Original, object? Version, bool ToEntity)> _versions = [];

        /// <summary>Puts <paramref name="version"/> in place of the original version of the entry, recording the one it replaces.</summary>
        public void ReadBack(PropertyEntry property, object? version, bool toEntity)
        {
            _versions.Add((property, property.OriginalValue, version, toEntity));
            property.OriginalValue = version;
        }

        /// <summary>Puts the original versions back (latest first) after the attempt's transaction rolled back.</summary>
        public void RollBack()
        {
            for (var index = _versions.Count - 1; index >= 0; index--)
            {
                _versions[index].Property.OriginalValue = _versions[index].Original;
            }

            _versions.Clear();
        }

        /// <summary>Gives the versions of the rows SaveChanges did not write to their entities, after the commit.</summary>
        public void Commit()
        {
            foreach (var (property, _, version, toEntity) in _versions)
            {
                if (toEntity)
                {
                    property.CurrentValue = version;
                }
            }

            _versions.Clear();
        }
    }

    /// <summary>
    /// Reports the entries whose own write matched no row although SaveChanges would not write them (see
    /// <see cref="WriteOwnColumnsAsync"/>); the save handles it as it handles a <see cref="DbUpdateConcurrencyException"/>.
    /// </summary>
    private sealed class OwnWriteMissedException(IReadOnlyList<EntityEntry> entries)
        : Exception("The update of a row without a column SaveChanges writes matched no row.")
    {
        /// <summary>The entries whose statement matched no row.</summary>
        public IReadOnlyList<EntityEntry> Entries { get; } = entries;
    }

    /// <summary>The entries whose statement matched no row within one attempt, and the exception that reported them.</summary>
    private sealed record MissedStatements(IReadOnlyList<EntityEntry> Entries, Exception Cause);

    /// <summary>The primary key columns of an entry and their current values.</summary>
    private static ((string Name, Type ClrType)[] Keys, object?[] Values) KeyColumnsOf(EntityEntry entry)
    {
        var keys = entry
            .Metadata.FindPrimaryKey()!
            .Properties.Select(property => (property.Name, property.ClrType))
            .ToArray();
        return (keys, keys.Select(key => entry.Property(key.Name).CurrentValue).ToArray());
    }

    /// <summary>The concurrency token (the rowversion column) of an entity type, or null when it has none.</summary>
    private static Microsoft.EntityFrameworkCore.Metadata.IProperty? TokenOf(
        Microsoft.EntityFrameworkCore.Metadata.IEntityType entityType
    ) => entityType.GetProperties().FirstOrDefault(property => property.IsConcurrencyToken);

    /// <summary>Closes a generic method over an entity type once and caches it as a delegate (no reflection on each call).</summary>
    private static TDelegate CloseOver<TDelegate>(
        MethodInfo definition,
        ConcurrentDictionary<Type, TDelegate> cache,
        Type entityType
    )
        where TDelegate : Delegate =>
        cache.GetOrAdd(entityType, type => definition.MakeGenericMethod(type).CreateDelegate<TDelegate>());

    /// <summary>The condition that each of <paramref name="columns"/> equals its value, the values sent as parameters.</summary>
    private static Expression MatchColumns(
        ParameterExpression row,
        (string Name, Type ClrType)[] columns,
        object?[] values
    )
    {
        Expression? match = null;

        for (var index = 0; index < columns.Length; index++)
        {
            var equal = Expression.Equal(
                StoredColumn(row, columns[index]),
                ParameterValue(values[index], columns[index].ClrType)
            );
            match = match is null ? equal : Expression.AndAlso(match, equal);
        }

        return match!;
    }

    /// <summary>A value read off a holder, which EF Core sends as a parameter rather than writing a literal (see BuildKeyPredicate).</summary>
    private static Expression ParameterValue(object? value, Type clrType) =>
        Expression.Convert(
            Expression.Field(Expression.Constant(new StoredValueHolder(value)), nameof(StoredValueHolder.Value)),
            clrType
        );

    /// <summary>One column an ExecuteUpdate sets: to a value, or to itself (<paramref name="ToItself"/>).</summary>
    private sealed record ColumnSetter((string Name, Type ClrType) Column, object? Value, bool ToItself);

    /// <summary>
    /// Sets each column in an ExecuteUpdate (the column is read with <c>EF.Property</c>): to its value, sent as a parameter,
    /// or to itself.
    /// </summary>
    private static void SetColumns<TRow>(UpdateSettersBuilder<TRow> builder, IReadOnlyList<ColumnSetter> setters)
    {
        foreach (var setter in setters)
        {
            var row = Expression.Parameter(typeof(TRow), "row");
            var property = Expression.Lambda(StoredColumn(row, setter.Column), row);

            if (setter.ToItself)
            {
                var source = Expression.Parameter(typeof(TRow), "row");
                builder.SetProperty(property, Expression.Lambda(StoredColumn(source, setter.Column), source));
            }
            else
            {
                builder.SetProperty(property, ParameterValue(setter.Value, setter.Column.ClrType));
            }
        }
    }

    /// <summary>Compares a stored value with an entity's value (a byte array by its content).</summary>
    private static bool StoredValueEquals(object? stored, object? value) =>
        stored is byte[] || value is byte[]
            ? System.Collections.StructuralComparisons.StructuralEqualityComparer.Equals(stored, value)
            : Equals(stored, value);

    /// <summary>How many times one entry is attempted while its statement keeps matching no row although the stored values were adopted.</summary>
    private const int MaxConcurrencyAttempts = 10;

    /// <summary>Creates the per-entry count of adopted stored values (keyed by the entity instance).</summary>
    private static Dictionary<object, int> NewAdoptions() => new(ReferenceEqualityComparer.Instance);

    /// <summary>
    /// Works out why a reported entry's statement matched no row. Returns <c>true</c> when the row is gone, and otherwise
    /// resolves the conflict under <paramref name="mode"/>: <see cref="ConcurrencyMode.Optimistic"/> reports it as a
    /// <see cref="SaveConflictException"/>, and <see cref="ConcurrencyMode.ForceOverwrite"/> adopts the stored values as the
    /// originals so that the retry matches the row.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Matching no row is ambiguous: either the row is gone or its concurrency token moved on after the entity was read.
    /// Reading the stored values tells the two apart. Without a concurrency token there is nothing that could have moved
    /// on, so it is the former (the QuickER repositories report a table without a rowversion column the same way).
    /// </para>
    /// <para>
    /// The attempt limit is counted per entry, and only after the classification: a gone row is reported as gone however
    /// many attempts the save has already made, and the save gives up only on an entry whose statement still matches no row
    /// at its <see cref="MaxConcurrencyAttempts"/>-th attempt, after its stored values were adopted for each of the attempts
    /// before (a statement discarded for a reason other than concurrency, such as a trigger or row-level security). EF Core reports the entries of the first failing
    /// command only, so a save of many rows that each need resolving takes one attempt per row; a limit on the attempts of
    /// the whole save would give up on a large save that is making progress.
    /// </para>
    /// </remarks>
    private static async Task<bool> IsRowGoneAsync(
        EntityEntry entry,
        ConcurrencyMode mode,
        Dictionary<object, int> adoptions,
        Exception exception,
        CancellationToken cancellationToken
    )
    {
        var stored = TokenOf(entry.Metadata) is not null
            ? await entry.GetDatabaseValuesAsync(cancellationToken).ConfigureAwait(false)
            : null;

        if (stored is null)
        {
            return true;
        }

        // The row is still there, so someone else changed it after this entity was read
        if (mode == ConcurrencyMode.Optimistic)
        {
            throw SaveConflictException.Modified(
                entry.Entity.GetType(),
                KeyOf(entry.Entity),
                OperationVerb(entry.State)
            );
        }

        var adopted = adoptions.GetValueOrDefault(entry.Entity) + 1;

        if (adopted >= MaxConcurrencyAttempts)
        {
            throw ConcurrencyAttemptsExhausted(exception);
        }

        // Last-write-wins: adopting the stored values as the originals makes the retry match the row
        adoptions[entry.Entity] = adopted;
        entry.OriginalValues.SetValues(stored);

        return false;
    }

{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    /// <summary>
    /// Within a request of the generated remote endpoints, leaves the excluded columns of every updated entry as they are
    /// stored (see <see cref="UnboundedBinaryColumns.EnterRemoteRequest"/>); outside one, does nothing.
    /// </summary>
    /// <remarks>
    /// The remote wire does not carry the values of the excluded columns, so an updated entity arrives with them in the
    /// "not-fetched" state, and writing every column would wipe the stored blobs. The excluded columns are taken out of the
    /// UPDATE by making their original value the current one and marking them unmodified. It runs before every SaveChanges,
    /// because adopting the stored values on a last-write-wins retry makes the original values differ again, and the change
    /// detection of the next SaveChanges would mark the columns modified. An inserted entry writes the values sent.
    /// </remarks>
    private static void KeepStoredUnboundedBinaries(DbContext context)
    {
        if (!UnboundedBinaryColumns.InRemoteRequest)
        {
            return;
        }

        foreach (var entry in context.ChangeTracker.Entries())
        {
            if (entry.State != EntityState.Modified)
            {
                continue;
            }

            foreach (var excluded in UnboundedBinaryColumns.For(entry.Entity.GetType()))
            {
                var property = entry.Property(excluded.Name);
                property.OriginalValue = property.CurrentValue;
                property.IsModified = false;
            }
        }
    }

{{~ end ~}}
    /// <summary>Whether the recorded operations delete a stored row and update another (see <see cref="AdoptStoredForeignKeysAsync"/>).</summary>
    private static bool DeletesAndUpdates(IReadOnlyList<TrackedOperation> tracked) =>
        tracked.Any(op => op.Operation == SaveOperation.Delete && op.Entry is not null)
        && tracked.Any(op => op.Operation == SaveOperation.Update);

    /// <summary>
    /// When the save deletes rows, gives the foreign keys of every updated entry the values the database holds as their
    /// original values, so that EF Core orders the statements by where the rows stand.
    /// </summary>
    /// <remarks>
    /// <para>
    /// EF Core orders the statements of one SaveChanges by the original values of the foreign keys: an updated row whose
    /// original foreign key points at a deleted row is written before that deletion. An entity the graph save registers was
    /// not loaded by this context, so its original values are its current ones, and a row moved away from a parent the same
    /// save deletes looks as if it had always pointed at its new parent. EF Core would then delete the old parent first,
    /// which the foreign key refuses, or which (when deleting cascades) takes the moved row with it, so that its UPDATE
    /// matches no row.
    /// </para>
    /// <para>
    /// It runs inside the transaction of the SaveChanges it prepares, on every attempt: a retry of the execution strategy
    /// registers the graph again from scratch, so the values read for an earlier attempt are gone. Only the foreign keys are
    /// read, in one query per updated entry (an excluded blob is not read); a row that is gone is left as it is, for the
    /// SaveChanges to report.
    /// </para>
    /// </remarks>
    private static async Task AdoptStoredForeignKeysAsync(DbContext context, CancellationToken cancellationToken)
    {
        var entries = context.ChangeTracker.Entries().ToList();

        if (!entries.Any(entry => entry.State == EntityState.Deleted))
        {
            return;
        }

        foreach (var entry in entries)
        {
            if (entry.State != EntityState.Modified)
            {
                continue;
            }

            var foreignKeys = entry
                .Metadata.GetForeignKeys()
                .SelectMany(foreignKey => foreignKey.Properties)
                .Distinct()
                .Select(property => (property.Name, property.ClrType))
                .ToArray();

            if (foreignKeys.Length == 0)
            {
                continue;
            }

            var (keys, keyValues) = KeyColumnsOf(entry);
            var read = CloseOver(_readStoredValuesDefinition, _readStoredValues, entry.Metadata.ClrType);
            var stored = await read(context, keys, keyValues, foreignKeys, cancellationToken).ConfigureAwait(false);

            if (stored is null)
            {
                continue;
            }

            for (var index = 0; index < foreignKeys.Length; index++)
            {
                entry.Property(foreignKeys[index].Name).OriginalValue = stored[index];
            }
        }
    }

    /// <summary>The open definition of <see cref="ReadStoredValuesAsync{TRow}"/>.</summary>
    private static readonly MethodInfo _readStoredValuesDefinition = typeof(EfCoreRepositoryCore<TEntity, TKey, TContext>).GetMethod(
        nameof(ReadStoredValuesAsync),
        BindingFlags.NonPublic | BindingFlags.Static
    )!;

    /// <summary>Reads the stored values of some columns of one row (see <see cref="ReadStoredValuesAsync{TRow}"/>).</summary>
    private delegate Task<object?[]?> StoredValuesReader(
        DbContext context,
        (string Name, Type ClrType)[] keys,
        object?[] keyValues,
        (string Name, Type ClrType)[] columns,
        CancellationToken cancellationToken
    );

    /// <summary>Caches <see cref="ReadStoredValuesAsync{TRow}"/> closed over each entity type.</summary>
    private static readonly ConcurrentDictionary<Type, StoredValuesReader> _readStoredValues = new();

    /// <summary>Reads the stored values of <paramref name="columns"/> of the row with the given key (null when the row is gone).</summary>
    private static Task<object?[]?> ReadStoredValuesAsync<TRow>(
        DbContext context,
        (string Name, Type ClrType)[] keys,
        object?[] keyValues,
        (string Name, Type ClrType)[] columns,
        CancellationToken cancellationToken
    )
        where TRow : class
    {
        var row = Expression.Parameter(typeof(TRow), "row");
        var match = MatchColumns(row, keys, keyValues);
        var values = Expression.NewArrayInit(
            typeof(object),
            columns.Select(column => Expression.Convert(StoredColumn(row, column), typeof(object)))
        );

        return context
            .Set<TRow>()
            .AsNoTracking()
            .Where(Expression.Lambda<Func<TRow, bool>>(match, row))
            .Select(Expression.Lambda<Func<TRow, object?[]>>(values, row))
            .FirstOrDefaultAsync(cancellationToken);
    }

    /// <summary>Reads one column of the row in a query (<c>EF.Property</c>).</summary>
    private static MethodCallExpression StoredColumn(ParameterExpression row, (string Name, Type ClrType) column) =>
        Expression.Call(typeof(EF), nameof(EF.Property), [column.ClrType], row, Expression.Constant(column.Name));

    /// <summary>Carries a value into a query as a member EF Core turns into a parameter.</summary>
    private sealed class StoredValueHolder(object? value)
    {
        /// <summary>The value.</summary>
        public readonly object? Value = value;
    }

    /// <summary>Creates the exception for an entry whose statement kept matching no row through every attempt.</summary>
    private static SaveConflictException ConcurrencyAttemptsExhausted(Exception ex) =>
        new(
            $"The save still matched no row after {MaxConcurrencyAttempts} attempts on the same record. Something other than a concurrent change (such as a trigger or row-level security) may be discarding the statement.",
            ex
        );

    /// <summary>Reads an entity's primary key value for conflict reporting.</summary>
    private static object? KeyOf(object entity) =>
        EntitySaveMetadata.For(entity.GetType()).KeyProperty.GetValue(entity);

    /// <inheritdoc />
    public async Task<bool> DeleteAsync(TKey id, CancellationToken cancellationToken = default)
    {
        if (id is null)
        {
            throw new ArgumentNullException(nameof(id));
        }

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        var affected = await context
            .Set<TEntity>()
            .Where(BuildKeyPredicate(id))
            .ExecuteDeleteAsync(cancellationToken).ConfigureAwait(false);
        return affected > 0;
    }

    /// <summary>Starts a query that retrieves entities with chained filters, orderings, and Includes (executed by EF Core).</summary>
    public SqlQuery<TEntity> Query() =>
        new(new EfCoreSqlQueryExecutor<TEntity, TContext>(_contextFactory));

    /// <summary>Gets the UNIQUE constraints the pre-check walks (the generated repository overrides this with its own table; empty here).</summary>
    protected virtual UniquenessConstraintSet<TEntity> UniquenessConstraints =>
        UniquenessConstraintSet<TEntity>.Empty;

    /// <summary>Collects the user-defined uniqueness checks (the generated repository overrides this to reach its own partial hook).</summary>
    /// <param name="checks">The list to add the checks to (null until the first one is added).</param>
    protected virtual void CollectUniquenessChecks(ref List<UniquenessCheck<TEntity>>? checks) { }

    /// <inheritdoc />
    public async Task<IReadOnlyList<UniquenessViolation>> CheckUniquenessAsync(
        TEntity entity,
        CancellationToken cancellationToken = default
    )
    {
        var constraints = UniquenessConstraints;
        var violations = await UniquenessChecker
            .CheckAsync(
                entity,
                Query,
                constraints.ExcludeSelf,
                constraints.Constraints,
                cancellationToken
            )
            .ConfigureAwait(false);

        List<UniquenessCheck<TEntity>>? customChecks = null;
        CollectUniquenessChecks(ref customChecks);
        await UniquenessChecker
            .RunCustomChecksAsync(entity, customChecks, violations, cancellationToken)
            .ConfigureAwait(false);

        return violations;
    }

    /// <summary>Saves inserts, updates, and deletes according to RowState within a single transaction (children are cascaded by default).</summary>
    /// <remarks>
    /// Entities carrying a concurrency token (a rowversion column) take part in optimistic concurrency: unless
    /// <paramref name="mode"/> says otherwise, an update or delete whose row was changed by someone else after it was read
    /// is rejected with a <see cref="SaveConflictException"/> and the whole transaction rolls back. A save hook's
    /// <c>AfterSaveAsync</c> runs before the commit and therefore still sees the version the entity was read with; the
    /// version the database assigned is written back once the commit succeeds (the same contract as the direct ADO path).
    /// </remarks>
    public async Task<int> SaveAsync(
        TEntity entity,
        bool cascadeSave = true,
        bool cascadeDelete = true,
        bool insertWhenUpdateMissing = false,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entity);
        mode = ConcurrencyModes.Validated(mode);

        // If there are no changes anywhere in the graph, return without even creating a DbContext.
        if (!EntityGraphSaver.HasChanges(entity, cascadeSave))
        {
            return 0;
        }

        return await ExecuteGraphSaveAsync(
            [entity],
            cascadeSave,
            cascadeDelete,
            insertWhenUpdateMissing,
            mode,
            cancellationToken
        ).ConfigureAwait(false);
    }

    /// <summary>Saves multiple aggregate roots together within a single transaction (atomic: all succeed or all roll back).</summary>
    /// <remarks>
    /// Entities carrying a concurrency token (a rowversion column) take part in optimistic concurrency: unless
    /// <paramref name="mode"/> says otherwise, an update or delete whose row was changed by someone else after it was read
    /// is rejected with a <see cref="SaveConflictException"/> and the whole transaction rolls back. A save hook's
    /// <c>AfterSaveAsync</c> runs before the commit and therefore still sees the version the entity was read with; the
    /// version the database assigned is written back once the commit succeeds (the same contract as the direct ADO path).
    /// </remarks>
    public async Task<int> SaveAsync(
        IEnumerable<TEntity> entities,
        bool cascadeSave = true,
        bool cascadeDelete = true,
        bool insertWhenUpdateMissing = false,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entities);
        mode = ConcurrencyModes.Validated(mode);

        // Only graphs with changes are targeted (narrowed down before creating a DbContext).
        var targets = entities
            .Where(entity => entity is not null && EntityGraphSaver.HasChanges(entity, cascadeSave))
            .ToList();

        if (targets.Count == 0)
        {
            return 0;
        }

        return await ExecuteGraphSaveAsync(
            targets,
            cascadeSave,
            cascadeDelete,
            insertWhenUpdateMissing,
            mode,
            cancellationToken
        ).ConfigureAwait(false);
    }

    /// <summary>Runs one graph save through the DbContext's execution strategy, building every attempt from scratch.</summary>
    /// <remarks>
    /// A retrying execution strategy (such as SQL Server's <c>EnableRetryOnFailure</c>) refuses a transaction opened
    /// outside it, and the hook path (and a save that deletes some rows and updates others) opens one, so the whole save is
    /// handed to the strategy. Every attempt starts from an
    /// empty change tracker and registers the graph again with a fresh hook session, so a failed attempt leaves nothing
    /// behind for the next one (the entities' RowState is settled only after a successful commit). As a consequence a save
    /// hook runs once per attempt: its database writes roll back with the failed attempt, but a side effect outside the
    /// database is repeated.
    /// </remarks>
    private async Task<int> ExecuteGraphSaveAsync(
        IReadOnlyList<TEntity> roots,
        bool cascadeSave,
        bool cascadeDelete,
        bool insertWhenUpdateMissing,
        ConcurrencyMode mode,
        CancellationToken cancellationToken
    )
    {
        // A cancelled save stops before the save hooks run, as the QuickER repositories stop when they open the connection
        cancellationToken.ThrowIfCancellationRequested();

        // A navigation and a foreign key that disagree, or a row changed through two instances, stop the save before anything runs
        var consistency = GraphConsistency.Check(roots, cascadeSave, cascadeDelete);

        await using var context = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        // Taken before EF Core tracks anything, and put back before every attempt walks the graph and after the save
        var navigations = NavigationSnapshot.Take(roots);

        try
        {
            return await context
                .Database.CreateExecutionStrategy()
                .ExecuteAsync(
                    async attemptToken =>
                    {
                        // A failed attempt may have left its registrations behind, and the navigations EF Core fixed up
                        context.ChangeTracker.Clear();
                        navigations.Restore();

                        var tracked = new List<TrackedOperation>();

                        // The same stages as the QuickER repositories (GraphSaveOrder), so the save hooks fire in the same
                        // sequence; EF Core still orders the statements of its SaveChanges itself
                        var order = GraphSaveOrder.For(roots, cascadeSave, cascadeDelete);
                        IReadOnlyList<EntityBaseCore> startingPoints = order?.StartingPoints ?? roots;

                        // A held-back row that takes the alternate key of a deleted row is saved by a second context
                        // after the deletions (see HeldBackContextAsync)
                        await using var heldBack = await HeldBackContextAsync(context, order, cascadeSave, attemptToken)
                            .ConfigureAwait(false);

                        // The held-back rows are the last starting points
                        var firstHeldBack = startingPoints.Count - (order?.HeldBack.Count ?? 0);

                        for (var index = 0; index < startingPoints.Count; index++)
                        {
                            var target = heldBack is not null && index >= firstHeldBack ? heldBack.Context : context;
                            TrackNode(target, startingPoints[index], cascadeSave, cascadeDelete, tracked, order, consistency);
                        }

                        return await SaveTrackedGraphAsync(
                            context,
                            heldBack?.Context,
                            roots,
                            tracked,
                            navigations,
                            consistency,
                            cascadeSave,
                            insertWhenUpdateMissing,
                            mode,
                            attemptToken
                        ).ConfigureAwait(false);
                    },
                    cancellationToken
                ).ConfigureAwait(false);
        }
        catch
        {
            navigations.Restore();
            throw;
        }
    }

    /// <summary>
    /// Returns a second context for the held-back rows (the third stage of <see cref="GraphSaveOrder"/>) when one of them
    /// takes, in an alternate key, a value a row of the save deletes still holds; otherwise null, and the whole save runs
    /// in one SaveChanges.
    /// </summary>
    /// <remarks>
    /// <para>
    /// EF Core never writes an alternate key, so the save writes it itself before SaveChanges (see
    /// <see cref="WriteOwnColumnsAsync"/>). Nothing can run between the statements of one SaveChanges, and the unique
    /// indexes that order the rows that take a unique value (<c>HasIndex(...).IsUnique()</c>) do not order a key: written
    /// before SaveChanges, the key would meet the row the save is about to delete and be refused. So the held-back rows are
    /// tracked by a second context that shares the connection and the transaction, and are saved after the SaveChanges of
    /// the first one: their alternate keys are written after the deletions, and the rows below them (a new row that refers
    /// to the new value) after those keys, as the QuickER repositories write the three stages.
    /// </para>
    /// <para>
    /// Both contexts keep their entries pending until the commit (SaveChanges runs with acceptAllChangesOnSuccess=false),
    /// so a statement that matched no row in either is resolved and both run again within the same attempt, and the
    /// generated values reach the entities only after the commit. A held-back row that takes another kind of unique value
    /// is ordered by the unique indexes within the one SaveChanges, as before.
    /// </para>
    /// </remarks>
    private async Task<HeldBackContext?> HeldBackContextAsync(
        TContext context,
        GraphSaveOrder? order,
        bool cascadeSave,
        CancellationToken cancellationToken
    )
    {
        if (order is null || !order.HeldBack.Any(row => TakesDeletedAlternateKey(context.Model, order, row, cascadeSave)))
        {
            return null;
        }

        var heldBack = await _contextFactory.CreateDbContextAsync(cancellationToken).ConfigureAwait(false);

        try
        {
            return new HeldBackContext(heldBack, context.Database.GetDbConnection());
        }
        catch
        {
            // The second context would otherwise be left undisposed (and, from a pooling factory, never returned)
            await heldBack.DisposeAsync().ConfigureAwait(false);
            throw;
        }
    }

    /// <summary>
    /// The second context of a save that writes the held-back rows after the deletions (see
    /// <see cref="HeldBackContextAsync"/>): it runs on the first context's connection, which it never opens or closes, and
    /// joins each of its transactions.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Disposing it leaves the transaction and gives the context its own connection back before the context is disposed: a
    /// context from a pooling factory goes back to the pool as it is, and the next save would otherwise lease it with the
    /// connection of this one. How the connection is given back depends on where it came from, read from the options:
    /// </para>
    /// <list type="bullet">
    ///   <item>A context configured with a connection string owns the connection it creates, and EF Core disposes that
    ///     connection, and forgets the connection string, as soon as another connection is set. The context gets the
    ///     connection string back instead (<c>SetDbConnection(null)</c> then <c>SetConnectionString</c>), and creates a new
    ///     connection when it is next used. Setting the connection string alone would write it into the connection the
    ///     context holds at that moment, which is the shared one.</item>
    ///   <item>A context configured with a connection the application passed (<c>UseSqlServer(connection)</c>) gets that
    ///     connection back, owned as the options say (<c>contextOwnsConnection</c>). EF Core disposes a connection the
    ///     context owns when another one is set, so a connection passed with <c>contextOwnsConnection: true</c> cannot be
    ///     given back usable: such a context is disposed with this save, as it would be anyway, but it must not be reused
    ///     (pooled) afterwards.</item>
    ///   <item>A context configured without either (the factory attached a connection at run time with
    ///     <c>SetDbConnection</c>) gets that connection back as not owned. Whether the context owned it cannot be read
    ///     through a public API, so the save leans towards never disposing the application's connection: a connection
    ///     attached with <c>contextOwnsConnection: true</c> is then left for the code that attached it to dispose.</item>
    /// </list>
    /// <para>
    /// When the factory hands both contexts the same connection, the second context is left as it is.
    /// </para>
    /// </remarks>
    private sealed class HeldBackContext : IAsyncDisposable
    {
        private readonly System.Data.Common.DbConnection? _own;
        private readonly bool _ownsConnection;
        private readonly string? _connectionString;

        public HeldBackContext(TContext context, System.Data.Common.DbConnection shared)
        {
            Context = context;
            var own = context.Database.GetDbConnection();

            if (ReferenceEquals(own, shared))
            {
                return;
            }

            // Where the connection came from decides how it is given back (see the remarks)
            var relational = RelationalOptionsExtension.Extract(context.GetService<IDbContextOptions>());

            if (relational.Connection is null && relational.ConnectionString is { } connectionString)
            {
                _connectionString = connectionString;
            }
            else
            {
                _own = own;
                _ownsConnection = relational.Connection is not null && relational.IsConnectionOwned;
            }

            context.Database.SetDbConnection(shared, contextOwnsConnection: false);
        }

        /// <summary>The context that tracks the held-back rows.</summary>
        public TContext Context { get; }

        public async ValueTask DisposeAsync()
        {
            Context.Database.UseTransaction(null);

            if (_connectionString is not null)
            {
                Context.Database.SetDbConnection(null, contextOwnsConnection: true);
                Context.Database.SetConnectionString(_connectionString);
            }
            else if (_own is not null)
            {
                Context.Database.SetDbConnection(_own, _ownsConnection);
            }

            await Context.DisposeAsync().ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Whether <paramref name="entity"/>, or a row the save writes below it, updates an alternate key to a value a row of the
    /// save deletes still holds (the rule <see cref="GraphSaveOrder"/> holds rows back by, limited to the alternate keys).
    /// </summary>
    private static bool TakesDeletedAlternateKey(
        Microsoft.EntityFrameworkCore.Metadata.IModel model,
        GraphSaveOrder order,
        EntityBaseCore entity,
        bool cascadeSave
    )
    {
        if (entity.IsUpdated && model.FindEntityType(entity.GetType()) is { } entityType)
        {
            var alternateKeys = AlternateKeyColumns(entityType);

            if (
                alternateKeys.Length > 0
                && order.TakesDeletedValue(entity, alternateKeys.Select(column => column.Name).ToArray())
            )
            {
                return true;
            }
        }

        // A deleted row below is saved by the second stage, not with the held-back row
        return cascadeSave
            && entity
                .EnumerateCascadeChildren()
                .Any(child => !order.Defers(child) && TakesDeletedAlternateKey(model, order, child, cascadeSave));
    }

    /// <summary>
    /// Saves the tracked graph. It runs SaveChanges within an explicit transaction (Before → SaveChanges → After → Commit) when
    /// any of the recorded types has a save hook registration, or when the save deletes some rows and updates others (the
    /// stored foreign keys are read in the same transaction, see <see cref="AdoptStoredForeignKeysAsync"/>), or when it
    /// updates a row the save writes itself (an alternate key, or a row SaveChanges would send no UPDATE for, written in
    /// the same transaction, see <see cref="WriteOwnColumnsAsync"/>); otherwise
    /// SaveChanges runs without an explicit transaction (each SaveChanges call is a transaction of its own).
    /// </summary>
    /// <remarks>
    /// Either way, a statement that matched no row makes the save resolve the reported entries and run SaveChanges again
    /// (see <see cref="ResolveConcurrencyFailureAsync"/>). That retry is internal to one attempt of the execution strategy:
    /// Before has already run and is not run again, and After runs once, after the SaveChanges that succeeded. With a
    /// <paramref name="heldBack"/> context, its SaveChanges runs after the first one within the same transaction (see
    /// <see cref="HeldBackContextAsync"/>).
    /// </remarks>
    private async Task<int> SaveTrackedGraphAsync(
        TContext context,
        TContext? heldBack,
        IReadOnlyList<TEntity> roots,
        List<TrackedOperation> tracked,
        NavigationSnapshot navigations,
        GraphConsistency consistency,
        bool cascadeSave,
        bool insertWhenUpdateMissing,
        ConcurrencyMode mode,
        CancellationToken cancellationToken
    )
    {
        // Enter the hook path only when any of the recorded types has a hook registration (when none do, use the pre-existing path).
        var hasHooks =
            _saveHooks is not null
            && tracked.Any(op => _saveHooks.GetInvoker(op.Entity.GetType()) is not null);

        // A save that deletes some rows and updates others reads the stored foreign keys of the updated rows within the
        // transaction of its SaveChanges, so it takes the explicit-transaction path even without hooks
        var readsStoredForeignKeys = DeletesAndUpdates(tracked);

        // A save that updates a row it writes itself (an alternate key, or a row SaveChanges would send no UPDATE for)
        // writes it before its SaveChanges, within the same transaction (see WriteOwnColumnsAsync)
        var writesOwnColumns = tracked.Any(WritesOwnColumns);

        if (!hasHooks && !readsStoredForeignKeys && !writesOwnColumns && heldBack is null)
        {
            // No Before hook can assign a parent's key, so the unset foreign keys are filled at once
            consistency.FillAll();

            // Pre-existing path: SaveChanges without an explicit transaction (executed internally as a single transaction).
            var rowsWithoutHooks = await SaveTrackedChangesAsync(
                context,
                tracked,
                insertWhenUpdateMissing,
                mode,
                cancellationToken
            ).ConfigureAwait(false);

            // The navigations EF Core fixed up go back first, so only the deleted children leave the collections
            navigations.Restore();

            foreach (var root in roots)
            {
                EntityGraphSaver.AcceptChanges(root, cascadeSave);
            }

            return rowsWithoutHooks;
        }

        // Hook path: a session that supplies After with a context enclosing the in-progress context (and its CurrentTransaction).
        var hooks = hasHooks
            ? new SaveHookSession(_saveHooks!, _ => new EfCoreSaveHookContext(context))
            : null;

        // Before pass (prior to SaveChanges): fires in recorded order; false demotes the Entry to Unchanged and removes it from
        // the save targets. The original values are made the current ones first, so the values a hook wrote before declining
        // stay on the entity, as they do in the QuickER repositories: demoting a Modified entry resets its modified values to
        // the originals, and the change detection of SaveChanges would write a skipped delete or insert as an UPDATE of the
        // values the hook wrote. The entry is not detached, which would take a skipped child out of its parent's collection.
        var survivors = new List<TrackedOperation>(tracked.Count);

        foreach (var op in tracked)
        {
            // An unset foreign key takes the parent's key as it stands now, after the parent's own Before hook
            if (op.Operation == SaveOperation.Insert)
            {
                consistency.Fill(op.Entity);
            }

            if (
                hooks is null
                || await hooks.InvokeBeforeAsync(op.Entity, op.Operation, cancellationToken).ConfigureAwait(false)
            )
            {
                survivors.Add(op);
            }
            else
            {
                if (op.Entry is not null)
                {
                    op.Entry.OriginalValues.SetValues(op.Entry.CurrentValues);
                    op.Entry.State = EntityState.Unchanged;
                }

                hooks.Skip(op.Entity);
            }
        }

        var rows = 0;
        var adoptions = NewAdoptions();
        var attempt = new OwnWriteAttempt();

        // SaveChanges runs with acceptAllChangesOnSuccess=false, so the values the database generated (a row version, a
        // computed column) stay inside the change tracker and reach the entities only through AcceptAllChanges, after the
        // commit. After therefore still sees the values the entities were read with, and a save that does not commit (an
        // exception from After, a failed commit, a retry) never leaves a value on the entities that the database does not
        // hold - a later save of the same instance would otherwise fail as a phantom conflict.
        // To fire After "post-operation, pre-commit", and to read the stored foreign keys next to the statements they order,
        // SaveChanges is performed within an explicit transaction. Each
        // attempt has a transaction of its own, rolled back as a whole when a statement matches no row, so a retry
        // never runs on top of the statements an earlier attempt already executed. Retrying inside one transaction
        // would rely on EF Core's automatic savepoints, which EF Core turns off under SQL Server MARS (and which
        // AutoSavepointsEnabled can turn off): the retry would then send the earlier statements again (an INSERT twice
        // is a primary-key violation, a DELETE twice matches no row).
        while (true)
        {
            await using var transaction = await context.Database.BeginTransactionAsync(cancellationToken).ConfigureAwait(false);
            MissedStatements? conflict = null;

            if (heldBack is not null)
            {
                await heldBack
                    .Database.UseTransactionAsync(transaction.GetDbTransaction(), cancellationToken)
                    .ConfigureAwait(false);
            }

            try
            {
                rows = await SaveContextAsync(context).ConfigureAwait(false);

                // The held-back rows after the deletions the first SaveChanges ran (see HeldBackContextAsync)
                if (heldBack is not null)
                {
                    rows += await SaveContextAsync(heldBack).ConfigureAwait(false);
                }
            }
            catch (DbUpdateConcurrencyException ex)
            {
                conflict = new(ex.Entries, ex);
            }
            catch (OwnWriteMissedException ex)
            {
                conflict = new(ex.Entries, ex);
            }

            if (conflict is not null)
            {
                // The stored values are read after the rollback, from outside this attempt's uncommitted writes (the
                // held-back context leaves the finished transaction first, so that it reads outside it too)
                await transaction.RollbackAsync(cancellationToken).ConfigureAwait(false);

                if (heldBack is not null)
                {
                    await heldBack.Database.UseTransactionAsync(null, cancellationToken).ConfigureAwait(false);
                }

                // The versions read back after writing alternate keys rolled back with the transaction (in either
                // context); they go back before the classification, which may adopt the stored values in their place
                attempt.RollBack();

                await ResolveConcurrencyFailureAsync(
                    conflict.Entries,
                    conflict.Cause,
                    survivors,
                    insertWhenUpdateMissing,
                    mode,
                    adoptions,
                    cancellationToken
                ).ConfigureAwait(false);
                continue;
            }

            // After pass (pre-commit): fires in recorded order with the operation actually performed (Insert when switched).
            if (hooks is not null)
            {
                foreach (var op in survivors)
                {
                    await hooks.InvokeAfterAsync(op.Entity, op.Operation, cancellationToken).ConfigureAwait(false);
                }
            }

            await transaction.CommitAsync(cancellationToken).ConfigureAwait(false);
            attempt.Commit();
            break;
        }

        // The commit made the generated values real, so they reach the entities now.
        context.ChangeTracker.AcceptAllChanges();
        heldBack?.ChangeTracker.AcceptAllChanges();

        // The navigations EF Core fixed up go back first, so only the deleted children leave the collections
        navigations.Restore();

        // After a successful save, finalize the state (Added/Updated → Unchanged), leaving skipped rows as-is.
        foreach (var root in roots)
        {
            EntityGraphSaver.AcceptChanges(root, cascadeSave, hooks?.Skipped);
        }

        return rows;

        // Writes what SaveChanges would not write for the surviving entries one context tracks, then runs its SaveChanges
        // (the rows written here that SaveChanges does not write count among the rows of the save)
        async Task<int> SaveContextAsync(TContext target)
        {
            // First, before anything that runs the change detection (see WriteOwnColumnsAsync)
            var ownRows = await WriteOwnColumnsAsync(
                target,
                survivors
                    .Where(op => op.Entry is not null && ReferenceEquals(op.Entry.Context, target))
                    .Select(op => op.Entry!),
                mode,
                attempt,
                cancellationToken
            ).ConfigureAwait(false);

{{~ if exclude_unbounded_binary || runtime_package_export ~}}
            KeepStoredUnboundedBinaries(target);
{{~ end ~}}

            // The held-back context deletes nothing (the deletions are the second stage), so this reads nothing there
            if (readsStoredForeignKeys)
            {
                await AdoptStoredForeignKeysAsync(target, cancellationToken).ConfigureAwait(false);
            }

            return ownRows
                + await target.SaveChangesAsync(
                    acceptAllChangesOnSuccess: false,
                    cancellationToken
                ).ConfigureAwait(false);
        }
    }

    /// <summary>Executes a raw SQL SELECT and returns the result rows mapped to {TEntity}.</summary>
    /// <remarks>
    /// The mapping and binding semantics are identical to the existing SQL Server version (all columns required, RowState=Unchanged).
    /// The implementation delegates to <see cref="ISqlExecutor"/> (EF Core version), consolidating binding and mapping into a single path.
    /// </remarks>
    public Task<IReadOnlyList<TEntity>> QueryBySqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => _sqlExecutor.QueryBySqlAsync<TEntity>(sql, parameters, cancellationToken);

    /// <summary>Executes raw SQL (UPDATE/DELETE/any DML) and returns the number of affected rows.</summary>
    /// <remarks>
    /// Opens and closes a DbContext (connection) per call. To execute multiple statements atomically,
    /// write the transaction into the SQL of a single call on SQL Server (<c>SET XACT_ABORT ON; BEGIN TRAN ... COMMIT</c>); on
    /// SQLite run the statements inside a transaction of your own DbContext instead (see <see cref="EfCoreSqlExecutor{TContext}.ExecuteSqlAsync"/>).
    /// The implementation delegates to <see cref="ISqlExecutor"/> (EF Core version).
    /// </remarks>
    public Task<int> ExecuteSqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => _sqlExecutor.ExecuteSqlAsync(sql, parameters, cancellationToken);

    /// <summary>Executes raw SQL and returns a single scalar value (no match / DBNull yields <c>default</c>).</summary>
    /// <remarks>The conversion and binding semantics are identical to the existing SQL Server version. The implementation delegates to <see cref="ISqlExecutor"/> (EF Core version).</remarks>
    public Task<TResult?> ExecuteScalarSqlAsync<TResult>(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => _sqlExecutor.ExecuteScalarSqlAsync<TResult>(sql, parameters, cancellationToken);

    /// <summary>Builds the primary key equality predicate (e => e.Key == id) from the metadata.</summary>
    /// <remarks>
    /// The key is read off a holder object rather than embedded as a constant: EF Core sends a captured member as a
    /// parameter but writes a constant into the SQL as a literal, which compiles a new query - and gives the database a new
    /// plan to cache - for every key value.
    /// </remarks>
    private static Expression<Func<TEntity, bool>> BuildKeyPredicate(TKey id)
    {
        var parameter = Expression.Parameter(typeof(TEntity), "e");
        Expression key = Expression.Field(
            Expression.Constant(new KeyHolder(id)),
            nameof(KeyHolder.Value)
        );

        if (key.Type != _metadata.KeyProperty.PropertyType)
        {
            key = Expression.Convert(key, _metadata.KeyProperty.PropertyType);
        }

        var body = Expression.Equal(Expression.Property(parameter, _metadata.KeyProperty), key);
        return Expression.Lambda<Func<TEntity, bool>>(body, parameter);
    }

    /// <summary>Carries a key value into a predicate as a member EF Core turns into a parameter.</summary>
    private sealed class KeyHolder(TKey value)
    {
        /// <summary>The key value.</summary>
        public readonly TKey Value = value;
    }

    /// <summary>
    /// Registers one entity of the cascade closure with the DbContext via RowState → EntityState conversion, records it as a
    /// save target (when not Unchanged) into <paramref name="tracked"/>, and walks on to its children (pre-save processing for
    /// the disconnected pattern; called once per root).
    /// </summary>
    /// <remarks>
    /// <para>
    /// Only the cascade closure is registered - the children <see cref="EntityBaseCore.EnumerateCascadeChildren"/> yields,
    /// the same walk the QuickER repositories' graph save follows - and each entity is registered on its own through
    /// <c>Entry(...).State</c>, which does not reach the entities its navigations point at. A parent reference
    /// (<c>line.Order</c>, <c>order.Customer</c>) is therefore never tracked: following it would mark a deleted child's
    /// parent and siblings for deletion too, would collide when two loaded children carry separate instances of the same
    /// parent, and would write a parent the save was never asked to write.
    /// </para>
    /// <para>
    /// The recording order is the order the save hooks' Before/After fire in, and it follows the QuickER repositories (the
    /// stages of <see cref="GraphSaveOrder"/>; a child <paramref name="order"/> leaves to another stage is skipped): an
    /// entity that is kept is recorded before its children, and a deleted entity after its descendants (children first). The
    /// descendants of a deleted entity are recorded as a deletion group when <paramref name="cascadeDelete"/> is
    /// <c>true</c>, whatever <paramref name="cascadeSave"/> says (the QuickER repositories delete the children of a removed
    /// root first in that case as well); <paramref name="cascadeSave"/> only decides whether the children of an entity that
    /// is kept are saved.
    /// </para>
    /// </remarks>
    private static void TrackNode(
        TContext context,
        EntityBaseCore entity,
        bool cascadeSave,
        bool cascadeDelete,
        List<TrackedOperation> tracked,
        GraphSaveOrder? order,
        GraphConsistency consistency
    )
    {
        if (entity.IsRemoved)
        {
            // Children first, as the QuickER repositories delete them
            if (cascadeDelete)
            {
                foreach (var child in entity.EnumerateCascadeChildren())
                {
                    TrackDeletedNode(context, child, tracked);
                }
            }

            var removedEntry = context.Entry(entity);
            removedEntry.State = EntityState.Deleted;
            RecordOperation(tracked, entity, removedEntry);

            return;
        }

        // An unchanged second instance of a row the save tracks already is left out; the walk still goes below it
        if (!consistency.IsUntracked(entity))
        {
            var entry = context.Entry(entity);
            entry.State = ToEntityState(entity.RowState);
            RecordOperation(tracked, entity, entry);
        }

        if (!cascadeSave)
        {
            return;
        }

        // Unchanged entities are also registered (EntityState.Unchanged) so the walk reaches changed entities below them
        foreach (var child in entity.EnumerateCascadeChildren())
        {
            // A deleted or held-back child starts a later stage (see GraphSaveOrder)
            if (order is not null && order.Defers(child))
            {
                continue;
            }

            TrackNode(context, child, cascadeSave, cascadeDelete, tracked, order, consistency);
        }
    }

    /// <summary>Registers a descendant of a deleted entity for deletion, after its own descendants (children first).</summary>
    /// <remarks>
    /// An Added descendant (not inserted into the database yet) has no row to delete, so it is not registered with EF Core;
    /// it is still recorded, without an entry, so that the delete hooks run for it as they do in the QuickER repositories,
    /// where its DELETE affects no row.
    /// </remarks>
    private static void TrackDeletedNode(
        TContext context,
        EntityBaseCore entity,
        List<TrackedOperation> tracked
    )
    {
        foreach (var child in entity.EnumerateCascadeChildren())
        {
            TrackDeletedNode(context, child, tracked);
        }

        if (entity.IsAdded)
        {
            tracked.Add(new TrackedOperation(entity, null, SaveOperation.Delete));
            return;
        }

        var entry = context.Entry(entity);
        entry.State = EntityState.Deleted;
        RecordOperation(tracked, entity, entry);
    }

    /// <summary>Adds a record for hook firing when the EntityState is a save target (Added/Modified/Deleted); Unchanged is ignored.</summary>
    private static void RecordOperation(
        List<TrackedOperation> tracked,
        EntityBaseCore entity,
        EntityEntry entry
    )
    {
        var operation = entry.State switch
        {
            EntityState.Added => (SaveOperation?)SaveOperation.Insert,
            EntityState.Modified => SaveOperation.Update,
            EntityState.Deleted => SaveOperation.Delete,
            _ => null,
        };

        if (operation is { } value)
        {
            tracked.Add(new TrackedOperation(entity, entry, value));
        }
    }

    /// <summary>Converts a RowState into an EF Core EntityState.</summary>
    private static EntityState ToEntityState(RowState rowState) =>
        rowState switch
        {
            RowState.Added => EntityState.Added,
            RowState.Updated => EntityState.Modified,
            RowState.Removed => EntityState.Deleted,
            _ => EntityState.Unchanged,
        };

    /// <summary>
    /// Executes SaveChanges (each call a transaction of its own) and converts a <see cref="DbUpdateConcurrencyException"/>
    /// into the save contract, retrying after the reported entries are resolved.
    /// </summary>
    private static async Task<int> SaveTrackedChangesAsync(
        TContext context,
        IReadOnlyList<TrackedOperation> tracked,
        bool insertWhenUpdateMissing,
        ConcurrencyMode mode,
        CancellationToken cancellationToken
    )
    {
        var adoptions = NewAdoptions();

        while (true)
        {
            try
            {
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
                KeepStoredUnboundedBinaries(context);
{{~ end ~}}
                return await context.SaveChangesAsync(cancellationToken).ConfigureAwait(false);
            }
            catch (DbUpdateConcurrencyException ex)
            {
                await ResolveConcurrencyFailureAsync(
                    ex.Entries,
                    ex,
                    tracked,
                    insertWhenUpdateMissing,
                    mode,
                    adoptions,
                    cancellationToken
                ).ConfigureAwait(false);
            }
        }
    }

    /// <summary>
    /// Resolves the entries a <see cref="DbUpdateConcurrencyException"/> reported, so that the save can run SaveChanges
    /// again, or throws the save contract's exception.
    /// </summary>
    /// <remarks>
    /// SaveChanges reports the statement that matched no row through one exception, which covers two different situations
    /// told apart by <see cref="IsRowGoneAsync"/>:
    /// <list type="bullet">
    ///   <item>the row is gone: with insertWhenUpdateMissing=true an UPDATE is switched to an INSERT and retried, otherwise
    ///     it is reported as a <see cref="SaveConflictException"/></item>
    ///   <item>the row is still there but its concurrency token moved on: under
    ///     <see cref="ConcurrencyMode.Optimistic"/> it is reported as a <see cref="SaveConflictException"/> (it must never be
    ///     switched to an INSERT, which would turn a stale version into a primary-key violation), and under
    ///     <see cref="ConcurrencyMode.ForceOverwrite"/> the stored values are adopted as the originals so the retry wins</item>
    /// </list>
    /// An entry without a concurrency token cannot have been changed "under" this save, so its statement matching no row is
    /// treated as the row being gone without reading the stored values - the QuickER repositories do the same for a table
    /// without a rowversion column. A row that is still there (a trigger or row-level security discarded the statement) is
    /// therefore reported the way a missing one is, rather than as a concurrent modification.
    /// </remarks>
    private static async Task ResolveConcurrencyFailureAsync(
        IReadOnlyList<EntityEntry> entries,
        Exception exception,
        IReadOnlyList<TrackedOperation> tracked,
        bool insertWhenUpdateMissing,
        ConcurrencyMode mode,
        Dictionary<object, int> adoptions,
        CancellationToken cancellationToken
    )
    {
        if (entries.Count == 0)
        {
            // EF Core could not attribute the failure to any entry, so there is nothing to classify or retry. The
            // original exception is kept as the inner one: with no entry to name, it is the only thing left that
            // says which statement EF Core was running
            throw new SaveConflictException(
                "The save was rejected by a concurrency conflict that could not be attributed to a specific record. Reload the data and try again.",
                exception
            );
        }

        foreach (var entry in entries)
        {
            if (
                !await IsRowGoneAsync(entry, mode, adoptions, exception, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                continue;
            }

            // The row is gone. Depending on the policy, switch to INSERT or report as a conflict
            if (!insertWhenUpdateMissing || entry.State != EntityState.Modified)
            {
                throw SaveConflictException.NotFound(
                    entry.Entity.GetType(),
                    KeyOf(entry.Entity),
                    OperationVerb(entry.State)
                );
            }

            entry.State = EntityState.Added;

            // For nodes switched to INSERT on retry, the operation used when After fires is also updated to Insert (Before already fired as Update).
            foreach (var op in tracked)
            {
                if (ReferenceEquals(op.Entity, entry.Entity))
                {
                    op.Operation = SaveOperation.Insert;
                }
            }
        }
    }

    /// <summary>The lowercase verb of the statement an entry ran, for the messages of the save contract.</summary>
    private static string OperationVerb(EntityState state) =>
        state switch
        {
            EntityState.Deleted => "delete",
            EntityState.Added => "insert",
            _ => "update",
        };
}

/// <summary>EF Core context passed to save hook After callbacks that participates in the in-progress DbContext (and its CurrentTransaction).</summary>
/// <remarks>
/// <para>
/// Raw SQL (<see cref="ExecuteSqlAsync"/>) executes on the in-progress context's connection and current transaction
/// (reusing the same binding helper as EfCoreSqlExecutor, <see cref="RawSqlMapper.BindParameters"/>). No separate connection or transaction is opened.
/// </para>
/// <para>
/// Writing excluded binary columns (<see cref="WriteBinaryColumnAsync"/>) throws <see cref="NotSupportedException"/>
/// because EF Core cannot host dialect-specific streaming (the same policy as the stream accessors for EF Core). To update the column
/// within the same transaction, use <see cref="ExecuteSqlAsync"/> or the QuickER Repository.
/// </para>
/// </remarks>
{{ infra_visibility }} sealed class EfCoreSaveHookContext(DbContext context) : ISaveHookContext
{
    private readonly DbContext _context = context;

    /// <summary>Executes raw SQL (any DML) within the in-progress save transaction and returns the number of affected rows (binding shares the single RawSqlMapper path).</summary>
    public async Task<int> ExecuteSqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(sql);

        // The connection is owned by the in-progress DbContext and is already open within the transaction; the command
        // participates in that transaction (no separate connection or transaction is opened).
        await using var command = EfCoreCommands.Create(_context.Database, sql, parameters);
        return await command.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Writing excluded binary columns is not supported in EF Core mode (the same policy as the stream accessors: use raw SQL or the QuickER Repository).</summary>
    public Task<bool> WriteBinaryColumnAsync(
        string propertyName,
        object key,
        Stream? source,
        long? length = null,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "Writing excluded binary columns from a save hook (WriteBinaryColumnAsync) is not available in EF Core mode. "
                + "Update the column with raw SQL (ExecuteSqlAsync) or use the QuickER Repository."
        );
}
{{~ end ~}}
{{~ if ef_core && render_ef_core && emit_schema_dependent ~}}

/// <summary>Base of every generated EF Core repository, and the extension point for them. Members added to a partial declaration of this class are available to every entity repository on the EF Core engine.</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
/// <typeparam name="TContext">The concrete type of the DbContext that performs CRUD.</typeparam>
public abstract partial class EfCoreRepository<TEntity, TKey, TContext>(
    IDbContextFactory<TContext> contextFactory,
    ISaveHookRegistry? saveHooks = null,
    ISqlExecutor? sqlExecutor = null
) : EfCoreRepositoryCore<TEntity, TKey, TContext>(contextFactory, saveHooks, sqlExecutor)
    where TEntity : EntityBaseCore, new()
    where TContext : DbContext { }

/// <summary>Extensions that register the generated EF Core repositories into the DI container.</summary>
public static class GeneratedEfCoreRepositoryServiceCollectionExtensions
{
    /// <summary>Registers all generated EF Core repositories into the DI container, together with the DbContext configuration.</summary>
    /// <remarks>
    /// Because the EF Core implementations are registered against the same interfaces as the existing
    /// <c>AddGeneratedSqlServerRepositories</c> / <c>AddGeneratedSqliteRepositories</c>, swapping the call alone switches between
    /// the QuickER Repository ⇔ EF Core (with the dialect chosen by the application's configuration).
    /// The DbContext options also get <see cref="SqliteBusyTimeoutInterceptor"/> and <see cref="SqlServerQueryParameterInterceptor"/>,
    /// after <paramref name="configureDbContext"/>: on SQLite a write waits for a lock held by another connection up to the
    /// command timeout, and on SQL Server a compared value that does not fit the column's type is bound with its own type
    /// (each does nothing on other providers).
    /// </remarks>
    /// <param name="services">The service collection to register into.</param>
    /// <param name="configureDbContext">Configuration of the dialect provider and connection string (e.g. <c>options => options.UseSqlServer(...)</c>).</param>
    public static IServiceCollection AddGeneratedEfCoreRepositories(
        this IServiceCollection services,
        Action<DbContextOptionsBuilder> configureDbContext
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        ArgumentNullException.ThrowIfNull(configureDbContext);

        services.AddDbContextFactory<QuickErDbContext>(options =>
        {
            configureDbContext(options);
            options.AddInterceptors(
                SqliteBusyTimeoutInterceptor.Instance,
                SqlServerQueryParameterInterceptor.Instance
            );
        });
        services.AddSingleton<ISqlExecutor, EfCoreSqlExecutor<QuickErDbContext>>();

        // Register the save hook registry by default (a complete no-op when there are no ISaveHook<T> registrations).
        services.TryAddScoped<ISaveHookRegistry>(provider => new ServiceProviderSaveHookRegistry(
            provider
        ));
{{~ if remote_contracts && repository_classes.size > 0 ~}}

        // Both contracts are meant to hand back one repository per scope, so the remote surface forwards to the
        // full-featured registration instead of being registered on its own
        void AddRepository<TContract, TRemote, TImplementation>()
            where TContract : class, TRemote
            where TRemote : class
            where TImplementation : class, TContract
        {
            services.AddScoped<TContract, TImplementation>();
            services.AddScoped<TRemote>(provider => provider.GetRequiredService<TContract>());
        }

{{ for repository in repository_classes }}        AddRepository<{{ repository.interface_name }}, {{ repository.remote_interface_name }}, EfCore{{ repository.class_name }}>();
{{ end ~}}
{{~ else ~}}
{{ for repository in repository_classes }}        services.AddScoped<{{ repository.interface_name }}, EfCore{{ repository.class_name }}>();
{{ end ~}}
{{~ end ~}}

        return services;
    }
}
{{~ for repository in repository_classes ~}}
{{~ efcore_impl_members = join_members repository.query_shared_impl_block repository.uniqueness_binding_block ~}}
{{~ efcore_impl_members = join_members efcore_impl_members repository.binary_stream_ef_impl_block ~}}


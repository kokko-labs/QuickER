            entity.Property(e => e.{{ prop.property_name }}).HasColumnName("{{ prop.column_name }}"){{ if prop.is_required }}.IsRequired(){{ end }}{{ if prop.max_length }}.HasMaxLength({{ prop.max_length }}){{ end }}{{ if prop.precision }}.HasPrecision({{ prop.precision }}{{ if prop.scale }}, {{ prop.scale }}{{ end }}){{ end }}{{ if prop.is_row_version }}.IsRowVersion(){{ end }}{{ if prop.is_value_object }}.HasConversion(v => v!.Value, v => {{ prop.value_object_class_name }}.Create(v!)){{ end }};
{{~ end ~}}

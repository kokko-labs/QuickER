{{~ if ef_core && render_ef_core && emit_schema_dependent ~}}

/// <summary>
/// EF Core DbContext that connects to an existing schema.
/// </summary>
/// <remarks>
/// Schema creation (Migrations / EnsureCreated) is out of scope. This context only holds the configuration
/// needed to map existing entities to existing tables for reading and writing. Column database types
/// (HasColumnType) are declared only for columns the EF Core provider cannot write with its default
/// mapping for the property type (such as PostgreSQL date, timestamp and jsonb); the rest are left to DDL generation.
/// </remarks>
public partial class QuickErDbContext : DbContext
{
    /// <summary>Initializes the DbContext with the given options.</summary>
    public QuickErDbContext(DbContextOptions<QuickErDbContext> options)
        : base(options) { }
{{~ if generate_value_objects ~}}

    /// <summary>Adds an extension that translates value object string methods (Contains/StartsWith/EndsWith and .Value) into SQL.</summary>
    /// <remarks>
    /// Value objects are projected onto string columns by a converter (v =&gt; v.Value), but by default EF Core
    /// cannot translate the <c>Contains</c> of a string value object and similar members, so the query fails.
    /// <see cref="ValueObjectTranslationDbContextOptionsExtension"/> is plugged in to translate these into LIKE / plain string columns.
    /// </remarks>
    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        base.OnConfiguring(optionsBuilder);

        if (optionsBuilder.Options.FindExtension<ValueObjectTranslationDbContextOptionsExtension>() is null)
        {
            ((IDbContextOptionsBuilderInfrastructure)optionsBuilder).AddOrUpdateExtension(
                new ValueObjectTranslationDbContextOptionsExtension()
            );
        }
    }
{{~ end ~}}

    /// <summary>The name EF Core's SQL Server provider reports (Microsoft.EntityFrameworkCore.SqlServer is not referenced).</summary>
    private const string SqlServerProviderName = "Microsoft.EntityFrameworkCore.SqlServer";

    /// <summary>
    /// On SQL Server, makes EF Core convert an expression to <c>decimal(38,19)</c> rather than <c>decimal(18,2)</c> when the conversion
    /// has no column to take its type from, then calls <c>ConfigureConventionsPartial</c>.
    /// </summary>
    /// <remarks>
    /// <para>
    /// C# widens an integer to <c>decimal</c> when it is compared with one (<c>x.Id &gt; 1.5m</c>), and EF Core writes that as
    /// <c>CAST([id] AS decimal(…))</c>. With EF Core's default <c>decimal(18,2)</c>, a <c>bigint</c> value with more than 16 integral
    /// digits overflows the cast, and the whole query fails with an arithmetic overflow, whatever value it is compared with.
    /// <c>decimal(38,19)</c> holds every <c>long</c> in its 19 integral digits and keeps 19 fractional digits.
    /// A compared value with more digits than that is sent with its own type by <c>SqlServerQueryParameterInterceptor</c>.
    /// </para>
    /// <para>
    /// The setting applies only to such conversions and to values that are not compared with a column: a parameter compared with a
    /// column still takes the column's type, and the type of every property, with or without a precision, stays as it is.
    /// Other providers are left as they are.
    /// </para>
    /// </remarks>
    protected override void ConfigureConventions(ModelConfigurationBuilder configurationBuilder)
    {
        base.ConfigureConventions(configurationBuilder);

        if (Database.ProviderName == SqlServerProviderName)
        {
            configurationBuilder.DefaultTypeMapping<decimal>().HasPrecision(38, 19);
        }

        ConfigureConventionsPartial(configurationBuilder);
    }

    /// <summary>Extension point for callers to add model-wide conventions (partial; zero-cost when not implemented).</summary>
    partial void ConfigureConventionsPartial(ModelConfigurationBuilder configurationBuilder);

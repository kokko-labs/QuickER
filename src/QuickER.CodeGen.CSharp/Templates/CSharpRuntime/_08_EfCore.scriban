                .OnDelete({{ if rel.cascade_delete }}DeleteBehavior.Cascade{{ else }}DeleteBehavior.Restrict{{ end }});
{{~ else ~}}
            entity
                .HasOne(e => e.{{ rel.principal_navigation_name }})
                .WithOne({{ if rel.dependent_navigation_name != "" }}e => e.{{ rel.dependent_navigation_name }}{{ end }})
                .HasForeignKey<{{ rel.dependent_class_name }}>(e => {{ if rel.foreign_key_property_names.size == 1 }}e.{{ rel.foreign_key_property_names[0] }}{{ else }}new { {{ for k in rel.foreign_key_property_names }}e.{{ k }}{{ if !for.last }}, {{ end }}{{ end }} }{{ end }})
                .OnDelete({{ if rel.cascade_delete }}DeleteBehavior.Cascade{{ else }}DeleteBehavior.Restrict{{ end }});
{{~ end ~}}
{{~ end ~}}

    /// <summary>Maps the remote-surface endpoints for {{ repository.entity_class_name }}.</summary>
    private static void Map{{ repository.remote_route_name }}Endpoints(RouteGroupBuilder group)
    {
        MapCrud<{{ repository.entity_class_name }}, {{ repository.key_type_name }}, {{ repository.remote_interface_name }}>(
            group,
            "{{ repository.remote_route_name }}"
        );

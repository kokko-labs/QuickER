{{~ if render_sync && emit_shared_infra ~}}

/// <summary>The kind of local change recorded in the sync journal.</summary>
public enum SyncJournalOperation
{
    /// <summary>An insert or an update. The row's current local content is what gets uploaded.</summary>
    Upsert,

    /// <summary>A delete. The key and the mirrored version the row carried when it was deleted are what get uploaded.</summary>
    Delete,
}

/// <summary>Why a journal entry could not be replayed against the server.</summary>
public enum SyncConflictReason
{
    /// <summary>Someone else changed the server row after the local copy was taken.</summary>
    ModifiedOnServer,

    /// <summary>The server row the local change was meant to update no longer exists.</summary>
    MissingOnServer,

    /// <summary>The row was created locally, but a row with the same key already exists on the server.</summary>
    DuplicateOnServer,

    /// <summary>The server refused the row because a row it refers to is no longer there.</summary>
    /// <remarks>
    /// Reported when writing the row to the server failed and a parent the local row points at turned out to be gone
    /// from the server - deleted there while the row was being edited here. Neither policy brings the parent back:
    /// <see cref="SyncConflictPolicy.LocalWins"/> makes the local change win, not the local view of rows this device did
    /// not change. Running with <see cref="SyncConflictPolicy.ServerWins"/> (in either mode), pointing the row at another
    /// parent, or editing the parent locally (which records a change of its own) settles it.
    /// </remarks>
    ParentMissingOnServer,

    /// <summary>The server refused to delete the row, which it still holds and which a row it holds refers to.</summary>
    /// <remarks>
    /// Reported when deleting the row on the server failed while the server still holds it and a row the server holds
    /// refers to it - typically because another device has added one. The rows looked at are the server rows of the
    /// synchronized tables that refer to the row by its primary key; a referring table outside that reach (one the engine
    /// does not synchronize, or a foreign key that refers to a unique constraint or spans several columns) cannot be
    /// asked, and its presence alone reports the delete this way. The entry stays in the journal and the next run tries
    /// again. Running with <see cref="SyncConflictPolicy.ServerWins"/> (in either mode) brings the row back, together with
    /// whatever now points at it.
    /// </remarks>
    DeleteRefusedOnServer,

    /// <summary>The server refused the row because another row there holds one of its unique values.</summary>
    /// <remarks>
    /// Reported when writing the row to the server failed and the server's uniqueness check, asked with the local row,
    /// finds another row holding the value - typically another device took it in the meantime, or the row this device
    /// deleted to free it is still there because the delete did not go through. Neither policy takes the value from
    /// the other row: <see cref="SyncConflictPolicy.LocalWins"/> makes the local change win, not the local view of rows
    /// this device did not change. Changing the value, or running with <see cref="SyncConflictPolicy.ServerWins"/> (in
    /// either mode), settles it.
    /// </remarks>
    UniqueValueTakenOnServer,
}

/// <summary>How the engine treats a local change that collides with the server.</summary>
public enum SyncConflictPolicy
{
    /// <summary>Leaves the entry in the journal and reports it (the default: nothing is resolved silently).</summary>
    Collect,

    /// <summary>Discards the local change and makes the row match the server's state: the server's row is read back over the local one when the server has the key, and delete propagation removes the row when it does not (a local insert the server never received).</summary>
    /// <remarks>
    /// A <see cref="SyncMode.Versioned"/> run discards every local change of the tables it covers. A
    /// <see cref="SyncMode.LastWriteWins"/> run uploads as it always does and discards only the changes the server
    /// refuses (<see cref="SyncConflictReason.ParentMissingOnServer"/>,
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>, <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>),
    /// which are not reported as conflicts then. That is the one way to settle such a change to a table without a version
    /// column, which no versioned run reaches.
    /// </remarks>
    ServerWins,

    /// <summary>Resends the local change with <see cref="ConcurrencyMode.ForceOverwrite"/>, overwriting the server row - and inserting it again when the server has no such row, so a row deleted on the server is resurrected by a local edit.</summary>
    LocalWins,
}

/// <summary>One local change that could not be replayed against the server.</summary>
/// <param name="TableName">The table the row belongs to.</param>
/// <param name="KeyText">The primary key, in the same text form the journal stores.</param>
/// <param name="Operation">The local operation that was being replayed.</param>
/// <param name="Reason">Why the replay did not go through.</param>
/// <param name="LocalEntity">The local row as it stands (null for a delete, whose row is already gone locally).</param>
/// <param name="ServerEntity">The server row as it stands (null when the server has no such row).</param>
public sealed record SyncConflict(
    string TableName,
    string KeyText,
    SyncJournalOperation Operation,
    SyncConflictReason Reason,
    object? LocalEntity,
    object? ServerEntity
);

/// <summary>What replaying one journal entry did.</summary>
/// <param name="Sent">Whether the change actually reached the server.</param>
/// <param name="Conflict">The disagreement that stopped it, or null when nothing stood in the way.</param>
/// <remarks>
/// "Not sent" and "conflicted" are different outcomes and must not be folded together: an entry whose row no longer
/// exists locally has nothing left to send and is simply dropped, which is neither an upload nor a conflict.
/// </remarks>
public readonly record struct SyncUploadOutcome(bool Sent, SyncConflict? Conflict)
{
    /// <summary>The version the server stamped the row with, or null when there is none to report.</summary>
    /// <remarks>
    /// The run remembers this stamp for the download that follows, which recognises a row carrying it as the echo of
    /// what this very run sent. Null for a delete, for a discard, for a conflict, and for a table without a version
    /// column.
    /// </remarks>
    public byte[]? ServerRowVersion { get; init; }

    /// <summary>The change reached the server; the journal entry is settled.</summary>
    public static SyncUploadOutcome Uploaded { get; } = new(true, null);

    /// <summary>There was nothing to send (a stale intent); the journal entry is settled without a round trip.</summary>
    public static SyncUploadOutcome Discarded { get; } = new(false, null);

    /// <summary>The server disagreed; the journal entry stays put.</summary>
    public static SyncUploadOutcome Conflicted(SyncConflict conflict) => new(false, conflict);

    /// <summary>The change reached the server, which stamped the row with the given version.</summary>
    /// <param name="serverRowVersion">The version the server now holds for the row, or null when it holds none.</param>
    public static SyncUploadOutcome UploadedWith(byte[]? serverRowVersion) =>
        new(true, null) { ServerRowVersion = serverRowVersion };
}

/// <summary>How one run treats versions and conflicts.</summary>
public enum SyncMode
{
    /// <summary>
    /// Versioned differential sync (the default): tables with a version column sync incrementally under version
    /// guards, and tables without one take no part in the run. This is the pre-existing behaviour, unchanged.
    /// </summary>
    Versioned,

    /// <summary>
    /// Last-write-wins: every table takes part. Uploads overwrite the server unconditionally - an update that finds
    /// no row inserts it, a delete needs no version - so nothing is reported as a conflict except a write the server
    /// refuses (<see cref="SyncConflictReason.ParentMissingOnServer"/>,
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>, <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>),
    /// and <see cref="SyncOptions.ConflictPolicy"/> is ignored except that <see cref="SyncConflictPolicy.ServerWins"/>
    /// settles those three. Tables without a version column download as a full
    /// key-ordered scan on every run; tables with one still download incrementally, because the result is the same
    /// and the transfer is smaller. The winner is whoever <i>uploads</i> last, not whoever edited last, and a lost
    /// update is neither detected nor reported - that is the trade this mode names.
    /// </summary>
    LastWriteWins,
}

/// <summary>Knobs for one sync run.</summary>
public sealed class SyncOptions
{
    /// <summary>How versions and conflicts are treated in this run (default <see cref="SyncMode.Versioned"/>).</summary>
    public SyncMode Mode { get; init; } = SyncMode.Versioned;

    /// <summary>The entity types this run leaves out entirely (upload, download, and delete propagation alike).</summary>
    /// <remarks>
    /// This is a per-run scope, not a way to keep a table local: the journaling decorators keep recording the
    /// excluded tables' writes, and the next run that includes them replays what accumulated. A table that should
    /// never sync is excluded where the engine is put together instead (the <c>excludeFromSync</c> argument of
    /// <c>AddGeneratedSyncEngine</c>), which also stops the recording. A type the engine does not synchronise -
    /// including one excluded at construction - is rejected with <see cref="ArgumentException"/> rather than
    /// silently skipped.
    /// </remarks>
    public IReadOnlyCollection<Type> ExcludedEntityTypes { get; init; } = [];

    /// <summary>How many rows one download batch fetches and applies in a single local transaction (default 500).</summary>
    public int DownloadBatchSize { get; init; } = 500;

    /// <summary>
    /// How many rows one fetch and apply of <see cref="TrackedSyncEngine"/> may bring down before it checks for unsent
    /// changes (default 300,000; must be greater than zero).
    /// </summary>
    /// <remarks>
    /// The fetched rows are held in memory until they are applied. When the rows fetched exceed this limit and the tables
    /// of the run hold unsent local changes, the run throws <see cref="SyncDownloadTooLargeException"/> and applies
    /// nothing. Without unsent changes it applies the rest of the download a chunk at a time, committing as it goes (see
    /// <see cref="TrackedSyncEngine"/>), as a fetch over 50,000 rows without unsent changes does even below this limit.
    /// <see cref="SyncEngine"/> does not read this setting.
    /// </remarks>
    public int DownloadRowLimit { get; init; } = 300_000;

    /// <summary>Whether to delete local rows whose key no longer exists on the server (default true).</summary>
    /// <remarks>
    /// <para>
    /// The check compares the full key set of each table, which costs a key-only pass over the server table each time it
    /// runs - and a run runs it twice, before the download and again after it, reading the keys afresh. Turn it off (and
    /// run it on a slower schedule) when the tables are large enough for those passes to matter.
    /// </para>
    /// <para>
    /// A key the journal still holds an unsent entry for is spared, so a local edit awaiting upload - including one this
    /// run reported as a conflict - is not removed underneath the caller. That protection reaches exactly as far as the
    /// journal does: <b>a row written into a synchronised table without going through the generated repositories - raw
    /// SQL above all - has no entry, and while this is on it is deleted on the next run</b>, because from the key set's
    /// point of view it is a row the server does not have. Rows the local database is meant to keep to itself belong in
    /// a table that is not synchronised (one excluded where the engine is put together - the <c>excludeFromSync</c>
    /// argument of <c>AddGeneratedSyncEngine</c>).
    /// </para>
    /// </remarks>
    public bool PropagateDeletes { get; init; } = true;

    /// <summary>How a local change that collides with the server is treated (default <see cref="SyncConflictPolicy.Collect"/>).</summary>
    public SyncConflictPolicy ConflictPolicy { get; init; } = SyncConflictPolicy.Collect;

    /// <summary>Whether to carry the unbounded binary columns the row transfer leaves out (default false).</summary>
    /// <remarks>
    /// <para>
    /// Only tables generated with the unbounded binary columns excluded have any (<c>ISyncTable.UnboundedBinaryColumnNames</c>
    /// names them); for every other table this changes nothing. Those columns are not part of the row a run reads or
    /// writes, so with this off a downloaded row arrives without its blob and an uploaded row is sent without it. What is
    /// already stored on the receiving side stays there - an update never touches an excluded column - but a row that is
    /// new to that side has nothing to keep, and arrives with the column empty.
    /// </para>
    /// <para>
    /// With it on, each such column is copied separately after the row itself has been transferred, streamed through a
    /// temporary file so neither side has to hold the blob in memory. That is one round trip per column per changed row,
    /// which is why it is not the default: a table of large blobs whose rows change often pays for it on every run.
    /// </para>
    /// <para>
    /// That file is created in the operating system's temporary folder (<c>Path.GetTempPath()</c>) and deleted when the
    /// column has been written, so a blob whose contents are sensitive passes through the file system unencrypted for the
    /// duration of its copy - on a machine where that matters, point the temporary folder somewhere it does not.
    /// </para>
    /// </remarks>
    public bool IncludeUnboundedBinary { get; init; }
}

/// <summary>One table whose download stopped before the end of the server's changes.</summary>
/// <remarks>
/// <para>
/// A table stops at a row it cannot apply yet; only that table stops, and the tables after it in foreign-key order go
/// on. A row of a later table whose parent was behind the stopping point brings the parent in from the server first, or
/// stops its own table when the parent cannot be had (see <see cref="SyncParentResolver"/>), so no row goes in without
/// its parent.
/// </para>
/// <para>
/// A row cannot be applied yet when its own key holds an unsent local change, when another local row holds a unique
/// value it needs and cannot be brought up to date, or when it refers to a parent the local database does not have and
/// the run may not bring in: the parent's table is outside the run's scope, the parent's key holds an unsent local
/// delete the run is not discarding, or the server does not have the parent either. The last kind names the parent's
/// table in <see cref="MissingParentTableName"/>.
/// </para>
/// </remarks>
/// <param name="TableName">The table whose download stopped early.</param>
/// <param name="PendingKeyText">The key of the row the download stopped at.</param>
/// <param name="TruncatedByTableName">Always null: a table's stop no longer stops the tables after it. Kept so that code written against it goes on compiling.</param>
public sealed record SyncDownloadTruncation(
    string TableName,
    string? PendingKeyText,
    string? TruncatedByTableName
)
{
    /// <summary>The table of the parent the row the download stopped at refers to and could not have, or null when the row stopped for another reason.</summary>
    public string? MissingParentTableName { get; init; }

    /// <summary>Whether the download stopped because a local save hook skipped the row (its Before returned false).</summary>
    public bool SkippedBySaveHook { get; init; }
}

/// <summary>What one sync run did.</summary>
/// <param name="Uploaded">The number of local changes replayed against the server.</param>
/// <param name="Downloaded">The number of server rows applied locally.</param>
/// <param name="DeletedLocally">The number of local rows removed because the server no longer has that key.</param>
/// <param name="Discarded">The number of journal entries dropped without being sent (a stale intent, or ServerWins).</param>
/// <param name="Conflicts">The local changes that could not be replayed; they stay in the journal.</param>
public sealed record SyncResult(
    int Uploaded,
    int Downloaded,
    int DeletedLocally,
    int Discarded,
    IReadOnlyList<SyncConflict> Conflicts
)
{
    /// <summary>The tables whose download stopped early, empty when every table was drained.</summary>
    /// <remarks>
    /// A run that reports a conflict usually reports a truncation as well: the conflicted row's own table stops at it.
    /// The rows behind the stopping point are still on the server and come down once the entry that stopped them is
    /// settled, which is the caller's to decide and re-run.
    /// </remarks>
    public IReadOnlyList<SyncDownloadTruncation> Truncations { get; init; } = [];

    /// <summary>Whether any local change was left unsent.</summary>
    public bool HasConflicts => Conflicts.Count > 0;

    /// <summary>Whether any table's download stopped early.</summary>
    public bool HasTruncations => Truncations.Count > 0;

    /// <summary>The local rows the run discarded the changes of, or rewrote or removed on its own, empty when it did none of that.</summary>
    /// <remarks>
    /// <para>
    /// A run changes local rows that are not just the server's changes coming down: under
    /// <see cref="SyncConflictPolicy.ServerWins"/> it discards the unsent changes of the rows it settles and puts the
    /// server's content back; it brings a local row up to date when another row of the server needs the unique value it
    /// holds, and removes a row with nothing to send that keeps such a row from going; and a
    /// <see cref="SyncConflictPolicy.ServerWins"/> run removes a row it is discarding that the server does not have
    /// before the server's rows come down. Each such row is listed once per reason (see
    /// <see cref="SyncLocalRowChangeReason"/>); the counts in <see cref="Discarded"/> and <see cref="DeletedLocally"/>
    /// include the discards and the removals before the download.
    /// </para>
    /// <para>
    /// Only <see cref="SyncEngine.SyncAsync"/> fills this; <see cref="SyncEngine.UploadAsync"/> and
    /// <see cref="SyncEngine.DownloadAsync"/> called on their own return what they always did. A run that throws hands the
    /// rows it had changed so far on in the exception's <see cref="Exception.Data"/>, under
    /// <see cref="SyncEngine.LocalRowChangesDataKey"/>.
    /// </para>
    /// </remarks>
    public IReadOnlyList<SyncLocalRowChange> LocalRowChanges { get; init; } = [];
}

/// <summary>Why a sync run changed a local row other than by applying the server's change to it.</summary>
public enum SyncLocalRowChangeReason
{
    /// <summary>A <see cref="SyncConflictPolicy.ServerWins"/> run discarded the row's unsent changes and put the server's content back (or left the row for the delete propagation when the server no longer has it).</summary>
    DiscardedByServerWins,

    /// <summary>The row held a unique value a server row coming down needed, and was read again from the server (or removed, when the server no longer has it and nothing local refers to it).</summary>
    ReloadedForUniqueValue,

    /// <summary>A <see cref="SyncConflictPolicy.ServerWins"/> run removed the row, whose changes it was discarding and which the server does not have, before the server's rows came down.</summary>
    RemovedBeforeDownload,

    /// <summary>
    /// The row kept a local row holding a unique value a server row coming down needed, and had nothing to send (no
    /// unsent change, or only changes the run was discarding), so it was removed for that row to go; when the server has
    /// the row, its server copy comes back with the download - read back by key when the ordered stream has already
    /// passed it.
    /// </summary>
    RemovedForUniqueValue,
}

/// <summary>One local row a sync run changed other than by applying the server's change to it (see <see cref="SyncResult.LocalRowChanges"/>).</summary>
/// <param name="TableName">The row's table.</param>
/// <param name="KeyText">The row's key in the journal's text form.</param>
/// <param name="Reason">Why the run changed it.</param>
public sealed record SyncLocalRowChange(string TableName, string KeyText, SyncLocalRowChangeReason Reason);

/// <summary>Collects the local rows one run changes on its own, each once per reason.</summary>
internal sealed class SyncLocalRowChangeLog
{
    private readonly List<SyncLocalRowChange> _changes = [];
    private readonly HashSet<SyncLocalRowChange> _seen = [];

    /// <summary>Notes one row.</summary>
    public void Add(string tableName, string keyText, SyncLocalRowChangeReason reason)
    {
        var change = new SyncLocalRowChange(tableName, keyText, reason);

        if (_seen.Add(change))
        {
            _changes.Add(change);
        }
    }

    /// <summary>The rows noted so far, in the order they were noted.</summary>
    public IReadOnlyList<SyncLocalRowChange> ToList() => _changes.ToList();
}

/// <summary>Knobs for one refresh run.</summary>
public sealed class SyncRefreshOptions
{
    /// <summary>Which tables the refresh covers (default <see cref="SyncMode.LastWriteWins"/> = every synchronised table).</summary>
    /// <remarks>
    /// <para>
    /// A refresh has no upload, so the mode is purely a scope here - and unlike an ordinary run, the default takes
    /// everything: a refresh rebuilds the local database as a copy of the server's, and leaving the versionless
    /// tables out of that rebuild would keep stale rows pointing at parents the wipe is about to remove (a foreign
    /// key failure whenever a versionless table references a versioned one). On a diagram whose tables all carry a
    /// version column the two defaults cover the same set, so nothing changes there.
    /// </para>
    /// <para>
    /// <see cref="SyncMode.Versioned"/> narrows the refresh to the versioned tables. While a local row of a versionless
    /// table refers to a row of a versioned table, the run throws <see cref="SyncRefreshScopeException"/> before it
    /// deletes anything, rather than emptying the versioned table underneath that row.
    /// The unsent-changes refusal and the forced discard follow the scope either way: entries of tables outside
    /// this refresh are neither counted nor dropped.
    /// </para>
    /// </remarks>
    public SyncMode Mode { get; init; } = SyncMode.LastWriteWins;

    /// <summary>The entity types this refresh leaves out (neither emptied nor reloaded).</summary>
    /// <remarks>
    /// The same per-run scope as <see cref="SyncOptions.ExcludedEntityTypes"/>, with the same rejection of a type the
    /// engine does not synchronise. Leaving a child table out while one of its local rows refers to a row of a table
    /// the run empties makes the run throw <see cref="SyncRefreshScopeException"/> before it deletes anything. Leaving
    /// a parent table out while reloading its children can break a foreign key mid-run; the scope is the caller's to
    /// choose soundly there.
    /// </remarks>
    public IReadOnlyCollection<Type> ExcludedEntityTypes { get; init; } = [];

    /// <summary>How many rows one batch fetches from the server and writes locally (default 2000).</summary>
    /// <remarks>
    /// <para>
    /// Each batch is one local transaction, and on a local database that commit costs more than the inserts it commits.
    /// The default is therefore several times the one an ordinary run downloads with: a refresh writes whole tables and
    /// gains most of its speed here, while a run interrupted part way is repaired by running it again, so the finer
    /// resume granularity a small batch buys is worth less.
    /// </para>
    /// <para>
    /// The cost of raising it is memory - a batch is held in full - and, when the server is reached over HTTP, the size
    /// of one response body. A table with large binary columns is the case that wants a smaller value than the default,
    /// not a larger one.
    /// </para>
    /// </remarks>
    public int BatchSize { get; init; } = 2000;

    /// <summary>
    /// How many rows one fetch and apply of <see cref="TrackedSyncEngine"/> may bring down before it checks for unsent
    /// changes (default 300,000; must be greater than zero).
    /// </summary>
    /// <remarks>
    /// The fetched rows are held in memory until they are applied. When the rows fetched exceed this limit and the tables
    /// of the refresh hold unsent local changes other than the ones the refresh discards (changes written while the
    /// refresh runs), the run throws <see cref="SyncDownloadTooLargeException"/> and applies nothing. Otherwise it
    /// applies the rest of the refresh a chunk at a time, committing as it goes (see <see cref="TrackedSyncEngine"/>), as
    /// a fetch over 50,000 rows without such changes does even below this limit. <see cref="SyncEngine"/> does not read
    /// this setting.
    /// </remarks>
    public int DownloadRowLimit { get; init; } = 300_000;

    /// <summary>Whether to discard the unsent local changes instead of refusing to run (default false).</summary>
    /// <remarks>
    /// A refresh replaces the local rows wholesale, so an offline edit that has not reached the server yet goes with
    /// them. Leaving this off makes the run throw <see cref="SyncPendingChangesException"/> before it touches
    /// anything, which leaves the caller free to send those changes first - an ordinary
    /// <see cref="SyncEngine.SyncAsync"/> is what sends them - and refresh afterwards. Turning it on says the loss is
    /// intended.
    /// </remarks>
    public bool Force { get; init; }

    /// <summary>Whether to reload the unbounded binary columns as well (default false).</summary>
    /// <remarks>
    /// A refresh deletes the local rows, and an excluded column goes with the row that held it. Turning this on copies
    /// each such column back down after its row has been written, which makes the rebuilt local database a complete copy
    /// at the cost of one round trip per column per row. Leaving it off means the reloaded rows carry no blobs at all -
    /// which is why a table that has such columns refuses to be refreshed until one of this and
    /// <see cref="DiscardLocalUnboundedBinaries"/> says which of the two was meant.
    /// </remarks>
    public bool IncludeUnboundedBinary { get; init; }

    /// <summary>Whether to accept losing the local unbounded binary columns instead of refusing to run (default false).</summary>
    /// <remarks>
    /// This is the other answer to the same question <see cref="IncludeUnboundedBinary"/> answers, for the case where the
    /// blobs are not worth transferring - a local cache of thumbnails that can be rebuilt, say. It says the loss is
    /// intended; it does not make the rows arrive with their blobs. Setting both is not a contradiction, because
    /// carrying the columns means nothing is lost for the flag to permit.
    /// </remarks>
    public bool DiscardLocalUnboundedBinaries { get; init; }
}

/// <summary>The unbounded binary columns one table would lose in a refresh.</summary>
/// <param name="TableName">The table.</param>
/// <param name="ColumnNames">The columns the ordinary row transfer leaves out.</param>
public sealed record SyncUnboundedBinaryColumns(
    string TableName,
    IReadOnlyList<string> ColumnNames
);

/// <summary>Thrown when a refresh would drop local blobs without having been told which of the two outcomes was meant.</summary>
/// <remarks>
/// The run throws before it deletes anything. Set <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> to reload the
/// columns with the rows, or <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> to say the loss is intended.
/// </remarks>
public sealed class SyncUnboundedBinaryLossException : InvalidOperationException
{
    /// <summary>Creates the exception from the per-table breakdown of the columns at stake.</summary>
    /// <param name="columns">The unbounded binary columns, grouped by table.</param>
    public SyncUnboundedBinaryLossException(IReadOnlyList<SyncUnboundedBinaryColumns> columns)
        : base(BuildMessage(columns))
    {
        ArgumentNullException.ThrowIfNull(columns);
        Columns = columns;
    }

    /// <summary>The unbounded binary columns the refresh would have dropped, grouped by table.</summary>
    public IReadOnlyList<SyncUnboundedBinaryColumns> Columns { get; }

    /// <summary>Builds the message, which names the columns so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncUnboundedBinaryColumns> columns)
    {
        ArgumentNullException.ThrowIfNull(columns);
        var breakdown = string.Join(
            ", ",
            columns.Select(table =>
                $"{table.TableName}: {string.Join('/', table.ColumnNames)}"
            )
        );

        return "A refresh replaces the local rows, and the unbounded binary columns of these tables go with them "
            + $"({breakdown}). Set SyncRefreshOptions.IncludeUnboundedBinary to reload them as well, or "
            + "SyncRefreshOptions.DiscardLocalUnboundedBinaries to say the loss is intended.";
    }
}

/// <summary>How many unsent local changes one table has.</summary>
/// <param name="TableName">The table the changes belong to.</param>
/// <param name="Count">The number of journal entries, which counts edits rather than rows: a row edited twice offline has two.</param>
public sealed record SyncPendingChange(string TableName, int Count);

/// <summary>Thrown when a refresh is asked for while the journal still holds unsent local changes.</summary>
/// <remarks>
/// The run throws before it deletes anything, so the local database is exactly as it was and the changes are still
/// there to be uploaded.
/// </remarks>
public sealed class SyncPendingChangesException : InvalidOperationException
{
    /// <summary>Creates the exception from the per-table breakdown of what the refresh would have discarded.</summary>
    /// <param name="pendingChanges">The unsent local changes, grouped by table.</param>
    public SyncPendingChangesException(IReadOnlyList<SyncPendingChange> pendingChanges)
        : base(BuildMessage(pendingChanges))
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        PendingChanges = pendingChanges;
        PendingCount = pendingChanges.Sum(change => change.Count);
    }

    /// <summary>The unsent local changes the refresh would have discarded, grouped by table.</summary>
    public IReadOnlyList<SyncPendingChange> PendingChanges { get; }

    /// <summary>The total number of unsent local changes.</summary>
    public int PendingCount { get; }

    /// <summary>Builds the message, which names the tables so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncPendingChange> pendingChanges)
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        var breakdown = string.Join(
            ", ",
            pendingChanges.Select(change => $"{change.TableName}: {change.Count}")
        );

        return $"A refresh would discard {pendingChanges.Sum(change => change.Count)} unsent local "
            + $"change(s) ({breakdown}). Upload them with SyncAsync first, or set "
            + "SyncRefreshOptions.Force to discard them.";
    }
}

/// <summary>One table outside a refresh whose local rows refer to a table the refresh rebuilds.</summary>
/// <param name="ReferencingTableName">The table outside the refresh that holds the referring rows.</param>
/// <param name="ReferencedTableName">The table the refresh would empty, which those rows refer to.</param>
public sealed record SyncRefreshScopeReference(string ReferencingTableName, string ReferencedTableName);

/// <summary>Thrown when a refresh would empty a table that rows of a table outside the refresh refer to.</summary>
/// <remarks>
/// <para>
/// A refresh empties every table it covers before it reloads them. A local row of a table outside the refresh that
/// refers to one of those rows would either go with it, under <c>ON DELETE CASCADE</c>, taking any unsent edit of it
/// along, or make the emptying fail on the local foreign key. The run throws before it reads or deletes anything, so
/// the local database, the journal and the receipts are exactly as they were.
/// </para>
/// <para>
/// Bring the referring table into the refresh (drop it from <see cref="SyncRefreshOptions.ExcludedEntityTypes"/>, or
/// use <see cref="SyncMode.LastWriteWins"/> when it is a table without a version column), or remove the referring rows
/// first. A table that is not synchronised at all - one excluded when the engine was built, or one the diagram has but
/// the engine does not - can only be dealt with the second way.
/// </para>
/// </remarks>
public sealed class SyncRefreshScopeException : InvalidOperationException
{
    /// <summary>Creates the exception from the references that block the refresh.</summary>
    /// <param name="references">The tables outside the refresh whose rows refer to a table it rebuilds.</param>
    public SyncRefreshScopeException(IReadOnlyList<SyncRefreshScopeReference> references)
        : base(BuildMessage(references))
    {
        ArgumentNullException.ThrowIfNull(references);
        References = references;
    }

    /// <summary>The tables outside the refresh whose rows refer to a table it rebuilds.</summary>
    public IReadOnlyList<SyncRefreshScopeReference> References { get; }

    /// <summary>Builds the message, which names the tables so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncRefreshScopeReference> references)
    {
        ArgumentNullException.ThrowIfNull(references);
        var breakdown = string.Join(
            ", ",
            references.Select(reference =>
                $"{reference.ReferencingTableName} -> {reference.ReferencedTableName}"
            )
        );

        return "A refresh empties the tables it covers, and local rows of tables outside it refer to them "
            + $"({breakdown}). Bring the referring tables into the refresh, or remove the referring rows first.";
    }
}

/// <summary>What a refresh did to one table.</summary>
/// <param name="TableName">The table.</param>
/// <param name="Deleted">How many local rows were removed to make room.</param>
/// <param name="Inserted">How many server rows were written in their place.</param>
public sealed record SyncRefreshTableResult(string TableName, int Deleted, int Inserted);

/// <summary>What one refresh run did.</summary>
/// <param name="Tables">The per-table counts, in the order the rows were written (parents first).</param>
/// <param name="DiscardedChanges">The number of journal entries dropped, which is zero unless <see cref="SyncRefreshOptions.Force"/> was set.</param>
/// <param name="Elapsed">How long the whole run took, measured around it rather than accumulated per table.</param>
public sealed record SyncRefreshResult(
    IReadOnlyList<SyncRefreshTableResult> Tables,
    int DiscardedChanges,
    TimeSpan Elapsed
)
{
    /// <summary>The total number of local rows removed.</summary>
    public int Deleted => Tables.Sum(table => table.Deleted);

    /// <summary>The total number of server rows written locally.</summary>
    public int Inserted => Tables.Sum(table => table.Inserted);
}

/// <summary>Marks the writes the sync engine itself performs so the journaling decorators skip them.</summary>
/// <remarks>
/// <para>
/// Applying a downloaded row and cleaning the journal both go through the ordinary local repository, which is wrapped by
/// the journaling decorator. Without this flag every downloaded row would immediately be recorded as a local change and
/// uploaded back on the next run - the same row would bounce between the two databases forever.
/// </para>
/// <para>
/// The flag is <see cref="AsyncLocal{T}"/>, so it follows the async control flow of the sync run - including work the
/// run itself starts, such as a <see cref="System.Threading.Tasks.Task.Run(System.Action)"/> begun inside the scope. It
/// does not reach work posted to a flow that began outside the scope (a worker loop, a channel consumer, a timer), and
/// a fire-and-forget task started inside the scope stays suppressed for as long as it runs. It is a counter rather
/// than a bool so nested scopes restore the outer state.
/// </para>
/// </remarks>
public static class SyncSession
{
    private static readonly AsyncLocal<int> _depth = new();

    /// <summary>Whether the current async flow is inside a sync-engine write.</summary>
    public static bool IsSuppressed => _depth.Value > 0;

    /// <summary>Suppresses journaling until the returned scope is disposed.</summary>
    public static IDisposable Suppress()
    {
        _depth.Value++;
        return new Scope();
    }

    private sealed class Scope : IDisposable
    {
        private bool _disposed;

        public void Dispose()
        {
            if (_disposed)
            {
                return;
            }

            _disposed = true;
            _depth.Value--;
        }
    }
}

/// <summary>Collects the ids of the journal entries one recording step writes, so they can be taken back when the write they describe fails.</summary>
/// <remarks>
/// Set only while the journaling decorator records the intent of one business write (<c>RecordAndWriteAsync</c>):
/// <see cref="SyncJournal.RecordManyAsync"/> then reads back the ids it inserts. A recording made outside that step -
/// a caller writing to the journal directly - is not collected and is left as it is.
/// </remarks>
internal sealed class SyncRecordingScope
{
    private static readonly AsyncLocal<SyncRecordingScope?> _current = new();

    /// <summary>The scope the current async flow records into, or null.</summary>
    internal static SyncRecordingScope? Current => _current.Value;

    /// <summary>The ids of the entries recorded so far, in the order they were written.</summary>
    internal List<long> Ids { get; } = [];

    /// <summary>The entries recorded so far, with their ids.</summary>
    internal List<(long Id, SyncJournalRecord Record)> Recorded { get; } = [];

    /// <summary>Makes this the scope the current async flow records into, until the returned value is disposed.</summary>
    internal IDisposable Begin()
    {
        var previous = _current.Value;
        _current.Value = this;

        return new Restore(previous);
    }

    private sealed class Restore(SyncRecordingScope? previous) : IDisposable
    {
        public void Dispose() => _current.Value = previous;
    }
}

/// <summary>The size every IN clause the sync engine builds is chunked to.</summary>
/// <remarks>
/// A collection parameter is expanded into one bind variable per value, so a single statement is bounded by the
/// database's parameter limit: one run settles every table's journal entries together, and a download batch looks up
/// every key it is about to apply, so a long offline stretch or a large batch size can push either past that limit.
/// Chunking keeps the statement within it whatever the list holds. The size matches the one the dialect engines use
/// for their own IN clauses.
/// </remarks>
internal static class SyncInClause
{
    /// <summary>The maximum number of values one statement binds.</summary>
    internal const int ChunkSize = 500;
}

/// <summary>Compares server versions (unsigned big-endian integers) without knowing which table they belong to.</summary>
internal static class SyncRowVersions
{
    /// <summary>Whether a server version is past a resume point (a missing or empty resume point is passed by every version, and a missing or empty version passes nothing).</summary>
    /// <param name="version">The server version, or null.</param>
    /// <param name="anchor">The resume point, or null.</param>
    internal static bool IsPast(byte[]? version, byte[]? anchor) =>
        version is { Length: > 0 }
        && (anchor is not { Length: > 0 } || CompareRowVersions(version, anchor) > 0);

    /// <summary>The later of two server versions (null and empty both mean "no version at all").</summary>
    /// <remarks>
    /// A version is an unsigned big-endian integer, so the comparison is the lexicographic one over the significant
    /// bytes, with a longer significant run standing for the larger number. Taking the maximum rather than preferring
    /// one side is what keeps the choice safe in both directions: a receipt already cleared leaves the mirror ahead,
    /// and an echo that has not come down leaves the receipt ahead.
    /// </remarks>
    /// <param name="left">One version, or null.</param>
    /// <param name="right">The other version, or null.</param>
    internal static byte[]? Max(byte[]? left, byte[]? right)
    {
        if (left is not { Length: > 0 })
        {
            return right is { Length: > 0 } ? right : null;
        }

        if (right is not { Length: > 0 })
        {
            return left;
        }

        return CompareRowVersions(left, right) >= 0 ? left : right;
    }

    /// <summary>Compares two non-empty versions as unsigned big-endian integers.</summary>
    private static int CompareRowVersions(byte[] left, byte[] right)
    {
        var leftStart = FirstSignificantByte(left);
        var rightStart = FirstSignificantByte(right);
        var leftLength = left.Length - leftStart;
        var rightLength = right.Length - rightStart;

        if (leftLength != rightLength)
        {
            return leftLength < rightLength ? -1 : 1;
        }

        for (var index = 0; index < leftLength; index++)
        {
            var difference = left[leftStart + index].CompareTo(right[rightStart + index]);

            if (difference != 0)
            {
                return difference;
            }
        }

        return 0;
    }

    /// <summary>The offset of the first non-zero byte (the length itself when every byte is zero).</summary>
    private static int FirstSignificantByte(byte[] value)
    {
        var index = 0;

        while (index < value.Length && value[index] == 0)
        {
            index++;
        }

        return index;
    }
}

/// <summary>
/// The two locks one local database is guarded by: one that serialises the writes into it, and one that serialises the
/// sync runs over it.
/// </summary>
/// <remarks>
/// <para>
/// <b>The write lock is what lets the application keep writing while a run is in flight.</b> The journaling decorators
/// take it for each write they make - the journal entry and the business write together - and the engine takes it for
/// the stretches where it reads what is still unsent and then acts on it: applying one download batch, deleting the rows
/// the server dropped from one table, writing the server's rows over the local ones. Without it a write landing between
/// that read and that action goes unseen - a row created during the download is deleted as one the server does not have,
/// a row edited during it is overwritten by the batch. With it the write waits for at most one such stretch, and then
/// lands where the next read sees it.
/// </para>
/// <para>
/// The local database is SQLite, which takes one writer at a time anyway, so serialising the writes costs next to
/// nothing that the database was not already costing.
/// </para>
/// <para>
/// The locks are kept per raw SQL executor of the local database, not per journal: the journal is registered per scope,
/// so a screen's scope and the sync run's scope each hold their own, while the executor they share is a singleton. A
/// table is therefore guarded across scopes, and not across processes - a second process writing the same database file
/// is not something these locks can see.
/// </para>
/// <para>
/// The write lock is re-entrant along one async flow. A write the engine makes on its own behalf runs suppressed and
/// takes no lock at all; a write made while the same flow already holds the lock - a save hook writing to another
/// synchronised table, say - goes straight through rather than waiting for itself. The run lock is not: a run started
/// from a flow that already holds either lock is refused at once (see <see cref="RunExclusiveAsync{T}"/>). The mark
/// that says "this flow holds the lock" is a lease that is spent when the lock is released, so work a flow started and
/// left running cannot ride on a lock that has since been given back.
/// </para>
/// </remarks>
internal sealed class SyncLocalGate
{
    /// <summary>The gates, one per local raw SQL executor (held weakly, so a discarded executor takes its gate with it).</summary>
    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<
        ISqlExecutor,
        SyncLocalGate
    > Gates = new();

    /// <summary>The write lease the current async flow holds, if any.</summary>
    private static readonly AsyncLocal<Lease?> WriteLease = new();

    /// <summary>The run lease the current async flow holds, if any.</summary>
    private static readonly AsyncLocal<Lease?> RunLease = new();

    private readonly SemaphoreSlim _write = new(1, 1);
    private readonly SemaphoreSlim _run = new(1, 1);

    /// <summary>Gets the gate of the local database the given executor writes to.</summary>
    /// <param name="localSqlExecutor">The raw SQL executor of the local database.</param>
    internal static SyncLocalGate For(ISqlExecutor localSqlExecutor) =>
        Gates.GetValue(localSqlExecutor, static _ => new SyncLocalGate());

    /// <summary>Runs the body while holding the write lock (straight through when this flow already holds it).</summary>
    internal Task<T> WriteExclusiveAsync<T>(Func<Task<T>> body, CancellationToken cancellationToken) =>
        EnterAsync(_write, WriteLease, body, cancellationToken);

    /// <summary>Runs the body while holding the run lock.</summary>
    /// <remarks>
    /// <para>
    /// A run started from a flow that holds the write lock but not the run lock - a save hook inside a journaled
    /// write - is refused at once. The run would take the run lock and then wait for the write lock its own caller
    /// holds, and while another run is in flight that one holds the run lock and waits for the same write lock: two
    /// flows each waiting on the other, which no timeout ever ends. Refusing it whether or not another run happens to
    /// be in flight makes the mistake show the same way every time.
    /// </para>
    /// <para>
    /// A run started from a flow that already holds the run lock - a save hook that the run's own apply fires - is
    /// refused as well. The engine never starts a run from inside one of its own, so such a call can only come from
    /// code the run called back into; letting it through would start a second run inside the first, replacing the
    /// first run's record of the local rows it changed and contending with the batch it is applying.
    /// </para>
    /// </remarks>
    internal Task<T> RunExclusiveAsync<T>(Func<Task<T>> body, CancellationToken cancellationToken)
    {
        if (Holds(RunLease))
        {
            return Task.FromException<T>(
                new InvalidOperationException(
                    "A sync run cannot be started from inside another run on the same local database - a save hook "
                    + "that the run's own apply fires, for example. Start the run after the running one has returned."
                )
            );
        }

        if (Holds(WriteLease))
        {
            return Task.FromException<T>(
                new InvalidOperationException(
                    "A sync run cannot be started from inside a write to the local database it synchronises - a save "
                    + "hook of a journaled repository, for example. The write holds the lock the run needs to apply "
                    + "its batches; start the run after the write has returned."
                )
            );
        }

        return EnterAsync(_run, RunLease, body, cancellationToken);
    }

    /// <summary>Whether the current flow holds this gate's lock of the given kind.</summary>
    private bool Holds(AsyncLocal<Lease?> slot) =>
        slot.Value is { Released: false } held && ReferenceEquals(held.Gate, this);

    /// <summary>Takes the lock, marks the flow as holding it, runs the body, and gives the lock back.</summary>
    /// <remarks>
    /// The mark is set inside this method on purpose: an async method's changes to an <see cref="AsyncLocal{T}"/> do not
    /// flow back to its caller, so the body - which runs inside - is the only place the mark is seen, and it is gone again
    /// for the caller once this returns.
    /// </remarks>
    private async Task<T> EnterAsync<T>(
        SemaphoreSlim semaphore,
        AsyncLocal<Lease?> slot,
        Func<Task<T>> body,
        CancellationToken cancellationToken
    )
    {
        if (Holds(slot))
        {
            return await body().ConfigureAwait(false);
        }

        await semaphore.WaitAsync(cancellationToken).ConfigureAwait(false);
        var lease = new Lease(this);

        try
        {
            slot.Value = lease;

            return await body().ConfigureAwait(false);
        }
        finally
        {
            lease.Released = true;
            semaphore.Release();
        }
    }

    /// <summary>The mark that one flow holds one gate's lock, spent when the lock is given back.</summary>
    private sealed class Lease(SyncLocalGate gate)
    {
        /// <summary>The gate whose lock is held.</summary>
        public SyncLocalGate Gate { get; } = gate;

        /// <summary>Whether the lock has been given back (a spent lease marks nothing).</summary>
        public volatile bool Released;
    }
}

/// <summary>One local change to record in the journal.</summary>
/// <param name="TableName">The table the changed row belongs to.</param>
/// <param name="KeyText">The primary key in the text form the table's descriptor produces.</param>
/// <param name="Operation">Whether the row was written or deleted.</param>
/// <param name="OriginalRowVersion">For a delete, the mirrored server version the row carried; otherwise null.</param>
public sealed record SyncJournalRecord(
    string TableName,
    string KeyText,
    SyncJournalOperation Operation,
    byte[]? OriginalRowVersion
)
{
    /// <summary>The unbounded binary columns the write stored a value in, or null when it stored none.</summary>
    /// <remarks>
    /// An insert stores every such column, a write of one column through its accessor stores that one, and an update
    /// stores none - it never touches them. A run that carries these columns sends only the ones some entry of the row
    /// names, so a blob this device never had is not sent over the server's.
    /// </remarks>
    public IReadOnlyList<string>? UnboundedBinaryColumns { get; init; }

    /// <summary>The entity the entry was made from, when the journaling decorator recorded it (see <see cref="SyncRecordingScope"/>).</summary>
    internal EntityBaseCore? Entity { get; init; }

    /// <summary>The descriptor that formats <see cref="Entity"/>'s key.</summary>
    internal ISyncTableDescriptor? Descriptor { get; init; }

    /// <summary>Whether the entry was recorded for a graph save, whose save hooks may skip the row.</summary>
    internal bool SavedByGraph { get; init; }
}

/// <summary>One row of the journal table, as the lenient projection mapper reads it.</summary>
public sealed class SyncJournalRow
{
    /// <summary>The autoincrement id (also the replay order).</summary>
    public long Id { get; set; }

    /// <summary>The table the change belongs to.</summary>
    public string TableName { get; set; } = string.Empty;

    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;

    /// <summary>The operation name (the <see cref="SyncJournalOperation"/> member name).</summary>
    public string Operation { get; set; } = string.Empty;

    /// <summary>The version the row carried when it was deleted (null for an upsert as recorded).</summary>
    /// <remarks>
    /// In the entry the replay hands a table, an upsert of a row that was deleted and then created again under the same
    /// key carries the version the delete recorded: the server still holds that row, and the new content goes there as
    /// an update guarded by it.
    /// </remarks>
    public byte[]? OriginalRowVersion { get; set; }

    /// <summary>The unbounded binary columns the write stored a value in, comma-separated (null when it stored none).</summary>
    public string? UnboundedBinaryColumns { get; set; }
}

/// <summary>One blob copy a download still owes, as the lenient projection mapper reads it.</summary>
internal sealed class SyncBlobCopyRow
{
    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;

    /// <summary>The unbounded binary column still to be copied.</summary>
    public string ColumnName { get; set; } = string.Empty;
}

/// <summary>One row a download still owes this device, as the lenient projection mapper reads it.</summary>
internal sealed class SyncOwedRow
{
    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;
}

/// <summary>One row of the acknowledgement table, as the lenient projection mapper reads it.</summary>
public sealed class SyncAckRow
{
    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;

    /// <summary>The version the server stamped on the row when it took this device's upload.</summary>
    public byte[] ServerRowVersion { get; set; } = [];
}

/// <summary>
/// The local record of offline edits (<c>quicker_sync_journal</c>) and of the uploads the server has taken
/// (<c>quicker_sync_ack</c>), kept in two shared tables in the local database.
/// </summary>
/// <remarks>
/// <para>
/// The server gets no extra schema at all; only the local database - which the application owns - gets these two
/// tables, and two more for what a download still owes this device (blob copies, <c>quicker_sync_blob_pending</c>, and
/// rows to read back, <c>quicker_sync_row_pending</c>), each created on first use with
/// <c>CREATE TABLE IF NOT EXISTS</c>.
/// </para>
/// <para>
/// <b>The acknowledgement table is a per-row receipt, not a resume point.</b> It holds, for a row this device has
/// uploaded, the version the server stamped on it - which the upload may not write into the mirror, because the
/// mirrored version is what the download derives its resume point from and only the download may move it. Until the
/// row comes back down and the mirror catches up, the receipt is the only record that the local row has already been
/// accepted at a newer version, and the replay of a further edit needs it to guard against the right original.
/// </para>
/// <para>
/// <b>Recording happens before the business write ("journal-first").</b> The generated repositories manage their own
/// connection, so a decorator cannot enlist its INSERT in the transaction of the write it wraps; something has to go
/// first. Recording the <i>intent</i> first is the safe order: if the business write then fails or is rolled back, the
/// journal holds an entry for a write that never landed, and the upload settles it from the local row as it is: an
/// upsert entry whose insert never landed finds no row and is discarded, and a delete entry whose delete never landed
/// finds the row still there and is discarded too - the replay looks for the local row before it deletes anything on
/// the server, so a failed local delete is not finished there. (The decorator removes the entries of a write that fails
/// while it is still waiting on it; what is left over is what a process stopped in between leaves.) The opposite order
/// would lose changes outright: a write that succeeded and a journal entry that never landed is an edit no later run
/// can find. The entry also carries only the key, never a snapshot, so a stale intent still uploads the row's current
/// content.
/// </para>
/// </remarks>
public sealed class SyncJournal
{
    /// <summary>The statement that creates the journal table when it is missing.</summary>
    private const string CreateTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_journal ("
        + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "operation TEXT NOT NULL, "
        + "original_row_version BLOB NULL, "
        + "unbounded_binary_columns TEXT NULL, "
        + "recorded_at TEXT NOT NULL)";

    /// <summary>The statement that creates the acknowledgement table when it is missing.</summary>
    private const string CreateAckTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_ack ("
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "server_row_version BLOB NOT NULL, "
        + "PRIMARY KEY (table_name, key_text))";

    /// <summary>The statement that creates the table of blob copies a download still owes, when it is missing.</summary>
    private const string CreateBlobCopyTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_blob_pending ("
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "column_name TEXT NOT NULL, "
        + "PRIMARY KEY (table_name, key_text, column_name))";

    /// <summary>The statement that creates the table of rows a download still owes, when it is missing.</summary>
    private const string CreateOwedRowTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_row_pending ("
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "PRIMARY KEY (table_name, key_text))";

    /// <summary>
    /// The key text an entry is recorded under while its row has no key yet - a new row whose key a save hook is still
    /// to set (see <see cref="SyncTableDescriptor{TEntity, TKey}.FormatEntityKey"/>).
    /// </summary>
    /// <remarks>
    /// <para>
    /// Such an entry exists only inside the write that recorded it: the write holds the local write lock from recording
    /// to the check that follows it, and the check moves the entry to the key the save gave the row. The readers the
    /// engine uses leave it out (<see cref="ReadAllAsync"/>, <see cref="CountPendingAsync"/>), since a run reading the
    /// journal outside that lock could otherwise read the entry mid-write and try to parse a key that is not one.
    /// </para>
    /// <para>
    /// One left behind - the process ended between the write and the check, or the check failed - names no row, so an
    /// upload removes it when it plans the table, under the write lock (see <see cref="RemoveUnsetKeyEntriesAsync"/>).
    /// The row the write saved then has no entry of its own, as a row whose integer key the check had yet to move has
    /// none.
    /// </para>
    /// </remarks>
    internal const string UnsetKeyText = "\u0001quicker:unset-key";

    /// <summary>
    /// The unbounded binary columns an entry's <see cref="SyncJournalRow.UnboundedBinaryColumns"/> names (the column
    /// names, comma-separated, as the entry was recorded; none when it is null or empty).
    /// </summary>
    /// <param name="columns">The entry's column list.</param>
    internal static string[] SplitUnboundedBinaryColumns(string? columns) =>
        string.IsNullOrEmpty(columns) ? [] : columns.Split(',');

    /// <summary>Reads every pending entry in replay order, aliasing the columns onto the DTO's property names.</summary>
    private const string SelectAllSql =
        "SELECT id AS Id, table_name AS TableName, key_text AS KeyText, operation AS Operation, "
        + "original_row_version AS OriginalRowVersion, unbounded_binary_columns AS UnboundedBinaryColumns "
        + "FROM quicker_sync_journal WHERE key_text <> @unsetKeyText ORDER BY id";

    /// <summary>Reads one table's pending entries in replay order (the columns as <see cref="SelectAllSql"/> aliases them).</summary>
    private const string SelectTableSql =
        "SELECT id AS Id, table_name AS TableName, key_text AS KeyText, operation AS Operation, "
        + "original_row_version AS OriginalRowVersion, unbounded_binary_columns AS UnboundedBinaryColumns "
        + "FROM quicker_sync_journal WHERE table_name = @tableName AND key_text <> @unsetKeyText ORDER BY id";

    /// <summary>Reads one table's acknowledgements, aliasing the columns onto the DTO's property names.</summary>
    private const string SelectAcksSql =
        "SELECT key_text AS KeyText, server_row_version AS ServerRowVersion FROM quicker_sync_ack "
        + "WHERE table_name = @tableName";

    private readonly ISqlExecutor _localSqlExecutor;
    private volatile bool _ensured;

    /// <summary>The local database the journal lives in (the same one the synchronised tables are in).</summary>
    internal ISqlExecutor LocalSqlExecutor => _localSqlExecutor;

    /// <summary>Creates a journal over the local database's raw SQL executor.</summary>
    /// <param name="localSqlExecutor">The raw SQL executor bound to the local (SQLite) database.</param>
    public SyncJournal(ISqlExecutor localSqlExecutor)
    {
        ArgumentNullException.ThrowIfNull(localSqlExecutor);
        _localSqlExecutor = localSqlExecutor;
        Gate = SyncLocalGate.For(localSqlExecutor);
    }

    /// <summary>The locks of the local database this journal lives in (shared by every journal over the same executor).</summary>
    internal SyncLocalGate Gate { get; }

    /// <summary>
    /// Creates the tables when they do not exist yet (idempotent, and only issued once per instance). Each table is
    /// created on its own, so a local database an earlier version left with only some of them gets the rest.
    /// </summary>
    public async Task EnsureCreatedAsync(CancellationToken cancellationToken = default)
    {
        if (_ensured)
        {
            return;
        }

        await _localSqlExecutor
            .ExecuteSqlAsync(CreateTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(CreateAckTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(CreateBlobCopyTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(CreateOwedRowTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        _ensured = true;
    }

    /// <summary>
    /// Rewrites the key texts of the given tables - in the journal, the receipts, the owed blob copies and the owed rows -
    /// into the form the tables write today.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A key text an earlier version wrote can differ from the one the table writes now: a <see cref="DateTime"/> key
    /// used to carry its kind (<c>Z</c>, or the local offset), while the row read back from either database carries
    /// none. Every comparison the engine makes is ordinal, so such an entry would never meet its row - an edit taken for
    /// a row that is gone, a receipt never found. They are rewritten before a run reads them, so a local database kept
    /// from an earlier version goes on working as it is.
    /// </para>
    /// <para>
    /// Two receipts that come to name the same key keep the later version; two owed copies of the same column, or two
    /// owed rows, become one. It runs at the start of every run, not once per instance: a journal instance can outlive
    /// the version of the generated code that wrote the texts it is now asked to read. Only the tables whose form has
    /// changed are read.
    /// </para>
    /// </remarks>
    /// <param name="normalizers">The rewrite of each table whose form has changed, by table name.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task NormalizeKeyTextsAsync(
        IReadOnlyDictionary<string, Func<string, string>> normalizers,
        CancellationToken cancellationToken
    )
    {
        if (normalizers.Count > 0)
        {
            foreach (var entry in await ReadAllAsync(cancellationToken).ConfigureAwait(false))
            {
                if (
                    normalizers.TryGetValue(entry.TableName, out var normalize)
                    && normalize(entry.KeyText) is var keyText
                    && !string.Equals(keyText, entry.KeyText, StringComparison.Ordinal)
                )
                {
                    await _localSqlExecutor
                        .ExecuteSqlAsync(
                            "UPDATE quicker_sync_journal SET key_text = @keyText WHERE id = @id",
                            new { keyText, id = entry.Id },
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }
            }

            foreach (var (tableName, normalize) in normalizers)
            {
                var acks = await ReadAcksAsync(tableName, cancellationToken).ConfigureAwait(false);

                foreach (var (keyText, version) in acks)
                {
                    var normalized = normalize(keyText);

                    if (string.Equals(normalized, keyText, StringComparison.Ordinal))
                    {
                        continue;
                    }

                    var kept = acks.TryGetValue(normalized, out var existing)
                        ? SyncRowVersions.Max(version, existing) ?? version
                        : version;
                    await RecordAckAsync(tableName, normalized, kept, cancellationToken)
                        .ConfigureAwait(false);
                    await RemoveAcksAsync(tableName, [keyText], cancellationToken)
                        .ConfigureAwait(false);
                }

                foreach (var copy in await ReadBlobCopiesAsync(tableName, cancellationToken).ConfigureAwait(false))
                {
                    var normalized = normalize(copy.KeyText);

                    if (string.Equals(normalized, copy.KeyText, StringComparison.Ordinal))
                    {
                        continue;
                    }

                    await RecordBlobCopiesAsync(tableName, [normalized], [copy.ColumnName], cancellationToken)
                        .ConfigureAwait(false);
                    await _localSqlExecutor
                        .ExecuteSqlAsync(
                            "DELETE FROM quicker_sync_blob_pending WHERE table_name = @tableName "
                                + "AND key_text = @keyText AND column_name = @columnName",
                            new
                            {
                                tableName,
                                keyText = copy.KeyText,
                                columnName = copy.ColumnName,
                            },
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }

                foreach (var keyText in await ReadOwedRowsAsync(tableName, cancellationToken).ConfigureAwait(false))
                {
                    var normalized = normalize(keyText);

                    if (string.Equals(normalized, keyText, StringComparison.Ordinal))
                    {
                        continue;
                    }

                    await RecordOwedRowsAsync(tableName, [normalized], cancellationToken).ConfigureAwait(false);
                    await RemoveOwedRowsAsync(tableName, [keyText], cancellationToken).ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>Records one local change (a no-op while the sync engine's own writes are running).</summary>
    /// <param name="tableName">The table the changed row belongs to.</param>
    /// <param name="keyText">The primary key in the text form the table's descriptor produces.</param>
    /// <param name="operation">Whether the row was written or deleted.</param>
    /// <param name="originalRowVersion">For a delete, the mirrored server version the row carried; otherwise null.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task RecordAsync(
        string tableName,
        string keyText,
        SyncJournalOperation operation,
        byte[]? originalRowVersion,
        CancellationToken cancellationToken = default
    ) =>
        RecordManyAsync(
            [new SyncJournalRecord(tableName, keyText, operation, originalRowVersion)],
            cancellationToken
        );

    /// <summary>Records several local changes at once, in the given order (a no-op while the sync engine's own writes are running).</summary>
    /// <remarks>
    /// <para>
    /// What a bulk insert or a graph save records goes through here, so the cost of the journal grows with the number of
    /// statements rather than with the number of rows: the entries are written as multi-row inserts of
    /// <see cref="RowsPerStatement"/> rows each, and every statement is one commit instead of one commit per row.
    /// </para>
    /// <para>
    /// The statements are separate commits, and that is enough. The journal is written before the business write it
    /// describes, so a recording cut short leaves entries for rows the business write never reached - entries the
    /// upload re-reads, finds nothing for, and drops - and never a written row without one. When the journaling
    /// decorator records, it also takes the entries back if the business write then fails (see
    /// <see cref="JournalingRepositoryBase{TEntity, TKey}"/>).
    /// </para>
    /// <para>
    /// The per-row values go in as one collection parameter per column, and the statement names their elements
    /// directly (<c>@tableName0</c>, <c>@tableName1</c>, ...). That relies on the collection binding of the raw SQL
    /// executor - an element <i>i</i> of a collection <c>name</c> is bound as <c>@name</c><i>i</i>, and only a bare
    /// <c>@name</c> in the text is rewritten - so an executor put in front of the local database has to keep that
    /// convention, which the generated one and any wrapper that hands the call on to it do.
    /// </para>
    /// </remarks>
    /// <param name="records">The changes to record, in the order they are to be replayed.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RecordManyAsync(
        IReadOnlyList<SyncJournalRecord> records,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(records);

        if (SyncSession.IsSuppressed || records.Count == 0)
        {
            return;
        }

        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        var recordedAt = DateTime.UtcNow.ToString(
            "o",
            System.Globalization.CultureInfo.InvariantCulture
        );

        // Inside a decorator's recording step the ids are read back, so the entries can be taken back if the write they
        // describe fails (see SyncRecordingScope). The statement is the same one, with the ids returned.
        var scope = SyncRecordingScope.Current;

        foreach (var chunk in records.Chunk(RowsPerStatement))
        {
            var rows = string.Join(
                ", ",
                Enumerable
                    .Range(0, chunk.Length)
                    .Select(index =>
                        $"(@tableName{index}, @keyText{index}, @operation{index}, "
                        + $"@originalRowVersion{index}, @unboundedBinaryColumns{index}, @recordedAt)"
                    )
            );

            var sql =
                "INSERT INTO quicker_sync_journal "
                + "(table_name, key_text, operation, original_row_version, "
                + "unbounded_binary_columns, recorded_at) "
                + "VALUES "
                + rows;
            var parameters = new
            {
                tableName = chunk.Select(record => record.TableName).ToList(),
                keyText = chunk.Select(record => record.KeyText).ToList(),
                operation = chunk.Select(record => record.Operation.ToString()).ToList(),
                originalRowVersion = chunk.Select(record => record.OriginalRowVersion).ToList(),
                unboundedBinaryColumns = chunk
                    .Select(record =>
                        record.UnboundedBinaryColumns is { Count: > 0 } columns
                            ? string.Join(',', columns)
                            : null
                    )
                    .ToList(),
                recordedAt,
            };

            if (scope is null)
            {
                await _localSqlExecutor
                    .ExecuteSqlAsync(sql, parameters, cancellationToken)
                    .ConfigureAwait(false);
            }
            else
            {
                // One statement inserts its rows in the order they are listed, so the ids it hands back, ascending, are
                // the rows' ids in that order.
                var ids = (
                    await _localSqlExecutor
                        .QueryProjectionBySqlAsync<long>(
                            sql + " RETURNING id",
                            parameters,
                            cancellationToken
                        )
                        .ConfigureAwait(false)
                )
                    .Order()
                    .ToList();
                scope.Ids.AddRange(ids);
                scope.Recorded.AddRange(ids.Zip(chunk));
            }
        }
    }

    /// <summary>Records a write of one unbounded binary column inside the transaction of the save that made it.</summary>
    /// <remarks>
    /// What a save hook writes through its context goes through here (see <see cref="SaveHookContextWrites"/>): the entry
    /// is written by the save's own connection, so it commits or rolls back with the save, and a save that does not
    /// commit leaves no entry behind. The table has to exist already, since the save holds the database's write lock and
    /// another connection could not create it.
    /// </remarks>
    /// <param name="context">The context of the save that wrote the column.</param>
    /// <param name="tableName">The table the row belongs to.</param>
    /// <param name="keyText">The row's key text.</param>
    /// <param name="columnName">The property name of the column written.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal Task RecordWithinSaveAsync(
        ISaveHookContext context,
        string tableName,
        string keyText,
        string columnName,
        CancellationToken cancellationToken
    ) =>
        context.ExecuteSqlAsync(
            "INSERT INTO quicker_sync_journal "
                + "(table_name, key_text, operation, original_row_version, "
                + "unbounded_binary_columns, recorded_at) "
                + "VALUES (@tableName, @keyText, @operation, NULL, @unboundedBinaryColumns, @recordedAt)",
            new
            {
                tableName,
                keyText,
                operation = SyncJournalOperation.Upsert.ToString(),
                unboundedBinaryColumns = columnName,
                recordedAt = DateTime.UtcNow.ToString(
                    "o",
                    System.Globalization.CultureInfo.InvariantCulture
                ),
            },
            cancellationToken
        );

    /// <summary>How many entries one multi-row insert of <see cref="RecordManyAsync"/> carries.</summary>
    /// <remarks>
    /// Each entry binds one parameter per column, so the statement stays well inside 999 - the limit an SQLite build
    /// older than 3.32 still applies - whatever the columns grow to.
    /// </remarks>
    private const int RowsPerStatement = 100;

    /// <summary>Reads every pending entry in the order it was recorded.</summary>
    /// <remarks>
    /// An entry of a row that has no key yet is left out: it belongs to a write still in progress (see
    /// <see cref="UnsetKeyText"/>).
    /// </remarks>
    public async Task<IReadOnlyList<SyncJournalRow>> ReadAllAsync(
        CancellationToken cancellationToken = default
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncJournalRow>(
                SelectAllSql,
                new { unsetKeyText = UnsetKeyText },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Reads the pending entries of one table in the order they were recorded (what <see cref="ReadAllAsync"/> returns for it).</summary>
    /// <param name="tableName">The table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<IReadOnlyList<SyncJournalRow>> ReadTableAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncJournalRow>(
                SelectTableSql,
                new { tableName, unsetKeyText = UnsetKeyText },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>
    /// Removes the entries of one table a write left under <see cref="UnsetKeyText"/> (called by an upload under the write
    /// lock, where no write is between recording such an entry and moving it to its key).
    /// </summary>
    /// <param name="tableName">The table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task RemoveUnsetKeyEntriesAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_journal WHERE table_name = @tableName AND key_text = @unsetKeyText",
                new { tableName, unsetKeyText = UnsetKeyText },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes the given entries (called once the change they describe has reached the server).</summary>
    /// <remarks>The removal is chunked to <see cref="SyncInClause.ChunkSize"/> ids per statement.</remarks>
    public async Task RemoveAsync(
        IReadOnlyList<long> ids,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(ids);

        foreach (var chunk in ids.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_journal WHERE id IN (@ids)",
                    new { ids = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Removes every entry of one table, discarding the unsent local changes it held.</summary>
    /// <remarks>
    /// <para>
    /// This is journal maintenance for a table that is no longer synchronised - one excluded where the engine is put
    /// together after entries had already accumulated. Such entries can never be replayed (no run knows the table),
    /// yet they count as unsent changes and block <see cref="SyncEngine.RefreshAsync"/> for ever. Removing them is
    /// the deliberate statement that those local edits will never reach the server.
    /// </para>
    /// <para>
    /// Do not call it while a sync run is in flight: the run reads the journal once at its start and settles entries
    /// by id, and removing rows underneath it makes the two views disagree.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table whose entries are dropped.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveTableAsync(
        string tableName,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_journal WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes every entry of every table, discarding all unsent local changes.</summary>
    /// <remarks>
    /// The whole-journal counterpart of <see cref="RemoveTableAsync"/>, with the same warnings: it is the journal half
    /// of what <see cref="SyncConflictPolicy.ServerWins"/> does at upload time, done without a run. What it leaves out
    /// is the other half - reading the server's rows back over the local ones - so an edit to a row the server has not
    /// changed since it was mirrored stays where it is, with nothing left to say it is there.
    /// </remarks>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveAllAsync(CancellationToken cancellationToken = default)
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync("DELETE FROM quicker_sync_journal", null, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Records the version the server stamped on a row this device uploaded (one receipt per key, replaced on repeat).</summary>
    /// <remarks>
    /// <para>
    /// Written <i>before</i> the journal entry it settles is removed. Both surviving a crash costs nothing: the next
    /// run replays the same local content with the acknowledged version as its original, and the server takes it
    /// again. The opposite order leaves the row with a mirrored version behind the server's and nothing left to say
    /// so, which is the very state the receipt exists to prevent.
    /// </para>
    /// <para>
    /// The one window nothing can close is between the server accepting the upload and this write: a crash in
    /// between leaves an entry whose change the server already holds, and the next run's version-guarded replay
    /// reports it as a conflict against a row this device itself wrote.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table the row belongs to.</param>
    /// <param name="keyText">The primary key in the text form the table's descriptor produces.</param>
    /// <param name="serverRowVersion">The version the server stamped on the row it accepted.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RecordAckAsync(
        string tableName,
        string keyText,
        byte[] serverRowVersion,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        ArgumentNullException.ThrowIfNull(keyText);
        ArgumentNullException.ThrowIfNull(serverRowVersion);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "INSERT OR REPLACE INTO quicker_sync_ack "
                    + "(table_name, key_text, server_row_version) "
                    + "VALUES (@tableName, @keyText, @serverRowVersion)",
                new
                {
                    tableName,
                    keyText,
                    serverRowVersion,
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Reads every acknowledgement of one table, by the key's journal text form.</summary>
    /// <param name="tableName">The table whose receipts are read.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task<IReadOnlyDictionary<string, byte[]>> ReadAcksAsync(
        string tableName,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        var rows = await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncAckRow>(
                SelectAcksSql,
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
        var byKeyText = new Dictionary<string, byte[]>(StringComparer.Ordinal);

        foreach (var row in rows)
        {
            byKeyText[row.KeyText] = row.ServerRowVersion;
        }

        return byKeyText;
    }

    /// <summary>Removes the acknowledgements of the given keys (the receipt has served its purpose, or has gone stale).</summary>
    /// <remarks>The removal is chunked to <see cref="SyncInClause.ChunkSize"/> keys per statement.</remarks>
    /// <param name="tableName">The table the keys belong to.</param>
    /// <param name="keyTexts">The keys whose receipts go.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveAcksAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        ArgumentNullException.ThrowIfNull(keyTexts);

        foreach (var chunk in keyTexts.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_ack WHERE table_name = @tableName "
                        + "AND key_text IN (@keyTexts)",
                    new { tableName, keyTexts = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Removes every acknowledgement of one table (what a refresh does, having rebuilt its rows outright).</summary>
    /// <param name="tableName">The table whose receipts go.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveTableAcksAsync(
        string tableName,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_ack WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Rewrites the key text of the given entries (what a write that settled its row's key only as it ran leaves behind).</summary>
    /// <param name="rewrites">The entries and the key texts they are to carry.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task RewriteKeyTextsAsync(
        IReadOnlyList<(long Id, string KeyText)> rewrites,
        CancellationToken cancellationToken
    )
    {
        foreach (var (id, keyText) in rewrites)
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "UPDATE quicker_sync_journal SET key_text = @keyText WHERE id = @id",
                    new { keyText, id },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Widens the unbounded binary columns one entry names to the given ones (what an upload that inserted the row still owes).</summary>
    /// <remarks>
    /// An upload that inserts the row sends every unbounded binary column after it, and the copy can fail on its own.
    /// The row is on the server by then, so the next replay takes the update path, which sends only the columns the
    /// entries name - an update's entry names none - and the blobs the insert left empty would never follow. Recording
    /// every column on the entry before the copy keeps them owed until a run sends them.
    /// </remarks>
    /// <param name="id">The id of the entry.</param>
    /// <param name="columns">The columns the entry is to name.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task WidenUnboundedBinaryColumnsAsync(
        long id,
        IReadOnlyList<string> columns,
        CancellationToken cancellationToken
    )
    {
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "UPDATE quicker_sync_journal SET unbounded_binary_columns = @columns WHERE id = @id",
                new { columns = string.Join(',', columns), id },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Records that the given columns of the given rows are to be copied down (before the rows are written).</summary>
    /// <remarks>
    /// A download writes a batch of rows and copies their blobs afterwards, and the copy can fail on its own. The row
    /// is in by then and its mirrored version has moved the resume point past it, so no later download would bring it
    /// down again - this record is what remembers the blob still owed, until the copy has been made.
    /// </remarks>
    internal async Task RecordBlobCopiesAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        IReadOnlyList<string> columnNames,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        var pairs = keyTexts.SelectMany(keyText => columnNames.Select(column => (keyText, column)));

        foreach (var chunk in pairs.Chunk(RowsPerStatement))
        {
            var rows = string.Join(
                ", ",
                Enumerable
                    .Range(0, chunk.Length)
                    .Select(index => $"(@tableName, @keyText{index}, @columnName{index})")
            );

            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "INSERT OR IGNORE INTO quicker_sync_blob_pending (table_name, key_text, column_name) "
                        + "VALUES "
                        + rows,
                    new
                    {
                        tableName,
                        keyText = chunk.Select(pair => pair.keyText).ToList(),
                        columnName = chunk.Select(pair => pair.column).ToList(),
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Reads the blob copies one table still owes, as key and column pairs.</summary>
    internal async Task<IReadOnlyList<SyncBlobCopyRow>> ReadBlobCopiesAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncBlobCopyRow>(
                "SELECT key_text AS KeyText, column_name AS ColumnName FROM quicker_sync_blob_pending "
                    + "WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes every blob copy one table owes (what a refresh does, having emptied the table).</summary>
    internal async Task RemoveTableBlobCopiesAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_blob_pending WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes the blob copies owed for the given rows (every column of them).</summary>
    internal async Task RemoveBlobCopiesAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        foreach (var chunk in keyTexts.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_blob_pending WHERE table_name = @tableName "
                        + "AND key_text IN (@keyTexts)",
                    new { tableName, keyTexts = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Records rows a download still owes this device: rows removed here that are to be read back from the server.</summary>
    /// <remarks>
    /// A row the engine removes to let a unique value's holder go can be one the ordered stream has already passed - its
    /// server version at or below the resume point the remaining rows derive - so no later download would bring it down
    /// again. The record is written before the row goes, and it is what remembers the row until it has been read back
    /// (see <see cref="SyncParentResolver.RemoveRowsKeepingHoldersAsync"/>).
    /// </remarks>
    internal async Task RecordOwedRowsAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        foreach (var chunk in keyTexts.Chunk(RowsPerStatement))
        {
            var rows = string.Join(
                ", ",
                Enumerable.Range(0, chunk.Length).Select(index => $"(@tableName, @keyText{index})")
            );

            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "INSERT OR IGNORE INTO quicker_sync_row_pending (table_name, key_text) VALUES " + rows,
                    new { tableName, keyText = chunk.ToList() },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Reads the keys of the rows one table's download still owes this device.</summary>
    internal async Task<IReadOnlyList<string>> ReadOwedRowsAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return (
            await _localSqlExecutor
                .QueryProjectionBySqlAsync<SyncOwedRow>(
                    "SELECT key_text AS KeyText FROM quicker_sync_row_pending WHERE table_name = @tableName",
                    new { tableName },
                    cancellationToken
                )
                .ConfigureAwait(false)
        )
            .Select(row => row.KeyText)
            .ToList();
    }

    /// <summary>Removes the records of the given owed rows.</summary>
    internal async Task RemoveOwedRowsAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        foreach (var chunk in keyTexts.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_row_pending WHERE table_name = @tableName "
                        + "AND key_text IN (@keyTexts)",
                    new { tableName, keyTexts = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Removes every owed row of one table (what a refresh does, having reloaded the table).</summary>
    internal async Task RemoveTableOwedRowsAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_row_pending WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Counts the entries still waiting to be uploaded.</summary>
    /// <remarks>An entry of a row that has no key yet is not counted (see <see cref="ReadAllAsync"/>).</remarks>
    public async Task<int> CountPendingAsync(CancellationToken cancellationToken = default)
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .ExecuteScalarSqlAsync<int>(
                "SELECT COUNT(*) FROM quicker_sync_journal WHERE key_text <> @unsetKeyText",
                new { unsetKeyText = UnsetKeyText },
                cancellationToken
            )
            .ConfigureAwait(false);
    }
}

/// <summary>One batch of server changes, together with whether the stream it came from has more behind it.</summary>
/// <param name="Rows">The changed rows, in ascending version order.</param>
/// <param name="HasMore">Whether asking again - from the version the last row carries - can still return something.</param>
/// <remarks>
/// The flag is the source's own answer rather than something inferred from the row count. A full batch is the usual way
/// a source says "there is more", but only the source knows: one that trims a batch to fit a transfer limit returns
/// fewer rows and still has more behind them, and inferring from the count alone would stop the download early and
/// leave the rest for a later run without saying so.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record SyncChangeBatch<TEntity>(IReadOnlyList<TEntity> Rows, bool HasMore)
    where TEntity : EntityBaseCore, new();

/// <summary>
/// One side's unbounded binary columns, reachable by column name so the engine can copy them without knowing the entity.
/// </summary>
/// <remarks>
/// <para>
/// The generated accessors are named after their column (<c>ReadPayloadAsync</c> and so on), which an engine written
/// against <c>TEntity</c> cannot call. Both sides expose the same narrow surface instead, and the engine copies through
/// it - which is also what lets a direct database connection and an HTTP client stand in the same place, as they do for
/// every other part of a sync run.
/// </para>
/// <para>
/// A column name outside <see cref="UnboundedBinaryColumnNames"/> is rejected rather than ignored: silently doing
/// nothing would leave the destination as it was and report the copy as done.
/// </para>
/// </remarks>
/// <typeparam name="TKey">The primary key type.</typeparam>
public interface ISyncBinaryColumns<TKey>
{
    /// <summary>The names of the columns the ordinary row transfer leaves out.</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>Reads one column into the destination stream (false = no row, or the column is NULL).</summary>
    /// <param name="columnName">One of <see cref="UnboundedBinaryColumnNames"/>.</param>
    /// <param name="id">The primary key of the row.</param>
    /// <param name="destination">The stream the column's bytes are written to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    );

    /// <summary>Writes one column from a stream, or sets it to NULL (false = no row).</summary>
    /// <param name="columnName">One of <see cref="UnboundedBinaryColumnNames"/>.</param>
    /// <param name="id">The primary key of the row.</param>
    /// <param name="source">The bytes to store, or null to set the column to NULL.</param>
    /// <param name="length">The number of bytes, required when the stream cannot report its own length.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    );
}

/// <summary>One foreign key of a synchronised table, as the engine reads it off a row.</summary>
/// <param name="ParentTableName">The table the row refers to (its name as it appears in the journal).</param>
/// <param name="ReadParentKeyText">Reads the parent's primary key off the row in the journal's text form, or null when the row refers to no parent.</param>
/// <typeparam name="TEntity">The entity type of the referring row.</typeparam>
public sealed record SyncParentReference<TEntity>(
    string ParentTableName,
    Func<TEntity, string?> ReadParentKeyText
);

/// <summary>Helpers for the text form a primary key takes in the journal.</summary>
public static class SyncKeyText
{
    /// <summary>The length of a <see cref="DateTime"/> in round-trip form without a kind (<c>yyyy-MM-ddTHH:mm:ss.fffffff</c>).</summary>
    private const int DateTimeLength = 27;

    /// <summary>
    /// Removes the kind a <see cref="DateTime"/> key in round-trip form carries - a trailing <c>Z</c>, or a
    /// <c>+hh:mm</c> / <c>-hh:mm</c> offset - and leaves the clock time; any other text comes back as it is.
    /// </summary>
    /// <remarks>
    /// A <see cref="DateTime"/> key is written without its kind, because neither database keeps it: a row read back
    /// carries <see cref="DateTimeKind.Unspecified"/> whatever kind it was written with, and a key text that kept the
    /// kind would never meet the text of the row it is about. This also reads a key text an earlier version wrote with
    /// the kind still in it.
    /// </remarks>
    /// <param name="keyText">The key text.</param>
    public static string WithoutDateTimeKind(string keyText)
    {
        ArgumentNullException.ThrowIfNull(keyText);

        if (keyText.Length == DateTimeLength + 1 && keyText[DateTimeLength] == 'Z')
        {
            return keyText[..DateTimeLength];
        }

        if (
            keyText.Length == DateTimeLength + 6
            && keyText[DateTimeLength] is '+' or '-'
            && keyText[DateTimeLength + 3] == ':'
        )
        {
            return keyText[..DateTimeLength];
        }

        return keyText;
    }

    /// <summary>The fixed-point pattern a <see cref="decimal"/> key is written with: no exponent, no trailing zeros, every one of the 28 decimal places a value can have.</summary>
    private const string DecimalPattern = "0.############################";

    /// <summary>Writes a <see cref="decimal"/> key in the journal's text form.</summary>
    /// <remarks>
    /// The scale is normalised (no trailing zeros): SQL Server returns a value at the scale the column declares
    /// (<c>1.50</c> in a <c>decimal(10,2)</c>) while SQLite keeps the digits it was given, and the same row has to give
    /// the same text on both sides. The text never uses an exponent, so <see cref="ParseDecimal"/> reads it back - a
    /// general format writes a value below 1e-5 in magnitude as <c>1E-06</c>.
    /// </remarks>
    /// <param name="value">The key.</param>
    public static string FormatDecimal(decimal value) =>
        value.ToString(DecimalPattern, CultureInfo.InvariantCulture);

    /// <summary>Reads a <see cref="decimal"/> key from the journal's text form, including the exponent form an earlier version wrote.</summary>
    /// <param name="keyText">The key text.</param>
    public static decimal ParseDecimal(string keyText)
    {
        ArgumentNullException.ThrowIfNull(keyText);

        return decimal.Parse(keyText, NumberStyles.Float, CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Rewrites a <see cref="decimal"/> key that an earlier version wrote with an exponent (<c>1E-06</c>) in the form
    /// <see cref="FormatDecimal"/> writes; any other text comes back as it is.
    /// </summary>
    /// <param name="keyText">The key text.</param>
    public static string WithoutDecimalExponent(string keyText)
    {
        ArgumentNullException.ThrowIfNull(keyText);

        return
            keyText.AsSpan().IndexOfAny('E', 'e') >= 0
            && decimal.TryParse(
                keyText,
                NumberStyles.Float,
                CultureInfo.InvariantCulture,
                out var value
            )
            ? FormatDecimal(value)
            : keyText;
    }
}

/// <summary>One unique constraint of a synchronised table, as the local database is asked which row holds a value.</summary>
/// <param name="ReadValues">Reads the constraint's values off a row, in the order the statement binds them.</param>
/// <param name="Sql">Returns the key of the local row holding the values, bound as the collection parameter <c>@values</c> (<c>@values0</c>, <c>@values1</c>, ...).</param>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record SyncUniqueLookup<TEntity>(Func<TEntity, object?[]> ReadValues, string Sql);

/// <summary>One foreign key of the diagram that points at a synchronised table's primary key, as the local database is asked about it.</summary>
/// <param name="TableName">The referring table, as the local database names it.</param>
/// <param name="Sql">Returns which of the given keys (bound as the collection parameter <c>@keys</c>) a row of the referring table refers to.</param>
public sealed record SyncLocalReference(string TableName, string Sql);

/// <summary>How one unbounded binary column is read from and written to a repository that owns it.</summary>
/// <remarks>
/// The repository arrives untyped because these accessors are declared on the concrete generated contract
/// (<c>ISyncOrderRepository</c> and the like), which the fixed engine has no way to name. The generated lambda is the
/// only place that knows the type, and it casts back to it there.
/// </remarks>
/// <param name="Read">Reads the column into the destination stream (false = no row, or the column is NULL).</param>
/// <param name="Write">Writes the column from a stream, or sets it to NULL when the stream is null (false = no row).</param>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record SyncBinaryColumnAccessor<TKey>(
    Func<object, TKey, Stream, CancellationToken, Task<bool>> Read,
    Func<object, TKey, Stream?, long?, CancellationToken, Task<bool>> Write
);

/// <summary>One trigger that records the changes of a synchronised table in the local database.</summary>
/// <param name="Name">The trigger name, unquoted (it starts with <see cref="SyncLocalTracking.TriggerNamePrefix"/>).</param>
/// <param name="TableName">The table the trigger is on (<see cref="ISyncTableDescriptor.LocalTableName"/>).</param>
/// <param name="Sql">The statement that creates the trigger.</param>
public sealed record SyncLocalTrigger(string Name, string TableName, string Sql);

/// <summary>
/// The tables and triggers that record, inside the local (SQLite) database itself, which rows of the synchronised tables
/// have changed.
/// </summary>
/// <remarks>
/// <para>
/// <c>quicker_sync_state</c> holds one row: the format of these tables, an identifier of the database, whether the
/// engine is applying server rows (<c>applying</c>, which the triggers check so that what the engine writes is not
/// recorded as a local change), and the next change number. <c>quicker_sync_row</c> holds one row per changed row of a
/// synchronised table: its table, its key as the table stores it, whether it is still to be sent (<c>dirty</c>), whether
/// it was deleted, the unbounded binary columns written since it was last sent, and the number of its latest change.
/// It also has columns only the engine writes (<c>base_version</c>, <c>known</c>, <c>sw_seq</c>, <c>blob_owed</c>).
/// The anchor table <c>quicker_sync_table</c> holds one row per synchronised table: where its next download resumes
/// (<c>anchor</c>).
/// </para>
/// <para>
/// Each synchronised table gets an insert, an update and a delete trigger, and one trigger per unbounded binary column
/// the ordinary row transfer leaves out (fired only by an update of that column). The triggers write only the columns
/// named here, so the engine's columns of <c>quicker_sync_row</c> keep their values across a delete, a re-insert under
/// the same key and a change of the primary key.
/// </para>
/// <para>
/// A <c>quicker_sync_row</c> that lacks some of the engine's columns (made before they existed) gets them added with
/// <c>ALTER TABLE</c>, so its rows - the changes still to be sent - are kept.
/// </para>
/// <para>
/// SQLite triggers cannot write from a table of an attached database into the main database, so only tables of the
/// main database can be tracked; <see cref="TriggersFor"/> refuses the others.
/// </para>
/// </remarks>
public static class SyncLocalTracking
{
    /// <summary>The name of the table that holds the state of the change tracking.</summary>
    public const string StateTableName = "quicker_sync_state";

    /// <summary>The name of the table that holds one row per changed row of a synchronised table.</summary>
    public const string RowTableName = "quicker_sync_row";

    /// <summary>The name of the anchor table: one row per synchronised table, holding where its next download resumes.</summary>
    public const string AnchorTableName = "quicker_sync_table";

    /// <summary>The prefix of the names of the triggers the change tracking puts on the synchronised tables.</summary>
    public const string TriggerNamePrefix = "quicker_sync_trg_";

    /// <summary>The statement that creates the state table when it is missing.</summary>
    private const string CreateStateTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_state ("
        + "id INTEGER PRIMARY KEY CHECK (id = 1), "
        + "format INTEGER NOT NULL, "
        + "db_id TEXT NOT NULL, "
        + "applying INTEGER NOT NULL, "
        + "next_seq INTEGER NOT NULL)";

    /// <summary>The statement that puts the one row into the state table when it is not there yet.</summary>
    private const string SeedStateSql =
        "INSERT OR IGNORE INTO quicker_sync_state (id, format, db_id, applying, next_seq) "
        + "VALUES (1, 1, lower(hex(randomblob(16))), 0, 1)";

    /// <summary>The declaration of the engine's column <c>base_version</c> of the row state table.</summary>
    private const string BaseVersionColumn = "base_version BLOB NULL";

    /// <summary>The declaration of the engine's column <c>known</c> of the row state table.</summary>
    private const string KnownColumn = "known INTEGER NOT NULL DEFAULT 0";

    /// <summary>The declaration of the engine's column <c>sw_seq</c> of the row state table.</summary>
    private const string ServerWinsSequenceColumn = "sw_seq INTEGER NULL";

    /// <summary>The declaration of the engine's column <c>blob_owed</c> of the row state table.</summary>
    private const string BlobOwedColumn = "blob_owed TEXT NOT NULL DEFAULT ''";

    /// <summary>
    /// The columns of the row state table that only the engine writes, each as it is declared (the name first). Each one
    /// allows NULL or has a default, so it can be added to an existing table.
    /// </summary>
    private static readonly string[] EngineRowColumns =
    [
        BaseVersionColumn,
        KnownColumn,
        ServerWinsSequenceColumn,
        BlobOwedColumn,
    ];

    /// <summary>The statement that creates the row state table when it is missing.</summary>
    /// <remarks>The key column has no declared type, so it keeps each key exactly as the synchronised table stores it.</remarks>
    private const string CreateRowTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_row ("
        + "table_name TEXT NOT NULL, "
        + "\"key\", "
        + "dirty INTEGER NOT NULL, "
        + "deleted INTEGER NOT NULL, "
        + "blob_columns TEXT NOT NULL DEFAULT '', "
        + "change_seq INTEGER NOT NULL, "
        + BaseVersionColumn
        + ", "
        + KnownColumn
        + ", "
        + ServerWinsSequenceColumn
        + ", "
        + BlobOwedColumn
        + ", "
        + "PRIMARY KEY (table_name, \"key\"))";

    /// <summary>The statement that creates the anchor table (where each synchronised table's next download resumes) when it is missing.</summary>
    private const string CreateAnchorTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_table ("
        + "table_name TEXT NOT NULL PRIMARY KEY, "
        + "anchor BLOB NULL)";

    /// <summary>The columns an upsert into the row state table writes.</summary>
    private const string RowColumns =
        "quicker_sync_row (table_name, \"key\", dirty, deleted, blob_columns, change_seq)";

    /// <summary>The conflict target of an upsert into the row state table.</summary>
    private const string RowConflict = "ON CONFLICT (table_name, \"key\") DO UPDATE SET";

    /// <summary>The next change number, as an expression.</summary>
    private const string NextSequence = "(SELECT next_seq FROM quicker_sync_state)";

    /// <summary>The statement that moves the next change number on.</summary>
    private const string AdvanceSequence = "UPDATE quicker_sync_state SET next_seq = next_seq + 1";

    /// <summary>The characters a comparison of two trigger statements treats as white space.</summary>
    private static readonly char[] StatementWhiteSpace = [' ', '\t', '\r', '\n'];

    /// <summary>The triggers that record the changes of one synchronised table.</summary>
    /// <param name="table">The table.</param>
    /// <returns>The insert, update and delete triggers, then one trigger per unbounded binary column, in column order.</returns>
    /// <exception cref="NotSupportedException">The table lives in an attached database rather than in the main database.</exception>
    public static IReadOnlyList<SyncLocalTrigger> TriggersFor(ISyncTableDescriptor table)
    {
        ArgumentNullException.ThrowIfNull(table);

        if (
            table.LocalDatabaseName is { } database
            && !string.Equals(database, "main", StringComparison.OrdinalIgnoreCase)
        )
        {
            throw new NotSupportedException(
                $"The changes of the table '{table.TableName}' cannot be tracked: the table lives in the attached "
                    + $"database '{database}'; change tracking supports tables of the main database only."
            );
        }

        var accessorNames = table.UnboundedBinaryColumnNames;
        var columnNames = table.LocalUnboundedBinaryColumnNames;

        if (accessorNames.Count != columnNames.Count)
        {
            throw new ArgumentException(
                $"The table '{table.TableName}' names {accessorNames.Count.ToString(CultureInfo.InvariantCulture)} "
                    + $"unbounded binary columns but {columnNames.Count.ToString(CultureInfo.InvariantCulture)} "
                    + "database columns for them.",
                nameof(table)
            );
        }

        var tableText = Text(table.TableName);
        var newKey = "NEW." + Identifier(table.LocalKeyColumnName);
        var oldKey = "OLD." + Identifier(table.LocalKeyColumnName);
        var keyChanged = $"{oldKey} IS NOT {newKey}";

        var triggers = new List<SyncLocalTrigger>(3 + accessorNames.Count)
        {
            // An insert records the row with every excluded binary column, since the insert wrote them all.
            Create(
                table,
                "ai",
                "AFTER INSERT",
                $"INSERT INTO {RowColumns} VALUES ({tableText}, {newKey}, 1, 0, "
                    + $"{Text(string.Join(",", accessorNames))}, {NextSequence}) "
                    + $"{RowConflict} dirty = 1, deleted = 0, change_seq = excluded.change_seq, "
                    + "blob_columns = excluded.blob_columns; "
                    + $"{AdvanceSequence};"
            ),
            // An update records the row under its new key and, when the key changed, the old key as deleted.
            Create(
                table,
                "au",
                "AFTER UPDATE",
                $"INSERT INTO {RowColumns} VALUES ({tableText}, {newKey}, 1, 0, '', {NextSequence}) "
                    + $"{RowConflict} dirty = 1, deleted = 0, change_seq = excluded.change_seq; "
                    + $"{AdvanceSequence}; "
                    + $"INSERT INTO {RowColumns} SELECT {tableText}, {oldKey}, 1, 1, '', {NextSequence} "
                    + $"WHERE {keyChanged} "
                    + $"{RowConflict} dirty = 1, deleted = 1, change_seq = excluded.change_seq; "
                    + $"{AdvanceSequence} WHERE {keyChanged};"
            ),
            Create(
                table,
                "ad",
                "AFTER DELETE",
                $"INSERT INTO {RowColumns} VALUES ({tableText}, {oldKey}, 1, 1, '', {NextSequence}) "
                    + $"{RowConflict} dirty = 1, deleted = 1, change_seq = excluded.change_seq; "
                    + $"{AdvanceSequence};"
            ),
        };

        for (var index = 0; index < accessorNames.Count; index++)
        {
            var accessorName = accessorNames[index];

            // An update of an excluded binary column adds the column (by its accessor name) to the row's list, once.
            triggers.Add(
                Create(
                    table,
                    "b" + (index + 1).ToString(CultureInfo.InvariantCulture),
                    $"AFTER UPDATE OF {Identifier(columnNames[index])}",
                    $"INSERT INTO {RowColumns} VALUES ({tableText}, {newKey}, 1, 0, {Text(accessorName)}, {NextSequence}) "
                        + $"{RowConflict} dirty = 1, change_seq = excluded.change_seq, blob_columns = CASE "
                        + $"WHEN instr(',' || blob_columns || ',', {Text("," + accessorName + ",")}) > 0 THEN blob_columns "
                        + $"WHEN blob_columns = '' THEN {Text(accessorName)} "
                        + $"ELSE blob_columns || ',' || {Text(accessorName)} END; "
                        + $"{AdvanceSequence};"
                )
            );
        }

        return triggers;
    }

    /// <summary>
    /// Creates the state tables when they are missing, and brings the triggers of each table to the expected form.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tables">The synchronised tables.</param>
    /// <returns>The <see cref="ISyncTableDescriptor.TableName"/> of each table whose triggers were created or recreated.</returns>
    /// <remarks>
    /// <para>
    /// Everything runs in one immediate transaction. The engine's columns missing from an existing row state table are
    /// added to it (its rows are kept). A table missing from the database is skipped. A table whose triggers
    /// already have the expected names and statements (compared with runs of white space folded to one space and a
    /// trailing semicolon dropped) is left as it is; for any other, every trigger whose name starts with
    /// <see cref="TriggerNamePrefix"/> is dropped and the expected ones are created. Triggers on tables outside
    /// <paramref name="tables"/> are not touched.
    /// </para>
    /// <para>
    /// Before replacing the triggers of a table, the key column and the excluded binary columns are looked up in the
    /// table. SQLite does not check the columns a trigger names when it creates the trigger, so a trigger naming a column
    /// the table does not have would be created without complaint and then make every write to the table fail; a
    /// missing column therefore rolls everything back and throws instead.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">The connection is not open, or a table lacks a column its triggers name.</exception>
    /// <exception cref="NotSupportedException">A table lives in an attached database (nothing has been changed).</exception>
    public static IReadOnlyList<string> Ensure(
        DbConnection connection,
        IReadOnlyList<ISyncTableDescriptor> tables
    )
    {
        ArgumentNullException.ThrowIfNull(connection);
        ArgumentNullException.ThrowIfNull(tables);

        if (connection.State != System.Data.ConnectionState.Open)
        {
            throw new InvalidOperationException(
                "The connection must be open before the change tracking is set up."
            );
        }

        return EnsureExpected(connection, Expect(tables), beforeCommit: null);
    }

    /// <summary>
    /// Runs writes that the change tracking does not record: what <paramref name="write"/> writes to the synchronised
    /// tables is not sent by a later synchronisation.
    /// </summary>
    /// <param name="connection">An open connection to the local database, outside any transaction.</param>
    /// <param name="write">
    /// The writes. It receives <paramref name="connection"/> and writes through it: with SQL, or with an
    /// <see cref="ILocalRowStore"/>.
    /// </param>
    /// <param name="cancellationToken">The cancellation token (passed on to <paramref name="write"/>).</param>
    /// <remarks>
    /// <para>
    /// Everything runs in one transaction on <paramref name="connection"/> that holds the write lock of the database from
    /// its first statement: the applying flag of <c>quicker_sync_state</c> is set, <paramref name="write"/> runs, the flag
    /// is cleared, and the transaction commits. The triggers record nothing while the flag is set, and what was recorded
    /// before (the rows still to be sent, the engine's columns, the change numbers) stays as it is. No other connection
    /// ever sees the flag set: until the commit it reads the database as it was, and its writes wait for the commit (as long
    /// as its busy timeout allows) and are recorded as usual.
    /// </para>
    /// <para>
    /// When <paramref name="write"/> throws or is cancelled, or the commit fails, the transaction is rolled back before the
    /// exception leaves: nothing that was written stays, and the connection is outside a transaction again. A pooled
    /// connection may therefore be passed. A connection from <see cref="ILocalRowStore.CreateDedicatedConnection"/> (not
    /// pooled) is the safer choice: should the rollback itself fail, closing it releases the write lock, whereas a pooled
    /// connection keeps the transaction and the lock until it is opened again through a
    /// <see cref="SyncLocalTrackingGuard"/> (which rolls the transaction back) or the pool discards it.
    /// </para>
    /// <para>
    /// Inside <paramref name="write"/>:
    /// </para>
    /// <list type="bullet">
    /// <item>Write only through the given connection. A generated repository or an <c>ISqlExecutor</c> opens a connection
    /// of its own, and a write through it waits for the lock this transaction holds until its busy timeout runs out.</item>
    /// <item>Do not begin, commit or roll back a transaction (a savepoint, started and ended with SQL, is fine), and do not
    /// close the connection.</item>
    /// <item>Do not call this method again, and do not run a synchronisation.</item>
    /// </list>
    /// <para>
    /// Foreign keys are checked as <paramref name="connection"/> is set to check them.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">
    /// The connection is not open or is already inside a transaction (nothing has been changed); the change tracking is not
    /// set up in the database; or <paramref name="write"/> closed the connection (nothing was committed, but a pooled
    /// connection keeps the transaction and the write lock until it is opened again through a
    /// <see cref="SyncLocalTrackingGuard"/> or the pool discards it).
    /// </exception>
    public static async Task WriteUntrackedAsync(
        DbConnection connection,
        Func<DbConnection, CancellationToken, Task> write,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(connection);
        ArgumentNullException.ThrowIfNull(write);

        if (connection.State != System.Data.ConnectionState.Open)
        {
            throw new InvalidOperationException(
                "The connection must be open before an untracked write runs."
            );
        }

        try
        {
            // A deferred BEGIN takes no lock and waits for nothing: it fails only when the connection is already inside a
            // transaction. The first statement after it takes the write lock
            await TrackedSyncState.ExecuteAsync(connection, "BEGIN", cancellationToken).ConfigureAwait(false);
        }
        catch (DbException exception)
        {
            throw new InvalidOperationException(
                "An untracked write could not start its transaction: the connection is already inside a transaction. "
                    + "Pass a connection that is outside any transaction; an untracked write cannot run inside another "
                    + "one, and the writes it runs must not begin a transaction of their own.",
                exception
            );
        }

        try
        {
            // Takes the write lock (waiting for another writer as long as the connection's busy timeout allows). A flag
            // found set here was left by a write that committed without clearing it: no writer is in the middle of
            // anything while this transaction holds the lock, so it is simply set and cleared again
            if (await TrackedSyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false) != 1)
            {
                throw new InvalidOperationException(
                    "The change tracking is not set up in this database (" + StateTableName + " has no row). "
                        + "Call SyncLocalTracking.Ensure before an untracked write."
                );
            }

            await write(connection, cancellationToken).ConfigureAwait(false);

            if (connection.State != System.Data.ConnectionState.Open)
            {
                throw new InvalidOperationException(
                    "The writes of an untracked write closed the connection they were given. Nothing was committed, but "
                        + "the transaction could not be rolled back: a pooled connection keeps it, together with the "
                        + "write lock of the database, until it is opened again through a SyncLocalTrackingGuard or the "
                        + "pool discards it. Do not close the connection inside the writes."
                );
            }

            // What is left only tidies up after writes that have run: it is not cancelled half way
            await TrackedSyncState.SetApplyingAsync(connection, false, CancellationToken.None).ConfigureAwait(false);
            await TrackedSyncState.ExecuteAsync(connection, "COMMIT", CancellationToken.None).ConfigureAwait(false);
        }
        catch
        {
            if (connection.State == System.Data.ConnectionState.Open)
            {
                try
                {
                    await TrackedSyncState.ExecuteAsync(connection, "ROLLBACK", CancellationToken.None).ConfigureAwait(false);
                }
                catch (DbException)
                {
                    // The rollback failing must not hide what went wrong first
                }
            }

            throw;
        }
    }

    /// <summary>Builds the expected triggers of every table, refusing a table that cannot be tracked before anything changes.</summary>
    /// <param name="tables">The synchronised tables.</param>
    /// <returns>Each table with its expected triggers, in the order of <paramref name="tables"/>.</returns>
    /// <exception cref="NotSupportedException">A table lives in an attached database.</exception>
    internal static IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> Expect(
        IReadOnlyList<ISyncTableDescriptor> tables
    )
    {
        ArgumentNullException.ThrowIfNull(tables);

        var expected = new List<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)>(
            tables.Count
        );

        foreach (var table in tables)
        {
            ArgumentNullException.ThrowIfNull(table, nameof(tables));
            expected.Add((table, TriggersFor(table)));
        }

        return expected;
    }

    /// <summary>
    /// The SHA-256 (hexadecimal) of the expected definition: the statements that create the state tables, then the name
    /// and statement of every trigger of every table, in order.
    /// </summary>
    /// <param name="expected">The tables with their expected triggers (see <see cref="Expect"/>).</param>
    internal static string DefinitionHash(
        IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> expected
    )
    {
        var definition = new System.Text.StringBuilder();
        definition.Append(CreateStateTableSql).Append('\n');
        definition.Append(CreateRowTableSql).Append('\n');
        definition.Append(CreateAnchorTableSql).Append('\n');
        definition.Append(SeedStateSql).Append('\n');

        foreach (var (_, triggers) in expected)
        {
            foreach (var trigger in triggers)
            {
                definition.Append(trigger.Name).Append('\n').Append(trigger.Sql).Append('\n');
            }
        }

        return Convert.ToHexString(
            System.Security.Cryptography.SHA256.HashData(
                System.Text.Encoding.UTF8.GetBytes(definition.ToString())
            )
        );
    }

    /// <summary>
    /// Whether the database already has everything <see cref="Ensure"/> would set up: the three state tables, every
    /// engine column of the row state table, the one row of the state table, and the expected triggers on each table the
    /// database has. It only reads.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="expected">The tables with their expected triggers (see <see cref="Expect"/>).</param>
    internal static bool HasExpectedState(
        DbConnection connection,
        IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> expected
    )
    {
        if (
            !TableExists(connection, StateTableName)
            || !TableExists(connection, RowTableName)
            || !TableExists(connection, AnchorTableName)
        )
        {
            return false;
        }

        if (MissingRowColumns(connection).Count > 0)
        {
            return false;
        }

        using (var command = connection.CreateCommand())
        {
            command.CommandText = "SELECT count(*) FROM quicker_sync_state WHERE id = 1";

            if (Convert.ToInt64(command.ExecuteScalar(), CultureInfo.InvariantCulture) == 0)
            {
                return false;
            }
        }

        foreach (var (table, triggers) in expected)
        {
            if (CurrentTriggersIfDifferent(connection, table, triggers) is not null)
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>
    /// The body of <see cref="Ensure"/>: in one immediate transaction, creates the state tables when they are missing, adds
    /// the engine's columns missing from the row state table, and brings the triggers of each table to the expected form.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="expected">The tables with their expected triggers (see <see cref="Expect"/>).</param>
    /// <param name="beforeCommit">Runs inside the transaction after everything is in place and before it commits (null = nothing).</param>
    /// <returns>The <see cref="ISyncTableDescriptor.TableName"/> of each table whose triggers were created or recreated.</returns>
    internal static IReadOnlyList<string> EnsureExpected(
        DbConnection connection,
        IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> expected,
        Action<DbConnection>? beforeCommit
    )
    {
        Execute(connection, "BEGIN IMMEDIATE");

        try
        {
            Execute(connection, CreateStateTableSql);
            Execute(connection, CreateRowTableSql);

            // A row state table made before the engine's columns existed gets them added in place: rebuilding it would
            // lose the changes still to be sent
            foreach (var column in MissingRowColumns(connection))
            {
                Execute(connection, "ALTER TABLE quicker_sync_row ADD COLUMN " + column);
            }

            Execute(connection, CreateAnchorTableSql);
            Execute(connection, SeedStateSql);

            var changed = new List<string>();

            foreach (var (table, triggers) in expected)
            {
                var current = CurrentTriggersIfDifferent(connection, table, triggers);

                if (current is null)
                {
                    continue;
                }

                var missing = MissingColumns(connection, table);

                if (missing.Count > 0)
                {
                    throw new InvalidOperationException(
                        $"The change tracking of the table '{table.TableName}' cannot be set up: the local table "
                            + $"'{table.LocalTableName}' has no column "
                            + string.Join(", ", missing.Select(column => $"'{column}'"))
                            + ". Make the column names of the diagram and of the database agree, then generate "
                            + "the code again."
                    );
                }

                foreach (var name in current.Keys)
                {
                    Execute(connection, "DROP TRIGGER " + Identifier(name));
                }

                foreach (var trigger in triggers)
                {
                    Execute(connection, trigger.Sql);
                }

                changed.Add(table.TableName);
            }

            beforeCommit?.Invoke(connection);
            Execute(connection, "COMMIT");
            return changed;
        }
        catch
        {
            try
            {
                Execute(connection, "ROLLBACK");
            }
            catch (DbException)
            {
                // The rollback failing must not hide what went wrong first
            }

            throw;
        }
    }

    /// <summary>Builds one trigger of a table.</summary>
    /// <param name="table">The table.</param>
    /// <param name="suffix">What follows the table name in the trigger name.</param>
    /// <param name="timing">When the trigger fires (for example <c>AFTER INSERT</c>).</param>
    /// <param name="body">The statements of the trigger, each ending with a semicolon.</param>
    private static SyncLocalTrigger Create(
        ISyncTableDescriptor table,
        string suffix,
        string timing,
        string body
    )
    {
        var escapedTable = EscapeIdentifier(table.LocalTableName);

        return new SyncLocalTrigger(
            TriggerNamePrefix + table.LocalTableName + "_" + suffix,
            table.LocalTableName,
            $"CREATE TRIGGER \"quicker_sync_trg_{escapedTable}_{suffix}\" {timing} ON \"{escapedTable}\" "
                + "WHEN (SELECT applying FROM quicker_sync_state) = 0 "
                + $"BEGIN {body} END"
        );
    }

    /// <summary>The triggers of a table, when the table is in the database and its triggers are not the expected ones.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="table">The table.</param>
    /// <param name="expected">The table's expected triggers.</param>
    /// <returns>
    /// The table's triggers whose names start with the prefix, by name; null when the database has no such table or its
    /// triggers are already the expected ones.
    /// </returns>
    private static Dictionary<string, string>? CurrentTriggersIfDifferent(
        DbConnection connection,
        ISyncTableDescriptor table,
        IReadOnlyList<SyncLocalTrigger> expected
    )
    {
        if (!TableExists(connection, table.LocalTableName))
        {
            return null;
        }

        var current = ReadTriggers(connection, table.LocalTableName);

        return HasExpectedTriggers(current, expected) ? null : current;
    }

    /// <summary>Whether the triggers a table has are exactly the expected ones.</summary>
    /// <param name="current">The table's triggers whose names start with the prefix, by name.</param>
    /// <param name="expected">The expected triggers.</param>
    private static bool HasExpectedTriggers(
        IReadOnlyDictionary<string, string> current,
        IReadOnlyList<SyncLocalTrigger> expected
    )
    {
        if (current.Count != expected.Count)
        {
            return false;
        }

        foreach (var trigger in expected)
        {
            if (
                !current.TryGetValue(trigger.Name, out var sql)
                || !string.Equals(NormalizeStatement(sql), NormalizeStatement(trigger.Sql), StringComparison.Ordinal)
            )
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>A statement with every run of white space folded to one space, and a trailing semicolon and the white space around it dropped.</summary>
    /// <param name="sql">The statement.</param>
    private static string NormalizeStatement(string sql) =>
        string.Join(' ', sql.Split(StatementWhiteSpace, StringSplitOptions.RemoveEmptyEntries))
            .TrimEnd(';')
            .Trim();

    /// <summary>Whether the main database has the table (the name compared ignoring case).</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="tableName">The table name, unquoted.</param>
    private static bool TableExists(DbConnection connection, string tableName)
    {
        using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = @table COLLATE NOCASE";
        AddParameter(command, "@table", tableName);

        return Convert.ToInt64(command.ExecuteScalar(), CultureInfo.InvariantCulture) > 0;
    }

    /// <summary>The triggers on a table whose names start with <see cref="TriggerNamePrefix"/>, with their statements.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="tableName">The table name, unquoted (compared ignoring case).</param>
    /// <returns>The statements by trigger name (names compared ignoring case).</returns>
    private static Dictionary<string, string> ReadTriggers(DbConnection connection, string tableName)
    {
        var triggers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT name, sql FROM sqlite_master WHERE type = 'trigger' AND tbl_name = @table COLLATE NOCASE";
        AddParameter(command, "@table", tableName);

        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            var name = reader.GetString(0);

            // The prefix is compared here rather than with LIKE, where its underscores would match any character
            if (!name.StartsWith(TriggerNamePrefix, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            triggers[name] = reader.IsDBNull(1) ? string.Empty : reader.GetString(1);
        }

        return triggers;
    }

    /// <summary>The columns the triggers of a table name that the table does not have (the key column first).</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="table">The table.</param>
    private static List<string> MissingColumns(DbConnection connection, ISyncTableDescriptor table)
    {
        var present = ColumnNames(connection, table.LocalTableName);

        return new[] { table.LocalKeyColumnName }
            .Concat(table.LocalUnboundedBinaryColumnNames)
            .Where(column => !present.Contains(column))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>The engine's columns the row state table does not have, each as it is declared (in declaration order).</summary>
    /// <param name="connection">The connection (the row state table exists).</param>
    private static List<string> MissingRowColumns(DbConnection connection)
    {
        var present = ColumnNames(connection, RowTableName);

        return EngineRowColumns
            .Where(declaration => !present.Contains(declaration[..declaration.IndexOf(' ')]))
            .ToList();
    }

    /// <summary>The column names of a table of the main database (compared ignoring case).</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="tableName">The table name, unquoted.</param>
    private static HashSet<string> ColumnNames(DbConnection connection, string tableName)
    {
        var present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        using var command = connection.CreateCommand();
        command.CommandText = "SELECT name FROM pragma_table_info(@table, 'main')";
        AddParameter(command, "@table", tableName);

        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            present.Add(reader.GetString(0));
        }

        return present;
    }

    /// <summary>Runs one statement that returns no rows.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="sql">One statement (never several, so none of them can be left unrun).</param>
    private static void Execute(DbConnection connection, string sql)
    {
        using var command = connection.CreateCommand();
        command.CommandText = sql;
        command.ExecuteNonQuery();
    }

    /// <summary>Adds a text parameter to a command.</summary>
    private static void AddParameter(DbCommand command, string name, string value)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.Value = value;
        command.Parameters.Add(parameter);
    }

    /// <summary>A name quoted as an SQLite identifier.</summary>
    private static string Identifier(string name) => "\"" + EscapeIdentifier(name) + "\"";

    /// <summary>A name with its double quotes doubled, ready to go between double quotes.</summary>
    private static string EscapeIdentifier(string name) =>
        name.Replace("\"", "\"\"", StringComparison.Ordinal);

    /// <summary>A value written as an SQL string literal.</summary>
    private static string Text(string value) =>
        "'" + value.Replace("'", "''", StringComparison.Ordinal) + "'";
}

/// <summary>
/// Checks, every time a connection to the local database opens, that the change tracking of
/// <see cref="SyncLocalTracking"/> is in place, and puts it back when it is not.
/// </summary>
/// <remarks>
/// <para>
/// The check costs one statement in the usual case: it reads the database's schema version together with the identifier
/// in <c>quicker_sync_state</c>, and stops when the pair is the one remembered after the last full check of the same
/// database file. Any change to the schema (a dropped trigger, an unrelated table) moves the schema version on, and a
/// different file at the same path has a different identifier, so either leads to the full check.
/// </para>
/// <para>
/// The full check runs in a read transaction and writes nothing, so a read-only connection passes it when everything is
/// in place. Only when something is missing or different does it take the write lock and do what
/// <see cref="SyncLocalTracking.Ensure"/> does.
/// </para>
/// <para>
/// The remembered pairs are kept for the whole process, by database file and by the expected definition (the state tables
/// and every trigger of the given tables), so guards made per scope share them, and two registrations with different sets
/// of tables over the same file do not take each other's result. An in-memory database (an empty
/// <see cref="DbConnection.DataSource"/> once open) is never remembered and gets the full check every time.
/// </para>
/// <para>
/// When the full check or the repair fails, the connection is closed before the exception leaves, so a connection whose
/// tracking could not be confirmed is never handed on open, and nothing is remembered: the next connection that opens
/// checks again.
/// </para>
/// <para>
/// The check also clears an applying flag that was left set. The engine and
/// <see cref="SyncLocalTracking.WriteUntrackedAsync"/> set and clear the flag inside one transaction, and no other
/// connection sees the flag of a transaction still open. A connection that has just opened therefore sees it set in two
/// cases only. A write committed without clearing it (the writes of an untracked write committed the transaction
/// themselves, or something outside set it): while it stayed set nothing was recorded, and those writes are not
/// recovered; clearing it makes the following ones recorded again. Or the connection is a pooled one that was closed in
/// the middle of such a transaction (the writes of an untracked write closed it, or its rollback failed): the check rolls
/// that transaction back, which also releases the write lock it held. The flag is read together with the pair, so the
/// usual case still costs one statement; clearing a committed flag needs the write lock, and fails like the repair does.
/// </para>
/// </remarks>
public sealed class SyncLocalTrackingGuard
{
    /// <summary>The pair read from the database after its last successful full check, by database file and definition.</summary>
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<
        (string DataSource, string DefinitionHash),
        (long SchemaVersion, string DatabaseId)
    > Confirmed = new();

    /// <summary>The statement that reads the schema version, the database identifier and the applying flag together.</summary>
    private const string ReadPairSql =
        "SELECT (SELECT schema_version FROM pragma_schema_version), (SELECT db_id FROM quicker_sync_state), "
        + "(SELECT applying FROM quicker_sync_state)";

    /// <summary>The statement that clears an applying flag left set in the database.</summary>
    private const string ClearLeftoverFlagSql = "UPDATE quicker_sync_state SET applying = 0 WHERE applying <> 0";

    /// <summary>The tables with their expected triggers.</summary>
    private readonly IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> _expected;

    /// <summary>The SHA-256 of the expected definition (see <see cref="SyncLocalTracking.DefinitionHash"/>).</summary>
    private readonly string _definitionHash;

    /// <summary>How many times this guard has run the full check.</summary>
    private int _fullCheckCount;

    /// <summary>How many times this guard has run the repair.</summary>
    private int _repairCount;

    /// <summary>Creates the guard for the given synchronised tables.</summary>
    /// <param name="tables">The synchronised tables.</param>
    /// <exception cref="NotSupportedException">A table lives in an attached database.</exception>
    public SyncLocalTrackingGuard(IReadOnlyList<ISyncTableDescriptor> tables)
    {
        _expected = SyncLocalTracking.Expect(tables);
        _definitionHash = SyncLocalTracking.DefinitionHash(_expected);
    }

    /// <summary>How many times this guard has run the full check (for diagnostics).</summary>
    internal int FullCheckCount => Volatile.Read(ref _fullCheckCount);

    /// <summary>How many times this guard has run the repair (for diagnostics).</summary>
    internal int RepairCount => Volatile.Read(ref _repairCount);

    /// <summary>
    /// The handler to add to a connection's <see cref="DbConnection.StateChange"/>: it runs <see cref="Check"/> when the
    /// connection has just opened.
    /// </summary>
    /// <param name="sender">The connection.</param>
    /// <param name="e">The state change.</param>
    public void OnStateChange(object? sender, System.Data.StateChangeEventArgs e)
    {
        ArgumentNullException.ThrowIfNull(e);

        if (
            e.CurrentState != System.Data.ConnectionState.Open
            || e.OriginalState == System.Data.ConnectionState.Open
        )
        {
            return;
        }

        Check((DbConnection)sender!);
    }

    /// <summary>Checks the change tracking on a connection that has just opened, and puts it back when it is not in place.</summary>
    /// <param name="connection">An open connection to the local database, outside any transaction.</param>
    /// <exception cref="InvalidOperationException">
    /// The change tracking could not be confirmed or put back (the connection has been closed): a table lacks a column its
    /// triggers name, or the database refused the check, the repair or the clearing of an applying flag left set (the
    /// original error is the inner exception).
    /// </exception>
    public void Check(DbConnection connection)
    {
        ArgumentNullException.ThrowIfNull(connection);

        var source = connection.DataSource;
        (string DataSource, string DefinitionHash)? key = string.IsNullOrEmpty(source)
            ? null
            : (source, _definitionHash);

        var inPlace = false;
        var flagLeftSet = false;

        if (key is { } known && Confirmed.TryGetValue(known, out var remembered))
        {
            try
            {
                var read = ReadPair(connection);
                inPlace = (read.SchemaVersion, read.DatabaseId) == remembered;
                flagLeftSet = read.Applying;
            }
            catch (DbException)
            {
                // The state table is gone (or cannot be read): the full check finds out what is missing
            }
        }

        var doing = "checked";

        try
        {
            if (!inPlace)
            {
                Interlocked.Increment(ref _fullCheckCount);

                if (ConfirmWithoutWriting(connection) is { } confirmed)
                {
                    Remember(key, (confirmed.SchemaVersion, confirmed.DatabaseId));
                    flagLeftSet = confirmed.Applying;
                }
                else
                {
                    doing = "put in place";
                    Interlocked.Increment(ref _repairCount);

                    (long SchemaVersion, string? DatabaseId, bool Applying) repaired = default;
                    SyncLocalTracking.EnsureExpected(
                        connection,
                        _expected,
                        beforeCommit: inside => repaired = ReadPair(inside)
                    );
                    Remember(key, (repaired.SchemaVersion, repaired.DatabaseId));
                    flagLeftSet = repaired.Applying;
                }
            }

            if (flagLeftSet)
            {
                // A connection that has just opened sees the flag set in two cases. Either a write committed without
                // clearing it, and nothing clears it any more. Or this is a pooled connection that was closed in the middle
                // of a transaction (the writes of an untracked write closed it, or its rollback failed): the flag belongs
                // to that transaction, which still holds the write lock. Rolling back ends such a transaction; when there
                // is none, the rollback fails and changes nothing
                doing = "cleared of the applying flag an earlier write left set";

                try
                {
                    Execute(connection, "ROLLBACK");
                }
                catch (DbException)
                {
                    // No transaction was left open on the connection
                }

                if (ReadPair(connection).Applying)
                {
                    Execute(connection, ClearLeftoverFlagSql);
                }
            }
        }
        catch (DbException exception)
        {
            CloseQuietly(connection);

            throw new InvalidOperationException(
                $"The change tracking of the local database '{source}' could not be "
                    + doing
                    + $": {exception.Message} The connection has been closed. The next connection that opens checks "
                    + "again; if another writer held the database, open the connection again once it has finished. If "
                    + "the database was opened read-only, open it once with a connection that can write, so that the "
                    + "change tracking can be put in place.",
                exception
            );
        }
        catch
        {
            CloseQuietly(connection);
            throw;
        }
    }

    /// <summary>
    /// The full check that only reads: in one read transaction, the schema version first, then whether everything is in
    /// place, then the database identifier and the applying flag.
    /// </summary>
    /// <param name="connection">The connection.</param>
    /// <returns>The pair to remember with the applying flag, or null when something is missing or different.</returns>
    private (long SchemaVersion, string? DatabaseId, bool Applying)? ConfirmWithoutWriting(DbConnection connection)
    {
        Execute(connection, "BEGIN");

        try
        {
            // The first read fixes the snapshot, so the version read here belongs to the state checked next
            long schemaVersion;

            using (var command = connection.CreateCommand())
            {
                command.CommandText = "PRAGMA schema_version";
                schemaVersion = Convert.ToInt64(command.ExecuteScalar(), CultureInfo.InvariantCulture);
            }

            (long, string?, bool)? confirmed = null;

            if (SyncLocalTracking.HasExpectedState(connection, _expected))
            {
                var pair = ReadPair(connection);
                confirmed = (schemaVersion, pair.DatabaseId, pair.Applying);
            }

            Execute(connection, "COMMIT");
            return confirmed;
        }
        catch
        {
            try
            {
                Execute(connection, "ROLLBACK");
            }
            catch (DbException)
            {
                // The rollback failing must not hide what went wrong first
            }

            throw;
        }
    }

    /// <summary>Remembers the pair confirmed for a database file (nothing for an in-memory database or a missing identifier).</summary>
    private static void Remember(
        (string DataSource, string DefinitionHash)? key,
        (long SchemaVersion, string? DatabaseId) pair
    )
    {
        if (key is { } known && pair.DatabaseId is not null)
        {
            Confirmed[known] = (pair.SchemaVersion, pair.DatabaseId);
        }
    }

    /// <summary>
    /// Reads the schema version, the database identifier (null when the state table has no row) and whether the applying
    /// flag is set.
    /// </summary>
    private static (long SchemaVersion, string? DatabaseId, bool Applying) ReadPair(DbConnection connection)
    {
        using var command = connection.CreateCommand();
        command.CommandText = ReadPairSql;

        using var reader = command.ExecuteReader();

        if (!reader.Read())
        {
            return (-1, null, false);
        }

        return (
            Convert.ToInt64(reader.GetValue(0), CultureInfo.InvariantCulture),
            reader.IsDBNull(1) ? null : reader.GetString(1),
            !reader.IsDBNull(2) && Convert.ToInt64(reader.GetValue(2), CultureInfo.InvariantCulture) != 0
        );
    }

    /// <summary>Closes the connection, keeping a failure to close from hiding what went wrong first.</summary>
    private static void CloseQuietly(DbConnection connection)
    {
        try
        {
            connection.Close();
        }
        catch (DbException)
        {
            // The error that led here is the one to report
        }
    }

    /// <summary>Runs one statement that returns no rows.</summary>
    private static void Execute(DbConnection connection, string sql)
    {
        using var command = connection.CreateCommand();
        command.CommandText = sql;
        command.ExecuteNonQuery();
    }
}

/// <summary>Everything about one synchronised table that the journal recorder needs, with the entity's types erased.</summary>
/// <remarks>
/// The recorder walks a graph of <see cref="EntityBaseCore"/> without knowing any entity type, so it looks a node's table up
/// by its CLR type and asks the descriptor it finds for the two things a journal entry carries.
/// </remarks>
public interface ISyncTableDescriptor
{
    /// <summary>The table name, as it appears in the journal.</summary>
    string TableName { get; }

    /// <summary>The CLR entity type the table synchronises.</summary>
    Type EntityType { get; }

    /// <summary>Renders the entity's primary key into the text form the journal stores.</summary>
    /// <param name="entity">An entity of <see cref="EntityType"/>.</param>
    string FormatEntityKey(EntityBaseCore entity);

    /// <summary>Reads the mirrored server version off the entity (null for a table without a version column).</summary>
    /// <param name="entity">An entity of <see cref="EntityType"/>.</param>
    byte[]? ReadEntityRowVersion(EntityBaseCore entity);

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (what an inserted row is recorded as storing).</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames => [];

    /// <summary>
    /// The name of the local (SQLite) table without its schema part, unquoted: what <c>sqlite_master.tbl_name</c> holds
    /// for it. The table name itself when it has no schema part.
    /// </summary>
    string LocalTableName { get; }

    /// <summary>The schema part of the local table's name, unquoted (null when the name has none).</summary>
    string? LocalDatabaseName { get; }

    /// <summary>The database column name of the primary key, unquoted.</summary>
    string LocalKeyColumnName { get; }

    /// <summary>
    /// The database column names of <see cref="UnboundedBinaryColumnNames"/>, unquoted, in the same order and of the same
    /// count (those are the accessor names; these are the columns of the local table).
    /// </summary>
    IReadOnlyList<string> LocalUnboundedBinaryColumnNames => [];
}

/// <summary>
/// Everything about one synchronised table that depends on the diagram: its name, the SQL that carries its identity, and
/// how the key and the mirrored version are read off an entity and written back.
/// </summary>
/// <remarks>
/// <para>
/// This is the whole of what the generator emits per table. The behaviour - batching, anchor derivation, delete
/// propagation, the replay of a journal entry - lives once in the fixed classes that take a descriptor
/// (<see cref="SyncTable{TEntity, TKey}"/>, <see cref="VersionlessSyncTable{TEntity, TKey}"/>,
/// <see cref="DirectSyncSource{TEntity, TKey}"/> and its versionless counterpart), so a table contributes data rather
/// than a class of its own.
/// </para>
/// <para>
/// The SQL is text baked in at generation time rather than assembled at run time: the two dialects a sync setup spans
/// (SQL Server for the server, SQLite for the local database) quote differently, and the generator is where both are
/// known.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncTableDescriptor<TEntity, TKey>
    : ISyncTableDescriptor,
        ISyncLocalRowVersionReader,
        ISyncHookKeyFormatter
    where TEntity : EntityBaseCore, new()
{
    /// <inheritdoc />
    public required string TableName { get; init; }

    /// <summary>The remote endpoint route of the entity (for example "SyncOrder").</summary>
    public required string RemoteRouteName { get; init; }

    /// <summary>
    /// Whether the table has no version column - synchronised only by <see cref="SyncMode.LastWriteWins"/> runs,
    /// downloaded as a full key-ordered scan, and uploaded without version guards.
    /// </summary>
    public required bool IsVersionless { get; init; }

    /// <inheritdoc />
    public Type EntityType => typeof(TEntity);

    /// <summary>Reads the entity's primary key.</summary>
    public required Func<TEntity, TKey> ReadKey { get; init; }

    /// <summary>Writes the entity's primary key (used to build the stub a version-guarded delete is sent as).</summary>
    public required Action<TEntity, TKey> WriteKey { get; init; }

    /// <summary>Renders a primary key into the text form the journal stores.</summary>
    public required Func<TKey, string> FormatKey { get; init; }

    /// <summary>Parses a primary key back out of the journal's text form.</summary>
    public required Func<string, TKey> ParseKey { get; init; }

    /// <summary>Rewrites a key text an earlier version wrote into the form <see cref="FormatKey"/> writes now, or null when the form has not changed.</summary>
    /// <remarks>Applied to the journal, the receipts and the owed blob copies before a run reads them (see <see cref="SyncJournal"/>).</remarks>
    public Func<string, string>? NormalizeKeyText { get; init; }

    /// <summary>Reads the mirrored server version off the entity.</summary>
    /// <remarks>
    /// The default answers null, which is what a table without a version column has to say: the delete entries it
    /// records carry no version, and nothing else ever asks.
    /// </remarks>
    public Func<TEntity, byte[]?> ReadRowVersion { get; init; } = static _ => null;

    /// <summary>Writes the mirrored server version onto the entity.</summary>
    /// <remarks>The default does nothing, and is never reached: only a versioned table writes a mirrored version.</remarks>
    public Action<TEntity, byte[]?> WriteRowVersion { get; init; } = static (_, _) => { };

    /// <summary>SELECT that returns every primary key of the server table (SQL Server quoting).</summary>
    public required string ServerKeysSql { get; init; }

    /// <summary>SELECT that returns one ascending batch of server rows above the anchor and below the ceiling (versioned tables).</summary>
    public string ServerChangesSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the first ascending batch of server rows by primary key (versionless tables).</summary>
    public string ServerPageFirstSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the next ascending batch of server rows above a key (versionless tables).</summary>
    public string ServerPageAfterSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the highest mirrored version among the local rows (the derived resume point).</summary>
    public string LocalAnchorSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the mirrored version of one local row (bound as <c>@key</c>); empty for a versionless table.</summary>
    /// <remarks>
    /// Read when a graph save records a delete: the entity it deletes may be a stub carrying only the key, or an object
    /// held since before the row's last download, and either carries no version or an older one than the row has.
    /// </remarks>
    public string LocalRowVersionSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns every local primary key.</summary>
    public required string LocalKeysSql { get; init; }

    /// <summary>SELECT that returns the local primary keys within a given set (bound as the collection parameter <c>@keys</c>).</summary>
    public required string LocalExistingKeysSql { get; init; }

    /// <summary>DELETE that empties the local table (the first half of a refresh).</summary>
    public required string LocalDeleteAllSql { get; init; }

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (empty when the table has none).</summary>
    public IReadOnlyList<string> UnboundedBinaryColumnNames { get; init; } = [];

    /// <inheritdoc />
    public required string LocalTableName { get; init; }

    /// <inheritdoc />
    public string? LocalDatabaseName { get; init; }

    /// <inheritdoc />
    public required string LocalKeyColumnName { get; init; }

    /// <inheritdoc />
    public IReadOnlyList<string> LocalUnboundedBinaryColumnNames { get; init; } = [];

    /// <summary>The repository accessors for those columns, by column name (empty when the table has none).</summary>
    public IReadOnlyDictionary<string, SyncBinaryColumnAccessor<TKey>> UnboundedBinaryAccessors
    {
        get;
        init;
    } = new Dictionary<string, SyncBinaryColumnAccessor<TKey>>(StringComparer.Ordinal);

    /// <summary>The foreign keys of this table that point at the primary key of another synchronised table (or of itself).</summary>
    /// <remarks>
    /// A single-column foreign key to a synchronised table's primary key is listed; one that refers to a unique
    /// constraint, or spans several columns, is not, because the parent's key cannot be read off the row. The engine
    /// uses them to keep the parents of the rows the delete propagation keeps, to stop a download at a row whose parent
    /// is deleted locally and not yet sent, and to tell a write the server refused for a missing parent.
    /// </remarks>
    public IReadOnlyList<SyncParentReference<TEntity>> ParentReferences { get; init; } = [];

    /// <summary>Gives every NOT NULL unbounded binary column that holds nothing an empty value, before a row is inserted.</summary>
    /// <remarks>
    /// A row read for a sync run arrives without these columns, and a value-object column left unread is null - which a
    /// NOT NULL column refuses when the engine inserts the row locally. The empty value is what the column holds until
    /// the blob is copied, which is the same thing a row new to this side holds when the run does not carry the blobs.
    /// The default does nothing: a table without such a column has nothing to fill.
    /// </remarks>
    public Action<TEntity> FillUnsetUnboundedBinaries { get; init; } = static _ => { };

    /// <summary>The tables of the diagram that refer to this one, synchronised or not.</summary>
    /// <remarks>What makes a failed delete of one of this table's rows worth reporting as refused by the server.</remarks>
    public IReadOnlyList<string> ReferencingTableNames { get; init; } = [];

    /// <summary>The tables of the diagram that refer to this one through a foreign key <see cref="LocalReferences"/> does not list.</summary>
    /// <remarks>
    /// A foreign key that refers to a unique constraint of this table, or spans several columns, cannot be asked which
    /// rows it refers to. A refresh that empties this table and leaves such a table out refuses to run whenever the local
    /// database has that table, without looking at its rows.
    /// </remarks>
    public IReadOnlyList<string> UnlistedReferencingTableNames { get; init; } = [];

    /// <summary>The foreign keys of the diagram that point at this table's primary key, one per referring column.</summary>
    /// <remarks>
    /// Every referring table of the diagram is listed, synchronised or not, and this table itself when it refers to its
    /// own rows: the delete propagation removes only the rows nothing local refers to. A referring table the local
    /// database does not have is skipped, since it holds no rows to refer with. A foreign key that refers to a unique
    /// constraint, or spans several columns, is not listed.
    /// </remarks>
    public IReadOnlyList<SyncLocalReference> LocalReferences { get; init; } = [];

    /// <summary>The unique constraints of the table, one per constraint.</summary>
    /// <remarks>
    /// What a server row that collides with a local one on a unique value is resolved by: the local row holding the value
    /// is found and brought up to date first (see <see cref="SyncParentResolver"/>).
    /// </remarks>
    public IReadOnlyList<SyncUniqueLookup<TEntity>> LocalUniqueLookups { get; init; } = [];

    /// <summary>
    /// Writes the values of the table's unique constraints - the constraints <see cref="LocalUniqueLookups"/> lists - from
    /// one copy of a row (the first argument) into another (the second).
    /// </summary>
    /// <remarks>
    /// What a row staged for a unique value takes from the other copy: a row moved off a holder keeps its local unique
    /// values, and a holder giving its values up takes the server's (see <see cref="SyncParentResolver"/>). Null (the
    /// default) means unset: a descriptor built by hand that leaves it unset never stages such a row, and its collisions
    /// stay as they are; set it together with <see cref="LocalUniqueLookups"/>, over the same constraints, so that what is
    /// looked up and what is copied agree.
    /// </remarks>
    public Action<TEntity, TEntity>? CopyUniqueValues { get; init; }

    /// <inheritdoc />
    /// <remarks>
    /// A row with no key yet - a new row whose key a Before save hook is still to set, under a key type that can be
    /// null - has nothing to format, and gets <see cref="SyncJournal.UnsetKeyText"/>; the decorator's check after the
    /// write moves the entry to the key the save gave the row.
    /// </remarks>
    public string FormatEntityKey(EntityBaseCore entity)
    {
        ArgumentNullException.ThrowIfNull(entity);

        return ReadKey((TEntity)entity) is { } key ? FormatKey(key) : SyncJournal.UnsetKeyText;
    }

    /// <inheritdoc />
    public byte[]? ReadEntityRowVersion(EntityBaseCore entity)
    {
        ArgumentNullException.ThrowIfNull(entity);

        return ReadRowVersion((TEntity)entity);
    }

    /// <inheritdoc />
    string ISyncHookKeyFormatter.FormatHookKey(object key)
    {
        ArgumentNullException.ThrowIfNull(key);

        if (key is TKey typed)
        {
            return FormatKey(typed);
        }

        try
        {
{{~ if generate_value_objects ~}}
            var raw = SqlParameterValue.Unwrap(key)!;

            return FormatKey(
                SqlValueObjectActivator.Wrap(raw, typeof(TKey)) is TKey wrapped
                    ? wrapped
                    : (TKey)RawValueConverter.ConvertRaw(raw, typeof(TKey))
            );
{{~ else ~}}
            return FormatKey((TKey)RawValueConverter.ConvertRaw(key, typeof(TKey)));
{{~ end ~}}
        }
        catch (Exception failure)
        {
            throw new InvalidOperationException(
                $"A save hook wrote an unbounded binary column of {typeof(TEntity).Name} with a key of type "
                    + $"{key.GetType().Name}, which cannot be read as the table's key type {typeof(TKey).Name}, so the "
                    + "write cannot be recorded for the sync journal. Pass the key as the table's key type.",
                failure
            );
        }
    }

    /// <inheritdoc />
    async Task<byte[]?> ISyncLocalRowVersionReader.ReadLocalRowVersionAsync(
        ISqlExecutor local,
        string keyText,
        CancellationToken cancellationToken
    )
    {
        if (string.IsNullOrEmpty(LocalRowVersionSql))
        {
            return null;
        }

        return await local
            .ExecuteScalarSqlAsync<byte[]>(
                LocalRowVersionSql,
                new { key = ParseKey(keyText) },
                cancellationToken
            )
            .ConfigureAwait(false);
    }
}

/// <summary>Turns the key a save hook passed when it wrote an unbounded binary column into the journal's key text.</summary>
internal interface ISyncHookKeyFormatter
{
    /// <summary>The key text of the row, from the key as the hook passed it (the key type, or a value convertible to it).</summary>
    /// <param name="key">The key the hook passed.</param>
    /// <exception cref="InvalidOperationException">The key cannot be read as the table's key type.</exception>
    string FormatHookKey(object key);
}

/// <summary>Reads the mirrored version of one local row by its key text (what a recorded delete is guarded by).</summary>
internal interface ISyncLocalRowVersionReader
{
    /// <summary>The mirrored version of the local row with the given key, or null when the row or its version is not there.</summary>
    /// <param name="local">The local database.</param>
    /// <param name="keyText">The row's key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<byte[]?> ReadLocalRowVersionAsync(
        ISqlExecutor local,
        string keyText,
        CancellationToken cancellationToken
    );
}

/// <summary>
/// One side's unbounded binary columns, reached by column name through the repository that owns them.
/// </summary>
/// <remarks>
/// The same class serves the local database and a directly connected server, because both are reached through a
/// generated repository; only the instance differs. A column outside the descriptor's list is rejected rather than
/// ignored, for the reason <see cref="ISyncBinaryColumns{TKey}"/> gives.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncRepositoryBinaryColumns<TEntity, TKey> : ISyncBinaryColumns<TKey>
    where TEntity : EntityBaseCore, new()
{
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;
    private readonly object _repository;

    /// <summary>Creates the surface over the table's descriptor and the repository the columns are stored in.</summary>
    /// <param name="descriptor">The table's descriptor, which names the columns and holds their accessors.</param>
    /// <param name="repository">The generated repository instance the accessors are invoked on.</param>
    public SyncRepositoryBinaryColumns(
        SyncTableDescriptor<TEntity, TKey> descriptor,
        object repository
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(repository);
        _descriptor = descriptor;
        _repository = repository;
    }

    /// <inheritdoc />
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <inheritdoc />
    public Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    ) => Accessor(columnName).Read(_repository, id, destination, cancellationToken);

    /// <inheritdoc />
    public Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    ) => Accessor(columnName).Write(_repository, id, source, length, cancellationToken);

    /// <summary>Looks the accessors of one column up, refusing a name the table does not have.</summary>
    private SyncBinaryColumnAccessor<TKey> Accessor(string columnName) =>
        _descriptor.UnboundedBinaryAccessors.TryGetValue(columnName, out var accessor)
            ? accessor
            : throw new ArgumentOutOfRangeException(
                nameof(columnName),
                columnName,
                "The column is not an unbounded binary column of this table."
            );
}

/// <summary>
/// The server side of the differential source for one entity type: where changed rows, the change ceiling, and the key
/// set come from, and which repository the local changes are replayed against.
/// </summary>
/// <remarks>
/// The engine never talks to the server directly, so a second implementation (over HTTP, say) can replace the direct
/// one without the engine changing. The generated direct implementation reads through the server's raw SQL surface and
/// writes through the server's ordinary repository.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public interface ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>
    /// Gets the exclusive upper bound for this pass: the lowest version of any transaction still in flight.
    /// </summary>
    /// <remarks>
    /// A row committed later can carry a lower version than one committed earlier, so reading up to "the current
    /// maximum" would step over rows that are still uncommitted and never come back for them. Stopping below the
    /// oldest active transaction is what makes the derived anchor (the local mirror's maximum) safe to resume from.
    /// </remarks>
    Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default);

    /// <summary>Gets the rows whose version is above <paramref name="anchor"/> and below <paramref name="ceiling"/>, in ascending version order.</summary>
    /// <param name="anchor">The resume point (null on the first pass, which takes everything below the ceiling).</param>
    /// <param name="ceiling">The exclusive upper bound from <see cref="GetChangeCeilingAsync"/>.</param>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    );

    /// <summary>Gets the first batch of rows in ascending primary-key order (the versionless full scan).</summary>
    /// <remarks>
    /// A table without a version column has no change stream to resume, so its download reads every row, paged by the
    /// primary key. The default refuses rather than answers: a source written for a versioned table has no key-ordered
    /// SQL to serve it with, and only the generated versionless sources override it.
    /// </remarks>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <summary>Gets the next batch of rows whose primary key is above <paramref name="afterKey"/>, in ascending key order.</summary>
    /// <param name="afterKey">The last key of the previous batch (the exclusive lower bound).</param>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <summary>Gets every primary key the server holds for this table (the input to delete propagation).</summary>
    Task<IReadOnlyList<TKey>> GetAllKeysAsync(CancellationToken cancellationToken = default);

    /// <summary>The repository the local changes are replayed against.</summary>
    /// <remarks>
    /// The remote surface rather than the full one: replaying a journal entry only ever reads a row by key, inserts,
    /// updates, saves, or deletes it, and those are exactly the operations that can cross a network boundary. Asking for
    /// no more than that is what lets an HTTP client stand here beside a direct repository, which satisfies the narrower
    /// contract as well.
    /// </remarks>
    IRemoteRepositoryCore<TEntity, TKey> Writer { get; }

    /// <summary>The server's unbounded binary columns, or null when the table has none to copy.</summary>
    /// <remarks>
    /// Null is the answer for every table generated without the unbounded binary columns excluded, which is why it is
    /// the default: a source written before there was anything to copy still satisfies the contract, and a run that asks
    /// for the columns simply finds none.
    /// </remarks>
    ISyncBinaryColumns<TKey>? BinaryColumns => null;
}

/// <summary>What one table's download knows about the local changes of the run it belongs to.</summary>
/// <remarks>
/// <para>
/// Both halves are about the same thing: a download must not undo what the run's own upload has just done, and must not
/// undo what the upload could not do either.
/// </para>
/// <para>
/// <see cref="PendingKeyTexts"/> holds the keys whose local change is still in the journal - a collected conflict, or an
/// entry a failure left behind. The row behind such a key carries local content nobody has agreed to give up, so the
/// download stops there rather than overwriting it.
/// </para>
/// <para>
/// <see cref="AcknowledgedRowVersions"/> holds the version the server stamped on each row this device has uploaded and
/// not yet seen come back. Such a row comes back down as a change like any other, and applying it would be writing the
/// row's own content over itself; only the version is worth keeping, and that is all the download writes for it.
/// </para>
/// </remarks>
public sealed record SyncDownloadContext
{
    /// <summary>A download that knows of no unsent local change and of no outstanding acknowledgement.</summary>
    public static SyncDownloadContext Empty { get; } = new();

    /// <summary>The keys of this table that still hold an unsent journal entry.</summary>
    /// <remarks>
    /// A copy taken as the table's download starts. The engine hands it to a table that implements only the public
    /// surface; the fixed table classes read what is unsent again before each batch instead, so a row the application
    /// edits while the run is downloading is protected as well. A table of your own sees only what was unsent at the
    /// start, and an edit made after that may be overwritten by a batch it then applies.
    /// </remarks>
    public IReadOnlySet<string> PendingKeyTexts { get; init; } =
        new HashSet<string>(StringComparer.Ordinal);

    /// <summary>The acknowledged server version of each uploaded row awaiting its echo, by the key's journal text form.</summary>
    public IReadOnlyDictionary<string, byte[]> AcknowledgedRowVersions { get; init; } =
        new Dictionary<string, byte[]>(StringComparer.Ordinal);

    /// <summary>Reads the unsent changes afresh (set by the engine; replaces <see cref="PendingKeyTexts"/> when present).</summary>
    /// <remarks>
    /// The application may keep writing while a run downloads, so what is still unsent is read again right before each
    /// batch is applied, under the lock those writes take - never once up front, which would let a row edited in the
    /// meantime be overwritten by the batch.
    /// </remarks>
    internal Func<CancellationToken, Task<SyncPendingSnapshot>>? PendingReader { get; init; }

    /// <summary>The locks of the local database (set by the engine together with <see cref="PendingReader"/>).</summary>
    internal SyncLocalGate? Gate { get; init; }

    /// <summary>Makes the resolver one batch brings its missing parents in through (set by the engine together with <see cref="PendingReader"/>).</summary>
    internal Func<SyncPendingSnapshot, SyncParentResolver>? ParentResolverFactory { get; init; }
}

/// <summary>What is still unsent at the moment one download batch is about to be applied.</summary>
/// <param name="KeyTexts">The keys of the downloading table that hold an unsent entry.</param>
/// <param name="DeletedKeyTextsByTable">The keys of every table that hold an unsent delete, by table name.</param>
/// <param name="BinaryColumnsByKeyText">The unbounded binary columns the downloading table's unsent entries stored a value in, by key.</param>
internal sealed record SyncPendingSnapshot(
    IReadOnlySet<string> KeyTexts,
    IReadOnlyDictionary<string, IReadOnlySet<string>> DeletedKeyTextsByTable,
    IReadOnlyDictionary<string, IReadOnlySet<string>> BinaryColumnsByKeyText
)
{
    /// <summary>The keys of every table that hold an unsent entry, by table name.</summary>
    public IReadOnlyDictionary<string, IReadOnlySet<string>> KeyTextsByTable { get; init; } =
        new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal);
}

/// <summary>What one table's download did.</summary>
/// <param name="Applied">The number of server rows applied locally (a row recognised as this device's own echo is not one of them).</param>
/// <param name="TruncatedAtKeyText">The key of the row the download stopped at (see <see cref="SyncDownloadTruncation"/>), or null when the table was drained.</param>
/// <param name="SettledAckKeyTexts">The acknowledged keys whose mirrored version this download has brought up to date, so their receipts can go.</param>
/// <remarks>
/// The settled keys are handed back rather than cleared here because the clearing has to follow the local commit that
/// wrote the versions: a receipt dropped before the commit that replaces it, and a commit that then fails, is the
/// "no receipt, stale mirror" state all over again. The opposite order leaves a receipt behind for a row that no longer
/// needs one, which the next run recognises as an echo, writes the same version for, and clears - a state that repairs
/// itself.
/// </remarks>
public readonly record struct SyncDownloadOutcome(
    int Applied,
    string? TruncatedAtKeyText,
    IReadOnlyList<string> SettledAckKeyTexts
)
{
    /// <summary>An outcome with no receipt to settle (what a table that carries no acknowledgements returns).</summary>
    /// <param name="applied">The number of server rows applied locally.</param>
    /// <param name="truncatedAtKeyText">The key the download stopped at, or null when the table was drained.</param>
    public SyncDownloadOutcome(int applied, string? truncatedAtKeyText)
        : this(applied, truncatedAtKeyText, []) { }

    /// <summary>The table of the parent the row the download stopped at could not have, or null when it stopped for its own unsent change.</summary>
    public string? MissingParentTableName { get; init; }

    /// <summary>Whether the download stopped because a local save hook skipped the row (its Before returned false).</summary>
    public bool SkippedBySaveHook { get; init; }
}

/// <summary>One row a <see cref="SyncConflictPolicy.ServerWins"/> upload wrote the server's copy over.</summary>
/// <param name="KeyText">The primary key in the text form the table's descriptor produces.</param>
/// <param name="ServerRowVersion">The version the server's copy carried when it was read, or null when it had none.</param>
/// <remarks>
/// The version reported is the server's own, not the one written onto the local row - that one is deliberately left
/// where it was. So nothing about the row itself says that its local content is the server's content at that version,
/// and the run records the pair as an acknowledgement instead.
/// </remarks>
public readonly record struct SyncAppliedServerRow(string KeyText, byte[]? ServerRowVersion);

/// <summary>The engine's view of one synchronised table, with the entity's own types erased.</summary>
public interface ISyncTable
{
    /// <summary>The table name, as it appears in the journal.</summary>
    string TableName { get; }

    /// <summary>The CLR entity type the table synchronises (what the exclusion lists are matched against).</summary>
    Type EntityType { get; }

    /// <summary>
    /// Whether the table has no version column - synchronised only by <see cref="SyncMode.LastWriteWins"/> runs,
    /// downloaded as a full key-ordered scan, and uploaded without version guards.
    /// </summary>
    bool IsVersionless { get; }

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (empty when the table has none).</summary>
    /// <remarks>
    /// The engine reads this to decide whether a refresh has local blobs to lose, and callers can read it to see which
    /// columns <c>SyncOptions.IncludeUnboundedBinary</c> would carry.
    /// </remarks>
    IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>Gets the server's change ceiling (the engine asks one table and uses the answer for all of them).</summary>
    Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default);

    /// <summary>Pulls every server change below the ceiling into the local database and returns the number of rows applied.</summary>
    /// <remarks>
    /// A download that knows nothing of the run's local changes: it applies every row it is given. Inside a run the
    /// engine calls the overload that takes a <see cref="SyncDownloadContext"/> instead.
    /// </remarks>
    Task<int> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    );

    /// <summary>Pulls the server's changes down under what the run knows about its own local changes.</summary>
    /// <param name="ceiling">The exclusive upper bound of the pass.</param>
    /// <param name="batchSize">How many rows one batch fetches and applies in a single local transaction.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="context">The table's unsent local changes and its outstanding acknowledgements.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// The default answers as the context-free overload does, applying every row and never stopping early - the only
    /// sound answer for an implementation that has no way to tell a row with an unsent local change from any other.
    /// </remarks>
    async Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    ) =>
        new(
            await DownloadAsync(ceiling, batchSize, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false),
            null
        );

    /// <summary>Overwrites the named local rows with the server's copies.</summary>
    /// <param name="keyTexts">The keys, in the journal's text form, whose local content is to give way to the server's.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried down as well.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// <para>
    /// What <see cref="SyncConflictPolicy.ServerWins"/> is made of. Dropping the journal entry only stops the local
    /// change from being sent; the row keeps the content the entry was about, and the download brings nothing down for
    /// a row the server has not changed since it was last mirrored. The server's row is therefore read back and
    /// written over the local one, which is what "the server wins" says. A key the server no longer holds has nothing
    /// to apply, and is left to the delete propagation - so with propagation turned off that row stays as it is.
    /// </para>
    /// <para>
    /// <b>The mirrored version is left exactly where it was.</b> The row read from the server carries the server's
    /// current version, and writing that onto the local row would raise the derived resume point to it - past every
    /// row of the ordered stream this device has not seen, none of which any later run would ask for again. The
    /// content is applied and the version is not, so the next download reaches the row in its proper order and writes
    /// the version then; applying the same content a second time costs nothing.
    /// </para>
    /// <para>
    /// <b>Which is why the applied rows are reported back.</b> With the mirrored version left behind, nothing on the
    /// device records that the row's local content is the server's content at the version just read - and no download
    /// need ever supply it: a row restored under a server version at or below the derived resume point is one the
    /// ordered stream has already passed. Replaying a later edit to such a row would then find no version to guard it
    /// with and take it for a row that has never been on the server, which the server answers by already having it.
    /// The caller records the pairs as acknowledgements, and the replay reads its original from those too.
    /// </para>
    /// <para>
    /// The default applies nothing, the only sound answer for an implementation with no server of its own to read.
    /// </para>
    /// </remarks>
    /// <returns>The key and the server's version of every row applied, in the order they were applied.</returns>
    Task<IReadOnlyList<SyncAppliedServerRow>> ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) => Task.FromResult<IReadOnlyList<SyncAppliedServerRow>>([]);

    /// <summary>Deletes the local rows whose key the server no longer has, and returns the keys that went.</summary>
    /// <param name="pendingKeyTexts">The keys of this table that still hold an unsent journal entry; they are left alone.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// <para>
    /// A key the journal still holds an entry for is not treated as one the server dropped. The entry is a local
    /// intention this run has not settled - a conflict it collected, or a change it never reached - and deleting the row
    /// underneath it would resolve that in the server's favour without saying so, which is exactly what
    /// <see cref="SyncConflictPolicy.Collect"/> promises not to do. Once the entry is settled - uploaded, discarded as a
    /// stale intent, or dropped by <see cref="SyncConflictPolicy.ServerWins"/> - the next run propagates the deletion as
    /// usual.
    /// </para>
    /// <para>
    /// The protection reaches exactly as far as the journal does. A row written without going through the generated
    /// repositories - raw SQL, most of all - has no entry to hold it back and is deleted like any other row the server
    /// does not have (see <see cref="SyncOptions.PropagateDeletes"/>).
    /// </para>
    /// <para>
    /// The keys are returned rather than counted because a row the server has dropped invalidates whatever else was
    /// recorded about it - its acknowledgement most of all, which would otherwise send the next replay of that key
    /// against a version of a row that is gone.
    /// </para>
    /// </remarks>
    Task<IReadOnlyList<string>> PropagateDeletesAsync(
        IReadOnlySet<string> pendingKeyTexts,
        CancellationToken cancellationToken = default
    );

    /// <summary>Removes every local row of this table and returns how many went (the first half of a refresh).</summary>
    Task<int> DeleteAllLocalAsync(CancellationToken cancellationToken = default);

    /// <summary>Writes every server row below the ceiling into the emptied local table and returns how many arrived.</summary>
    Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    );

    /// <summary>Replays one journal entry against the server.</summary>
    /// <param name="entry">The journal entry to replay.</param>
    /// <param name="mode">The run's mode; <see cref="SyncMode.LastWriteWins"/> replays without version guards and ignores <paramref name="policy"/>.</param>
    /// <param name="policy">How a collision with the server is treated (versioned mode only).</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="acknowledgedRowVersion">The version the server last acknowledged for this key, or null when there is no receipt.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// A version-guarded replay guards against the later of the mirrored version and the acknowledged one. The mirror
    /// is the row's version as of the last download that reached it, the receipt is its version as of the last upload
    /// the server took, and either can be the more recent - the mirror when the receipt has already been cleared, the
    /// receipt when the echo has not come down yet.
    /// </remarks>
    Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    );
}

/// <summary>What one table's delete propagation did.</summary>
/// <param name="Removed">The keys whose local rows went.</param>
/// <param name="KeptParents">The parents in other tables that the rows this table kept refer to.</param>
internal sealed record SyncPropagationOutcome(
    IReadOnlyList<string> Removed,
    IReadOnlyList<(string TableName, string KeyText)> KeptParents
);

/// <summary>Works out which of the rows a delete propagation would remove have to stay, and which parents they need.</summary>
internal static class SyncKeptRows
{
    /// <summary>
    /// Closes the kept set over the parents within the table, and collects the parents in other tables.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A row the server does not have is kept when its key still holds an unsent entry, or when a kept row of a child
    /// table refers to it. A kept row keeps its parents in turn: removing a parent a kept row points at fails on the
    /// local foreign key, or - under <c>ON DELETE CASCADE</c> - takes the kept row with it. A parent in the same table is
    /// kept here, and its own parents are followed from it; a parent in another table is handed back, for that table's
    /// propagation to keep, which runs after this one because tables are propagated children first.
    /// </para>
    /// <para>
    /// Only rows the server does not have are followed. A parent the server still holds is not a candidate for
    /// removal, so there is nothing to keep it from; and a row met twice is followed once, so a reference cycle ends.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table being propagated.</param>
    /// <param name="seeds">The candidates kept on their own account (unsent, or needed by a child).</param>
    /// <param name="candidates">The keys of the local rows the server does not have.</param>
    /// <param name="readParents">Reads the parents a kept row refers to.</param>
    internal static async Task<(
        HashSet<string> Kept,
        List<(string TableName, string KeyText)> OtherParents
    )> CloseAsync(
        string tableName,
        IEnumerable<string> seeds,
        IReadOnlySet<string> candidates,
        Func<string, Task<IReadOnlyList<(string TableName, string KeyText)>>> readParents
    )
    {
        var kept = new HashSet<string>(StringComparer.Ordinal);
        var work = new Queue<string>();
        var otherParents = new List<(string TableName, string KeyText)>();

        foreach (var seed in seeds)
        {
            if (candidates.Contains(seed) && kept.Add(seed))
            {
                work.Enqueue(seed);
            }
        }

        while (work.TryDequeue(out var keyText))
        {
            foreach (var parent in await readParents(keyText).ConfigureAwait(false))
            {
                if (!string.Equals(parent.TableName, tableName, StringComparison.Ordinal))
                {
                    otherParents.Add(parent);
                }
                else if (candidates.Contains(parent.KeyText) && kept.Add(parent.KeyText))
                {
                    work.Enqueue(parent.KeyText);
                }
            }
        }

        return (kept, otherParents);
    }
}

/// <summary>Brings in the parents that rows about to be applied refer to and the local database does not have.</summary>
/// <remarks>
/// <para>
/// A row can arrive before the row it points at. A download applies rows in version order, and a parent changed after
/// its child carries the higher version; a parent changed above the run's ceiling does not come down in this run at
/// all; and the rows <see cref="SyncConflictPolicy.ServerWins"/> puts back arrive in the order they were recorded.
/// Applying such a row fails on the local foreign key.
/// </para>
/// <para>
/// A parent the local database does not have is read from the server and applied first, its own parents the same way,
/// unless one of these says it must not be:
/// </para>
/// <list type="bullet">
/// <item>its table is outside the run's scope (excluded, or versionless in a versioned run): the run does not touch that
/// table;</item>
/// <item>its key holds an unsent local delete the run is not discarding: the delete stands, and bringing the row back
/// would undo it without saying so;</item>
/// <item>the server does not have it either, or it cannot be had for one of these reasons in turn.</item>
/// </list>
/// <para>
/// A parent brought in is written the way a row <see cref="SyncConflictPolicy.ServerWins"/> puts back is: its content is
/// applied and its mirrored version is not, since that version would raise the derived resume point past rows the
/// ordered stream has not delivered. The server's version is recorded as an acknowledgement instead - without it, an
/// edit made to the row before a download reaches it would find no version to guard with.
/// </para>
/// <para>
/// The receipt speaks for the content read back, so it goes when the same run then writes an older copy over that
/// content: a download batch or a refresh batch fetched before the row was read back still holds the row as it was, and
/// writes it in its turn - the stream's order is what keeps the derived resume point honest, so the row is not skipped.
/// Left behind, the receipt would carry a version newer than the content, the next run would take the row's newer
/// version for an echo of its own and write only the version, and a later edit would be guarded with that version and
/// overwrite the server's newer content without a conflict. Each unit of writes reports the rows it wrote
/// (<see cref="EndWriteUnit"/>); a receipt recorded before a unit wrote its row goes right after that unit has
/// committed - a download's flush and a refresh batch alike, not with the table's download, which an exception can still
/// end before it clears anything - and that leaves the row as it would be had nothing been read back: the older content,
/// its mirrored version, and no receipt, so the next run brings the newer version down as content. A row read back
/// again after the unit that wrote it keeps its receipt, since the content is then the newer one again (see
/// <see cref="ReconcileSettledReceipts"/>). The same holds for a row brought up to date for a unique value
/// (<see cref="BringHoldersUpToDateAsync"/>).
/// </para>
/// <para>
/// The rows <see cref="SyncConflictPolicy.ServerWins"/> puts back never have their receipts outlive their content this
/// way: a parent listed among them counts as present rather than being read back, a row brought up to date for a unique
/// value that is listed among them as well is written from the list afterwards and its receipt is then recorded again
/// from the list's copy, and the table's download - the one stream that could still hold an older copy - has finished
/// before they are applied.
/// </para>
/// <para>
/// One resolver serves one download batch, the rows one table's download still owes, one table of a
/// <see cref="SyncConflictPolicy.ServerWins"/> application, or one refresh, and remembers the parents it has looked at,
/// so a parent several rows share is read once.
/// </para>
/// </remarks>
/// <param name="tables">Every table of the engine (a parent's table is looked up by name).</param>
/// <param name="scopeTableNames">The tables the run covers.</param>
/// <param name="pending">What is unsent (the unsent deletes the run is not discarding).</param>
/// <param name="journal">Where the acknowledgements of the parents brought in are recorded.</param>
/// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
/// <param name="propagateDeletes">Whether the run propagates deletes: a local row holding a unique value that the server no longer has is then removed (see <see cref="BringHoldersUpToDateAsync"/>).</param>
/// <param name="changes">Where the rows brought up to date for a unique value are noted, or null when the run does not report them (see <see cref="SyncResult.LocalRowChanges"/>).</param>
/// <param name="discarding">The rows a <see cref="SyncConflictPolicy.ServerWins"/> run is discarding, with the entries it read for each (null: none); a row removed so a holder can go has them dropped first.</param>
internal sealed class SyncParentResolver(
    IReadOnlyList<ISyncTable> tables,
    IReadOnlySet<string> scopeTableNames,
    SyncPendingSnapshot pending,
    SyncJournal journal,
    bool includeUnboundedBinary,
    bool propagateDeletes,
    SyncLocalRowChangeLog? changes = null,
    IReadOnlyDictionary<(string TableName, string KeyText), List<long>>? discarding = null
)
{
    /// <summary>What is unsent when nothing is (a refresh runs with the journal empty).</summary>
    internal static SyncPendingSnapshot NothingPending { get; } =
        new(
            new HashSet<string>(StringComparer.Ordinal),
            new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal),
            new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal)
        );

    /// <summary>The parents looked at so far: true when the row is there (it was, or it was brought in).</summary>
    private readonly Dictionary<(string TableName, string KeyText), bool> _known = new();

    /// <summary>The parents being brought in right now (met again on the way, they cannot be had: a reference cycle).</summary>
    private readonly HashSet<(string TableName, string KeyText)> _inProgress = new();

    /// <summary>The rows brought in, by table.</summary>
    private readonly Dictionary<string, HashSet<string>> _broughtIn = new(StringComparer.Ordinal);

    /// <summary>The rows this resolver has recorded a receipt for, by table.</summary>
    private readonly Dictionary<string, HashSet<string>> _acknowledged = new(StringComparer.Ordinal);

    /// <summary>The rows given a receipt since the last unit of writes of their table ended, by table.</summary>
    private readonly Dictionary<string, HashSet<string>> _acknowledgedSinceUnit = new(StringComparer.Ordinal);

    /// <summary>The rows whose receipt a unit of writes has since written an older copy over, by table.</summary>
    private readonly Dictionary<string, HashSet<string>> _overwritten = new(StringComparer.Ordinal);

    /// <summary>
    /// Ends one unit of writes of the table - a download's flush, a refresh batch - and returns the rows it wrote whose
    /// receipt this resolver recorded before the unit wrote them: the unit put the batch's own, older copy over the
    /// content read back, so the caller removes their receipts as soon as the unit has committed (see the class
    /// remarks).
    /// </summary>
    /// <remarks>
    /// Every receipt of a unit is recorded before the unit's last write of the rows: the parents are brought in before
    /// the rows are written, and a collision resolved on the way is followed by the whole unit being written again. A row
    /// given a receipt since the previous unit ended that this unit did not write was read back after any earlier write
    /// of it, so it is no longer counted as overwritten.
    /// </remarks>
    /// <param name="tableName">The table.</param>
    /// <param name="writtenKeyTexts">The keys of the rows the unit wrote as content.</param>
    internal IReadOnlyList<string> EndWriteUnit(
        string tableName,
        IEnumerable<string> writtenKeyTexts
    )
    {
        var written = writtenKeyTexts.ToHashSet(StringComparer.Ordinal);
        var overwritten = Rows(_overwritten, tableName);

        if (_acknowledgedSinceUnit.Remove(tableName, out var since))
        {
            overwritten.ExceptWith(since.Where(keyText => !written.Contains(keyText)));
        }

        var acknowledged = Rows(_acknowledged, tableName);
        var settled = written.Where(acknowledged.Contains).ToList();
        overwritten.UnionWith(settled);

        return settled;
    }

    /// <summary>
    /// Takes off a download's list of receipts to clear every row this resolver read back after the row's last write:
    /// the receipt it would clear is now the one recorded here, which speaks for the content read back - whatever put
    /// the row on the list (a receipt held when the table's download began, say). A receipt a unit overwrote has gone
    /// already, as that unit committed.
    /// </summary>
    /// <param name="tableName">The table.</param>
    /// <param name="settled">The keys whose receipts go once the download has committed.</param>
    internal void ReconcileSettledReceipts(string tableName, List<string> settled)
    {
        EndWriteUnit(tableName, []);
        var overwritten = Rows(_overwritten, tableName);

        foreach (var keyText in Rows(_acknowledged, tableName))
        {
            if (!overwritten.Contains(keyText))
            {
                settled.RemoveAll(key => string.Equals(key, keyText, StringComparison.Ordinal));
            }
        }
    }

    /// <summary>Records the receipt of a row this resolver read back from the server.</summary>
    private async Task RecordAckAsync(
        string tableName,
        string keyText,
        byte[] serverRowVersion,
        CancellationToken cancellationToken
    )
    {
        await journal
            .RecordAckAsync(tableName, keyText, serverRowVersion, cancellationToken)
            .ConfigureAwait(false);
        Rows(_acknowledged, tableName).Add(keyText);
        Rows(_acknowledgedSinceUnit, tableName).Add(keyText);
    }

    /// <summary>The set of one table's keys in a by-table map (added when the table has none yet).</summary>
    private static HashSet<string> Rows(Dictionary<string, HashSet<string>> byTable, string tableName)
    {
        if (!byTable.TryGetValue(tableName, out var keyTexts))
        {
            keyTexts = new HashSet<string>(StringComparer.Ordinal);
            byTable.Add(tableName, keyTexts);
        }

        return keyTexts;
    }

    /// <summary>Makes the given parents present where it may, and returns the ones that are not.</summary>
    /// <param name="parents">The parents, by table name and key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<IReadOnlySet<(string TableName, string KeyText)>> EnsureAsync(
        IEnumerable<(string TableName, string KeyText)> parents,
        CancellationToken cancellationToken
    )
    {
        var requested = parents.Distinct().ToList();

        foreach (
            var group in requested
                .Where(parent => !_known.ContainsKey(parent) && !_inProgress.Contains(parent))
                .GroupBy(parent => parent.TableName, StringComparer.Ordinal)
        )
        {
            await EnsureTableAsync(
                    group.Key,
                    group.Select(parent => parent.KeyText).ToList(),
                    cancellationToken
                )
                .ConfigureAwait(false);
        }

        return requested
            .Where(parent => !_known.TryGetValue(parent, out var present) || !present)
            .ToHashSet();
    }

    /// <summary>Whether the run propagates deletes (a local row the server no longer has may then be removed).</summary>
    internal bool PropagatesDeletes => propagateDeletes;

    /// <summary>Whether the row is being brought in or brought up to date right now, further up the way.</summary>
    /// <param name="tableName">The table.</param>
    /// <param name="keyText">The key.</param>
    internal bool IsInProgress(string tableName, string keyText) =>
        _inProgress.Contains((tableName, keyText));

    /// <summary>Whether the key holds an unsent local change the run is not discarding.</summary>
    /// <param name="tableName">The table.</param>
    /// <param name="keyText">The key.</param>
    internal bool HoldsUnsentChange(string tableName, string keyText) =>
        pending.KeyTextsByTable.TryGetValue(tableName, out var keyTexts) && keyTexts.Contains(keyText);

    /// <summary>
    /// Brings the local rows that hold a unique value a server row needs up to date from the server: a row the server
    /// still has takes its content, a row it no longer has goes when nothing local refers to it and the run propagates
    /// deletes. Returns whether every one of them was dealt with.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The download sees each row at its latest version only, so a row that gave a unique value up and was changed
    /// again later comes after the row that took the value - and the local copy still holding it refuses the newcomer.
    /// The local copy is what is out of date, so it is the one brought forward. Like a parent brought in, the row keeps
    /// no mirrored version and gets a receipt (see the class remarks).
    /// </para>
    /// <para>
    /// A holder whose server copy cannot go in only because its new parent is the row waiting for the value further up
    /// the way - a cycle of moves and renames - gives its values up instead: the server's unique values are written into
    /// the local row, which keeps its parent and the rest of its content
    /// (<see cref="ISyncTableRunSupport.ReleaseUniqueValuesAsync"/>). That is enough for the row waiting for the value,
    /// whose arrival is what the holder was waiting for, and the holder itself comes in whole when its own download or
    /// the run's own application reaches it.
    /// </para>
    /// <para>
    /// The caller has already ruled out a row with an unsent change and a row whose server copy still holds the value;
    /// a row met again on the way - a cycle of rows each holding the value the next one needs - is not dealt with.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table.</param>
    /// <param name="keyTexts">The keys of the local rows holding the values.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<bool> BringHoldersUpToDateAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        if (
            tables.FirstOrDefault(table =>
                string.Equals(table.TableName, tableName, StringComparison.Ordinal)
            )
            is not ISyncTableRunSupport support
            || keyTexts.Any(keyText => _inProgress.Contains((tableName, keyText)))
        )
        {
            return false;
        }

        foreach (var keyText in keyTexts)
        {
            _inProgress.Add((tableName, keyText));
        }

        try
        {
            var (applied, held, removed) = await support
                .ApplyServerRowsAsync(
                    keyTexts,
                    includeUnboundedBinary,
                    removeLocalRowsMissingOnServer: propagateDeletes,
                    this,
                    cancellationToken
                )
                .ConfigureAwait(false);

            foreach (var row in applied)
            {
                if (row.ServerRowVersion is { Length: > 0 } serverRowVersion)
                {
                    await RecordAckAsync(tableName, row.KeyText, serverRowVersion, cancellationToken)
                        .ConfigureAwait(false);
                }
            }

            if (removed.Count > 0)
            {
                await journal
                    .RemoveAcksAsync(tableName, removed, cancellationToken)
                    .ConfigureAwait(false);
            }

            var dealtWith = applied
                .Select(row => row.KeyText)
                .Concat(removed)
                .ToHashSet(StringComparer.Ordinal);

            foreach (var keyText in held)
            {
                if (
                    await support
                        .ReleaseUniqueValuesAsync(keyText, this, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    dealtWith.Add(keyText);
                }
            }

            if (changes is not null)
            {
                foreach (var keyText in dealtWith)
                {
                    changes.Add(tableName, keyText, SyncLocalRowChangeReason.ReloadedForUniqueValue);
                }
            }

            return keyTexts.All(dealtWith.Contains);
        }
        finally
        {
            foreach (var keyText in keyTexts)
            {
                _inProgress.Remove((tableName, keyText));
            }
        }
    }

    /// <summary>
    /// Reads back from the server the rows a download still owes this device (see
    /// <see cref="SyncJournal.RecordOwedRowsAsync"/>), and returns the keys whose records can go.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Decided per row, before the table's download fetches anything:
    /// </para>
    /// <list type="bullet">
    /// <item>The local database has the row: something wrote it after it was removed - the application, the download, or
    /// a row read back on the way - and that is newer than what was owed, so the record goes.</item>
    /// <item>The key holds an unsent local change the run is not discarding: the record stays, and is looked at again once
    /// the change is settled.</item>
    /// <item>Otherwise the server's copy is read and put in the way a parent brought in is - its content without its
    /// mirrored version, its parents first, the server's version recorded as a receipt (see the class remarks) - and the
    /// record goes. The server no longer having the row also lets the record go: the row is gone, as a delete propagation
    /// would leave it. A row that does not go in - a parent that cannot be had, a unique value another local row holds -
    /// keeps its record for a later run.</item>
    /// </list>
    /// <para>
    /// The receipt this records is never overwritten by an older copy in the same run: the table's download fetches its
    /// batches after this, so they hold the row at the version read here or a later one.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table.</param>
    /// <param name="keyTexts">The keys of the owed rows.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<IReadOnlyList<string>> BringOwedRowsBackAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        if (
            keyTexts.Count == 0
            || !scopeTableNames.Contains(tableName)
            || tables.FirstOrDefault(table =>
                string.Equals(table.TableName, tableName, StringComparison.Ordinal)
            )
                is not ISyncTableRunSupport support
        )
        {
            return [];
        }

        var present = await support
            .FindLocalKeyTextsAsync(keyTexts, cancellationToken)
            .ConfigureAwait(false);
        var settled = keyTexts.Where(present.Contains).ToList();
        var toBringIn = keyTexts
            .Where(keyText =>
                !present.Contains(keyText)
                && !HoldsUnsentChange(tableName, keyText)
                && !_inProgress.Contains((tableName, keyText))
            )
            .ToList();

        if (toBringIn.Count == 0)
        {
            return settled;
        }

        foreach (var keyText in toBringIn)
        {
            _inProgress.Add((tableName, keyText));
        }

        IReadOnlyList<SyncAppliedServerRow> applied;
        IReadOnlyList<string> held;

        try
        {
            (applied, held, _) = await support
                .ApplyServerRowsAsync(
                    toBringIn,
                    includeUnboundedBinary,
                    removeLocalRowsMissingOnServer: false,
                    this,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        finally
        {
            foreach (var keyText in toBringIn)
            {
                _inProgress.Remove((tableName, keyText));
            }
        }

        foreach (var row in applied)
        {
            _known[(tableName, row.KeyText)] = true;
            Rows(_broughtIn, tableName).Add(row.KeyText);

            if (row.ServerRowVersion is { Length: > 0 } serverRowVersion)
            {
                await RecordAckAsync(tableName, row.KeyText, serverRowVersion, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        // What was neither put in nor held back is what the server no longer has.
        var kept = held.ToHashSet(StringComparer.Ordinal);
        settled.AddRange(toBringIn.Where(keyText => !kept.Contains(keyText)));

        return settled;
    }

    /// <summary>The keys of the table this resolver has brought in.</summary>
    /// <param name="tableName">The table.</param>
    internal IReadOnlySet<string> BroughtIn(string tableName) =>
        _broughtIn.TryGetValue(tableName, out var keyTexts)
            ? keyTexts
            : new HashSet<string>(StringComparer.Ordinal);

    /// <summary>Looks at the parents of one table and brings in the missing ones it may.</summary>
    private async Task EnsureTableAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        // A table the fixed classes do not implement cannot say which rows it holds. Its rows are taken to be there,
        // as every parent was before parents were looked at; the local foreign key has the last word.
        if (
            tables.FirstOrDefault(table =>
                string.Equals(table.TableName, tableName, StringComparison.Ordinal)
            )
            is not ISyncTableRunSupport support
        )
        {
            foreach (var keyText in keyTexts)
            {
                _known[(tableName, keyText)] = true;
            }

            return;
        }

        var present = await support
            .FindLocalKeyTextsAsync(keyTexts, cancellationToken)
            .ConfigureAwait(false);
        var toBringIn = new List<string>();

        foreach (var keyText in keyTexts)
        {
            if (present.Contains(keyText))
            {
                _known[(tableName, keyText)] = true;
            }
            else if (
                !scopeTableNames.Contains(tableName)
                || pending.DeletedKeyTextsByTable.TryGetValue(tableName, out var deleted)
                    && deleted.Contains(keyText)
            )
            {
                _known[(tableName, keyText)] = false;
            }
            else
            {
                toBringIn.Add(keyText);
            }
        }

        if (toBringIn.Count == 0)
        {
            return;
        }

        foreach (var keyText in toBringIn)
        {
            _inProgress.Add((tableName, keyText));
        }

        IReadOnlyList<SyncAppliedServerRow> applied;

        try
        {
            (applied, _, _) = await support
                .ApplyServerRowsAsync(
                    toBringIn,
                    includeUnboundedBinary,
                    removeLocalRowsMissingOnServer: false,
                    this,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        finally
        {
            foreach (var keyText in toBringIn)
            {
                _inProgress.Remove((tableName, keyText));
            }
        }

        if (!_broughtIn.TryGetValue(tableName, out var broughtIn))
        {
            broughtIn = new HashSet<string>(StringComparer.Ordinal);
            _broughtIn.Add(tableName, broughtIn);
        }

        foreach (var row in applied)
        {
            broughtIn.Add(row.KeyText);

            // A table with no version has nothing to acknowledge.
            if (row.ServerRowVersion is { Length: > 0 } serverRowVersion)
            {
                await RecordAckAsync(tableName, row.KeyText, serverRowVersion, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        foreach (var keyText in toBringIn)
        {
            _known[(tableName, keyText)] = broughtIn.Contains(keyText);
        }
    }

    /// <summary>
    /// Removes the local rows that keep the given holders - rows the server no longer has - from going, when every one of
    /// them has nothing to send; returns whether it removed them. The holders themselves are left to
    /// <see cref="BringHoldersUpToDateAsync"/>, which can then remove them.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A holder stays while a local row refers to it, and the row referring to it can be one whose server copy sits
    /// below the very row waiting for the holder's value: a row created here under the holder whose key the server holds
    /// under that row, or a stale copy of a row the server moved there. Its server copy cannot go in first - its parent
    /// is the waiting row - and the waiting row cannot go in while the holder is there, so nothing moves on any run.
    /// When every row keeping the holder, directly or through other rows, has nothing to send - no unsent change, or
    /// entries the run is discarding - the rows are removed, children first, and the holder can go. Nothing the device
    /// meant to send is lost by it: a row that only had entries the run discards gives up a change the run gives up
    /// anyway, and a row the server does not have is one the delete propagation removes as soon as nothing refers to it.
    /// </para>
    /// <para>
    /// It is asked only when the run propagates deletes, as the holder is removed only then. The rows are removed only when
    /// all of them belong to tables of the fixed classes the run covers and nothing else refers to them: a row of a table
    /// outside the run, of a table the engine does not synchronise, or one followed through a foreign key the descriptors
    /// do not list keeps them, and so does a cycle among them. Whatever stops it is found before anything is removed.
    /// </para>
    /// <para>
    /// The entries the run is discarding go before the row they describe does. A run that stops in between leaves a
    /// row with no entries, which the next run treats the same way; the other order could leave an entry of a delete
    /// for a row that is gone, which a later run would send to the server against the row the server holds. A removed
    /// row takes its receipt with it, as in the delete propagation. Each removed row is noted as
    /// <see cref="SyncLocalRowChangeReason.RemovedForUniqueValue"/>.
    /// </para>
    /// <para>
    /// The removed rows the server has come back with their server copies through the download - in the same run when
    /// their table comes after the one being applied, as the rows below the waiting row do, otherwise in the next - or
    /// through the <see cref="SyncConflictPolicy.ServerWins"/> application that puts them back. A row whose server copy
    /// is behind the resume point the table's remaining rows derive - one up to date here, hanging below a row being
    /// removed, while a later row of its table has come down - would not come down again, so it is recorded as owed
    /// (<see cref="SyncJournal.RecordOwedRowsAsync"/>) before any row goes, and its table's download reads it back from
    /// the server first (<see cref="BringOwedRowsBackAsync"/>). The record goes in after the entries and before the
    /// rows: a run that stops after it and before the row goes leaves the row and its record, and the record is dropped
    /// when the row is found still there; the other order could leave the row gone with nothing to bring it back.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The holders' table.</param>
    /// <param name="holderKeyTexts">The keys of the holders the server no longer has.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<bool> RemoveRowsKeepingHoldersAsync(
        string tableName,
        IReadOnlySet<string> holderKeyTexts,
        CancellationToken cancellationToken
    )
    {
        if (holderKeyTexts.Count == 0)
        {
            return false;
        }

        var inside = tables
            .Where(table => table is ISyncTableRunSupport && scopeTableNames.Contains(table.TableName))
            .Select(table => table.TableName)
            .ToHashSet(StringComparer.Ordinal);

        if (!inside.Contains(tableName))
        {
            return false;
        }

        var holders = holderKeyTexts.Select(keyText => (TableName: tableName, KeyText: keyText)).ToHashSet();
        var found = new List<(string TableName, string KeyText)>();
        var parentsOf = new Dictionary<(string TableName, string KeyText), HashSet<(string TableName, string KeyText)>>();
        var frontier = holders.ToList();

        while (frontier.Count > 0)
        {
            var next = new List<(string TableName, string KeyText)>();

            foreach (var group in frontier.GroupBy(row => row.TableName, StringComparer.Ordinal))
            {
                var parentKeyTexts = group.Select(row => row.KeyText).ToHashSet(StringComparer.Ordinal);

                if (
                    await Support(group.Key)
                        .IsReferencedOutsideAsync(parentKeyTexts, inside, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    return false;
                }

                foreach (var childTable in tables.Where(table => inside.Contains(table.TableName)))
                {
                    var referring = await ((ISyncTableRunSupport)childTable)
                        .FindLocalRowsReferringAsync(group.Key, parentKeyTexts, cancellationToken)
                        .ConfigureAwait(false);

                    foreach (var (childKeyText, parentKeyText) in referring)
                    {
                        var child = (TableName: childTable.TableName, KeyText: childKeyText);

                        if (holders.Contains(child))
                        {
                            continue;
                        }

                        if (_inProgress.Contains(child) || HoldsUnsentChange(child.TableName, child.KeyText))
                        {
                            return false;
                        }

                        if (!parentsOf.TryGetValue(child, out var parents))
                        {
                            parents = [];
                            parentsOf.Add(child, parents);
                            found.Add(child);
                            next.Add(child);
                        }

                        parents.Add((group.Key, parentKeyText));
                    }
                }
            }

            frontier = next;
        }

        if (found.Count == 0)
        {
            return false;
        }

        // Children first: a row goes once no row still to go refers to it. A cycle among them leaves rows over, and
        // then nothing is removed.
        var referrers = found.ToDictionary(row => row, _ => 0);

        foreach (var parent in parentsOf.Values.SelectMany(parents => parents))
        {
            if (referrers.ContainsKey(parent))
            {
                referrers[parent]++;
            }
        }

        var order = new List<(string TableName, string KeyText)>(found.Count);
        var ready = new Queue<(string TableName, string KeyText)>(found.Where(row => referrers[row] == 0));

        while (ready.TryDequeue(out var row))
        {
            order.Add(row);

            foreach (var parent in parentsOf[row])
            {
                if (referrers.ContainsKey(parent) && --referrers[parent] == 0)
                {
                    ready.Enqueue(parent);
                }
            }
        }

        if (order.Count != found.Count)
        {
            return false;
        }

        // A row whose server copy is behind the resume point the remaining rows derive would not come down again, so it is
        // recorded as owed and read back from the server when its table's download comes round (see the remarks).
        var owed = new List<(string TableName, IReadOnlyList<string> KeyTexts)>();

        foreach (var group in found.GroupBy(row => row.TableName, StringComparer.Ordinal))
        {
            var passed = await Support(group.Key)
                .FindRowsNotBroughtBackAsync(group.Select(row => row.KeyText).ToList(), cancellationToken)
                .ConfigureAwait(false);

            if (passed.Count > 0)
            {
                owed.Add((group.Key, passed));
            }
        }

        // The entries first, then the owed rows, then the rows (see the remarks).
        var discarded = order
            .Where(row => discarding is not null && discarding.ContainsKey(row))
            .ToList();
        var ids = discarded.SelectMany(row => discarding![row]).ToList();

        if (ids.Count > 0)
        {
            using (SyncSession.Suppress())
            {
                await journal.RemoveAsync(ids, cancellationToken).ConfigureAwait(false);
            }
        }

        foreach (var (rowTableName, keyText) in discarded)
        {
            changes?.Add(rowTableName, keyText, SyncLocalRowChangeReason.DiscardedByServerWins);
        }

        foreach (var (owedTableName, keyTexts) in owed)
        {
            await journal.RecordOwedRowsAsync(owedTableName, keyTexts, cancellationToken).ConfigureAwait(false);
        }

        foreach (var row in order)
        {
            var removed = await Support(row.TableName)
                .RemoveLocalRowsAsync([row.KeyText], cancellationToken)
                .ConfigureAwait(false);

            if (removed.Count == 0)
            {
                continue;
            }

            await journal
                .RemoveAcksAsync(row.TableName, removed, cancellationToken)
                .ConfigureAwait(false);
            _known.Remove(row);
            changes?.Add(row.TableName, row.KeyText, SyncLocalRowChangeReason.RemovedForUniqueValue);
        }

        return true;

        ISyncTableRunSupport Support(string name) =>
            (ISyncTableRunSupport)tables.First(table => string.Equals(table.TableName, name, StringComparison.Ordinal));
    }
}

/// <summary>What the engine asks of the fixed table classes beyond the public <see cref="ISyncTable"/> surface.</summary>
/// <remarks>
/// These are the steps of a run that need the local database's locks, or knowledge the engine has and a table does not.
/// They are kept off the public interface because they are a protocol between the engine and the fixed classes rather
/// than something an implementation of its own would be asked to supply; a table that does not implement this is run
/// the way the public interface describes.
/// </remarks>
internal interface ISyncTableRunSupport
{
    /// <summary>Deletes the local rows whose key the server no longer has, reading the unsent keys under the write lock.</summary>
    /// <param name="gate">The locks of the local database.</param>
    /// <param name="readPendingKeyTexts">Reads this table's unsent keys at the moment it is called.</param>
    /// <param name="keptByChildren">Keys of this table that rows the propagation of child tables kept refer to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The keys that went, and the parents in other tables that the rows kept here refer to.</returns>
    Task<SyncPropagationOutcome> PropagateDeletesAsync(
        SyncLocalGate gate,
        Func<CancellationToken, Task<IReadOnlySet<string>>> readPendingKeyTexts,
        IReadOnlySet<string> keptByChildren,
        CancellationToken cancellationToken
    );

    /// <summary>Whether some table of the diagram refers to this one (what a refused delete is reported by).</summary>
    bool IsReferenced { get; }

    /// <summary>The local raw SQL surface the table's statements run on (tables sharing one can be emptied in one transaction).</summary>
    ISqlExecutor LocalSqlExecutor { get; }

    /// <summary>The statement that empties the local table (what <see cref="ISyncTable.DeleteAllLocalAsync"/> runs).</summary>
    string LocalDeleteAllSql { get; }

    /// <summary>The tables of the diagram that refer to this one, synchronised or not (see <see cref="SyncTableDescriptor{TEntity, TKey}.ReferencingTableNames"/>).</summary>
    IReadOnlyList<string> ReferencingTableNames { get; }

    /// <summary>The referring tables whose foreign key a row cannot be followed by (see <see cref="SyncTableDescriptor{TEntity, TKey}.UnlistedReferencingTableNames"/>).</summary>
    IReadOnlyList<string> UnlistedReferencingTableNames { get; }

    /// <summary>Whether a row the server holds for this table refers to the given parent (what tells a delete the server refused from one that failed).</summary>
    /// <param name="parentTableName">The parent's table.</param>
    /// <param name="parentKeyText">The parent's key, in the journal's text form.</param>
    /// <param name="batchSize">How many server rows one read fetches.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> HasServerRowReferringToAsync(
        string parentTableName,
        string parentKeyText,
        int batchSize,
        CancellationToken cancellationToken
    );

    /// <summary>Returns the tables outside the given scope whose local rows refer to a local row of this table (what a refresh refuses to run for).</summary>
    /// <param name="scopeTableNames">The tables the refresh covers.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlyList<string>> FindReferencesFromOutsideAsync(
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    );

    /// <summary>Reads the local row and the parents it refers to (empty when the row is gone or refers to nothing).</summary>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<(object? LocalRow, IReadOnlyList<(string TableName, string KeyText)> Parents)> ReadLocalParentsAsync(
        string keyText,
        CancellationToken cancellationToken
    );

    /// <summary>Reads the server's row (null when the server does not have it).</summary>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<object?> ReadServerRowAsync(string keyText, CancellationToken cancellationToken);

    /// <summary>Returns which of the given keys the local table holds a row for (what decides the operation a replay sends).</summary>
    /// <param name="keyTexts">The keys, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlySet<string>> FindLocalKeyTextsAsync(
        IReadOnlyCollection<string> keyTexts,
        CancellationToken cancellationToken
    );

    /// <summary>
    /// Overwrites the named local rows with the server's copies (see <see cref="ISyncTable.ApplyServerRowsAsync"/>),
    /// bringing in the parents they refer to first; a row whose parent cannot be had, or whose unique values collide with
    /// another local row, is left as it is and handed back.
    /// </summary>
    /// <param name="keyTexts">The keys, in the journal's text form.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried down as well.</param>
    /// <param name="removeLocalRowsMissingOnServer">
    /// Whether a named row the server does not have is removed locally first (when nothing local refers to it), so the
    /// rows put back do not collide with it - what the delete propagation would do later in the run.
    /// </param>
    /// <param name="resolver">Brings in the missing parents it may.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The rows applied, the keys left alone, and the keys of the local rows removed.</returns>
    Task<(
        IReadOnlyList<SyncAppliedServerRow> Applied,
        IReadOnlyList<string> Held,
        IReadOnlyList<string> Removed
    )> ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        bool removeLocalRowsMissingOnServer,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    );

    /// <summary>
    /// Writes the server's unique values into the local row and keeps the rest of it - its parent included - as it is;
    /// returns whether the row was written (false when either copy is missing, the values are already the server's, or
    /// the write does not go in).
    /// </summary>
    /// <remarks>
    /// Asked of a local row holding a unique value another row needs, when its server copy cannot go in whole. The
    /// mirrored version is the local row's own, so the row is still due for its download, which brings the rest.
    /// </remarks>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="resolver">Brings the local rows holding the server's values up to date in turn.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> ReleaseUniqueValuesAsync(
        string keyText,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    );

    /// <summary>
    /// Returns the local rows of this table that refer to one of the given rows of a parent table, each with the key of
    /// the row it refers to (what keeps a holder from going; see <see cref="SyncParentResolver.RemoveRowsKeepingHoldersAsync"/>).
    /// </summary>
    /// <param name="parentTableName">The parent's table.</param>
    /// <param name="parentKeyTexts">The parents' keys, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlyList<(string KeyText, string ParentKeyText)>> FindLocalRowsReferringAsync(
        string parentTableName,
        IReadOnlySet<string> parentKeyTexts,
        CancellationToken cancellationToken
    );

    /// <summary>
    /// Whether a local row of a table other than the given ones refers to one of the given rows of this table, or a table
    /// that refers to this one through a foreign key a row cannot be followed by is in the local database.
    /// </summary>
    /// <param name="keyTexts">The rows' keys, in the journal's text form.</param>
    /// <param name="insideTableNames">The tables whose rows the caller looks at itself.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> IsReferencedOutsideAsync(
        IReadOnlySet<string> keyTexts,
        IReadOnlySet<string> insideTableNames,
        CancellationToken cancellationToken
    );

    /// <summary>
    /// Returns the given keys whose server copy the table's download would not bring back if the local rows were removed:
    /// the server holds the row at a version the resume point derived from the remaining rows has already passed (none
    /// for a versionless table, whose download reads every row).
    /// </summary>
    /// <param name="keyTexts">The rows' keys, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlyList<string>> FindRowsNotBroughtBackAsync(
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    );

    /// <summary>Deletes the given local rows without recording the deletes, and returns the keys that went.</summary>
    /// <param name="keyTexts">The rows' keys, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlyList<string>> RemoveLocalRowsAsync(
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    );

    /// <summary>Rewrites a key text an earlier version wrote into today's form, or null when the table's form has not changed.</summary>
    Func<string, string>? NormalizeKeyText { get; }

    /// <summary>Whether the local row's unique values are held by another row on the server (false when the local row is gone).</summary>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> CollidesOnServerAsync(string keyText, CancellationToken cancellationToken);

    /// <summary>Reloads the emptied table (see <see cref="ISyncTable.RefreshAsync"/>), bringing in first the parents a row refers to and the reload has not reached.</summary>
    /// <param name="ceiling">The exclusive upper bound of the reload.</param>
    /// <param name="batchSize">How many rows one batch fetches and inserts.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="resolver">Brings in the missing parents (one for the whole refresh).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    );
}

/// <summary>
/// The shared half of one synchronised table: the pieces that do not depend on whether the table carries a version
/// column - batch application, delete propagation, the local wipe of a refresh, the unbounded-binary column copy,
/// and the last-write-wins replay of a journal entry.
/// </summary>
/// <remarks>
/// The two shapes a table can take derive from this: <see cref="SyncTable{TEntity, TKey}"/> for a table with a
/// version column (incremental download, version-guarded replay) and <see cref="VersionlessSyncTable{TEntity, TKey}"/>
/// for one without (full key-ordered download, last-write-wins replay). They are classes rather than a flag because
/// the two differ in what they are able to promise, not in how they are configured.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class SyncTableBase<TEntity, TKey> : ISyncTable, ISyncTableRunSupport
    where TEntity : EntityBaseCore, new()
{
    /// <summary>The local repository, reached through the journaling decorator (engine writes suppress the recording).</summary>
    protected readonly IRepositoryCore<TEntity, TKey> _local;

    /// <summary>The local raw SQL surface (key sets, the derived anchor, the wipe of a refresh).</summary>
    protected readonly ISqlExecutor _localSqlExecutor;

    /// <summary>The server side: where changed rows and key sets come from, and where local changes are replayed to.</summary>
    protected readonly ISyncServerSource<TEntity, TKey> _server;

    /// <summary>The table's generated descriptor (its name, its SQL, and how a key and a version are read and written).</summary>
    protected readonly SyncTableDescriptor<TEntity, TKey> _descriptor;

    /// <summary>The local side's unbounded binary columns, built once because a copy asks for them per row.</summary>
    private readonly ISyncBinaryColumns<TKey>? _localBinaryColumns;

    /// <summary>
    /// The journal of the local database this table writes to: the receipts an upload records before it sends the
    /// blobs, and the copies of blobs a download still owes.
    /// </summary>
    /// <remarks>
    /// Built over the table's own local executor, which is the executor the engine's journal sits on, so both write the
    /// same tables of the same database.
    /// </remarks>
    private protected readonly SyncJournal _localJournal;

    /// <summary>The save hooks of the local repository, or null when the table was built without them.</summary>
    private readonly ISaveHookRegistry? _localSaveHooks;

    /// <summary>Creates the table with its local repository, the local raw SQL surface, the server source, and its descriptor.</summary>
    /// <param name="local">The local repository.</param>
    /// <param name="localSqlExecutor">The local raw SQL surface.</param>
    /// <param name="server">The server source.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="localSaveHooks">The save hooks the local repository runs (the registry it was given); null when it runs none.</param>
    protected SyncTableBase(
        IRepositoryCore<TEntity, TKey> local,
        ISqlExecutor localSqlExecutor,
        ISyncServerSource<TEntity, TKey> server,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISaveHookRegistry? localSaveHooks = null
    )
    {
        ArgumentNullException.ThrowIfNull(local);
        ArgumentNullException.ThrowIfNull(localSqlExecutor);
        ArgumentNullException.ThrowIfNull(server);
        ArgumentNullException.ThrowIfNull(descriptor);
        _local = local;
        _localSqlExecutor = localSqlExecutor;
        _server = server;
        _descriptor = descriptor;
        _localBinaryColumns =
            descriptor.UnboundedBinaryColumnNames.Count == 0
                ? null
                : new SyncRepositoryBinaryColumns<TEntity, TKey>(descriptor, local);
        _localJournal = new SyncJournal(localSqlExecutor);
        _localSaveHooks = localSaveHooks;
    }

    /// <inheritdoc />
    public string TableName => _descriptor.TableName;

    /// <inheritdoc />
    public Type EntityType => typeof(TEntity);

    /// <inheritdoc />
    public bool IsVersionless => _descriptor.IsVersionless;

    /// <summary>The local side's unbounded binary columns, or null when the table has none.</summary>
    /// <remarks>
    /// Null exactly when the descriptor names no such column; the two sides are asked separately because either one can
    /// be absent, and a copy needs both.
    /// </remarks>
    protected ISyncBinaryColumns<TKey>? LocalBinaryColumns => _localBinaryColumns;

    /// <inheritdoc />
    /// <remarks>
    /// The descriptor's own list, which is also what the local copy iterates, so the names the engine reads and the
    /// names the copy walks cannot come apart.
    /// </remarks>
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <summary>SELECT that returns every local primary key.</summary>
    protected string LocalKeysSql => _descriptor.LocalKeysSql;

    /// <summary>SELECT that returns the local primary keys within a given set (bound as the collection parameter <c>@keys</c>).</summary>
    protected string LocalExistingKeysSql => _descriptor.LocalExistingKeysSql;

    /// <summary>DELETE that empties the local table (the first half of a refresh).</summary>
    protected string LocalDeleteAllSql => _descriptor.LocalDeleteAllSql;

    /// <summary>Reads the entity's primary key.</summary>
    protected TKey ReadKey(TEntity entity) => _descriptor.ReadKey(entity);

    /// <summary>Writes the entity's primary key (used to build the stub a version-guarded delete is sent as).</summary>
    protected void WriteKey(TEntity entity, TKey key) => _descriptor.WriteKey(entity, key);

    /// <summary>Renders a primary key into the text form the journal stores.</summary>
    public string FormatKey(TKey key) => _descriptor.FormatKey(key);

    /// <summary>Parses a primary key back out of the journal's text form.</summary>
    public TKey ParseKey(string keyText) => _descriptor.ParseKey(keyText);

    /// <inheritdoc />
    public virtual Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => _server.GetChangeCeilingAsync(cancellationToken);

    /// <inheritdoc />
    /// <remarks>The download that knows of no unsent local change and of no outstanding acknowledgement.</remarks>
    public virtual async Task<int> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) =>
        (
            await DownloadAsync(
                ceiling,
                batchSize,
                includeUnboundedBinary,
                SyncDownloadContext.Empty,
                cancellationToken
            )
                .ConfigureAwait(false)
        ).Applied;

    /// <inheritdoc />
    public abstract Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public abstract Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    );

    /// <summary>The reload behind <see cref="RefreshAsync(byte[], int, bool, CancellationToken)"/>, bringing in missing parents through the resolver when there is one.</summary>
    private protected abstract Task<int> RefreshCoreAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    );

    /// <inheritdoc />
    Task<int> ISyncTableRunSupport.RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    ) => RefreshCoreAsync(ceiling, batchSize, includeUnboundedBinary, resolver, cancellationToken);

    /// <inheritdoc />
    public abstract Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    );

    /// <summary>The later of two server versions (null and empty both mean "no version at all").</summary>
    /// <remarks>See <see cref="SyncRowVersions.Max"/>.</remarks>
    private protected static byte[]? MaxRowVersion(byte[]? left, byte[]? right) =>
        SyncRowVersions.Max(left, right);

    /// <summary>
    /// Replays one journal entry without version guards: the local change overwrites whatever the server holds.
    /// </summary>
    /// <remarks>
    /// One code path for every table. An upsert re-reads the current local row (nothing to send is a stale intent,
    /// discarded), overwrites the server's row with <see cref="ConcurrencyMode.ForceOverwrite"/>, and inserts it when
    /// the update finds no row - which also means a row deleted on the server is resurrected by a local edit, exactly
    /// what last-write-wins promises. A delete needs no version, but it does re-read the local row for the reason an
    /// upsert does: a row that is still there says the business delete never landed, which makes the entry a stale
    /// intent rather than something to carry out on the server. A delete of a row the server no longer has is a no-op.
    /// Nothing can conflict, so nothing is ever collected.
    /// </remarks>
    protected async Task<SyncUploadOutcome> UploadLastWriteWinsAsync(
        SyncJournalRow entry,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var key = ParseKey(entry.KeyText);

        if (
            string.Equals(
                entry.Operation,
                nameof(SyncJournalOperation.Delete),
                StringComparison.Ordinal
            )
        )
        {
            if (await LocalRowSurvivedDeleteAsync(key, cancellationToken).ConfigureAwait(false))
            {
                return SyncUploadOutcome.Discarded;
            }

            await _server.Writer.DeleteAsync(key, cancellationToken).ConfigureAwait(false);

            return SyncUploadOutcome.Uploaded;
        }

        var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);

        if (local is null)
        {
            // A journal-first entry whose business write never landed, or a row deleted afterwards. Nothing to send.
            return SyncUploadOutcome.Discarded;
        }

        // The row was read without its unbounded binary columns, so a NOT NULL one may hold nothing at all, which an
        // insert on the server would refuse; an update never writes these columns, so the empty value goes nowhere.
        _descriptor.FillUnsetUnboundedBinaries(local);

        var inserted = await ForceOverwriteOrInsertAsync(local, cancellationToken)
            .ConfigureAwait(false);
        var columns = ColumnsToSend(entry, inserted, includeUnboundedBinary);

        if (inserted)
        {
            await KeepInsertedBlobsOwedAsync(entry, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        if (columns.Count > 0)
        {
            await RecordInterimAckAsync(entry, local, cancellationToken).ConfigureAwait(false);
            await CopyBinaryColumnsUpAsync(key, columns, cancellationToken).ConfigureAwait(false);
        }

        if (!inserted)
        {
            await OweUnsentBlobCopiesAsync(entry.KeyText, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        return SyncUploadOutcome.UploadedWith(
            await ReadServerRowVersionAsync(local, columns.Count > 0, cancellationToken)
                .ConfigureAwait(false)
        );
    }

    /// <summary>
    /// Records the version the server gave the row it has just taken, before its unbounded binary columns are sent.
    /// </summary>
    /// <remarks>
    /// The row has reached the server once the write returns, and the blobs that follow are separate writes that can
    /// fail on their own. Without a receipt in between, a failed blob copy leaves the entry in the journal with the
    /// mirrored version behind the server's, and the next run reports a conflict against the row this device wrote
    /// itself. The run overwrites the receipt with the version read back after the blobs, as it always does.
    /// </remarks>
    private protected async Task RecordInterimAckAsync(
        SyncJournalRow entry,
        TEntity sent,
        CancellationToken cancellationToken
    )
    {
        if (IsVersionless || _descriptor.ReadRowVersion(sent) is not { Length: > 0 } version)
        {
            return;
        }

        await _localJournal
            .RecordAckAsync(TableName, entry.KeyText, version, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Reads the version the server now holds for a row an upsert has just sent.</summary>
    /// <remarks>
    /// The writer stamps the row it accepted, so the entity in hand already carries the new version. Writing a blob is
    /// another write to the same row, so where the excluded columns were carried the stamp in hand is behind by one and
    /// the server row is read once more. A table without a version column has nothing to report.
    /// </remarks>
    /// <param name="local">The row that was sent, as the writer left it.</param>
    /// <param name="copiedUnboundedBinary">Whether any unbounded binary column was sent after the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task<byte[]?> ReadServerRowVersionAsync(
        TEntity local,
        bool copiedUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        if (IsVersionless)
        {
            return null;
        }

        if (copiedUnboundedBinary)
        {
            var refreshed = await _server
                .Writer.GetByIdAsync(ReadKey(local), cancellationToken)
                .ConfigureAwait(false);

            if (refreshed is not null)
            {
                return _descriptor.ReadRowVersion(refreshed);
            }
        }

        return _descriptor.ReadRowVersion(local);
    }

    /// <summary>Overwrites the server's row without a version guard, inserting it when the update finds no row. Returns whether it inserted.</summary>
    /// <remarks>
    /// The two halves belong together: an update that matches nothing means the server no longer holds the row, and
    /// putting it back is what "the local change wins" amounts to. Shared by the last-write-wins replay and by the
    /// <see cref="SyncConflictPolicy.LocalWins"/> resolution of a version-guarded one, so the two say the same thing.
    /// </remarks>
    /// <param name="local">The current local row, which becomes the server's.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task<bool> ForceOverwriteOrInsertAsync(
        TEntity local,
        CancellationToken cancellationToken
    )
    {
        local.MarkUpdated();
        var updated = await _server
            .Writer.UpdateAsync(local, ConcurrencyMode.ForceOverwrite, cancellationToken)
            .ConfigureAwait(false);

        if (updated)
        {
            return false;
        }

        local.MarkAdded();
        await _server.Writer.InsertAsync(local, cancellationToken).ConfigureAwait(false);

        return true;
    }

    /// <summary>The unbounded binary columns an upload sends after the row: every one for a row it inserted, otherwise the ones the entry's writes stored a value in.</summary>
    /// <remarks>
    /// A row the server is given for the first time - an offline insert, a row a local edit puts back after the server
    /// deleted it, a row created again here - gets its blobs from this device or not at all, so every column goes, as an
    /// ordinary insert writes them. An update leaves the server's blobs in place, so only the columns written here go
    /// (see <see cref="UnboundedBinaryColumnsOf"/>).
    /// </remarks>
    /// <param name="entry">The replayed entry.</param>
    /// <param name="inserted">Whether the row was inserted on the server.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    private protected IReadOnlyList<string> ColumnsToSend(
        SyncJournalRow entry,
        bool inserted,
        bool includeUnboundedBinary
    ) =>
        !includeUnboundedBinary ? []
        : inserted ? UnboundedBinaryColumnNames
        : UnboundedBinaryColumnsOf(entry);

    /// <summary>Keeps every unbounded binary column owed by the entry of a row the upload has just inserted, before they are sent.</summary>
    /// <remarks>See <see cref="SyncJournal.WidenUnboundedBinaryColumnsAsync"/>.</remarks>
    /// <param name="entry">The replayed entry (its id is the newest of the row's entries, which are read together).</param>
    /// <param name="columns">The columns about to be sent.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task KeepInsertedBlobsOwedAsync(
        SyncJournalRow entry,
        IReadOnlyList<string> columns,
        CancellationToken cancellationToken
    )
    {
        if (columns.Count == 0 || columns.Count == UnboundedBinaryColumnsOf(entry).Count)
        {
            return;
        }

        using (SyncSession.Suppress())
        {
            await _localJournal
                .WidenUnboundedBinaryColumnsAsync(entry.Id, columns, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Records, after a write that overwrote the server's row without a version guard, a copy down of each unbounded
    /// binary column the upload did not send.
    /// </summary>
    /// <remarks>
    /// The overwrite leaves the server's blobs as they were, and those may be another writer's, newer than the ones
    /// here. The row that comes back down is this device's own echo, which the download recognises by its receipt and
    /// does not copy anything for - so without this the blobs would differ for good. The copy is made by the next run
    /// that carries the columns (<see cref="CopyOwedBlobsAsync"/>), which leaves a column alone if a later local write
    /// stored a value in it.
    /// </remarks>
    /// <param name="keyText">The row's key text.</param>
    /// <param name="sent">The columns the upload sent.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task OweUnsentBlobCopiesAsync(
        string keyText,
        IReadOnlyList<string> sent,
        CancellationToken cancellationToken
    )
    {
        if (_server.BinaryColumns is null || LocalBinaryColumns is null)
        {
            return;
        }

        var unsent = UnboundedBinaryColumnNames
            .Where(column => !sent.Contains(column, StringComparer.Ordinal))
            .ToList();

        if (unsent.Count > 0)
        {
            await _localJournal
                .RecordBlobCopiesAsync(TableName, [keyText], unsent, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <summary>Whether the local row a delete entry speaks for is still there (the delete never landed).</summary>
    /// <remarks>
    /// The journal records the intent before the business delete runs, so an entry can outlive a delete a foreign key
    /// or a lock refused. Removing the server's row on the strength of such an entry would let a failed local
    /// operation finish itself on the server - and the delete propagation of the same run would then take the
    /// surviving local row with it. An upsert is already protected by re-reading the row it sends; this is the same
    /// guard for the one operation that has nothing to re-read.
    /// </remarks>
    /// <param name="key">The key the entry names.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task<bool> LocalRowSurvivedDeleteAsync(
        TKey key,
        CancellationToken cancellationToken
    ) => await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false) is not null;

    /// <summary>Inserts one batch of a refresh into the emptied table, with its blobs when the run carries them.</summary>
    /// <remarks>
    /// <para>
    /// With a resolver, the parents the rows refer to and the reload has not reached are brought in first - a parent of
    /// the same table changed after its child comes later in version order, possibly in a later batch. A row brought in
    /// that way is already there when its own batch arrives, so it is saved over rather than inserted a second time.
    /// A row whose parent cannot be had is inserted all the same and fails on the local foreign key, as it always did.
    /// </para>
    /// <para>
    /// Saving it over writes the batch's copy, which is older than the row read back when the server changed the row
    /// after the batch was fetched. The receipt the resolver recorded for the row read back then goes once the save has
    /// committed (see <see cref="SyncParentResolver"/>): the row is left with the batch's content, its mirrored version,
    /// and no receipt, and the next run brings the newer version down as content.
    /// </para>
    /// </remarks>
    private protected async Task<int> InsertRefreshedRowsAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        var inserted = 0;
        var batch = rows;
        IReadOnlyList<TEntity> again = [];

        if (resolver is not null)
        {
            await FindRowsMissingParentsAsync(rows, resolver, cancellationToken)
                .ConfigureAwait(false);
            var broughtIn = resolver.BroughtIn(TableName);

            if (broughtIn.Count > 0)
            {
                again = rows.Where(row => broughtIn.Contains(FormatKey(ReadKey(row)))).ToList();
                rows = rows.Where(row => !broughtIn.Contains(FormatKey(ReadKey(row)))).ToList();
            }
        }

        foreach (var row in rows)
        {
            _descriptor.FillUnsetUnboundedBinaries(row);
        }

        await WriteRowsAndBlobsAsync(
                rows,
                includeUnboundedBinary,
                async () =>
                {
                    using (SyncSession.Suppress())
                    {
                        inserted = await _local
                            .BulkInsertAsync(rows, cancellationToken)
                            .ConfigureAwait(false);
                    }

                    return true;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        if (again.Count > 0)
        {
            await ApplyBatchAsync(again, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false);
            inserted += again.Count;
        }

        if (resolver is not null)
        {
            // The batch has committed: a receipt for a row read back before the batch wrote it over has gone stale.
            // Not the caller's token: a cancellation arriving after the commit must not leave the stale receipt behind.
            var overwritten = resolver.EndWriteUnit(
                TableName,
                batch.Select(row => FormatKey(ReadKey(row)))
            );

            if (overwritten.Count > 0)
            {
                await _localJournal
                    .RemoveAcksAsync(TableName, overwritten, CancellationToken.None)
                    .ConfigureAwait(false);
            }
        }

        return inserted;
    }

    /// <summary>
    /// Works out which of the rows about to be applied cannot be, because a parent they refer to is neither in the
    /// local database nor one the resolver may bring in; the ones it may are brought in on the way.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A parent that is an earlier row of the same list, or the row itself, is taken to be there, since it is applied
    /// first - unless that row cannot be applied either. A parent later in the list is brought in ahead of it like any
    /// other missing parent, and written again when its own turn comes: the rows of a download are committed in the
    /// order they arrived, and that order is what keeps the derived resume point honest.
    /// </para>
    /// <para>
    /// Rows applied together in no particular order - what <see cref="SyncConflictPolicy.ServerWins"/> puts back, or
    /// parents brought in - pass <paramref name="inAnyOrder"/>: a parent anywhere in the list is taken to be there
    /// unless it cannot be applied either, and the caller puts the rows in parent-first order
    /// (<see cref="ParentsFirst"/>) before applying them.
    /// </para>
    /// </remarks>
    /// <param name="rows">The rows, in the order they would be applied.</param>
    /// <param name="resolver">Brings in the missing parents it may (null: no parent is looked at).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <param name="inAnyOrder">Whether a parent later in the list counts as well.</param>
    /// <returns>The rows that cannot be applied, by index, each with the table of the parent it lacks.</returns>
    private protected async Task<Dictionary<int, string>> FindRowsMissingParentsAsync(
        IReadOnlyList<TEntity> rows,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken,
        bool inAnyOrder = false
    )
    {
        var blocked = new Dictionary<int, string>();

        if (resolver is null || _descriptor.ParentReferences.Count == 0 || rows.Count == 0)
        {
            return blocked;
        }

        var positions = new Dictionary<string, int>(StringComparer.Ordinal);

        for (var index = 0; index < rows.Count; index++)
        {
            positions.TryAdd(FormatKey(ReadKey(rows[index])), index);
        }

        var parentsByRow = rows.Select(ReadParents).ToList();
        var missing = await resolver
            .EnsureAsync(
                parentsByRow.SelectMany(
                    (parents, index) =>
                        parents.Where(parent => EarlierRow(parent, index) is null)
                ),
                cancellationToken
            )
            .ConfigureAwait(false);

        // Repeated until nothing changes: in any order, a row can depend on one later in the list that is found
        // unable only afterwards.
        for (var changed = true; changed; )
        {
            changed = false;

            for (var index = 0; index < rows.Count; index++)
            {
                if (blocked.ContainsKey(index))
                {
                    continue;
                }

                foreach (var parent in parentsByRow[index])
                {
                    var cannot = EarlierRow(parent, index) is { } earlier
                        ? blocked.ContainsKey(earlier)
                        : missing.Contains(parent);

                    if (cannot)
                    {
                        blocked[index] = parent.TableName;
                        changed = true;
                        break;
                    }
                }
            }
        }

        return blocked;

        int? EarlierRow((string TableName, string KeyText) parent, int index) =>
            string.Equals(parent.TableName, TableName, StringComparison.Ordinal)
            && positions.TryGetValue(parent.KeyText, out var position)
            && (inAnyOrder || position <= index)
                ? position
                : null;
    }

    /// <summary>Puts rows applied together in no particular order into parent-first order within this table (a reference cycle keeps the order it has).</summary>
    private protected List<TEntity> ParentsFirst(IReadOnlyList<TEntity> rows)
    {
        if (_descriptor.ParentReferences.Count == 0 || rows.Count < 2)
        {
            return rows.ToList();
        }

        var byKey = new Dictionary<string, TEntity>(StringComparer.Ordinal);

        foreach (var row in rows)
        {
            byKey.TryAdd(FormatKey(ReadKey(row)), row);
        }

        var ordered = new List<TEntity>(rows.Count);
        var visited = new HashSet<string>(StringComparer.Ordinal);

        foreach (var row in rows)
        {
            Visit(row);
        }

        return ordered;

        void Visit(TEntity row)
        {
            if (!visited.Add(FormatKey(ReadKey(row))))
            {
                return;
            }

            foreach (var parent in ReadParents(row))
            {
                if (
                    string.Equals(parent.TableName, TableName, StringComparison.Ordinal)
                    && byKey.TryGetValue(parent.KeyText, out var parentRow)
                )
                {
                    Visit(parentRow);
                }
            }

            ordered.Add(row);
        }
    }

    /// <summary>Writes a batch of rows and, when the run carries them, copies their unbounded binary columns down.</summary>
    /// <remarks>
    /// The copies owed are recorded before the rows are written and dropped once they have been made. A copy that fails
    /// leaves its record behind, and the next run that carries the columns makes it first
    /// (<see cref="CopyOwedBlobsAsync"/>): the row itself is already in, its version has moved the resume point past
    /// it, and nothing else would ever bring its blob down.
    /// </remarks>
    /// <param name="rows">The rows of the batch.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="writeRows">Writes the rows themselves, returning false when they did not go in (a local save hook skipped them): no blob is copied then, and the records of the copies go - as they do, before the exception goes on, when it throws.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task WriteRowsAndBlobsAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        Func<Task<bool>> writeRows,
        CancellationToken cancellationToken
    )
    {
        if (
            !includeUnboundedBinary
            || _server.BinaryColumns is null
            || LocalBinaryColumns is not { } local
            || rows.Count == 0
        )
        {
            await writeRows().ConfigureAwait(false);

            return;
        }

        var keyTexts = rows.Select(row => FormatKey(ReadKey(row))).ToList();
        await _localJournal
            .RecordBlobCopiesAsync(TableName, keyTexts, local.UnboundedBinaryColumnNames, cancellationToken)
            .ConfigureAwait(false);

        bool written;

        try
        {
            written = await writeRows().ConfigureAwait(false);
        }
        catch (Exception)
        {
            // The rows did not go in, so the copies recorded for them go, as when a save hook skips them: left behind,
            // a later run would copy the server's blob into a local row that still holds its older content. Best
            // effort - not the caller's token, and a failure here does not hide the write's own.
            try
            {
                await _localJournal
                    .RemoveBlobCopiesAsync(TableName, keyTexts, CancellationToken.None)
                    .ConfigureAwait(false);
            }
            catch (Exception)
            {
                // The records stay, as a process stopped at this point would leave them.
            }

            throw;
        }

        // After the rows, not with them: an excluded column is not part of the row, and the copy needs the row to be
        // there to write into.
        if (written)
        {
            await CopyBinaryColumnsDownAsync(rows, cancellationToken).ConfigureAwait(false);
        }

        await _localJournal
            .RemoveBlobCopiesAsync(TableName, keyTexts, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>
    /// Reads back from the server the rows an earlier step left owing for this table, and drops the records of the ones
    /// settled (see <see cref="SyncParentResolver.BringOwedRowsBackAsync"/>).
    /// </summary>
    /// <remarks>
    /// Done under the write lock with what is unsent read afresh, as a download batch is. A download the engine does not
    /// drive has no resolver to bring the rows in through, so it leaves the records for a run that does.
    /// </remarks>
    /// <param name="context">The table's download context (what is unsent, the lock, and the resolver).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task BringOwedRowsBackAsync(
        SyncDownloadContext context,
        CancellationToken cancellationToken
    )
    {
        if (context.ParentResolverFactory is null || context.Gate is null || context.PendingReader is null)
        {
            return;
        }

        var owed = await _localJournal.ReadOwedRowsAsync(TableName, cancellationToken).ConfigureAwait(false);

        if (owed.Count == 0)
        {
            return;
        }

        var settled = await RunBatchSectionAsync<IReadOnlyList<string>>(
                context,
                async (_, resolver) =>
                {
                    if (resolver is null)
                    {
                        return [];
                    }

                    return await resolver
                        .BringOwedRowsBackAsync(TableName, owed, cancellationToken)
                        .ConfigureAwait(false);
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        if (settled.Count > 0)
        {
            await _localJournal.RemoveOwedRowsAsync(TableName, settled, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>Makes the blob copies an earlier run left owing for this table (when this run carries the columns).</summary>
    /// <remarks>
    /// <para>
    /// Decided per row and column, under the write lock when the engine drives the download:
    /// </para>
    /// <list type="bullet">
    /// <item>The local row is gone (deleted here, or by a delete propagation): there is nothing to copy into, and the
    /// record goes.</item>
    /// <item>An unsent entry of the row stored a value in that column: the local blob was written here since and is the
    /// newer one, so it is not copied over, and the record goes.</item>
    /// <item>The server no longer has the row: there is nothing to copy from - reading its column would come back
    /// empty, and writing that empty value into a NOT NULL column would fail on every run - so the record goes, and the
    /// row is left to the delete propagation.</item>
    /// <item>Otherwise - no unsent entry, or only entries that did not touch the column, such as an edit of the row's
    /// ordinary columns: the server's blob is copied down, and the record goes.</item>
    /// </list>
    /// <para>
    /// A download called without the engine knows which keys are unsent but not which columns their entries wrote, so
    /// a key with an unsent entry keeps its record for a run that does.
    /// </para>
    /// </remarks>
    /// <param name="context">The table's download context (what is unsent, and the lock).</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task CopyOwedBlobsAsync(
        SyncDownloadContext context,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        if (
            !includeUnboundedBinary
            || _server.BinaryColumns is not { } server
            || LocalBinaryColumns is not { } local
        )
        {
            return;
        }

        if (context.Gate is { } gate && context.PendingReader is { } readPending)
        {
            await gate.WriteExclusiveAsync(
                    async () =>
                    {
                        var pending = await readPending(cancellationToken).ConfigureAwait(false);
                        await CopyOwedBlobsCoreAsync(
                                server,
                                local,
                                (keyText, column) =>
                                    pending.BinaryColumnsByKeyText.TryGetValue(keyText, out var written)
                                    && written.Contains(column),
                                _ => false,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        return true;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);

            return;
        }

        var pendingKeyTexts = context.PendingKeyTexts;
        await CopyOwedBlobsCoreAsync(
                server,
                local,
                (_, _) => false,
                pendingKeyTexts.Contains,
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>The body of <see cref="CopyOwedBlobsAsync"/>.</summary>
    /// <param name="server">The server's unbounded binary columns.</param>
    /// <param name="local">The local unbounded binary columns.</param>
    /// <param name="writtenHere">Whether an unsent entry of the row stored a value in the column.</param>
    /// <param name="keepRecord">Whether the row's records are kept as they are, for a run that can decide them.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task CopyOwedBlobsCoreAsync(
        ISyncBinaryColumns<TKey> server,
        ISyncBinaryColumns<TKey> local,
        Func<string, string, bool> writtenHere,
        Func<string, bool> keepRecord,
        CancellationToken cancellationToken
    )
    {
        var owed = await _localJournal
            .ReadBlobCopiesAsync(TableName, cancellationToken)
            .ConfigureAwait(false);

        if (owed.Count == 0)
        {
            return;
        }

        var keyTexts = owed.Select(copy => copy.KeyText)
            .Distinct(StringComparer.Ordinal)
            .Where(keyText => !keepRecord(keyText))
            .ToList();
        var present = await FindLocalKeyTextsAsync(keyTexts.Select(ParseKey), cancellationToken)
            .ConfigureAwait(false);

        // Asked once per row, and only for the rows a copy would be made for.
        var onServer = new Dictionary<string, bool>(StringComparer.Ordinal);

        using (SyncSession.Suppress())
        {
            foreach (var copy in owed)
            {
                if (
                    keepRecord(copy.KeyText)
                    || !present.Contains(copy.KeyText)
                    || writtenHere(copy.KeyText, copy.ColumnName)
                    || !local.UnboundedBinaryColumnNames.Contains(copy.ColumnName, StringComparer.Ordinal)
                )
                {
                    continue;
                }

                if (!onServer.TryGetValue(copy.KeyText, out var serverHasRow))
                {
                    serverHasRow =
                        await _server
                            .Writer.GetByIdAsync(ParseKey(copy.KeyText), cancellationToken)
                            .ConfigureAwait(false)
                            is not null;
                    onServer.Add(copy.KeyText, serverHasRow);
                }

                if (!serverHasRow)
                {
                    continue;
                }

                await CopyBinaryColumnAsync(
                        server,
                        local,
                        copy.ColumnName,
                        ParseKey(copy.KeyText),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }
        }

        await _localJournal
            .RemoveBlobCopiesAsync(TableName, keyTexts, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Copies every unbounded binary column of the given rows from the server down to the local database.</summary>
    /// <remarks>
    /// Suppressed as a whole: the local write goes through the journaling decorator like any other, and a downloaded
    /// blob recorded as a local change would be uploaded straight back on the next run.
    /// </remarks>
    protected async Task CopyBinaryColumnsDownAsync(
        IReadOnlyList<TEntity> rows,
        CancellationToken cancellationToken
    )
    {
        if (_server.BinaryColumns is not { } server || LocalBinaryColumns is not { } local)
        {
            return;
        }

        using (SyncSession.Suppress())
        {
            foreach (var row in rows)
            {
                var key = ReadKey(row);

                foreach (var column in local.UnboundedBinaryColumnNames)
                {
                    await CopyBinaryColumnAsync(server, local, column, key, cancellationToken)
                        .ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>The unbounded binary columns a journal entry says the row's writes stored a value in.</summary>
    /// <remarks>
    /// Only those are sent. A row this device has never had a blob for - one brought down by a run that did not carry
    /// the columns, and edited here since - would otherwise send its empty column over the server's blob.
    /// </remarks>
    private protected IReadOnlyList<string> UnboundedBinaryColumnsOf(SyncJournalRow entry) =>
        SyncJournal
            .SplitUnboundedBinaryColumns(entry.UnboundedBinaryColumns)
            .Where(column => UnboundedBinaryColumnNames.Contains(column, StringComparer.Ordinal))
            .ToList();

    /// <summary>Copies the given unbounded binary columns of one row from the local database up to the server.</summary>
    protected async Task CopyBinaryColumnsUpAsync(
        TKey key,
        IReadOnlyList<string> columns,
        CancellationToken cancellationToken
    )
    {
        if (
            columns.Count == 0
            || _server.BinaryColumns is not { } server
            || LocalBinaryColumns is not { } local
        )
        {
            return;
        }

        using (SyncSession.Suppress())
        {
            foreach (var column in columns)
            {
                await CopyBinaryColumnAsync(local, server, column, key, cancellationToken)
                    .ConfigureAwait(false);
            }
        }
    }

    /// <summary>Copies one column of one row from one side to the other.</summary>
    /// <remarks>
    /// <para>
    /// The two accessors meet in the middle rather than end to end: reading pushes the bytes into a stream that is
    /// handed to it, writing pulls them out of a stream that is handed to it, and a stream cannot be both. A temporary
    /// file is what joins them without either side holding the blob in memory - and it answers the other question the
    /// write asks, since a length has to be known up front and the finished file reports its own. It lives in the
    /// operating system's temporary folder and is removed once the column has been written.
    /// </para>
    /// <para>
    /// A source column that is NULL (or a row the source no longer has) clears the destination rather than leaving what
    /// was there: the point of carrying these columns is that the two sides end up alike, and a stale blob under a row
    /// whose server copy has none is exactly the disagreement this is here to remove.
    /// </para>
    /// </remarks>
    private static async Task CopyBinaryColumnAsync(
        ISyncBinaryColumns<TKey> from,
        ISyncBinaryColumns<TKey> to,
        string columnName,
        TKey key,
        CancellationToken cancellationToken
    )
    {
        var path = Path.Combine(
            Path.GetTempPath(),
            "quicker-sync-" + Guid.NewGuid().ToString("n") + ".tmp"
        );

        try
        {
            bool present;

            await using (
                var destination = new FileStream(
                    path,
                    FileMode.Create,
                    FileAccess.Write,
                    FileShare.None,
                    bufferSize: 81920,
                    useAsync: true
                )
            )
            {
                present = await from.ReadUnboundedBinaryAsync(
                    columnName,
                    key,
                    destination,
                    cancellationToken
                )
                    .ConfigureAwait(false);
            }

            if (!present)
            {
                await to.WriteUnboundedBinaryAsync(columnName, key, null, null, cancellationToken)
                    .ConfigureAwait(false);

                return;
            }

            await using var source = new FileStream(
                path,
                FileMode.Open,
                FileAccess.Read,
                FileShare.Read,
                bufferSize: 81920,
                useAsync: true
            );
            await to.WriteUnboundedBinaryAsync(
                columnName,
                key,
                source,
                source.Length,
                cancellationToken
            )
                .ConfigureAwait(false);
        }
        finally
        {
            // Swallowed on purpose: this runs while an exception from the copy itself may be in flight, and letting a
            // failure to delete replace it would erase why the copy failed. What is lost by ignoring it is one
            // temporary file left in the operating system's temporary folder.
            try
            {
                File.Delete(path);
            }
            catch
            {
                // Nothing to do here - see above.
            }
        }
    }

    /// <summary>Returns which of the given keys the local table holds a row for, in the journal's text form.</summary>
    /// <remarks>
    /// The lookup is chunked to <see cref="SyncInClause.ChunkSize"/> keys per statement; the list of keys is the
    /// caller's to size, so it is not bounded on its own.
    /// </remarks>
    private async Task<IReadOnlySet<string>> FindLocalKeyTextsAsync(
        IEnumerable<TKey> keys,
        CancellationToken cancellationToken
    )
    {
        var found = new HashSet<string>(StringComparer.Ordinal);

        foreach (var chunk in keys.Chunk(SyncInClause.ChunkSize))
        {
            var existing = await _localSqlExecutor
                .QueryProjectionBySqlAsync<TKey>(
                    LocalExistingKeysSql,
                    new { keys = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);

            foreach (var key in existing)
            {
                found.Add(FormatKey(key));
            }
        }

        return found;
    }

    /// <inheritdoc />
    Task<IReadOnlySet<string>> ISyncTableRunSupport.FindLocalKeyTextsAsync(
        IReadOnlyCollection<string> keyTexts,
        CancellationToken cancellationToken
    ) => FindLocalKeyTextsAsync(keyTexts.Select(ParseKey), cancellationToken);

    /// <summary>Runs the part of one download batch that reads what is unsent and acts on it, under the write lock.</summary>
    /// <remarks>
    /// <para>
    /// When the engine drives the download, what is unsent is read afresh inside the lock, so a local write made since
    /// the run began is seen before the batch can overwrite or skip it. A download called without that (directly, with
    /// a context of its own) acts on the keys it was handed and takes no lock.
    /// </para>
    /// <para>
    /// A row is held back when its own key holds an unsent entry, or when it refers to a parent whose local delete has
    /// not been sent yet. Applying the second kind would fail on the local foreign key: the parent is gone here, and
    /// the server still has it only because the delete has not reached it - typically because the server refused it, a
    /// row like this one having been added there by another device in the meantime.
    /// </para>
    /// </remarks>
    /// <param name="context">The table's download context.</param>
    /// <param name="body">Decides about the batch and applies it, given which rows are held back at that moment and the resolver the batch brings its missing parents in through (null when the engine does not drive the download).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected Task<T> RunBatchSectionAsync<T>(
        SyncDownloadContext context,
        Func<Func<TEntity, (bool Held, string? ParentTableName)>, SyncParentResolver?, Task<T>> body,
        CancellationToken cancellationToken
    )
    {
        if (context.Gate is not { } gate || context.PendingReader is not { } readPending)
        {
            var pendingKeyTexts = context.PendingKeyTexts;

            return body(row => (pendingKeyTexts.Contains(FormatKey(ReadKey(row))), null), null);
        }

        return gate.WriteExclusiveAsync(
            async () =>
            {
                var pending = await readPending(cancellationToken).ConfigureAwait(false);

                return await body(
                        row => HoldOf(row, pending),
                        context.ParentResolverFactory?.Invoke(pending)
                    )
                    .ConfigureAwait(false);
            },
            cancellationToken
        );
    }

    /// <summary>Whether the row is held back from a download batch, and the table of the parent that holds it back when it is a parent (see <see cref="RunBatchSectionAsync"/>).</summary>
    private (bool Held, string? ParentTableName) HoldOf(TEntity row, SyncPendingSnapshot pending)
    {
        if (pending.KeyTexts.Contains(FormatKey(ReadKey(row))))
        {
            return (true, null);
        }

        foreach (var reference in _descriptor.ParentReferences)
        {
            if (
                reference.ReadParentKeyText(row) is { } parentKeyText
                && pending.DeletedKeyTextsByTable.TryGetValue(reference.ParentTableName, out var deleted)
                && deleted.Contains(parentKeyText)
            )
            {
                return (true, reference.ParentTableName);
            }
        }

        return (false, null);
    }

    /// <summary>Applies one ordered batch of server rows to the local database.</summary>
    /// <remarks>
    /// The rows go in as <see cref="ApplyBatchCoreAsync"/> writes them. A row a local save hook skips stops the batch
    /// there, which this method reports by throwing: the rows before it are in, and the row and the ones after it are
    /// not.
    /// </remarks>
    /// <exception cref="InvalidOperationException">A local save hook skipped a row of the batch.</exception>
    protected async Task ApplyBatchAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var skippedAt = await ApplyBatchCoreAsync(rows, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);

        if (skippedAt >= 0)
        {
            throw new InvalidOperationException(
                $"A local save hook skipped the row '{FormatKey(ReadKey(rows[skippedAt]))}' of '{TableName}', so "
                    + "the batch was applied only up to that row."
            );
        }
    }

    /// <summary>
    /// Applies one ordered batch of server rows to the local database and returns the index of the row a local save
    /// hook skipped (-1 when every row went in); that row and the rows after it are not applied.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A table whose local repository runs no save hook for its entity writes the batch with one graph save, which is
    /// one local transaction. A table built with the hooks the repository runs (<see cref="SyncTableBase{TEntity, TKey}"/>'s
    /// <c>localSaveHooks</c>) that has one for its entity writes the rows one at a time instead, each in its own save:
    /// a Before that returns false skips its row, and the rows after it must not go in, or the resume point derived from
    /// the local rows would move past the skipped row and the row would never come down again. The cost is one save,
    /// one transaction, per row.
    /// </para>
    /// <para>
    /// A row a hook skips in a table built without the hooks is found only after the whole batch has gone in, the rows
    /// after it included, so it is reported as an error rather than as a stop.
    /// </para>
    /// <para>
    /// The lookup that decides insert from update is chunked to <see cref="SyncInClause.ChunkSize"/> keys per
    /// statement; the batch size is the caller's to choose, so the list of keys is not bounded on its own.
    /// </para>
    /// <para>
    /// Insert or update is decided afresh on every call, from what the local database holds now. A batch is applied
    /// again after a collision has been resolved, and resolving it can bring in a row of the batch (a parent read back
    /// from the server): left marked as an insert by the attempt that failed, that row would be inserted a second time.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">A local save hook skipped a row of a table built without the hooks.</exception>
    private protected async Task<int> ApplyBatchCoreAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var existingKeys = await FindLocalKeyTextsAsync(rows.Select(ReadKey), cancellationToken)
            .ConfigureAwait(false);

        foreach (var row in rows)
        {
            if (existingKeys.Contains(FormatKey(ReadKey(row))))
            {
                // MarkUpdated leaves an insert as it is, so the state an earlier attempt left is cleared first.
                row.MarkUnchanged();
                row.MarkUpdated();
            }
            else
            {
                row.MarkAdded();
                _descriptor.FillUnsetUnboundedBinaries(row);
            }
        }

        if (_localSaveHooks?.GetInvoker(typeof(TEntity)) is null)
        {
            await WriteRowsAndBlobsAsync(
                    rows,
                    includeUnboundedBinary,
                    async () =>
                    {
                        await SaveAppliedRowsAsync(rows, cancellationToken).ConfigureAwait(false);

                        return true;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);

            var skipped = FindSkippedRow(rows);

            if (skipped >= 0)
            {
                throw new InvalidOperationException(
                    $"A local save hook skipped the row '{FormatKey(ReadKey(rows[skipped]))}' of '{TableName}' "
                        + "while the sync engine applied it, but the table was built without the save hooks the local "
                        + "repository runs, so the rows after it were applied as well and the resume point has moved "
                        + "past it. Build the table with the save hook registry the local repository is given."
                );
            }

            return -1;
        }

        for (var index = 0; index < rows.Count; index++)
        {
            IReadOnlyList<TEntity> row = [rows[index]];
            var written = false;

            await WriteRowsAndBlobsAsync(
                    row,
                    includeUnboundedBinary,
                    async () =>
                    {
                        await SaveAppliedRowsAsync(row, cancellationToken).ConfigureAwait(false);
                        written = FindSkippedRow(row) < 0;

                        return written;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);

            if (!written)
            {
                return index;
            }
        }

        return -1;
    }

    /// <summary>Writes the rows with one graph save of the local repository, without recording them.</summary>
    /// <remarks>
    /// The applied rows are flat, so no cascade is wanted. ForceOverwrite is deliberate: the server's row is the truth
    /// here, and the local engine has no version to guard.
    /// </remarks>
    private async Task SaveAppliedRowsAsync(
        IReadOnlyList<TEntity> rows,
        CancellationToken cancellationToken
    )
    {
        using (SyncSession.Suppress())
        {
            await _local
                .SaveAsync(
                    rows,
                    cascadeSave: false,
                    cascadeDelete: false,
                    insertWhenUpdateMissing: false,
                    ConcurrencyMode.ForceOverwrite,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>The index of the first row a save left in its state - one a save hook skipped - or -1 when there is none.</summary>
    private static int FindSkippedRow(IReadOnlyList<TEntity> rows)
    {
        for (var index = 0; index < rows.Count; index++)
        {
            if (rows[index].RowState != RowState.Unchanged)
            {
                return index;
            }
        }

        return -1;
    }

    /// <inheritdoc />
    /// <remarks>
    /// The rows go through the same batch application a download uses, so a key the local database does not have is
    /// put back rather than skipped - a row deleted locally and still held by the server returns, which is the
    /// server winning over a delete exactly as it wins over an edit. A restored row carries no mirrored version until
    /// a download reaches it in order: it may not have one to keep, and the server's own is the one version that must
    /// not be written here.
    /// </remarks>
    public async Task<IReadOnlyList<SyncAppliedServerRow>> ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(keyTexts);

        var (applied, _, _) = await ApplyServerRowsCoreAsync(
                keyTexts,
                includeUnboundedBinary,
                removeLocalRowsMissingOnServer: false,
                null,
                cancellationToken
            )
            .ConfigureAwait(false);

        return applied;
    }

    /// <inheritdoc />
    Task<(
        IReadOnlyList<SyncAppliedServerRow> Applied,
        IReadOnlyList<string> Held,
        IReadOnlyList<string> Removed
    )> ISyncTableRunSupport.ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        bool removeLocalRowsMissingOnServer,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    ) =>
        ApplyServerRowsCoreAsync(
            keyTexts,
            includeUnboundedBinary,
            removeLocalRowsMissingOnServer,
            resolver,
            cancellationToken
        );

    /// <inheritdoc />
    async Task<bool> ISyncTableRunSupport.CollidesOnServerAsync(
        string keyText,
        CancellationToken cancellationToken
    )
    {
        var local = await _local.GetByIdAsync(ParseKey(keyText), cancellationToken)
            .ConfigureAwait(false);

        return local is not null
            && (
                await _server
                    .Writer.CheckUniquenessAsync(local, cancellationToken)
                    .ConfigureAwait(false)
            ).Count > 0;
    }

    /// <summary>Overwrites the named local rows with the server's copies, bringing in their missing parents through the resolver when there is one.</summary>
    /// <returns>The rows applied, the keys of the rows left alone (a parent that cannot be had, or a unique value another local row holds), and the keys of the local rows removed.</returns>
    private async Task<(
        IReadOnlyList<SyncAppliedServerRow> Applied,
        IReadOnlyList<string> Held,
        IReadOnlyList<string> Removed
    )> ApplyServerRowsCoreAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        bool removeLocalRowsMissingOnServer,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        var rows = new List<TEntity>(keyTexts.Count);
        var applied = new List<SyncAppliedServerRow>(keyTexts.Count);
        var missingOnServer = new Dictionary<string, TKey>(StringComparer.Ordinal);

        foreach (var keyText in keyTexts)
        {
            cancellationToken.ThrowIfCancellationRequested();

            var key = ParseKey(keyText);
            var server = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            if (server is null)
            {
                missingOnServer[keyText] = key;

                continue;
            }

            // Read before it is replaced: this is the version the content about to be applied belongs to, and the
            // only place it survives the write below.
            var serverRowVersion = _descriptor.ReadRowVersion(server);

            // The version has to keep saying how far this device's ordered stream reached, so the local row's own is
            // put back onto the server's copy before it is applied - see the interface for what writing the server's
            // would cost. A row the local database does not have keeps whatever the descriptor makes of "no version",
            // which is the same thing a row created locally starts with.
            var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);
            _descriptor.WriteRowVersion(
                server,
                local is null ? null : _descriptor.ReadRowVersion(local)
            );
            rows.Add(server);
            applied.Add(new SyncAppliedServerRow(keyText, serverRowVersion));
        }

        IReadOnlyList<string> removed = [];

        if (removeLocalRowsMissingOnServer && missingOnServer.Count > 0)
        {
            // A row the server does not have is removed before the server's rows go in, rather than left to the delete
            // propagation later in the run: a row recreated here under another key with the unique value the server's
            // row holds would otherwise refuse that row.
            var present = await FindLocalKeyTextsAsync(missingOnServer.Values, cancellationToken)
                .ConfigureAwait(false);
            removed = await DeleteUnreferencedAsync(
                    missingOnServer
                        .Where(pair => present.Contains(pair.Key))
                        .ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal),
                    cancellationToken
                )
                .ConfigureAwait(false);
        }

        var held = new List<string>();
        var blocked = await FindRowsMissingParentsAsync(
                rows,
                resolver,
                cancellationToken,
                inAnyOrder: true
            )
            .ConfigureAwait(false);

        if (blocked.Count > 0)
        {
            // Left as they are: a row whose parent the run may not bring in - its table is outside the run, or it has a
            // local delete the run is not discarding - would fail on the local foreign key, or undo that delete.
            held.AddRange(blocked.Keys.Select(index => applied[index].KeyText));
            rows = rows.Where((_, index) => !blocked.ContainsKey(index)).ToList();
            applied = applied.Where((_, index) => !blocked.ContainsKey(index)).ToList();
        }

        if (rows.Count == 0)
        {
            return (applied, held, removed);
        }

        // Applied together, so the order within the batch is free: parents go first, or the local foreign key refuses
        // a child whose parent comes later in the list. A row whose unique value another local row still holds is left
        // as it is, like a row whose parent cannot be had.
        //
        // A row a local save hook skips is left as it is as well, and so are the rows after it: the rows go in parents
        // first, so a row after it may be its child.
        var ordered = ParentsFirst(rows);
        var (colliding, skippedAt) = await ApplyBatchOrFindCollisionsAsync(
                ordered,
                includeUnboundedBinary,
                stopAtFirst: false,
                resolver,
                cancellationToken
            )
            .ConfigureAwait(false);
        var leftOut = skippedAt >= 0
            ? colliding.Concat(Enumerable.Range(skippedAt, ordered.Count - skippedAt)).ToList()
            : colliding;

        if (leftOut.Count > 0)
        {
            var leftOutKeys = leftOut
                .Select(index => FormatKey(ReadKey(ordered[index])))
                .ToHashSet(StringComparer.Ordinal);
            held.AddRange(leftOutKeys);
            applied = applied.Where(row => !leftOutKeys.Contains(row.KeyText)).ToList();
        }

        // Reported only once the batch is in: a row whose application never committed is not one anything should be
        // recorded about.
        return (applied, held, removed);
    }

    /// <summary>
    /// Applies the rows as one batch; when that fails, finds the rows whose unique values another local row holds and
    /// applies the others, returning the indexes of the ones left out.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Asked only after the batch has failed, so a batch that goes in makes no extra call. The batch is one local
    /// transaction, so nothing of it is in when the rows are looked at. A row is checked against what the local database
    /// holds, with the repository's own uniqueness check; a failure no row explains is thrown as it was.
    /// </para>
    /// <para>
    /// A server row collides with a local one when the local database still holds a value the server has moved on from:
    /// a row the server deleted and recreated under another key with the same unique value, while the old row is still
    /// here - unsent, referred to, or with the delete propagation turned off. Two rows of the same batch that swapped
    /// their values collide as well, since SQLite checks a unique constraint statement by statement; that one does not
    /// go away by itself (see the known limitations in the documentation).
    /// </para>
    /// </remarks>
    /// <param name="rows">The rows, in the order they are applied.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="stopAtFirst">Whether only the rows before the first collision are applied (an ordered download), rather than every row that does not collide.</param>
    /// <param name="resolver">Brings the local rows holding the values up to date when it may (null: a collision is only looked at, not resolved).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The indexes of the rows left out for a unique value, and the index of the row a local save hook skipped (-1 when none did); that row and the rows after it are not in.</returns>
    /// <remarks>
    /// With a resolver, a collision is resolved before it is given up on: the local rows holding the colliding row's
    /// unique values are found (<see cref="SyncTableDescriptor{TEntity, TKey}.LocalUniqueLookups"/>) and brought up to
    /// date from the server, and the batch is tried again (see <see cref="TryResolveCollisionAsync"/>). The batch is
    /// tried at most as many times as it has rows; each try that does not end the loop has resolved a collision.
    /// </remarks>
    private protected async Task<(IReadOnlyList<int> Colliding, int SkippedAt)> ApplyBatchOrFindCollisionsAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        bool stopAtFirst,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        for (var attempt = 0; ; attempt++)
        {
            var (colliding, skippedAt) = await TryApplyBatchAsync(
                    rows,
                    includeUnboundedBinary,
                    stopAtFirst,
                    applyRest: false,
                    cancellationToken
                )
                .ConfigureAwait(false);

            if (colliding.Count == 0)
            {
                return ([], skippedAt);
            }

            if (resolver is not null && attempt < rows.Count)
            {
                var resolved = false;

                foreach (var index in colliding)
                {
                    resolved |= await TryResolveCollisionAsync(rows, index, resolver, cancellationToken)
                        .ConfigureAwait(false);
                }

                if (resolved)
                {
                    continue;
                }
            }

            return await TryApplyBatchAsync(
                    rows,
                    includeUnboundedBinary,
                    stopAtFirst,
                    applyRest: true,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Finds the local rows holding the row's unique values and, unless that would overwrite an unsent change or the
    /// server still gives them the same value, brings them up to date from the server; returns whether it did.
    /// </summary>
    /// <remarks>
    /// A holder with an unsent change the run is not discarding is left alone - bringing it forward would drop the
    /// change without saying so - and so is a holder whose server copy still holds the value (two rows that swapped
    /// their values, or data the server itself holds twice): the collision stays, and the caller stops at the row.
    /// </remarks>
    /// <param name="rows">The batch the colliding row belongs to.</param>
    /// <param name="index">The colliding row's index in the batch.</param>
    /// <param name="resolver">Brings the local rows holding the values up to date.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<bool> TryResolveCollisionAsync(
        IReadOnlyList<TEntity> rows,
        int index,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    )
    {
        var row = rows[index];
        var rowKeyText = FormatKey(ReadKey(row));
        var holders = new Dictionary<string, TKey>(StringComparer.Ordinal);

        foreach (var lookup in _descriptor.LocalUniqueLookups)
        {
            var values = lookup.ReadValues(row);

            if (values.Any(value => value is null))
            {
                continue;
            }

            var keys = await _localSqlExecutor
                .QueryProjectionBySqlAsync<TKey>(lookup.Sql, new { values }, cancellationToken)
                .ConfigureAwait(false);

            foreach (var key in keys)
            {
                var keyText = FormatKey(key);

                if (!string.Equals(keyText, rowKeyText, StringComparison.Ordinal))
                {
                    holders[keyText] = key;
                }
            }
        }

        if (holders.Count == 0)
        {
            return false;
        }

        var missingOnServer = new HashSet<string>(StringComparer.Ordinal);

        foreach (var (keyText, key) in holders)
        {
            if (resolver.HoldsUnsentChange(TableName, keyText))
            {
                return false;
            }

            var server = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            if (server is null)
            {
                missingOnServer.Add(keyText);
            }

            if (
                server is not null
                && _descriptor.LocalUniqueLookups.Any(lookup =>
                    lookup.ReadValues(row) is var wanted
                    && wanted.All(value => value is not null)
                    && SameUniqueValues(lookup.ReadValues(server), wanted)
                )
            )
            {
                return false;
            }
        }

        if (
            await resolver
                .BringHoldersUpToDateAsync(TableName, holders.Keys.ToList(), cancellationToken)
                .ConfigureAwait(false)
        )
        {
            return true;
        }

        if (!resolver.PropagatesDeletes || missingOnServer.Count == 0)
        {
            return false;
        }

        // A holder the server no longer has stays while a local row refers to it, and the rows referring to it can be the
        // very row waiting for its value and others of the same batch: rows the server moved under another parent, one
        // of which it gave the holder's value. The moves go in first, with the rows' own unique values, and the holder
        // can then go. When it still cannot - something else refers to it - the rows are put back as they were, so no
        // mixture of the two copies outlives this.
        if (
            await MoveOffHoldersAsync(rows, index, missingOnServer, cancellationToken)
                .ConfigureAwait(false)
            is { } originals
        )
        {
            if (
                await resolver
                    .BringHoldersUpToDateAsync(TableName, holders.Keys.ToList(), cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                return true;
            }

            await PutBackAsync(originals, cancellationToken).ConfigureAwait(false);
        }

        // The rows keeping the holder can also be rows whose server copies sit below the waiting row, in this table or
        // another: they cannot go in first, since their parent is the row waiting. When none of them has anything to send
        // they are removed, the holder goes, and their server copies come back with the download (see
        // SyncParentResolver.RemoveRowsKeepingHoldersAsync).
        return await resolver
                .RemoveRowsKeepingHoldersAsync(TableName, missingOnServer, cancellationToken)
                .ConfigureAwait(false)
            && await resolver
                .BringHoldersUpToDateAsync(TableName, holders.Keys.ToList(), cancellationToken)
                .ConfigureAwait(false);
    }

    /// <summary>
    /// Writes the server's copies of the waiting row and of the other rows of its batch that refer to one of the given
    /// holders locally and no longer do on the server, each with its local unique values; returns the local rows as they
    /// were before, or null when the waiting row is not such a row or one of them does not go in.
    /// </summary>
    /// <remarks>
    /// What the server rows bring besides their unique values - a new parent above all - goes in, and the rows no
    /// longer keep the holder. The mirrored versions are the local rows' own, so the rows are still due for the
    /// server's versions, which the batch applies once the holder is gone. Whenever it answers null - a row that does
    /// not go in, or the waiting row turning out not to be such a row once rows before it are in - the rows written
    /// before are put back first. With <see cref="SyncTableDescriptor{TEntity, TKey}.CopyUniqueValues"/> unset, it
    /// writes nothing and answers null.
    /// </remarks>
    /// <param name="rows">The batch.</param>
    /// <param name="index">The index of the row waiting for a unique value a holder has.</param>
    /// <param name="holders">The keys of the holders the server no longer has.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<List<TEntity>?> MoveOffHoldersAsync(
        IReadOnlyList<TEntity> rows,
        int index,
        IReadOnlySet<string> holders,
        CancellationToken cancellationToken
    )
    {
        if (
            _descriptor.LocalUniqueLookups.Count == 0
            || _descriptor.CopyUniqueValues is not { } copyUniqueValues
        )
        {
            return null;
        }

        var originals = new List<TEntity>();

        for (var position = 0; position < rows.Count; position++)
        {
            var row = rows[position];

            if (RefersTo(row, holders))
            {
                if (position == index)
                {
                    await PutBackAsync(originals, cancellationToken).ConfigureAwait(false);

                    return null;
                }

                continue;
            }

            var local = await _local.GetByIdAsync(ReadKey(row), cancellationToken).ConfigureAwait(false);

            if (local is null || !RefersTo(local, holders))
            {
                if (position == index)
                {
                    await PutBackAsync(originals, cancellationToken).ConfigureAwait(false);

                    return null;
                }

                continue;
            }

            var staged = (TEntity)row.Clone();
            copyUniqueValues(local, staged);
            _descriptor.WriteRowVersion(staged, _descriptor.ReadRowVersion(local));

            if (!await StageAsync(staged, null, cancellationToken).ConfigureAwait(false))
            {
                await PutBackAsync(originals, cancellationToken).ConfigureAwait(false);

                return null;
            }

            originals.Add(local);
        }

        return originals;

        bool RefersTo(TEntity entity, IReadOnlySet<string> keyTexts) =>
            ReadParents(entity)
                .Any(parent =>
                    string.Equals(parent.TableName, TableName, StringComparison.Ordinal)
                    && keyTexts.Contains(parent.KeyText)
                );
    }

    /// <summary>
    /// Whether two reads of one unique constraint's values (<see cref="SyncUniqueLookup{TEntity}.ReadValues"/>) are the
    /// same values: compared element by element, and a binary value by its bytes, as the database compares them.
    /// </summary>
    private static bool SameUniqueValues(object?[] left, object?[] right) =>
        System.Collections.StructuralComparisons.StructuralEqualityComparer.Equals(left, right);

    /// <summary>Writes staged rows back as they were, the last one first.</summary>
    /// <remarks>
    /// A row that does not go back would keep the mixture of its server copy and its local unique values, and a later
    /// upload would send that mixture as the device's own change. The run is stopped instead, once every row that can go
    /// back has, naming the rows that could not.
    /// </remarks>
    /// <exception cref="InvalidOperationException">A row could not be written back as it was.</exception>
    private async Task PutBackAsync(List<TEntity> originals, CancellationToken cancellationToken)
    {
        var notPutBack = new List<string>();

        for (var position = originals.Count - 1; position >= 0; position--)
        {
            if (!await StageAsync(originals[position], null, cancellationToken).ConfigureAwait(false))
            {
                notPutBack.Add(FormatKey(ReadKey(originals[position])));
            }
        }

        if (notPutBack.Count > 0)
        {
            throw new InvalidOperationException(
                $"The local rows of '{TableName}' with the keys {string.Join(", ", notPutBack)} could not be written "
                    + "back as they were after being staged for a unique value, and hold their server copies with "
                    + "their local unique values. The sync stopped so that this mixture is not uploaded."
            );
        }
    }

    /// <inheritdoc />
    async Task<bool> ISyncTableRunSupport.ReleaseUniqueValuesAsync(
        string keyText,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    )
    {
        if (
            _descriptor.LocalUniqueLookups.Count == 0
            || _descriptor.CopyUniqueValues is not { } copyUniqueValues
        )
        {
            return false;
        }

        var key = ParseKey(keyText);
        var server = await _server.Writer.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);

        if (server is null)
        {
            return false;
        }

        // Only a row that waits for nothing but a row further up the way: that row is what goes in once the values are
        // given up, and the holder after it. A row held for any other reason may stay held, and would keep the mixture.
        var missingParents = await resolver
            .EnsureAsync(ReadParents(server), cancellationToken)
            .ConfigureAwait(false);

        if (
            missingParents.Count == 0
            || !missingParents.All(parent => resolver.IsInProgress(parent.TableName, parent.KeyText))
        )
        {
            return false;
        }

        var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);

        if (
            local is null
            || _descriptor.LocalUniqueLookups.All(lookup =>
                SameUniqueValues(lookup.ReadValues(server), lookup.ReadValues(local))
            )
        )
        {
            return false;
        }

        copyUniqueValues(server, local);

        return await StageAsync(local, resolver, cancellationToken).ConfigureAwait(false);
    }

    /// <inheritdoc />
    /// <remarks>
    /// The table's local rows are read whole and their parents looked at: it is asked only after a holder could not be
    /// removed, so it costs nothing on a run where nothing collides.
    /// </remarks>
    async Task<IReadOnlyList<(string KeyText, string ParentKeyText)>> ISyncTableRunSupport.FindLocalRowsReferringAsync(
        string parentTableName,
        IReadOnlySet<string> parentKeyTexts,
        CancellationToken cancellationToken
    )
    {
        if (
            !_descriptor.ParentReferences.Any(reference =>
                string.Equals(reference.ParentTableName, parentTableName, StringComparison.Ordinal)
            )
        )
        {
            return [];
        }

        var referring = new List<(string KeyText, string ParentKeyText)>();

        foreach (var row in await _local.GetAllAsync(cancellationToken).ConfigureAwait(false))
        {
            foreach (var parent in ReadParents(row))
            {
                if (
                    string.Equals(parent.TableName, parentTableName, StringComparison.Ordinal)
                    && parentKeyTexts.Contains(parent.KeyText)
                )
                {
                    referring.Add((FormatKey(ReadKey(row)), parent.KeyText));
                }
            }
        }

        return referring;
    }

    /// <inheritdoc />
    async Task<bool> ISyncTableRunSupport.IsReferencedOutsideAsync(
        IReadOnlySet<string> keyTexts,
        IReadOnlySet<string> insideTableNames,
        CancellationToken cancellationToken
    )
    {
        var listed = _descriptor
            .LocalReferences.Where(reference => !insideTableNames.Contains(reference.TableName))
            .ToList();
        var unlisted = _descriptor
            .UnlistedReferencingTableNames.Where(name => !insideTableNames.Contains(name))
            .ToList();

        if (listed.Count == 0 && unlisted.Count == 0)
        {
            return false;
        }

        var present = await ReadLocalTableNamesAsync(cancellationToken).ConfigureAwait(false);

        if (unlisted.Any(present.Contains))
        {
            return true;
        }

        listed = listed.Where(reference => present.Contains(reference.TableName)).ToList();

        return listed.Count > 0
            && (
                await FindLocallyReferencedKeyTextsAsync(
                        listed,
                        keyTexts.Select(ParseKey).ToList(),
                        cancellationToken
                    )
                    .ConfigureAwait(false)
            ).Count > 0;
    }

    /// <inheritdoc />
    async Task<IReadOnlyList<string>> ISyncTableRunSupport.FindRowsNotBroughtBackAsync(
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        if (IsVersionless || keyTexts.Count == 0)
        {
            return [];
        }

        // The resume point the download derives once the rows are gone: the highest mirrored version among the rows left.
        var removing = keyTexts.ToHashSet(StringComparer.Ordinal);
        byte[]? anchor = null;

        foreach (var row in await _local.GetAllAsync(cancellationToken).ConfigureAwait(false))
        {
            if (!removing.Contains(FormatKey(ReadKey(row))))
            {
                anchor = SyncRowVersions.Max(anchor, _descriptor.ReadRowVersion(row));
            }
        }

        var passed = new List<string>();

        foreach (var keyText in keyTexts)
        {
            var server = await _server
                .Writer.GetByIdAsync(ParseKey(keyText), cancellationToken)
                .ConfigureAwait(false);

            if (server is not null && !SyncRowVersions.IsPast(_descriptor.ReadRowVersion(server), anchor))
            {
                passed.Add(keyText);
            }
        }

        return passed;
    }

    /// <inheritdoc />
    async Task<IReadOnlyList<string>> ISyncTableRunSupport.RemoveLocalRowsAsync(
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        var removed = new List<string>();

        using (SyncSession.Suppress())
        {
            foreach (var keyText in keyTexts)
            {
                if (await _local.DeleteAsync(ParseKey(keyText), cancellationToken).ConfigureAwait(false))
                {
                    removed.Add(keyText);
                }
            }
        }

        return removed;
    }

    /// <summary>Writes a row staged on the way to its server copy; returns whether it went in.</summary>
    /// <remarks>
    /// The row is written without its unbounded binary columns. A row that collides with yet another local row is
    /// resolved through the resolver when there is one; a failure leaves nothing behind, since the write is one local
    /// transaction, and is answered with false: the caller is left with the collision it had.
    /// </remarks>
    private async Task<bool> StageAsync(
        TEntity staged,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        try
        {
            var (colliding, skippedAt) = await ApplyBatchOrFindCollisionsAsync(
                    [staged],
                    includeUnboundedBinary: false,
                    stopAtFirst: true,
                    resolver,
                    cancellationToken
                )
                .ConfigureAwait(false);

            return colliding.Count == 0 && skippedAt < 0;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            return false;
        }
    }

    /// <summary>
    /// Applies the rows as one batch; when that fails, finds the rows whose unique values another local row holds and,
    /// with <paramref name="applyRest"/>, applies the others. Returns the indexes of the rows left out for a unique value,
    /// and the index of the row a local save hook skipped (-1 when none did; that row and the rows after it are not in).
    /// </summary>
    /// <remarks>
    /// Applying every row that does not collide leaves out, with a row left out that the local database does not hold,
    /// the rows of the batch below it in this table (see <see cref="WithRowsBelowAbsentAsync"/>): written without it,
    /// they would fail on the local foreign key and take the whole application down with them.
    /// </remarks>
    private async Task<(IReadOnlyList<int> Colliding, int SkippedAt)> TryApplyBatchAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        bool stopAtFirst,
        bool applyRest,
        CancellationToken cancellationToken
    )
    {
        try
        {
            var skippedAt = await ApplyBatchCoreAsync(rows, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false);

            return ([], skippedAt);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            var colliding = new List<int>();

            try
            {
                for (var index = 0; index < rows.Count; index++)
                {
                    var violations = await _local
                        .CheckUniquenessAsync(rows[index], cancellationToken)
                        .ConfigureAwait(false);

                    if (violations.Count > 0)
                    {
                        colliding.Add(index);

                        if (stopAtFirst)
                        {
                            break;
                        }
                    }
                }
            }
            catch (Exception lookup) when (lookup is not OperationCanceledException)
            {
                colliding.Clear();
            }

            if (colliding.Count == 0)
            {
                System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(exception).Throw();
            }

            if (!applyRest)
            {
                return (colliding, -1);
            }

            if (!stopAtFirst)
            {
                colliding = await WithRowsBelowAbsentAsync(rows, colliding, cancellationToken)
                    .ConfigureAwait(false);
            }

            var restAt = stopAtFirst
                ? Enumerable.Range(0, colliding[0]).ToList()
                : Enumerable.Range(0, rows.Count).Where(index => !colliding.Contains(index)).ToList();
            var restSkippedAt = -1;

            if (restAt.Count > 0)
            {
                restSkippedAt = await ApplyBatchCoreAsync(
                        restAt.Select(index => rows[index]).ToList(),
                        includeUnboundedBinary,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            return (colliding, restSkippedAt >= 0 ? restAt[restSkippedAt] : -1);
        }
    }

    /// <summary>
    /// Adds to the rows left out the rows of the batch that refer, in this table and as far as it reaches, to a row left
    /// out that the local database does not hold; returns the indexes in ascending order.
    /// </summary>
    /// <remarks>
    /// A row left out that the local database already holds stays where it is, so the rows below it still have their
    /// parent and go in. One the local database does not hold - a row the server puts back after a local delete - is
    /// not there for them to refer to. A row of another table that refers to it is held back by its own application,
    /// which finds the parent missing.
    /// </remarks>
    private async Task<List<int>> WithRowsBelowAbsentAsync(
        IReadOnlyList<TEntity> rows,
        List<int> leftOut,
        CancellationToken cancellationToken
    )
    {
        if (_descriptor.ParentReferences.Count == 0)
        {
            return leftOut;
        }

        var present = await FindLocalKeyTextsAsync(rows.Select(ReadKey), cancellationToken)
            .ConfigureAwait(false);
        var result = leftOut.ToHashSet();
        var absent = leftOut
            .Select(index => FormatKey(ReadKey(rows[index])))
            .Where(keyText => !present.Contains(keyText))
            .ToHashSet(StringComparer.Ordinal);

        for (var changed = absent.Count > 0; changed; )
        {
            changed = false;

            for (var index = 0; index < rows.Count; index++)
            {
                if (
                    result.Contains(index)
                    || !ReadParents(rows[index])
                        .Any(parent =>
                            string.Equals(parent.TableName, TableName, StringComparison.Ordinal)
                            && absent.Contains(parent.KeyText)
                        )
                )
                {
                    continue;
                }

                result.Add(index);
                changed = true;

                if (FormatKey(ReadKey(rows[index])) is var keyText && !present.Contains(keyText))
                {
                    absent.Add(keyText);
                }
            }
        }

        return result.Order().ToList();
    }

    /// <inheritdoc />
    public async Task<IReadOnlyList<string>> PropagateDeletesAsync(
        IReadOnlySet<string> pendingKeyTexts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(pendingKeyTexts);

        var serverKeyTexts = await ReadServerKeyTextsAsync(cancellationToken).ConfigureAwait(false);
        var outcome = await DeleteRowsMissingOnServerAsync(
                serverKeyTexts,
                _ => Task.FromResult(pendingKeyTexts),
                new HashSet<string>(StringComparer.Ordinal),
                cancellationToken
            )
            .ConfigureAwait(false);

        return outcome.Removed;
    }

    /// <inheritdoc />
    /// <remarks>
    /// The server's key set is read first and outside the lock - it is the slow half, and nothing local depends on it.
    /// The local key set and the unsent keys are then read under the write lock, in that order, and the rows are deleted
    /// before it is given back. The order is what makes it safe to keep writing during a run: a row created after the
    /// local keys were read is not among the candidates at all, and a row created before was journaled before it was
    /// written, so its entry is already there when the unsent keys are read after.
    /// </remarks>
    async Task<SyncPropagationOutcome> ISyncTableRunSupport.PropagateDeletesAsync(
        SyncLocalGate gate,
        Func<CancellationToken, Task<IReadOnlySet<string>>> readPendingKeyTexts,
        IReadOnlySet<string> keptByChildren,
        CancellationToken cancellationToken
    )
    {
        var serverKeyTexts = await ReadServerKeyTextsAsync(cancellationToken).ConfigureAwait(false);

        return await gate.WriteExclusiveAsync(
                () =>
                    DeleteRowsMissingOnServerAsync(
                        serverKeyTexts,
                        readPendingKeyTexts,
                        keptByChildren,
                        cancellationToken
                    ),
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <inheritdoc />
    bool ISyncTableRunSupport.IsReferenced => _descriptor.ReferencingTableNames.Count > 0;

    /// <inheritdoc />
    ISqlExecutor ISyncTableRunSupport.LocalSqlExecutor => _localSqlExecutor;

    /// <inheritdoc />
    string ISyncTableRunSupport.LocalDeleteAllSql => _descriptor.LocalDeleteAllSql;

    /// <inheritdoc />
    IReadOnlyList<string> ISyncTableRunSupport.ReferencingTableNames => _descriptor.ReferencingTableNames;

    /// <inheritdoc />
    IReadOnlyList<string> ISyncTableRunSupport.UnlistedReferencingTableNames =>
        _descriptor.UnlistedReferencingTableNames;

    /// <inheritdoc />
    /// <remarks>
    /// Every row the server holds for this table is read, a batch at a time, until one refers to the parent. It is asked
    /// only after a delete has failed, so a run where nothing goes wrong reads nothing.
    /// </remarks>
    async Task<bool> ISyncTableRunSupport.HasServerRowReferringToAsync(
        string parentTableName,
        string parentKeyText,
        int batchSize,
        CancellationToken cancellationToken
    )
    {
        var found = false;

        await ScanServerRowsAsync(
                batchSize,
                rows =>
                {
                    found = rows.Any(row =>
                        ReadParents(row)
                            .Any(parent =>
                                string.Equals(parent.TableName, parentTableName, StringComparison.Ordinal)
                                && string.Equals(parent.KeyText, parentKeyText, StringComparison.Ordinal)
                            )
                    );

                    return !found;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        return found;
    }

    /// <summary>Reads every row the server holds for this table, a batch at a time.</summary>
    /// <param name="batchSize">How many rows one read fetches.</param>
    /// <param name="onBatch">Looks at one batch, returning whether the scan goes on.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected abstract Task ScanServerRowsAsync(
        int batchSize,
        Func<IReadOnlyList<TEntity>, bool> onBatch,
        CancellationToken cancellationToken
    );

    /// <inheritdoc />
    Func<string, string>? ISyncTableRunSupport.NormalizeKeyText => _descriptor.NormalizeKeyText;

    /// <inheritdoc />
    async Task<(object? LocalRow, IReadOnlyList<(string TableName, string KeyText)> Parents)> ISyncTableRunSupport.ReadLocalParentsAsync(
        string keyText,
        CancellationToken cancellationToken
    )
    {
        var local = await _local.GetByIdAsync(ParseKey(keyText), cancellationToken)
            .ConfigureAwait(false);

        return (local, local is null ? [] : ReadParents(local));
    }

    /// <inheritdoc />
    async Task<object?> ISyncTableRunSupport.ReadServerRowAsync(
        string keyText,
        CancellationToken cancellationToken
    ) =>
        await _server
            .Writer.GetByIdAsync(ParseKey(keyText), cancellationToken)
            .ConfigureAwait(false);

    /// <summary>The parents the row refers to, by table name and key text (a NULL foreign key refers to none).</summary>
    private List<(string TableName, string KeyText)> ReadParents(TEntity row)
    {
        var parents = new List<(string TableName, string KeyText)>();

        foreach (var reference in _descriptor.ParentReferences)
        {
            if (reference.ReadParentKeyText(row) is { } parentKeyText)
            {
                parents.Add((reference.ParentTableName, parentKeyText));
            }
        }

        return parents;
    }

    /// <summary>Reads every key the server holds for this table, in the journal's text form.</summary>
    private async Task<HashSet<string>> ReadServerKeyTextsAsync(CancellationToken cancellationToken)
    {
        var serverKeys = await _server.GetAllKeysAsync(cancellationToken).ConfigureAwait(false);

        return serverKeys.Select(FormatKey).ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>
    /// Deletes the local rows whose key is not in the server's set and that no local row refers to, sparing the keys that
    /// are still unsent (read after the local keys), the keys kept rows of child tables refer to, and the parents of every
    /// row so spared.
    /// </summary>
    /// <remarks>
    /// <para>
    /// An unsent journal entry outranks the server's key set: the row is the subject of a local intention this run has
    /// not settled, and removing it here would settle it silently against the local side. A row kept that way keeps
    /// what it refers to (see <see cref="SyncKeptRows.CloseAsync"/>).
    /// </para>
    /// <para>
    /// A row is only removed when nothing local refers to it, and the removal is repeated until a pass removes nothing.
    /// The rows that refer to a candidate can be anywhere: a row of the same table (a child within a self-referencing
    /// table, removed in an earlier pass when the server dropped it as well), an unsent row, a row a truncated download
    /// has not brought up to date yet, or a row of a table outside this run's scope. Removing the parent of any of them
    /// fails on the local foreign key, or - under <c>ON DELETE CASCADE</c> - takes the row with it; a parent kept this
    /// way goes on a later run, once nothing refers to it any more.
    /// </para>
    /// </remarks>
    private async Task<SyncPropagationOutcome> DeleteRowsMissingOnServerAsync(
        HashSet<string> serverKeyTexts,
        Func<CancellationToken, Task<IReadOnlySet<string>>> readPendingKeyTexts,
        IReadOnlySet<string> keptByChildren,
        CancellationToken cancellationToken
    )
    {
        var localKeys = await _localSqlExecutor
            .QueryProjectionBySqlAsync<TKey>(LocalKeysSql, null, cancellationToken)
            .ConfigureAwait(false);
        var pendingKeyTexts = await readPendingKeyTexts(cancellationToken).ConfigureAwait(false);
        var candidates = new Dictionary<string, TKey>(StringComparer.Ordinal);

        foreach (var key in localKeys)
        {
            var keyText = FormatKey(key);

            if (!serverKeyTexts.Contains(keyText))
            {
                candidates[keyText] = key;
            }
        }

        var candidateKeyTexts = candidates.Keys.ToHashSet(StringComparer.Ordinal);
        var (kept, keptParents) = await SyncKeptRows
            .CloseAsync(
                TableName,
                candidateKeyTexts.Where(keyText =>
                    pendingKeyTexts.Contains(keyText) || keptByChildren.Contains(keyText)
                ),
                candidateKeyTexts,
                async keyText =>
                    _descriptor.ParentReferences.Count == 0
                    || await _local
                        .GetByIdAsync(candidates[keyText], cancellationToken)
                        .ConfigureAwait(false)
                        is not { } row
                        ? []
                        : ReadParents(row)
            )
            .ConfigureAwait(false);
        var remaining = candidates
            .Where(pair => !kept.Contains(pair.Key))
            .ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
        var removed = await DeleteUnreferencedAsync(remaining, cancellationToken)
            .ConfigureAwait(false);

        return new SyncPropagationOutcome(removed, keptParents);
    }

    /// <summary>Deletes the given local rows that nothing local refers to, repeating until a pass removes nothing, and returns the keys that went.</summary>
    private async Task<IReadOnlyList<string>> DeleteUnreferencedAsync(
        Dictionary<string, TKey> remaining,
        CancellationToken cancellationToken
    )
    {
        var removed = new List<string>();
        var references = remaining.Count == 0
            ? []
            : await ReadPresentLocalReferencesAsync(cancellationToken).ConfigureAwait(false);

        using (SyncSession.Suppress())
        {
            while (remaining.Count > 0)
            {
                var referenced = await FindLocallyReferencedKeyTextsAsync(
                        references,
                        remaining.Values,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
                var removable = remaining.Where(pair => !referenced.Contains(pair.Key)).ToList();

                if (removable.Count == 0)
                {
                    break;
                }

                foreach (var (keyText, key) in removable)
                {
                    remaining.Remove(keyText);

                    if (await _local.DeleteAsync(key, cancellationToken).ConfigureAwait(false))
                    {
                        removed.Add(keyText);
                    }
                }
            }
        }

        return removed;
    }

    /// <summary>The descriptor's <see cref="SyncTableDescriptor{TEntity, TKey}.LocalReferences"/> whose referring table the local database has.</summary>
    /// <remarks>
    /// The local database is not required to hold every table of the diagram - one built from the synchronised tables
    /// alone has always worked - and asking a table it does not have fails the statement. Such a table holds no rows to
    /// refer with, so leaving it out changes nothing about which rows are referred to. The table list is read once per
    /// propagation of this table.
    /// </remarks>
    private async Task<IReadOnlyList<SyncLocalReference>> ReadPresentLocalReferencesAsync(
        CancellationToken cancellationToken
    )
    {
        if (_descriptor.LocalReferences.Count == 0)
        {
            return [];
        }

        var present = await ReadLocalTableNamesAsync(cancellationToken).ConfigureAwait(false);

        return _descriptor.LocalReferences.Where(reference => present.Contains(reference.TableName)).ToList();
    }

    /// <summary>The names of the tables the local database has.</summary>
    private async Task<HashSet<string>> ReadLocalTableNamesAsync(CancellationToken cancellationToken)
    {
        var tables = await _localSqlExecutor
            .QueryProjectionBySqlAsync<string>(
                "SELECT name FROM sqlite_master WHERE type = 'table'",
                null,
                cancellationToken
            )
            .ConfigureAwait(false);

        return tables.ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    /// <inheritdoc />
    /// <remarks>
    /// A table outside the scope is asked through <see cref="SyncTableDescriptor{TEntity, TKey}.LocalReferences"/>,
    /// with every local key of this table - the refresh is about to delete them all - in chunks. A table the local
    /// database does not have is skipped, as in the delete propagation. A table that refers to this one only through a
    /// foreign key those references do not list (<see cref="SyncTableDescriptor{TEntity, TKey}.UnlistedReferencingTableNames"/>)
    /// cannot be asked, so it counts whenever the local database has it.
    /// </remarks>
    async Task<IReadOnlyList<string>> ISyncTableRunSupport.FindReferencesFromOutsideAsync(
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    )
    {
        var listed = _descriptor
            .LocalReferences.Where(reference => !scopeTableNames.Contains(reference.TableName))
            .ToList();
        var unlisted = _descriptor
            .UnlistedReferencingTableNames.Where(name => !scopeTableNames.Contains(name))
            .ToList();

        if (listed.Count == 0 && unlisted.Count == 0)
        {
            return [];
        }

        var present = await ReadLocalTableNamesAsync(cancellationToken).ConfigureAwait(false);
        var referring = unlisted.Where(present.Contains).Distinct(StringComparer.Ordinal).ToList();
        listed = listed
            .Where(reference =>
                present.Contains(reference.TableName)
                && !referring.Contains(reference.TableName, StringComparer.Ordinal)
            )
            .ToList();

        if (listed.Count == 0)
        {
            return referring;
        }

        var localKeys = await _localSqlExecutor
            .QueryProjectionBySqlAsync<TKey>(LocalKeysSql, null, cancellationToken)
            .ConfigureAwait(false);

        foreach (var reference in listed)
        {
            if (referring.Contains(reference.TableName, StringComparer.Ordinal))
            {
                continue;
            }

            var referenced = await FindLocallyReferencedKeyTextsAsync(
                    [reference],
                    localKeys,
                    cancellationToken
                )
                .ConfigureAwait(false);

            if (referenced.Count > 0)
            {
                referring.Add(reference.TableName);
            }
        }

        return referring;
    }

    /// <summary>Returns which of the given keys a local row refers to, through the given foreign keys.</summary>
    /// <remarks>The keys are bound in chunks of <see cref="SyncInClause.ChunkSize"/>, one round trip per chunk and referencing foreign key.</remarks>
    private async Task<HashSet<string>> FindLocallyReferencedKeyTextsAsync(
        IReadOnlyList<SyncLocalReference> references,
        IEnumerable<TKey> keys,
        CancellationToken cancellationToken
    )
    {
        var referenced = new HashSet<string>(StringComparer.Ordinal);

        if (references.Count == 0)
        {
            return referenced;
        }

        foreach (var chunk in keys.Chunk(SyncInClause.ChunkSize))
        {
            foreach (var reference in references)
            {
                var found = await _localSqlExecutor
                    .QueryProjectionBySqlAsync<TKey>(
                        reference.Sql,
                        new { keys = chunk },
                        cancellationToken
                    )
                    .ConfigureAwait(false);

                foreach (var key in found)
                {
                    referenced.Add(FormatKey(key));
                }
            }
        }

        return referenced;
    }

    /// <inheritdoc />
    /// <remarks>
    /// Raw SQL is never journaled, so the suppression here is not what keeps this write out of the journal. It is
    /// there because a refresh is one engine-driven write from beginning to end, and a table whose local repository
    /// happens to be reached some other way inside it should be treated the same as the rest.
    /// </remarks>
    public async Task<int> DeleteAllLocalAsync(CancellationToken cancellationToken = default)
    {
        using (SyncSession.Suppress())
        {
            return await _localSqlExecutor
                .ExecuteSqlAsync(LocalDeleteAllSql, null, cancellationToken)
                .ConfigureAwait(false);
        }
    }
}

/// <summary>
/// The fixed half of one synchronised table that carries a version column: batching, anchor derivation, and the
/// version-guarded journal replay.
/// </summary>
/// <remarks>
/// <para>
/// The descriptor supplies everything that depends on the diagram - the table name, the SQL that reads the local anchor
/// and key set, how to read and write the key and the mirrored version on the entity, and how a key turns into the
/// journal's text form and back.
/// </para>
/// <para>
/// <b>The resume point is derived, never stored.</b> The anchor is the maximum mirrored version among the local rows,
/// so it is a fact about the data rather than a separate bookkeeping row that could disagree with it. Three things make
/// that derivation correct, and all three are load-bearing: rows are fetched in ascending version order, each batch is
/// applied in a single local transaction, and <b>the download is the only thing that writes a mirrored version</b>. A
/// run interrupted anywhere leaves the local database holding a prefix of the ordered stream, and the maximum of that
/// prefix is exactly where the next run must start. Rows created locally and not yet uploaded have no mirrored version,
/// so they drop out of the maximum on their own.
/// </para>
/// <para>
/// The third point is what keeps the first two worth anything. A version written from anywhere but the ordered stream -
/// an upload mirroring the stamp the server just gave its row, say - can stand above rows of that stream the local
/// database has not seen, and every one of them then sits below the anchor for good: no later run asks for them again.
/// The version an upload earns is therefore reported to the run rather than mirrored, and the download writes it when
/// the row reaches it in order.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncTable<TEntity, TKey> : SyncTableBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the table with its local repository, the local raw SQL surface, the server source, and its descriptor.</summary>
    /// <param name="local">The local repository.</param>
    /// <param name="localSqlExecutor">The local raw SQL surface.</param>
    /// <param name="server">The server source.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="localSaveHooks">The save hooks the local repository runs (the registry it was given); null when it runs none.</param>
    public SyncTable(
        IRepositoryCore<TEntity, TKey> local,
        ISqlExecutor localSqlExecutor,
        ISyncServerSource<TEntity, TKey> server,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISaveHookRegistry? localSaveHooks = null
    )
        : base(local, localSqlExecutor, server, descriptor, localSaveHooks) { }

    /// <summary>SELECT that returns the highest mirrored version among the local rows (the derived resume point).</summary>
    private string LocalAnchorSql => _descriptor.LocalAnchorSql;

    /// <summary>Reads the mirrored server version off the entity (null when the row has never been uploaded).</summary>
    private byte[]? ReadRowVersion(TEntity entity) => _descriptor.ReadRowVersion(entity);

    /// <summary>Writes the mirrored server version onto the entity.</summary>
    private void WriteRowVersion(TEntity entity, byte[]? rowVersion) =>
        _descriptor.WriteRowVersion(entity, rowVersion);

    /// <inheritdoc />
    /// <remarks>
    /// <para>
    /// The rows of a batch arrive in ascending version order and are dealt with in that order, so whatever the run
    /// commits is a prefix of the stream and the anchor derived from it is where the next pass must resume.
    /// </para>
    /// <para>
    /// A row whose key still holds an unsent local change ends the table's download at that row. The rows behind it are
    /// left on the server rather than applied out of order: applying them would move the anchor past the stopping point,
    /// and the change that stopped it would then never be seen again.
    /// </para>
    /// </remarks>
    public override async Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(context);

        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The download batch size must be greater than zero."
            );
        }

        // Rows an earlier step left owing come first, as nothing in the stream would bring them down again; then the blobs
        // an earlier run left owing, so a row whose copy failed gets its blob even though the stream has moved past it.
        await BringOwedRowsBackAsync(context, cancellationToken).ConfigureAwait(false);
        await CopyOwedBlobsAsync(context, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);

        var applied = 0;
        byte[]? previousAnchor = null;
        var appliedAnyBatch = false;

        // The receipts this download makes redundant. Collected rather than cleared as they are met, because the
        // clearing has to follow the local commit that wrote the version - and the caller clears them once this
        // returns, by which time every batch has committed.
        var settledAcks = new List<string>();

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            // The anchor is re-derived for every batch: the previous batch committed, so the maximum has moved on.
            var anchor = await _localSqlExecutor
                .ExecuteScalarSqlAsync<byte[]>(LocalAnchorSql, null, cancellationToken)
                .ConfigureAwait(false);

            if (appliedAnyBatch && SameAnchor(anchor, previousAnchor))
            {
                // A batch was applied and yet the resume point did not move, so asking again would hand back the same
                // rows for ever. Every reason for it is a defect rather than a state to wait out - a source that
                // ignores the anchor it is given, or rows whose version column is empty and cannot raise the maximum -
                // so it is reported instead of spun on. Without this the download has no way to end.
                throw new InvalidOperationException(
                    $"The download of '{TableName}' is not making progress: a batch was applied but the resume point "
                        + "derived from the local rows did not move. The server source is returning rows that do not "
                        + "advance past the anchor it was given."
                );
            }

            previousAnchor = anchor;

            var batch = await _server
                .GetChangesAsync(anchor, ceiling, batchSize, cancellationToken)
                .ConfigureAwait(false);

            if (batch.Rows.Count == 0)
            {
                return new SyncDownloadOutcome(applied, null, settledAcks);
            }

            var (stopAt, missingParentTable, batchApplied, wroteAny, skippedBySaveHook) = await RunBatchSectionAsync(
                    context,
                    async (holdOf, resolver) =>
                    {
                        var (stop, parentTable) = FindHeldRow(batch.Rows, holdOf);
                        var rows = stop < 0 ? batch.Rows : batch.Rows.Take(stop).ToList();

                        // A row whose parent the local database does not have stops the batch as well, unless the
                        // parent can be brought in first - the prefix up to it is what gets applied.
                        var blocked = await FindRowsMissingParentsAsync(rows, resolver, cancellationToken)
                            .ConfigureAwait(false);

                        if (blocked.Count > 0)
                        {
                            stop = blocked.Keys.Min();
                            parentTable = blocked[stop];
                            rows = rows.Take(stop).ToList();
                        }

                        if (rows.Count == 0)
                        {
                            resolver?.ReconcileSettledReceipts(TableName, settledAcks);

                            return (stop, parentTable, 0, false, false);
                        }

                        var (appliedRows, stoppedAt, skipped) = await ApplyDownloadedRowsAsync(
                                rows,
                                context,
                                settledAcks,
                                includeUnboundedBinary,
                                resolver,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        // A row the resolver read back and the batch then wrote over lost its receipt as that flush
                        // committed; one read back after its last write keeps the receipt recorded for it, whatever the
                        // row's own receipt said (see SyncParentResolver).
                        resolver?.ReconcileSettledReceipts(TableName, settledAcks);

                        if (stoppedAt >= 0)
                        {
                            // A row whose unique value another local row still holds, or that a local save hook
                            // skipped, stops the batch like a held row.
                            return (stoppedAt, (string?)null, appliedRows, true, skipped);
                        }

                        return (stop, parentTable, appliedRows, true, false);
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
            applied += batchApplied;

            // Set even when every row of the batch was this device's own echo: those write a version too, so the
            // resume point did move and the progress guard has nothing to report.
            appliedAnyBatch |= wroteAny;

            if (stopAt >= 0)
            {
                // Stopping is a normal end of this table's download, not a stall: the caller settles the change that
                // stopped it and the next run carries on from the prefix this one left.
                return new SyncDownloadOutcome(
                    applied,
                    FormatKey(ReadKey(batch.Rows[stopAt])),
                    settledAcks
                )
                {
                    MissingParentTableName = missingParentTable,
                    SkippedBySaveHook = skippedBySaveHook,
                };
            }

            // The source itself says whether the stream is drained; what is left over is above the ceiling either way
            // and waits for the next run. Asking again is safe but pointless, so the flag is what ends the loop.
            if (!batch.HasMore)
            {
                return new SyncDownloadOutcome(applied, null, settledAcks);
            }
        }
    }

    /// <summary>Finds the first row that is held back from the batch (-1 when none is), with the table of the parent that holds it back.</summary>
    private static (int Index, string? ParentTableName) FindHeldRow(
        IReadOnlyList<TEntity> rows,
        Func<TEntity, (bool Held, string? ParentTableName)> holdOf
    )
    {
        for (var index = 0; index < rows.Count; index++)
        {
            if (holdOf(rows[index]) is (true, var parentTableName))
            {
                return (index, parentTableName);
            }
        }

        return (-1, null);
    }

    /// <summary>Applies the rows of one batch in order and returns how many of them were applied as content.</summary>
    /// <remarks>
    /// <para>
    /// A row this device uploaded comes back carrying the version the server stamped on it, which is the version the
    /// receipt holds. Such a row holds the local content it was made from, so writing it back would be writing the
    /// row over itself - and, where the excluded columns are carried, copying a blob down that was just copied up. Only
    /// the version is worth taking, and it is taken on its own.
    /// </para>
    /// <para>
    /// Every row that gets this far has its mirrored version written, one way or the other, so a row whose key held a
    /// receipt when the table's download began leaves that receipt with nothing left to say: the mirror now carries at
    /// least what the receipt did. Both paths therefore add to <paramref name="settledAcks"/> - including a row someone
    /// else changed after this device uploaded it, whose receipt is not merely redundant but stale.
    /// </para>
    /// <para>
    /// A row the resolver read back during the batch - a parent further down the batch, a row holding a unique value a
    /// row needs - has a receipt for the version it read, which can be newer than the batch's copy written over it
    /// afterwards. Each flush tells the resolver which rows it wrote and removes, once it has committed, the receipts the
    /// batch's copy overwrote (see <see cref="SyncParentResolver"/>), so the next run brings the newer version down as
    /// content rather than taking it for an echo - even when a later batch of the table's download then fails. The caller
    /// then takes off <paramref name="settledAcks"/> the rows the resolver read back after their last write.
    /// </para>
    /// </remarks>
    /// <param name="rows">The batch's rows, in ascending version order.</param>
    /// <param name="context">The table's unsent local changes and its outstanding acknowledgements.</param>
    /// <param name="settledAcks">The keys whose receipt this download has made redundant; added to as rows are applied.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="resolver">Brings in missing parents and resolves unique-value collisions when it may (null: neither).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The rows applied as content, the index of the row the batch stopped at - because its unique value another local row holds, or because a local save hook skipped it - (-1 when it did not), and whether a save hook was the reason.</returns>
    private async Task<(int Applied, int StoppedAt, bool SkippedBySaveHook)> ApplyDownloadedRowsAsync(
        IReadOnlyList<TEntity> rows,
        SyncDownloadContext context,
        List<string> settledAcks,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        var applied = 0;
        var content = new List<(TEntity Row, int Index)>();

        for (var index = 0; index < rows.Count; index++)
        {
            var row = rows[index];
            var keyText = FormatKey(ReadKey(row));

            if (context.AcknowledgedRowVersions.ContainsKey(keyText))
            {
                settledAcks.Add(keyText);
            }

            if (!IsEchoOfThisDevicesUpload(row, context))
            {
                content.Add((row, index));

                continue;
            }

            // Flushed before the version-only write so the rows are committed in the order they arrived: every commit
            // boundary then leaves the local database holding a prefix of the ordered stream.
            var (flushed, stoppedAt, skippedBySaveHook) = await FlushContentAsync(
                    content,
                    includeUnboundedBinary,
                    resolver,
                    cancellationToken
                )
                .ConfigureAwait(false);
            applied += flushed;

            if (stoppedAt >= 0)
            {
                return (applied, Unsettle(stoppedAt), skippedBySaveHook);
            }

            if (!await MirrorRowVersionAsync(row, cancellationToken).ConfigureAwait(false))
            {
                // The local row is gone - removed outside the generated repositories since the upload read it - so
                // there is no version to write onto it and the server's row is applied like any other.
                content.Add((row, index));
            }
        }

        var (last, lastStoppedAt, lastSkippedBySaveHook) = await FlushContentAsync(
                content,
                includeUnboundedBinary,
                resolver,
                cancellationToken
            )
            .ConfigureAwait(false);

        return lastStoppedAt >= 0
            ? (applied + last, Unsettle(lastStoppedAt), lastSkippedBySaveHook)
            : (applied + last, -1, false);

        // The rows from the stop on are not in: their receipts have nothing to be settled by.
        int Unsettle(int stoppedAt)
        {
            foreach (var row in rows.Skip(stoppedAt))
            {
                settledAcks.Remove(FormatKey(ReadKey(row)));
            }

            return stoppedAt;
        }
    }

    /// <summary>
    /// Applies the rows accumulated so far and empties the buffer; returns how many went, the batch index of the row it
    /// stopped at - because its unique value another local row holds, or because a local save hook skipped it - (-1 when
    /// it did not), and whether a save hook was the reason.
    /// </summary>
    private async Task<(int Applied, int StoppedAt, bool SkippedBySaveHook)> FlushContentAsync(
        List<(TEntity Row, int Index)> content,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        if (content.Count == 0)
        {
            return (0, -1, false);
        }

        var (colliding, skippedAt) = await ApplyBatchOrFindCollisionsAsync(
                content.Select(item => item.Row).ToList(),
                includeUnboundedBinary,
                stopAtFirst: true,
                resolver,
                cancellationToken
            )
            .ConfigureAwait(false);
        var stop = colliding.Count > 0 ? colliding[0] : -1;
        var skipped = skippedAt >= 0 && (stop < 0 || skippedAt < stop);

        if (skipped)
        {
            stop = skippedAt;
        }

        var applied = stop >= 0 ? stop : content.Count;
        var stoppedAt = stop >= 0 ? content[stop].Index : -1;

        // One unit of writes ends here, committed: a row read back before it and written now holds the batch's copy
        // again, so its receipt goes now rather than with the table's download - an exception later in the table's
        // download would otherwise leave it behind. Not the caller's token, for the same reason: a cancellation arriving
        // after the commit must not leave it behind either.
        if (resolver is not null)
        {
            var overwritten = resolver.EndWriteUnit(
                TableName,
                content.Take(applied).Select(item => FormatKey(ReadKey(item.Row)))
            );

            if (overwritten.Count > 0)
            {
                await _localJournal
                    .RemoveAcksAsync(TableName, overwritten, CancellationToken.None)
                    .ConfigureAwait(false);
            }
        }

        content.Clear();

        return (applied, stoppedAt, skipped);
    }

    /// <summary>Whether the downloaded row is the row this device uploaded, still carrying the version the server gave it.</summary>
    /// <remarks>
    /// The version has to match, not just the key: a row someone else changed after this device uploaded it carries a
    /// different version, and that change is a server-side change like any other and has to be applied.
    /// </remarks>
    private bool IsEchoOfThisDevicesUpload(TEntity row, SyncDownloadContext context) =>
        context.AcknowledgedRowVersions.TryGetValue(FormatKey(ReadKey(row)), out var acknowledged)
        && ReadRowVersion(row) is { } current
        && acknowledged.SequenceEqual(current);

    /// <summary>Writes one downloaded row's version onto the local row without touching its content (false = no local row).</summary>
    private async Task<bool> MirrorRowVersionAsync(
        TEntity row,
        CancellationToken cancellationToken
    )
    {
        using (SyncSession.Suppress())
        {
            var local = await _local
                .GetByIdAsync(ReadKey(row), cancellationToken)
                .ConfigureAwait(false);

            if (local is null)
            {
                return false;
            }

            WriteRowVersion(local, ReadRowVersion(row));
            local.MarkUpdated();
            await _local
                .UpdateAsync(local, ConcurrencyMode.ForceOverwrite, cancellationToken)
                .ConfigureAwait(false);

            return true;
        }
    }

    /// <summary>Compares two derived anchors (null means "no local row carries a version yet").</summary>
    private static bool SameAnchor(byte[]? left, byte[]? right) =>
        left is null || right is null ? left is null && right is null : left.SequenceEqual(right);

    /// <inheritdoc />
    /// <remarks>
    /// <para>
    /// The rows come from the same differential source an ordinary run reads, asked from the very beginning: a refresh
    /// is the degenerate case of a download whose resume point starts at nothing, so no second server surface and no
    /// extra endpoint is involved. The ceiling still applies, and it has to - a row still in flight beneath it must
    /// stay out of the reload, or the anchor the reloaded table yields would sit above a row that never arrived and no
    /// later run would look below it again.
    /// </para>
    /// <para>
    /// The cursor advances by the version of the batch's last row rather than by re-deriving the local maximum. Both
    /// give the same value while the source keeps its promise to return rows in ascending version order, and the row
    /// is already in hand. As in a download, a batch that fails to move the cursor is reported rather than spun on.
    /// </para>
    /// <para>
    /// Rows are inserted rather than saved: the table was emptied first, so there is nothing to compare against and
    /// nothing to update. That - together with the absent anchor query, key set, and journal - is where the speed of a
    /// refresh comes from.
    /// </para>
    /// </remarks>
    public override Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) => RefreshCoreAsync(ceiling, batchSize, includeUnboundedBinary, null, cancellationToken);

    /// <inheritdoc />
    private protected override async Task<int> RefreshCoreAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The refresh batch size must be greater than zero."
            );
        }

        // The table was emptied before this, so a blob an earlier run left owing belongs to a row that is gone; the
        // reloaded rows bring their own copies when the refresh carries the columns. A row a download still owed comes
        // in with the reload like every other row the server has.
        await _localJournal.RemoveTableBlobCopiesAsync(TableName, cancellationToken)
            .ConfigureAwait(false);
        await _localJournal.RemoveTableOwedRowsAsync(TableName, cancellationToken)
            .ConfigureAwait(false);

        var inserted = 0;
        byte[]? anchor = null;

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            var batch = await _server
                .GetChangesAsync(anchor, ceiling, batchSize, cancellationToken)
                .ConfigureAwait(false);

            if (batch.Rows.Count == 0)
            {
                return inserted;
            }

            inserted += await InsertRefreshedRowsAsync(
                    batch.Rows,
                    includeUnboundedBinary,
                    resolver,
                    cancellationToken
                )
                .ConfigureAwait(false);

            var next = ReadRowVersion(batch.Rows[^1]);

            if (next is null || next.Length == 0 || SameAnchor(next, anchor))
            {
                throw new InvalidOperationException(
                    $"The refresh of '{TableName}' is not making progress: the last row of a batch carries no "
                        + "version, or one that does not advance past the anchor the batch was asked for. The server "
                        + "source is not returning rows in ascending version order above the anchor it was given."
                );
            }

            // The source itself says whether the stream is drained; what is left over is above the ceiling either way
            // and belongs to the next ordinary run, which resumes from the anchor this reload leaves behind.
            if (!batch.HasMore)
            {
                return inserted;
            }

            anchor = next;
        }
    }

    /// <inheritdoc />
    /// <remarks>
    /// The change stream read from the start, with no ceiling: a reference check wants what the server holds now, and a
    /// row a transaction in flight is writing is not committed to refer to anything yet.
    /// </remarks>
    private protected override async Task ScanServerRowsAsync(
        int batchSize,
        Func<IReadOnlyList<TEntity>, bool> onBatch,
        CancellationToken cancellationToken
    )
    {
        byte[]? anchor = null;

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            var batch = await _server
                .GetChangesAsync(anchor, null, batchSize, cancellationToken)
                .ConfigureAwait(false);

            if (batch.Rows.Count == 0 || !onBatch(batch.Rows) || !batch.HasMore)
            {
                return;
            }

            var next = ReadRowVersion(batch.Rows[^1]);

            if (next is null || next.Length == 0 || SameAnchor(next, anchor))
            {
                throw new InvalidOperationException(
                    $"The reference check of '{TableName}' is not making progress: the last row of a batch carries no "
                        + "version, or one that does not advance past the anchor the batch was asked for."
                );
            }

            anchor = next;
        }
    }

    /// <inheritdoc />
    public override async Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entry);

        if (mode == SyncMode.LastWriteWins)
        {
            // The run asked for overwrites, so the version guards - and the receipt they would be read against, and
            // the policy that decides what happens when they fire - have nothing to do.
            return await UploadLastWriteWinsAsync(entry, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false);
        }

        var key = ParseKey(entry.KeyText);

        // A delete carries nothing extra: the excluded columns go with the row it removes.
        return string.Equals(
            entry.Operation,
            nameof(SyncJournalOperation.Delete),
            StringComparison.Ordinal
        )
            ? await UploadDeleteAsync(
                entry,
                key,
                policy,
                acknowledgedRowVersion,
                cancellationToken
            )
                .ConfigureAwait(false)
            : await UploadUpsertAsync(
                entry,
                key,
                policy,
                includeUnboundedBinary,
                acknowledgedRowVersion,
                cancellationToken
            )
                .ConfigureAwait(false);
    }

    /// <summary>Replays an insert or an update by sending the row's <i>current</i> local content.</summary>
    /// <remarks>
    /// The original the update guards against is the later of the mirrored version and the acknowledged one. Reading
    /// the mirror alone makes a row whose echo has not come down look older than the server's copy of itself, and the
    /// guard then fires against a version this very device wrote - a conflict with nobody. It is also what tells an
    /// offline insert apart from a row already accepted but not yet echoed: both have an empty mirror, and only the
    /// second has a receipt.
    /// <para>
    /// A row deleted here and created again under the same key has no mirror of its own either; the entry carries the
    /// version the server held for the row the delete removed, and that is taken into the same maximum. The server still
    /// has that row, so the new content goes there as an update guarded by that version - a later change on the server
    /// is a conflict, as for any other edit - rather than as an insert the server refuses as a duplicate. A row created,
    /// deleted and created again without ever reaching the server carries no such version and is inserted as before.
    /// </para>
    /// </remarks>
    private async Task<SyncUploadOutcome> UploadUpsertAsync(
        SyncJournalRow entry,
        TKey key,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken
    )
    {
        var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);

        if (local is null)
        {
            // A journal-first entry whose business write never landed, or a row deleted afterwards. Nothing to send.
            return SyncUploadOutcome.Discarded;
        }

        // The row was read without its unbounded binary columns, so a NOT NULL one may hold nothing at all, which an
        // insert on the server would refuse; an update never writes these columns, so the empty value goes nowhere.
        _descriptor.FillUnsetUnboundedBinaries(local);

        var mirror = MaxRowVersion(
            MaxRowVersion(ReadRowVersion(local), acknowledgedRowVersion),
            entry.OriginalRowVersion
        );

        // Whether the server is given the row for the first time (every blob goes), and whether its row was overwritten
        // without a version guard (the blobs not sent are owed a copy down) - see ColumnsToSend and
        // OweUnsentBlobCopiesAsync.
        var inserted = false;
        var forced = false;

        if (mirror is null)
        {
            // Neither a mirrored version nor a receipt means the row was created locally and has never been on the
            // server.
            var alreadyThere = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            if (alreadyThere is not null && policy != SyncConflictPolicy.LocalWins)
            {
                return SyncUploadOutcome.Conflicted(
                    new SyncConflict(
                        TableName,
                        entry.KeyText,
                        SyncJournalOperation.Upsert,
                        SyncConflictReason.DuplicateOnServer,
                        local,
                        alreadyThere
                    )
                );
            }

            if (alreadyThere is null)
            {
                local.MarkAdded();
                await _server.Writer.InsertAsync(local, cancellationToken).ConfigureAwait(false);
                inserted = true;
            }
            else
            {
                // LocalWins: the offline insert overwrites the row the server already holds under that key. The
                // insert the overwrite falls back to covers that row disappearing between the probe and the update.
                inserted = await ForceOverwriteOrInsertAsync(local, cancellationToken)
                    .ConfigureAwait(false);
                forced = !inserted;
            }
        }
        else
        {
            // The guard reads the version off the entity, so the one that is actually going to be guarded against is
            // written onto it first - which matters exactly when the receipt is the later of the two.
            WriteRowVersion(local, mirror);

            if (policy == SyncConflictPolicy.LocalWins)
            {
                // LocalWins: the local edit overwrites the server's row, and puts it back when the server no longer
                // has it - the same resurrection last-write-wins performs, here as the resolution of a collected
                // conflict.
                inserted = await ForceOverwriteOrInsertAsync(local, cancellationToken)
                    .ConfigureAwait(false);
                forced = !inserted;
            }
            else
            {
                local.MarkUpdated();

                try
                {
                    var updated = await _server
                        .Writer.UpdateAsync(local, ConcurrencyMode.Optimistic, cancellationToken)
                        .ConfigureAwait(false);

                    if (!updated)
                    {
                        return SyncUploadOutcome.Conflicted(
                            new SyncConflict(
                                TableName,
                                entry.KeyText,
                                SyncJournalOperation.Upsert,
                                SyncConflictReason.MissingOnServer,
                                local,
                                null
                            )
                        );
                    }
                }
                catch (SaveConflictException)
                {
                    var current = await _server
                        .Writer.GetByIdAsync(key, cancellationToken)
                        .ConfigureAwait(false);

                    return SyncUploadOutcome.Conflicted(
                        new SyncConflict(
                            TableName,
                            entry.KeyText,
                            SyncJournalOperation.Upsert,
                            SyncConflictReason.ModifiedOnServer,
                            local,
                            current
                        )
                    );
                }
            }
        }

        var columns = ColumnsToSend(entry, inserted, includeUnboundedBinary);

        if (inserted)
        {
            await KeepInsertedBlobsOwedAsync(entry, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        if (columns.Count > 0)
        {
            await RecordInterimAckAsync(entry, local, cancellationToken).ConfigureAwait(false);
            await CopyBinaryColumnsUpAsync(key, columns, cancellationToken).ConfigureAwait(false);
        }

        if (forced)
        {
            await OweUnsentBlobCopiesAsync(entry.KeyText, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        // The server stamped the row with a new version. It is reported to the run rather than written onto the local
        // row: the mirrored version is the resume point of the download, and only the download may move it.
        return SyncUploadOutcome.UploadedWith(
            await ReadServerRowVersionAsync(local, columns.Count > 0, cancellationToken)
                .ConfigureAwait(false)
        );
    }

    /// <summary>Replays a delete under the protection of the version the row carried when it was deleted.</summary>
    /// <remarks>
    /// The key alone would delete unconditionally, so the delete goes through the graph save instead: a stub carrying
    /// the key, the recorded version, and <c>RowState.Removed</c> is exactly the shape the existing version guard
    /// already covers. A row the server no longer has is a no-op rather than a conflict - the delete's intent is
    /// already satisfied. A row that is still there locally means the opposite, and the entry is discarded unsent.
    /// <para>
    /// The recorded version is the mirror as the row carried it when it was deleted, so it is behind the server's
    /// whenever the row's echo had not come down - and the stub is guarded against the later of it and the receipt for
    /// the same reason an update is.
    /// </para>
    /// </remarks>
    private async Task<SyncUploadOutcome> UploadDeleteAsync(
        SyncJournalRow entry,
        TKey key,
        SyncConflictPolicy policy,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken
    )
    {
        if (await LocalRowSurvivedDeleteAsync(key, cancellationToken).ConfigureAwait(false))
        {
            return SyncUploadOutcome.Discarded;
        }

        if (policy == SyncConflictPolicy.LocalWins)
        {
            await _server.Writer.DeleteAsync(key, cancellationToken).ConfigureAwait(false);

            return SyncUploadOutcome.Uploaded;
        }

        var stub = new TEntity();
        WriteKey(stub, key);
        WriteRowVersion(stub, MaxRowVersion(entry.OriginalRowVersion, acknowledgedRowVersion));
        stub.MarkRemoved();

        try
        {
            await _server
                .Writer.SaveAsync(
                    stub,
                    cascadeSave: false,
                    cascadeDelete: false,
                    insertWhenUpdateMissing: false,
                    ConcurrencyMode.Optimistic,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        catch (SaveConflictException)
        {
            var current = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            return SyncUploadOutcome.Conflicted(
                new SyncConflict(
                    TableName,
                    entry.KeyText,
                    SyncJournalOperation.Delete,
                    current is null
                        ? SyncConflictReason.MissingOnServer
                        : SyncConflictReason.ModifiedOnServer,
                    null,
                    current
                )
            );
        }

        return SyncUploadOutcome.Uploaded;
    }
}

/// <summary>
/// The fixed half of one synchronised table without a version column: a full key-ordered download and a
/// last-write-wins replay.
/// </summary>
/// <remarks>
/// <para>
/// No version column means no change stream: there is nothing to derive a resume point from and nothing to bound a
/// pass with, so every download reads the whole table in ascending primary-key order and applies each batch as an
/// upsert. The cost is O(table) per run, which is why these tables are meant to be the small, rarely changing kind -
/// a large or busy table is better served by a rowversion column and the incremental download it buys.
/// </para>
/// <para>
/// Uploads carry no version either, so a replay can only overwrite. These tables therefore take part exclusively in
/// <see cref="SyncMode.LastWriteWins"/> runs; a <see cref="SyncMode.Versioned"/> run leaves them - and their journal
/// entries - untouched.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class VersionlessSyncTable<TEntity, TKey> : SyncTableBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the table with its local repository, the local raw SQL surface, the server source, and its descriptor.</summary>
    /// <param name="local">The local repository.</param>
    /// <param name="localSqlExecutor">The local raw SQL surface.</param>
    /// <param name="server">The server source.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="localSaveHooks">The save hooks the local repository runs (the registry it was given); null when it runs none.</param>
    public VersionlessSyncTable(
        IRepositoryCore<TEntity, TKey> local,
        ISqlExecutor localSqlExecutor,
        ISyncServerSource<TEntity, TKey> server,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISaveHookRegistry? localSaveHooks = null
    )
        : base(local, localSqlExecutor, server, descriptor, localSaveHooks) { }

    /// <inheritdoc />
    /// <remarks>A key-ordered scan has no version to bound, so the answer is always null and the engine never asks.</remarks>
    public override Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => Task.FromResult<byte[]?>(null);

    /// <inheritdoc />
    /// <remarks>
    /// <para>
    /// The ceiling is ignored - there is no version to bound by. Every row comes down and is applied as an upsert
    /// through the same batch application a versioned download uses (one local transaction per batch, journaling
    /// suppressed), so a row that did not change is overwritten with itself; the delete propagation that follows a
    /// download is what removes the rows the server dropped.
    /// </para>
    /// <para>
    /// A row whose key still holds an unsent local change, or whose parent the local database does not have and the run
    /// may not bring in, is skipped and the scan carries on: there is no resume point to protect here - every run reads
    /// the whole table - so leaving one row alone costs nothing. The table is still reported as stopped, at the first
    /// row it skipped, once the scan is through. A row of a later table that refers to the row skipped here is held back
    /// in turn - the row is either here already, or cannot be had for the same reason it was skipped.
    /// </para>
    /// </remarks>
    public override async Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(context);

        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The download batch size must be greater than zero."
            );
        }

        // Blobs an earlier run left owing come first, so a row whose copy failed gets its blob even though the stream
        // has moved past it.
        await CopyOwedBlobsAsync(context, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);

        var applied = 0;
        string? stoppedAt = null;
        string? missingParentTable = null;
        var skippedBySaveHook = false;

        // A row a local save hook skips stops the table there, as in a versioned download: the scan goes no further.
        var stoppedBySaveHook = false;

        await ScanByKeyAsync(
                batchSize,
                "download",
                async rows =>
                {
                    applied += await RunBatchSectionAsync(
                            context,
                            async (holdOf, resolver) =>
                            {
                                var kept = new List<TEntity>(rows.Count);
                                var keptAt = new List<int>(rows.Count);
                                var firstSkipped = -1;
                                string? firstParentTable = null;

                                for (var index = 0; index < rows.Count; index++)
                                {
                                    if (holdOf(rows[index]) is (true, var parentTable))
                                    {
                                        if (firstSkipped < 0)
                                        {
                                            (firstSkipped, firstParentTable) = (index, parentTable);
                                        }

                                        continue;
                                    }

                                    kept.Add(rows[index]);
                                    keptAt.Add(index);
                                }

                                var blocked = await FindRowsMissingParentsAsync(kept, resolver, cancellationToken)
                                    .ConfigureAwait(false);

                                foreach (var (index, parentTable) in blocked)
                                {
                                    if (firstSkipped < 0 || keptAt[index] < firstSkipped)
                                    {
                                        (firstSkipped, firstParentTable) = (keptAt[index], parentTable);
                                    }
                                }

                                var toApplyAt = keptAt.Where((_, index) => !blocked.ContainsKey(index)).ToList();
                                var toApply = kept.Where((_, index) => !blocked.ContainsKey(index)).ToList();
                                var firstSkippedBySaveHook = false;

                                if (toApply.Count > 0)
                                {
                                    // A row whose unique value another local row still holds is skipped as well. A
                                    // row a local save hook skips stops the batch, and the rows after it stay out.
                                    var (colliding, hookSkippedAt) = await ApplyBatchOrFindCollisionsAsync(
                                            toApply,
                                            includeUnboundedBinary,
                                            stopAtFirst: false,
                                            resolver,
                                            cancellationToken
                                        )
                                        .ConfigureAwait(false);

                                    foreach (var index in colliding)
                                    {
                                        if (firstSkipped < 0 || toApplyAt[index] < firstSkipped)
                                        {
                                            (firstSkipped, firstParentTable) = (toApplyAt[index], null);
                                        }
                                    }

                                    if (hookSkippedAt >= 0)
                                    {
                                        stoppedBySaveHook = true;

                                        if (firstSkipped < 0 || toApplyAt[hookSkippedAt] < firstSkipped)
                                        {
                                            (firstSkipped, firstParentTable) = (toApplyAt[hookSkippedAt], null);
                                            firstSkippedBySaveHook = true;
                                        }
                                    }

                                    toApply = toApply
                                        .Where(
                                            (_, index) =>
                                                !colliding.Contains(index)
                                                && (hookSkippedAt < 0 || index < hookSkippedAt)
                                        )
                                        .ToList();
                                }

                                if (firstSkipped >= 0 && stoppedAt is null)
                                {
                                    stoppedAt = FormatKey(ReadKey(rows[firstSkipped]));
                                    missingParentTable = firstParentTable;
                                    skippedBySaveHook = firstSkippedBySaveHook;
                                }

                                return toApply.Count;
                            },
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return !stoppedBySaveHook;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        return new SyncDownloadOutcome(applied, stoppedAt)
        {
            MissingParentTableName = missingParentTable,
            SkippedBySaveHook = skippedBySaveHook,
        };
    }

    /// <summary>
    /// Reads the whole server table in ascending primary-key order, one batch at a time, and hands each non-empty batch
    /// to <paramref name="onBatch"/> (the scan a download and a refresh of this table share).
    /// </summary>
    /// <remarks>
    /// A source whose last key fails to advance while it still claims more is reported rather than spun on, exactly
    /// like a versioned source that ignores its anchor.
    /// </remarks>
    /// <param name="batchSize">The maximum number of rows one batch carries.</param>
    /// <param name="what">The name of the operation, for the message of the progress guard.</param>
    /// <param name="onBatch">Deals with one batch, returning whether the scan goes on.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task ScanByKeyAsync(
        int batchSize,
        string what,
        Func<IReadOnlyList<TEntity>, Task<bool>> onBatch,
        CancellationToken cancellationToken
    )
    {
        string? previousKeyText = null;
        var batch = await _server
            .GetFirstPageAsync(batchSize, cancellationToken)
            .ConfigureAwait(false);

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            if (batch.Rows.Count == 0)
            {
                return;
            }

            if (!await onBatch(batch.Rows).ConfigureAwait(false) || !batch.HasMore)
            {
                return;
            }

            var lastKey = ReadKey(batch.Rows[^1]);
            var lastKeyText = FormatKey(lastKey);

            if (string.Equals(lastKeyText, previousKeyText, StringComparison.Ordinal))
            {
                throw new InvalidOperationException(
                    $"The {what} of '{TableName}' is not making progress: the last key of a batch did not advance "
                        + "past the one the batch was asked for. The server source is not returning rows in ascending "
                        + "primary-key order above the key it was given."
                );
            }

            previousKeyText = lastKeyText;
            batch = await _server
                .GetPageAfterAsync(lastKey, batchSize, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <inheritdoc />
    /// <remarks>
    /// Rows are inserted rather than saved - the table was emptied first, so there is nothing to compare against -
    /// and the scan is paged by key like a download, with the same progress guard. The ceiling is ignored for the
    /// same reason it is during a download.
    /// </remarks>
    public override Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) => RefreshCoreAsync(ceiling, batchSize, includeUnboundedBinary, null, cancellationToken);

    /// <inheritdoc />
    private protected override async Task<int> RefreshCoreAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The refresh batch size must be greater than zero."
            );
        }

        // The table was emptied before this, so a blob an earlier run left owing belongs to a row that is gone; the
        // reloaded rows bring their own copies when the refresh carries the columns.
        await _localJournal.RemoveTableBlobCopiesAsync(TableName, cancellationToken)
            .ConfigureAwait(false);

        var inserted = 0;

        await ScanByKeyAsync(
                batchSize,
                "refresh",
                async rows =>
                {
                    inserted += await InsertRefreshedRowsAsync(
                            rows,
                            includeUnboundedBinary,
                            resolver,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return true;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        return inserted;
    }

    /// <inheritdoc />
    private protected override Task ScanServerRowsAsync(
        int batchSize,
        Func<IReadOnlyList<TEntity>, bool> onBatch,
        CancellationToken cancellationToken
    ) =>
        ScanByKeyAsync(
            batchSize,
            "reference check",
            rows => Task.FromResult(onBatch(rows)),
            cancellationToken
        );

    /// <inheritdoc />
    /// <remarks>
    /// Only <see cref="SyncMode.LastWriteWins"/> runs include this table, and without a version the replay can only
    /// overwrite, so neither the mode nor the policy nor an acknowledged version has anything left to choose. Nothing
    /// ever records a receipt for such a table either: an upload with no version to report leaves none behind.
    /// </remarks>
    public override async Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entry);

        return await UploadLastWriteWinsAsync(entry, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);
    }
}

/// <summary>
/// Bidirectional differential sync between the server database and the local one, with the server as the source of truth.
/// </summary>
/// <remarks>
/// <para>
/// A run uploads first and downloads second. Uploading first means a local change reaches the server before the server's
/// rows come back down, so a change accepted by the server is not immediately overwritten by its own pre-upload state.
/// The upload is also where <see cref="SyncConflictPolicy.ServerWins"/> decides which local changes give way. Each such
/// row takes the server's content right after its table's download, parents first (a call to
/// <see cref="UploadAsync"/> on its own does it during the upload), and a row the server does not have is left to the
/// delete propagation that follows the download.
/// </para>
/// <para>
/// Rows go in foreign-key order - parents before children when rows are written, children before parents when rows are
/// deleted. The upload runs in rounds: a round sends the upserts parents first, then the deletes children first, then
/// the upserts it held back, and a write the server refused over a foreign key or a unique value goes into the next round
/// as long as the round got anything through. The download visits the tables parents first and reads one table's
/// changes before it moves to the next, so a child row is never applied before the parent it points at.
/// </para>
/// <para>
/// Nothing here resolves a conflict silently. Under the default policy a local change that collides with the server stays
/// in the journal and comes back in <see cref="SyncResult.Conflicts"/> with both sides of the disagreement attached - and
/// the row it describes stays where it is, because both halves of the download leave every key the journal still holds an
/// entry for alone: the row itself is not overwritten, and the delete propagation does not remove it.
/// </para>
/// <para>
/// Leaving such a row alone has a price, and the run says so rather than paying it quietly. A table's download stops at
/// the first row whose local change is still unsent (the tables after it go on, bringing in from the server any parent
/// that was behind the stopping point); what was left unread is reported in <see cref="SyncResult.Truncations"/> and
/// comes down once the change that stopped it has been settled - which is the caller's to decide and re-run.
/// </para>
/// </remarks>
public sealed class SyncEngine
{
    /// <summary>The key of <see cref="Exception.Data"/> under which a <see cref="SyncAsync"/> that throws hands on the local rows it had changed on its own (an <see cref="IReadOnlyList{T}"/> of <see cref="SyncLocalRowChange"/>; see <see cref="SyncResult.LocalRowChanges"/>).</summary>
    public const string LocalRowChangesDataKey = "QuickER.Sync.LocalRowChanges";

    private readonly IReadOnlyList<ISyncTable> _tables;
    private readonly SyncJournal _journal;

    /// <summary>Where the run in flight notes the local rows it changes on its own (set by <see cref="SyncAsync"/>; runs never overlap).</summary>
    private SyncLocalRowChangeLog? _changeLog;

    /// <summary>Creates the engine over the synchronised tables, ordered parents first.</summary>
    /// <param name="tables">The synchronised tables in foreign-key order (a parent always precedes its children).</param>
    /// <param name="journal">The local journal of offline edits.</param>
    public SyncEngine(IEnumerable<ISyncTable> tables, SyncJournal journal)
    {
        ArgumentNullException.ThrowIfNull(tables);
        ArgumentNullException.ThrowIfNull(journal);
        _tables = tables.ToList();
        _journal = journal;
        _keyTextNormalizers = _tables
            .Where(table => table is ISyncTableRunSupport { NormalizeKeyText: not null })
            .ToDictionary(
                table => table.TableName,
                table => ((ISyncTableRunSupport)table).NormalizeKeyText!,
                StringComparer.Ordinal
            );
    }

    /// <summary>The rewrite of each table whose key text form has changed (see <see cref="SyncJournal.NormalizeKeyTextsAsync"/>).</summary>
    private readonly IReadOnlyDictionary<string, Func<string, string>> _keyTextNormalizers;

    /// <summary>Creates the journal's tables when they are missing and brings the key texts in them to today's form.</summary>
    private async Task PrepareJournalAsync(CancellationToken cancellationToken)
    {
        await _journal.EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _journal
            .NormalizeKeyTextsAsync(_keyTextNormalizers, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Runs one full sync: replays the local journal, then pulls the server's changes down.</summary>
    /// <remarks>
    /// What the upload learns is carried into the download through the acknowledgement table rather than through the
    /// run: the version the server stamped on each row that went up is written down as it goes, so the download can
    /// tell an echo from a change worth applying. Calling <see cref="UploadAsync"/> and <see cref="DownloadAsync"/>
    /// separately is therefore not a lesser arrangement - the receipts outlive the call that wrote them, and a
    /// download run on its own recognises the echoes of every upload whose row has yet to come back down.
    /// </remarks>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task<SyncResult> SyncAsync(
        SyncOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncOptions();

        // Checked before the upload rather than left to the download: by then the upload may already have changed
        // both databases, and a run that does that and only then reports a bad argument is not one anybody asked for.
        if (options.DownloadBatchSize <= 0)
        {
            return Task.FromException<SyncResult>(
                new ArgumentOutOfRangeException(
                    nameof(options),
                    options.DownloadBatchSize,
                    "The download batch size must be greater than zero."
                )
            );
        }

        return _journal.Gate.RunExclusiveAsync(
            async () =>
            {
                var changes = new SyncLocalRowChangeLog();
                _changeLog = changes;

                try
                {
                    await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

                    var conflicts = new List<SyncConflict>();
                    var upload = await UploadCoreAsync(
                            options,
                            conflicts,
                            deferServerWins: true,
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                    var download = await DownloadCoreAsync(
                            options,
                            upload.DeferredServerWins,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return new SyncResult(
                        upload.Uploaded,
                        download.Downloaded,
                        download.DeletedLocally,
                        upload.Discarded + download.Discarded,
                        conflicts
                    )
                    {
                        Truncations = download.Truncations,
                        LocalRowChanges = changes.ToList(),
                    };
                }
                catch (Exception failure)
                {
                    // The run stops, but what it did to local rows on its own stays done; the caller learns which rows
                    // through the exception, whose type is left as it is.
                    if (changes.ToList() is { Count: > 0 } changed)
                    {
                        failure.Data[LocalRowChangesDataKey] = changed;
                    }

                    throw;
                }
                finally
                {
                    _changeLog = null;
                }
            },
            cancellationToken
        );
    }

    /// <summary>Rebuilds the local database from the server's rows: every synchronised table is emptied and reloaded.</summary>
    /// <remarks>
    /// <para>
    /// This is for building the local database the first time, for recovering one that was lost or corrupted, and for
    /// starting over when a database has fallen so far behind that catching up row by row is not worth it. It is not a
    /// faster <see cref="SyncAsync"/> and does not replace one: it transfers every row of every synchronised table, so
    /// over a slow link and a large table the transfer is what dominates and an ordinary run - which carries only what
    /// changed - is the cheaper one from the second run onwards.
    /// </para>
    /// <para>
    /// What makes it fast is what it leaves out. Nothing is compared with the row it replaces, no anchor is derived
    /// per batch, no key set is fetched to find the rows the server dropped (they are gone by construction), and no
    /// journal is replayed. All of it is skipped because the answer is known in advance: the local side ends up as a
    /// copy of the server's.
    /// </para>
    /// <para>
    /// It touches the synchronised tables and nothing else. A table the local database keeps for itself - a settings
    /// table, a cache, anything excluded where the engine was put together - is not part of this and is left
    /// exactly as it was; and <see cref="SyncRefreshOptions.Mode"/> can narrow a run further.
    /// </para>
    /// <para>
    /// Rows outside the refresh that refer to the tables it empties are refused rather than lost. When a local row of
    /// a table the run leaves out - one narrowed away by <see cref="SyncRefreshOptions.Mode"/> or
    /// <see cref="SyncRefreshOptions.ExcludedEntityTypes"/>, one excluded where the engine was put together, or one the
    /// engine does not synchronise at all - refers to a row of a table the run empties, the run throws
    /// <see cref="SyncRefreshScopeException"/> before it reads or deletes anything: emptying the table would take that
    /// row with it under <c>ON DELETE CASCADE</c>, or fail on the local foreign key. The check looks at the rows, so a
    /// table left out that holds no such row does not stand in the way; a table the local database does not have is
    /// not asked. A foreign key that refers to a unique constraint, or spans several columns, cannot be asked which rows
    /// it refers to, so such a table refuses the run whenever the local database has it. A table implemented outside
    /// the generated code is not checked.
    /// </para>
    /// <para>
    /// Unsent local changes are refused rather than lost. When the journal is not empty the run throws
    /// <see cref="SyncPendingChangesException"/> before deleting anything;
    /// <see cref="SyncRefreshOptions.Force"/> is the explicit request to drop them instead.
    /// </para>
    /// <para>
    /// Local blobs are refused on the same terms. When a synchronised table has unbounded binary columns - which the
    /// row transfer leaves out, so the reload does not bring them back - the run throws
    /// <see cref="SyncUnboundedBinaryLossException"/> before deleting anything, until
    /// <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> says to reload them too or
    /// <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> says the loss is intended. A generated setup
    /// without such columns never sees this.
    /// </para>
    /// <para>
    /// <b>Crash safety.</b> The run is not one transaction - the generated repositories manage their own connections,
    /// so nothing here can enlist in a transaction of its own making - but every point at which it commits is a state
    /// a later run can start from, which is the property that actually matters. The deletes go children first and the
    /// reloads parents first, so no foreign key ever points at a row that is not there; and each table's rows arrive
    /// in ascending version order, so a table interrupted part way holds exactly the rows below the version it
    /// stopped at - precisely the resume point that the local maximum yields. A refresh cut short anywhere is
    /// therefore repaired by running it again, and an ordinary <see cref="SyncAsync"/> in the meantime picks up from
    /// where it stopped rather than mistaking the gap for a server-side deletion.
    /// </para>
    /// <para>
    /// Tables that refer to each other in a cycle (one refers to another, which refers back) cannot be emptied one at a
    /// time: whichever goes first, the other still refers to it. When the tables a run covers form such a cycle, the
    /// deletes therefore run as one transaction with the foreign key check deferred to its commit - provided every table
    /// of the run is a generated one and they share one local executor that implements <see cref="ISqlBatchExecutor"/>
    /// (the generated SQLite executor does). The tables are then emptied together or not at all. Otherwise the deletes
    /// run one table at a time as above, and a cycle makes the first of them fail on the local foreign key. Tables
    /// without a cycle are always emptied one at a time. Rows that refer to each other in a cycle go with the deletes,
    /// but the reload cannot bring such rows back one by one, and stops at them.
    /// </para>
    /// <para>
    /// The one state this leaves that a single transaction would not is a partly rebuilt local database: between the
    /// first delete and the last row of the last table, a reader of the local database sees fewer rows than either
    /// side holds. Nothing is lost by it - the server still has everything - but a refresh is not something to run
    /// underneath a live screen.
    /// </para>
    /// </remarks>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <exception cref="SyncRefreshScopeException">A local row of a table outside the refresh refers to a row of a table it would empty.</exception>
    /// <exception cref="SyncPendingChangesException">The journal holds unsent local changes and <see cref="SyncRefreshOptions.Force"/> was not set.</exception>
    /// <exception cref="SyncUnboundedBinaryLossException">A synchronised table has unbounded binary columns and neither <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> nor <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> was set.</exception>
    public async Task<SyncRefreshResult> RefreshAsync(
        SyncRefreshOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncRefreshOptions();

        // Checked here rather than left to the per-table call: by then the local tables have already been emptied, and
        // a run that wipes the local database and only then reports a bad argument is not one anybody asked for.
        if (options.BatchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.BatchSize,
                "The refresh batch size must be greater than zero."
            );
        }

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);

        // Also before anything is deleted, and before the journal is even read: a local blob that only exists here is
        // gone for good once its row is, and neither answer to that is one the engine may pick on the caller's behalf.
        if (!options.IncludeUnboundedBinary && !options.DiscardLocalUnboundedBinaries)
        {
            var atStake = scope
                .Where(table => table.UnboundedBinaryColumnNames.Count > 0)
                .Select(table => new SyncUnboundedBinaryColumns(
                    table.TableName,
                    table.UnboundedBinaryColumnNames
                ))
                .ToList();

            if (atStake.Count > 0)
            {
                throw new SyncUnboundedBinaryLossException(atStake);
            }
        }

        var startedAt = Stopwatch.GetTimestamp();

        // The whole refresh holds the run lock and the write lock: it wipes tables wholesale, so a local write landing
        // part way through would be deleted, or would point at a parent the wipe is about to remove. Its own writes run
        // suppressed and take no lock.
        return await _journal
            .Gate.RunExclusiveAsync(
                () =>
                    _journal.Gate.WriteExclusiveAsync(
                        () => RefreshCoreAsync(options, scope, startedAt, cancellationToken),
                        cancellationToken
                    ),
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>The body of <see cref="RefreshAsync"/>, run under both locks once the arguments have been checked.</summary>
    private async Task<SyncRefreshResult> RefreshCoreAsync(
        SyncRefreshOptions options,
        IReadOnlyList<ISyncTable> scope,
        long startedAt,
        CancellationToken cancellationToken
    )
    {
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);

        // Before anything is read or changed: a row outside the scope that refers to a row the run is about to delete
        // goes with it under CASCADE, or makes the deletion fail. Both locks are held, so no journaled write can add
        // such a row between this check and the deletion.
        var blocking = new List<SyncRefreshScopeReference>();

        foreach (var table in scope)
        {
            if (table is not ISyncTableRunSupport support)
            {
                continue;
            }

            foreach (
                var referring in await support
                    .FindReferencesFromOutsideAsync(scopeTableNames, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                blocking.Add(new SyncRefreshScopeReference(referring, table.TableName));
            }
        }

        if (blocking.Count > 0)
        {
            throw new SyncRefreshScopeException(blocking);
        }

        await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

        // Only the entries of the tables this refresh covers count as being at stake: an entry of a table outside
        // the scope describes rows the run will not touch, so it neither blocks the run nor is dropped by Force.
        var pending = (await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false))
            .Where(entry => scopeTableNames.Contains(entry.TableName))
            .ToList();

        if (pending.Count > 0 && !options.Force)
        {
            throw new SyncPendingChangesException(
                pending
                    .GroupBy(entry => entry.TableName, StringComparer.Ordinal)
                    .Select(group => new SyncPendingChange(group.Key, group.Count()))
                    .ToList()
            );
        }

        if (pending.Count > 0)
        {
            // Dropped before anything is deleted, so an interrupted forced run does not leave entries describing rows
            // that the reload has already replaced.
            await RemoveAsync(pending.Select(entry => entry.Id).ToList(), cancellationToken)
                .ConfigureAwait(false);
        }

        if (scope.Count == 0)
        {
            return new SyncRefreshResult([], pending.Count, Stopwatch.GetElapsedTime(startedAt));
        }

        // One ceiling for the whole run, for the same reason an ordinary run uses one (and from a versioned table,
        // for the same reason as well).
        var ceilingTable = scope.FirstOrDefault(table => !table.IsVersionless);
        var ceiling = ceilingTable is null
            ? null
            : await ceilingTable.GetChangeCeilingAsync(cancellationToken).ConfigureAwait(false);
        var deleted = await EmptyLocalTablesAsync(scope, cancellationToken).ConfigureAwait(false);

        // The receipts go once the rows they are about have: a refresh replaces every row of these tables along with
        // its mirrored version, so a per-row record of what the server once acknowledged has nothing left to be about.
        // Not before the deletion, which can fail - the rows would then stay, with nothing left to tell an edit of one
        // the server has already taken from a row it has never seen. A run that stops between the two leaves receipts
        // for rows that are gone; the reload writes the server's version, which is never behind a receipt, so such a
        // receipt changes nothing - unless the server has lost the row too, when a row later made under the same key
        // locally is sent as an update and reported missing on the server.
        foreach (var table in scope)
        {
            await _journal
                .RemoveTableAcksAsync(table.TableName, cancellationToken)
                .ConfigureAwait(false);
        }

        var tables = new List<SyncRefreshTableResult>(scope.Count);

        // One resolver for the whole reload: a parent brought in ahead of its own batch has to be recognised when that
        // batch arrives, whichever table it belongs to.
        var resolver = new SyncParentResolver(
            _tables,
            scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal),
            SyncParentResolver.NothingPending,
            _journal,
            options.IncludeUnboundedBinary,

            // The reload starts from emptied tables: there is no local row the server does not have.
            propagateDeletes: false
        );

        // Parents first, for the same reason in reverse.
        for (var index = 0; index < scope.Count; index++)
        {
            var table = scope[index];
            var inserted = table is ISyncTableRunSupport support
                ? await support
                    .RefreshAsync(
                        ceiling,
                        options.BatchSize,
                        options.IncludeUnboundedBinary,
                        resolver,
                        cancellationToken
                    )
                    .ConfigureAwait(false)
                : await table
                    .RefreshAsync(
                        ceiling,
                        options.BatchSize,
                        options.IncludeUnboundedBinary,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            tables.Add(new SyncRefreshTableResult(table.TableName, deleted[index], inserted));
        }

        return new SyncRefreshResult(tables, pending.Count, Stopwatch.GetElapsedTime(startedAt));
    }

    /// <summary>Empties the local tables of a refresh, children first, and returns how many rows each one lost (in the order of <paramref name="scope"/>).</summary>
    /// <remarks>
    /// One table at a time, each delete its own statement, unless the tables refer to each other in a cycle - then no order
    /// works, and the deletes go as one transaction with the foreign key check deferred to its commit (see
    /// <see cref="CycleBatchExecutor"/>). A cycle the run cannot put in one transaction is left to fail as it always did.
    /// </remarks>
    /// <param name="scope">The tables of the run, parents first.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private static async Task<int[]> EmptyLocalTablesAsync(
        IReadOnlyList<ISyncTable> scope,
        CancellationToken cancellationToken
    )
    {
        var deleted = new int[scope.Count];

        if (CycleBatchExecutor(scope) is { } batch)
        {
            // The pragma lasts until the transaction ends, so nothing after the batch runs without the check.
            var statements = new List<string>(scope.Count + 1) { "PRAGMA defer_foreign_keys = ON" };

            for (var index = scope.Count - 1; index >= 0; index--)
            {
                statements.Add(((ISyncTableRunSupport)scope[index]).LocalDeleteAllSql);
            }

            IReadOnlyList<int> affected;

            using (SyncSession.Suppress())
            {
                affected = await batch
                    .ExecuteSqlBatchAsync(statements, cancellationToken)
                    .ConfigureAwait(false);
            }

            for (var index = scope.Count - 1; index >= 0; index--)
            {
                deleted[index] = affected[scope.Count - index];
            }

            return deleted;
        }

        // Children first: emptying a parent while its children are still there is what a foreign key forbids.
        for (var index = scope.Count - 1; index >= 0; index--)
        {
            deleted[index] = await scope[index]
                .DeleteAllLocalAsync(cancellationToken)
                .ConfigureAwait(false);
        }

        return deleted;
    }

    /// <summary>
    /// The executor that empties the run's tables in one transaction, or null when they are emptied one at a time: they
    /// form no foreign key cycle, or one of them is not a generated table, or they do not share one executor that can run a
    /// batch.
    /// </summary>
    /// <remarks>
    /// A table referring to itself is no cycle here - a single delete empties it. The references read are those of the
    /// diagram (<see cref="ISyncTableRunSupport.ReferencingTableNames"/>), restricted to the tables of the run.
    /// </remarks>
    private static ISqlBatchExecutor? CycleBatchExecutor(IReadOnlyList<ISyncTable> scope)
    {
        var supports = scope.OfType<ISyncTableRunSupport>().ToList();

        if (supports.Count < 2 || supports.Count != scope.Count)
        {
            return null;
        }

        var executor = supports[0].LocalSqlExecutor;

        if (
            executor is not ISqlBatchExecutor batch
            || supports.Any(support => !ReferenceEquals(support.LocalSqlExecutor, executor))
        )
        {
            return null;
        }

        var names = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);

        // Edges from a child to the parent it refers to, within the run.
        var parentsOf = names.ToDictionary(
            name => name,
            _ => new List<string>(),
            StringComparer.Ordinal
        );

        for (var index = 0; index < scope.Count; index++)
        {
            foreach (var child in supports[index].ReferencingTableNames)
            {
                if (
                    names.Contains(child)
                    && !string.Equals(child, scope[index].TableName, StringComparison.Ordinal)
                )
                {
                    parentsOf[child].Add(scope[index].TableName);
                }
            }
        }

        // A depth-first walk that meets a table still on its path has found a cycle.
        var onPath = new HashSet<string>(StringComparer.Ordinal);
        var done = new HashSet<string>(StringComparer.Ordinal);

        return names.Any(Reaches) ? batch : null;

        bool Reaches(string name)
        {
            if (done.Contains(name))
            {
                return false;
            }

            if (!onPath.Add(name))
            {
                return true;
            }

            var found = parentsOf[name].Any(Reaches);
            onPath.Remove(name);
            done.Add(name);

            return found;
        }
    }

    /// <summary>Replays the journal against the server and returns how many entries went and how many were dropped.</summary>
    /// <remarks>
    /// Each entry is settled - its receipt written, then the entry removed - the moment the server has taken it,
    /// rather than all of them at the end of the run. An upload interrupted part way then leaves behind entries for
    /// exactly the changes that did not reach the server; the whole-run alternative leaves entries for changes that
    /// did, and the next run resends them, reports a conflict against the row it wrote itself, or overwrites a newer
    /// server row with a stale local one.
    /// </remarks>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="conflicts">The collection the collected conflicts are added to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task<(int Uploaded, int Discarded)> UploadAsync(
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(options);
        ArgumentNullException.ThrowIfNull(conflicts);

        return _journal.Gate.RunExclusiveAsync<(int Uploaded, int Discarded)>(
            async () =>
            {
                await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

                var upload = await UploadCoreAsync(
                        options,
                        conflicts,
                        deferServerWins: false,
                        cancellationToken
                    )
                    .ConfigureAwait(false);

                return (upload.Uploaded, upload.Discarded);
            },
            cancellationToken
        );
    }

    /// <summary>The body of <see cref="UploadAsync"/>, run under the run lock.</summary>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="conflicts">The collection the collected conflicts are added to.</param>
    /// <param name="deferServerWins">
    /// Whether a <see cref="SyncConflictPolicy.ServerWins"/> run leaves applying the server's rows to the download that
    /// follows (what <see cref="SyncAsync"/> asks for) rather than doing it here.
    /// </param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<(
        int Uploaded,
        int Discarded,
        Dictionary<(string TableName, string KeyText), List<long>>? DeferredServerWins
    )> UploadCoreAsync(
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        bool deferServerWins,
        CancellationToken cancellationToken
    )
    {
        var entries = await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false);

        if (entries.Count == 0)
        {
            return (0, 0, null);
        }

        // The journal is append-only, so a row edited several times has several entries. Together they describe the
        // row, and they are settled together. A tuple key needs no separator, so two rows can never collide the way a
        // concatenated string key can when one table name is a prefix of another.
        var rows = new Dictionary<(string TableName, string KeyText), PendingRow>();

        foreach (var entry in entries)
        {
            var rowId = (entry.TableName, entry.KeyText);

            if (!rows.TryGetValue(rowId, out var row))
            {
                row = new PendingRow();
                rows.Add(rowId, row);
            }

            row.Add(entry);
        }

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);

        if (options.Mode == SyncMode.Versioned && options.ConflictPolicy == SyncConflictPolicy.ServerWins)
        {
            // Nothing local is worth sending, so each row this run holds an entry for takes the server's content
            // instead. Only the rows of the tables the run covers: an entry of a table outside it is not this run's to
            // discard, and it goes on counting as unsent - a delete of a parent there still holds its children back.
            // (A last-write-wins run consults the policy only for the conflicts below.)
            var serverWins = rows.Where(pair => scopeTableNames.Contains(pair.Key.TableName))
                .ToDictionary(pair => pair.Key, pair => pair.Value.Ids);

            if (deferServerWins)
            {
                // Applied table by table right after each table's download, parents first: a row put back may point
                // at a parent the server has changed or added since, and that parent is only here once its own table
                // has been downloaded.
                return (0, 0, serverWins);
            }

            var dropped = await ApplyServerWinsAsync(
                    scope,
                    serverWins,
                    options.IncludeUnboundedBinary,
                    cancellationToken
                )
                .ConfigureAwait(false);

            return (0, dropped, null);
        }

        var uploaded = 0;
        var discarded = 0;
        var plans = new List<TableReplayPlan>(scope.Count);

        // A last-write-wins run has no version to decide a conflict by, so the policy has nothing to say about the
        // write itself. The three conflicts the server refuses a write for are the exception (two for a foreign key, one
        // for a unique value): the row will not go up until something changes. ServerWins settles them the way it
        // settles everything in a versioned run - the entries go, and the row takes the server's content - which is the
        // one way to settle a row of a table without a version, since no versioned run ever reaches it.
        var settled =
            options.Mode == SyncMode.LastWriteWins
            && options.ConflictPolicy == SyncConflictPolicy.ServerWins
                ? new Dictionary<(string TableName, string KeyText), List<long>>()
                : null;

        foreach (var table in scope)
        {
            // Planned and the discards settled under the write lock, as one step. The entries were read before the
            // lock, so one of them can belong to a write the application is still in the middle of - recorded, its
            // business write not yet landed. Looking at the local row then would see the row as it was before that
            // write, and settling on what it saw would drop the entry of a write that lands a moment later. Inside the
            // lock every such write has finished, so what the row is now is what the entries describe. Writes the
            // application starts afterwards record entries of their own, which this run never read and never drops.
            var plan = await _journal
                .Gate.WriteExclusiveAsync(
                    async () =>
                    {
                        // An entry still under the unset key once the lock is held is one a write left behind
                        await _journal
                            .RemoveUnsetKeyEntriesAsync(table.TableName, cancellationToken)
                            .ConfigureAwait(false);

                        var planned = await PlanReplayAsync(table, rows, cancellationToken)
                            .ConfigureAwait(false);

                        // A row there is nothing to send for is settled straight away, as a discard.
                        foreach (var ids in planned.Discards)
                        {
                            await RemoveAsync(ids, cancellationToken).ConfigureAwait(false);
                        }

                        return planned;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
            plans.Add(plan);
            discarded += plan.Discards.Count;
        }

        // An upsert whose unique values the server still holds under a row this run deletes goes after the deletes,
        // with the upserts that refer to it - see FindUpsertsToDeferAsync.
        var deferred = await FindUpsertsToDeferAsync(plans, cancellationToken)
            .ConfigureAwait(false);

        // The run goes in rounds (see RunRoundAsync). The first sends every planned entry; each later one sends again
        // what the server refused for a foreign key or a unique value in the round before, as long as some write of
        // that round went through - it may be what freed the way. There are never more rounds than entries, since each
        // needs a write of the one before. What is still refused when no write goes through any more is reported - or,
        // in a last-write-wins ServerWins run, settled - and only that.
        var remaining = plans.Select(plan => new ReplayRound(plan, plan.Upserts, plan.Deletes)).ToList();
        var rounds = plans.Sum(plan => plan.Upserts.Count + plan.Deletes.Count);

        for (var round = 0; ; round++)
        {
            var refused = new List<RefusedWrite>();
            var uploadedBefore = uploaded;
            await RunRoundAsync(remaining, refused).ConfigureAwait(false);

            if (refused.Count == 0)
            {
                break;
            }

            if (uploaded == uploadedBefore || round + 1 >= rounds)
            {
                foreach (var write in refused)
                {
                    SettleOrCollect(write);
                }

                break;
            }

            var again = refused.Select(write => (write.Plan.Table.TableName, write.Entry.KeyText)).ToHashSet();
            remaining = plans
                .Select(plan => new ReplayRound(
                    plan,
                    plan.Upserts.Where(upsert => again.Contains((plan.Table.TableName, upsert.Entry.KeyText))).ToList(),
                    plan.Deletes.Where(delete => again.Contains((plan.Table.TableName, delete.Entry.KeyText))).ToList()
                ))
                .ToList();
        }

        if (settled is not { Count: > 0 })
        {
            return (uploaded, discarded, null);
        }

        if (deferServerWins)
        {
            // Applied after each table's download, parents first, exactly like a versioned ServerWins run.
            return (uploaded, discarded, settled);
        }

        discarded += await ApplyServerWinsAsync(
                scope,
                settled,
                options.IncludeUnboundedBinary,
                cancellationToken
            )
            .ConfigureAwait(false);

        return (uploaded, discarded, null);

        // One round: upserts parents first so a child never reaches the server before the row it points at, deletes
        // the other way round, children first, and the deferred upserts last, parents first again, once the deletes
        // have freed the values they need.
        async Task RunRoundAsync(List<ReplayRound> round, List<RefusedWrite> refused)
        {
            foreach (var (plan, upserts, _) in round)
            {
                await ReplayStageAsync(
                        plan,
                        upserts
                            .Where(upsert => !deferred.Contains((plan.Table.TableName, upsert.Entry.KeyText)))
                            .ToList(),
                        refused
                    )
                    .ConfigureAwait(false);
            }

            for (var index = round.Count - 1; index >= 0; index--)
            {
                await ReplayStageAsync(round[index].Plan, round[index].Deletes, refused).ConfigureAwait(false);
            }

            if (deferred.Count > 0)
            {
                foreach (var (plan, upserts, _) in round)
                {
                    await ReplayStageAsync(
                            plan,
                            upserts
                                .Where(upsert => deferred.Contains((plan.Table.TableName, upsert.Entry.KeyText)))
                                .ToList(),
                            refused
                        )
                        .ConfigureAwait(false);
                }
            }
        }

        async Task ReplayStageAsync(
            TableReplayPlan plan,
            IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> entries,
            List<RefusedWrite> refused
        )
        {
            if (entries.Count == 0)
            {
                return;
            }

            var refusedHere = new List<((SyncJournalRow Entry, List<long> Ids) Planned, SyncConflict Conflict)>();
            var (sent, dropped) = await ReplayPassAsync(
                    plan.Table,
                    entries,
                    plan.Acknowledged,
                    plan.DeletesIfGone,
                    conflicts,
                    refusedHere,
                    options,
                    cancellationToken
                )
                .ConfigureAwait(false);
            uploaded += sent;
            discarded += dropped;

            foreach (var ((entry, ids), conflict) in refusedHere)
            {
                refused.Add(new RefusedWrite(plan, entry, ids, conflict));
            }
        }

        // A write the server refused and no round got past: in a last-write-wins ServerWins run it goes to the rows the
        // server wins over; otherwise it is reported.
        void SettleOrCollect(RefusedWrite write)
        {
            if (settled is null)
            {
                conflicts.Add(write.Conflict);
            }
            else
            {
                settled[(write.Plan.Table.TableName, write.Conflict.KeyText)] = write.Ids;
            }
        }
    }

    /// <summary>The entries of one table a round of the replay sends.</summary>
    private sealed record ReplayRound(
        TableReplayPlan Plan,
        IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> Upserts,
        IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> Deletes
    );

    /// <summary>A write the server refused for a foreign key or a unique value, which the next round sends again.</summary>
    private sealed record RefusedWrite(
        TableReplayPlan Plan,
        SyncJournalRow Entry,
        List<long> Ids,
        SyncConflict Conflict
    );

    /// <summary>Decides, for every row of one table the journal holds entries for, what the replay sends.</summary>
    /// <remarks>
    /// <para>
    /// The decision is made from what the local row is now and from everything recorded about it, never from the last
    /// entry alone. The journal is written before the business write, so its last entry can describe a write that
    /// never landed - and acting on that one would throw away whatever the earlier entries were about.
    /// </para>
    /// <list type="table">
    /// <listheader><term>Local row</term><description>What the replay does</description></listheader>
    /// <item><term>There, with an insert or update recorded</term><description>Sends its current content.</description></item>
    /// <item><term>There, with only deletes recorded</term><description>Drops the entries: the delete never landed.</description></item>
    /// <item><term>Gone, with a delete recorded and a server version known</term><description>Deletes it on the server, guarded by the latest version the server is known to have held (the deletes' recorded versions and the receipt).</description></item>
    /// <item><term>Gone, otherwise</term><description>Drops the entries: the row never reached the server.</description></item>
    /// </list>
    /// <para>
    /// A table without a version column has no version to know, so a delete recorded for a row that is gone is sent
    /// unconditionally. A table the fixed classes do not implement has no way to report which rows are there, and its
    /// rows are replayed by the last entry, as they always were.
    /// </para>
    /// <para>
    /// The entries are read again here, under the write lock, and grouped by the key they hold now. The run read them
    /// before the lock, and a write in progress then could have moved one of them to another key afterwards - a new row
    /// whose key a save hook set, which the write's check moves its entry to. Grouped by the key read first, the entry
    /// would be decided by a row that does not exist and dropped by its id, the moved entry with it. Only the entries
    /// the run read are taken: one recorded after the read belongs to a write this run never saw.
    /// </para>
    /// </remarks>
    private async Task<TableReplayPlan> PlanReplayAsync(
        ISyncTable table,
        Dictionary<(string TableName, string KeyText), PendingRow> rows,
        CancellationToken cancellationToken
    )
    {
        var readIds = rows.Where(pair =>
                string.Equals(pair.Key.TableName, table.TableName, StringComparison.Ordinal)
            )
            .SelectMany(pair => pair.Value.Ids)
            .ToHashSet();
        var regrouped = new Dictionary<(string TableName, string KeyText), PendingRow>();

        if (readIds.Count > 0)
        {
            foreach (
                var entry in await _journal
                    .ReadTableAsync(table.TableName, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                if (!readIds.Contains(entry.Id))
                {
                    continue;
                }

                var rowId = (entry.TableName, entry.KeyText);

                if (!regrouped.TryGetValue(rowId, out var row))
                {
                    row = new PendingRow();
                    regrouped.Add(rowId, row);
                }

                row.Add(entry);
            }
        }

        var tableRows = regrouped.OrderBy(pair => pair.Value.Ids[0]).ToList();
        var plan = new TableReplayPlan(table);

        if (tableRows.Count == 0)
        {
            return plan;
        }

        // Read once for this table's pass: the receipts of the keys about to be replayed are what their version
        // guards are read against.
        plan.Acknowledged = await _journal
            .ReadAcksAsync(table.TableName, cancellationToken)
            .ConfigureAwait(false);
        var localKeyTexts = table is ISyncTableRunSupport support
            ? await support
                .FindLocalKeyTextsAsync(
                    tableRows.Select(pair => pair.Key.KeyText).ToList(),
                    cancellationToken
                )
                .ConfigureAwait(false)
            : null;

        foreach (var (rowId, row) in tableRows)
        {
            var operation = localKeyTexts is null
                ? row.LatestOperation
                : Decide(
                    row,
                    localKeyTexts.Contains(rowId.KeyText),
                    table.IsVersionless,
                    plan.Acknowledged.TryGetValue(rowId.KeyText, out var acknowledged)
                        ? acknowledged
                        : null
                );

            switch (operation)
            {
                case SyncJournalOperation.Upsert:
                    // A row deleted and created again under the same key carries the version the server held for
                    // the row it deleted: the new local row has no mirrored version of its own, and without it the
                    // upload takes the row for one the server has never seen and inserts it (see UploadUpsertAsync).
                    plan.Upserts.Add(
                        (row.ToEntry(rowId, SyncJournalOperation.Upsert, row.DeletedRowVersion), row.Ids)
                    );

                    // The row may be deleted again after this plan, before its upsert is sent: the upsert then finds
                    // nothing to send, and the delete these entries hold is what is left of them. Decided here, with
                    // the row taken for gone, by the same rule - the delete the application has just recorded carries
                    // no version of its own when the row was recreated, so it alone could not be sent.
                    if (
                        localKeyTexts is not null
                        && Decide(
                            row,
                            existsLocally: false,
                            table.IsVersionless,
                            plan.Acknowledged.TryGetValue(rowId.KeyText, out var acknowledgedIfGone)
                                ? acknowledgedIfGone
                                : null
                        ) == SyncJournalOperation.Delete
                    )
                    {
                        plan.DeletesIfGone[rowId.KeyText] = row.ToEntry(
                            rowId,
                            SyncJournalOperation.Delete,
                            row.DeletedRowVersion
                        );
                    }

                    break;

                case SyncJournalOperation.Delete:
                    plan.Deletes.Add(
                        (
                            row.ToEntry(
                                rowId,
                                SyncJournalOperation.Delete,
                                localKeyTexts is null ? row.LatestRowVersion : row.DeletedRowVersion
                            ),
                            row.Ids
                        )
                    );
                    break;

                default:
                    plan.Discards.Add(row.Ids);
                    break;
            }
        }

        return plan;
    }

    /// <summary>The operation a row's replay sends, or null when there is nothing to send (see <see cref="PlanReplayAsync"/>).</summary>
    /// <param name="row">Everything the journal holds about the row.</param>
    /// <param name="existsLocally">Whether the local table holds the row now.</param>
    /// <param name="versionless">Whether the table has no version column.</param>
    /// <param name="acknowledged">The receipt of the row, or null when there is none.</param>
    private static SyncJournalOperation? Decide(
        PendingRow row,
        bool existsLocally,
        bool versionless,
        byte[]? acknowledged
    )
    {
        if (existsLocally)
        {
            return row.HasUpsert ? SyncJournalOperation.Upsert : null;
        }

        if (!row.HasDelete)
        {
            return null;
        }

        return versionless || SyncRowVersions.Max(row.DeletedRowVersion, acknowledged) is not null
            ? SyncJournalOperation.Delete
            : null;
    }

    /// <summary>
    /// Settles the run's journal entries in the server's favour: each row they name takes the server's content, and the
    /// entries go. Returns how many entries were dropped.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Scoped to the tables the run covers - an entry of an excluded or out-of-mode table is not this run's to decide
    /// about, so it stays for the run that does cover it.
    /// </para>
    /// <para>
    /// The download alone cannot stand in for this: it only carries rows the server has changed since they were last
    /// mirrored, and a local edit to a row nobody else has touched would survive the run that was told to discard it -
    /// with its entry gone, for good.
    /// </para>
    /// <para>
    /// Each table is settled under the write lock, parents first (a row put back may be the one another row points
    /// at), and the journal is read again inside it. What is dropped is exactly the entries the run read at its start, of
    /// the rows it put back: a key that has picked up a newer entry since - the application kept writing while the run was
    /// in flight - is left with its content untouched, because the newer edit is not one the caller asked to discard, and
    /// with every entry it has, the ones the run read included. The content still carries what those describe (a blob
    /// written, a delete holding the version the server has the row at), and the next run sends it along with the newer
    /// edit; dropping them alone would leave the content and the journal disagreeing for good.
    /// </para>
    /// <para>
    /// Within a table the order is apply, record the receipts, drop the entries. The applied row's local content is the
    /// server's content at the version just read, and the mirrored version deliberately does not say so; the receipt is
    /// the only thing that does. Interrupted either side of the receipts the run is still sound: before them, the
    /// entries stay and the next run applies the same rows and records them then; after them but before the entries
    /// go, the next run applies the same rows again - which changes nothing - and writes the same receipts over
    /// themselves. The other order would leave a local edit standing with nothing left to say it is there.
    /// </para>
    /// </remarks>
    private async Task<int> ApplyServerWinsAsync(
        IReadOnlyList<ISyncTable> scope,
        Dictionary<(string TableName, string KeyText), List<long>> idsByRow,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var discarded = 0;
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        IReadOnlySet<long> droppedIds = idsByRow.Values.SelectMany(ids => ids).ToHashSet();

        foreach (var table in scope)
        {
            var rows = idsByRow
                .Where(pair =>
                    string.Equals(pair.Key.TableName, table.TableName, StringComparison.Ordinal)
                )
                .OrderBy(pair => pair.Value[0])
                .ToList();

            if (rows.Count == 0)
            {
                continue;
            }

            var (dropped, _) = await _journal
                .Gate.WriteExclusiveAsync(
                    () =>
                        ApplyServerWinsToTableAsync(
                            table,
                            rows,
                            includeUnboundedBinary,

                            // An upload on its own is followed by no delete propagation, so a row the server does not
                            // have stays where it is, as it always did.
                            propagateDeletes: false,
                            droppedIds,
                            idsByRow,
                            scopeTableNames,
                            cancellationToken
                        ),
                    cancellationToken
                )
                .ConfigureAwait(false);
            discarded += dropped;
        }

        return discarded;
    }

    /// <summary>Settles one table's entries in the server's favour (see <see cref="ApplyServerWinsAsync"/>); runs under the write lock.</summary>
    /// <remarks>
    /// A row put back can refer to a parent the local database does not have. The parent is brought in first when the
    /// run may (see <see cref="SyncParentResolver"/>); a row whose parent it may not bring in - the parent's table is
    /// outside the run, or the parent has an unsent delete the run is not discarding - is left as it is, and its entries
    /// stay for a run that can settle it.
    /// <para>
    /// The run read the entries before taking the lock. The ones it read are grouped here by the key each holds now: a
    /// new row whose key a save hook set had its entry moved to that key by the write in progress, and the row is put
    /// back, its entries dropped and the drop reported under the key it has. An entry the run itself has dropped on the
    /// way keeps the key it was read under.
    /// </para>
    /// </remarks>
    /// <param name="table">The table.</param>
    /// <param name="rows">The table's rows the run settles, with the entries of each, as the run read them.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="propagateDeletes">Whether a delete propagation follows in the run: a row the server does not have is then removed before the server's rows are put back rather than after (see <see cref="ISyncTableRunSupport.ApplyServerRowsAsync"/>).</param>
    /// <param name="droppedIds">Every entry the run is settling this way (they hold no parent back).</param>
    /// <param name="discarding">Every row the run is settling this way, with its entries (see <see cref="SyncParentResolver.RemoveRowsKeepingHoldersAsync"/>).</param>
    /// <param name="scopeTableNames">The tables the run covers.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The entries dropped, and the local rows removed because the server does not have them.</returns>
    private async Task<(int Dropped, int Removed)> ApplyServerWinsToTableAsync(
        ISyncTable table,
        IReadOnlyList<KeyValuePair<(string TableName, string KeyText), List<long>>> rows,
        bool includeUnboundedBinary,
        bool propagateDeletes,
        IReadOnlySet<long> droppedIds,
        IReadOnlyDictionary<(string TableName, string KeyText), List<long>> discarding,
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    )
    {
        // The entries are read again here, under the lock, and the ones the run read are grouped by the key they hold
        // now (as PlanReplayAsync does): a write in progress when the run read them may have moved one to the key its
        // save hook gave the row since, and the row is put back and reported under that key, not the one read first. An
        // entry the run has already dropped on the way (the delete propagation before the download) keeps the key read.
        var readIds = rows.SelectMany(pair => pair.Value).ToHashSet();
        var entries = await _journal
            .ReadTableAsync(table.TableName, cancellationToken)
            .ConfigureAwait(false);
        var keyNow = entries
            .Where(entry => readIds.Contains(entry.Id))
            .ToDictionary(entry => entry.Id, entry => entry.KeyText);
        rows =
        [
            .. rows.SelectMany(pair =>
                    pair.Value.Select(id =>
                        (KeyText: keyNow.TryGetValue(id, out var keyText) ? keyText : pair.Key.KeyText, Id: id)
                    )
                )
                .GroupBy(entry => entry.KeyText, StringComparer.Ordinal)
                .Select(group => new KeyValuePair<(string TableName, string KeyText), List<long>>(
                    (table.TableName, group.Key),
                    group.Select(entry => entry.Id).Order().ToList()
                ))
                .OrderBy(pair => pair.Value[0]),
        ];

        // The keys that picked up an entry the run did not read: their newer local edit stands.
        var editedSince = entries
            .Where(entry => !readIds.Contains(entry.Id))
            .Select(entry => entry.KeyText)
            .ToHashSet(StringComparer.Ordinal);
        var keyTexts = rows.Select(pair => pair.Key.KeyText)
            .Where(keyText => !editedSince.Contains(keyText))
            .ToList();

        IReadOnlyList<string> held = [];
        IReadOnlyList<string> removed = [];

        if (keyTexts.Count > 0)
        {
            IReadOnlyList<SyncAppliedServerRow> applied;

            if (table is ISyncTableRunSupport support)
            {
                var pending = await ReadPendingAsync(table.TableName, droppedIds, cancellationToken)
                    .ConfigureAwait(false);
                (applied, held, removed) = await support
                    .ApplyServerRowsAsync(
                        keyTexts,
                        includeUnboundedBinary,
                        propagateDeletes,
                        new SyncParentResolver(
                            _tables,
                            scopeTableNames,
                            pending,
                            _journal,
                            includeUnboundedBinary,
                            propagateDeletes,
                            _changeLog,
                            discarding
                        ),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }
            else
            {
                applied = await table
                    .ApplyServerRowsAsync(keyTexts, includeUnboundedBinary, cancellationToken)
                    .ConfigureAwait(false);
            }

            foreach (var row in applied)
            {
                // A table with no version has nothing to acknowledge (and no versioned run to reach it here).
                if (row.ServerRowVersion is not { Length: > 0 } serverRowVersion)
                {
                    continue;
                }

                await _journal
                    .RecordAckAsync(table.TableName, row.KeyText, serverRowVersion, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        // A removed row takes its receipt with it, as in the delete propagation.
        if (removed.Count > 0)
        {
            await _journal
                .RemoveAcksAsync(table.TableName, removed, cancellationToken)
                .ConfigureAwait(false);
        }

        // A key edited since the run read its entries was not put back (see keyTexts), so its local content still carries
        // what those entries describe - a blob written, a delete holding the version the server has the row at. They stay
        // with the row alongside the newer entries, for the next run to send: dropped, the content and the journal would
        // disagree for good (the blob never goes up; the recreated row goes up as an insert the server refuses).
        var dropRows = rows.Where(pair =>
                !held.Contains(pair.Key.KeyText, StringComparer.Ordinal)
                && !editedSince.Contains(pair.Key.KeyText)
            )
            .ToList();
        var dropIds = dropRows.SelectMany(pair => pair.Value).ToList();
        await RemoveAsync(dropIds, cancellationToken).ConfigureAwait(false);

        if (_changeLog is { } changes)
        {
            foreach (var pair in dropRows)
            {
                changes.Add(
                    table.TableName,
                    pair.Key.KeyText,
                    SyncLocalRowChangeReason.DiscardedByServerWins
                );
            }

            foreach (var keyText in removed)
            {
                changes.Add(table.TableName, keyText, SyncLocalRowChangeReason.RemovedBeforeDownload);
            }
        }

        return (dropIds.Count, removed.Count);
    }

    /// <summary>
    /// Finds the upserts that have to wait until the run's deletes have gone: the ones whose unique values the server
    /// still holds under another row, and the upserts that refer to one of those.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Upserts go before deletes, parents first, and deletes after, children first - the order the foreign keys need.
    /// A row deleted here and recreated under another key with the same unique value turns that around: the insert
    /// reaches the server while the old row still holds the value, and the server refuses it. So in a table the run
    /// also deletes rows of, each upsert is checked against the server's unique constraints first, and one that would
    /// collide goes after the deletes. If it still collides then - the delete it waited for did not go through - it is
    /// reported as <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>.
    /// </para>
    /// <para>
    /// An upsert that refers to a deferred row - in another table, or in the same table - goes with it: sent before its
    /// parent, it would be refused for the parent the server does not have yet. The check costs a round trip per upsert,
    /// and only in a table with deletes in the same run.
    /// </para>
    /// </remarks>
    private async Task<HashSet<(string TableName, string KeyText)>> FindUpsertsToDeferAsync(
        IReadOnlyList<TableReplayPlan> plans,
        CancellationToken cancellationToken
    )
    {
        var deferred = new HashSet<(string TableName, string KeyText)>();

        foreach (var plan in plans)
        {
            if (
                plan.Deletes.Count == 0
                || plan.Upserts.Count == 0
                || plan.Table is not ISyncTableRunSupport support
            )
            {
                continue;
            }

            foreach (var (entry, _) in plan.Upserts)
            {
                if (
                    await support
                        .CollidesOnServerAsync(entry.KeyText, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    deferred.Add((plan.Table.TableName, entry.KeyText));
                }
            }
        }

        if (deferred.Count == 0)
        {
            return deferred;
        }

        // The rows that refer to a deferred row, as far as it reaches.
        var parentsOf = new Dictionary<(string TableName, string KeyText), IReadOnlyList<(string TableName, string KeyText)>>();

        foreach (var plan in plans)
        {
            if (plan.Table is not ISyncTableRunSupport support)
            {
                continue;
            }

            foreach (var (entry, _) in plan.Upserts)
            {
                if (!deferred.Contains((plan.Table.TableName, entry.KeyText)))
                {
                    var (_, parents) = await support
                        .ReadLocalParentsAsync(entry.KeyText, cancellationToken)
                        .ConfigureAwait(false);
                    parentsOf[(plan.Table.TableName, entry.KeyText)] = parents;
                }
            }
        }

        for (var changed = true; changed; )
        {
            changed = false;

            foreach (var (row, parents) in parentsOf)
            {
                if (!deferred.Contains(row) && parents.Any(deferred.Contains))
                {
                    deferred.Add(row);
                    changed = true;
                }
            }
        }

        return deferred;
    }

    /// <summary>Replays the planned entries of one table once, in the order they were first recorded.</summary>
    /// <remarks>
    /// <para>
    /// The receipt is written <i>before</i> the entry is removed, which is what a crash between the two is measured
    /// against: both records survive, the next run replays the same local content with the acknowledged version as its
    /// original, and the server takes it again. The other order leaves the row with a stale mirror and no receipt to
    /// correct it, and the next version-guarded replay of that key reports a conflict with nobody.
    /// </para>
    /// <para>
    /// A delete that reached the server goes the other way: the row is gone, so its receipt is dropped rather than
    /// written, and dropping it first means a crash in between leaves an entry whose replay deletes a row the server
    /// no longer has - a no-op.
    /// </para>
    /// <para>
    /// An upsert that finds nothing to send after all - its row has gone since it was planned - drops the entries without
    /// taking the lock, and that is sound. They are the entries the plan looked at under the lock, so every write they
    /// describe had finished by then; whatever the application has done to the row since was recorded in entries of its
    /// own, which this run never read and leaves where they are.
    /// </para>
    /// <para>
    /// The two ways the row can have changed since the plan each keep what the newer entries need. An upsert whose row
    /// has gone but whose entries hold a delete the server can be told about sends that delete instead
    /// (<paramref name="deletesIfGone"/>): the row was deleted again, and dropping the entries would leave only the new
    /// delete, which carries no version when the row had been recreated. A delete whose row is back - created again
    /// under the same key, which the entry recorded since the run read these shows - leaves its entries in the journal:
    /// they hold the version the server has the row at, which the recreation's own entry does not, and the next run sends
    /// the row as an update guarded by it rather than as an insert the server refuses as a duplicate. A delete that finds
    /// the row there with nothing recorded since is one whose business write never landed, and its entries are dropped:
    /// kept, a table the fixed classes do not implement - planned by its last entry rather than by the row - would plan
    /// the same delete and find the row again on every run.
    /// </para>
    /// <para>
    /// A write the server refuses for a foreign key or a unique value goes to <paramref name="refused"/>, and the run sends
    /// it again in its next round (see <see cref="UploadCoreAsync"/>): another write of the run - of this table or
    /// another, in this stage or a later one - may be what frees the way, such as the update that gives up the unique
    /// value an earlier entry takes, or the move of the last child of a row whose delete was refused.
    /// </para>
    /// </remarks>
    private async Task<(int Uploaded, int Discarded)> ReplayPassAsync(
        ISyncTable table,
        IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> planned,
        IReadOnlyDictionary<string, byte[]> acknowledged,
        IReadOnlyDictionary<string, SyncJournalRow> deletesIfGone,
        ICollection<SyncConflict> conflicts,
        List<((SyncJournalRow Entry, List<long> Ids) Planned, SyncConflict Conflict)> refused,
        SyncOptions options,
        CancellationToken cancellationToken
    )
    {
        var uploaded = 0;
        var discarded = 0;

        foreach (var (plannedEntry, ids) in planned)
        {
            var entry = plannedEntry;
            var outcome = await SendAsync(entry).ConfigureAwait(false);

            if (
                outcome is { Sent: false, Conflict: null }
                && string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Upsert),
                    StringComparison.Ordinal
                )
                && deletesIfGone.TryGetValue(entry.KeyText, out var deleteIfGone)
            )
            {
                entry = deleteIfGone;
                outcome = await SendAsync(entry).ConfigureAwait(false);
            }

            if (outcome.Conflict is { } conflict)
            {
                // The entries stay in the journal so the caller can decide and re-run - unless the server refused the
                // write for a foreign key or a unique value, which the run's next round may get past.
                if (
                    conflict.Reason
                    is SyncConflictReason.ParentMissingOnServer
                        or SyncConflictReason.DeleteRefusedOnServer
                        or SyncConflictReason.UniqueValueTakenOnServer
                )
                {
                    refused.Add(((entry, ids), conflict));
                }
                else
                {
                    conflicts.Add(conflict);
                }

                continue;
            }

            if (
                outcome is { Sent: false }
                && string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
                && await HasEntriesRecordedSinceAsync(table.TableName, entry.KeyText, ids)
                    .ConfigureAwait(false)
            )
            {
                // The row is back because the application created it again under the same key after the run read these
                // entries, in a write that recorded an entry of its own. The entries planned here hold the version the
                // server still has the row at, and the new entry carries none, so dropping them would send the new row
                // up as an insert the server refuses as a duplicate. They stay with the row instead, and the next run
                // sends it as an update guarded by that version (see PlanReplayAsync). A row there with nothing recorded
                // since - a delete whose business write never landed - has nothing to keep them for, and they go as
                // before: kept, a table planned by its last entry would plan the same delete and find the row on every run.
                continue;
            }

            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                if (outcome.Sent)
                {
                    await _journal
                        .RemoveAcksAsync(table.TableName, [entry.KeyText], cancellationToken)
                        .ConfigureAwait(false);
                }
            }
            else if (outcome.ServerRowVersion is { Length: > 0 } serverRowVersion)
            {
                await _journal
                    .RecordAckAsync(
                        table.TableName,
                        entry.KeyText,
                        serverRowVersion,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            await RemoveAsync(ids, cancellationToken).ConfigureAwait(false);

            // A settled entry that never reached the server (a stale intent) is a discard, not an upload:
            // counting it as one would report a change as delivered when nothing was sent.
            if (outcome.Sent)
            {
                uploaded++;
            }
            else
            {
                discarded++;
            }
        }

        return (uploaded, discarded);

        // Whether the journal holds an entry for the row besides the ones the run read: a write recorded after them
        async Task<bool> HasEntriesRecordedSinceAsync(
            string tableName,
            string keyText,
            IReadOnlyCollection<long> readIds
        ) =>
            (await _journal.ReadTableAsync(tableName, cancellationToken).ConfigureAwait(false)).Any(
                recorded =>
                    string.Equals(recorded.KeyText, keyText, StringComparison.Ordinal)
                    && !readIds.Contains(recorded.Id)
            );

        // Only the call that writes to the server is guarded: a failure of the local receipt or of the journal clean-up
        // is the local database's own, and reporting it as a refusal by the server would hide it.
        async Task<SyncUploadOutcome> SendAsync(SyncJournalRow entry)
        {
            try
            {
                return await table
                    .UploadAsync(
                        entry,
                        options.Mode,
                        options.ConflictPolicy,
                        options.IncludeUnboundedBinary,
                        acknowledged.TryGetValue(entry.KeyText, out var acknowledgedRowVersion)
                            ? acknowledgedRowVersion
                            : null,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }
            catch (Exception exception)
                when (exception is not OperationCanceledException
                    && table is ISyncTableRunSupport support
                )
            {
                SyncConflict? refusal;

                try
                {
                    refusal = await ExplainServerRefusalAsync(
                            table,
                            support,
                            entry,
                            options.DownloadBatchSize,
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }
                catch (Exception checkFailure) when (checkFailure is not OperationCanceledException)
                {
                    // Neither failure can stand for the other: the write's says what went wrong, the check's why it could
                    // not be told whether the server refused it. The entry stays, and the next run sends it again.
                    throw new AggregateException(
                        $"Writing row '{entry.KeyText}' of table '{table.TableName}' to the server failed (the first "
                            + "inner exception), and checking whether the server refused it for a foreign key or a "
                            + "unique value failed too (the second); the entry stays and the next run sends it again.",
                        exception,
                        checkFailure
                    );
                }

                if (refusal is null)
                {
                    System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(exception).Throw();
                    throw;
                }

                return SyncUploadOutcome.Conflicted(refusal);
            }
        }
    }

    /// <summary>
    /// Works out whether a write the server failed is one it refused for a foreign key or a unique value, and returns the
    /// conflict to report (null when it is not, or when the question cannot be answered).
    /// </summary>
    /// <remarks>
    /// <para>
    /// Asked only after the write has failed, so the run makes no extra call while nothing goes wrong. The failure itself
    /// cannot say why: over HTTP the server's foreign key error arrives as a 500 with its details withheld. So the state
    /// the failure would follow from is looked up instead.
    /// </para>
    /// <list type="bullet">
    /// <item>An upsert whose local row refers to a parent the server no longer holds is
    /// <see cref="SyncConflictReason.ParentMissingOnServer"/>.</item>
    /// <item>A delete of a row the server still holds is <see cref="SyncConflictReason.DeleteRefusedOnServer"/> when a
    /// row the server holds refers to it. The check covers the synchronised tables that refer to it by its primary key,
    /// reading their server rows; a referring table outside that reach - one the engine does not synchronise, or one
    /// whose foreign key refers to a unique constraint or spans several columns - cannot be asked, and its presence
    /// alone keeps the delete reported as refused.</item>
    /// <item>An upsert whose local row's unique values another row holds on the server - the server's own uniqueness
    /// check, asked with the local row - is <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>.</item>
    /// </list>
    /// <para>
    /// Anything else is not explained, and the caller throws the original failure: a dropped connection must not turn
    /// into a conflict the run quietly moves past. A lookup that fails in turn throws, and the caller throws both
    /// failures together.
    /// </para>
    /// </remarks>
    private async Task<SyncConflict?> ExplainServerRefusalAsync(
        ISyncTable table,
        ISyncTableRunSupport support,
        SyncJournalRow entry,
        int batchSize,
        CancellationToken cancellationToken
    )
    {
        if (
            string.Equals(entry.Operation, nameof(SyncJournalOperation.Delete), StringComparison.Ordinal)
        )
        {
            if (!support.IsReferenced)
            {
                return null;
            }

            var server = await support
                .ReadServerRowAsync(entry.KeyText, cancellationToken)
                .ConfigureAwait(false);

            return server is null
                || !await IsReferencedOnServerAsync(
                        table.TableName,
                        support,
                        entry.KeyText,
                        batchSize,
                        cancellationToken
                    )
                    .ConfigureAwait(false)
                ? null
                : new SyncConflict(
                    table.TableName,
                    entry.KeyText,
                    SyncJournalOperation.Delete,
                    SyncConflictReason.DeleteRefusedOnServer,
                    null,
                    server
                );
        }

        var (local, parents) = await support
            .ReadLocalParentsAsync(entry.KeyText, cancellationToken)
            .ConfigureAwait(false);

        foreach (var (parentTableName, parentKeyText) in parents)
        {
            if (
                _tables.FirstOrDefault(candidate =>
                    string.Equals(candidate.TableName, parentTableName, StringComparison.Ordinal)
                )
                is not ISyncTableRunSupport parent
            )
            {
                continue;
            }

            if (
                await parent.ReadServerRowAsync(parentKeyText, cancellationToken).ConfigureAwait(false)
                is null
            )
            {
                return new SyncConflict(
                    table.TableName,
                    entry.KeyText,
                    SyncJournalOperation.Upsert,
                    SyncConflictReason.ParentMissingOnServer,
                    local,
                    null
                );
            }
        }

        if (
            local is not null
            && await support
                .CollidesOnServerAsync(entry.KeyText, cancellationToken)
                .ConfigureAwait(false)
        )
        {
            return new SyncConflict(
                table.TableName,
                entry.KeyText,
                SyncJournalOperation.Upsert,
                SyncConflictReason.UniqueValueTakenOnServer,
                local,
                null
            );
        }

        return null;
    }

    /// <summary>
    /// Whether a row the server holds refers to the given row, as far as it can be told; a referring table that cannot be
    /// asked counts as referring, which is what the delete was reported as before the rows were looked at. Rows that
    /// cannot be read just now throw: a passing failure must not turn into a refusal.
    /// </summary>
    private async Task<bool> IsReferencedOnServerAsync(
        string tableName,
        ISyncTableRunSupport support,
        string keyText,
        int batchSize,
        CancellationToken cancellationToken
    )
    {
        if (support.UnlistedReferencingTableNames.Count > 0)
        {
            return true;
        }

        foreach (var referringTableName in support.ReferencingTableNames)
        {
            if (
                _tables.FirstOrDefault(candidate =>
                    string.Equals(candidate.TableName, referringTableName, StringComparison.Ordinal)
                )
                is not ISyncTableRunSupport referring
            )
            {
                return true;
            }

            if (
                await referring
                    .HasServerRowReferringToAsync(tableName, keyText, batchSize, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>Everything the journal holds about one row, folded from its entries in the order they were recorded.</summary>
    private sealed class PendingRow
    {
        /// <summary>The ids of every entry about the row, oldest first (they are settled together).</summary>
        public List<long> Ids { get; } = [];

        /// <summary>Whether any entry records an insert or an update.</summary>
        public bool HasUpsert { get; private set; }

        /// <summary>Whether any entry records a delete.</summary>
        public bool HasDelete { get; private set; }

        /// <summary>The latest of the versions the row's delete entries carried (null when none carried one).</summary>
        public byte[]? DeletedRowVersion { get; private set; }

        /// <summary>The operation of the newest entry (what a table outside the fixed classes is replayed by).</summary>
        public SyncJournalOperation LatestOperation { get; private set; }

        /// <summary>The version the newest entry carried.</summary>
        public byte[]? LatestRowVersion { get; private set; }

        /// <summary>The unbounded binary columns any entry stored a value in (what a run that carries them sends).</summary>
        public SortedSet<string> UnboundedBinaryColumns { get; } = new(StringComparer.Ordinal);

        /// <summary>Folds one more entry in.</summary>
        public void Add(SyncJournalRow entry)
        {
            Ids.Add(entry.Id);
            LatestRowVersion = entry.OriginalRowVersion;

            UnboundedBinaryColumns.UnionWith(
                SyncJournal.SplitUnboundedBinaryColumns(entry.UnboundedBinaryColumns)
            );

            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                HasDelete = true;
                LatestOperation = SyncJournalOperation.Delete;
                DeletedRowVersion = SyncRowVersions.Max(DeletedRowVersion, entry.OriginalRowVersion);
            }
            else
            {
                HasUpsert = true;
                LatestOperation = SyncJournalOperation.Upsert;
            }
        }

        /// <summary>Builds the entry the table replays for the row (the newest id stands for all of them).</summary>
        public SyncJournalRow ToEntry(
            (string TableName, string KeyText) rowId,
            SyncJournalOperation operation,
            byte[]? originalRowVersion
        ) =>
            new()
            {
                Id = Ids[^1],
                TableName = rowId.TableName,
                KeyText = rowId.KeyText,
                Operation = operation.ToString(),
                OriginalRowVersion = originalRowVersion,
                UnboundedBinaryColumns =
                    UnboundedBinaryColumns.Count == 0 ? null : string.Join(',', UnboundedBinaryColumns),
            };
    }

    /// <summary>What the replay of one table sends, and what it drops unsent.</summary>
    private sealed class TableReplayPlan(ISyncTable table)
    {
        /// <summary>The table.</summary>
        public ISyncTable Table { get; } = table;

        /// <summary>The table's receipts, by key.</summary>
        public IReadOnlyDictionary<string, byte[]> Acknowledged { get; set; } =
            new Dictionary<string, byte[]>(StringComparer.Ordinal);

        /// <summary>The rows whose current content is sent.</summary>
        public List<(SyncJournalRow Entry, List<long> Ids)> Upserts { get; } = [];

        /// <summary>The rows deleted on the server.</summary>
        public List<(SyncJournalRow Entry, List<long> Ids)> Deletes { get; } = [];

        /// <summary>The entries of the rows there is nothing to send for.</summary>
        public List<List<long>> Discards { get; } = [];

        /// <summary>For an upsert whose row holds a delete in its entries: the delete sent instead when the row has gone by the time the upsert is replayed.</summary>
        public Dictionary<string, SyncJournalRow> DeletesIfGone { get; } = new(StringComparer.Ordinal);
    }

    /// <summary>Removes settled journal entries without letting the removal itself be journaled.</summary>
    private async Task RemoveAsync(IReadOnlyList<long> ids, CancellationToken cancellationToken)
    {
        using (SyncSession.Suppress())
        {
            await _journal.RemoveAsync(ids, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>Pulls the server's changes down and, unless it is turned off, removes the local rows the server dropped.</summary>
    /// <remarks>
    /// A table whose journal still holds an unsent change stops at the row that change belongs to; the tables after it
    /// go on. <see cref="SyncAsync"/> reports where that happened in
    /// <see cref="SyncResult.Truncations"/>; called on its own, this returns only what it applied.
    /// </remarks>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task<(int Downloaded, int DeletedLocally)> DownloadAsync(
        SyncOptions options,
        CancellationToken cancellationToken = default
    ) =>
        _journal.Gate.RunExclusiveAsync<(int Downloaded, int DeletedLocally)>(
            async () =>
            {
                await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

                var download = await DownloadCoreAsync(options, null, cancellationToken)
                    .ConfigureAwait(false);

                return (download.Downloaded, download.DeletedLocally);
            },
            cancellationToken
        );

    /// <summary>Pulls the server's changes down, knowing what is still unsent and what the server has acknowledged.</summary>
    /// <remarks>
    /// <para>
    /// Under a <see cref="SyncConflictPolicy.ServerWins"/> run, the rows whose entries the run drops take the server's
    /// content table by table, right after that table's download and parents first. By then the parents the server's
    /// rows point at - including a parent the server added or another device changed since - have come down, so putting
    /// a row back does not fail on a foreign key; and a row put back is there before the child tables that may point at
    /// it are downloaded. The entries being dropped do not hold the table's download back. A row put back brings in the
    /// parents it refers to first, or stays as it is with its entries when it cannot have them (see
    /// <see cref="SyncParentResolver"/>).
    /// </para>
    /// <para>
    /// A table that stops part way stops only itself. The tables after it go on: a row whose parent was behind the
    /// stopping point brings the parent in from the server, or stops its own table when the parent cannot be had.
    /// </para>
    /// <para>
    /// The delete propagation runs before the download and again after it, children first. Each table spares the rows
    /// that are still unsent (the entries a <see cref="SyncConflictPolicy.ServerWins"/> run drops keep nothing), the rows
    /// the tables already propagated keep pointing at, the parents of every row so spared (see
    /// <see cref="SyncKeptRows.CloseAsync"/>), and the rows a local row refers to.
    /// </para>
    /// </remarks>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="serverWins">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run drops, by row, or null.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<(
        int Downloaded,
        int DeletedLocally,
        int Discarded,
        IReadOnlyList<SyncDownloadTruncation> Truncations
    )> DownloadCoreAsync(
        SyncOptions options,
        Dictionary<(string TableName, string KeyText), List<long>>? serverWins,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(options);

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);
        var truncations = new List<SyncDownloadTruncation>();

        if (scope.Count == 0)
        {
            return (0, 0, 0, truncations);
        }

        // One ceiling for the whole pass: asking per table would let a row committed between two tables slip through
        // the gap between their bounds. Only a versioned table can answer - a key-ordered scan has no bound to apply -
        // so an all-versionless scope runs without one.
        var ceilingTable = scope.FirstOrDefault(table => !table.IsVersionless);
        var ceiling = ceilingTable is null
            ? null
            : await ceilingTable.GetChangeCeilingAsync(cancellationToken).ConfigureAwait(false);

        IReadOnlySet<long> droppedIds =
            serverWins?.Values.SelectMany(ids => ids).ToHashSet() ?? new HashSet<long>();
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        var removedByServerWins = 0;

        // Before the download as well as after it - see PropagateDeletesAcrossAsync.
        var deletedBefore = options.PropagateDeletes
            ? await PropagateDeletesAcrossAsync(
                    scope,
                    droppedIds,
                    cancellationToken,
                    serverWins
                )
                .ConfigureAwait(false)
            : 0;
        var downloaded = 0;
        var discarded = 0;

        // A table that stops part way does not stop the tables after it. Their rows may point at parents that were
        // behind the stopping point, but each such parent is brought in from the server first, or the row stops its
        // own table when the parent cannot be had (the resolver below), so no row goes in without its parent. Waiting
        // for the earlier table instead could wait for good: the row it stopped at may be held there by a stale row of
        // a later table, which only that table's download brings up to date.
        foreach (var table in scope)
        {
            // Read per table alongside the pending keys: the receipts say which of the rows about to come down are
            // this device's own echoes, and - once they have come down - which receipts have served their purpose.
            var acknowledged = await _journal
                .ReadAcksAsync(table.TableName, cancellationToken)
                .ConfigureAwait(false);

            // A table of the fixed classes reads what is unsent before each batch (PendingReader below). One that only
            // has the public surface cannot, so it is handed what is unsent as the download starts: without it, it
            // would take every row for one it may overwrite, the row of a conflict this run has just reported included.
            var pendingAtStart = table is ISyncTableRunSupport
                ? new HashSet<string>(StringComparer.Ordinal)
                : (await ReadPendingAsync(table.TableName, droppedIds, cancellationToken).ConfigureAwait(false)).KeyTexts;
            var outcome = await table
                .DownloadAsync(
                    ceiling,
                    options.DownloadBatchSize,
                    options.IncludeUnboundedBinary,
                    new SyncDownloadContext
                    {
                        PendingKeyTexts = pendingAtStart,
                        AcknowledgedRowVersions = acknowledged,

                        // What is unsent is read afresh before each batch, under the lock the application's writes
                        // take, rather than once for the whole pass: the application may keep writing while the run
                        // is in flight, and a row it edits after the pass began must not be overwritten by a batch.
                        PendingReader = token => ReadPendingAsync(table.TableName, droppedIds, token),
                        Gate = _journal.Gate,

                        // A row whose parent the local database does not have brings the parent in first when the
                        // run may - see SyncParentResolver.
                        ParentResolverFactory = pending =>
                            new SyncParentResolver(
                                _tables,
                                scopeTableNames,
                                pending,
                                _journal,
                                options.IncludeUnboundedBinary,
                                options.PropagateDeletes,
                                _changeLog,
                                serverWins
                            ),
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
            downloaded += outcome.Applied;

            // After the download, so every batch that wrote one of these versions has committed: a receipt dropped
            // ahead of the commit that replaces it would be gone for a commit that then failed.
            if (outcome.SettledAckKeyTexts is { Count: > 0 } settledAcks)
            {
                await _journal
                    .RemoveAcksAsync(table.TableName, settledAcks, cancellationToken)
                    .ConfigureAwait(false);
            }

            await SettleServerWinsAsync(table).ConfigureAwait(false);

            if (outcome.TruncatedAtKeyText is { } stoppedAt)
            {
                truncations.Add(
                    new SyncDownloadTruncation(table.TableName, stoppedAt, null)
                    {
                        MissingParentTableName = outcome.MissingParentTableName,
                        SkippedBySaveHook = outcome.SkippedBySaveHook,
                    }
                );
            }
        }

        if (!options.PropagateDeletes)
        {
            return (downloaded, removedByServerWins, discarded, truncations);
        }

        var deleted =
            deletedBefore
            + removedByServerWins
            + await PropagateDeletesAcrossAsync(scope, droppedIds, cancellationToken)
                .ConfigureAwait(false);

        return (downloaded, deleted, discarded, truncations);

        // Settles the table's entries a ServerWins run is dropping, right after the table's download.
        async Task SettleServerWinsAsync(ISyncTable table)
        {
            if (serverWins is null)
            {
                return;
            }

            var rows = serverWins
                .Where(pair => string.Equals(pair.Key.TableName, table.TableName, StringComparison.Ordinal))
                .OrderBy(pair => pair.Value[0])
                .ToList();

            if (rows.Count == 0)
            {
                return;
            }

            var (dropped, removed) = await _journal
                .Gate.WriteExclusiveAsync(
                    () =>
                        ApplyServerWinsToTableAsync(
                            table,
                            rows,
                            options.IncludeUnboundedBinary,
                            options.PropagateDeletes,
                            droppedIds,
                            serverWins,
                            scopeTableNames,
                            cancellationToken
                        ),
                    cancellationToken
                )
                .ConfigureAwait(false);
            discarded += dropped;
            removedByServerWins += removed;
        }
    }

    /// <summary>Runs the delete propagation over the tables of a run, children first, and returns how many local rows went.</summary>
    /// <remarks>
    /// It runs twice per download. Once before it: a row the server deleted is gone before the download applies the
    /// server's rows, so a row the server recreated under another key with the same unique value does not collide with
    /// the old one locally. And once after it, as it always has: the download may have made rows unreferenced that were
    /// referenced before, and the server's key set is read again, so a row the server added while the run was in flight
    /// is not taken for one it dropped.
    /// </remarks>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="droppedIds">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run is dropping, which keep no row: a row created only here, whose entry the run discards, goes before the download rather than standing in the way of a server row with the same unique value.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <param name="discardedRows">The rows a <see cref="SyncConflictPolicy.ServerWins"/> run is discarding the changes of, with their entries, when this is the pass before the download: such a row that goes is noted as <see cref="SyncLocalRowChangeReason.RemovedBeforeDownload"/>, and its entries go with it.</param>
    private async Task<int> PropagateDeletesAcrossAsync(
        IReadOnlyList<ISyncTable> scope,
        IReadOnlySet<long> droppedIds,
        CancellationToken cancellationToken,
        IReadOnlyDictionary<(string TableName, string KeyText), List<long>>? discardedRows = null
    )
    {
        var deleted = 0;
        var keptByTable = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);

        for (var index = scope.Count - 1; index >= 0; index--)
        {
            var table = scope[index];
            IReadOnlyList<string> removedKeyTexts;

            // The unsent keys are read under the write lock, after the local keys, by the same reasoning the download
            // reads them per batch (see ISyncTableRunSupport.PropagateDeletesAsync). A table outside the fixed classes
            // is handed the keys as they stand now.
            if (table is ISyncTableRunSupport support)
            {
                var propagation = await support
                    .PropagateDeletesAsync(
                        _journal.Gate,
                        token => ReadPendingKeyTextsAsync(table.TableName, droppedIds, token),
                        keptByTable.TryGetValue(table.TableName, out var keptHere)
                            ? keptHere
                            : new HashSet<string>(StringComparer.Ordinal),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
                removedKeyTexts = propagation.Removed;

                foreach (var (parentTableName, parentKeyText) in propagation.KeptParents)
                {
                    if (!keptByTable.TryGetValue(parentTableName, out var keys))
                    {
                        keys = new HashSet<string>(StringComparer.Ordinal);
                        keptByTable.Add(parentTableName, keys);
                    }

                    keys.Add(parentKeyText);
                }
            }
            else
            {
                removedKeyTexts = await table
                    .PropagateDeletesAsync(
                        await ReadPendingKeyTextsAsync(table.TableName, droppedIds, cancellationToken)
                            .ConfigureAwait(false),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            deleted += removedKeyTexts.Count;

            if (discardedRows is not null)
            {
                // A row whose entries the run discards, gone ahead of the download: its entries go now rather than when
                // the table is settled after its download. Left until then, a run that fails in between would leave
                // entries for a row that is no longer there, and the next run would drop them as having nothing to
                // send - the discard the failed run reported (RemovedBeforeDownload) would come back as a silent one.
                // They are the entries the run read at its start, so a write the application made since keeps its own.
                var ids = new List<long>();

                foreach (var keyText in removedKeyTexts)
                {
                    if (!discardedRows.TryGetValue((table.TableName, keyText), out var entryIds))
                    {
                        continue;
                    }

                    ids.AddRange(entryIds);
                    _changeLog?.Add(table.TableName, keyText, SyncLocalRowChangeReason.RemovedBeforeDownload);
                }

                if (ids.Count > 0)
                {
                    await RemoveAsync(ids, cancellationToken).ConfigureAwait(false);
                }
            }

            // A key the server has dropped takes its receipt with it. Left behind, it would be the original of the
            // next replay of that key - a version-guarded update against a row that is gone, reported as a conflict
            // with a row nobody can produce - which is exactly what a local row recreated under the same key runs into.
            if (removedKeyTexts.Count > 0)
            {
                await _journal
                    .RemoveAcksAsync(table.TableName, removedKeyTexts, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        return deleted;
    }

    /// <summary>Resolves which tables one run covers: the mode keeps the versionless ones out of a versioned run, and the exclusions take named types away.</summary>
    /// <remarks>
    /// A type the engine does not synchronise is rejected rather than skipped: the caller either mistyped, or named a
    /// table that was already excluded where the engine was put together - and a silently ignored exclusion would read
    /// as if it had worked. The order of the remaining tables is the foreign-key order the engine was built with.
    /// </remarks>
    private IReadOnlyList<ISyncTable> ResolveScope(
        SyncMode mode,
        IReadOnlyCollection<Type> excludedEntityTypes
    )
    {
        ArgumentNullException.ThrowIfNull(excludedEntityTypes);

        foreach (var type in excludedEntityTypes)
        {
            if (_tables.All(table => table.EntityType != type))
            {
                throw new ArgumentException(
                    $"The type '{type}' is not an entity type this engine synchronises - a typo, or a table that was "
                        + "already excluded where the engine was put together.",
                    nameof(excludedEntityTypes)
                );
            }
        }

        return _tables
            .Where(table =>
                (mode == SyncMode.LastWriteWins || !table.IsVersionless)
                && !excludedEntityTypes.Contains(table.EntityType)
            )
            .ToList();
    }

    /// <summary>Reads what is still unsent when one table's download batch is about to be applied.</summary>
    /// <param name="tableName">The downloading table.</param>
    /// <param name="ignoredIds">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run is about to drop, which hold nothing back.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<SyncPendingSnapshot> ReadPendingAsync(
        string tableName,
        IReadOnlySet<long> ignoredIds,
        CancellationToken cancellationToken
    )
    {
        var entries = await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false);
        var keyTexts = new HashSet<string>(StringComparer.Ordinal);
        var deleted = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        var unsent = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        var binaryColumns = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);

        foreach (var entry in entries)
        {
            if (ignoredIds.Contains(entry.Id))
            {
                continue;
            }

            if (!unsent.TryGetValue(entry.TableName, out var tableKeys))
            {
                tableKeys = new HashSet<string>(StringComparer.Ordinal);
                unsent.Add(entry.TableName, tableKeys);
            }

            tableKeys.Add(entry.KeyText);

            if (string.Equals(entry.TableName, tableName, StringComparison.Ordinal))
            {
                keyTexts.Add(entry.KeyText);

                if (!string.IsNullOrEmpty(entry.UnboundedBinaryColumns))
                {
                    if (!binaryColumns.TryGetValue(entry.KeyText, out var columns))
                    {
                        columns = new HashSet<string>(StringComparer.Ordinal);
                        binaryColumns.Add(entry.KeyText, columns);
                    }

                    columns.UnionWith(
                        SyncJournal.SplitUnboundedBinaryColumns(entry.UnboundedBinaryColumns)
                    );
                }
            }

            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                if (!deleted.TryGetValue(entry.TableName, out var keys))
                {
                    keys = new HashSet<string>(StringComparer.Ordinal);
                    deleted.Add(entry.TableName, keys);
                }

                keys.Add(entry.KeyText);
            }
        }

        return new SyncPendingSnapshot(
            keyTexts,
            deleted.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlySet<string>)pair.Value,
                StringComparer.Ordinal
            ),
            binaryColumns.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlySet<string>)pair.Value,
                StringComparer.Ordinal
            )
        )
        {
            KeyTextsByTable = unsent.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlySet<string>)pair.Value,
                StringComparer.Ordinal
            ),
        };
    }

    /// <summary>Reads the keys of one table's still-unsent journal entries: the rows a download and a delete propagation both leave alone.</summary>
    /// <param name="tableName">The table whose keys are read.</param>
    /// <param name="ignoredIds">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run is about to drop, which keep nothing.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<IReadOnlySet<string>> ReadPendingKeyTextsAsync(
        string tableName,
        IReadOnlySet<long> ignoredIds,
        CancellationToken cancellationToken
    )
    {
        var entries = await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false);

        return entries
            .Where(entry =>
                string.Equals(entry.TableName, tableName, StringComparison.Ordinal)
                && !ignoredIds.Contains(entry.Id)
            )
            .Select(entry => entry.KeyText)
            .ToHashSet(StringComparer.Ordinal);
    }
}

/// <summary>
/// Records the journal entries a graph save is about to need, before the save itself runs ("journal-first").
/// </summary>
/// <remarks>
/// <para>
/// The traversal mirrors the decision procedure of the graph saver: a removed node has its cascade subtree recorded as
/// deletes (children first) followed by the node itself, an added or updated node is recorded as an upsert, and an
/// unchanged node contributes nothing of its own - but its children are still visited while the save cascades, because a
/// changed child under an unchanged root is written all the same.
/// </para>
/// <para>
/// A delete is recorded only for a node the saver's DELETE can find. The saver removes a removed node's subtree whatever
/// the state of each node in it, so a saved child moved there from under another parent is recorded; but an added node
/// in that subtree has never been written, and a node whose key is not set yet (it formats as
/// <see cref="SyncJournal.UnsetKeyText"/>) matches no row, so neither records a delete of its own - the walk still goes
/// on into their children. One case is given up for it: an added node carrying the key of a row that already exists
/// (a misuse, since inserting it would fail) has that row removed by the saver without a delete being recorded. Telling
/// it apart would take a read of the local row for every added node, and a table without a version column has no such
/// read; recording it instead would replay an unguarded delete of whatever row another device created under that key.
/// </para>
/// <para>
/// It is one traversal rather than one per entity type: the children come from
/// <see cref="EntityBaseCore.EnumerateCascadeChildren"/>, which yields the same cascade navigations the saver's own walk
/// enumerates (the saver reads them from its EntitySaveMetadata.CascadeNavigations rather than calling this method), and
/// a node is recorded only when its CLR type has a descriptor. A table on the path that is not synchronised - or that
/// the engine was built without - is therefore walked through without an entry of its own, and a subtree holding no
/// synchronised table records nothing.
/// </para>
/// <para>
/// Recording the whole graph first keeps the journal-first safety order for every row the save is going to touch: an
/// entry whose write then fails or is rolled back describes a row the upload re-reads and settles without a round trip.
/// </para>
/// </remarks>
public sealed class SyncGraphRecorder
{
    private readonly Dictionary<Type, ISyncTableDescriptor> _descriptors;
    private readonly Dictionary<string, ISyncTableDescriptor> _descriptorsByTable;

    /// <summary>Creates the recorder over the descriptors of the tables whose rows are recorded.</summary>
    /// <remarks>
    /// The tables an engine synchronises belong here and no others: a table the engine was built without
    /// (<c>excludeFromSync</c>) is left out, so a graph save records none of its rows - whichever repository the save
    /// goes through - while the synchronised rows the same save cascades into are still recorded. The journal is the one
    /// the engine replays, and an entry of a table it never replays would stay unsent for good.
    /// </remarks>
    /// <param name="descriptors">The descriptors, one per table whose rows are recorded.</param>
    public SyncGraphRecorder(IEnumerable<ISyncTableDescriptor> descriptors)
    {
        ArgumentNullException.ThrowIfNull(descriptors);
        _descriptors = descriptors.ToDictionary(descriptor => descriptor.EntityType);
        _descriptorsByTable = _descriptors.Values.ToDictionary(
            descriptor => descriptor.TableName,
            StringComparer.Ordinal
        );
    }

    /// <summary>Records the entries for a graph save rooted at the given entity (the cascade children included).</summary>
    /// <param name="journal">The journal the entries are recorded to.</param>
    /// <param name="entity">The root of the graph the save was asked for.</param>
    /// <param name="cascadeSave">Whether the save cascades into the children.</param>
    /// <param name="cascadeDelete">Whether removing the root removes its subtree.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// The whole graph is recorded in one call to <see cref="SyncJournal.RecordManyAsync"/>, in the order below. A delete
    /// carries the later of the version on the entity and the version the local row has (see
    /// <see cref="RecordCollectedAsync"/>).
    /// </remarks>
    public Task RecordSaveAsync(
        SyncJournal journal,
        EntityBaseCore entity,
        bool cascadeSave,
        bool cascadeDelete,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(journal);
        ArgumentNullException.ThrowIfNull(entity);

        var records = new List<SyncJournalRecord>();
        CollectSave(entity, cascadeSave, cascadeDelete, records);

        return RecordCollectedAsync(journal, records, cancellationToken);
    }

    /// <summary>Records the collected entries, giving each delete of a versioned table the version its local row has.</summary>
    /// <remarks>
    /// A delete is replayed under the version it carries, and one that carries none for a row the server has is dropped
    /// unsent. The entity a graph save deletes cannot be relied on for it: a stub made from the key alone carries no
    /// version, and an object held since before the row's last download carries an older one. The local row is read for
    /// it before it goes - one SELECT per such delete - and the later of the two is recorded. A row that is not there, or
    /// a table without a version column, keeps what the entity carries.
    /// </remarks>
    /// <param name="journal">The journal the entries are recorded to.</param>
    /// <param name="records">The entries, in the order they are to be recorded.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task RecordCollectedAsync(
        SyncJournal journal,
        List<SyncJournalRecord> records,
        CancellationToken cancellationToken
    )
    {
        if (!SyncSession.IsSuppressed)
        {
            for (var index = 0; index < records.Count; index++)
            {
                var record = records[index];

                if (
                    record.Operation == SyncJournalOperation.Delete
                    && _descriptorsByTable.GetValueOrDefault(record.TableName)
                        is ISyncLocalRowVersionReader reader
                    && await reader
                        .ReadLocalRowVersionAsync(
                            journal.LocalSqlExecutor,
                            record.KeyText,
                            cancellationToken
                        )
                        .ConfigureAwait(false)
                        is { } local
                )
                {
                    records[index] = record with
                    {
                        OriginalRowVersion = SyncRowVersions.Max(record.OriginalRowVersion, local),
                    };
                }
            }
        }

        await journal.RecordManyAsync(records, cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Collects the entries for a graph save rooted at the given entity, in the order they are to be recorded.</summary>
    /// <param name="entity">The root of the graph the save was asked for.</param>
    /// <param name="cascadeSave">Whether the save cascades into the children.</param>
    /// <param name="cascadeDelete">Whether removing the root removes its subtree.</param>
    /// <param name="records">The list the entries are appended to.</param>
    internal void CollectSave(
        EntityBaseCore entity,
        bool cascadeSave,
        bool cascadeDelete,
        List<SyncJournalRecord> records
    )
    {
        if (entity.RowState == RowState.Removed)
        {
            if (cascadeDelete)
            {
                CollectDeleteGraph(entity, records);
            }
            else
            {
                CollectDelete(entity, records);
            }

            return;
        }

        if (entity.RowState != RowState.Unchanged && Find(entity) is { } descriptor)
        {
            records.Add(
                new SyncJournalRecord(
                    descriptor.TableName,
                    descriptor.FormatEntityKey(entity),
                    SyncJournalOperation.Upsert,
                    null
                )
                {
                    // An added row is written with every column, the excluded ones included; an updated one is not.
                    UnboundedBinaryColumns =
                        entity.RowState == RowState.Added ? descriptor.UnboundedBinaryColumnNames : null,
                    Entity = entity,
                    Descriptor = descriptor,
                    SavedByGraph = true,
                }
            );
        }

        if (!cascadeSave)
        {
            return;
        }

        foreach (var child in entity.EnumerateCascadeChildren())
        {
            CollectSave(child, cascadeSave, cascadeDelete, records);
        }
    }

    /// <summary>Collects the subtree as deletes, children first (see the remarks on the class for the nodes that record none).</summary>
    /// <remarks>
    /// The saver removes the subtree whatever the state of each node, so every node is visited; an added node records no
    /// delete of its own, since it has never been written, but its children are still collected - a saved child moved
    /// under it is removed all the same.
    /// </remarks>
    private void CollectDeleteGraph(EntityBaseCore entity, List<SyncJournalRecord> records)
    {
        foreach (var child in entity.EnumerateCascadeChildren())
        {
            CollectDeleteGraph(child, records);
        }

        if (entity.RowState != RowState.Added)
        {
            CollectDelete(entity, records);
        }
    }

    /// <summary>
    /// Collects the delete of one node, carrying the mirrored version the row holds (nothing for an unsynchronised table,
    /// and nothing for a node whose key is not set yet, whose delete matches no row).
    /// </summary>
    private void CollectDelete(EntityBaseCore entity, List<SyncJournalRecord> records)
    {
        if (
            Find(entity) is { } descriptor
            && descriptor.FormatEntityKey(entity) is var keyText
            && !string.Equals(keyText, SyncJournal.UnsetKeyText, StringComparison.Ordinal)
        )
        {
            records.Add(
                new SyncJournalRecord(
                    descriptor.TableName,
                    keyText,
                    SyncJournalOperation.Delete,
                    descriptor.ReadEntityRowVersion(entity)
                )
            );
        }
    }

    /// <summary>Finds the descriptor of the node's table, or null when the table is not synchronised.</summary>
    private ISyncTableDescriptor? Find(EntityBaseCore entity) =>
        _descriptors.GetValueOrDefault(entity.GetType());

    /// <summary>Finds the descriptor of the given entity type's table, or null when the table is not synchronised.</summary>
    internal ISyncTableDescriptor? Find(Type entityType) =>
        _descriptors.GetValueOrDefault(entityType);
}

/// <summary>
/// Generic core of the journaling repository decorator: every write entry point on the repository contract records
/// its intent to the journal before the write is performed, and everything else is forwarded untouched.
/// </summary>
/// <remarks>
/// <para>
/// It wraps the repository rather than hooking into the save pipeline because a save hook only fires for a graph save -
/// a direct Insert, Update, Delete, or BulkInsert passes it by. Offline editing has to be caught at every write, so
/// every write entry point on the contract records here. What stays with the generated derived class is only what the
/// generic core cannot reach: the members the concrete interface adds - named queries and the binary column accessors -
/// which the derived class forwards itself.
/// </para>
/// <para>
/// Raw SQL (<c>ExecuteSqlAsync</c>) is forwarded untouched and is <b>not</b> recorded: the statement's shape is opaque
/// to the decorator, so there is no key to journal. The same holds for the bulk delete behind
/// <c>Query().ExecuteDeleteAsync</c>, whose rows are chosen by a predicate the decorator never sees. Rows changed
/// either way reach the server only if something else records them.
/// </para>
/// <para>
/// A table the engine was built without (<c>excludeFromSync</c>) is wrapped as well, in the form that does not record its
/// own rows (<see cref="RecordsOwnRows"/> false): its direct writes go straight to the repository it wraps, with no lock
/// and no entry, while its graph saves still go through the recording step, because a save rooted at it cascades into
/// synchronised tables whose rows have to be recorded. The graph recorder of such an engine leaves the excluded tables
/// out, so the save records none of their rows.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class JournalingRepositoryBase<TEntity, TKey> : IRepositoryCore<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder.</summary>
    /// <remarks>The decorator records the rows of its own table (see <see cref="RecordsOwnRows"/>).</remarks>
    protected JournalingRepositoryBase(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder
    )
        : this(inner, journal, descriptor, graphRecorder, recordsOwnRows: true) { }

    /// <summary>
    /// Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder,
    /// saying whether it records the rows of its own table.
    /// </summary>
    /// <param name="inner">The repository every call is forwarded to.</param>
    /// <param name="journal">The journal the write intents are recorded to.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="graphRecorder">The recorder a graph save is journaled through.</param>
    /// <param name="recordsOwnRows">
    /// False for a table the engine was built without: its direct writes are forwarded unrecorded, and only its graph
    /// saves go through the recording step (see <see cref="RecordsOwnRows"/>).
    /// </param>
    protected JournalingRepositoryBase(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder,
        bool recordsOwnRows
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(graphRecorder);
        Inner = inner;
        Journal = journal;
        Descriptor = descriptor;
        GraphRecorder = graphRecorder;
        RecordsOwnRows = recordsOwnRows;
    }

    /// <summary>Gets whether the decorator records the rows of its own table.</summary>
    /// <remarks>
    /// False for a table the engine was built without (<c>excludeFromSync</c>). Its direct writes - Insert, Update,
    /// Delete, BulkInsert, and the generated unbounded binary column writes - are then forwarded as they are, without
    /// taking the local write lock, recording, or creating the journal table. Its graph saves still go through
    /// <see cref="RecordAndWriteAsync"/>, so the synchronised rows a save cascades into are recorded under the lock and
    /// settled against what the save did; the graph recorder of the engine leaves the excluded tables out, so none of
    /// their rows are recorded.
    /// </remarks>
    protected bool RecordsOwnRows { get; }

    /// <summary>Gets the wrapped repository every call is forwarded to.</summary>
    protected IRepositoryCore<TEntity, TKey> Inner { get; }

    /// <summary>Gets the journal the write intents are recorded to.</summary>
    protected SyncJournal Journal { get; }

    /// <summary>Gets the table's descriptor (its journal name, and how its key and mirrored version are read).</summary>
    protected SyncTableDescriptor<TEntity, TKey> Descriptor { get; }

    /// <summary>Gets the recorder that journals the whole cascade a graph save is about to write.</summary>
    protected SyncGraphRecorder GraphRecorder { get; }

    /// <summary>Gets the server-side table name the journal entries are recorded under.</summary>
    protected string TableName => Descriptor.TableName;

    /// <summary>Reads the primary key of the given entity.</summary>
    protected TKey ReadKey(TEntity entity) => Descriptor.ReadKey(entity);

    /// <summary>Formats a key into the journal's key text (the same serialization the sync engine reads back).</summary>
    protected string FormatKey(TKey key) => Descriptor.FormatKey(key);

    /// <summary>Records a delete intent for the given key (the versioned and versionless subclasses differ here).</summary>
    protected abstract Task RecordDeleteAsync(TKey id, CancellationToken cancellationToken);

    /// <summary>Records the whole cascade a graph save is about to write, before the save itself runs.</summary>
    /// <remarks>
    /// The decorator sees only the root, while the saver walks the cascade navigations and writes the descendants too.
    /// The recorder walks the same navigations, so the children a save writes or deletes are journaled exactly like the
    /// root - and a table on the path that is not synchronised is walked through without an entry of its own.
    /// </remarks>
    protected Task RecordGraphSaveAsync(
        TEntity entity,
        bool cascadeSave,
        bool cascadeDelete,
        CancellationToken cancellationToken
    ) =>
        GraphRecorder.RecordSaveAsync(
            Journal,
            entity,
            cascadeSave,
            cascadeDelete,
            cancellationToken
        );

    /// <summary>Records the intent to write the given row, unless the sync engine is the one writing.</summary>
    /// <remarks>
    /// The key text comes from <see cref="SyncTableDescriptor{TEntity, TKey}.FormatEntityKey"/>, as an insert's does: a
    /// row whose key is not set is recorded under <see cref="SyncJournal.UnsetKeyText"/>, which names no row, and the write
    /// itself decides what happens to the row (an entry left under that text goes when an upload plans the table).
    /// </remarks>
    protected Task RecordUpsertAsync(TEntity entity, CancellationToken cancellationToken) =>
        Journal.RecordAsync(
            TableName,
            Descriptor.FormatEntityKey(entity),
            SyncJournalOperation.Upsert,
            null,
            cancellationToken
        );

    /// <summary>Records the intent to insert the given row, which stores every unbounded binary column as well.</summary>
    private Task RecordInsertAsync(TEntity entity, CancellationToken cancellationToken) =>
        Journal.RecordManyAsync([InsertRecord(entity)], cancellationToken);

    /// <summary>The entry an insert of the given row records.</summary>
    private SyncJournalRecord InsertRecord(TEntity entity) =>
        new(TableName, Descriptor.FormatEntityKey(entity), SyncJournalOperation.Upsert, null)
        {
            UnboundedBinaryColumns = Descriptor.UnboundedBinaryColumnNames,
            Entity = entity,
            Descriptor = Descriptor,
        };

    /// <summary>Records an intent and performs the write it describes, as one step under the local write lock.</summary>
    /// <remarks>
    /// <para>
    /// The two belong together because a sync run reads what is still unsent and then acts on it: a write slipping in
    /// between - recorded, but not yet there, or there but not yet recorded - is a write that run either overwrites or
    /// deletes. Holding the lock across both means the run sees the write whole or not at all, and a write that has to
    /// wait waits for at most one batch of the run.
    /// </para>
    /// <para>
    /// The engine's own writes run suppressed and are made while it already holds the lock, so they neither record nor
    /// wait; a write made while this flow already holds the lock - from a save hook, say - goes straight through as well.
    /// </para>
    /// <para>
    /// When the business write throws, the entries this call recorded are taken back before the exception goes on, still
    /// under the lock: the write did not land, and an entry left behind would upload content the local database never
    /// committed - over another writer's newer row or blob. Only the entries of this call go; earlier entries for the
    /// same row stay. The repositories behind this commit as their last step, so an exception means the write did not
    /// land; a repository of your own put behind the decorator has to keep to that, since an exception it throws after
    /// committing takes back the entry of a write that did land. A process that ends between recording and writing
    /// still leaves its entries behind, which the upload re-reads and drops when the row is not there. Should taking the
    /// entries back fail as well, the write's exception still goes on, with the failure in its
    /// <see cref="Exception.Data"/> under <see cref="JournalCleanupFailureKey"/>.
    /// </para>
    /// <para>
    /// When the write succeeds, the entries are checked against what it did (see <see cref="SettleRecordedAsync"/>): an
    /// entry for a row a save hook skipped is taken back, and one whose row a save hook gave its key is moved to that key.
    /// </para>
    /// <para>
    /// An unbounded binary column a save hook writes through its context during the write is recorded as well, inside
    /// the save's transaction (see <see cref="RecordHookBinaryWriteAsync"/>), so the entry goes with the save whichever
    /// way it ends.
    /// </para>
    /// </remarks>
    /// <param name="record">Records the intent (called first).</param>
    /// <param name="write">Performs the business write (called second).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    protected Task<TResult> RecordAndWriteAsync<TResult>(
        Func<Task> record,
        Func<Task<TResult>> write,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(record);
        ArgumentNullException.ThrowIfNull(write);

        if (SyncSession.IsSuppressed)
        {
            return write();
        }

        return Journal.Gate.WriteExclusiveAsync(
            async () =>
            {
                var recorded = new SyncRecordingScope();
                TResult result;

                try
                {
                    // A save hook's write is recorded by the save's own connection, which cannot create the table
                    await Journal.EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

                    using (recorded.Begin())
                    {
                        await record().ConfigureAwait(false);
                    }

                    using (SaveHookContextWrites.Observe(RecordHookBinaryWriteAsync))
                    {
                        result = await write().ConfigureAwait(false);
                    }
                }
                catch (Exception failure) when (recorded.Ids.Count > 0)
                {
                    await TakeBackAsync(recorded.Ids, failure).ConfigureAwait(false);

                    throw;
                }

                await SettleRecordedAsync(recorded).ConfigureAwait(false);

                return result;
            },
            cancellationToken
        );
    }

    /// <summary>Records an unbounded binary column a save hook wrote during a write, inside the save's transaction.</summary>
    /// <remarks>
    /// <para>
    /// The entries a graph save records are made before it runs, from what the graph holds, and an After hook can write
    /// a column of a row the save wrote, or of another row, through its context. Left out of the journal, that blob would
    /// never be uploaded, and the next download would put the server's value back over it. The entry is written by the
    /// save's own connection, so it commits or rolls back with the save; a write that matched no row is not reported.
    /// </para>
    /// <para>
    /// A table that is not synchronised, and a column the table does not leave out of the row transfer, record nothing.
    /// A key that cannot be read as the table's key type fails the save rather than leaving the blob unrecorded.
    /// </para>
    /// </remarks>
    /// <param name="write">The column the hook wrote.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private Task RecordHookBinaryWriteAsync(
        SaveHookBinaryColumnWrite write,
        CancellationToken cancellationToken
    )
    {
        if (
            GraphRecorder.Find(write.EntityType) is not { } descriptor
            || !descriptor.UnboundedBinaryColumnNames.Contains(write.PropertyName, StringComparer.Ordinal)
        )
        {
            return Task.CompletedTask;
        }

        if (descriptor is not ISyncHookKeyFormatter formatter)
        {
            throw new InvalidOperationException(
                $"The sync descriptor of {descriptor.TableName} cannot read the key a save hook passed, so the "
                    + "unbounded binary column the hook wrote cannot be recorded for the sync journal."
            );
        }

        return Journal.RecordWithinSaveAsync(
            write.Context,
            descriptor.TableName,
            formatter.FormatHookKey(write.Key),
            write.PropertyName,
            cancellationToken
        );
    }

    /// <summary>
    /// Brings the entries a write recorded into line with what the write did, once it has succeeded: an entry for a row
    /// a save hook skipped goes, and an entry whose row took another key as it was saved is moved to that key.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The entries are recorded before the write, from the entities as they stood then, and a graph save's hooks can
    /// change the outcome afterwards. A Before hook that returns false skips the row: nothing is written, yet its entry
    /// would upload the row's current content - over another writer's newer row, or as a write that moves the server's
    /// version on and raises a conflict elsewhere. A skipped row is the one the save leaves in its old state rather
    /// than marking it unchanged, which is how it is told apart. A hook can also give a new row its key; the entry,
    /// made under the key the row had before, would then name a row that does not exist and the upload would drop it.
    /// </para>
    /// <para>
    /// A delete a hook skipped needs nothing here: its row is still there, which already makes the upload drop the
    /// entry. A write made directly rather than through a graph save runs no hooks and leaves the entity's state alone,
    /// so only a key settled as it ran is looked at.
    /// </para>
    /// <para>
    /// Done under the same lock right after the write, and as a best effort: the write has landed by then, and failing
    /// the call over its bookkeeping would tell the caller it did not. A process that ends in between, or a failure
    /// here, leaves the entries as they were recorded.
    /// </para>
    /// </remarks>
    /// <param name="recorded">What the write recorded.</param>
    private async Task SettleRecordedAsync(SyncRecordingScope recorded)
    {
        var skipped = new List<long>();
        var rekeyed = new List<(long Id, string KeyText)>();

        foreach (var (id, record) in recorded.Recorded)
        {
            if (
                record.Operation != SyncJournalOperation.Upsert
                || record.Entity is not { } entity
                || record.Descriptor is not { } descriptor
            )
            {
                continue;
            }

            if (record.SavedByGraph && entity.RowState != RowState.Unchanged)
            {
                skipped.Add(id);

                continue;
            }

            var keyText = descriptor.FormatEntityKey(entity);

            if (!string.Equals(keyText, record.KeyText, StringComparison.Ordinal))
            {
                rekeyed.Add((id, keyText));
            }
        }

        if (skipped.Count == 0 && rekeyed.Count == 0)
        {
            return;
        }

        try
        {
            await Journal.RemoveAsync(skipped, CancellationToken.None).ConfigureAwait(false);
            await Journal
                .RewriteKeyTextsAsync(rekeyed, CancellationToken.None)
                .ConfigureAwait(false);
        }
        catch (Exception)
        {
            // Best effort (see the remarks): the entries stay as recorded.
        }
    }

    /// <summary>The key of <see cref="Exception.Data"/> that carries a failure to take back the entries of a write that failed.</summary>
    public const string JournalCleanupFailureKey = "QuickER.Sync.JournalCleanupFailure";

    /// <summary>Removes the entries a failed write recorded, leaving a failure to do so on the write's exception.</summary>
    private async Task TakeBackAsync(IReadOnlyList<long> ids, Exception failure)
    {
        try
        {
            // Not the caller's token: the write has already failed, and a cancellation that stopped it must not leave
            // its entries behind as well.
            await Journal.RemoveAsync(ids, CancellationToken.None).ConfigureAwait(false);
        }
        catch (Exception cleanupFailure)
        {
            failure.Data[JournalCleanupFailureKey] = cleanupFailure;
        }
    }

    /// <summary>Records a write of one unbounded binary column and performs it, as one step under the local write lock.</summary>
    /// <remarks>
    /// What a generated accessor that writes one column of a row on its own goes through. A decorator that does not
    /// record its own rows (<see cref="RecordsOwnRows"/>) performs the write and nothing else.
    /// </remarks>
    /// <param name="id">The key of the row being written.</param>
    /// <param name="columnName">The column the write stores a value in.</param>
    /// <param name="write">Performs the business write.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <exception cref="ArgumentNullException"><paramref name="id"/> is null (refused before anything is recorded).</exception>
    protected Task<TResult> RecordUnboundedBinaryWriteAsync<TResult>(
        TKey id,
        string columnName,
        Func<Task<TResult>> write,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(write);

        if (!RecordsOwnRows)
        {
            return write();
        }

        if (id is null)
        {
            throw new ArgumentNullException(nameof(id));
        }

        return RecordAndWriteAsync(
            () =>
                Journal.RecordManyAsync(
                    [
                        new SyncJournalRecord(
                            TableName,
                            FormatKey(id),
                            SyncJournalOperation.Upsert,
                            null
                        )
                        {
                            UnboundedBinaryColumns = [columnName],
                        },
                    ],
                    cancellationToken
                ),
            write,
            cancellationToken
        );
    }

    /// <inheritdoc />
    public Task<TEntity?> GetByIdAsync(TKey id, CancellationToken cancellationToken = default) =>
        Inner.GetByIdAsync(id, cancellationToken);

    /// <inheritdoc />
    public Task<IReadOnlyList<TEntity>> GetAllAsync(CancellationToken cancellationToken = default) =>
        Inner.GetAllAsync(cancellationToken);

    /// <inheritdoc />
    /// <remarks>A read-only check: it writes nothing, so there is nothing to journal.</remarks>
    public Task<IReadOnlyList<UniquenessViolation>> CheckUniquenessAsync(
        TEntity entity,
        CancellationToken cancellationToken = default
    ) => Inner.CheckUniquenessAsync(entity, cancellationToken);

    /// <inheritdoc />
    /// <remarks>A decorator that does not record its own rows forwards the call as it is (see <see cref="RecordsOwnRows"/>).</remarks>
    public async Task InsertAsync(TEntity entity, CancellationToken cancellationToken = default)
    {
        if (!RecordsOwnRows)
        {
            await Inner.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

            return;
        }

        ArgumentNullException.ThrowIfNull(entity);
        await RecordAndWriteAsync(
                () => RecordInsertAsync(entity, cancellationToken),
                async () =>
                {
                    await Inner.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

                    return true;
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <inheritdoc />
    /// <remarks>A decorator that does not record its own rows forwards the call as it is (see <see cref="RecordsOwnRows"/>).</remarks>
    public Task<bool> UpdateAsync(
        TEntity entity,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        if (!RecordsOwnRows)
        {
            return Inner.UpdateAsync(entity, mode, cancellationToken);
        }

        ArgumentNullException.ThrowIfNull(entity);

        return RecordAndWriteAsync(
            () => RecordUpsertAsync(entity, cancellationToken),
            () => Inner.UpdateAsync(entity, mode, cancellationToken),
            cancellationToken
        );
    }

    /// <inheritdoc />
    /// <remarks>
    /// A null key is refused before anything is recorded, as the repository it wraps refuses it. A decorator that does not
    /// record its own rows forwards the call as it is (see <see cref="RecordsOwnRows"/>).
    /// </remarks>
    public Task<bool> DeleteAsync(TKey id, CancellationToken cancellationToken = default)
    {
        if (!RecordsOwnRows)
        {
            return Inner.DeleteAsync(id, cancellationToken);
        }

        if (id is null)
        {
            throw new ArgumentNullException(nameof(id));
        }

        return RecordAndWriteAsync(
            () => RecordDeleteAsync(id, cancellationToken),
            () => Inner.DeleteAsync(id, cancellationToken),
            cancellationToken
        );
    }

    /// <inheritdoc />
    /// <remarks>
    /// Every row is recorded in one call to <see cref="SyncJournal.RecordManyAsync"/>, not one statement per row. A
    /// decorator that does not record its own rows forwards the call as it is (see <see cref="RecordsOwnRows"/>), and so
    /// does a call with no row to insert (an empty sequence, or only null elements, which the insert skips): there is
    /// nothing to record, so it takes neither the write lock nor the journal's tables.
    /// </remarks>
    public Task<int> BulkInsertAsync(
        IEnumerable<TEntity> entities,
        CancellationToken cancellationToken = default
    )
    {
        if (!RecordsOwnRows)
        {
            return Inner.BulkInsertAsync(entities, cancellationToken);
        }

        ArgumentNullException.ThrowIfNull(entities);
        var materialized = entities.ToList();

        if (!materialized.Any(entity => entity is not null))
        {
            return Inner.BulkInsertAsync(materialized, cancellationToken);
        }

        return RecordAndWriteAsync(
            () =>
                Journal.RecordManyAsync(
                    materialized.Where(entity => entity is not null).Select(InsertRecord).ToList(),
                    cancellationToken
                ),
            () => Inner.BulkInsertAsync(materialized, cancellationToken),
            cancellationToken
        );
    }

    /// <inheritdoc />
    /// <remarks>
    /// The decorator sees only the root, while the saver walks the cascade navigations and writes the descendants too.
    /// The recorder walks the same navigations, so the children a save writes or deletes are journaled exactly like the
    /// root - and a table on the path that is not synchronised is walked through without an entry of its own.
    /// </remarks>
    public Task<int> SaveAsync(
        TEntity entity,
        bool cascadeSave = true,
        bool cascadeDelete = true,
        bool insertWhenUpdateMissing = false,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entity);

        return RecordAndWriteAsync(
            () =>
                GraphRecorder.RecordSaveAsync(
                    Journal,
                    entity,
                    cascadeSave,
                    cascadeDelete,
                    cancellationToken
                ),
            () =>
                Inner.SaveAsync(
                    entity,
                    cascadeSave,
                    cascadeDelete,
                    insertWhenUpdateMissing,
                    mode,
                    cancellationToken
                ),
            cancellationToken
        );
    }

    /// <inheritdoc />
    /// <remarks>The graphs of every root are recorded together, in one call to <see cref="SyncJournal.RecordManyAsync"/>.</remarks>
    public Task<int> SaveAsync(
        IEnumerable<TEntity> entities,
        bool cascadeSave = true,
        bool cascadeDelete = true,
        bool insertWhenUpdateMissing = false,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entities);
        var materialized = entities.ToList();

        return RecordAndWriteAsync(
            () =>
            {
                var records = new List<SyncJournalRecord>();

                foreach (var entity in materialized)
                {
                    if (entity is not null)
                    {
                        GraphRecorder.CollectSave(entity, cascadeSave, cascadeDelete, records);
                    }
                }

                return GraphRecorder.RecordCollectedAsync(Journal, records, cancellationToken);
            },
            () =>
                Inner.SaveAsync(
                    materialized,
                    cascadeSave,
                    cascadeDelete,
                    insertWhenUpdateMissing,
                    mode,
                    cancellationToken
                ),
            cancellationToken
        );
    }

    /// <inheritdoc />
    public SqlQuery<TEntity> Query() => Inner.Query();

    /// <inheritdoc />
    public Task<IReadOnlyList<TEntity>> QueryBySqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => Inner.QueryBySqlAsync(sql, parameters, cancellationToken);

    /// <inheritdoc />
    public Task<int> ExecuteSqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => Inner.ExecuteSqlAsync(sql, parameters, cancellationToken);

    /// <inheritdoc />
    public Task<TResult?> ExecuteScalarSqlAsync<TResult>(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => Inner.ExecuteScalarSqlAsync<TResult>(sql, parameters, cancellationToken);
}

/// <summary>Journaling decorator core for a table with a row-version column (a delete intent carries the mirrored version).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class JournalingRepository<TEntity, TKey> : JournalingRepositoryBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder.</summary>
    protected JournalingRepository(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder
    )
        : base(inner, journal, descriptor, graphRecorder) { }

    /// <summary>
    /// Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder,
    /// saying whether it records the rows of its own table (see <see cref="JournalingRepositoryBase{TEntity, TKey}.RecordsOwnRows"/>).
    /// </summary>
    protected JournalingRepository(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder,
        bool recordsOwnRows
    )
        : base(inner, journal, descriptor, graphRecorder, recordsOwnRows) { }

    /// <summary>Reads the mirrored row version of the given entity.</summary>
    private byte[]? ReadRowVersion(TEntity entity) => Descriptor.ReadRowVersion(entity);

    /// <inheritdoc />
    protected sealed override async Task RecordDeleteAsync(
        TKey id,
        CancellationToken cancellationToken
    )
    {
        // The row has to be read before it goes: its mirrored version is the only thing that lets the delete be
        // replayed under a version guard, and once the row is gone there is nowhere left to read it from.
        if (!SyncSession.IsSuppressed)
        {
            var existing = await Inner.GetByIdAsync(id, cancellationToken).ConfigureAwait(false);
            await Journal.RecordAsync(
                TableName,
                FormatKey(id),
                SyncJournalOperation.Delete,
                existing is null ? null : ReadRowVersion(existing),
                cancellationToken
            )
                .ConfigureAwait(false);
        }
    }
}

/// <summary>Journaling decorator core for a table without a row-version column (a delete intent carries no version and replays unguarded).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class VersionlessJournalingRepository<TEntity, TKey>
    : JournalingRepositoryBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder.</summary>
    protected VersionlessJournalingRepository(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder
    )
        : base(inner, journal, descriptor, graphRecorder) { }

    /// <summary>
    /// Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder,
    /// saying whether it records the rows of its own table (see <see cref="JournalingRepositoryBase{TEntity, TKey}.RecordsOwnRows"/>).
    /// </summary>
    protected VersionlessJournalingRepository(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder,
        bool recordsOwnRows
    )
        : base(inner, journal, descriptor, graphRecorder, recordsOwnRows) { }

    /// <inheritdoc />
    protected sealed override Task RecordDeleteAsync(TKey id, CancellationToken cancellationToken) =>
        // No version column means there is no mirrored version to capture before the row goes; the delete replays
        // without a guard, which is all a last-write-wins table can promise anyway.
        Journal.RecordAsync(
            TableName,
            FormatKey(id),
            SyncJournalOperation.Delete,
            null,
            cancellationToken
        );
}

/// <summary>
/// Generic core of the direct (same-process database connection) server source: the key set and the change stream
/// come through the server's raw SQL surface, and the local changes are replayed through the server's ordinary
/// repository. What stays with the generated derived class is only the SQL text, which carries the table's identity.
/// </summary>
/// <remarks>
/// The paging members are virtual here rather than left to the interface's default implementations on purpose:
/// interface mapping is fixed at the class that lists the interface - this one - so a member a derived class adds later
/// would never be reached through the interface. A virtual with the same default keeps the dispatch open for the
/// versionless subclass, which does override them.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class DirectSyncSourceBase<TEntity, TKey> : ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    protected DirectSyncSourceBase(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
    {
        ArgumentNullException.ThrowIfNull(serverSqlExecutor);
        ArgumentNullException.ThrowIfNull(writer);
        ArgumentNullException.ThrowIfNull(descriptor);
        ServerSqlExecutor = serverSqlExecutor;
        Writer = writer;
        Descriptor = descriptor;
        BinaryColumns =
            descriptor.UnboundedBinaryColumnNames.Count == 0
                ? null
                : new SyncRepositoryBinaryColumns<TEntity, TKey>(descriptor, writer);
    }

    /// <summary>Gets the server's raw SQL surface the scans read through.</summary>
    protected ISqlExecutor ServerSqlExecutor { get; }

    /// <summary>Gets the table's descriptor (the SQL text that carries the table's identity).</summary>
    protected SyncTableDescriptor<TEntity, TKey> Descriptor { get; }

    /// <inheritdoc />
    public IRemoteRepositoryCore<TEntity, TKey> Writer { get; }

    /// <inheritdoc />
    /// <remarks>
    /// Null exactly when the descriptor names no unbounded binary column. The accessors are invoked on
    /// <see cref="Writer"/>, which is the generated server repository the direct registration hands in.
    /// </remarks>
    public ISyncBinaryColumns<TKey>? BinaryColumns { get; }

    /// <summary>SELECT that returns every primary key of the table (SQL Server quoting).</summary>
    protected string ServerKeysSql => Descriptor.ServerKeysSql;

    /// <inheritdoc />
    public abstract Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public abstract Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public virtual Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <inheritdoc />
    public virtual Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <inheritdoc />
    public async Task<IReadOnlyList<TKey>> GetAllKeysAsync(
        CancellationToken cancellationToken = default
    ) =>
        await ServerSqlExecutor.QueryProjectionBySqlAsync<TKey>(
            ServerKeysSql,
            null,
            cancellationToken
        )
            .ConfigureAwait(false);
}

/// <summary>Direct server source for a table with a row-version column (an ascending, anchored change scan).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class DirectSyncSource<TEntity, TKey> : DirectSyncSourceBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    public DirectSyncSource(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(serverSqlExecutor, writer, descriptor) { }

    /// <summary>SELECT that returns one ascending batch of rows above the anchor and below the ceiling (SQL Server quoting).</summary>
    private string ServerChangesSql => Descriptor.ServerChangesSql;

    /// <inheritdoc />
    public override async Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) =>
        await ServerSqlExecutor.ExecuteScalarSqlAsync<byte[]>(
            "SELECT MIN_ACTIVE_ROWVERSION()",
            null,
            cancellationToken
        )
            .ConfigureAwait(false);

    /// <inheritdoc />
    /// <remarks>
    /// A full batch is reported as "there is more", which the next call settles: it either returns the rest or comes
    /// back empty when the batch happened to end exactly on the boundary. The extra round trip in that case is the
    /// price of not fetching a row beyond the batch to peek with, and it costs one empty query per drained table.
    /// </remarks>
    public override async Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerChangesSql,
            new
            {
                anchor,
                ceiling,
                batchSize,
            },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }
}

/// <summary>Direct server source for a table without a row-version column (a key-ordered full scan, paged by primary key).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class VersionlessDirectSyncSource<TEntity, TKey>
    : DirectSyncSourceBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    public VersionlessDirectSyncSource(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(serverSqlExecutor, writer, descriptor) { }

    /// <summary>SELECT that returns the first ascending batch of rows by primary key (SQL Server quoting).</summary>
    private string ServerPageFirstSql => Descriptor.ServerPageFirstSql;

    /// <summary>SELECT that returns the next ascending batch of rows above a key (SQL Server quoting).</summary>
    private string ServerPageAfterSql => Descriptor.ServerPageAfterSql;

    /// <inheritdoc />
    /// <remarks>A key-ordered scan has no version to bound, so there is no ceiling to read.</remarks>
    public override Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => Task.FromResult<byte[]?>(null);

    /// <inheritdoc />
    /// <remarks>Never called for a table without a version column; the download pages by key instead.</remarks>
    public override Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "The table has no version column; its download pages by primary key."
        );

    /// <inheritdoc />
    /// <remarks>
    /// A full batch is reported as "there is more", which the next call settles: it either returns the rest or comes
    /// back empty when the batch happened to end exactly on the boundary - the same trade the versioned change scan
    /// makes.
    /// </remarks>
    public override async Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerPageFirstSql,
            new { batchSize },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }

    /// <inheritdoc />
    public override async Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerPageAfterSql,
            new { afterKey, batchSize },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }
}

/// <summary>
/// Thrown when a run finds a synchronised table empty locally while the change tracking holds rows of it that the server
/// knows and that have nothing to send: the table appears to have been made again empty.
/// </summary>
/// <remarks>
/// The run throws before it sends or downloads anything, so neither the local database nor the server changes. A run
/// would not bring the missing rows back (the download resumes after the rows it has already received) and could remove
/// the server's copies of rows it believes the device deleted. Rebuild the tables from the server with a refresh
/// (<c>RefreshAsync</c>).
/// </remarks>
public sealed class SyncLocalTableEmptiedException : InvalidOperationException
{
    /// <summary>Creates the exception from the tables found emptied.</summary>
    /// <param name="tableNames">The tables found emptied.</param>
    public SyncLocalTableEmptiedException(IReadOnlyList<string> tableNames)
        : base(BuildMessage(tableNames))
    {
        TableNames = tableNames;
    }

    /// <summary>The tables found emptied.</summary>
    public IReadOnlyList<string> TableNames { get; }

    /// <summary>Builds the message, which names the tables and the way back.</summary>
    private static string BuildMessage(IReadOnlyList<string> tableNames)
    {
        ArgumentNullException.ThrowIfNull(tableNames);

        return "The local table(s) "
            + string.Join(", ", tableNames)
            + " are empty, while the change tracking holds rows of them that this device had received from the server: "
            + "the tables appear to have been made again empty. Nothing was sent or downloaded. Rebuild them from the "
            + "server with a refresh (RefreshAsync).";
    }
}

/// <summary>
/// Thrown when one fetch of <see cref="TrackedSyncEngine"/> brings down more rows than
/// <see cref="SyncOptions.DownloadRowLimit"/> (or <see cref="SyncRefreshOptions.DownloadRowLimit"/>) while the tables of
/// the run hold unsent local changes.
/// </summary>
/// <remarks>
/// The rows fetched are dropped. The local database, the row state and the resume points are left unchanged, so the
/// unsent changes are still there to be sent and the next run fetches the same rows again.
/// </remarks>
public sealed class SyncDownloadTooLargeException : InvalidOperationException
{
    /// <summary>Creates the exception from the rows fetched, the limit and the per-table breakdown of the unsent changes.</summary>
    /// <param name="fetchedRowCount">The rows fetched when the run stopped.</param>
    /// <param name="rowLimit">The limit the fetch went over.</param>
    /// <param name="pendingChanges">The unsent local changes of the run's tables, grouped by table.</param>
    public SyncDownloadTooLargeException(
        int fetchedRowCount,
        int rowLimit,
        IReadOnlyList<SyncPendingChange> pendingChanges
    )
        : base(BuildMessage(fetchedRowCount, rowLimit, pendingChanges))
    {
        FetchedRowCount = fetchedRowCount;
        RowLimit = rowLimit;
        PendingChanges = pendingChanges;
        PendingCount = pendingChanges.Sum(change => change.Count);
    }

    /// <summary>The rows fetched when the run stopped.</summary>
    public int FetchedRowCount { get; }

    /// <summary>The limit the fetch went over.</summary>
    public int RowLimit { get; }

    /// <summary>The unsent local changes of the run's tables, grouped by table.</summary>
    public IReadOnlyList<SyncPendingChange> PendingChanges { get; }

    /// <summary>The total number of unsent local changes.</summary>
    public int PendingCount { get; }

    /// <summary>Builds the message, which names the counts, the tables and the ways out.</summary>
    private static string BuildMessage(int fetchedRowCount, int rowLimit, IReadOnlyList<SyncPendingChange> pendingChanges)
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        var breakdown = string.Join(
            ", ",
            pendingChanges.Select(change => $"{change.TableName}: {change.Count}")
        );

        return $"The download fetched {fetchedRowCount} row(s), more than the limit of {rowLimit}, while "
            + $"{pendingChanges.Sum(change => change.Count)} unsent local change(s) wait ({breakdown}). Nothing was "
            + "applied. Send the changes first with UploadAsync (and resolve any conflicts it reports), raise "
            + "DownloadRowLimit, or - if the local changes may be discarded - refresh with SyncRefreshOptions.Force.";
    }
}

/// <summary>One unsent local change of <see cref="TrackedSyncEngine"/>, as <see cref="TrackedSyncEngine.GetPendingChangesAsync"/> lists it.</summary>
/// <param name="TableName">The synchronised table the row belongs to (the table name of its descriptor).</param>
/// <param name="KeyText">The row's key as text, in the same form as <see cref="SyncConflict.KeyText"/>.</param>
/// <param name="IsDelete">Whether the row's latest change deleted it.</param>
/// <param name="KnownToServer">Whether the server is known to hold the row.</param>
/// <param name="IsDiscarded">
/// Whether the row's change is to be discarded and no run has carried that out yet: the next run whose scope covers the
/// table does not send it and puts the server's row back instead.
/// </param>
/// <param name="ChangeNumber">
/// The number of the row's latest change when the list was read. <see cref="TrackedSyncEngine.DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>
/// discards the row only while its change number is still this one, so a row written again since keeps its change.
/// </param>
public sealed record SyncPendingRow(
    string TableName,
    string KeyText,
    bool IsDelete,
    bool KnownToServer,
    bool IsDiscarded,
    long ChangeNumber
);

/// <summary>One unsent row of the row state table of <see cref="SyncLocalTracking"/> (a row whose <c>dirty</c> is set).</summary>
/// <param name="TableName">The synchronised table the row belongs to.</param>
/// <param name="RawKey">The key exactly as the row state table stores it (the value the synchronised table stores).</param>
/// <param name="Deleted">Whether the row's latest change deleted it.</param>
/// <param name="Known">Whether the server is known to hold the row.</param>
/// <param name="ChangeSequence">The number of the row's latest change.</param>
/// <param name="BaseVersion">The server version the local content is based on (null when none is known).</param>
/// <param name="BlobColumns">The unbounded binary columns written since the row was last sent (accessor names, comma separated).</param>
/// <param name="ServerWinsSequence">The change number a <see cref="SyncConflictPolicy.ServerWins"/> run decided to discard and could not, or null.</param>
internal sealed record TrackedSyncPendingRow(
    string TableName,
    object RawKey,
    bool Deleted,
    bool Known,
    long ChangeSequence,
    byte[]? BaseVersion,
    string BlobColumns,
    long? ServerWinsSequence
)
{
    /// <summary>Whether the row's latest change inserted or updated it (rather than deleting it).</summary>
    public bool Upserted => !Deleted;
}

/// <summary>What the row state table of <see cref="SyncLocalTracking"/> holds for one row.</summary>
internal sealed record TrackedSyncRowState
{
    /// <summary>The key exactly as the row state table stores it.</summary>
    public required object RawKey { get; init; }

    /// <summary>The server version the local content is based on (null when none is known).</summary>
    public byte[]? BaseVersion { get; init; }

    /// <summary>Whether the server is known to hold the row.</summary>
    public bool Known { get; init; }

    /// <summary>Whether the row holds an unsent change.</summary>
    public bool Dirty { get; init; }

    /// <summary>The number of the row's latest change.</summary>
    public long ChangeSequence { get; init; }

    /// <summary>The unbounded binary columns written since the row was last sent (accessor names, comma separated).</summary>
    public string BlobColumns { get; init; } = string.Empty;

    /// <summary>The unbounded binary columns still to be copied down from the server (accessor names, comma separated).</summary>
    public string BlobOwed { get; init; } = string.Empty;
}

/// <summary>
/// Every read and write of the state tables of <see cref="SyncLocalTracking"/> that <see cref="TrackedSyncEngine"/>
/// makes: the row state table, the state table and the anchor table.
/// </summary>
/// <remarks>
/// The statements run on the connection passed in, inside whatever transaction the caller started with an SQL statement.
/// Keys are bound exactly as the row state table stores them (the raw value the triggers copied from the synchronised
/// table), so a key read from it can be bound back unchanged.
/// </remarks>
internal static class TrackedSyncState
{
    /// <summary>The columns of a row state read, in the order <see cref="ReadRowState"/> reads them.</summary>
    private const string RowStateColumns =
        "\"key\", base_version, known, dirty, change_seq, blob_columns, blob_owed";

    /// <summary>
    /// Reads every unsent row (the table, the key, whether it was inserted or updated or deleted, and the change number),
    /// in the order of the changes.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<IReadOnlyList<TrackedSyncPendingRow>> ReadPendingAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    )
    {
        var pending = new List<TrackedSyncPendingRow>();

        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT table_name, \"key\", deleted, known, change_seq, base_version, blob_columns, sw_seq FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE dirty = 1 ORDER BY change_seq";

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            pending.Add(
                new TrackedSyncPendingRow(
                    reader.GetString(0),
                    reader.GetValue(1),
                    reader.GetInt64(2) != 0,
                    reader.GetInt64(3) != 0,
                    reader.GetInt64(4),
                    reader.IsDBNull(5) ? null : (byte[])reader.GetValue(5),
                    reader.GetString(6),
                    reader.IsDBNull(7) ? null : reader.GetInt64(7)
                )
            );
        }

        return pending;
    }

    /// <summary>
    /// Drops the state of a row with nothing to send (gone locally and never on the server), only while its change number is
    /// still the one read.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="changeSequence">The change number read with the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task ForgetPendingAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        long changeSequence,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "DELETE FROM "
                + SyncLocalTracking.RowTableName
                + " WHERE table_name = @table AND \"key\" = @key AND change_seq = @seq",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey),
            ("@seq", changeSequence)
        );

    /// <summary>
    /// Records, before a row's unbounded binary columns are sent, the version its row write earned and that the server knows
    /// it (the unsent change stays), widens the columns written to every column for a row the server took as an insert, and
    /// adds the columns an overwrite leaves owing - so that a failure while the columns go leaves the next run guarding
    /// against this device's own write and sending every column a new server row lacks.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="version">The version the row write earned (null for a table without a version column).</param>
    /// <param name="widen">Every unbounded binary column, for a row the server took as an insert; otherwise empty.</param>
    /// <param name="owed">The unbounded binary columns an overwrite leaves owing from the server.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task RecordInterimAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        byte[]? version,
        IReadOnlyList<string> widen,
        IReadOnlyList<string> owed,
        CancellationToken cancellationToken
    )
    {
        await ExecuteAsync(
                connection,
                "UPDATE "
                    + SyncLocalTracking.RowTableName
                    + " SET base_version = @version, known = 1, "
                    + "blob_columns = CASE WHEN @widen = '' THEN blob_columns ELSE @widen END "
                    + "WHERE table_name = @table AND \"key\" = @key",
                cancellationToken,
                ("@version", version),
                ("@widen", string.Join(",", widen)),
                ("@table", tableName),
                ("@key", rawKey)
            )
            .ConfigureAwait(false);

        if (owed.Count > 0)
        {
            await AddOwedAsync(connection, tableName, rawKey, owed, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Records that a row's write reached the server: its base version and that the server knows it, and - only while its
    /// change number is still the one read - that it has nothing more to send.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="version">The version the server now holds for the row (null for a table without a version column).</param>
    /// <param name="changeSequence">The change number read with the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task SettleSentAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        byte[]? version,
        long changeSequence,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE "
                + SyncLocalTracking.RowTableName
                + " SET base_version = @version, known = 1, "
                + "dirty = CASE WHEN change_seq = @seq THEN 0 ELSE dirty END, "
                + "deleted = CASE WHEN change_seq = @seq THEN 0 ELSE deleted END, "
                + "blob_columns = CASE WHEN change_seq = @seq THEN '' ELSE blob_columns END "
                + "WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@version", version),
            ("@seq", changeSequence),
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>
    /// Records that a row's delete reached the server: the state goes while its change number is still the one read, and a
    /// row made again under the key since stays as a row the server does not have.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="changeSequence">The change number read with the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task SettleDeletedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        long changeSequence,
        CancellationToken cancellationToken
    )
    {
        await ForgetPendingAsync(connection, tableName, rawKey, changeSequence, cancellationToken)
            .ConfigureAwait(false);
        await ExecuteAsync(
                connection,
                "UPDATE "
                    + SyncLocalTracking.RowTableName
                    + " SET known = 0, base_version = NULL WHERE table_name = @table AND \"key\" = @key",
                cancellationToken,
                ("@table", tableName),
                ("@key", rawKey)
            )
            .ConfigureAwait(false);
    }

    /// <summary>Adds unbounded binary columns to the ones a row still has to copy down (merged, without repeats).</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="columns">The columns (accessor names) to add.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task AddOwedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        IEnumerable<string> columns,
        CancellationToken cancellationToken
    )
    {
        if (await ReadRowAsync(connection, tableName, rawKey, cancellationToken).ConfigureAwait(false) is not { } row)
        {
            return;
        }

        var merged = row
            .BlobOwed.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Concat(columns)
            .Distinct(StringComparer.Ordinal)
            .Order(StringComparer.Ordinal);
        await WriteOwedAsync(connection, tableName, rawKey, string.Join(",", merged), cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Clears the unsent change of a row a <see cref="SyncConflictPolicy.ServerWins"/> run discards.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task ClearDiscardedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE "
                + SyncLocalTracking.RowTableName
                + " SET dirty = 0, deleted = 0, blob_columns = '', sw_seq = NULL WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>
    /// Carries a <see cref="SyncConflictPolicy.ServerWins"/> decision the run could not carry out over to later runs: the row's
    /// current change number is marked, so later runs do not send the row and put the server's content back instead. A
    /// later local write moves the change number on, and the mark no longer applies.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task MarkServerWinsAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE "
                + SyncLocalTracking.RowTableName
                + " SET sw_seq = change_seq WHERE table_name = @table AND \"key\" = @key AND dirty = 1",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>
    /// Whether the local table is empty while the row state table holds rows of it the server knows and that have nothing
    /// to send (the table appears to have been made again empty).
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="qualifiedLocalName">The local table's name, quoted.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<bool> IsEmptiedAsync(
        DbConnection connection,
        string tableName,
        string qualifiedLocalName,
        CancellationToken cancellationToken
    )
    {
        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT NOT EXISTS (SELECT 1 FROM "
            + qualifiedLocalName
            + ") AND EXISTS (SELECT 1 FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE table_name = @table AND known = 1 AND dirty = 0)";
        AddParameter(command, "@table", tableName);

        return Convert.ToInt64(
                await command.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false),
                CultureInfo.InvariantCulture
            ) != 0;
    }

    /// <summary>Reads the state of every row of one table, by the key text the table gives each raw key.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="keyText">Renders a raw key into the table's key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<Dictionary<string, TrackedSyncRowState>> ReadRowsAsync(
        DbConnection connection,
        string tableName,
        Func<object, string> keyText,
        CancellationToken cancellationToken
    )
    {
        var rows = new Dictionary<string, TrackedSyncRowState>(StringComparer.Ordinal);

        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT " + RowStateColumns + " FROM " + SyncLocalTracking.RowTableName + " WHERE table_name = @table";
        AddParameter(command, "@table", tableName);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            var state = ReadRowState(reader);
            rows[keyText(state.RawKey)] = state;
        }

        return rows;
    }

    /// <summary>The temporary table <see cref="ReadRowsByKeyAsync"/> turns keys into stored keys through.</summary>
    private const string StoredKeyTableName = "quicker_sync_stored_keys";

    /// <summary>The most keys bound in one statement (well under SQLite's limit on the number of parameters).</summary>
    private const int MaxKeysPerStatement = 500;

    /// <summary>
    /// Reads the states of the rows with the given keys only (never every row state of the table), by the key text the
    /// table gives each raw key, together with each key exactly as the synchronised table stores it, by key text.
    /// </summary>
    /// <remarks>
    /// Each key is bound the way the local row store binds a key (a value object as its underlying value) into a temporary
    /// table whose column takes the affinity of the synchronised table's key column, so the value read back is the key as
    /// that table stores it - and as the row state table, which copies it, stores it. The row states are then read by those
    /// values, a bounded number at a time.
    /// </remarks>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="qualifiedLocalName">The synchronised table's local name, quoted.</param>
    /// <param name="quotedKeyColumn">The synchronised table's key column, quoted.</param>
    /// <param name="keys">The keys, of the table's key type.</param>
    /// <param name="keyText">Renders a raw key into the table's key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<(
        Dictionary<string, TrackedSyncRowState> States,
        Dictionary<string, object> RawKeys
    )> ReadRowsByKeyAsync(
        DbConnection connection,
        string tableName,
        string qualifiedLocalName,
        string quotedKeyColumn,
        IReadOnlyList<object> keys,
        Func<object, string> keyText,
        CancellationToken cancellationToken
    )
    {
        var states = new Dictionary<string, TrackedSyncRowState>(StringComparer.Ordinal);
        var rawKeys = new Dictionary<string, object>(StringComparer.Ordinal);

        if (keys.Count == 0)
        {
            return (states, rawKeys);
        }

        await ExecuteAsync(connection, "DROP TABLE IF EXISTS temp." + StoredKeyTableName, cancellationToken)
            .ConfigureAwait(false);
        await ExecuteAsync(
                connection,
                "CREATE TEMP TABLE "
                    + StoredKeyTableName
                    + " AS SELECT "
                    + quotedKeyColumn
                    + " AS k FROM "
                    + qualifiedLocalName
                    + " WHERE 0",
                cancellationToken
            )
            .ConfigureAwait(false);

        for (var start = 0; start < keys.Count; start += MaxKeysPerStatement)
        {
            var count = Math.Min(MaxKeysPerStatement, keys.Count - start);
            await using var insert = connection.CreateCommand();
            insert.CommandText =
                "INSERT INTO temp."
                + StoredKeyTableName
                + " (k) VALUES "
                + string.Join(
                    ", ",
                    Enumerable.Range(0, count).Select(index => "(@k" + index.ToString(CultureInfo.InvariantCulture) + ")")
                );

            for (var index = 0; index < count; index++)
            {
{{~ if generate_value_objects ~}}
                AddParameter(
                    insert,
                    "@k" + index.ToString(CultureInfo.InvariantCulture),
                    SqlParameterValue.Unwrap(keys[start + index])
                );
{{~ else ~}}
                AddParameter(insert, "@k" + index.ToString(CultureInfo.InvariantCulture), keys[start + index]);
{{~ end ~}}
            }

            await insert.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
        }

        var stored = new List<object>(keys.Count);

        await using (var read = connection.CreateCommand())
        {
            read.CommandText = "SELECT k FROM temp." + StoredKeyTableName;
            await using var reader = await read.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                if (!reader.IsDBNull(0))
                {
                    var rawKey = reader.GetValue(0);
                    stored.Add(rawKey);
                    rawKeys[keyText(rawKey)] = rawKey;
                }
            }
        }

        await ExecuteAsync(connection, "DROP TABLE temp." + StoredKeyTableName, cancellationToken).ConfigureAwait(false);

        for (var start = 0; start < stored.Count; start += MaxKeysPerStatement)
        {
            var count = Math.Min(MaxKeysPerStatement, stored.Count - start);
            await using var command = connection.CreateCommand();
            command.CommandText =
                "SELECT "
                + RowStateColumns
                + " FROM "
                + SyncLocalTracking.RowTableName
                + " WHERE table_name = @table AND \"key\" IN ("
                + string.Join(
                    ", ",
                    Enumerable.Range(0, count).Select(index => "@k" + index.ToString(CultureInfo.InvariantCulture))
                )
                + ")";
            AddParameter(command, "@table", tableName);

            for (var index = 0; index < count; index++)
            {
                AddParameter(command, "@k" + index.ToString(CultureInfo.InvariantCulture), stored[start + index]);
            }

            await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                var state = ReadRowState(reader);
                states[keyText(state.RawKey)] = state;
            }
        }

        return (states, rawKeys);
    }

    /// <summary>Reads the state of one row (null when the row state table has no row for it).</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<TrackedSyncRowState?> ReadRowAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    )
    {
        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT "
            + RowStateColumns
            + " FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE table_name = @table AND \"key\" = @key";
        AddParameter(command, "@table", tableName);
        AddParameter(command, "@key", rawKey);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        return await reader.ReadAsync(cancellationToken).ConfigureAwait(false) ? ReadRowState(reader) : null;
    }

    /// <summary>
    /// Records that a row now holds the server's content: its base version, that the server knows it, and no unsent
    /// change. A non-empty <paramref name="owed"/> replaces the columns still to be copied down; an empty one keeps them.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the synchronised table stores it.</param>
    /// <param name="version">The server version of the content written (null for a table without a version column).</param>
    /// <param name="owed">The unbounded binary columns to copy down from the server (accessor names, comma separated), or empty.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task WriteAppliedRowAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        byte[]? version,
        string owed,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "INSERT INTO "
                + SyncLocalTracking.RowTableName
                + " (table_name, \"key\", dirty, deleted, blob_columns, change_seq, base_version, known, blob_owed) "
                + "VALUES (@table, @key, 0, 0, '', 0, @version, 1, @owed) "
                + "ON CONFLICT (table_name, \"key\") DO UPDATE SET base_version = excluded.base_version, known = 1, "
                + "dirty = 0, deleted = 0, blob_columns = '', sw_seq = NULL, "
                + "blob_owed = CASE WHEN @owed = '' THEN blob_owed ELSE @owed END",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey),
            ("@version", version),
            ("@owed", owed)
        );

    /// <summary>Drops the unbounded binary columns every row of one table still owes.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task ClearTableOwedAsync(
        DbConnection connection,
        string tableName,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE " + SyncLocalTracking.RowTableName + " SET blob_owed = '' WHERE table_name = @table",
            cancellationToken,
            ("@table", tableName)
        );

    /// <summary>Removes the state of one row.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task RemoveRowAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "DELETE FROM " + SyncLocalTracking.RowTableName + " WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>Reads the rows of one table that still have unbounded binary columns to copy down.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<IReadOnlyList<TrackedSyncRowState>> ReadOwedAsync(
        DbConnection connection,
        string tableName,
        CancellationToken cancellationToken
    )
    {
        var rows = new List<TrackedSyncRowState>();

        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT "
            + RowStateColumns
            + " FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE table_name = @table AND blob_owed <> ''";
        AddParameter(command, "@table", tableName);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            rows.Add(ReadRowState(reader));
        }

        return rows;
    }

    /// <summary>Replaces the unbounded binary columns one row still has to copy down.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="owed">The columns still owed (accessor names, comma separated; empty when none is).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task WriteOwedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        string owed,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE " + SyncLocalTracking.RowTableName + " SET blob_owed = @owed WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@owed", owed),
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>Sets or clears the applying flag the triggers check (what is written while it is set is not recorded).</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="applying">Whether the flag is set.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The number of rows of the state table that were written (1 when the change tracking is set up).</returns>
    public static Task<int> SetApplyingAsync(
        DbConnection connection,
        bool applying,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE " + SyncLocalTracking.StateTableName + " SET applying = " + (applying ? "1" : "0"),
            cancellationToken
        );

    /// <summary>Reads where each table's next download resumes, by table name.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<Dictionary<string, byte[]?>> ReadAnchorsAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    )
    {
        var anchors = new Dictionary<string, byte[]?>(StringComparer.Ordinal);

        await using var command = connection.CreateCommand();
        command.CommandText = "SELECT table_name, anchor FROM " + SyncLocalTracking.AnchorTableName;

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            anchors[reader.GetString(0)] = reader.IsDBNull(1) ? null : (byte[])reader.GetValue(1);
        }

        return anchors;
    }

    /// <summary>Saves where one table's next download resumes.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="anchor">The version to resume above (null to take everything).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task WriteAnchorAsync(
        DbConnection connection,
        string tableName,
        byte[]? anchor,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "INSERT INTO "
                + SyncLocalTracking.AnchorTableName
                + " (table_name, anchor) VALUES (@table, @anchor) "
                + "ON CONFLICT (table_name) DO UPDATE SET anchor = excluded.anchor",
            cancellationToken,
            ("@table", tableName),
            ("@anchor", anchor)
        );

    /// <summary>Runs one statement that returns no rows, and returns the number of rows it changed.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="sql">One statement.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <param name="parameters">The parameters, by name (a null value is bound as NULL).</param>
    internal static async Task<int> ExecuteAsync(
        DbConnection connection,
        string sql,
        CancellationToken cancellationToken,
        params (string Name, object? Value)[] parameters
    )
    {
        await using var command = connection.CreateCommand();
        command.CommandText = sql;

        foreach (var (name, value) in parameters)
        {
            AddParameter(command, name, value);
        }

        return await command.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Adds a parameter to a command (null is bound as NULL).</summary>
    internal static void AddParameter(DbCommand command, string name, object? value)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.Value = value ?? DBNull.Value;
        command.Parameters.Add(parameter);
    }

    /// <summary>Reads the columns of <see cref="RowStateColumns"/> off the current row of the reader.</summary>
    private static TrackedSyncRowState ReadRowState(DbDataReader reader) =>
        new()
        {
            RawKey = reader.GetValue(0),
            BaseVersion = reader.IsDBNull(1) ? null : (byte[])reader.GetValue(1),
            Known = reader.GetInt64(2) != 0,
            Dirty = reader.GetInt64(3) != 0,
            ChangeSequence = reader.GetInt64(4),
            BlobColumns = reader.GetString(5),
            BlobOwed = reader.GetString(6),
        };
}

/// <summary>How one write of an unsent row to the server ended.</summary>
internal enum TrackedSyncSendKind
{
    /// <summary>The write reached the server.</summary>
    Sent,

    /// <summary>The server's version disagreed (<see cref="SyncConflictReason.ModifiedOnServer"/>, <see cref="SyncConflictReason.MissingOnServer"/>, <see cref="SyncConflictReason.DuplicateOnServer"/>).</summary>
    Conflict,

    /// <summary>There was nothing to send (the row is gone locally and the server never had it).</summary>
    Discarded,

    /// <summary>The write to the server threw; why is for the engine to look up.</summary>
    Failed,
}

/// <summary>What one write of an unsent row to the server did.</summary>
/// <param name="Kind">How it ended.</param>
internal sealed record TrackedSyncSend(TrackedSyncSendKind Kind)
{
    /// <summary>Whether the write deleted the row on the server.</summary>
    public bool Deleted { get; init; }

    /// <summary>Whether the write inserted the row on the server.</summary>
    public bool Inserted { get; init; }

    /// <summary>Whether the write overwrote the server row without a version check.</summary>
    public bool Forced { get; init; }

    /// <summary>The disagreement, for a <see cref="TrackedSyncSendKind.Conflict"/>.</summary>
    public SyncConflictReason Reason { get; init; }

    /// <summary>The local row sent (null for a delete).</summary>
    public object? Local { get; init; }

    /// <summary>The server row as it stands, for a <see cref="TrackedSyncSendKind.Conflict"/> (null when the server has none).</summary>
    public object? Server { get; init; }

    /// <summary>The exception the server write threw, for a <see cref="TrackedSyncSendKind.Failed"/>.</summary>
    public Exception? Error { get; init; }

    /// <summary>
    /// The version the writer stamped on the row it accepted, for a <see cref="TrackedSyncSendKind.Sent"/> upsert (null when
    /// the writer left the version the row carried before the write, or for a table without a version column).
    /// </summary>
    public byte[]? Version { get; init; }
}

/// <summary>What <see cref="TrackedSyncEngine"/> asks of one table, without the table's entity and key types.</summary>
internal interface ITrackedSyncTable
{
    /// <summary>Reads the local row with the key (null when there is none).</summary>
    Task<EntityBaseCore?> FindAsync(DbConnection connection, object key, CancellationToken cancellationToken);

    /// <summary>
    /// Writes one unsent row to the server: an update guarded by the base version when the local row is there and the
    /// server knows it, an insert (after making sure the server has no such key) when the server does not know it, a delete
    /// guarded by the base version when the local row is gone and the server knows it, and nothing when the local row is
    /// gone and the server never had it. A forced write (or a table without a version column) overwrites without a version
    /// check, inserting when the server has no such row, and deletes unconditionally. Only the row goes: the unbounded
    /// binary columns are sent afterwards by the engine.
    /// </summary>
    Task<TrackedSyncSend> SendAsync(
        TrackedSyncPendingRow pending,
        object key,
        EntityBaseCore? local,
        bool force,
        CancellationToken cancellationToken
    );

    /// <summary>Reads one unbounded binary column of the local row into the stream (false when the row is gone or the column is NULL).</summary>
    Task<bool> ReadLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream destination,
        CancellationToken cancellationToken
    );

    /// <summary>Writes one unbounded binary column of the server row from the stream (NULL when the stream is null).</summary>
    Task WriteServerBinaryAsync(
        string propertyName,
        object key,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    );

    /// <summary>The database column names of the unbounded binary columns, unquoted, in the same order.</summary>
    IReadOnlyList<string> LocalUnboundedBinaryColumnNames { get; }

    /// <summary>Returns the tables outside the given scope whose local rows refer to a local row of this table (what a refresh refuses to run for).</summary>
    Task<IReadOnlyList<string>> FindReferencesFromOutsideAsync(
        DbConnection connection,
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    );

    /// <summary>Reads the server row with the key (null when there is none).</summary>
    Task<EntityBaseCore?> ReadServerAsync(object key, CancellationToken cancellationToken);

    /// <summary>Whether the server holds the row with the key text.</summary>
    Task<bool> ServerHasAsync(string keyText, CancellationToken cancellationToken);

    /// <summary>Whether a server row of this table refers to the given row by its primary key.</summary>
    Task<bool> ServerReferencesAsync(string parentTableName, string parentKeyText, CancellationToken cancellationToken);

    /// <summary>Whether another server row holds one of the row's unique values.</summary>
    Task<bool> CollidesOnServerAsync(EntityBaseCore local, CancellationToken cancellationToken);

    /// <summary>The parents a row refers to by their primary keys (the parent's table and key text, null for no parent).</summary>
    IEnumerable<(string TableName, string? KeyText)> ParentsOf(EntityBaseCore row);

    /// <summary>The table name, as the row state table records it.</summary>
    string TableName { get; }

    /// <summary>The entity type the table synchronises.</summary>
    Type EntityType { get; }

    /// <summary>Whether the table has no version column.</summary>
    bool IsVersionless { get; }

    /// <summary>The excluded unbounded binary columns (accessor names).</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>The local table name without its schema part, unquoted.</summary>
    string LocalTableName { get; }

    /// <summary>The schema part of the local table name, unquoted (null when the name has none).</summary>
    string? LocalDatabaseName { get; }

    /// <summary>The local primary key column, unquoted.</summary>
    string LocalKeyColumnName { get; }

    /// <summary>The local row store the table reads and writes its rows through.</summary>
    ILocalRowStore Rows { get; }

    /// <summary>The key text of a key of the table's key type.</summary>
    string KeyText(object key);

    /// <summary>The key of the table's key type for a key as the database stores it.</summary>
    object KeyOfRaw(object rawKey);

    /// <summary>The key text of a key as the database stores it.</summary>
    string KeyTextOfRaw(object rawKey);

    /// <summary>The key of a row.</summary>
    object KeyOf(EntityBaseCore row);

    /// <summary>The server version a row carries (null for a table without a version column).</summary>
    byte[]? VersionOf(EntityBaseCore row);

    /// <summary>Sets the server version a row carries (nothing for a table without a version column).</summary>
    void SetVersion(EntityBaseCore row, byte[]? version);

    /// <summary>Gets the server's change ceiling (null for a table without a version column).</summary>
    Task<byte[]?> GetCeilingAsync(CancellationToken cancellationToken);

    /// <summary>
    /// Fetches every server row above the anchor and below the ceiling (every row for a table without a version column),
    /// one page at a time, in the order they come (ascending version, or ascending key for a table without a version
    /// column). Empty pages are not returned. A source that says more rows follow a page whose last row does not advance
    /// past the anchor (or key) the page was asked for ends the enumeration with an <see cref="InvalidOperationException"/>.
    /// </summary>
    IAsyncEnumerable<IReadOnlyList<EntityBaseCore>> FetchPagesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken
    );

    /// <summary>Fetches the key texts of every row the server holds.</summary>
    Task<IReadOnlySet<string>> FetchServerKeysAsync(CancellationToken cancellationToken);

    /// <summary>Whether the local table has a row with the key.</summary>
    Task<bool> ExistsAsync(DbConnection connection, object key, CancellationToken cancellationToken);

    /// <summary>Inserts a server row locally, giving its unset NOT NULL excluded binary columns an empty value first.</summary>
    Task InsertAsync(DbConnection connection, EntityBaseCore row, CancellationToken cancellationToken);

    /// <summary>Overwrites the local row with a server row (the excluded binary columns are not touched).</summary>
    Task UpdateAsync(DbConnection connection, EntityBaseCore row, CancellationToken cancellationToken);

    /// <summary>Deletes the local row with the key.</summary>
    Task<bool> DeleteAsync(DbConnection connection, object key, CancellationToken cancellationToken);

    /// <summary>Reads every local key.</summary>
    Task<IReadOnlyList<object>> ListKeysAsync(DbConnection connection, CancellationToken cancellationToken);

    /// <summary>Copies one excluded binary column of the server row into the stream (false when the server has no such row or the column is NULL).</summary>
    Task<bool> ReadServerBinaryAsync(
        string propertyName,
        object key,
        Stream destination,
        CancellationToken cancellationToken
    );

    /// <summary>Writes one excluded binary column of the local row from the stream (NULL when the stream is null), inside the caller's transaction.</summary>
    Task<bool> WriteLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    );
}

/// <summary>
/// One synchronised table of <see cref="TrackedSyncEngine"/>: its descriptor, the server's differential source, and the
/// local row store its rows are read and written through.
/// </summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class TrackedSyncTable<TEntity, TKey> : ITrackedSyncTable
    where TEntity : EntityBaseCore, new()
{
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;
    private readonly ISyncServerSource<TEntity, TKey> _source;
    private readonly ILocalRowStore _rows;

    /// <summary>Creates the table over its descriptor, the server's differential source and the local row store.</summary>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="source">The server's differential source of the table (and its unbounded binary columns).</param>
    /// <param name="rows">The local row store (every table of one engine shares the same one).</param>
    public TrackedSyncTable(
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISyncServerSource<TEntity, TKey> source,
        ILocalRowStore rows
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(source);
        ArgumentNullException.ThrowIfNull(rows);
        _descriptor = descriptor;
        _source = source;
        _rows = rows;
    }

    string ITrackedSyncTable.TableName => _descriptor.TableName;

    Type ITrackedSyncTable.EntityType => typeof(TEntity);

    bool ITrackedSyncTable.IsVersionless => _descriptor.IsVersionless;

    IReadOnlyList<string> ITrackedSyncTable.UnboundedBinaryColumnNames => _descriptor.UnboundedBinaryColumnNames;

    string ITrackedSyncTable.LocalTableName => _descriptor.LocalTableName;

    string? ITrackedSyncTable.LocalDatabaseName => _descriptor.LocalDatabaseName;

    string ITrackedSyncTable.LocalKeyColumnName => _descriptor.LocalKeyColumnName;

    ILocalRowStore ITrackedSyncTable.Rows => _rows;

    string ITrackedSyncTable.KeyText(object key) => _descriptor.FormatKey((TKey)key);

    object ITrackedSyncTable.KeyOfRaw(object rawKey) => _rows.ConvertKey<TEntity>(rawKey);

    string ITrackedSyncTable.KeyTextOfRaw(object rawKey) =>
        _descriptor.FormatKey((TKey)_rows.ConvertKey<TEntity>(rawKey));

    async Task<EntityBaseCore?> ITrackedSyncTable.FindAsync(
        DbConnection connection,
        object key,
        CancellationToken cancellationToken
    ) => await _rows.FindAsync<TEntity>(connection, key, cancellationToken).ConfigureAwait(false);

    async Task<TrackedSyncSend> ITrackedSyncTable.SendAsync(
        TrackedSyncPendingRow pending,
        object key,
        EntityBaseCore? local,
        bool force,
        CancellationToken cancellationToken
    )
    {
        var typedKey = (TKey)key;
        var writer = _source.Writer;
        var versionless = _descriptor.IsVersionless;

        try
        {
            if (local is null)
            {
                // Gone locally: a row the server never had has nothing to send (a table without a version column is always known)
                if (!versionless && !pending.Known)
                {
                    return new(TrackedSyncSendKind.Discarded);
                }

                if (versionless || force)
                {
                    await writer.DeleteAsync(typedKey, cancellationToken).ConfigureAwait(false);

                    return new(TrackedSyncSendKind.Sent) { Deleted = true };
                }

                // A delete guarded by the base version: a delete by key alone is not version-checked, so a stub carrying the
                // version is saved as removed
                var stub = new TEntity();
                _descriptor.WriteKey(stub, typedKey);
                _descriptor.WriteRowVersion(stub, pending.BaseVersion);
                stub.MarkRemoved();

                try
                {
                    await writer.SaveAsync(stub, cancellationToken: cancellationToken).ConfigureAwait(false);
                }
                catch (SaveConflictException conflict) when (conflict.Reason == SaveConflictReason.Modified)
                {
                    return new(TrackedSyncSendKind.Conflict)
                    {
                        Reason = SyncConflictReason.ModifiedOnServer,
                        Server = await writer.GetByIdAsync(typedKey, cancellationToken).ConfigureAwait(false),
                    };
                }

                return new(TrackedSyncSendKind.Sent) { Deleted = true };
            }

            var entity = (TEntity)local;

            if (versionless || force)
            {
                var beforeOverwrite = VersionCarried(entity);

                if (
                    await writer
                        .UpdateAsync(entity, ConcurrencyMode.ForceOverwrite, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    return new(TrackedSyncSendKind.Sent) { Forced = true, Version = Stamped(entity, beforeOverwrite) };
                }

                // The server has no such row: it is inserted, and the engine then sends every binary column
                _descriptor.FillUnsetUnboundedBinaries(entity);
                var beforeForcedInsert = VersionCarried(entity);
                await writer.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

                return new(TrackedSyncSendKind.Sent)
                {
                    Inserted = true,
                    Forced = true,
                    Version = Stamped(entity, beforeForcedInsert),
                };
            }

            if (pending.Known)
            {
                _descriptor.WriteRowVersion(entity, pending.BaseVersion);

                try
                {
                    if (
                        !await writer
                            .UpdateAsync(entity, ConcurrencyMode.Optimistic, cancellationToken)
                            .ConfigureAwait(false)
                    )
                    {
                        return new(TrackedSyncSendKind.Conflict)
                        {
                            Reason = SyncConflictReason.MissingOnServer,
                            Local = entity,
                        };
                    }
                }
                catch (SaveConflictException conflict)
                {
                    var server = await writer.GetByIdAsync(typedKey, cancellationToken).ConfigureAwait(false);

                    return new(TrackedSyncSendKind.Conflict)
                    {
                        Reason =
                            conflict.Reason == SaveConflictReason.NotFound || server is null
                                ? SyncConflictReason.MissingOnServer
                                : SyncConflictReason.ModifiedOnServer,
                        Local = entity,
                        Server = server,
                    };
                }

                return new(TrackedSyncSendKind.Sent) { Version = Stamped(entity, pending.BaseVersion) };
            }

            // Made here under a key the server does not know: the server must not have the key already
            if (await writer.GetByIdAsync(typedKey, cancellationToken).ConfigureAwait(false) is { } existing)
            {
                return new(TrackedSyncSendKind.Conflict)
                {
                    Reason = SyncConflictReason.DuplicateOnServer,
                    Local = entity,
                    Server = existing,
                };
            }

            _descriptor.FillUnsetUnboundedBinaries(entity);
            var beforeInsert = VersionCarried(entity);
            await writer.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

            return new(TrackedSyncSendKind.Sent) { Inserted = true, Version = Stamped(entity, beforeInsert) };
        }
        catch (Exception failure) when (failure is not OperationCanceledException)
        {
            return new(TrackedSyncSendKind.Failed) { Error = failure, Local = local };
        }

        // The version the row carries before a write (null for a table without a version column)
        byte[]? VersionCarried(TEntity row) => versionless ? null : _descriptor.ReadRowVersion(row);

        // The version the writer stamped on the row it accepted: null when it left the version the row carried before
        // the write, which the engine then reads back from the server instead
        byte[]? Stamped(TEntity row, byte[]? before) =>
            !versionless
            && _descriptor.ReadRowVersion(row) is { Length: > 0 } after
            && !(before is not null && after.AsSpan().SequenceEqual(before))
                ? after
                : null;
    }

    async Task<EntityBaseCore?> ITrackedSyncTable.ReadServerAsync(object key, CancellationToken cancellationToken) =>
        await _source.Writer.GetByIdAsync((TKey)key, cancellationToken).ConfigureAwait(false);

    async Task<bool> ITrackedSyncTable.ServerHasAsync(string keyText, CancellationToken cancellationToken) =>
        await _source.Writer.GetByIdAsync(_descriptor.ParseKey(keyText), cancellationToken).ConfigureAwait(false)
            is not null;

    async Task<bool> ITrackedSyncTable.ServerReferencesAsync(
        string parentTableName,
        string parentKeyText,
        CancellationToken cancellationToken
    )
    {
        if (!_descriptor.ParentReferences.Any(reference => reference.ParentTableName == parentTableName))
        {
            return false;
        }

        var rows = await _source.Writer.GetAllAsync(cancellationToken).ConfigureAwait(false);

        return rows.Any(row =>
            _descriptor.ParentReferences.Any(reference =>
                reference.ParentTableName == parentTableName
                && string.Equals(reference.ReadParentKeyText(row), parentKeyText, StringComparison.Ordinal)
            )
        );
    }

    async Task<bool> ITrackedSyncTable.CollidesOnServerAsync(EntityBaseCore local, CancellationToken cancellationToken) =>
        (await _source.Writer.CheckUniquenessAsync((TEntity)local, cancellationToken).ConfigureAwait(false)).Count > 0;

    IEnumerable<(string TableName, string? KeyText)> ITrackedSyncTable.ParentsOf(EntityBaseCore row) =>
        _descriptor.ParentReferences.Select(reference =>
            (reference.ParentTableName, reference.ReadParentKeyText((TEntity)row))
        );

    object ITrackedSyncTable.KeyOf(EntityBaseCore row) => _descriptor.ReadKey((TEntity)row)!;

    byte[]? ITrackedSyncTable.VersionOf(EntityBaseCore row) =>
        _descriptor.IsVersionless ? null : _descriptor.ReadRowVersion((TEntity)row);

    void ITrackedSyncTable.SetVersion(EntityBaseCore row, byte[]? version)
    {
        if (!_descriptor.IsVersionless)
        {
            _descriptor.WriteRowVersion((TEntity)row, version);
        }
    }

    async Task<byte[]?> ITrackedSyncTable.GetCeilingAsync(CancellationToken cancellationToken) =>
        _descriptor.IsVersionless
            ? null
            : await _source.GetChangeCeilingAsync(cancellationToken).ConfigureAwait(false);

    async IAsyncEnumerable<IReadOnlyList<EntityBaseCore>> ITrackedSyncTable.FetchPagesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken cancellationToken
    )
    {
        if (_descriptor.IsVersionless)
        {
            var page = await _source.GetFirstPageAsync(batchSize, cancellationToken).ConfigureAwait(false);

            if (page.Rows.Count > 0)
            {
                yield return page.Rows;
            }

            while (page.HasMore && page.Rows.Count > 0)
            {
                var afterKey = _descriptor.ReadKey(page.Rows[^1]);
                page = await _source
                    .GetPageAfterAsync(afterKey, batchSize, cancellationToken)
                    .ConfigureAwait(false);

                if (page.Rows.Count > 0)
                {
                    yield return page.Rows;
                }

                if (
                    page.HasMore
                    && page.Rows.Count > 0
                    && string.Equals(
                        _descriptor.FormatKey(_descriptor.ReadKey(page.Rows[^1])),
                        _descriptor.FormatKey(afterKey),
                        StringComparison.Ordinal
                    )
                )
                {
                    throw new InvalidOperationException(
                        $"The download of '{_descriptor.TableName}' is not making progress: the last key of a batch did "
                            + "not advance past the one the batch was asked for. The server source is not returning rows in "
                            + "ascending primary-key order above the key it was given."
                    );
                }
            }
        }
        else
        {
            var resume = anchor;

            while (true)
            {
                var batch = await _source
                    .GetChangesAsync(resume, ceiling, batchSize, cancellationToken)
                    .ConfigureAwait(false);

                if (batch.Rows.Count > 0)
                {
                    yield return batch.Rows;
                }

                if (!batch.HasMore || batch.Rows.Count == 0)
                {
                    break;
                }

                var next = _descriptor.ReadRowVersion(batch.Rows[^1]);

                if (
                    next is null
                    || next.Length == 0
                    || (resume is not null && next.AsSpan().SequenceEqual(resume))
                )
                {
                    throw new InvalidOperationException(
                        $"The download of '{_descriptor.TableName}' is not making progress: the last row of a batch "
                            + "carries no version, or one that does not advance past the anchor the batch was asked for. The "
                            + "server source is not returning rows in ascending version order above the anchor it was given."
                    );
                }

                resume = next;
            }
        }
    }

    async Task<IReadOnlySet<string>> ITrackedSyncTable.FetchServerKeysAsync(CancellationToken cancellationToken)
    {
        var keys = await _source.GetAllKeysAsync(cancellationToken).ConfigureAwait(false);

        return keys.Select(_descriptor.FormatKey).ToHashSet(StringComparer.Ordinal);
    }

    Task<bool> ITrackedSyncTable.ExistsAsync(
        DbConnection connection,
        object key,
        CancellationToken cancellationToken
    ) => _rows.ExistsAsync<TEntity>(connection, key, cancellationToken);

    Task ITrackedSyncTable.InsertAsync(
        DbConnection connection,
        EntityBaseCore row,
        CancellationToken cancellationToken
    )
    {
        var entity = (TEntity)row;
        _descriptor.FillUnsetUnboundedBinaries(entity);

        return _rows.InsertAsync(connection, entity, cancellationToken);
    }

    Task ITrackedSyncTable.UpdateAsync(
        DbConnection connection,
        EntityBaseCore row,
        CancellationToken cancellationToken
    ) => _rows.UpdateAsync(connection, (TEntity)row, cancellationToken);

    Task<bool> ITrackedSyncTable.DeleteAsync(
        DbConnection connection,
        object key,
        CancellationToken cancellationToken
    ) => _rows.DeleteAsync<TEntity>(connection, key, cancellationToken);

    Task<IReadOnlyList<object>> ITrackedSyncTable.ListKeysAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    ) => _rows.ListKeysAsync<TEntity>(connection, cancellationToken);

    async Task<bool> ITrackedSyncTable.ReadServerBinaryAsync(
        string propertyName,
        object key,
        Stream destination,
        CancellationToken cancellationToken
    ) =>
        _source.BinaryColumns is { } binaries
        && await binaries
            .ReadUnboundedBinaryAsync(propertyName, (TKey)key, destination, cancellationToken)
            .ConfigureAwait(false);

    Task<bool> ITrackedSyncTable.WriteLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    ) => _rows.WriteBinaryAsync<TEntity>(connection, key, propertyName, source, length, cancellationToken);

    Task<bool> ITrackedSyncTable.ReadLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream destination,
        CancellationToken cancellationToken
    ) => _rows.ReadBinaryAsync<TEntity>(connection, key, propertyName, destination, cancellationToken);

    async Task ITrackedSyncTable.WriteServerBinaryAsync(
        string propertyName,
        object key,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    )
    {
        // A server without the binary surface has nothing to write to (its rows carry no excluded columns)
        if (_source.BinaryColumns is { } binaries)
        {
            await binaries
                .WriteUnboundedBinaryAsync(propertyName, (TKey)key, source, length, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    IReadOnlyList<string> ITrackedSyncTable.LocalUnboundedBinaryColumnNames =>
        _descriptor.LocalUnboundedBinaryColumnNames;

    /// <remarks>
    /// A table outside the scope is asked through <see cref="SyncTableDescriptor{TEntity, TKey}.LocalReferences"/>, against
    /// every local key of this table (the refresh may delete any of them). A table the local database does not have is
    /// skipped. A table that refers to this one only through a foreign key those references do not list
    /// (<see cref="SyncTableDescriptor{TEntity, TKey}.UnlistedReferencingTableNames"/>) cannot be asked, so it counts whenever
    /// the local database has it.
    /// </remarks>
    async Task<IReadOnlyList<string>> ITrackedSyncTable.FindReferencesFromOutsideAsync(
        DbConnection connection,
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    )
    {
        var listed = _descriptor
            .LocalReferences.Where(reference => !scopeTableNames.Contains(reference.TableName))
            .ToList();
        var unlisted = _descriptor
            .UnlistedReferencingTableNames.Where(name => !scopeTableNames.Contains(name))
            .ToList();

        if (listed.Count == 0 && unlisted.Count == 0)
        {
            return [];
        }

        var present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using (var command = connection.CreateCommand())
        {
            command.CommandText = "SELECT name FROM sqlite_master WHERE type = 'table'";
            await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                present.Add(reader.GetString(0));
            }
        }

        var referring = unlisted.Where(present.Contains).Distinct(StringComparer.Ordinal).ToList();
        var localKeys =
            "SELECT "
            + TrackedSyncEngine.Identifier(_descriptor.LocalKeyColumnName)
            + " FROM "
            + TrackedSyncEngine.QualifiedName(this);

        foreach (var reference in listed)
        {
            if (
                !present.Contains(reference.TableName)
                || referring.Contains(reference.TableName, StringComparer.Ordinal)
            )
            {
                continue;
            }

            // The reference reads the referring values among a set of keys (its one "IN (@keys)"); here the set is every
            // local key. A reference of any other form is not one the generator writes
            const string KeySet = "IN (@keys)";
            var at = reference.Sql.IndexOf(KeySet, StringComparison.Ordinal);

            if (
                at < 0
                || reference.Sql.IndexOf("@keys", at + KeySet.Length, StringComparison.Ordinal) >= 0
                || reference.Sql.IndexOf("@keys", StringComparison.Ordinal) != at + 4
            )
            {
                throw new InvalidOperationException(
                    $"The local reference from '{reference.TableName}' to '{_descriptor.TableName}' does not read one key set."
                );
            }

            await using var probe = connection.CreateCommand();
            probe.CommandText =
                "SELECT EXISTS ("
                + reference.Sql[..at]
                + "IN ("
                + localKeys
                + ")"
                + reference.Sql[(at + KeySet.Length)..]
                + ")";

            if (
                Convert.ToInt64(
                    await probe.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false),
                    CultureInfo.InvariantCulture
                ) != 0
            )
            {
                referring.Add(reference.TableName);
            }
        }

        return referring;
    }
}

/// <summary>
/// The sync engine over the change tracking of <see cref="SyncLocalTracking"/>: local changes are recorded by triggers in
/// the row state table, and a download brings the server's changes into memory and applies them in one local transaction.
/// </summary>
/// <remarks>
/// <para>
/// A download takes the change ceiling once at the start of the run and shares it among the tables, fetches every table
/// of the run's scope, and then applies everything on a dedicated connection (foreign keys checked off, one
/// <c>BEGIN IMMEDIATE</c> transaction, the applying flag set so that the triggers do not record what it writes). Within
/// that transaction it first removes, in every table, the local rows the server no longer has (delete propagation), then
/// writes the server rows, then checks the foreign keys, and finally saves each table's resume point - all or nothing.
/// When the apply holds rows back, the run takes the ceiling again and fetches and applies once more from the resume
/// points.
/// </para>
/// <para>
/// A sync, a download-only run or a refresh whose fetch brings more than 50,000 rows down while the run's tables hold no
/// unsent change (or more than the download row limit with none; a forced refresh does not count the rows it discards)
/// applies the download a chunk at a time instead: every 10,000 rows of a table are committed in a transaction of their
/// own, so the state in between is visible to other connections (it never leaves a foreign key violation: a row whose
/// parent or unique value is not in place yet is held back and written, with the other rows held back, in one last
/// transaction). Such a run is not all or nothing: one that fails half-way keeps the chunks it committed, and the next
/// run goes on from the resume points, which never pass a row held back (a failed refresh is run again to finish the
/// rebuild; a sync after it goes on downloading from where the refresh stopped, and sends a row it was discarding and had
/// not yet replaced as an ordinary unsent change). Before the first chunk, the run takes the server keys of the tables it
/// has not fetched yet and removes the local rows the server no longer holds, in a transaction of its own: a row the
/// server deletes between those keys and its rows stays on the device until the next run's delete propagation, and so
/// does a parent that still has a local child the server moved elsewhere (the child moves in a later chunk). For a
/// refresh, that transaction also forgets the rows neither side holds, empties every unbounded binary column of the
/// scope's tables when the refresh gives them up, settles the rows it discards that the server no longer holds, and sets
/// every table's resume point back to nothing fetched, from which the chunks move it.
/// </para>
/// <para>
/// The apply never calls the local save hooks. It writes rows through <see cref="ILocalRowStore"/>, which leaves the
/// excluded unbounded binary columns alone on an update; when the run carries those columns, each row the apply wrote
/// owes them, and they are copied down from the server afterwards, each through a temporary file and a short transaction
/// of its own, so no blob is held in memory.
/// </para>
/// <para>
/// A run reads and writes the local database through one dedicated connection (not pooled, foreign keys checked off),
/// opened at the start of the run and closed at its end, whether the run ends normally or by an exception. Between its
/// transactions the run holds no statement and no transaction open on that connection, so it holds no local lock: other
/// connections write freely while the run talks to the server.
/// </para>
/// <para>
/// The change tracking (<see cref="SyncLocalTracking.Ensure"/>) must be in place in the local database before a run.
/// </para>
/// </remarks>
public sealed class TrackedSyncEngine
{
    /// <summary>
    /// The most attempts one apply makes. Every attempt that finds a foreign key violation holds a row back or keeps a
    /// parent, so the attempts are bounded by the rows; this only stops a runaway.
    /// </summary>
    private const int MaxApplyAttempts = 200;

    /// <summary>The savepoint one row write runs inside.</summary>
    private const string WriteSavepoint = "quicker_sync_apply_write";

    /// <summary>The savepoint one rotation (delete and insert again) runs inside.</summary>
    private const string RotateSavepoint = "quicker_sync_apply_rotate";

    /// <summary>The buffer size of the temporary file an owed binary column passes through.</summary>
    private const int TemporaryFileBufferSize = 81920;

    private readonly IReadOnlyList<ITrackedSyncTable> _tables;
    private readonly ILocalRowStore _rows;

    /// <summary>
    /// The number of rows one fetch of a sync or a download-only run may hold before it reads the unsent changes of the
    /// run's tables, and - when there are none - applies the rest of the download a chunk at a time (default 50,000).
    /// </summary>
    internal int ChunkThreshold { get; set; } = 50_000;

    /// <summary>The most rows one chunk of a download applied a chunk at a time holds (default 10,000).</summary>
    internal int ChunkSize { get; set; } = 10_000;

    /// <summary>
    /// Called once for every fetch of a run, as soon as the way it is applied is decided: in one transaction, a chunk at
    /// a time, or refused (null calls nothing).
    /// </summary>
    internal Action<TrackedSyncDownloadRoute>? DownloadRouteObserved { get; set; }

    /// <summary>
    /// Called with the number of carried rows each time a download applied a chunk at a time runs its last apply (the
    /// rows its chunks held back; not called when they held none back). Null calls nothing.
    /// </summary>
    internal Action<int>? CarriedRowsApplied { get; set; }

    /// <summary>Creates the engine over the synchronised tables, ordered parents first.</summary>
    /// <param name="tables">The synchronised tables in foreign-key order; every one shares the same local row store.</param>
    /// <exception cref="ArgumentException">No table is given, or the tables do not share one local row store.</exception>
    internal TrackedSyncEngine(IEnumerable<ITrackedSyncTable> tables)
    {
        ArgumentNullException.ThrowIfNull(tables);
        _tables = tables.ToList();

        if (_tables.Count == 0)
        {
            throw new ArgumentException("The engine needs at least one table.", nameof(tables));
        }

        _rows = _tables[0].Rows;

        if (_tables.Any(table => !ReferenceEquals(table.Rows, _rows)))
        {
            throw new ArgumentException("Every table of one engine shares the same local row store.", nameof(tables));
        }
    }

    /// <summary>Runs one full sync: sends the local changes, then pulls the server's changes down.</summary>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// A run that throws hands the local rows it had changed on its own on in the exception's
    /// <see cref="Exception.Data"/>, under <see cref="SyncEngine.LocalRowChangesDataKey"/>.
    /// </remarks>
    /// <exception cref="SyncDownloadTooLargeException">The fetch went over <see cref="SyncOptions.DownloadRowLimit"/> while the run's tables held unsent changes, including the ones the run discards.</exception>
    public async Task<SyncResult> SyncAsync(
        SyncOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncOptions();
        var scope = ResolveScope(options);
        var changes = new SyncLocalRowChangeLog();

        try
        {
            return await RunExclusiveAsync(
                    async () =>
                    {
                        await RefuseEmptiedTablesAsync(scope, cancellationToken).ConfigureAwait(false);
                        var discards = await ReadCarriedDecisionsAsync(scope, cancellationToken)
                            .ConfigureAwait(false);
                        var conflicts = new List<SyncConflict>();
                        var (uploaded, discarded) = await UploadCoreAsync(
                                scope,
                                options,
                                conflicts,
                                discards,
                                cancellationToken
                            )
                            .ConfigureAwait(false);
                        var download = await DownloadCoreAsync(
                                scope,
                                options,
                                discards,
                                fetch: true,
                                changes,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        return new SyncResult(
                            uploaded,
                            download.Downloaded,
                            download.DeletedLocally,
                            discarded + download.Discarded,
                            conflicts
                        )
                        {
                            Truncations = download.Truncations,
                            LocalRowChanges = changes.ToList(),
                        };
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        catch (Exception failure)
        {
            failure.Data[SyncEngine.LocalRowChangesDataKey] = changes.ToList();
            throw;
        }
    }

    /// <summary>Sends the local changes and returns how many went and how many were dropped.</summary>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="conflicts">The collection the collected conflicts are added to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task<(int Uploaded, int Discarded)> UploadAsync(
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(options);
        ArgumentNullException.ThrowIfNull(conflicts);
        var scope = ResolveScope(options);

        return await RunExclusiveAsync(
                async () =>
                {
                    await RefuseEmptiedTablesAsync(scope, cancellationToken).ConfigureAwait(false);
                    var discards = await ReadCarriedDecisionsAsync(scope, cancellationToken).ConfigureAwait(false);
                    var (uploaded, discarded) = await UploadCoreAsync(
                            scope,
                            options,
                            conflicts,
                            discards,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    // With no download to follow, the rows ServerWins discards are put back here, each read from the server
                    // by key (nothing is fetched and no resume point moves)
                    if (discards.Count == 0)
                    {
                        return (uploaded, discarded);
                    }

                    var settled = await DownloadOnceAsync(
                            scope,
                            options,
                            discards,
                            fetch: false,
                            changes: null,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return (uploaded, discarded + settled.Discarded);
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Pulls the server's changes down and, unless it is turned off, removes the local rows the server dropped.</summary>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <exception cref="SyncDownloadTooLargeException">The fetch went over <see cref="SyncOptions.DownloadRowLimit"/> while the run's tables held unsent changes, including the ones the run discards.</exception>
    public async Task<(int Downloaded, int DeletedLocally)> DownloadAsync(
        SyncOptions options,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(options);
        var scope = ResolveScope(options);

        return await RunExclusiveAsync(
                async () =>
                {
                    await RefuseEmptiedTablesAsync(scope, cancellationToken).ConfigureAwait(false);
                    var discards = await ReadCarriedDecisionsAsync(scope, cancellationToken).ConfigureAwait(false);
                    var download = await DownloadCoreAsync(
                            scope,
                            options,
                            discards,
                            fetch: true,
                            changes: null,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return (download.Downloaded, download.DeletedLocally);
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Rebuilds the tables of the run's scope as a copy of the server's.</summary>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// <para>
    /// The refusals come first, in this order, each before anything is read or written: a batch size or a download row
    /// limit that is not greater than zero, an excluded type the engine does not synchronise, unbounded binary columns
    /// neither carried nor given up (decided from the tables alone, without reading the database), a local row of a table
    /// outside the scope referring to a row of a table inside it, and unsent changes in the scope's tables unless
    /// <see cref="SyncRefreshOptions.Force"/> is set. A table found emptied outside a run is not refused: the refresh is
    /// what rebuilds it.
    /// </para>
    /// <para>
    /// The refresh then fetches every row of the scope's tables below one change ceiling and applies them the way a
    /// download does - one transaction, the same holding back for missing parents and colliding unique values - except
    /// that no row is skipped as an echo, every local row the server does not hold goes, the rows to be discarded (see
    /// <see cref="DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>) are replaced by the
    /// server's rows, and the other unsent changes are discarded when forced. Rows held back are fetched once more from the resume points; when some are still held, the
    /// run throws. A row the server changed after the ceiling is left to the next run. A row being discarded whose server
    /// row cannot be put in place (a local row the refresh does not replace holds its unique value) is left as it is: it
    /// stays unsent with its local content, its unbounded binary columns included, also when the refresh gives those
    /// columns up.
    /// </para>
    /// <para>
    /// A refresh whose fetch goes over 50,000 rows (or over <see cref="SyncRefreshOptions.DownloadRowLimit"/>) while the
    /// scope's tables hold no unsent change other than the rows it discards applies a chunk at a time instead, as a
    /// download does (see the remarks of <see cref="TrackedSyncEngine"/>). It is then not all or nothing: a refresh that
    /// fails keeps what it committed, and is run again to finish the rebuild.
    /// </para>
    /// <para>
    /// The counts are per table: <see cref="SyncRefreshTableResult.Deleted"/> is the local rows removed because the server
    /// does not hold them, and <see cref="SyncRefreshTableResult.Inserted"/> the server rows written locally, inserted or
    /// overwritten. <see cref="SyncRefreshResult.DiscardedChanges"/> is the number of rows whose unsent change was
    /// discarded.
    /// </para>
    /// </remarks>
    /// <exception cref="SyncUnboundedBinaryLossException">A table of the scope has unbounded binary columns and neither <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> nor <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> was set.</exception>
    /// <exception cref="SyncRefreshScopeException">A local row of a table outside the refresh refers to a row of a table it rebuilds.</exception>
    /// <exception cref="SyncPendingChangesException">The scope's tables hold unsent local changes other than rows to be discarded, and <see cref="SyncRefreshOptions.Force"/> was not set.</exception>
    /// <exception cref="SyncDownloadTooLargeException">The fetch went over <see cref="SyncRefreshOptions.DownloadRowLimit"/> while the scope's tables held unsent changes written during the refresh.</exception>
    public async Task<SyncRefreshResult> RefreshAsync(
        SyncRefreshOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncRefreshOptions();

        if (options.BatchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.BatchSize,
                "The refresh batch size must be greater than zero."
            );
        }

        if (options.DownloadRowLimit <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.DownloadRowLimit,
                "The download row limit must be greater than zero."
            );
        }

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);

        if (!options.IncludeUnboundedBinary && !options.DiscardLocalUnboundedBinaries)
        {
            var atStake = scope
                .Where(table => table.UnboundedBinaryColumnNames.Count > 0)
                .Select(table => new SyncUnboundedBinaryColumns(table.TableName, table.UnboundedBinaryColumnNames))
                .ToList();

            if (atStake.Count > 0)
            {
                throw new SyncUnboundedBinaryLossException(atStake);
            }
        }

        var startedAt = Stopwatch.GetTimestamp();

        return await RunExclusiveAsync(
                () => RefreshCoreAsync(options, scope, startedAt, cancellationToken),
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Lists the unsent local changes of the engine's tables, in the order of the changes.</summary>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// Only rows of the tables the engine was put together with are listed. The list does not wait for a run on the same
    /// local database to end; a list read while a run is going on shows the state committed up to that point.
    /// </remarks>
    public async Task<IReadOnlyList<SyncPendingRow>> GetPendingChangesAsync(CancellationToken cancellationToken = default)
    {
        var byName = _tables.ToDictionary(table => table.TableName, StringComparer.Ordinal);
        await using var connection = await OpenDedicatedAsync(cancellationToken).ConfigureAwait(false);
        var listed = new List<SyncPendingRow>();

        foreach (var row in await TrackedSyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
        {
            if (!byName.TryGetValue(row.TableName, out var table))
            {
                continue;
            }

            listed.Add(
                new SyncPendingRow(
                    row.TableName,
                    table.KeyText(table.KeyOfRaw(row.RawKey)),
                    row.Deleted,
                    row.Known,
                    row.ServerWinsSequence == row.ChangeSequence,
                    row.ChangeSequence
                )
            );
        }

        return listed;
    }

    /// <summary>
    /// Discards the unsent changes of the rows given, each only while it is still unsent and its change number is still the
    /// one listed.
    /// </summary>
    /// <param name="rows">Rows listed by <see cref="GetPendingChangesAsync"/>.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many of the rows given are to be discarded after the call, counting the ones already marked.</returns>
    /// <remarks>
    /// <para>
    /// A discarded row stays unsent until a run carries the discard out: the next run whose scope covers its table
    /// (<see cref="SyncAsync"/>, <see cref="UploadAsync"/> or <see cref="DownloadAsync"/>), whatever its conflict policy,
    /// does not send the row and puts the server's row back over it, reading it from the server by key when the download
    /// does not bring it; a row the server does not hold goes from the device. A run that leaves the table out of its
    /// scope leaves the row as it is, still to be discarded.
    /// </para>
    /// <para>
    /// Writing the row again after the discard moves its change number on: the discard no longer applies, and what was
    /// written is sent. A row written again after it was listed is not discarded. A refresh
    /// (<see cref="RefreshAsync"/>) does not count a row to be discarded as an unsent change: forced or not, it replaces
    /// the row with the server's row (a row the server does not hold goes from the device). A row written again after the
    /// discard counts as unsent for the refresh as well.
    /// </para>
    /// <para>The call waits for a run on the same local database in this process to end, as the runs wait for each other.</para>
    /// </remarks>
    /// <exception cref="ArgumentNullException"><paramref name="rows"/> is null.</exception>
    /// <exception cref="ArgumentException">A row belongs to a table the engine does not synchronise; nothing is changed.</exception>
    public Task<int> DiscardPendingChangesAsync(
        IEnumerable<SyncPendingRow> rows,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(rows);
        var given = rows.ToList();
        var known = _tables.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        var unknown = given
            .Select(row => row.TableName)
            .Where(name => !known.Contains(name))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        if (unknown.Count > 0)
        {
            throw new ArgumentException(
                "The engine does not synchronise the table "
                    + string.Join(", ", unknown)
                    + "; discard only rows of the tables it synchronises.",
                nameof(rows)
            );
        }

        var wanted = given
            .GroupBy(row => (row.TableName, row.KeyText))
            .ToDictionary(group => group.Key, group => group.Select(row => row.ChangeNumber).ToHashSet());

        return MarkDiscardedAsync(
            (table, keyText, row) =>
                wanted.TryGetValue((table.TableName, keyText), out var numbers) && numbers.Contains(row.ChangeSequence),
            cancellationToken
        );
    }

    /// <summary>Discards every unsent change of the table of one entity type.</summary>
    /// <param name="entityType">The entity type of one of the engine's tables.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many rows are marked to be discarded.</returns>
    /// <remarks>
    /// The rows are discarded at the change numbers they have when the call runs, and the discard is carried out by later
    /// runs as with <see cref="DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>.
    /// </remarks>
    /// <exception cref="ArgumentNullException"><paramref name="entityType"/> is null.</exception>
    /// <exception cref="ArgumentException"><paramref name="entityType"/> is not a type the engine synchronises.</exception>
    public Task<int> DiscardPendingChangesAsync(Type entityType, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entityType);

        if (_tables.FirstOrDefault(candidate => candidate.EntityType == entityType) is not { } target)
        {
            throw new ArgumentException(
                "The engine does not synchronise "
                    + entityType.Name
                    + "; discard only the changes of the types it synchronises.",
                nameof(entityType)
            );
        }

        return MarkDiscardedAsync((table, _, _) => ReferenceEquals(table, target), cancellationToken);
    }

    /// <summary>Discards every unsent change of the engine's tables.</summary>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many rows are marked to be discarded.</returns>
    /// <remarks>
    /// The rows are discarded at the change numbers they have when the call runs, and the discard is carried out by later
    /// runs as with <see cref="DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>.
    /// </remarks>
    public Task<int> DiscardAllPendingChangesAsync(CancellationToken cancellationToken = default) =>
        MarkDiscardedAsync((_, _, _) => true, cancellationToken);

    /// <summary>
    /// Marks the unsent rows of the engine's tables the filter takes to be discarded at their current change numbers, read
    /// in the same write transaction, under the run lock.
    /// </summary>
    /// <param name="take">Whether to mark a row, given its table, its key text and its state.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many rows were marked.</returns>
    private Task<int> MarkDiscardedAsync(
        Func<ITrackedSyncTable, string, TrackedSyncPendingRow, bool> take,
        CancellationToken cancellationToken
    )
    {
        var byName = _tables.ToDictionary(table => table.TableName, StringComparer.Ordinal);

        return RunExclusiveAsync(
            async () =>
            {
                var connection = RunConnection;
                await TrackedSyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);

                try
                {
                    var marked = 0;

                    foreach (
                        var row in await TrackedSyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false)
                    )
                    {
                        if (
                            !byName.TryGetValue(row.TableName, out var table)
                            || !take(table, table.KeyText(table.KeyOfRaw(row.RawKey)), row)
                        )
                        {
                            continue;
                        }

                        // Read in this transaction, so the change number marked is the one the filter saw
                        await TrackedSyncState
                            .MarkServerWinsAsync(connection, row.TableName, row.RawKey, cancellationToken)
                            .ConfigureAwait(false);
                        marked++;
                    }

                    await TrackedSyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);

                    return marked;
                }
                catch
                {
                    try
                    {
                        await TrackedSyncState
                            .ExecuteAsync(connection, "ROLLBACK", CancellationToken.None)
                            .ConfigureAwait(false);
                    }
                    catch (DbException)
                    {
                        // The rollback failing must not hide what went wrong first
                    }

                    throw;
                }
            },
            cancellationToken
        );
    }

    /// <summary>The body of <see cref="RefreshAsync"/>, run under the run lock once the arguments have been checked.</summary>
    private async Task<SyncRefreshResult> RefreshCoreAsync(
        SyncRefreshOptions options,
        List<ITrackedSyncTable> scope,
        long startedAt,
        CancellationToken cancellationToken
    )
    {
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        var blocking = new List<SyncRefreshScopeReference>();
        IReadOnlyList<TrackedSyncPendingRow> pending;

        {
            var connection = RunConnection;

            foreach (var table in scope)
            {
                foreach (
                    var referring in await table
                        .FindReferencesFromOutsideAsync(connection, scopeTableNames, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    blocking.Add(new SyncRefreshScopeReference(referring, table.TableName));
                }
            }

            if (blocking.Count > 0)
            {
                throw new SyncRefreshScopeException(blocking);
            }

            pending = (await TrackedSyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
                .Where(row => scopeTableNames.Contains(row.TableName))
                .ToList();
        }

        // A row marked to be discarded at its current change number is given up already: it does not stand in the way of
        // the refresh, forced or not. A row written again after it was marked has moved on and counts as unsent
        var unsent = pending.Where(row => row.ServerWinsSequence != row.ChangeSequence).ToList();

        if (unsent.Count > 0 && !options.Force)
        {
            throw new SyncPendingChangesException(
                unsent
                    .GroupBy(row => row.TableName, StringComparer.Ordinal)
                    .Select(group => new SyncPendingChange(group.Key, group.Count()))
                    .ToList()
            );
        }

        if (scope.Count == 0)
        {
            return new SyncRefreshResult([], pending.Count, Stopwatch.GetElapsedTime(startedAt));
        }

        // Every unsent row left here is discarded (the rows marked to be discarded and, when forced, the rest), taking
        // the server's row when the fetch brings it
        var discards = new Dictionary<(string Table, string Key), TrackedSyncDiscard>();

        foreach (var row in pending)
        {
            var table = scope.First(candidate => candidate.TableName == row.TableName);
            var key = table.KeyOfRaw(row.RawKey);
            discards[(table.TableName, table.KeyText(key))] = new TrackedSyncDiscard(key, row.ChangeSequence);
        }

        var syncOptions = new SyncOptions
        {
            Mode = options.Mode,
            DownloadBatchSize = options.BatchSize,
            DownloadRowLimit = options.DownloadRowLimit,
            PropagateDeletes = true,
            IncludeUnboundedBinary = options.IncludeUnboundedBinary,
        };
        var refresh = new TrackedSyncRefresh(BlankBinaries: !options.IncludeUnboundedBinary);
        var first = await DownloadOnceAsync(
                scope,
                syncOptions,
                discards,
                true,
                null,
                cancellationToken,
                refresh,
                chunkable: true
            )
            .ConfigureAwait(false);
        var outcome = first;

        if (first.Truncations.Count > 0)
        {
            // The rows held back are fetched once more from the resume points the refresh left
            var second = await DownloadOnceAsync(
                    scope,
                    syncOptions,
                    [],
                    true,
                    null,
                    cancellationToken,
                    chunkable: true
                )
                .ConfigureAwait(false);
            outcome = new TrackedSyncDownload(
                first.Downloaded + second.Downloaded,
                first.DeletedLocally + second.DeletedLocally,
                second.Truncations
            )
            {
                PerTable = scope.ToDictionary(
                    table => table.TableName,
                    table =>
                    {
                        var a = first.PerTable.GetValueOrDefault(table.TableName);
                        var b = second.PerTable.GetValueOrDefault(table.TableName);

                        return (a.Deleted + b.Deleted, a.Written + b.Written);
                    },
                    StringComparer.Ordinal
                ),
            };
        }

        if (outcome.Truncations.Count > 0)
        {
            throw new InvalidOperationException(
                "The refresh could not replace every row; these are held back: "
                    + string.Join(
                        ", ",
                        outcome.Truncations.Select(truncation => truncation.TableName + "/" + truncation.PendingKeyText)
                    )
            );
        }

        return new SyncRefreshResult(
            scope
                .Select(table =>
                {
                    var counts = outcome.PerTable.GetValueOrDefault(table.TableName);

                    return new SyncRefreshTableResult(table.TableName, counts.Deleted, counts.Written);
                })
                .ToList(),
            pending.Count,
            Stopwatch.GetElapsedTime(startedAt)
        );
    }

    /// <summary>The tables a run covers, after checking the run's arguments.</summary>
    /// <param name="options">The knobs for the run.</param>
    /// <exception cref="ArgumentOutOfRangeException">The download batch size is not greater than zero.</exception>
    /// <exception cref="ArgumentException">An excluded type is not one the engine synchronises.</exception>
    private List<ITrackedSyncTable> ResolveScope(SyncOptions options)
    {
        if (options.DownloadBatchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.DownloadBatchSize,
                "The download batch size must be greater than zero."
            );
        }

        if (options.DownloadRowLimit <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.DownloadRowLimit,
                "The download row limit must be greater than zero."
            );
        }

        return ResolveScope(options.Mode, options.ExcludedEntityTypes);
    }

    /// <summary>The tables a mode and a set of excluded types cover.</summary>
    /// <param name="mode">The run's mode (<see cref="SyncMode.Versioned"/> leaves the tables without a version column out).</param>
    /// <param name="excludedEntityTypes">The entity types the run leaves out.</param>
    /// <exception cref="ArgumentException">An excluded type is not one the engine synchronises.</exception>
    private List<ITrackedSyncTable> ResolveScope(SyncMode mode, IReadOnlyCollection<Type> excludedEntityTypes)
    {
        var known = _tables.Select(table => table.EntityType).ToHashSet();
        var unknown = excludedEntityTypes.Where(type => !known.Contains(type)).ToList();

        if (unknown.Count > 0)
        {
            throw new ArgumentException(
                "The engine does not synchronise "
                    + string.Join(", ", unknown.Select(type => type.Name))
                    + "; exclude only the types it synchronises.",
                "options"
            );
        }

        var excluded = excludedEntityTypes.ToHashSet();

        return _tables
            .Where(table => !(mode == SyncMode.Versioned && table.IsVersionless))
            .Where(table => !excluded.Contains(table.EntityType))
            .ToList();
    }

    /// <summary>The locks that keep the runs on one local database in this process one at a time, by database file.</summary>
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, SemaphoreSlim> RunLocks =
        new(StringComparer.Ordinal);

    /// <summary>The lock of this engine's runs when the database has no file name to share a lock by (an in-memory database).</summary>
    private readonly SemaphoreSlim _ownRunLock = new(1, 1);

    /// <summary>
    /// The run's dedicated connection, set while a run holds the run lock and null outside a run (see
    /// <see cref="RunConnection"/>).
    /// </summary>
    private DbConnection? _runConnection;

    /// <summary>
    /// Runs the body while no other run on the same local database (the same <see cref="DbConnection.DataSource"/> once
    /// open) in this process is running: a run waits for the one before it to end.
    /// </summary>
    /// <remarks>
    /// The run's dedicated connection is opened first (its data source names the run lock), handed to the body through
    /// <see cref="RunConnection"/> once the lock is taken, and closed when the body ends - normally, by an exception or by
    /// cancellation, also while the lock is still being waited for - before the lock is released.
    /// </remarks>
    private async Task<T> RunExclusiveAsync<T>(Func<Task<T>> body, CancellationToken cancellationToken)
    {
        var connection = await OpenDedicatedAsync(cancellationToken).ConfigureAwait(false);
        SemaphoreSlim? held = null;

        try
        {
            var dataSource = connection.DataSource;
            var runLock = string.IsNullOrEmpty(dataSource)
                ? _ownRunLock
                : RunLocks.GetOrAdd(dataSource, static _ => new SemaphoreSlim(1, 1));
            await runLock.WaitAsync(cancellationToken).ConfigureAwait(false);
            held = runLock;
            _runConnection = connection;

            return await body().ConfigureAwait(false);
        }
        finally
        {
            if (held is not null)
            {
                _runConnection = null;
            }

            // Closed before the lock is released: the next run on the database starts with no connection of this run open
            await connection.DisposeAsync().ConfigureAwait(false);
            held?.Release();
        }
    }

    /// <summary>
    /// The run's dedicated connection: one connection from <see cref="ILocalRowStore.CreateDedicatedConnection"/>, open
    /// with foreign keys checked off from the start of the run to its end, that every read and write of the run's body uses.
    /// </summary>
    /// <exception cref="InvalidOperationException">Asked for outside a run (an internal error).</exception>
    private DbConnection RunConnection =>
        _runConnection
        ?? throw new InvalidOperationException(
            "The run's dedicated connection was asked for outside a run; only the body of a run, under the run lock, uses it."
        );

    /// <summary>
    /// Refuses the run when a table of its scope is empty locally while the row state table holds rows of it the server knows
    /// and that have nothing to send: the table appears to have been made again empty, and a run would send nothing for its
    /// missing rows and download only what changed since its resume point.
    /// </summary>
    /// <exception cref="SyncLocalTableEmptiedException">A table of the run's scope appears to have been made again empty.</exception>
    private async Task RefuseEmptiedTablesAsync(List<ITrackedSyncTable> scope, CancellationToken cancellationToken)
    {
        var emptied = new List<string>();

        {
            var connection = RunConnection;

            foreach (var table in scope)
            {
                if (
                    await TrackedSyncState
                        .IsEmptiedAsync(connection, table.TableName, QualifiedName(table), cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    emptied.Add(table.TableName);
                }
            }
        }

        if (emptied.Count > 0)
        {
            throw new SyncLocalTableEmptiedException(emptied);
        }
    }

    /// <summary>
    /// Reads the <see cref="SyncConflictPolicy.ServerWins"/> decisions earlier runs could not carry out (rows still marked
    /// at their current change number): whatever this run's policy, such a row is not sent, and the server's content is put
    /// back over it.
    /// </summary>
    private async Task<Dictionary<(string Table, string Key), TrackedSyncDiscard>> ReadCarriedDecisionsAsync(
        List<ITrackedSyncTable> scope,
        CancellationToken cancellationToken
    )
    {
        var byName = scope.ToDictionary(table => table.TableName, StringComparer.Ordinal);
        var discards = new Dictionary<(string Table, string Key), TrackedSyncDiscard>();

        var connection = RunConnection;

        foreach (var row in await TrackedSyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
        {
            if (row.ServerWinsSequence != row.ChangeSequence || !byName.TryGetValue(row.TableName, out var table))
            {
                continue;
            }

            var key = table.KeyOfRaw(row.RawKey);
            discards[(table.TableName, table.KeyText(key))] = new TrackedSyncDiscard(key, row.ChangeSequence);
        }

        return discards;
    }

    /// <summary>
    /// Sends the unsent changes of the run's tables, in rounds: the inserts and updates parents first, then the deletes
    /// children first; a write the server refused goes into the next round as long as the round got anything through.
    /// </summary>
    /// <remarks>
    /// A <see cref="SyncMode.Versioned"/> run under <see cref="SyncConflictPolicy.ServerWins"/> sends nothing and discards
    /// every unsent change of its tables. A <see cref="SyncMode.LastWriteWins"/> run (and every table without a version
    /// column) overwrites without a version check; <see cref="SyncConflictPolicy.LocalWins"/> settles a version conflict by
    /// overwriting. A failed write is explained by the server's state (a missing parent, a row still referring to the deleted
    /// one, another row holding a unique value); a failure nothing explains is thrown back unchanged. The rows a
    /// last-write-wins run under <see cref="SyncConflictPolicy.ServerWins"/> sees refused are discarded instead of reported.
    /// </remarks>
    /// <returns>How many changes reached the server, and how many were dropped with nothing to send.</returns>
    private async Task<(int Uploaded, int Discarded)> UploadCoreAsync(
        List<ITrackedSyncTable> scope,
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        Dictionary<(string Table, string Key), TrackedSyncDiscard> discards,
        CancellationToken cancellationToken
    )
    {
        var byName = scope.ToDictionary(table => table.TableName, StringComparer.Ordinal);
        List<TrackedSyncQueued> queue;

        {
            var connection = RunConnection;
            queue = [];

            foreach (
                var row in await TrackedSyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false)
            )
            {
                if (!byName.TryGetValue(row.TableName, out var table))
                {
                    continue;
                }

                var key = table.KeyOfRaw(row.RawKey);
                var keyText = table.KeyText(key);

                // A row a carried decision is discarding is not sent
                if (!discards.ContainsKey((table.TableName, keyText)))
                {
                    queue.Add(new TrackedSyncQueued(table, row, key, keyText));
                }
            }
        }

        if (options is { Mode: SyncMode.Versioned, ConflictPolicy: SyncConflictPolicy.ServerWins })
        {
            foreach (var queued in queue)
            {
                discards[(queued.Table.TableName, queued.KeyText)] = new TrackedSyncDiscard(
                    queued.Key,
                    queued.Row.ChangeSequence
                );
            }

            return (0, 0);
        }

        var lastWriteWins = options.Mode == SyncMode.LastWriteWins;
        var uploaded = 0;
        var discarded = 0;
        var refused = new List<(TrackedSyncQueued Queued, EntityBaseCore? Local, SyncConflictReason Reason)>();

        while (queue.Count > 0)
        {
            refused.Clear();
            var progress = false;
            var withLocal = new List<(TrackedSyncQueued Queued, EntityBaseCore? Local)>(queue.Count);

            {
                var connection = RunConnection;

                foreach (var queued in queue)
                {
                    withLocal.Add(
                        (
                            queued,
                            await queued.Table.FindAsync(connection, queued.Key, cancellationToken).ConfigureAwait(false)
                        )
                    );
                }
            }

            var order = withLocal
                .Where(item => item.Local is not null)
                .OrderBy(item => IndexOf(item.Queued.Table))
                .ThenBy(item => item.Queued.Row.ChangeSequence)
                .Concat(
                    withLocal
                        .Where(item => item.Local is null)
                        .OrderByDescending(item => IndexOf(item.Queued.Table))
                        .ThenBy(item => item.Queued.Row.ChangeSequence)
                )
                .ToList();

            foreach (var (queued, local) in order)
            {
                var force = lastWriteWins || queued.Table.IsVersionless;
                var result = await queued
                    .Table.SendAsync(queued.Row, queued.Key, local, force, cancellationToken)
                    .ConfigureAwait(false);

                // LocalWins settles a version conflict by overwriting (a write the server refused is not settled this way)
                if (
                    result.Kind == TrackedSyncSendKind.Conflict
                    && options.ConflictPolicy == SyncConflictPolicy.LocalWins
                )
                {
                    result = await queued
                        .Table.SendAsync(
                            queued.Row,
                            queued.Key,
                            local,
                            force: true,
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }

                switch (result.Kind)
                {
                    case TrackedSyncSendKind.Discarded:
                        {
                            var connection = RunConnection;
                            await TrackedSyncState
                                .ForgetPendingAsync(
                                    connection,
                                    queued.Table.TableName,
                                    queued.Row.RawKey,
                                    queued.Row.ChangeSequence,
                                    cancellationToken
                                )
                                .ConfigureAwait(false);
                        }

                        discarded++;
                        break;

                    case TrackedSyncSendKind.Sent:
                        await SettleSentAsync(queued, result, options.IncludeUnboundedBinary, cancellationToken)
                            .ConfigureAwait(false);
                        uploaded++;
                        progress = true;
                        break;

                    case TrackedSyncSendKind.Conflict:
                        conflicts.Add(
                            new SyncConflict(
                                queued.Table.TableName,
                                queued.KeyText,
                                local is null ? SyncJournalOperation.Delete : SyncJournalOperation.Upsert,
                                result.Reason,
                                result.Local,
                                result.Server
                            )
                        );
                        break;

                    default:
                        SyncConflictReason? reason;

                        try
                        {
                            reason = await ExplainRefusalAsync(queued, local, cancellationToken).ConfigureAwait(false);
                        }
                        catch (Exception lookup) when (lookup is not OperationCanceledException)
                        {
                            throw new AggregateException(result.Error!, lookup);
                        }

                        if (reason is null)
                        {
                            // A failure none of the three reasons explains (a dropped connection, say) is thrown back as it was
                            System.Runtime.ExceptionServices.ExceptionDispatchInfo.Throw(result.Error!);
                        }

                        refused.Add((queued, local, reason.Value));
                        break;
                }
            }

            if (refused.Count == 0 || !progress)
            {
                break;
            }

            queue = [.. refused.Select(item => item.Queued)];
        }

        foreach (var (queued, local, reason) in refused)
        {
            // A last-write-wins run under ServerWins gives up the change the server refused and puts the server's row back
            if (lastWriteWins && options.ConflictPolicy == SyncConflictPolicy.ServerWins)
            {
                discards[(queued.Table.TableName, queued.KeyText)] = new TrackedSyncDiscard(
                    queued.Key,
                    queued.Row.ChangeSequence
                );
                continue;
            }

            conflicts.Add(
                new SyncConflict(
                    queued.Table.TableName,
                    queued.KeyText,
                    local is null ? SyncJournalOperation.Delete : SyncJournalOperation.Upsert,
                    reason,
                    local,
                    await queued.Table.ReadServerAsync(queued.Key, cancellationToken).ConfigureAwait(false)
                )
            );
        }

        return (uploaded, discarded);
    }

    /// <summary>
    /// Records a write that reached the server and sends its unbounded binary columns. When there are columns to send, the
    /// version the row write earned is recorded first (with every column kept as written for a row the server took as an
    /// insert), so that a failure while the columns go leaves the next run guarding against this device's own write; the
    /// columns are then copied up one by one through a temporary file, and the version is read back from the server, since
    /// writing a column moves it on. Last, in one short local transaction: the version becomes the row's base version and,
    /// while the row's change number is still the one read, the version the local row carries (its content stays as sent and
    /// the change is not recorded), and the row loses its unsent change only while its change number is still the one read.
    /// An overwrite without a version check leaves the server's other unbounded binary columns as they were, so the row owes
    /// them from the server.
    /// </summary>
    /// <remarks>
    /// The columns sent are every one for a row the server took as an insert (it gets its blobs from this device or not at
    /// all), otherwise the ones the device wrote; none at all for a run that does not carry them, whose settlement then
    /// drops the columns written along with the rest of the change.
    /// </remarks>
    private async Task SettleSentAsync(
        TrackedSyncQueued queued,
        TrackedSyncSend result,
        bool includeBinaries,
        CancellationToken cancellationToken
    )
    {
        var table = queued.Table;

        if (result.Deleted)
        {
            var deleteConnection = RunConnection;
            await TrackedSyncState
                .SettleDeletedAsync(
                    deleteConnection,
                    table.TableName,
                    queued.Row.RawKey,
                    queued.Row.ChangeSequence,
                    cancellationToken
                )
                .ConfigureAwait(false);
            return;
        }

        // The version the writer stamped on the row it accepted; read back from the server only when the writer left none
        // (a version read back can already be another writer's, written after this one)
        var version =
            table.IsVersionless ? null
            : result.Version is { } stamped ? stamped
            : await ReadBackVersionAsync(queued, cancellationToken).ConfigureAwait(false);

        List<string> columns =
            !includeBinaries || table.UnboundedBinaryColumnNames.Count == 0 ? []
            : result.Inserted ? table.UnboundedBinaryColumnNames.ToList()
            : SplitColumns(queued.Row.BlobColumns)
                .Where(column => table.UnboundedBinaryColumnNames.Contains(column, StringComparer.Ordinal))
                .ToList();

        // An overwrite without a version check does not touch the server's columns this run does not send
        List<string> owedByOverwrite =
            result.Forced && !result.Inserted
                ? table.UnboundedBinaryColumnNames.Except(columns, StringComparer.Ordinal).ToList()
                : [];

        if (columns.Count > 0)
        {
            {
                var interim = RunConnection;
                await TrackedSyncState
                    .RecordInterimAsync(
                        interim,
                        table.TableName,
                        queued.Row.RawKey,
                        version,
                        result.Inserted ? table.UnboundedBinaryColumnNames : [],
                        owedByOverwrite,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            owedByOverwrite = [];

            foreach (var column in columns)
            {
                await SendBinaryAsync(table, queued.Key, column, cancellationToken).ConfigureAwait(false);
            }

            if (!table.IsVersionless)
            {
                version = await ReadBackVersionAsync(queued, cancellationToken).ConfigureAwait(false);
            }
        }

        var connection = RunConnection;
        await TrackedSyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);

        try
        {
            if (owedByOverwrite.Count > 0)
            {
                await TrackedSyncState
                    .AddOwedAsync(connection, table.TableName, queued.Row.RawKey, owedByOverwrite, cancellationToken)
                    .ConfigureAwait(false);
            }

            // The local row takes the version the server gave it, its content left as sent - only while its change number
            // is still the one read: a row edited since keeps what the device wrote
            if (version is not null)
            {
                var current = await TrackedSyncState
                    .ReadRowAsync(connection, table.TableName, queued.Row.RawKey, cancellationToken)
                    .ConfigureAwait(false);

                if (
                    current?.ChangeSequence == queued.Row.ChangeSequence
                    && await table.FindAsync(connection, queued.Key, cancellationToken).ConfigureAwait(false) is { } local
                )
                {
                    await TrackedSyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false);
                    table.SetVersion(local, version);
                    await table.UpdateAsync(connection, local, cancellationToken).ConfigureAwait(false);
                    await TrackedSyncState.SetApplyingAsync(connection, false, cancellationToken).ConfigureAwait(false);
                }
            }

            await TrackedSyncState
                .SettleSentAsync(
                    connection,
                    table.TableName,
                    queued.Row.RawKey,
                    version,
                    queued.Row.ChangeSequence,
                    cancellationToken
                )
                .ConfigureAwait(false);
            await TrackedSyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);
        }
        catch
        {
            try
            {
                await TrackedSyncState.ExecuteAsync(connection, "ROLLBACK", CancellationToken.None).ConfigureAwait(false);
            }
            catch (DbException)
            {
                // The rollback failing must not hide what went wrong first
            }

            throw;
        }
    }

    /// <summary>Reads the version the server holds for a row this run has just written.</summary>
    private static async Task<byte[]?> ReadBackVersionAsync(TrackedSyncQueued queued, CancellationToken cancellationToken) =>
        queued.Table.VersionOf(
            await queued.Table.ReadServerAsync(queued.Key, cancellationToken).ConfigureAwait(false)
                ?? throw new InvalidOperationException(
                    $"The row of '{queued.Table.TableName}' with the key '{queued.KeyText}' was written to the server but cannot be read back."
                )
        );

    /// <summary>
    /// Copies one unbounded binary column of a local row up to the server through a temporary file: the local column is read
    /// and the read is closed before the server write, so with no statement and no transaction open on the run's connection
    /// no local lock is held while the bytes travel. A column
    /// NULL locally sets the server's column to NULL, so the two sides end up alike. A row gone locally since it was read
    /// sends nothing: its delete is a later change, which keeps the row unsent and goes next.
    /// </summary>
    private async Task SendBinaryAsync(
        ITrackedSyncTable table,
        object key,
        string column,
        CancellationToken cancellationToken
    )
    {
        await using var file = CreateTemporaryFile();
        bool present;

        {
            var connection = RunConnection;
            present = await table
                .ReadLocalBinaryAsync(connection, key, column, file, cancellationToken)
                .ConfigureAwait(false);

            if (!present && !await table.ExistsAsync(connection, key, cancellationToken).ConfigureAwait(false))
            {
                return;
            }
        }

        if (!present)
        {
            await table.WriteServerBinaryAsync(column, key, null, null, cancellationToken).ConfigureAwait(false);
            return;
        }

        file.Position = 0;
        await table.WriteServerBinaryAsync(column, key, file, file.Length, cancellationToken).ConfigureAwait(false);
    }

    /// <summary>A temporary file that goes when it is closed (where unbounded binary columns pass between the two sides).</summary>
    private static FileStream CreateTemporaryFile() =>
        new(
            Path.Combine(Path.GetTempPath(), "quicker-sync-" + Guid.NewGuid().ToString("N") + ".tmp"),
            FileMode.CreateNew,
            FileAccess.ReadWrite,
            FileShare.None,
            TemporaryFileBufferSize,
            FileOptions.DeleteOnClose | FileOptions.Asynchronous
        );

    /// <summary>
    /// Why the server refused a write, by its state: a parent the row points at is gone (an insert or update), a row of a
    /// synchronised table still refers to it (a delete of a row the server still holds), or another row holds one of its
    /// unique values; null when none of these holds.
    /// </summary>
    private async Task<SyncConflictReason?> ExplainRefusalAsync(
        TrackedSyncQueued queued,
        EntityBaseCore? local,
        CancellationToken cancellationToken
    )
    {
        if (local is not null)
        {
            foreach (var (parentTableName, parentKeyText) in queued.Table.ParentsOf(local))
            {
                if (
                    parentKeyText is not null
                    && TableNamedInEngine(parentTableName) is { } parent
                    && !await parent.ServerHasAsync(parentKeyText, cancellationToken).ConfigureAwait(false)
                )
                {
                    return SyncConflictReason.ParentMissingOnServer;
                }
            }

            return await queued.Table.CollidesOnServerAsync(local, cancellationToken).ConfigureAwait(false)
                ? SyncConflictReason.UniqueValueTakenOnServer
                : null;
        }

        if (await queued.Table.ReadServerAsync(queued.Key, cancellationToken).ConfigureAwait(false) is null)
        {
            return null;
        }

        foreach (var table in _tables)
        {
            if (
                await table
                    .ServerReferencesAsync(queued.Table.TableName, queued.KeyText, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                return SyncConflictReason.DeleteRefusedOnServer;
            }
        }

        return null;
    }

    /// <summary>The position of a table in foreign-key order.</summary>
    private int IndexOf(ITrackedSyncTable table)
    {
        for (var index = 0; index < _tables.Count; index++)
        {
            if (ReferenceEquals(_tables[index], table))
            {
                return index;
            }
        }

        throw new ArgumentOutOfRangeException(nameof(table));
    }

    /// <summary>The table of the engine with the table name (null when none has).</summary>
    private ITrackedSyncTable? TableNamedInEngine(string tableName) =>
        _tables.FirstOrDefault(table => string.Equals(table.TableName, tableName, StringComparison.Ordinal));

    /// <summary>
    /// Fetches and applies the server's changes, and - when the apply held rows back - takes the ceiling again and
    /// fetches and applies once more from the resume points.
    /// </summary>
    private async Task<TrackedSyncDownload> DownloadCoreAsync(
        List<ITrackedSyncTable> scope,
        SyncOptions options,
        Dictionary<(string Table, string Key), TrackedSyncDiscard> discards,
        bool fetch,
        SyncLocalRowChangeLog? changes,
        CancellationToken cancellationToken
    )
    {
        var first = await DownloadOnceAsync(
                scope,
                options,
                discards,
                fetch,
                changes,
                cancellationToken,
                chunkable: true
            )
            .ConfigureAwait(false);

        if (first.Truncations.Count == 0)
        {
            return first;
        }

        // The second pass does not discard again: the rows the first pass could not put back are marked and carried
        var second = await DownloadOnceAsync(scope, options, [], fetch, changes, cancellationToken, chunkable: true)
            .ConfigureAwait(false);

        return new TrackedSyncDownload(
            first.Downloaded + second.Downloaded,
            first.DeletedLocally + second.DeletedLocally,
            second.Truncations
        )
        {
            Discarded = first.Discarded + second.Discarded,
        };
    }

    /// <summary>
    /// One fetch and one apply of every table of the run (the owed binary columns are copied before and after). Without a
    /// fetch, only the rows being discarded are put back, each read from the server by key. A refresh fetches every row
    /// from the start and reads no row by key: a row being discarded that the fetch did not bring only loses its change.
    /// </summary>
    /// <remarks>
    /// When <paramref name="chunkable"/> is set and the rows fetched go over <see cref="ChunkThreshold"/> while the run's
    /// tables hold no unsent change (or over the download row limit with none), the rest of the download is applied a
    /// chunk at a time instead (<see cref="ChunkedDownload"/>).
    /// </remarks>
    private async Task<TrackedSyncDownload> DownloadOnceAsync(
        List<ITrackedSyncTable> scope,
        SyncOptions options,
        Dictionary<(string Table, string Key), TrackedSyncDiscard> discards,
        bool fetch,
        SyncLocalRowChangeLog? changes,
        CancellationToken cancellationToken,
        TrackedSyncRefresh? refresh = null,
        bool chunkable = false
    )
    {
        if (fetch && options.IncludeUnboundedBinary)
        {
            await CopyOwedBinariesAsync(scope, cancellationToken).ConfigureAwait(false);
        }

        Dictionary<string, byte[]?> anchors;

        {
            var connection = RunConnection;
            anchors = await TrackedSyncState.ReadAnchorsAsync(connection, cancellationToken).ConfigureAwait(false);
        }

        // The ceiling is taken once and shared by every table: a ceiling per table would leave a parent written after an
        // earlier table's ceiling out while its child, under a later table's ceiling, comes down
        var versioned = scope.FirstOrDefault(table => !table.IsVersionless);
        var ceiling =
            !fetch || versioned is null
                ? null
                : await versioned.GetCeilingAsync(cancellationToken).ConfigureAwait(false);
        var plans = new List<TrackedSyncPlan>(scope.Count);

        // The rows fetched are counted across the tables; the first time the count goes over the limit the unsent
        // changes are read once, and the run is refused before anything is applied when there are any
        var fetchedRowCount = 0;
        var limitChecked = false;

        // A fetch past the chunk threshold reads the unsent changes once (a refresh leaves out the rows it discards): with
        // none, the rest of the download is applied a chunk at a time
        chunkable = chunkable && fetch;
        var thresholdChecked = false;
        ChunkedDownload? chunked = null;

        for (var index = 0; index < scope.Count; index++)
        {
            var table = scope[index];
            var anchor = table.IsVersionless || refresh is not null ? null : anchors.GetValueOrDefault(table.TableName);
            var rows = new List<EntityBaseCore>();
            IReadOnlySet<string>? serverKeys = null;

            if (fetch)
            {
                await foreach (
                    var page in table
                        .FetchPagesAsync(anchor, ceiling, options.DownloadBatchSize, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    if (chunked is not null)
                    {
                        await chunked.AddAsync(table, page, cancellationToken).ConfigureAwait(false);
                        continue;
                    }

                    rows.AddRange(page);
                    fetchedRowCount += page.Count;

                    if (chunkable && !thresholdChecked && fetchedRowCount > ChunkThreshold)
                    {
                        thresholdChecked = true;

                        if (
                            (
                                await ReadUnsentInScopeAsync(scope, discards, refresh is not null, cancellationToken)
                                    .ConfigureAwait(false)
                            ).Count == 0
                        )
                        {
                            chunked = await EnterChunkedDownloadAsync(
                                    scope,
                                    index,
                                    plans,
                                    rows,
                                    refresh is null ? anchors : [],
                                    options,
                                    changes,
                                    refresh,
                                    discards,
                                    cancellationToken
                                )
                                .ConfigureAwait(false);
                            continue;
                        }
                    }

                    if (!limitChecked && fetchedRowCount > options.DownloadRowLimit)
                    {
                        limitChecked = true;
                        var unsent = await ReadUnsentInScopeAsync(
                                scope,
                                discards,
                                refresh is not null,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        if (unsent.Count > 0)
                        {
                            DownloadRouteObserved?.Invoke(TrackedSyncDownloadRoute.Refused);

                            throw DownloadTooLarge(scope, unsent, fetchedRowCount, options.DownloadRowLimit);
                        }

                        if (chunkable)
                        {
                            chunked = await EnterChunkedDownloadAsync(
                                    scope,
                                    index,
                                    plans,
                                    rows,
                                    refresh is null ? anchors : [],
                                    options,
                                    changes,
                                    refresh,
                                    discards,
                                    cancellationToken
                                )
                                .ConfigureAwait(false);
                        }
                    }
                }

                if (chunked is not null)
                {
                    await chunked.FinishTableAsync(table, cancellationToken).ConfigureAwait(false);
                    continue;
                }

                if (options.PropagateDeletes)
                {
                    serverKeys = await table.FetchServerKeysAsync(cancellationToken).ConfigureAwait(false);
                }
            }

            // A row being discarded takes the server's row from what was fetched, or else is read from the server by key
            // (a row nobody else changed is not among the changes)
            var tableDiscards = new Dictionary<string, TrackedSyncPlanDiscard>(StringComparer.Ordinal);
            var wanted = discards
                .Where(discard => discard.Key.Table == table.TableName)
                .ToDictionary(discard => discard.Key.Key, discard => discard.Value, StringComparer.Ordinal);

            if (wanted.Count > 0)
            {
                var fetchedByKey = new Dictionary<string, EntityBaseCore>(StringComparer.Ordinal);

                foreach (var row in rows)
                {
                    var keyText = table.KeyText(table.KeyOf(row));

                    if (wanted.ContainsKey(keyText))
                    {
                        fetchedByKey[keyText] = row;
                    }
                }

                foreach (var (keyText, discard) in wanted)
                {
                    tableDiscards[keyText] = new TrackedSyncPlanDiscard(
                        discard.Key,
                        discard.Sequence,
                        fetchedByKey.TryGetValue(keyText, out var server) ? server
                        : refresh is not null ? null
                        : await table.ReadServerAsync(discard.Key, cancellationToken).ConfigureAwait(false)
                    );
                }
            }

            plans.Add(
                new TrackedSyncPlan(table, rows, serverKeys, anchor)
                {
                    Discards = tableDiscards,
                    Refresh = refresh,
                }
            );
        }

        if (chunked is not null)
        {
            var chunkedOutcome = await chunked.FinishAsync(cancellationToken).ConfigureAwait(false);

            if (options.IncludeUnboundedBinary)
            {
                await CopyOwedBinariesAsync(scope, cancellationToken).ConfigureAwait(false);
            }

            return chunkedOutcome;
        }

        if (fetch)
        {
            DownloadRouteObserved?.Invoke(TrackedSyncDownloadRoute.Single);
        }

        var outcome = await ApplyAsync(plans, options.IncludeUnboundedBinary, advanceAnchors: fetch, cancellationToken)
            .ConfigureAwait(false);

        // The rows the apply changed on its own are noted right after its commit, so a failed copy below still hands
        // them on
        foreach (var change in outcome.Changes)
        {
            changes?.Add(change.TableName, change.KeyText, change.Reason);
        }

        if (options.IncludeUnboundedBinary)
        {
            await CopyOwedBinariesAsync(scope, cancellationToken).ConfigureAwait(false);
        }

        return outcome;
    }

    /// <summary>
    /// Switches a fetch to applying a chunk at a time: takes the server keys of the tables not keyed yet (the table being
    /// fetched and the ones after it, in order, when delete propagation is on), runs the delete propagation of every table
    /// in a transaction of its own, and then applies the rows fetched so far as chunks, table by table.
    /// </summary>
    /// <remarks>
    /// For a refresh, that transaction also does what a refresh does to the whole of each table: it forgets the rows
    /// neither side holds, gives the unbounded binary columns up when the refresh does, settles the rows it discards that
    /// the server no longer holds, and sets every table's resume point back to nothing fetched, from which the chunks move
    /// it.
    /// </remarks>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="index">The position in <paramref name="scope"/> of the table being fetched.</param>
    /// <param name="plans">The tables fetched in full so far, with their rows and server keys.</param>
    /// <param name="rows">The rows of the table being fetched, so far.</param>
    /// <param name="anchors">The resume points the fetch started from, by table name (empty for a refresh).</param>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="changes">Where the rows the run changes on its own are noted (null for nowhere).</param>
    /// <param name="refresh">The refresh the fetch belongs to (null for an ordinary download).</param>
    /// <param name="discards">The rows the run discards (only a refresh enters with any).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<ChunkedDownload> EnterChunkedDownloadAsync(
        List<ITrackedSyncTable> scope,
        int index,
        List<TrackedSyncPlan> plans,
        List<EntityBaseCore> rows,
        Dictionary<string, byte[]?> anchors,
        SyncOptions options,
        SyncLocalRowChangeLog? changes,
        TrackedSyncRefresh? refresh,
        Dictionary<(string Table, string Key), TrackedSyncDiscard> discards,
        CancellationToken cancellationToken
    )
    {
        DownloadRouteObserved?.Invoke(TrackedSyncDownloadRoute.Chunked);
        var chunked = new ChunkedDownload(this, anchors, options.IncludeUnboundedBinary, changes, refresh, discards);

        if (options.PropagateDeletes)
        {
            var deletions = plans.Select(plan => chunked.DeletionPlan(plan.Table, plan.ServerKeys)).ToList();

            // The keys of the table being fetched and of the ones after it are taken before the rest of their rows
            for (var later = index; later < scope.Count; later++)
            {
                deletions.Add(
                    chunked.DeletionPlan(
                        scope[later],
                        await scope[later].FetchServerKeysAsync(cancellationToken).ConfigureAwait(false)
                    )
                );
            }

            await chunked.ApplyDeletionsAsync(deletions, cancellationToken).ConfigureAwait(false);
        }

        foreach (var plan in plans)
        {
            await chunked.AddAsync(plan.Table, plan.Rows, cancellationToken).ConfigureAwait(false);
            await chunked.FinishTableAsync(plan.Table, cancellationToken).ConfigureAwait(false);
        }

        await chunked.AddAsync(scope[index], rows, cancellationToken).ConfigureAwait(false);

        return chunked;
    }

    /// <summary>
    /// Reads the unsent changes of the tables of the run (table and key text). The unsent rows of tables outside the run
    /// are not counted. A run counts the rows it is about to discard as unsent; a refresh does not count the rows it
    /// discards when forced, unless they were written again since (their change number is no longer the one the discard
    /// was decided on, so the apply keeps them).
    /// </summary>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="discards">The rows the run discards.</param>
    /// <param name="refreshing">Whether the run is a refresh.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<HashSet<(string Table, string Key)>> ReadUnsentInScopeAsync(
        List<ITrackedSyncTable> scope,
        Dictionary<(string Table, string Key), TrackedSyncDiscard> discards,
        bool refreshing,
        CancellationToken cancellationToken
    )
    {
        var unsent = new HashSet<(string Table, string Key)>();

        {
            var connection = RunConnection;

            foreach (var row in await TrackedSyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
            {
                var table = scope.FirstOrDefault(candidate =>
                    string.Equals(candidate.TableName, row.TableName, StringComparison.Ordinal)
                );

                if (table is null)
                {
                    continue;
                }

                var key = (table.TableName, table.KeyText(table.KeyOfRaw(row.RawKey)));

                // A refresh leaves out a row it discards when forced, only while the row is still at the change the
                // discard was decided on: a row written again since is kept by the apply, so it is unsent
                if (
                    refreshing
                    && discards.TryGetValue(key, out var discard)
                    && discard.Sequence == row.ChangeSequence
                )
                {
                    continue;
                }

                unsent.Add(key);
            }
        }

        if (!refreshing)
        {
            foreach (var key in discards.Keys)
            {
                if (scope.Exists(table => string.Equals(table.TableName, key.Table, StringComparison.Ordinal)))
                {
                    unsent.Add(key);
                }
            }
        }

        return unsent;
    }

    /// <summary>The refusal of a fetch that went over the download row limit while the tables of the run held unsent changes.</summary>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="unsent">The unsent changes of the tables of the run (<see cref="ReadUnsentInScopeAsync"/>).</param>
    /// <param name="fetchedRowCount">The rows fetched so far.</param>
    /// <param name="rowLimit">The limit the fetch went over.</param>
    private static SyncDownloadTooLargeException DownloadTooLarge(
        List<ITrackedSyncTable> scope,
        HashSet<(string Table, string Key)> unsent,
        int fetchedRowCount,
        int rowLimit
    ) =>
        new(
            fetchedRowCount,
            rowLimit,
            scope
                .Select(table => new SyncPendingChange(
                    table.TableName,
                    unsent.Count(key => string.Equals(key.Table, table.TableName, StringComparison.Ordinal))
                ))
                .Where(change => change.Count > 0)
                .ToList()
        );

    /// <summary>
    /// Applies the fetched rows in one transaction. A foreign key violation rolls the attempt back and starts it again
    /// with the child it wrote held back, or with the parent it deleted kept.
    /// </summary>
    private async Task<TrackedSyncDownload> ApplyAsync(
        List<TrackedSyncPlan> plans,
        bool owesBinaries,
        bool advanceAnchors,
        CancellationToken cancellationToken
    )
    {
        // Rows held back (table, key text -> the missing parent's table, or null) and parents not to delete
        var held = new Dictionary<(string Table, string Key), string?>();
        var keep = new HashSet<(string Table, string Key)>();

        // The violations the database already had before the apply wrote anything: not this apply's doing, so they do not
        // stop it. Read only once an attempt finds violations (the check scans the whole database, and an apply that
        // leaves none needs one check, not two), and kept across the attempts
        HashSet<(string ChildTable, string ChildKey, string ParentTable, long ForeignKey)>? existing = null;

        for (var attempt = 0; attempt < MaxApplyAttempts; attempt++)
        {
            // Every attempt runs on the run's connection: the attempt before rolled back, so it starts on the state the
            // apply began with
            var connection = RunConnection;
            await TrackedSyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);
            var open = true;

            try
            {
                await TrackedSyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false);

                var run = new ApplyAttempt(connection, held, keep);

                // Delete propagation runs in every table before any row is written, so a value a removed row holds is
                // free for the server row that takes it
                foreach (var plan in plans)
                {
                    if (plan.ReadsStatesByKey)
                    {
                        // Only the plan's own rows: the transaction reads nothing in proportion to the table
                        var (states, rawKeys) = await TrackedSyncState
                            .ReadRowsByKeyAsync(
                                connection,
                                plan.Table.TableName,
                                QualifiedName(plan.Table),
                                Identifier(plan.Table.LocalKeyColumnName),
                                plan
                                    .Rows.Select(plan.Table.KeyOf)
                                    .Concat(plan.Discards.Values.Select(discard => discard.Key))
                                    .ToList(),
                                plan.Table.KeyTextOfRaw,
                                cancellationToken
                            )
                            .ConfigureAwait(false);
                        run.States[plan.Table.TableName] = states;
                        run.KnowRawKeys(plan.Table, rawKeys);
                    }
                    else
                    {
                        run.States[plan.Table.TableName] = await TrackedSyncState
                            .ReadRowsAsync(connection, plan.Table.TableName, plan.Table.KeyTextOfRaw, cancellationToken)
                            .ConfigureAwait(false);
                    }

                    await SettleDiscardsWithoutServerRowAsync(run, plan, cancellationToken).ConfigureAwait(false);
                    await PropagateDeletesAsync(run, plan, cancellationToken).ConfigureAwait(false);

                    if (plan.Refresh is not null && plan.RunsTableWideSteps)
                    {
                        await ForgetRowsGoneOnBothSidesAsync(run, plan, cancellationToken).ConfigureAwait(false);
                    }
                }

                foreach (var plan in plans)
                {
                    await WriteRowsAsync(run, plan, owesBinaries, cancellationToken).ConfigureAwait(false);
                }

                var violations = (await ForeignKeyViolationsAsync(connection, cancellationToken).ConfigureAwait(false))
                    .Where(violation => existing is null || !existing.Contains(violation.Identity))
                    .ToList();

                if (violations.Count > 0)
                {
                    await TrackedSyncState.ExecuteAsync(connection, "ROLLBACK", CancellationToken.None).ConfigureAwait(false);
                    open = false;

                    // With the attempt rolled back, the database is as it was before the apply wrote anything: what it
                    // reports now is what it already had
                    if (existing is null)
                    {
                        existing = (await ForeignKeyViolationsAsync(connection, cancellationToken).ConfigureAwait(false))
                            .Select(violation => violation.Identity)
                            .ToHashSet();
                        violations = violations.Where(violation => !existing.Contains(violation.Identity)).ToList();

                        if (violations.Count == 0)
                        {
                            continue;
                        }
                    }

                    var changed = false;
                    var lookups = new List<TrackedSyncViolation>();

                    foreach (var violation in violations)
                    {
                        if (run.Written.Contains(violation.Child) && !held.ContainsKey(violation.Child))
                        {
                            held[violation.Child] = violation.ParentTable;
                            changed = true;
                        }
                        else if (violation.Parent is { } parent && run.Deleted.Contains(parent) && keep.Add(parent))
                        {
                            changed = true;
                        }
                        else if (violation.Parent is null && violation.LookupColumns is not null)
                        {
                            lookups.Add(violation);
                        }
                    }

                    // A foreign key to a column other than the primary key names its parent by that column's values:
                    // with the delete rolled back the parent is there again, and is looked up by them
                    foreach (var violation in lookups)
                    {
                        if (
                            await FindParentKeyTextAsync(connection, violation, cancellationToken).ConfigureAwait(false)
                                is { } parentKey
                            && run.Deleted.Contains(parentKey)
                            && keep.Add(parentKey)
                        )
                        {
                            changed = true;
                        }
                    }

                    if (!changed)
                    {
                        throw new InvalidOperationException(
                            "The download left foreign key violations it cannot explain: "
                                + string.Join(
                                    "; ",
                                    violations.Select(violation =>
                                        violation.Child.Table
                                        + "/"
                                        + violation.Child.Key
                                        + " -> "
                                        + violation.ParentTable
                                        + "/"
                                        + (violation.Parent?.Key ?? "?")
                                    )
                                )
                        );
                    }

                    continue;
                }

                var truncations = new List<SyncDownloadTruncation>();

                foreach (var plan in plans)
                {
                    await SaveResumePointAsync(run, plan, truncations, advanceAnchors, cancellationToken)
                        .ConfigureAwait(false);
                }

                await TrackedSyncState.SetApplyingAsync(connection, false, cancellationToken).ConfigureAwait(false);
                await TrackedSyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);
                open = false;

                return new TrackedSyncDownload(run.Downloaded, run.DeletedLocally, truncations)
                {
                    Discarded = run.Discarded,
                    Changes = run.Changes,
                    PerTable = plans.ToDictionary(
                        plan => plan.Table.TableName,
                        plan =>
                            (
                                run.Deleted.Count(row => row.Table == plan.Table.TableName),
                                run.Written.Count(row => row.Table == plan.Table.TableName)
                            ),
                        StringComparer.Ordinal
                    ),
                };
            }
            catch
            {
                if (open)
                {
                    try
                    {
                        await TrackedSyncState
                            .ExecuteAsync(connection, "ROLLBACK", CancellationToken.None)
                            .ConfigureAwait(false);
                    }
                    catch (DbException)
                    {
                        // The rollback failing must not hide what went wrong first
                    }
                }

                throw;
            }
        }

        throw new InvalidOperationException(
            "The download did not settle within "
                + MaxApplyAttempts.ToString(CultureInfo.InvariantCulture)
                + " attempts."
        );
    }

    /// <summary>
    /// Deletes the local rows of one table the server no longer has, except the rows with an unsent change and the
    /// parents an earlier attempt found it must keep.
    /// </summary>
    private static async Task PropagateDeletesAsync(
        ApplyAttempt run,
        TrackedSyncPlan plan,
        CancellationToken cancellationToken
    )
    {
        if (plan.ServerKeys is not { } serverKeys)
        {
            return;
        }

        var table = plan.Table;
        var states = run.States[table.TableName];

        foreach (var key in await table.ListKeysAsync(run.Connection, cancellationToken).ConfigureAwait(false))
        {
            var keyText = table.KeyText(key);

            if (
                serverKeys.Contains(keyText)
                || run.Keep.Contains((table.TableName, keyText))
                || states.GetValueOrDefault(keyText) is { Dirty: true }
            )
            {
                continue;
            }

            await table.DeleteAsync(run.Connection, key, cancellationToken).ConfigureAwait(false);

            if (states.Remove(keyText, out var state))
            {
                await TrackedSyncState
                    .RemoveRowAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                    .ConfigureAwait(false);
            }

            run.Deleted.Add((table.TableName, keyText));
            run.DeletedLocally++;
        }
    }

    /// <summary>
    /// For a refresh: removes the states of the rows neither side holds any more (the server does not, and the local table
    /// has no such row), so that a row made later under the same key is not taken for one the server knows; and, when the
    /// refresh gives the unbounded binary columns up, drops what earlier runs left owing.
    /// </summary>
    private static async Task ForgetRowsGoneOnBothSidesAsync(
        ApplyAttempt run,
        TrackedSyncPlan plan,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var states = run.States[table.TableName];

        foreach (var (keyText, state) in states.ToList())
        {
            if (
                state.Dirty
                || plan.ServerKeys is { } serverKeys && serverKeys.Contains(keyText)
                || await table
                    .ExistsAsync(run.Connection, table.KeyOfRaw(state.RawKey), cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                continue;
            }

            await TrackedSyncState
                .RemoveRowAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                .ConfigureAwait(false);
            states.Remove(keyText);
        }

        if (plan.Refresh is { BlankBinaries: true } && table.UnboundedBinaryColumnNames.Count > 0)
        {
            // Every local row of the table without an unsent change loses its columns here, in the apply's transaction - also
            // a row the refresh does not write (one the server changed after the ceiling) and a row written later by a fetch
            // held back: what a row written afterwards brings carries no columns either. A row with an unsent change keeps
            // them: one the refresh does not discard (it was written while the refresh ran), and one being discarded that
            // the server still holds - whether the server's row can be put over it is not known yet, so it stays as it is,
            // columns and all, until the write that puts the server's row over it empties them (a row that cannot be placed
            // stays unsent with its columns). The rows being discarded the server no longer holds were settled just before,
            // so they are no longer unsent
            await BlankLocalBinariesAsync(
                    run.Connection,
                    table,
                    states.Values.Any(state => state.Dirty),
                    null,
                    cancellationToken
                )
                .ConfigureAwait(false);
            await TrackedSyncState
                .ClearTableOwedAsync(run.Connection, table.TableName, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Empties the unbounded binary columns of the local rows of a table: NULL in a column that allows it, an empty value
    /// in a NOT NULL column (what a row written without the columns holds).
    /// </summary>
    /// <param name="connection">The apply's connection.</param>
    /// <param name="table">The table.</param>
    /// <param name="keepUnsent">
    /// With no rows given: whether the rows the row state table marks as unsent keep their columns (false when the table
    /// has none, which spares the look-up).
    /// </param>
    /// <param name="onlyRawKeys">The rows to empty, by key as stored; null for every row of the table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private static async Task BlankLocalBinariesAsync(
        DbConnection connection,
        ITrackedSyncTable table,
        bool keepUnsent,
        IReadOnlyList<object>? onlyRawKeys,
        CancellationToken cancellationToken
    )
    {
        if (onlyRawKeys is { Count: 0 })
        {
            return;
        }

        var notNull = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using (var info = connection.CreateCommand())
        {
            info.CommandText =
                "PRAGMA "
                + Identifier(table.LocalDatabaseName ?? "main")
                + ".table_info("
                + Identifier(table.LocalTableName)
                + ")";
            await using var reader = await info.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                if (reader.GetInt64(3) != 0)
                {
                    notNull.Add(reader.GetString(1));
                }
            }
        }

        var update =
            "UPDATE "
            + QualifiedName(table)
            + " SET "
            + string.Join(
                ", ",
                table.LocalUnboundedBinaryColumnNames.Select(column =>
                    Identifier(column) + " = " + (notNull.Contains(column) ? "X''" : "NULL")
                )
            );
        var keyColumn = QualifiedName(table) + "." + Identifier(table.LocalKeyColumnName);

        if (onlyRawKeys is null)
        {
            await using var blank = connection.CreateCommand();
            blank.CommandText = update;

            if (keepUnsent)
            {
                blank.CommandText += " WHERE " + NotUnsentCondition(keyColumn);
                TrackedSyncState.AddParameter(blank, "@table", table.TableName);
            }

            await blank.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);

            return;
        }

        for (var start = 0; start < onlyRawKeys.Count; start += MaxBlankedKeysPerStatement)
        {
            var count = Math.Min(MaxBlankedKeysPerStatement, onlyRawKeys.Count - start);
            await using var blank = connection.CreateCommand();
            blank.CommandText =
                update
                + " WHERE "
                + keyColumn
                + " IN ("
                + string.Join(
                    ", ",
                    Enumerable.Range(0, count).Select(index => "@k" + index.ToString(CultureInfo.InvariantCulture))
                )
                + ")";

            for (var index = 0; index < count; index++)
            {
                TrackedSyncState.AddParameter(
                    blank,
                    "@k" + index.ToString(CultureInfo.InvariantCulture),
                    onlyRawKeys[start + index]
                );
            }

            await blank.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>The most keys <see cref="BlankLocalBinariesAsync"/> binds in one statement (well under SQLite's limit on the number of parameters).</summary>
    private const int MaxBlankedKeysPerStatement = 500;

    /// <summary>
    /// The condition that is true for the rows of a synchronised table the row state table does not mark as unsent (the
    /// statement binds the table's name as <c>@table</c>).
    /// </summary>
    /// <remarks>
    /// The unsent rows are read from the row state table inside the statement (it stores each key as the table does), so
    /// their number is never bound as parameters. The subquery does not refer to the outer row: it runs once, and each row
    /// of the table is looked up in its result. Comparing the table's key column against the state table's untyped key
    /// column row by row cannot use the state table's index, and reads every state row of the table for every row of the
    /// table. A NULL among the keys would make the condition true for no row, so the subquery leaves NULL out. A row of
    /// the table whose own key is NULL satisfies the condition only while the table has no unsent row.
    /// </remarks>
    /// <param name="quotedKeyColumn">The synchronised table's key column, quoted (and qualified where needed).</param>
    internal static string NotUnsentCondition(string quotedKeyColumn) =>
        quotedKeyColumn
        + " NOT IN (SELECT s.\"key\" FROM "
        + SyncLocalTracking.RowTableName
        + " AS s WHERE s.table_name = @table AND s.dirty = 1 AND s.\"key\" IS NOT NULL)";

    /// <summary>
    /// Settles the rows of one table that <see cref="SyncConflictPolicy.ServerWins"/> is discarding: only the rows still at
    /// the change number read at the start of the run are discarded (a row written again in the meantime keeps its local
    /// content), and a row the server no longer has only loses its unsent change - the row itself is left to the delete
    /// propagation. After the chunks of a refresh that gives the unbounded binary columns up, such a row loses those
    /// columns along with its change.
    /// </summary>
    private static async Task SettleDiscardsWithoutServerRowAsync(
        ApplyAttempt run,
        TrackedSyncPlan plan,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var states = run.States[table.TableName];
        var live = new Dictionary<string, TrackedSyncPlanDiscard>(StringComparer.Ordinal);

        foreach (var (keyText, discard) in plan.Discards)
        {
            if (states.TryGetValue(keyText, out var current) && current.ChangeSequence != discard.Sequence)
            {
                continue;
            }

            live[keyText] = discard;
        }

        run.LiveDiscards[table.TableName] = live;

        foreach (var (keyText, discard) in live)
        {
            // A plan that settles only the rows the server no longer holds leaves the others to the chunk that brings them
            if (
                discard.Server is not null
                || run.Held.ContainsKey((table.TableName, keyText))
                || plan.KeepsDiscardsTheServerHas && plan.ServerKeys is { } serverKeys && serverKeys.Contains(keyText)
            )
            {
                continue;
            }

            if (states.TryGetValue(keyText, out var state))
            {
                await TrackedSyncState
                    .ClearDiscardedAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                    .ConfigureAwait(false);
                states[keyText] = state with { Dirty = false };

                // After the chunks of a refresh that gives the unbounded binary columns up, a row being discarded that no
                // chunk brought (the server changed it after the ceiling, or deleted it after its key was read) still
                // holds the columns the transaction before the chunks left it: they go with its change, on this row alone
                if (
                    plan.Refresh is { BlankBinaries: true }
                    && !plan.RunsTableWideSteps
                    && table.UnboundedBinaryColumnNames.Count > 0
                )
                {
                    await BlankLocalBinariesAsync(run.Connection, table, false, [state.RawKey], cancellationToken)
                        .ConfigureAwait(false);
                }
            }

            run.NoteDiscarded(table.TableName, keyText);
        }
    }

    /// <summary>
    /// Writes the fetched rows of one table: a row with an unsent change keeps the local content, a row this device
    /// already holds the server's version of is skipped, and a row that collides on a unique value goes after the
    /// others, then into a rotation with the rows left, and is held back when even that cannot place it.
    /// </summary>
    private async Task WriteRowsAsync(
        ApplyAttempt run,
        TrackedSyncPlan plan,
        bool owesBinaries,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var states = run.States[table.TableName];
        var owed =
            owesBinaries && table.UnboundedBinaryColumnNames.Count > 0
                ? string.Join(",", table.UnboundedBinaryColumnNames)
                : string.Empty;
        var writes = new List<TrackedSyncRowWrite>();
        var discards = run.LiveDiscards[table.TableName];
        var fetchedKeys = new HashSet<string>(StringComparer.Ordinal);

        foreach (var row in plan.Rows)
        {
            var key = table.KeyOf(row);
            var keyText = table.KeyText(key);
            fetchedKeys.Add(keyText);

            if (run.Held.ContainsKey((table.TableName, keyText)))
            {
                continue;
            }

            states.TryGetValue(keyText, out var state);

            // A row ServerWins is discarding takes the server's row whatever the local row holds
            if (discards.ContainsKey(keyText))
            {
                writes.Add(new TrackedSyncRowWrite(row, key, keyText, state) { Discard = true });
                continue;
            }

            // A row with an unsent change keeps the local content - unless the local row is gone and the server never
            // had it: then there is nothing to send, and the server row takes its place
            if (
                state is { Dirty: true }
                && (
                    state.Known
                    || table.IsVersionless
                    || await table.ExistsAsync(run.Connection, key, cancellationToken).ConfigureAwait(false)
                )
            )
            {
                // A local row made under a key the server does not know holds the table's resume point before it:
                // past it, the server row would never come down again once the local row goes
                if (!state.Known && !table.IsVersionless)
                {
                    run.UniqueHeld.Add((table.TableName, keyText));
                }

                continue;
            }

            // The echo of what this device sent: the server row carries the version the local content is based on (a refresh
            // skips no echo: it rewrites every row, which brings back the columns a run that did not carry them left out)
            if (
                plan.Refresh is null
                && !table.IsVersionless
                && state?.BaseVersion is { } baseVersion
                && table.VersionOf(row) is { } version
                && baseVersion.AsSpan().SequenceEqual(version)
                && await table.ExistsAsync(run.Connection, key, cancellationToken).ConfigureAwait(false)
            )
            {
                continue;
            }

            writes.Add(new TrackedSyncRowWrite(row, key, keyText, state));
        }

        // A row being discarded that was not among the changes takes the server's row read by key
        foreach (var (keyText, discard) in discards)
        {
            if (
                discard.Server is not { } server
                || fetchedKeys.Contains(keyText)
                || run.Held.ContainsKey((table.TableName, keyText))
            )
            {
                continue;
            }

            states.TryGetValue(keyText, out var state);
            writes.Add(new TrackedSyncRowWrite(server, discard.Key, keyText, state) { Discard = true });
        }

        // A row that collides on a unique value goes after the others, as long as the others make progress
        var remaining = writes;

        while (remaining.Count > 0)
        {
            var deferred = new List<TrackedSyncRowWrite>();

            foreach (var write in remaining)
            {
                if (await TryWriteAsync(run, table, write, owed, cancellationToken).ConfigureAwait(false))
                {
                    run.Note(table, write);
                }
                else
                {
                    deferred.Add(write);
                }
            }

            if (deferred.Count == remaining.Count)
            {
                break;
            }

            remaining = deferred;
        }

        if (remaining.Count > 0)
        {
            // The rows left take values from one another (a swap or a rotation): they are deleted and inserted again
            // together, and a row that still collides is held back
            var stillHeld = await RotateAsync(run, table, remaining, owed, cancellationToken).ConfigureAwait(false);

            foreach (var write in remaining)
            {
                if (stillHeld.Contains(write))
                {
                    run.UniqueHeld.Add((table.TableName, write.KeyText));
                }
                else
                {
                    run.Note(table, write);
                }
            }
        }

        // A refresh that gives the unbounded binary columns up empties them on each row being discarded this apply put the
        // server's row over (until then such a row kept them: it was still unsent). A row being discarded that could not be
        // placed is left as it is - unsent, with its columns
        if (plan.Refresh is { BlankBinaries: true } && table.UnboundedBinaryColumnNames.Count > 0)
        {
            var replaced = writes
                .Where(write =>
                    write.Discard && write.State is not null && run.Written.Contains((table.TableName, write.KeyText))
                )
                .Select(write => write.State!.RawKey)
                .ToList();
            await BlankLocalBinariesAsync(run.Connection, table, false, replaced, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Writes one row (an update when the local row is there, an insert otherwise) and its state, inside a savepoint;
    /// false, with nothing written, when a unique value is already taken.
    /// </summary>
    private async Task<bool> TryWriteAsync(
        ApplyAttempt run,
        ITrackedSyncTable table,
        TrackedSyncRowWrite write,
        string owed,
        CancellationToken cancellationToken
    )
    {
        var connection = run.Connection;
        await TrackedSyncState
            .ExecuteAsync(connection, "SAVEPOINT " + WriteSavepoint, cancellationToken)
            .ConfigureAwait(false);

        try
        {
            var exists = await table.ExistsAsync(connection, write.Key, cancellationToken).ConfigureAwait(false);

            if (exists)
            {
                await table.UpdateAsync(connection, write.Row, cancellationToken).ConfigureAwait(false);
            }
            else
            {
                await table.InsertAsync(connection, write.Row, cancellationToken).ConfigureAwait(false);
            }

            var rawKey =
                write.State?.RawKey
                ?? await run.RawKeyAsync(table, write.KeyText, inserted: !exists, cancellationToken).ConfigureAwait(false);
            await TrackedSyncState
                .WriteAppliedRowAsync(
                    connection,
                    table.TableName,
                    rawKey,
                    table.VersionOf(write.Row),
                    owed,
                    cancellationToken
                )
                .ConfigureAwait(false);
            await TrackedSyncState
                .ExecuteAsync(connection, "RELEASE " + WriteSavepoint, cancellationToken)
                .ConfigureAwait(false);

            return true;
        }
        catch (DbException failure) when (_rows.IsUniqueViolation(failure))
        {
            await TrackedSyncState
                .ExecuteAsync(connection, "ROLLBACK TO " + WriteSavepoint, CancellationToken.None)
                .ConfigureAwait(false);
            await TrackedSyncState
                .ExecuteAsync(connection, "RELEASE " + WriteSavepoint, CancellationToken.None)
                .ConfigureAwait(false);

            return false;
        }
    }

    /// <summary>
    /// Deletes the local rows of the set and inserts the whole set again inside a savepoint; when a row still collides,
    /// goes back to the savepoint and tries again without it. Returns the rows held back.
    /// </summary>
    /// <remarks>
    /// The rows written carry no unbounded binary columns, so the local rows' columns are kept in a table of the
    /// connection's temporary schema before the rows go (copied inside the database, never through memory) and written back
    /// onto the rows inserted again; the temporary schema leaves the main database's schema version alone. A row the
    /// savepoint puts back keeps its own columns.
    /// </remarks>
    private async Task<HashSet<TrackedSyncRowWrite>> RotateAsync(
        ApplyAttempt run,
        ITrackedSyncTable table,
        List<TrackedSyncRowWrite> rows,
        string owed,
        CancellationToken cancellationToken
    )
    {
        var connection = run.Connection;
        var heldBack = new HashSet<TrackedSyncRowWrite>();
        var set = rows.ToList();
        var kept = new Dictionary<TrackedSyncRowWrite, object>();

        if (table.UnboundedBinaryColumnNames.Count > 0)
        {
            await TrackedSyncState.ExecuteAsync(connection, CreateRotateTableSql, cancellationToken).ConfigureAwait(false);

            foreach (var write in set)
            {
                if (!await table.ExistsAsync(connection, write.Key, cancellationToken).ConfigureAwait(false))
                {
                    continue;
                }

                var rawKey = await run
                    .RawKeyAsync(table, write.KeyText, inserted: false, cancellationToken)
                    .ConfigureAwait(false);

                foreach (var column in table.LocalUnboundedBinaryColumnNames)
                {
                    await TrackedSyncState
                        .ExecuteAsync(
                            connection,
                            "INSERT INTO temp."
                                + RotateTableName
                                + " (table_name, k, column_name, v) SELECT @table, "
                                + Identifier(table.LocalKeyColumnName)
                                + ", @column, "
                                + Identifier(column)
                                + " FROM "
                                + QualifiedName(table)
                                + " WHERE "
                                + Identifier(table.LocalKeyColumnName)
                                + " = @key",
                            cancellationToken,
                            ("@table", table.TableName),
                            ("@column", column),
                            ("@key", rawKey)
                        )
                        .ConfigureAwait(false);
                }

                kept[write] = rawKey;
            }
        }

        while (set.Count > 0)
        {
            await TrackedSyncState
                .ExecuteAsync(connection, "SAVEPOINT " + RotateSavepoint, cancellationToken)
                .ConfigureAwait(false);

            foreach (var write in set)
            {
                await table.DeleteAsync(connection, write.Key, cancellationToken).ConfigureAwait(false);
            }

            var failing = new List<TrackedSyncRowWrite>();

            foreach (var write in set)
            {
                if (!await TryWriteAsync(run, table, write, owed, cancellationToken).ConfigureAwait(false))
                {
                    failing.Add(write);
                }
            }

            if (failing.Count == 0)
            {
                // The rows inserted again take back the unbounded binary columns their local rows had
                foreach (var write in set)
                {
                    if (kept.TryGetValue(write, out var rawKey))
                    {
                        await RestoreKeptBinariesAsync(connection, table, rawKey, cancellationToken)
                            .ConfigureAwait(false);
                    }
                }

                await TrackedSyncState
                    .ExecuteAsync(connection, "RELEASE " + RotateSavepoint, CancellationToken.None)
                    .ConfigureAwait(false);
                break;
            }

            // CancellationToken.None: a canceled token must not be able to leave the savepoint half undone
            await TrackedSyncState
                .ExecuteAsync(connection, "ROLLBACK TO " + RotateSavepoint, CancellationToken.None)
                .ConfigureAwait(false);
            await TrackedSyncState
                .ExecuteAsync(connection, "RELEASE " + RotateSavepoint, CancellationToken.None)
                .ConfigureAwait(false);
            heldBack.UnionWith(failing);
            set = set.Except(failing).ToList();
        }

        // The kept copies go with the rotation; on a failure the apply's rollback takes them back with everything else
        if (kept.Count > 0)
        {
            await TrackedSyncState
                .ExecuteAsync(
                    connection,
                    "DELETE FROM temp." + RotateTableName + " WHERE table_name = @table",
                    cancellationToken,
                    ("@table", table.TableName)
                )
                .ConfigureAwait(false);
        }

        return heldBack;
    }

    /// <summary>Writes the kept unbounded binary columns back onto a row the rotation inserted again.</summary>
    private static async Task RestoreKeptBinariesAsync(
        DbConnection connection,
        ITrackedSyncTable table,
        object rawKey,
        CancellationToken cancellationToken
    )
    {
        foreach (var column in table.LocalUnboundedBinaryColumnNames)
        {
            await TrackedSyncState
                .ExecuteAsync(
                    connection,
                    "UPDATE "
                        + QualifiedName(table)
                        + " SET "
                        + Identifier(column)
                        + " = (SELECT v FROM temp."
                        + RotateTableName
                        + " WHERE table_name = @table AND column_name = @column AND k = @key) WHERE "
                        + Identifier(table.LocalKeyColumnName)
                        + " = @key",
                    cancellationToken,
                    ("@table", table.TableName),
                    ("@column", column),
                    ("@key", rawKey)
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>The table of the connection's temporary schema that keeps the unbounded binary columns of rotated rows.</summary>
    private const string RotateTableName = "quicker_sync_rotate";

    /// <summary>Creates the table that keeps the unbounded binary columns of rotated rows (in the temporary schema).</summary>
    private const string CreateRotateTableSql =
        "CREATE TEMP TABLE IF NOT EXISTS quicker_sync_rotate (table_name TEXT NOT NULL, k, column_name TEXT NOT NULL, v BLOB)";

    /// <summary>
    /// Reports the rows of one table held back, and saves its resume point: just before the first row held back, or the
    /// last fetched version when nothing was (never the ceiling itself, which is exclusive).
    /// </summary>
    private static async Task SaveResumePointAsync(
        ApplyAttempt run,
        TrackedSyncPlan plan,
        List<SyncDownloadTruncation> truncations,
        bool advanceAnchors,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var firstHeld = -1;

        for (var index = 0; index < plan.Rows.Count; index++)
        {
            var keyText = table.KeyText(table.KeyOf(plan.Rows[index]));
            var heldForParent = run.Held.TryGetValue((table.TableName, keyText), out var missingParent);

            if (!heldForParent && !run.UniqueHeld.Contains((table.TableName, keyText)))
            {
                continue;
            }

            truncations.Add(
                new SyncDownloadTruncation(table.TableName, keyText, null)
                {
                    MissingParentTableName = heldForParent ? missingParent : null,
                }
            );

            if (firstHeld < 0)
            {
                firstHeld = index;
            }
        }

        // A row ServerWins could not put back keeps its unsent change, marked so that later runs carry the decision out
        var states = run.States[table.TableName];
        var fetched = plan.Rows.Select(row => table.KeyText(table.KeyOf(row))).ToHashSet(StringComparer.Ordinal);

        foreach (var keyText in run.LiveDiscards[table.TableName].Keys)
        {
            var heldForParent = run.Held.TryGetValue((table.TableName, keyText), out var missingParent);

            if (!heldForParent && !run.UniqueHeld.Contains((table.TableName, keyText)))
            {
                continue;
            }

            if (!fetched.Contains(keyText))
            {
                truncations.Add(
                    new SyncDownloadTruncation(table.TableName, keyText, null)
                    {
                        MissingParentTableName = heldForParent ? missingParent : null,
                    }
                );
            }

            if (states.TryGetValue(keyText, out var state))
            {
                await TrackedSyncState
                    .MarkServerWinsAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        if (!advanceAnchors || table.IsVersionless || !plan.AdvancesAnchor)
        {
            return;
        }

        var anchor =
            firstHeld >= 0 ? plan.VersionBefore(firstHeld)
            : plan.Rows.Count > 0 ? plan.ThroughVersion ?? table.VersionOf(plan.Rows[^1])
            : plan.OldAnchor;

        await TrackedSyncState
            .WriteAnchorAsync(run.Connection, table.TableName, anchor, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>
    /// The foreign key violations the local database has now (<c>PRAGMA foreign_key_check</c>), each with the child row's
    /// key and, when the foreign key refers to the parent's primary key, the parent row's key.
    /// </summary>
    private async Task<List<TrackedSyncViolation>> ForeignKeyViolationsAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    )
    {
        var found = new List<(string Table, object RowId, string Parent, long ForeignKey)>();

        await using (var check = connection.CreateCommand())
        {
            check.CommandText = "PRAGMA foreign_key_check";
            await using var reader = await check.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                found.Add((reader.GetString(0), reader.GetValue(1), reader.GetString(2), reader.GetInt64(3)));
            }
        }

        var violations = new List<TrackedSyncViolation>(found.Count);

        foreach (var (tableName, rowId, parentName, foreignKey) in found)
        {
            var child = TableNamed(tableName);
            var parent = TableNamed(parentName);
            var childTable = child?.TableName ?? tableName;
            var parentTable = parent?.TableName ?? parentName;
            var columns = new List<(string From, string? To)>();

            await using (var list = connection.CreateCommand())
            {
                list.CommandText = "PRAGMA foreign_key_list(" + Identifier(tableName) + ")";
                await using var reader = await list.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

                while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
                {
                    if (reader.GetInt64(0) == foreignKey)
                    {
                        columns.Add((reader.GetString(3), reader.IsDBNull(4) ? null : reader.GetString(4)));
                    }
                }
            }

            if (rowId is DBNull || columns.Count == 0)
            {
                violations.Add(
                    new TrackedSyncViolation((childTable, "?"), parentTable, foreignKey, null, null, null, parent)
                );
                continue;
            }

            var referencesKey =
                parent is not null
                && columns.Count == 1
                && (
                    columns[0].To is null
                    || string.Equals(columns[0].To, parent.LocalKeyColumnName, StringComparison.OrdinalIgnoreCase)
                );

            await using var read = connection.CreateCommand();
            read.CommandText =
                "SELECT "
                + (child is null ? "rowid" : Identifier(child.LocalKeyColumnName))
                + ", "
                + string.Join(", ", columns.Select(column => Identifier(column.From)))
                + " FROM "
                + Identifier(tableName)
                + " WHERE rowid = @rowid";
            TrackedSyncState.AddParameter(read, "@rowid", rowId);
            await using var values = await read.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            if (!await values.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                violations.Add(
                    new TrackedSyncViolation((childTable, "?"), parentTable, foreignKey, null, null, null, parent)
                );
                continue;
            }

            var childKey = child is null
                ? "rowid:" + Convert.ToString(values.GetValue(0), CultureInfo.InvariantCulture)
                : child.KeyTextOfRaw(values.GetValue(0));
            (string Table, string Key)? parentKey =
                referencesKey && !values.IsDBNull(1) ? (parentTable, parent!.KeyTextOfRaw(values.GetValue(1))) : null;
            var lookupColumns =
                !referencesKey && parent is not null && columns.All(column => column.To is not null)
                    ? columns.Select(column => column.To!).ToArray()
                    : null;
            var lookupValues = lookupColumns is null
                ? null
                : columns.Select((_, index) => values.GetValue(index + 1)).ToArray();
            violations.Add(
                new TrackedSyncViolation(
                    (childTable, childKey),
                    parentTable,
                    foreignKey,
                    parentKey,
                    lookupColumns,
                    lookupValues,
                    parent
                )
            );
        }

        return violations;
    }

    /// <summary>The key of the parent row a violation's foreign key names by the values of columns other than the primary key (null when no such row is there).</summary>
    private static async Task<(string Table, string Key)?> FindParentKeyTextAsync(
        DbConnection connection,
        TrackedSyncViolation violation,
        CancellationToken cancellationToken
    )
    {
        var parent = violation.ParentDescriptor!;
        var columns = violation.LookupColumns!;
        var values = violation.LookupValues!;

        await using var find = connection.CreateCommand();
        find.CommandText =
            "SELECT "
            + Identifier(parent.LocalKeyColumnName)
            + " FROM "
            + QualifiedName(parent)
            + " WHERE "
            + string.Join(
                " AND ",
                columns.Select((column, index) => Identifier(column) + " = @v" + index.ToString(CultureInfo.InvariantCulture))
            );

        for (var index = 0; index < values.Length; index++)
        {
            TrackedSyncState.AddParameter(find, "@v" + index.ToString(CultureInfo.InvariantCulture), values[index]);
        }

        return await find.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false) is { } rawKey and not DBNull
            ? (parent.TableName, parent.KeyTextOfRaw(rawKey))
            : null;
    }

    /// <summary>
    /// Copies the owed unbounded binary columns down from the server: each row's columns go through temporary files,
    /// then into the local row in a short transaction of their own, and the row stops owing them. A column the local
    /// device wrote since (still unsent) is not copied; a column NULL on the server clears the local column; a row the
    /// server no longer has, or a row gone locally, only stops owing.
    /// </summary>
    private async Task CopyOwedBinariesAsync(List<ITrackedSyncTable> scope, CancellationToken cancellationToken)
    {
        foreach (var table in scope)
        {
            if (table.UnboundedBinaryColumnNames.Count == 0)
            {
                continue;
            }

            IReadOnlyList<TrackedSyncRowState> owedRows;

            {
                var connection = RunConnection;
                owedRows = await TrackedSyncState
                    .ReadOwedAsync(connection, table.TableName, cancellationToken)
                    .ConfigureAwait(false);
            }

            foreach (var owedRow in owedRows)
            {
                await CopyOwedRowAsync(table, owedRow, cancellationToken).ConfigureAwait(false);
            }
        }
    }

    /// <summary>Copies the owed columns of one row (see <see cref="CopyOwedBinariesAsync"/>).</summary>
    private async Task CopyOwedRowAsync(
        ITrackedSyncTable table,
        TrackedSyncRowState owedRow,
        CancellationToken cancellationToken
    )
    {
        var key = table.KeyOfRaw(owedRow.RawKey);
        var owed = SplitColumns(owedRow.BlobOwed);
        var written = SplitColumns(owedRow.BlobColumns);
        var wanted = owed.Where(column => !written.Contains(column)).ToList();

        // A column NULL on the server comes down as null and clears the local column, so the two sides end up alike rather
        // than a stale blob staying under the row
        var files = new List<(string Column, FileStream? File)>();

        try
        {
            foreach (var column in wanted)
            {
                var file = CreateTemporaryFile();

                if (await table.ReadServerBinaryAsync(column, key, file, cancellationToken).ConfigureAwait(false))
                {
                    file.Position = 0;
                    files.Add((column, file));
                }
                else
                {
                    await file.DisposeAsync().ConfigureAwait(false);
                    files.Add((column, null));
                }
            }

            // A row the server no longer has leaves the local columns as they are (the row goes with the delete propagation
            // or stays because something refers to it, and a NOT NULL column cannot be cleared); it only stops owing
            if (
                files.Any(entry => entry.File is null)
                && !await table.ServerHasAsync(table.KeyText(key), cancellationToken).ConfigureAwait(false)
            )
            {
                foreach (var (_, file) in files)
                {
                    if (file is not null)
                    {
                        await file.DisposeAsync().ConfigureAwait(false);
                    }
                }

                files.Clear();
            }

            var connection = RunConnection;
            await TrackedSyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);

            try
            {
                await TrackedSyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false);

                // Read again under the write lock: the device may have written a column, or an apply may have added one
                var current = await TrackedSyncState
                    .ReadRowAsync(connection, table.TableName, owedRow.RawKey, cancellationToken)
                    .ConfigureAwait(false);

                if (current is not null)
                {
                    var currentOwed = SplitColumns(current.BlobOwed);
                    var currentWritten = SplitColumns(current.BlobColumns);

                    foreach (var (column, file) in files)
                    {
                        if (currentOwed.Contains(column) && !currentWritten.Contains(column))
                        {
                            await table
                                .WriteLocalBinaryAsync(connection, key, column, file, file?.Length, cancellationToken)
                                .ConfigureAwait(false);
                        }
                    }

                    await TrackedSyncState
                        .WriteOwedAsync(
                            connection,
                            table.TableName,
                            owedRow.RawKey,
                            string.Join(",", currentOwed.Where(column => !owed.Contains(column))),
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }

                await TrackedSyncState.SetApplyingAsync(connection, false, cancellationToken).ConfigureAwait(false);
                await TrackedSyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);
            }
            catch
            {
                try
                {
                    await TrackedSyncState
                        .ExecuteAsync(connection, "ROLLBACK", CancellationToken.None)
                        .ConfigureAwait(false);
                }
                catch (DbException)
                {
                    // The rollback failing must not hide what went wrong first
                }

                throw;
            }
        }
        finally
        {
            foreach (var (_, file) in files)
            {
                if (file is not null)
                {
                    await file.DisposeAsync().ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>
    /// Opens a dedicated connection with foreign keys checked off (it is not pooled, so the setting goes with it). Only two
    /// places open one: the run's entry (<see cref="RunExclusiveAsync{T}"/>, whose connection the run's body borrows through
    /// <see cref="RunConnection"/>) and the list of unsent changes (<see cref="GetPendingChangesAsync"/>, which reads
    /// outside the run lock).
    /// </summary>
    private async Task<DbConnection> OpenDedicatedAsync(CancellationToken cancellationToken)
    {
        var connection = _rows.CreateDedicatedConnection();

        try
        {
            await connection.OpenAsync(cancellationToken).ConfigureAwait(false);
            await TrackedSyncState
                .ExecuteAsync(connection, "PRAGMA foreign_keys = OFF", cancellationToken)
                .ConfigureAwait(false);

            return connection;
        }
        catch
        {
            await connection.DisposeAsync().ConfigureAwait(false);
            throw;
        }
    }

    /// <summary>The table of the engine whose local table has the name (null when none has).</summary>
    private ITrackedSyncTable? TableNamed(string localTableName) =>
        _tables.FirstOrDefault(table =>
            string.Equals(table.LocalTableName, localTableName, StringComparison.OrdinalIgnoreCase)
            && (table.LocalDatabaseName is null
                || string.Equals(table.LocalDatabaseName, "main", StringComparison.OrdinalIgnoreCase))
        );

    /// <summary>The columns of a comma-separated list.</summary>
    private static HashSet<string> SplitColumns(string columns) =>
        columns.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.Ordinal);

    /// <summary>A name quoted as an SQLite identifier.</summary>
    internal static string Identifier(string name) => "\"" + name.Replace("\"", "\"\"", StringComparison.Ordinal) + "\"";

    /// <summary>The local table's name, quoted, with its schema part when it has one.</summary>
    internal static string QualifiedName(ITrackedSyncTable table) =>
        table.LocalDatabaseName is { } database
            ? Identifier(database) + "." + Identifier(table.LocalTableName)
            : Identifier(table.LocalTableName);

    /// <summary>
    /// A download applied a chunk at a time: each chunk - at most <see cref="ChunkSize"/> consecutive fetched rows of one
    /// table, in fetch order - is applied in a transaction of its own with the parts of a single apply, and the rows a
    /// chunk holds back are carried in memory to one last apply of them all.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A chunk reads the row states of its own rows only, and gets no server keys (the delete propagation ran before the
    /// first chunk). A row it holds back - for a missing parent, for a unique value, or as an unsent local row under a key
    /// the server does not know - is not written; it is carried, together with the version just before it in fetch order.
    /// </para>
    /// <para>
    /// A chunk moves its table's resume point while the table carries no row: to the last row it wrote or skipped, or to
    /// just before the first row it holds back. Once the table carries a row, the later chunks leave the resume point there,
    /// so a run that stops half-way fetches the carried rows again (the rows written after them come back as echoes).
    /// </para>
    /// <para>
    /// The last apply writes the carried rows of every table in one transaction, the way a single apply writes a download,
    /// so a cycle or a swap of unique values across chunks is settled there. It moves the resume point of each table it
    /// writes to the table's last fetched version, or to just before the first row it still holds back; those rows are the
    /// download's truncations.
    /// </para>
    /// <para>
    /// A refresh does what it does to the whole of a table in the transaction before the first chunk, which also sets
    /// every table's resume point back to nothing fetched; its chunks rewrite every row (none is skipped as an echo) and
    /// put the server's row over a row it discards in the chunk that brings it. The last apply also settles the rows it
    /// discards that neither a chunk brought nor that transaction settled (the server held them then): they only lose
    /// their change.
    /// </para>
    /// </remarks>
    /// <param name="engine">The engine applying the download.</param>
    /// <param name="anchors">The resume points the fetch started from, by table name (empty for a refresh).</param>
    /// <param name="owesBinaries">Whether the rows written owe their unbounded binary columns.</param>
    /// <param name="changes">Where the rows the run changes on its own are noted, right after each commit (null for nowhere).</param>
    /// <param name="refresh">The refresh the download belongs to (null for an ordinary download).</param>
    /// <param name="discards">The rows the run discards (only a refresh has any here).</param>
    private sealed class ChunkedDownload(
        TrackedSyncEngine engine,
        Dictionary<string, byte[]?> anchors,
        bool owesBinaries,
        SyncLocalRowChangeLog? changes,
        TrackedSyncRefresh? refresh,
        Dictionary<(string Table, string Key), TrackedSyncDiscard> discards
    )
    {
        /// <summary>The discards of each table the server held when the transaction before the first chunk ran, by table name.</summary>
        private readonly Dictionary<string, HashSet<string>> _discardsTheServerHad = new(StringComparer.Ordinal);

        /// <summary>
        /// The plan of one table for the transaction before the first chunk: its server keys (the delete propagation),
        /// and for a refresh what it does to the whole table and its discards, settling those the server no longer holds.
        /// </summary>
        public TrackedSyncPlan DeletionPlan(ITrackedSyncTable table, IReadOnlySet<string>? serverKeys)
        {
            var tableDiscards = DiscardsOf(table, keyText => true, keyText => null);

            if (serverKeys is not null)
            {
                _discardsTheServerHad[table.TableName] = tableDiscards
                    .Keys.Where(serverKeys.Contains)
                    .ToHashSet(StringComparer.Ordinal);
            }

            return new TrackedSyncPlan(table, [], serverKeys, null)
            {
                Refresh = refresh,
                Discards = tableDiscards,
                KeepsDiscardsTheServerHas = true,
            };
        }

        /// <summary>The discards of a table whose key text the filter takes, each with the server row the lookup gives.</summary>
        private Dictionary<string, TrackedSyncPlanDiscard> DiscardsOf(
            ITrackedSyncTable table,
            Func<string, bool> takes,
            Func<string, EntityBaseCore?> server
        )
        {
            var found = new Dictionary<string, TrackedSyncPlanDiscard>(StringComparer.Ordinal);

            foreach (var ((tableName, keyText), discard) in discards)
            {
                if (string.Equals(tableName, table.TableName, StringComparison.Ordinal) && takes(keyText))
                {
                    found[keyText] = new TrackedSyncPlanDiscard(discard.Key, discard.Sequence, server(keyText));
                }
            }

            return found;
        }
        /// <summary>Each table's progress, by table name.</summary>
        private readonly Dictionary<string, TableProgress> _progress = new(StringComparer.Ordinal);

        /// <summary>The tables in the order they were first given (the run's order).</summary>
        private readonly List<TableProgress> _order = [];

        /// <summary>The local rows the applies changed on their own, in order.</summary>
        private readonly List<SyncLocalRowChange> _changes = [];

        /// <summary>The rows deleted and written in each table by every apply so far.</summary>
        private readonly Dictionary<string, (int Deleted, int Written)> _perTable = new(StringComparer.Ordinal);

        private int _downloaded;
        private int _deletedLocally;
        private int _discarded;

        /// <summary>
        /// Runs the delete propagation of every table in one transaction (no row is written). The resume points do not move,
        /// except that a refresh sets them back to nothing fetched.
        /// </summary>
        public async Task ApplyDeletionsAsync(List<TrackedSyncPlan> plans, CancellationToken cancellationToken) =>
            Take(
                await engine
                    .ApplyAsync(plans, owesBinaries, advanceAnchors: refresh is not null, cancellationToken)
                    .ConfigureAwait(false)
            );

        /// <summary>Adds fetched rows of a table, applying a chunk each time the table's buffer is full.</summary>
        public async Task AddAsync(
            ITrackedSyncTable table,
            IReadOnlyList<EntityBaseCore> rows,
            CancellationToken cancellationToken
        )
        {
            var progress = ProgressOf(table);

            foreach (var row in rows)
            {
                progress.Buffer.Add(new CarriedRow(row, progress.LastVersion));
                progress.LastVersion = table.VersionOf(row);
                progress.Fetched.Add(table.KeyText(table.KeyOf(row)));

                if (progress.Buffer.Count >= engine.ChunkSize)
                {
                    await FlushAsync(progress, cancellationToken).ConfigureAwait(false);
                }
            }
        }

        /// <summary>Applies what is left in the table's buffer once its rows are all fetched (a chunk never spans tables).</summary>
        public Task FinishTableAsync(ITrackedSyncTable table, CancellationToken cancellationToken) =>
            FlushAsync(ProgressOf(table), cancellationToken);

        /// <summary>
        /// Applies the carried rows of every table in one transaction (with a refresh's discards no chunk brought), and
        /// returns what the whole download did.
        /// </summary>
        public async Task<TrackedSyncDownload> FinishAsync(CancellationToken cancellationToken)
        {
            var plans = new List<TrackedSyncPlan>();

            foreach (var progress in _order)
            {
                var table = progress.Table;
                var carriedKeys = progress
                    .Carried.Select(carried => table.KeyText(table.KeyOf(carried.Row)))
                    .ToHashSet(StringComparer.Ordinal);
                var serverHad = _discardsTheServerHad.GetValueOrDefault(table.TableName);

                // A carried row being discarded takes its fetched row; a discard the server held but no chunk brought only
                // loses its change (and, in a refresh that gives the unbounded binary columns up, those columns)
                var tableDiscards = DiscardsOf(
                    table,
                    keyText =>
                        carriedKeys.Contains(keyText)
                        || serverHad is not null && serverHad.Contains(keyText) && !progress.Fetched.Contains(keyText),
                    keyText =>
                        progress
                            .Carried.FirstOrDefault(carried =>
                                string.Equals(table.KeyText(table.KeyOf(carried.Row)), keyText, StringComparison.Ordinal)
                            )
                            ?.Row
                );

                if (progress.Carried.Count == 0 && tableDiscards.Count == 0)
                {
                    continue;
                }

                plans.Add(
                    new TrackedSyncPlan(
                        table,
                        progress.Carried.Select(carried => carried.Row).ToList(),
                        null,
                        progress.Carried.Count > 0 ? progress.Carried[0].Before : null
                    )
                    {
                        Refresh = refresh,
                        Discards = tableDiscards,
                        ReadsStatesByKey = true,
                        RunsTableWideSteps = false,
                        AdvancesAnchor = progress.Carried.Count > 0,
                        BeforeVersions = progress.Carried.Select(carried => carried.Before).ToList(),
                        ThroughVersion = progress.LastVersion,
                    }
                );
            }

            IReadOnlyList<SyncDownloadTruncation> truncations = [];

            if (plans.Count > 0)
            {
                if (plans.Sum(plan => plan.Rows.Count) is var carriedRows and > 0)
                {
                    engine.CarriedRowsApplied?.Invoke(carriedRows);
                }

                var outcome = await engine
                    .ApplyAsync(plans, owesBinaries, advanceAnchors: true, cancellationToken)
                    .ConfigureAwait(false);
                Take(outcome);
                truncations = outcome.Truncations;
            }

            return new TrackedSyncDownload(_downloaded, _deletedLocally, truncations)
            {
                Discarded = _discarded,
                Changes = _changes,
                PerTable = _perTable,
            };
        }

        /// <summary>Applies the table's buffered rows as one chunk, and carries the rows it held back.</summary>
        private async Task FlushAsync(TableProgress progress, CancellationToken cancellationToken)
        {
            if (progress.Buffer.Count == 0)
            {
                return;
            }

            var table = progress.Table;
            var chunk = progress.Buffer.ToList();
            progress.Buffer.Clear();

            var rowsByKey = chunk.ToDictionary(
                carried => table.KeyText(table.KeyOf(carried.Row)),
                carried => carried.Row,
                StringComparer.Ordinal
            );
            var plan = new TrackedSyncPlan(table, chunk.Select(carried => carried.Row).ToList(), null, chunk[0].Before)
            {
                Refresh = refresh,
                Discards = DiscardsOf(table, rowsByKey.ContainsKey, keyText => rowsByKey[keyText]),
                ReadsStatesByKey = true,
                RunsTableWideSteps = false,
                AdvancesAnchor = progress.Carried.Count == 0,
            };
            var outcome = await engine
                .ApplyAsync([plan], owesBinaries, advanceAnchors: true, cancellationToken)
                .ConfigureAwait(false);
            Take(outcome);

            var held = outcome
                .Truncations.Where(truncation =>
                    string.Equals(truncation.TableName, table.TableName, StringComparison.Ordinal)
                )
                .Select(truncation => truncation.PendingKeyText)
                .ToHashSet(StringComparer.Ordinal);

            foreach (var carried in chunk)
            {
                if (held.Contains(table.KeyText(table.KeyOf(carried.Row))))
                {
                    progress.Carried.Add(carried);
                }
            }
        }

        /// <summary>Adds what one committed apply did to the totals, and notes the rows it changed on its own.</summary>
        private void Take(TrackedSyncDownload outcome)
        {
            _downloaded += outcome.Downloaded;
            _deletedLocally += outcome.DeletedLocally;
            _discarded += outcome.Discarded;

            foreach (var change in outcome.Changes)
            {
                _changes.Add(change);
                changes?.Add(change.TableName, change.KeyText, change.Reason);
            }

            foreach (var (tableName, (deleted, written)) in outcome.PerTable)
            {
                var sum = _perTable.GetValueOrDefault(tableName);
                _perTable[tableName] = (sum.Deleted + deleted, sum.Written + written);
            }
        }

        /// <summary>The progress of a table, created the first time the table is given.</summary>
        private TableProgress ProgressOf(ITrackedSyncTable table)
        {
            if (!_progress.TryGetValue(table.TableName, out var progress))
            {
                progress = new TableProgress(table)
                {
                    LastVersion =
                        table.IsVersionless || refresh is not null ? null : anchors.GetValueOrDefault(table.TableName),
                };
                _progress[table.TableName] = progress;
                _order.Add(progress);
            }

            return progress;
        }

        /// <summary>One table's rows waiting for their chunk, the rows it carries, and the version last fetched.</summary>
        private sealed class TableProgress(ITrackedSyncTable table)
        {
            /// <summary>The table.</summary>
            public ITrackedSyncTable Table { get; } = table;

            /// <summary>The fetched rows waiting for their chunk, in fetch order.</summary>
            public List<CarriedRow> Buffer { get; } = [];

            /// <summary>The rows the chunks held back, in fetch order.</summary>
            public List<CarriedRow> Carried { get; } = [];

            /// <summary>The key texts of every row fetched for the table.</summary>
            public HashSet<string> Fetched { get; } = new(StringComparer.Ordinal);

            /// <summary>The version of the last fetched row (the resume point the fetch started from before any row).</summary>
            public byte[]? LastVersion { get; set; }
        }

        /// <summary>A fetched row and the version just before it in fetch order.</summary>
        /// <param name="Row">The server row.</param>
        /// <param name="Before">The version of the row fetched just before it in its table (the resume point the fetch started from for the first row).</param>
        private sealed record CarriedRow(EntityBaseCore Row, byte[]? Before);
    }

    /// <summary>What one apply attempt has done so far, on its connection.</summary>
    private sealed class ApplyAttempt(
        DbConnection connection,
        Dictionary<(string Table, string Key), string?> held,
        HashSet<(string Table, string Key)> keep
    )
    {
        /// <summary>The connection of the attempt (inside its transaction).</summary>
        public DbConnection Connection { get; } = connection;

        /// <summary>The rows held back for a missing parent (kept across attempts).</summary>
        public Dictionary<(string Table, string Key), string?> Held { get; } = held;

        /// <summary>The parents the delete propagation must not delete (kept across attempts).</summary>
        public HashSet<(string Table, string Key)> Keep { get; } = keep;

        /// <summary>The rows held back in this attempt for a unique value, or for an unsent change under a key the server does not know.</summary>
        public HashSet<(string Table, string Key)> UniqueHeld { get; } = [];

        /// <summary>The rows this attempt wrote.</summary>
        public HashSet<(string Table, string Key)> Written { get; } = [];

        /// <summary>The rows this attempt deleted.</summary>
        public HashSet<(string Table, string Key)> Deleted { get; } = [];

        /// <summary>The row states of each table, by table name and key text.</summary>
        public Dictionary<string, Dictionary<string, TrackedSyncRowState>> States { get; } =
            new(StringComparer.Ordinal);

        /// <summary>The number of server rows written.</summary>
        public int Downloaded { get; set; }

        /// <summary>The number of local rows deleted by the delete propagation.</summary>
        public int DeletedLocally { get; set; }

        /// <summary>The raw keys of each table's rows read so far, by key text.</summary>
        private readonly Dictionary<string, Dictionary<string, object>> _rawKeys = new(StringComparer.Ordinal);

        /// <summary>The raw keys of the rows of a plan read by key, by table name and key text (read before every table's keys).</summary>
        private readonly Dictionary<string, Dictionary<string, object>> _knownRawKeys = new(StringComparer.Ordinal);

        /// <summary>Records the raw keys of a plan's rows, read with their row states, so that no write needs every key of the table.</summary>
        public void KnowRawKeys(ITrackedSyncTable table, Dictionary<string, object> rawKeys) =>
            _knownRawKeys[table.TableName] = rawKeys;

        /// <summary>The rows ServerWins discards in this attempt, by table name and key text (still at the change number read).</summary>
        public Dictionary<string, Dictionary<string, TrackedSyncPlanDiscard>> LiveDiscards { get; } =
            new(StringComparer.Ordinal);

        /// <summary>The number of rows whose unsent change ServerWins discarded.</summary>
        public int Discarded { get; private set; }

        /// <summary>The local rows the attempt changed on its own, in the order they were changed.</summary>
        public List<SyncLocalRowChange> Changes { get; } = [];

        /// <summary>Notes a row written.</summary>
        public void Note(ITrackedSyncTable table, TrackedSyncRowWrite write)
        {
            if (!Written.Add((table.TableName, write.KeyText)))
            {
                return;
            }

            if (write.Discard)
            {
                NoteDiscarded(table.TableName, write.KeyText);
            }
            else
            {
                Downloaded++;
            }
        }

        /// <summary>Notes a row whose unsent change ServerWins discarded.</summary>
        public void NoteDiscarded(string tableName, string keyText)
        {
            Changes.Add(new SyncLocalRowChange(tableName, keyText, SyncLocalRowChangeReason.DiscardedByServerWins));
            Discarded++;
        }

        /// <summary>
        /// The key of a row just written, exactly as the table stores it: read through the rowid of an insert, or else
        /// from a read of the table's keys.
        /// </summary>
        public async Task<object> RawKeyAsync(
            ITrackedSyncTable table,
            string keyText,
            bool inserted,
            CancellationToken cancellationToken
        )
        {
            if (inserted)
            {
                await using var last = Connection.CreateCommand();
                last.CommandText =
                    "SELECT "
                    + Identifier(table.LocalKeyColumnName)
                    + " FROM "
                    + QualifiedName(table)
                    + " WHERE rowid = last_insert_rowid()";

                if (await last.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false) is { } rawKey and not DBNull)
                {
                    return rawKey;
                }
            }

            if (
                _knownRawKeys.TryGetValue(table.TableName, out var known)
                && known.TryGetValue(keyText, out var knownRawKey)
            )
            {
                return knownRawKey;
            }

            if (!_rawKeys.TryGetValue(table.TableName, out var keys))
            {
                keys = new Dictionary<string, object>(StringComparer.Ordinal);

                await using var read = Connection.CreateCommand();
                read.CommandText =
                    "SELECT " + Identifier(table.LocalKeyColumnName) + " FROM " + QualifiedName(table);
                await using var reader = await read.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

                while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
                {
                    var rawKey = reader.GetValue(0);
                    keys[table.KeyTextOfRaw(rawKey)] = rawKey;
                }

                _rawKeys[table.TableName] = keys;
            }

            return keys.TryGetValue(keyText, out var found)
                ? found
                : throw new InvalidOperationException(
                    $"The row of '{table.TableName}' with the key '{keyText}' was written but cannot be read back."
                );
        }
    }
}

/// <summary>One table's fetched rows, ready to apply.</summary>
/// <param name="Table">The table.</param>
/// <param name="Rows">The fetched server rows, in fetch order.</param>
/// <param name="ServerKeys">The server's key texts (null when delete propagation is off).</param>
/// <param name="OldAnchor">The resume point the fetch started from.</param>
internal sealed record TrackedSyncPlan(
    ITrackedSyncTable Table,
    IReadOnlyList<EntityBaseCore> Rows,
    IReadOnlySet<string>? ServerKeys,
    byte[]? OldAnchor
)
{
    /// <summary>The rows of the table <see cref="SyncConflictPolicy.ServerWins"/> discards, by key text.</summary>
    public IReadOnlyDictionary<string, TrackedSyncPlanDiscard> Discards { get; init; } =
        new Dictionary<string, TrackedSyncPlanDiscard>(StringComparer.Ordinal);

    /// <summary>The refresh the plan belongs to (null for an ordinary download).</summary>
    public TrackedSyncRefresh? Refresh { get; init; }

    /// <summary>Whether the apply reads the row states of the plan's rows and discards only (by key), rather than every row state of the table.</summary>
    public bool ReadsStatesByKey { get; init; }

    /// <summary>
    /// Whether a refresh's apply does what it does to the whole of the table (forgets the rows neither side holds, gives
    /// the unbounded binary columns up); false for a chunk, whose download did that before its first chunk.
    /// </summary>
    public bool RunsTableWideSteps { get; init; } = true;

    /// <summary>
    /// Whether the apply settles only the discards the server no longer holds (their keys are not in
    /// <see cref="ServerKeys"/>), leaving the others to the chunk that brings their server rows.
    /// </summary>
    public bool KeepsDiscardsTheServerHas { get; init; }

    /// <summary>Whether the apply saves the table's resume point (when the apply moves resume points at all).</summary>
    public bool AdvancesAnchor { get; init; } = true;

    /// <summary>
    /// The version just before each row, in the same order as <see cref="Rows"/> (null: the version of the row before it,
    /// and <see cref="OldAnchor"/> for the first).
    /// </summary>
    public IReadOnlyList<byte[]?>? BeforeVersions { get; init; }

    /// <summary>The version the resume point moves to when no row is held back (null: the version of the last row).</summary>
    public byte[]? ThroughVersion { get; init; }

    /// <summary>The version just before the row at the index (where the resume point stops when that row is held back).</summary>
    /// <param name="index">The row's index in <see cref="Rows"/>.</param>
    public byte[]? VersionBefore(int index) =>
        BeforeVersions is { } before ? before[index]
        : index == 0 ? OldAnchor
        : Table.VersionOf(Rows[index - 1]);
}

/// <summary>How one fetch of a run is applied, once that is decided.</summary>
internal enum TrackedSyncDownloadRoute
{
    /// <summary>Every fetched row is applied in one transaction.</summary>
    Single,

    /// <summary>The fetched rows are applied a chunk at a time.</summary>
    Chunked,

    /// <summary>The fetch went over the download row limit while the run's tables held unsent changes, and is refused.</summary>
    Refused,
}

/// <summary>How a refresh writes the rows it fetched.</summary>
/// <param name="BlankBinaries">Whether the refresh gives the unbounded binary columns up (the rows it writes come in with them empty).</param>
internal sealed record TrackedSyncRefresh(bool BlankBinaries);

/// <summary>An unsent row <see cref="SyncConflictPolicy.ServerWins"/> discards.</summary>
/// <param name="Key">The row's key.</param>
/// <param name="Sequence">The change number read at the start of the run (a row written again since is not discarded).</param>
internal sealed record TrackedSyncDiscard(object Key, long Sequence);

/// <summary>An unsent row <see cref="SyncConflictPolicy.ServerWins"/> discards, with the server's row to put back.</summary>
/// <param name="Key">The row's key.</param>
/// <param name="Sequence">The change number read at the start of the run.</param>
/// <param name="Server">The server's row (null when the server no longer has it).</param>
internal sealed record TrackedSyncPlanDiscard(object Key, long Sequence, EntityBaseCore? Server);

/// <summary>One unsent row queued for the upload.</summary>
/// <param name="Table">The row's table.</param>
/// <param name="Row">The row's state as read.</param>
/// <param name="Key">The row's key.</param>
/// <param name="KeyText">The row's key text.</param>
internal sealed record TrackedSyncQueued(
    ITrackedSyncTable Table,
    TrackedSyncPendingRow Row,
    object Key,
    string KeyText
);

/// <summary>One server row to write locally.</summary>
/// <param name="Row">The server row.</param>
/// <param name="Key">Its key.</param>
/// <param name="KeyText">Its key text.</param>
/// <param name="State">The row state the local database holds for it (null when it holds none).</param>
internal sealed record TrackedSyncRowWrite(EntityBaseCore Row, object Key, string KeyText, TrackedSyncRowState? State)
{
    /// <summary>Whether the write puts the server's row back over a row <see cref="SyncConflictPolicy.ServerWins"/> discards.</summary>
    public bool Discard { get; init; }
}

/// <summary>What a download did.</summary>
/// <param name="Downloaded">The number of server rows written locally.</param>
/// <param name="DeletedLocally">The number of local rows the delete propagation removed.</param>
/// <param name="Truncations">The rows held back, one per row.</param>
internal sealed record TrackedSyncDownload(
    int Downloaded,
    int DeletedLocally,
    IReadOnlyList<SyncDownloadTruncation> Truncations
)
{
    /// <summary>The number of rows whose unsent change <see cref="SyncConflictPolicy.ServerWins"/> discarded.</summary>
    public int Discarded { get; init; }

    /// <summary>The local rows the download changed on its own (the rows ServerWins discarded).</summary>
    public IReadOnlyList<SyncLocalRowChange> Changes { get; init; } = [];

    /// <summary>The rows deleted and written in each table, by table name.</summary>
    public IReadOnlyDictionary<string, (int Deleted, int Written)> PerTable { get; init; } =
        new Dictionary<string, (int Deleted, int Written)>(StringComparer.Ordinal);
}

/// <summary>One foreign key violation of the local database.</summary>
/// <param name="Child">The child row's table and key text (the key is "?" when it cannot be read).</param>
/// <param name="ParentTable">The parent's table.</param>
/// <param name="ForeignKey">The foreign key's number in its table.</param>
/// <param name="Parent">The parent row's table and key text, when the foreign key refers to the parent's primary key.</param>
/// <param name="LookupColumns">The parent's columns the foreign key refers to, when they are not the primary key.</param>
/// <param name="LookupValues">The child row's values for those columns.</param>
/// <param name="ParentDescriptor">The parent's table, when the engine synchronises it.</param>
internal sealed record TrackedSyncViolation(
    (string Table, string Key) Child,
    string ParentTable,
    long ForeignKey,
    (string Table, string Key)? Parent,
    string[]? LookupColumns,
    object?[]? LookupValues,
    ITrackedSyncTable? ParentDescriptor
)
{
    /// <summary>What tells one violation from another across two checks (not the rowid, which a rewrite can change).</summary>
    public (string ChildTable, string ChildKey, string ParentTable, long ForeignKey) Identity =>
        (Child.Table, Child.Key, ParentTable, ForeignKey);
}
{{~ if remote_services || runtime_package_export ~}}

/// <summary>The operation names of the sync-only endpoints (<c>POST {prefix}/{entity}/{operation}</c>).</summary>
/// <remarks>
/// The server maps them and the client posts to them, so both sides read the route from here and cannot drift apart.
/// They are additions to the same endpoint group as the CRUD operations, which is what makes authorization applied to
/// the group (<c>RemoteAccess.RequireAuthorization</c> at mapping time) cover them as well - and it has to: the
/// changed-rows endpoint hands out whole rows and the key endpoint hands out the entire key set of a table.
/// </remarks>
public static class RemoteSyncOperations
{
    /// <summary>Reads the exclusive upper bound for a sync pass (<c>MIN_ACTIVE_ROWVERSION()</c> on SQL Server).</summary>
    public const string Ceiling = "SyncCeiling";

    /// <summary>Reads one ascending batch of rows above an anchor and below a ceiling.</summary>
    public const string Changes = "SyncChanges";

    /// <summary>Reads every primary key the server holds for a table.</summary>
    public const string Keys = "SyncKeys";

    /// <summary>Reads one ascending batch of rows above a primary key (the versionless full scan; mapped only for tables without a version column).</summary>
    public const string Page = "SyncPage";
}

/// <summary>The response of <see cref="RemoteSyncOperations.Ceiling"/>.</summary>
/// <param name="Ceiling">The exclusive upper bound, or null when the server applies none.</param>
public sealed record RemoteSyncCeilingResult(byte[]? Ceiling);

/// <summary>The request of <see cref="RemoteSyncOperations.Changes"/>.</summary>
/// <param name="Anchor">The resume point (null takes everything below the ceiling).</param>
/// <param name="Ceiling">The exclusive upper bound the caller obtained for this pass (null applies none).</param>
/// <param name="BatchSize">The maximum number of rows to return (must be greater than zero).</param>
/// <remarks>
/// The ceiling travels from the client rather than being read again per request, because one pass has to use a single
/// bound: a bound re-read between two tables would let a row committed in between fall into the gap between them. The
/// consequence is that the guarantee behind the derived anchor only holds while the client sends the value
/// <see cref="RemoteSyncOperations.Ceiling"/> returned for the same pass. A ceiling above the server's own lowest
/// active version skips the rows still in flight beneath it permanently - the anchor moves past them and no later pass
/// looks below it again - so the value is not something a caller should invent.
/// </remarks>
public sealed record RemoteSyncChangesRequest(byte[]? Anchor, byte[]? Ceiling, int BatchSize);

/// <summary>The response of <see cref="RemoteSyncOperations.Changes"/>.</summary>
/// <param name="Rows">The changed rows, in ascending version order.</param>
/// <param name="HasMore">Whether asking again from the last row's version can still return something.</param>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record RemoteSyncChangesResult<TEntity>(IReadOnlyList<TEntity> Rows, bool HasMore)
    where TEntity : EntityBaseCore, new();

/// <summary>The response of <see cref="RemoteSyncOperations.Keys"/>.</summary>
/// <param name="Keys">Every primary key the server holds for the table.</param>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record RemoteSyncKeysResult<TKey>(IReadOnlyList<TKey> Keys);

/// <summary>The request of <see cref="RemoteSyncOperations.Page"/> (the response is a <see cref="RemoteSyncChangesResult{TEntity}"/>).</summary>
/// <param name="HasAfterKey">Whether <paramref name="AfterKey"/> carries a cursor (false asks for the first page).</param>
/// <param name="AfterKey">The last key of the previous batch (the exclusive lower bound), meaningful only when <paramref name="HasAfterKey"/> is true.</param>
/// <param name="BatchSize">The maximum number of rows to return (must be greater than zero).</param>
/// <remarks>
/// The cursor travels beside a flag rather than as a nullable value, because the key type is generic: a value-typed
/// key has no null to stand for "from the beginning", and a default value (zero, say) is a legitimate key.
/// </remarks>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record RemoteSyncPageRequest<TKey>(bool HasAfterKey, TKey? AfterKey, int BatchSize);

/// <summary>
/// The differential source for one entity type over HTTP: the sync-only endpoints for reading, and the ordinary remote
/// endpoints for replaying the local changes.
/// </summary>
/// <remarks>
/// <para>
/// It is an <see cref="HttpRemoteRepositoryCore{TEntity, TKey}"/> as well as a source, so <see cref="Writer"/> is the very
/// same client: the reads and the writes of one pass travel over one connection with one configuration, and every
/// failure - a conflict restored as <see cref="SaveConflictException"/>, a body that could not be read, a withheld
/// server message and its correlation id - is classified exactly as it is for any other remote call.
/// </para>
/// <para>
/// Nothing here is stateful. The resume point travels as the anchor in each request and the bound as the ceiling, so a
/// run interrupted at any point resumes by asking again with the anchor the local data now yields; the server keeps no
/// per-client bookkeeping and two clients on the same table do not interfere.
/// </para>
/// <para>
/// The wire format these endpoints speak is not promised to stay compatible across QuickER versions while the tool is
/// at 0.x, and nothing on the wire announces a mismatch, so regenerate the client and the server from the same diagram
/// and deploy them together.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
public sealed class HttpSyncServerSource<TEntity, TKey>
    : HttpRemoteRepositoryCore<TEntity, TKey>,
        ISyncServerSource<TEntity, TKey>,
        ISyncBinaryColumns<TKey>
    where TEntity : EntityBaseCore, new()
{
{{~ else ~}}
public sealed class HttpSyncServerSource<TEntity, TKey>
    : HttpRemoteRepositoryCore<TEntity, TKey>, ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
{{~ end ~}}
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;

    /// <summary>Initializes a new instance with the HTTP client and the table's descriptor (which names the route).</summary>
    public HttpSyncServerSource(
        HttpClient httpClient,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(httpClient, RouteOf(descriptor))
    {
        _descriptor = descriptor;
    }
{{~ else ~}}
    /// <summary>Initializes a new instance with the HTTP client and the table's descriptor (which names the route).</summary>
    public HttpSyncServerSource(
        HttpClient httpClient,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(httpClient, RouteOf(descriptor)) { }
{{~ end ~}}

    /// <summary>Reads the route off the descriptor before the base constructor runs (which is why it is static).</summary>
    private static string RouteOf(SyncTableDescriptor<TEntity, TKey> descriptor)
    {
        ArgumentNullException.ThrowIfNull(descriptor);

        return descriptor.RemoteRouteName;
    }

    /// <inheritdoc />
    /// <remarks>The client itself: the same connection, the same configuration, and the same failure classification.</remarks>
    public IRemoteRepositoryCore<TEntity, TKey> Writer => this;

{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    /// <inheritdoc />
    /// <remarks>
    /// The client itself again, when the table has such columns: they stream over the same binary endpoints the remote
    /// repository uses, so no second connection or configuration is involved.
    /// </remarks>
    public ISyncBinaryColumns<TKey>? BinaryColumns =>
        _descriptor.UnboundedBinaryColumnNames.Count == 0 ? null : this;

    /// <inheritdoc />
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <inheritdoc />
    public Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    ) =>
        DownloadUnboundedBinaryColumnAsync(
            KnownColumn(columnName),
            id,
            destination,
            cancellationToken
        );

    /// <inheritdoc />
    public Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    ) =>
        UploadUnboundedBinaryColumnAsync(
            KnownColumn(columnName),
            id,
            source,
            length,
            cancellationToken
        );

    /// <summary>Refuses a column name the table does not have, rather than asking the server for a route that has none.</summary>
    private string KnownColumn(string columnName) =>
        _descriptor.UnboundedBinaryColumnNames.Contains(columnName)
            ? columnName
            : throw new ArgumentOutOfRangeException(
                nameof(columnName),
                columnName,
                "The column is not an unbounded binary column of this table."
            );
{{~ end ~}}

    /// <inheritdoc />
    public async Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default)
    {
        var result = await InvokeAsync<RemoteSyncCeilingResult>(
            RemoteSyncOperations.Ceiling,
            null,
            cancellationToken
        ).ConfigureAwait(false);

        return result.Ceiling;
    }

    /// <inheritdoc />
    public async Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Changes,
            new RemoteSyncChangesRequest(anchor, ceiling, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }

    /// <inheritdoc />
    public async Task<IReadOnlyList<TKey>> GetAllKeysAsync(
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncKeysResult<TKey>>(
            RemoteSyncOperations.Keys,
            null,
            cancellationToken
        ).ConfigureAwait(false);

        return result.Keys;
    }

    /// <inheritdoc />
    /// <remarks>The server maps the page endpoint only for tables without a version column; nothing asks a versioned table for it.</remarks>
    public async Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Page,
            new RemoteSyncPageRequest<TKey>(false, default, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }

    /// <inheritdoc />
    public async Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Page,
            new RemoteSyncPageRequest<TKey>(true, afterKey, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }
}
{{~ end ~}}
{{~ end ~}}
{{~ if render_sync && emit_schema_dependent ~}}


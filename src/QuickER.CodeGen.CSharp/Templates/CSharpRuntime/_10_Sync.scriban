{{~ if render_sync && emit_shared_infra ~}}

/// <summary>The kind of local change recorded in the sync journal.</summary>
public enum SyncJournalOperation
{
    /// <summary>An insert or an update. The row's current local content is what gets uploaded.</summary>
    Upsert,

    /// <summary>A delete. The key and the mirrored version the row carried when it was deleted are what get uploaded.</summary>
    Delete,
}

/// <summary>Why a journal entry could not be replayed against the server.</summary>
public enum SyncConflictReason
{
    /// <summary>Someone else changed the server row after the local copy was taken.</summary>
    ModifiedOnServer,

    /// <summary>The server row the local change was meant to update no longer exists.</summary>
    MissingOnServer,

    /// <summary>The row was created locally, but a row with the same key already exists on the server.</summary>
    DuplicateOnServer,

    /// <summary>The server refused the row because a row it refers to is no longer there.</summary>
    /// <remarks>
    /// Reported when writing the row to the server failed and a parent the local row points at turned out to be gone
    /// from the server - deleted there while the row was being edited here. Neither policy brings the parent back:
    /// <see cref="SyncConflictPolicy.LocalWins"/> makes the local change win, not the local view of rows this device did
    /// not change. Running with <see cref="SyncConflictPolicy.ServerWins"/> (in either mode), pointing the row at another
    /// parent, or editing the parent locally (which records a change of its own) settles it.
    /// </remarks>
    ParentMissingOnServer,

    /// <summary>The server refused to delete the row, which it still holds and which other tables refer to.</summary>
    /// <remarks>
    /// Reported when deleting the row on the server failed while the server still holds it and some table of the diagram
    /// refers to its table - typically because another device has added a row that points at it. The cause itself is
    /// not looked up, so a passing failure of another kind can be reported this way too; the entry stays in the journal
    /// either way and the next run tries again. Running with <see cref="SyncConflictPolicy.ServerWins"/> (in either mode)
    /// brings the row back, together with whatever now points at it.
    /// </remarks>
    DeleteRefusedOnServer,

    /// <summary>The server refused the row because another row there holds one of its unique values.</summary>
    /// <remarks>
    /// Reported when writing the row to the server failed and the server's uniqueness check, asked with the local row,
    /// finds another row holding the value - typically another device took it in the meantime, or the row this device
    /// deleted to free it is still there because the delete did not go through. Neither policy takes the value from
    /// the other row: <see cref="SyncConflictPolicy.LocalWins"/> makes the local change win, not the local view of rows
    /// this device did not change. Changing the value, or running with <see cref="SyncConflictPolicy.ServerWins"/> (in
    /// either mode), settles it.
    /// </remarks>
    UniqueValueTakenOnServer,
}

/// <summary>How the engine treats a local change that collides with the server.</summary>
public enum SyncConflictPolicy
{
    /// <summary>Leaves the entry in the journal and reports it (the default: nothing is resolved silently).</summary>
    Collect,

    /// <summary>Discards the local change and makes the row match the server's state: the server's row is read back over the local one when the server has the key, and delete propagation removes the row when it does not (a local insert the server never received).</summary>
    /// <remarks>
    /// A <see cref="SyncMode.Versioned"/> run discards every local change of the tables it covers. A
    /// <see cref="SyncMode.LastWriteWins"/> run uploads as it always does and discards only the changes the server
    /// refuses (<see cref="SyncConflictReason.ParentMissingOnServer"/>,
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>, <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>),
    /// which are not reported as conflicts then. That is the one way to settle such a change to a table without a version
    /// column, which no versioned run reaches.
    /// </remarks>
    ServerWins,

    /// <summary>Resends the local change with <see cref="ConcurrencyMode.ForceOverwrite"/>, overwriting the server row - and inserting it again when the server has no such row, so a row deleted on the server is resurrected by a local edit.</summary>
    LocalWins,
}

/// <summary>One local change that could not be replayed against the server.</summary>
/// <param name="TableName">The table the row belongs to.</param>
/// <param name="KeyText">The primary key, in the same text form the journal stores.</param>
/// <param name="Operation">The local operation that was being replayed.</param>
/// <param name="Reason">Why the replay did not go through.</param>
/// <param name="LocalEntity">The local row as it stands (null for a delete, whose row is already gone locally).</param>
/// <param name="ServerEntity">The server row as it stands (null when the server has no such row).</param>
public sealed record SyncConflict(
    string TableName,
    string KeyText,
    SyncJournalOperation Operation,
    SyncConflictReason Reason,
    object? LocalEntity,
    object? ServerEntity
);

/// <summary>What replaying one journal entry did.</summary>
/// <param name="Sent">Whether the change actually reached the server.</param>
/// <param name="Conflict">The disagreement that stopped it, or null when nothing stood in the way.</param>
/// <remarks>
/// "Not sent" and "conflicted" are different outcomes and must not be folded together: an entry whose row no longer
/// exists locally has nothing left to send and is simply dropped, which is neither an upload nor a conflict.
/// </remarks>
public readonly record struct SyncUploadOutcome(bool Sent, SyncConflict? Conflict)
{
    /// <summary>The version the server stamped the row with, or null when there is none to report.</summary>
    /// <remarks>
    /// The run remembers this stamp for the download that follows, which recognises a row carrying it as the echo of
    /// what this very run sent. Null for a delete, for a discard, for a conflict, and for a table without a version
    /// column.
    /// </remarks>
    public byte[]? ServerRowVersion { get; init; }

    /// <summary>The change reached the server; the journal entry is settled.</summary>
    public static SyncUploadOutcome Uploaded { get; } = new(true, null);

    /// <summary>There was nothing to send (a stale intent); the journal entry is settled without a round trip.</summary>
    public static SyncUploadOutcome Discarded { get; } = new(false, null);

    /// <summary>The server disagreed; the journal entry stays put.</summary>
    public static SyncUploadOutcome Conflicted(SyncConflict conflict) => new(false, conflict);

    /// <summary>The change reached the server, which stamped the row with the given version.</summary>
    /// <param name="serverRowVersion">The version the server now holds for the row, or null when it holds none.</param>
    public static SyncUploadOutcome UploadedWith(byte[]? serverRowVersion) =>
        new(true, null) { ServerRowVersion = serverRowVersion };
}

/// <summary>How one run treats versions and conflicts.</summary>
public enum SyncMode
{
    /// <summary>
    /// Versioned differential sync (the default): tables with a version column sync incrementally under version
    /// guards, and tables without one take no part in the run. This is the pre-existing behaviour, unchanged.
    /// </summary>
    Versioned,

    /// <summary>
    /// Last-write-wins: every table takes part. Uploads overwrite the server unconditionally - an update that finds
    /// no row inserts it, a delete needs no version - so nothing is reported as a conflict except a write the server
    /// refuses (<see cref="SyncConflictReason.ParentMissingOnServer"/>,
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>, <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>),
    /// and <see cref="SyncOptions.ConflictPolicy"/> is ignored except that <see cref="SyncConflictPolicy.ServerWins"/>
    /// settles those three. Tables without a version column download as a full
    /// key-ordered scan on every run; tables with one still download incrementally, because the result is the same
    /// and the transfer is smaller. The winner is whoever <i>uploads</i> last, not whoever edited last, and a lost
    /// update is neither detected nor reported - that is the trade this mode names.
    /// </summary>
    LastWriteWins,
}

/// <summary>Knobs for one sync run.</summary>
public sealed class SyncOptions
{
    /// <summary>How versions and conflicts are treated in this run (default <see cref="SyncMode.Versioned"/>).</summary>
    public SyncMode Mode { get; init; } = SyncMode.Versioned;

    /// <summary>The entity types this run leaves out entirely (upload, download, and delete propagation alike).</summary>
    /// <remarks>
    /// This is a per-run scope, not a way to keep a table local: the journaling decorators keep recording the
    /// excluded tables' writes, and the next run that includes them replays what accumulated. A table that should
    /// never sync is excluded where the engine is put together instead (the <c>excludeFromSync</c> argument of
    /// <c>AddGeneratedSyncEngine</c>), which also stops the recording. A type the engine does not synchronise -
    /// including one excluded at construction - is rejected with <see cref="ArgumentException"/> rather than
    /// silently skipped.
    /// </remarks>
    public IReadOnlyCollection<Type> ExcludedEntityTypes { get; init; } = [];

    /// <summary>How many rows one download batch fetches and applies in a single local transaction (default 500).</summary>
    public int DownloadBatchSize { get; init; } = 500;

    /// <summary>Whether to delete local rows whose key no longer exists on the server (default true).</summary>
    /// <remarks>
    /// <para>
    /// The check compares the full key set of each table, which costs one key-only pass over the server table. Turn it
    /// off (and run it on a slower schedule) when the tables are large enough for that pass to matter.
    /// </para>
    /// <para>
    /// A key the journal still holds an unsent entry for is spared, so a local edit awaiting upload - including one this
    /// run reported as a conflict - is not removed underneath the caller. That protection reaches exactly as far as the
    /// journal does: <b>a row written into a synchronised table without going through the generated repositories - raw
    /// SQL above all - has no entry, and while this is on it is deleted on the next run</b>, because from the key set's
    /// point of view it is a row the server does not have. Rows the local database is meant to keep to itself belong in
    /// a table that is not synchronised (one excluded where the engine is put together - the <c>excludeFromSync</c>
    /// argument of <c>AddGeneratedSyncEngine</c>).
    /// </para>
    /// </remarks>
    public bool PropagateDeletes { get; init; } = true;

    /// <summary>How a local change that collides with the server is treated (default <see cref="SyncConflictPolicy.Collect"/>).</summary>
    public SyncConflictPolicy ConflictPolicy { get; init; } = SyncConflictPolicy.Collect;

    /// <summary>Whether to carry the unbounded binary columns the row transfer leaves out (default false).</summary>
    /// <remarks>
    /// <para>
    /// Only tables generated with the unbounded binary columns excluded have any (<c>ISyncTable.UnboundedBinaryColumnNames</c>
    /// names them); for every other table this changes nothing. Those columns are not part of the row a run reads or
    /// writes, so with this off a downloaded row arrives without its blob and an uploaded row is sent without it. What is
    /// already stored on the receiving side stays there - an update never touches an excluded column - but a row that is
    /// new to that side has nothing to keep, and arrives with the column empty.
    /// </para>
    /// <para>
    /// With it on, each such column is copied separately after the row itself has been transferred, streamed through a
    /// temporary file so neither side has to hold the blob in memory. That is one round trip per column per changed row,
    /// which is why it is not the default: a table of large blobs whose rows change often pays for it on every run.
    /// </para>
    /// <para>
    /// That file is created in the operating system's temporary folder (<c>Path.GetTempPath()</c>) and deleted when the
    /// column has been written, so a blob whose contents are sensitive passes through the file system unencrypted for the
    /// duration of its copy - on a machine where that matters, point the temporary folder somewhere it does not.
    /// </para>
    /// </remarks>
    public bool IncludeUnboundedBinary { get; init; }
}

/// <summary>One table whose download stopped before the end of the server's changes.</summary>
/// <remarks>
/// <para>
/// A table stops at a row it cannot apply yet; only that table stops, and the tables after it in foreign-key order go
/// on. A row of a later table whose parent was behind the stopping point brings the parent in from the server first, or
/// stops its own table when the parent cannot be had (see <see cref="SyncParentResolver"/>), so no row goes in without
/// its parent.
/// </para>
/// <para>
/// A row cannot be applied yet when its own key holds an unsent local change, when another local row holds a unique
/// value it needs and cannot be brought up to date, or when it refers to a parent the local database does not have and
/// the run may not bring in: the parent's table is outside the run's scope, the parent's key holds an unsent local
/// delete the run is not discarding, or the server does not have the parent either. The last kind names the parent's
/// table in <see cref="MissingParentTableName"/>.
/// </para>
/// </remarks>
/// <param name="TableName">The table whose download stopped early.</param>
/// <param name="PendingKeyText">The key of the row the download stopped at.</param>
/// <param name="TruncatedByTableName">Always null: a table's stop no longer stops the tables after it. Kept so that code written against it goes on compiling.</param>
public sealed record SyncDownloadTruncation(
    string TableName,
    string? PendingKeyText,
    string? TruncatedByTableName
)
{
    /// <summary>The table of the parent the row the download stopped at refers to and could not have, or null when the row stopped for another reason.</summary>
    public string? MissingParentTableName { get; init; }

    /// <summary>Whether the download stopped because a local save hook skipped the row (its Before returned false).</summary>
    public bool SkippedBySaveHook { get; init; }
}

/// <summary>What one sync run did.</summary>
/// <param name="Uploaded">The number of local changes replayed against the server.</param>
/// <param name="Downloaded">The number of server rows applied locally.</param>
/// <param name="DeletedLocally">The number of local rows removed because the server no longer has that key.</param>
/// <param name="Discarded">The number of journal entries dropped without being sent (a stale intent, or ServerWins).</param>
/// <param name="Conflicts">The local changes that could not be replayed; they stay in the journal.</param>
public sealed record SyncResult(
    int Uploaded,
    int Downloaded,
    int DeletedLocally,
    int Discarded,
    IReadOnlyList<SyncConflict> Conflicts
)
{
    /// <summary>The tables whose download stopped early, empty when every table was drained.</summary>
    /// <remarks>
    /// A run that reports a conflict usually reports a truncation as well: the conflicted row's own table stops at it.
    /// The rows behind the stopping point are still on the server and come down once the entry that stopped them is
    /// settled, which is the caller's to decide and re-run.
    /// </remarks>
    public IReadOnlyList<SyncDownloadTruncation> Truncations { get; init; } = [];

    /// <summary>Whether any local change was left unsent.</summary>
    public bool HasConflicts => Conflicts.Count > 0;

    /// <summary>Whether any table's download stopped early.</summary>
    public bool HasTruncations => Truncations.Count > 0;

    /// <summary>The local rows the run discarded the changes of, or rewrote or removed on its own, empty when it did none of that.</summary>
    /// <remarks>
    /// <para>
    /// A run changes local rows that are not just the server's changes coming down: under
    /// <see cref="SyncConflictPolicy.ServerWins"/> it discards the unsent changes of the rows it settles and puts the
    /// server's content back; it brings a local row up to date when another row of the server needs the unique value it
    /// holds; and a <see cref="SyncConflictPolicy.ServerWins"/> run removes a row it is discarding that the server does
    /// not have before the server's rows come down. Each such row is listed once per reason (see
    /// <see cref="SyncLocalRowChangeReason"/>); the counts in <see cref="Discarded"/> and <see cref="DeletedLocally"/>
    /// include them.
    /// </para>
    /// <para>
    /// Only <see cref="SyncEngine.SyncAsync"/> fills this; <see cref="SyncEngine.UploadAsync"/> and
    /// <see cref="SyncEngine.DownloadAsync"/> called on their own return what they always did. A run that throws hands the
    /// rows it had changed so far on in the exception's <see cref="Exception.Data"/>, under
    /// <see cref="SyncEngine.LocalRowChangesDataKey"/>.
    /// </para>
    /// </remarks>
    public IReadOnlyList<SyncLocalRowChange> LocalRowChanges { get; init; } = [];
}

/// <summary>Why a sync run changed a local row other than by applying the server's change to it.</summary>
public enum SyncLocalRowChangeReason
{
    /// <summary>A <see cref="SyncConflictPolicy.ServerWins"/> run discarded the row's unsent changes and put the server's content back (or left the row for the delete propagation when the server no longer has it).</summary>
    DiscardedByServerWins,

    /// <summary>The row held a unique value a server row coming down needed, and was read again from the server (or removed, when the server no longer has it and nothing local refers to it).</summary>
    ReloadedForUniqueValue,

    /// <summary>A <see cref="SyncConflictPolicy.ServerWins"/> run removed the row, whose changes it was discarding and which the server does not have, before the server's rows came down.</summary>
    RemovedBeforeDownload,
}

/// <summary>One local row a sync run changed other than by applying the server's change to it (see <see cref="SyncResult.LocalRowChanges"/>).</summary>
/// <param name="TableName">The row's table.</param>
/// <param name="KeyText">The row's key in the journal's text form.</param>
/// <param name="Reason">Why the run changed it.</param>
public sealed record SyncLocalRowChange(string TableName, string KeyText, SyncLocalRowChangeReason Reason);

/// <summary>Collects the local rows one run changes on its own, each once per reason.</summary>
internal sealed class SyncLocalRowChangeLog
{
    private readonly List<SyncLocalRowChange> _changes = [];
    private readonly HashSet<SyncLocalRowChange> _seen = [];

    /// <summary>Notes one row.</summary>
    public void Add(string tableName, string keyText, SyncLocalRowChangeReason reason)
    {
        var change = new SyncLocalRowChange(tableName, keyText, reason);

        if (_seen.Add(change))
        {
            _changes.Add(change);
        }
    }

    /// <summary>The rows noted so far, in the order they were noted.</summary>
    public IReadOnlyList<SyncLocalRowChange> ToList() => _changes.ToList();
}

/// <summary>Knobs for one refresh run.</summary>
public sealed class SyncRefreshOptions
{
    /// <summary>Which tables the refresh covers (default <see cref="SyncMode.LastWriteWins"/> = every synchronised table).</summary>
    /// <remarks>
    /// <para>
    /// A refresh has no upload, so the mode is purely a scope here - and unlike an ordinary run, the default takes
    /// everything: a refresh rebuilds the local database as a copy of the server's, and leaving the versionless
    /// tables out of that rebuild would keep stale rows pointing at parents the wipe is about to remove (a foreign
    /// key failure whenever a versionless table references a versioned one). On a diagram whose tables all carry a
    /// version column the two defaults cover the same set, so nothing changes there.
    /// </para>
    /// <para>
    /// <see cref="SyncMode.Versioned"/> narrows the refresh to the versioned tables. While a local row of a versionless
    /// table refers to a row of a versioned table, the run throws <see cref="SyncRefreshScopeException"/> before it
    /// deletes anything, rather than emptying the versioned table underneath that row.
    /// The unsent-changes refusal and the forced discard follow the scope either way: entries of tables outside
    /// this refresh are neither counted nor dropped.
    /// </para>
    /// </remarks>
    public SyncMode Mode { get; init; } = SyncMode.LastWriteWins;

    /// <summary>The entity types this refresh leaves out (neither emptied nor reloaded).</summary>
    /// <remarks>
    /// The same per-run scope as <see cref="SyncOptions.ExcludedEntityTypes"/>, with the same rejection of a type the
    /// engine does not synchronise. Leaving a child table out while one of its local rows refers to a row of a table
    /// the run empties makes the run throw <see cref="SyncRefreshScopeException"/> before it deletes anything. Leaving
    /// a parent table out while reloading its children can break a foreign key mid-run; the scope is the caller's to
    /// choose soundly there.
    /// </remarks>
    public IReadOnlyCollection<Type> ExcludedEntityTypes { get; init; } = [];

    /// <summary>How many rows one batch fetches from the server and writes locally (default 2000).</summary>
    /// <remarks>
    /// <para>
    /// Each batch is one local transaction, and on a local database that commit costs more than the inserts it commits.
    /// The default is therefore several times the one an ordinary run downloads with: a refresh writes whole tables and
    /// gains most of its speed here, while a run interrupted part way is repaired by running it again, so the finer
    /// resume granularity a small batch buys is worth less.
    /// </para>
    /// <para>
    /// The cost of raising it is memory - a batch is held in full - and, when the server is reached over HTTP, the size
    /// of one response body. A table with large binary columns is the case that wants a smaller value than the default,
    /// not a larger one.
    /// </para>
    /// </remarks>
    public int BatchSize { get; init; } = 2000;

    /// <summary>Whether to discard the unsent local changes instead of refusing to run (default false).</summary>
    /// <remarks>
    /// A refresh replaces the local rows wholesale, so an offline edit that has not reached the server yet goes with
    /// them. Leaving this off makes the run throw <see cref="SyncPendingChangesException"/> before it touches
    /// anything, which leaves the caller free to send those changes first - an ordinary
    /// <see cref="SyncEngine.SyncAsync"/> is what sends them - and refresh afterwards. Turning it on says the loss is
    /// intended.
    /// </remarks>
    public bool Force { get; init; }

    /// <summary>Whether to reload the unbounded binary columns as well (default false).</summary>
    /// <remarks>
    /// A refresh deletes the local rows, and an excluded column goes with the row that held it. Turning this on copies
    /// each such column back down after its row has been written, which makes the rebuilt local database a complete copy
    /// at the cost of one round trip per column per row. Leaving it off means the reloaded rows carry no blobs at all -
    /// which is why a table that has such columns refuses to be refreshed until one of this and
    /// <see cref="DiscardLocalUnboundedBinaries"/> says which of the two was meant.
    /// </remarks>
    public bool IncludeUnboundedBinary { get; init; }

    /// <summary>Whether to accept losing the local unbounded binary columns instead of refusing to run (default false).</summary>
    /// <remarks>
    /// This is the other answer to the same question <see cref="IncludeUnboundedBinary"/> answers, for the case where the
    /// blobs are not worth transferring - a local cache of thumbnails that can be rebuilt, say. It says the loss is
    /// intended; it does not make the rows arrive with their blobs. Setting both is not a contradiction, because
    /// carrying the columns means nothing is lost for the flag to permit.
    /// </remarks>
    public bool DiscardLocalUnboundedBinaries { get; init; }
}

/// <summary>The unbounded binary columns one table would lose in a refresh.</summary>
/// <param name="TableName">The table.</param>
/// <param name="ColumnNames">The columns the ordinary row transfer leaves out.</param>
public sealed record SyncUnboundedBinaryColumns(
    string TableName,
    IReadOnlyList<string> ColumnNames
);

/// <summary>Thrown when a refresh would drop local blobs without having been told which of the two outcomes was meant.</summary>
/// <remarks>
/// The run throws before it deletes anything. Set <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> to reload the
/// columns with the rows, or <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> to say the loss is intended.
/// </remarks>
public sealed class SyncUnboundedBinaryLossException : InvalidOperationException
{
    /// <summary>Creates the exception from the per-table breakdown of the columns at stake.</summary>
    /// <param name="columns">The unbounded binary columns, grouped by table.</param>
    public SyncUnboundedBinaryLossException(IReadOnlyList<SyncUnboundedBinaryColumns> columns)
        : base(BuildMessage(columns))
    {
        ArgumentNullException.ThrowIfNull(columns);
        Columns = columns;
    }

    /// <summary>The unbounded binary columns the refresh would have dropped, grouped by table.</summary>
    public IReadOnlyList<SyncUnboundedBinaryColumns> Columns { get; }

    /// <summary>Builds the message, which names the columns so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncUnboundedBinaryColumns> columns)
    {
        ArgumentNullException.ThrowIfNull(columns);
        var breakdown = string.Join(
            ", ",
            columns.Select(table =>
                $"{table.TableName}: {string.Join('/', table.ColumnNames)}"
            )
        );

        return "A refresh replaces the local rows, and the unbounded binary columns of these tables go with them "
            + $"({breakdown}). Set SyncRefreshOptions.IncludeUnboundedBinary to reload them as well, or "
            + "SyncRefreshOptions.DiscardLocalUnboundedBinaries to say the loss is intended.";
    }
}

/// <summary>How many unsent local changes one table has.</summary>
/// <param name="TableName">The table the changes belong to.</param>
/// <param name="Count">The number of journal entries, which counts edits rather than rows: a row edited twice offline has two.</param>
public sealed record SyncPendingChange(string TableName, int Count);

/// <summary>Thrown when a refresh is asked for while the journal still holds unsent local changes.</summary>
/// <remarks>
/// The run throws before it deletes anything, so the local database is exactly as it was and the changes are still
/// there to be uploaded.
/// </remarks>
public sealed class SyncPendingChangesException : InvalidOperationException
{
    /// <summary>Creates the exception from the per-table breakdown of what the refresh would have discarded.</summary>
    /// <param name="pendingChanges">The unsent local changes, grouped by table.</param>
    public SyncPendingChangesException(IReadOnlyList<SyncPendingChange> pendingChanges)
        : base(BuildMessage(pendingChanges))
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        PendingChanges = pendingChanges;
        PendingCount = pendingChanges.Sum(change => change.Count);
    }

    /// <summary>The unsent local changes the refresh would have discarded, grouped by table.</summary>
    public IReadOnlyList<SyncPendingChange> PendingChanges { get; }

    /// <summary>The total number of unsent local changes.</summary>
    public int PendingCount { get; }

    /// <summary>Builds the message, which names the tables so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncPendingChange> pendingChanges)
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        var breakdown = string.Join(
            ", ",
            pendingChanges.Select(change => $"{change.TableName}: {change.Count}")
        );

        return $"A refresh would discard {pendingChanges.Sum(change => change.Count)} unsent local "
            + $"change(s) ({breakdown}). Upload them with SyncAsync first, or set "
            + "SyncRefreshOptions.Force to discard them.";
    }
}

/// <summary>One table outside a refresh whose local rows refer to a table the refresh rebuilds.</summary>
/// <param name="ReferencingTableName">The table outside the refresh that holds the referring rows.</param>
/// <param name="ReferencedTableName">The table the refresh would empty, which those rows refer to.</param>
public sealed record SyncRefreshScopeReference(string ReferencingTableName, string ReferencedTableName);

/// <summary>Thrown when a refresh would empty a table that rows of a table outside the refresh refer to.</summary>
/// <remarks>
/// <para>
/// A refresh empties every table it covers before it reloads them. A local row of a table outside the refresh that
/// refers to one of those rows would either go with it, under <c>ON DELETE CASCADE</c>, taking any unsent edit of it
/// along, or make the emptying fail on the local foreign key. The run throws before it reads or deletes anything, so
/// the local database, the journal and the receipts are exactly as they were.
/// </para>
/// <para>
/// Bring the referring table into the refresh (drop it from <see cref="SyncRefreshOptions.ExcludedEntityTypes"/>, or
/// use <see cref="SyncMode.LastWriteWins"/> when it is a table without a version column), or remove the referring rows
/// first. A table that is not synchronised at all - one excluded when the engine was built, or one the diagram has but
/// the engine does not - can only be dealt with the second way.
/// </para>
/// </remarks>
public sealed class SyncRefreshScopeException : InvalidOperationException
{
    /// <summary>Creates the exception from the references that block the refresh.</summary>
    /// <param name="references">The tables outside the refresh whose rows refer to a table it rebuilds.</param>
    public SyncRefreshScopeException(IReadOnlyList<SyncRefreshScopeReference> references)
        : base(BuildMessage(references))
    {
        ArgumentNullException.ThrowIfNull(references);
        References = references;
    }

    /// <summary>The tables outside the refresh whose rows refer to a table it rebuilds.</summary>
    public IReadOnlyList<SyncRefreshScopeReference> References { get; }

    /// <summary>Builds the message, which names the tables so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncRefreshScopeReference> references)
    {
        ArgumentNullException.ThrowIfNull(references);
        var breakdown = string.Join(
            ", ",
            references.Select(reference =>
                $"{reference.ReferencingTableName} -> {reference.ReferencedTableName}"
            )
        );

        return "A refresh empties the tables it covers, and local rows of tables outside it refer to them "
            + $"({breakdown}). Bring the referring tables into the refresh, or remove the referring rows first.";
    }
}

/// <summary>What a refresh did to one table.</summary>
/// <param name="TableName">The table.</param>
/// <param name="Deleted">How many local rows were removed to make room.</param>
/// <param name="Inserted">How many server rows were written in their place.</param>
public sealed record SyncRefreshTableResult(string TableName, int Deleted, int Inserted);

/// <summary>What one refresh run did.</summary>
/// <param name="Tables">The per-table counts, in the order the rows were written (parents first).</param>
/// <param name="DiscardedChanges">The number of journal entries dropped, which is zero unless <see cref="SyncRefreshOptions.Force"/> was set.</param>
/// <param name="Elapsed">How long the whole run took, measured around it rather than accumulated per table.</param>
public sealed record SyncRefreshResult(
    IReadOnlyList<SyncRefreshTableResult> Tables,
    int DiscardedChanges,
    TimeSpan Elapsed
)
{
    /// <summary>The total number of local rows removed.</summary>
    public int Deleted => Tables.Sum(table => table.Deleted);

    /// <summary>The total number of server rows written locally.</summary>
    public int Inserted => Tables.Sum(table => table.Inserted);
}

/// <summary>Marks the writes the sync engine itself performs so the journaling decorators skip them.</summary>
/// <remarks>
/// <para>
/// Applying a downloaded row and cleaning the journal both go through the ordinary local repository, which is wrapped by
/// the journaling decorator. Without this flag every downloaded row would immediately be recorded as a local change and
/// uploaded back on the next run - the same row would bounce between the two databases forever.
/// </para>
/// <para>
/// The flag is <see cref="AsyncLocal{T}"/>, so it follows the async control flow of the sync run - including work the
/// run itself starts, such as a <see cref="System.Threading.Tasks.Task.Run(System.Action)"/> begun inside the scope. It
/// does not reach work posted to a flow that began outside the scope (a worker loop, a channel consumer, a timer), and
/// a fire-and-forget task started inside the scope stays suppressed for as long as it runs. It is a counter rather
/// than a bool so nested scopes restore the outer state.
/// </para>
/// </remarks>
public static class SyncSession
{
    private static readonly AsyncLocal<int> _depth = new();

    /// <summary>Whether the current async flow is inside a sync-engine write.</summary>
    public static bool IsSuppressed => _depth.Value > 0;

    /// <summary>Suppresses journaling until the returned scope is disposed.</summary>
    public static IDisposable Suppress()
    {
        _depth.Value++;
        return new Scope();
    }

    private sealed class Scope : IDisposable
    {
        private bool _disposed;

        public void Dispose()
        {
            if (_disposed)
            {
                return;
            }

            _disposed = true;
            _depth.Value--;
        }
    }
}

/// <summary>Collects the ids of the journal entries one recording step writes, so they can be taken back when the write they describe fails.</summary>
/// <remarks>
/// Set only while the journaling decorator records the intent of one business write (<c>RecordAndWriteAsync</c>):
/// <see cref="SyncJournal.RecordManyAsync"/> then reads back the ids it inserts. A recording made outside that step -
/// a caller writing to the journal directly - is not collected and is left as it is.
/// </remarks>
internal sealed class SyncRecordingScope
{
    private static readonly AsyncLocal<SyncRecordingScope?> _current = new();

    /// <summary>The scope the current async flow records into, or null.</summary>
    internal static SyncRecordingScope? Current => _current.Value;

    /// <summary>The ids of the entries recorded so far, in the order they were written.</summary>
    internal List<long> Ids { get; } = [];

    /// <summary>The entries recorded so far, with their ids.</summary>
    internal List<(long Id, SyncJournalRecord Record)> Recorded { get; } = [];

    /// <summary>Makes this the scope the current async flow records into, until the returned value is disposed.</summary>
    internal IDisposable Begin()
    {
        var previous = _current.Value;
        _current.Value = this;

        return new Restore(previous);
    }

    private sealed class Restore(SyncRecordingScope? previous) : IDisposable
    {
        public void Dispose() => _current.Value = previous;
    }
}

/// <summary>The size every IN clause the sync engine builds is chunked to.</summary>
/// <remarks>
/// A collection parameter is expanded into one bind variable per value, so a single statement is bounded by the
/// database's parameter limit: one run settles every table's journal entries together, and a download batch looks up
/// every key it is about to apply, so a long offline stretch or a large batch size can push either past that limit.
/// Chunking keeps the statement within it whatever the list holds. The size matches the one the dialect engines use
/// for their own IN clauses.
/// </remarks>
internal static class SyncInClause
{
    /// <summary>The maximum number of values one statement binds.</summary>
    internal const int ChunkSize = 500;
}

/// <summary>Compares server versions (unsigned big-endian integers) without knowing which table they belong to.</summary>
internal static class SyncRowVersions
{
    /// <summary>The later of two server versions (null and empty both mean "no version at all").</summary>
    /// <remarks>
    /// A version is an unsigned big-endian integer, so the comparison is the lexicographic one over the significant
    /// bytes, with a longer significant run standing for the larger number. Taking the maximum rather than preferring
    /// one side is what keeps the choice safe in both directions: a receipt already cleared leaves the mirror ahead,
    /// and an echo that has not come down leaves the receipt ahead.
    /// </remarks>
    /// <param name="left">One version, or null.</param>
    /// <param name="right">The other version, or null.</param>
    internal static byte[]? Max(byte[]? left, byte[]? right)
    {
        if (left is not { Length: > 0 })
        {
            return right is { Length: > 0 } ? right : null;
        }

        if (right is not { Length: > 0 })
        {
            return left;
        }

        return CompareRowVersions(left, right) >= 0 ? left : right;
    }

    /// <summary>Compares two non-empty versions as unsigned big-endian integers.</summary>
    private static int CompareRowVersions(byte[] left, byte[] right)
    {
        var leftStart = FirstSignificantByte(left);
        var rightStart = FirstSignificantByte(right);
        var leftLength = left.Length - leftStart;
        var rightLength = right.Length - rightStart;

        if (leftLength != rightLength)
        {
            return leftLength < rightLength ? -1 : 1;
        }

        for (var index = 0; index < leftLength; index++)
        {
            var difference = left[leftStart + index].CompareTo(right[rightStart + index]);

            if (difference != 0)
            {
                return difference;
            }
        }

        return 0;
    }

    /// <summary>The offset of the first non-zero byte (the length itself when every byte is zero).</summary>
    private static int FirstSignificantByte(byte[] value)
    {
        var index = 0;

        while (index < value.Length && value[index] == 0)
        {
            index++;
        }

        return index;
    }
}

/// <summary>
/// The two locks one local database is guarded by: one that serialises the writes into it, and one that serialises the
/// sync runs over it.
/// </summary>
/// <remarks>
/// <para>
/// <b>The write lock is what lets the application keep writing while a run is in flight.</b> The journaling decorators
/// take it for each write they make - the journal entry and the business write together - and the engine takes it for
/// the stretches where it reads what is still unsent and then acts on it: applying one download batch, deleting the rows
/// the server dropped from one table, writing the server's rows over the local ones. Without it a write landing between
/// that read and that action goes unseen - a row created during the download is deleted as one the server does not have,
/// a row edited during it is overwritten by the batch. With it the write waits for at most one such stretch, and then
/// lands where the next read sees it.
/// </para>
/// <para>
/// The local database is SQLite, which takes one writer at a time anyway, so serialising the writes costs next to
/// nothing that the database was not already costing.
/// </para>
/// <para>
/// The locks are kept per raw SQL executor of the local database, not per journal: the journal is registered per scope,
/// so a screen's scope and the sync run's scope each hold their own, while the executor they share is a singleton. A
/// table is therefore guarded across scopes, and not across processes - a second process writing the same database file
/// is not something these locks can see.
/// </para>
/// <para>
/// Both locks are re-entrant along one async flow. A write the engine makes on its own behalf runs suppressed and takes
/// no lock at all; a write made while the same flow already holds the lock - a save hook writing to another synchronised
/// table, say - goes straight through rather than waiting for itself. The mark that says "this flow holds the lock" is
/// a lease that is spent when the lock is released, so work a flow started and left running cannot ride on a lock that
/// has since been given back.
/// </para>
/// </remarks>
internal sealed class SyncLocalGate
{
    /// <summary>The gates, one per local raw SQL executor (held weakly, so a discarded executor takes its gate with it).</summary>
    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<
        ISqlExecutor,
        SyncLocalGate
    > Gates = new();

    /// <summary>The write lease the current async flow holds, if any.</summary>
    private static readonly AsyncLocal<Lease?> WriteLease = new();

    /// <summary>The run lease the current async flow holds, if any.</summary>
    private static readonly AsyncLocal<Lease?> RunLease = new();

    private readonly SemaphoreSlim _write = new(1, 1);
    private readonly SemaphoreSlim _run = new(1, 1);

    /// <summary>Gets the gate of the local database the given executor writes to.</summary>
    /// <param name="localSqlExecutor">The raw SQL executor of the local database.</param>
    internal static SyncLocalGate For(ISqlExecutor localSqlExecutor) =>
        Gates.GetValue(localSqlExecutor, static _ => new SyncLocalGate());

    /// <summary>Runs the body while holding the write lock (straight through when this flow already holds it).</summary>
    internal Task<T> WriteExclusiveAsync<T>(Func<Task<T>> body, CancellationToken cancellationToken) =>
        EnterAsync(_write, WriteLease, body, cancellationToken);

    /// <summary>Runs the body while holding the run lock (straight through when this flow already holds it).</summary>
    /// <remarks>
    /// A run started from a flow that holds the write lock but not the run lock - a save hook inside a journaled
    /// write - is refused at once. The run would take the run lock and then wait for the write lock its own caller
    /// holds, and while another run is in flight that one holds the run lock and waits for the same write lock: two
    /// flows each waiting on the other, which no timeout ever ends. Refusing it whether or not another run happens to
    /// be in flight makes the mistake show the same way every time.
    /// </remarks>
    internal Task<T> RunExclusiveAsync<T>(Func<Task<T>> body, CancellationToken cancellationToken)
    {
        if (Holds(WriteLease) && !Holds(RunLease))
        {
            return Task.FromException<T>(
                new InvalidOperationException(
                    "A sync run cannot be started from inside a write to the local database it synchronises - a save "
                    + "hook of a journaled repository, for example. The write holds the lock the run needs to apply "
                    + "its batches; start the run after the write has returned."
                )
            );
        }

        return EnterAsync(_run, RunLease, body, cancellationToken);
    }

    /// <summary>Whether the current flow holds this gate's lock of the given kind.</summary>
    private bool Holds(AsyncLocal<Lease?> slot) =>
        slot.Value is { Released: false } held && ReferenceEquals(held.Gate, this);

    /// <summary>Takes the lock, marks the flow as holding it, runs the body, and gives the lock back.</summary>
    /// <remarks>
    /// The mark is set inside this method on purpose: an async method's changes to an <see cref="AsyncLocal{T}"/> do not
    /// flow back to its caller, so the body - which runs inside - is the only place the mark is seen, and it is gone again
    /// for the caller once this returns.
    /// </remarks>
    private async Task<T> EnterAsync<T>(
        SemaphoreSlim semaphore,
        AsyncLocal<Lease?> slot,
        Func<Task<T>> body,
        CancellationToken cancellationToken
    )
    {
        if (Holds(slot))
        {
            return await body().ConfigureAwait(false);
        }

        await semaphore.WaitAsync(cancellationToken).ConfigureAwait(false);
        var lease = new Lease(this);

        try
        {
            slot.Value = lease;

            return await body().ConfigureAwait(false);
        }
        finally
        {
            lease.Released = true;
            semaphore.Release();
        }
    }

    /// <summary>The mark that one flow holds one gate's lock, spent when the lock is given back.</summary>
    private sealed class Lease(SyncLocalGate gate)
    {
        /// <summary>The gate whose lock is held.</summary>
        public SyncLocalGate Gate { get; } = gate;

        /// <summary>Whether the lock has been given back (a spent lease marks nothing).</summary>
        public volatile bool Released;
    }
}

/// <summary>One local change to record in the journal.</summary>
/// <param name="TableName">The table the changed row belongs to.</param>
/// <param name="KeyText">The primary key in the text form the table's descriptor produces.</param>
/// <param name="Operation">Whether the row was written or deleted.</param>
/// <param name="OriginalRowVersion">For a delete, the mirrored server version the row carried; otherwise null.</param>
public sealed record SyncJournalRecord(
    string TableName,
    string KeyText,
    SyncJournalOperation Operation,
    byte[]? OriginalRowVersion
)
{
    /// <summary>The unbounded binary columns the write stored a value in, or null when it stored none.</summary>
    /// <remarks>
    /// An insert stores every such column, a write of one column through its accessor stores that one, and an update
    /// stores none - it never touches them. A run that carries these columns sends only the ones some entry of the row
    /// names, so a blob this device never had is not sent over the server's.
    /// </remarks>
    public IReadOnlyList<string>? UnboundedBinaryColumns { get; init; }

    /// <summary>The entity the entry was made from, when the journaling decorator recorded it (see <see cref="SyncRecordingScope"/>).</summary>
    internal EntityBaseCore? Entity { get; init; }

    /// <summary>The descriptor that formats <see cref="Entity"/>'s key.</summary>
    internal ISyncTableDescriptor? Descriptor { get; init; }

    /// <summary>Whether the entry was recorded for a graph save, whose save hooks may skip the row.</summary>
    internal bool SavedByGraph { get; init; }
}

/// <summary>One row of the journal table, as the lenient projection mapper reads it.</summary>
public sealed class SyncJournalRow
{
    /// <summary>The autoincrement id (also the replay order).</summary>
    public long Id { get; set; }

    /// <summary>The table the change belongs to.</summary>
    public string TableName { get; set; } = string.Empty;

    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;

    /// <summary>The operation name (the <see cref="SyncJournalOperation"/> member name).</summary>
    public string Operation { get; set; } = string.Empty;

    /// <summary>The version the row carried when it was deleted (null for an upsert as recorded).</summary>
    /// <remarks>
    /// In the entry the replay hands a table, an upsert of a row that was deleted and then created again under the same
    /// key carries the version the delete recorded: the server still holds that row, and the new content goes there as
    /// an update guarded by it.
    /// </remarks>
    public byte[]? OriginalRowVersion { get; set; }

    /// <summary>The unbounded binary columns the write stored a value in, comma-separated (null when it stored none).</summary>
    public string? UnboundedBinaryColumns { get; set; }
}

/// <summary>One blob copy a download still owes, as the lenient projection mapper reads it.</summary>
internal sealed class SyncBlobCopyRow
{
    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;

    /// <summary>The unbounded binary column still to be copied.</summary>
    public string ColumnName { get; set; } = string.Empty;
}

/// <summary>One row of the acknowledgement table, as the lenient projection mapper reads it.</summary>
public sealed class SyncAckRow
{
    /// <summary>The primary key in text form.</summary>
    public string KeyText { get; set; } = string.Empty;

    /// <summary>The version the server stamped on the row when it took this device's upload.</summary>
    public byte[] ServerRowVersion { get; set; } = [];
}

/// <summary>
/// The local record of offline edits (<c>quicker_sync_journal</c>) and of the uploads the server has taken
/// (<c>quicker_sync_ack</c>), kept in two shared tables in the local database.
/// </summary>
/// <remarks>
/// <para>
/// The server gets no extra schema at all; only the local database - which the application owns - gets these two
/// tables, created on first use with <c>CREATE TABLE IF NOT EXISTS</c>.
/// </para>
/// <para>
/// <b>The acknowledgement table is a per-row receipt, not a resume point.</b> It holds, for a row this device has
/// uploaded, the version the server stamped on it - which the upload may not write into the mirror, because the
/// mirrored version is what the download derives its resume point from and only the download may move it. Until the
/// row comes back down and the mirror catches up, the receipt is the only record that the local row has already been
/// accepted at a newer version, and the replay of a further edit needs it to guard against the right original.
/// </para>
/// <para>
/// <b>Recording happens before the business write ("journal-first").</b> The generated repositories manage their own
/// connection, so a decorator cannot enlist its INSERT in the transaction of the write it wraps; something has to go
/// first. Recording the <i>intent</i> first is the safe order: if the business write then fails or is rolled back, the
/// journal holds an entry for a row that was never written, and the upload discards it - it re-reads the current local
/// row and finds nothing (an upsert entry), or sends a delete for a key the server does not have (a no-op). The
/// opposite order would lose changes outright: a write that succeeded and a journal entry that never landed is an edit
/// no later run can find. The entry also carries only the key, never a snapshot, so a stale intent still uploads the
/// row's current content.
/// </para>
/// </remarks>
public sealed class SyncJournal
{
    /// <summary>The statement that creates the journal table when it is missing.</summary>
    private const string CreateTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_journal ("
        + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "operation TEXT NOT NULL, "
        + "original_row_version BLOB NULL, "
        + "unbounded_binary_columns TEXT NULL, "
        + "recorded_at TEXT NOT NULL)";

    /// <summary>The statement that creates the acknowledgement table when it is missing.</summary>
    private const string CreateAckTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_ack ("
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "server_row_version BLOB NOT NULL, "
        + "PRIMARY KEY (table_name, key_text))";

    /// <summary>The statement that creates the table of blob copies a download still owes, when it is missing.</summary>
    private const string CreateBlobCopyTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_blob_pending ("
        + "table_name TEXT NOT NULL, "
        + "key_text TEXT NOT NULL, "
        + "column_name TEXT NOT NULL, "
        + "PRIMARY KEY (table_name, key_text, column_name))";

    /// <summary>Reads every pending entry in replay order, aliasing the columns onto the DTO's property names.</summary>
    private const string SelectAllSql =
        "SELECT id AS Id, table_name AS TableName, key_text AS KeyText, operation AS Operation, "
        + "original_row_version AS OriginalRowVersion, unbounded_binary_columns AS UnboundedBinaryColumns "
        + "FROM quicker_sync_journal ORDER BY id";

    /// <summary>Reads one table's acknowledgements, aliasing the columns onto the DTO's property names.</summary>
    private const string SelectAcksSql =
        "SELECT key_text AS KeyText, server_row_version AS ServerRowVersion FROM quicker_sync_ack "
        + "WHERE table_name = @tableName";

    private readonly ISqlExecutor _localSqlExecutor;
    private volatile bool _ensured;

    /// <summary>The local database the journal lives in (the same one the synchronised tables are in).</summary>
    internal ISqlExecutor LocalSqlExecutor => _localSqlExecutor;

    /// <summary>Creates a journal over the local database's raw SQL executor.</summary>
    /// <param name="localSqlExecutor">The raw SQL executor bound to the local (SQLite) database.</param>
    public SyncJournal(ISqlExecutor localSqlExecutor)
    {
        ArgumentNullException.ThrowIfNull(localSqlExecutor);
        _localSqlExecutor = localSqlExecutor;
        Gate = SyncLocalGate.For(localSqlExecutor);
    }

    /// <summary>The locks of the local database this journal lives in (shared by every journal over the same executor).</summary>
    internal SyncLocalGate Gate { get; }

    /// <summary>Creates the two tables when they do not exist yet (idempotent, and only issued once per instance).</summary>
    public async Task EnsureCreatedAsync(CancellationToken cancellationToken = default)
    {
        if (_ensured)
        {
            return;
        }

        await _localSqlExecutor
            .ExecuteSqlAsync(CreateTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(CreateAckTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(CreateBlobCopyTableSql, null, cancellationToken)
            .ConfigureAwait(false);
        _ensured = true;
    }

    /// <summary>
    /// Rewrites the key texts of the given tables - in the journal, the receipts, and the owed blob copies - into the
    /// form the tables write today.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A key text an earlier version wrote can differ from the one the table writes now: a <see cref="DateTime"/> key
    /// used to carry its kind (<c>Z</c>, or the local offset), while the row read back from either database carries
    /// none. Every comparison the engine makes is ordinal, so such an entry would never meet its row - an edit taken for
    /// a row that is gone, a receipt never found. They are rewritten before a run reads them, so a local database kept
    /// from an earlier version goes on working as it is.
    /// </para>
    /// <para>
    /// Two receipts that come to name the same key keep the later version; two owed copies of the same column become
    /// one. It runs at the start of every run, not once per instance: a journal instance can outlive the version of the
    /// generated code that wrote the texts it is now asked to read. Only the tables whose form has changed are read.
    /// </para>
    /// </remarks>
    /// <param name="normalizers">The rewrite of each table whose form has changed, by table name.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task NormalizeKeyTextsAsync(
        IReadOnlyDictionary<string, Func<string, string>> normalizers,
        CancellationToken cancellationToken
    )
    {
        if (normalizers.Count > 0)
        {
            foreach (var entry in await ReadAllAsync(cancellationToken).ConfigureAwait(false))
            {
                if (
                    normalizers.TryGetValue(entry.TableName, out var normalize)
                    && normalize(entry.KeyText) is var keyText
                    && !string.Equals(keyText, entry.KeyText, StringComparison.Ordinal)
                )
                {
                    await _localSqlExecutor
                        .ExecuteSqlAsync(
                            "UPDATE quicker_sync_journal SET key_text = @keyText WHERE id = @id",
                            new { keyText, id = entry.Id },
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }
            }

            foreach (var (tableName, normalize) in normalizers)
            {
                var acks = await ReadAcksAsync(tableName, cancellationToken).ConfigureAwait(false);

                foreach (var (keyText, version) in acks)
                {
                    var normalized = normalize(keyText);

                    if (string.Equals(normalized, keyText, StringComparison.Ordinal))
                    {
                        continue;
                    }

                    var kept = acks.TryGetValue(normalized, out var existing)
                        ? SyncRowVersions.Max(version, existing) ?? version
                        : version;
                    await RecordAckAsync(tableName, normalized, kept, cancellationToken)
                        .ConfigureAwait(false);
                    await RemoveAcksAsync(tableName, [keyText], cancellationToken)
                        .ConfigureAwait(false);
                }

                foreach (var copy in await ReadBlobCopiesAsync(tableName, cancellationToken).ConfigureAwait(false))
                {
                    var normalized = normalize(copy.KeyText);

                    if (string.Equals(normalized, copy.KeyText, StringComparison.Ordinal))
                    {
                        continue;
                    }

                    await RecordBlobCopiesAsync(tableName, [normalized], [copy.ColumnName], cancellationToken)
                        .ConfigureAwait(false);
                    await _localSqlExecutor
                        .ExecuteSqlAsync(
                            "DELETE FROM quicker_sync_blob_pending WHERE table_name = @tableName "
                                + "AND key_text = @keyText AND column_name = @columnName",
                            new
                            {
                                tableName,
                                keyText = copy.KeyText,
                                columnName = copy.ColumnName,
                            },
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>Records one local change (a no-op while the sync engine's own writes are running).</summary>
    /// <param name="tableName">The table the changed row belongs to.</param>
    /// <param name="keyText">The primary key in the text form the table's descriptor produces.</param>
    /// <param name="operation">Whether the row was written or deleted.</param>
    /// <param name="originalRowVersion">For a delete, the mirrored server version the row carried; otherwise null.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task RecordAsync(
        string tableName,
        string keyText,
        SyncJournalOperation operation,
        byte[]? originalRowVersion,
        CancellationToken cancellationToken = default
    ) =>
        RecordManyAsync(
            [new SyncJournalRecord(tableName, keyText, operation, originalRowVersion)],
            cancellationToken
        );

    /// <summary>Records several local changes at once, in the given order (a no-op while the sync engine's own writes are running).</summary>
    /// <remarks>
    /// <para>
    /// What a bulk insert or a graph save records goes through here, so the cost of the journal grows with the number of
    /// statements rather than with the number of rows: the entries are written as multi-row inserts of
    /// <see cref="RowsPerStatement"/> rows each, and every statement is one commit instead of one commit per row.
    /// </para>
    /// <para>
    /// The statements are separate commits, and that is enough. The journal is written before the business write it
    /// describes, so a recording cut short leaves entries for rows the business write never reached - entries the
    /// upload re-reads, finds nothing for, and drops - and never a written row without one. When the journaling
    /// decorator records, it also takes the entries back if the business write then fails (see
    /// <see cref="JournalingRepositoryBase{TEntity, TKey}"/>).
    /// </para>
    /// <para>
    /// The per-row values go in as one collection parameter per column, and the statement names their elements
    /// directly (<c>@tableName0</c>, <c>@tableName1</c>, ...). That relies on the collection binding of the raw SQL
    /// executor - an element <i>i</i> of a collection <c>name</c> is bound as <c>@name</c><i>i</i>, and only a bare
    /// <c>@name</c> in the text is rewritten - so an executor put in front of the local database has to keep that
    /// convention, which the generated one and any wrapper that hands the call on to it do.
    /// </para>
    /// </remarks>
    /// <param name="records">The changes to record, in the order they are to be replayed.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RecordManyAsync(
        IReadOnlyList<SyncJournalRecord> records,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(records);

        if (SyncSession.IsSuppressed || records.Count == 0)
        {
            return;
        }

        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        var recordedAt = DateTime.UtcNow.ToString(
            "o",
            System.Globalization.CultureInfo.InvariantCulture
        );

        // Inside a decorator's recording step the ids are read back, so the entries can be taken back if the write they
        // describe fails (see SyncRecordingScope). The statement is the same one, with the ids returned.
        var scope = SyncRecordingScope.Current;

        foreach (var chunk in records.Chunk(RowsPerStatement))
        {
            var rows = string.Join(
                ", ",
                Enumerable
                    .Range(0, chunk.Length)
                    .Select(index =>
                        $"(@tableName{index}, @keyText{index}, @operation{index}, "
                        + $"@originalRowVersion{index}, @unboundedBinaryColumns{index}, @recordedAt)"
                    )
            );

            var sql =
                "INSERT INTO quicker_sync_journal "
                + "(table_name, key_text, operation, original_row_version, "
                + "unbounded_binary_columns, recorded_at) "
                + "VALUES "
                + rows;
            var parameters = new
            {
                tableName = chunk.Select(record => record.TableName).ToList(),
                keyText = chunk.Select(record => record.KeyText).ToList(),
                operation = chunk.Select(record => record.Operation.ToString()).ToList(),
                originalRowVersion = chunk.Select(record => record.OriginalRowVersion).ToList(),
                unboundedBinaryColumns = chunk
                    .Select(record =>
                        record.UnboundedBinaryColumns is { Count: > 0 } columns
                            ? string.Join(',', columns)
                            : null
                    )
                    .ToList(),
                recordedAt,
            };

            if (scope is null)
            {
                await _localSqlExecutor
                    .ExecuteSqlAsync(sql, parameters, cancellationToken)
                    .ConfigureAwait(false);
            }
            else
            {
                // One statement inserts its rows in the order they are listed, so the ids it hands back, ascending, are
                // the rows' ids in that order.
                var ids = (
                    await _localSqlExecutor
                        .QueryProjectionBySqlAsync<long>(
                            sql + " RETURNING id",
                            parameters,
                            cancellationToken
                        )
                        .ConfigureAwait(false)
                )
                    .Order()
                    .ToList();
                scope.Ids.AddRange(ids);
                scope.Recorded.AddRange(ids.Zip(chunk));
            }
        }
    }

    /// <summary>Records a write of one unbounded binary column inside the transaction of the save that made it.</summary>
    /// <remarks>
    /// What a save hook writes through its context goes through here (see <see cref="SaveHookContextWrites"/>): the entry
    /// is written by the save's own connection, so it commits or rolls back with the save, and a save that does not
    /// commit leaves no entry behind. The table has to exist already, since the save holds the database's write lock and
    /// another connection could not create it.
    /// </remarks>
    /// <param name="context">The context of the save that wrote the column.</param>
    /// <param name="tableName">The table the row belongs to.</param>
    /// <param name="keyText">The row's key text.</param>
    /// <param name="columnName">The property name of the column written.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal Task RecordWithinSaveAsync(
        ISaveHookContext context,
        string tableName,
        string keyText,
        string columnName,
        CancellationToken cancellationToken
    ) =>
        context.ExecuteSqlAsync(
            "INSERT INTO quicker_sync_journal "
                + "(table_name, key_text, operation, original_row_version, "
                + "unbounded_binary_columns, recorded_at) "
                + "VALUES (@tableName, @keyText, @operation, NULL, @unboundedBinaryColumns, @recordedAt)",
            new
            {
                tableName,
                keyText,
                operation = SyncJournalOperation.Upsert.ToString(),
                unboundedBinaryColumns = columnName,
                recordedAt = DateTime.UtcNow.ToString(
                    "o",
                    System.Globalization.CultureInfo.InvariantCulture
                ),
            },
            cancellationToken
        );

    /// <summary>How many entries one multi-row insert of <see cref="RecordManyAsync"/> carries.</summary>
    /// <remarks>
    /// Each entry binds one parameter per column, so the statement stays well inside 999 - the limit an SQLite build
    /// older than 3.32 still applies - whatever the columns grow to.
    /// </remarks>
    private const int RowsPerStatement = 100;

    /// <summary>Reads every pending entry in the order it was recorded.</summary>
    public async Task<IReadOnlyList<SyncJournalRow>> ReadAllAsync(
        CancellationToken cancellationToken = default
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncJournalRow>(SelectAllSql, null, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Removes the given entries (called once the change they describe has reached the server).</summary>
    /// <remarks>The removal is chunked to <see cref="SyncInClause.ChunkSize"/> ids per statement.</remarks>
    public async Task RemoveAsync(
        IReadOnlyList<long> ids,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(ids);

        foreach (var chunk in ids.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_journal WHERE id IN (@ids)",
                    new { ids = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Removes every entry of one table, discarding the unsent local changes it held.</summary>
    /// <remarks>
    /// <para>
    /// This is journal maintenance for a table that is no longer synchronised - one excluded where the engine is put
    /// together after entries had already accumulated. Such entries can never be replayed (no run knows the table),
    /// yet they count as unsent changes and block <see cref="SyncEngine.RefreshAsync"/> for ever. Removing them is
    /// the deliberate statement that those local edits will never reach the server.
    /// </para>
    /// <para>
    /// Do not call it while a sync run is in flight: the run reads the journal once at its start and settles entries
    /// by id, and removing rows underneath it makes the two views disagree.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table whose entries are dropped.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveTableAsync(
        string tableName,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_journal WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes every entry of every table, discarding all unsent local changes.</summary>
    /// <remarks>
    /// The whole-journal counterpart of <see cref="RemoveTableAsync"/>, with the same warnings: it is the journal half
    /// of what <see cref="SyncConflictPolicy.ServerWins"/> does at upload time, done without a run. What it leaves out
    /// is the other half - reading the server's rows back over the local ones - so an edit to a row the server has not
    /// changed since it was mirrored stays where it is, with nothing left to say it is there.
    /// </remarks>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveAllAsync(CancellationToken cancellationToken = default)
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync("DELETE FROM quicker_sync_journal", null, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Records the version the server stamped on a row this device uploaded (one receipt per key, replaced on repeat).</summary>
    /// <remarks>
    /// <para>
    /// Written <i>before</i> the journal entry it settles is removed. Both surviving a crash costs nothing: the next
    /// run replays the same local content with the acknowledged version as its original, and the server takes it
    /// again. The opposite order leaves the row with a mirrored version behind the server's and nothing left to say
    /// so, which is the very state the receipt exists to prevent.
    /// </para>
    /// <para>
    /// The one window nothing can close is between the server accepting the upload and this write: a crash in
    /// between leaves an entry whose change the server already holds, and the next run's version-guarded replay
    /// reports it as a conflict against a row this device itself wrote.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table the row belongs to.</param>
    /// <param name="keyText">The primary key in the text form the table's descriptor produces.</param>
    /// <param name="serverRowVersion">The version the server stamped on the row it accepted.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RecordAckAsync(
        string tableName,
        string keyText,
        byte[] serverRowVersion,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        ArgumentNullException.ThrowIfNull(keyText);
        ArgumentNullException.ThrowIfNull(serverRowVersion);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "INSERT OR REPLACE INTO quicker_sync_ack "
                    + "(table_name, key_text, server_row_version) "
                    + "VALUES (@tableName, @keyText, @serverRowVersion)",
                new
                {
                    tableName,
                    keyText,
                    serverRowVersion,
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Reads every acknowledgement of one table, by the key's journal text form.</summary>
    /// <param name="tableName">The table whose receipts are read.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task<IReadOnlyDictionary<string, byte[]>> ReadAcksAsync(
        string tableName,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        var rows = await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncAckRow>(
                SelectAcksSql,
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
        var byKeyText = new Dictionary<string, byte[]>(StringComparer.Ordinal);

        foreach (var row in rows)
        {
            byKeyText[row.KeyText] = row.ServerRowVersion;
        }

        return byKeyText;
    }

    /// <summary>Removes the acknowledgements of the given keys (the receipt has served its purpose, or has gone stale).</summary>
    /// <remarks>The removal is chunked to <see cref="SyncInClause.ChunkSize"/> keys per statement.</remarks>
    /// <param name="tableName">The table the keys belong to.</param>
    /// <param name="keyTexts">The keys whose receipts go.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveAcksAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        ArgumentNullException.ThrowIfNull(keyTexts);

        foreach (var chunk in keyTexts.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_ack WHERE table_name = @tableName "
                        + "AND key_text IN (@keyTexts)",
                    new { tableName, keyTexts = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Removes every acknowledgement of one table (what a refresh does, having rebuilt its rows outright).</summary>
    /// <param name="tableName">The table whose receipts go.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task RemoveTableAcksAsync(
        string tableName,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(tableName);
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_ack WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Rewrites the key text of the given entries (what a write that settled its row's key only as it ran leaves behind).</summary>
    /// <param name="rewrites">The entries and the key texts they are to carry.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task RewriteKeyTextsAsync(
        IReadOnlyList<(long Id, string KeyText)> rewrites,
        CancellationToken cancellationToken
    )
    {
        foreach (var (id, keyText) in rewrites)
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "UPDATE quicker_sync_journal SET key_text = @keyText WHERE id = @id",
                    new { keyText, id },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Widens the unbounded binary columns one entry names to the given ones (what an upload that inserted the row still owes).</summary>
    /// <remarks>
    /// An upload that inserts the row sends every unbounded binary column after it, and the copy can fail on its own.
    /// The row is on the server by then, so the next replay takes the update path, which sends only the columns the
    /// entries name - an update's entry names none - and the blobs the insert left empty would never follow. Recording
    /// every column on the entry before the copy keeps them owed until a run sends them.
    /// </remarks>
    /// <param name="id">The id of the entry.</param>
    /// <param name="columns">The columns the entry is to name.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task WidenUnboundedBinaryColumnsAsync(
        long id,
        IReadOnlyList<string> columns,
        CancellationToken cancellationToken
    )
    {
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "UPDATE quicker_sync_journal SET unbounded_binary_columns = @columns WHERE id = @id",
                new { columns = string.Join(',', columns), id },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Records that the given columns of the given rows are to be copied down (before the rows are written).</summary>
    /// <remarks>
    /// A download writes a batch of rows and copies their blobs afterwards, and the copy can fail on its own. The row
    /// is in by then and its mirrored version has moved the resume point past it, so no later download would bring it
    /// down again - this record is what remembers the blob still owed, until the copy has been made.
    /// </remarks>
    internal async Task RecordBlobCopiesAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        IReadOnlyList<string> columnNames,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        var pairs = keyTexts.SelectMany(keyText => columnNames.Select(column => (keyText, column)));

        foreach (var chunk in pairs.Chunk(RowsPerStatement))
        {
            var rows = string.Join(
                ", ",
                Enumerable
                    .Range(0, chunk.Length)
                    .Select(index => $"(@tableName, @keyText{index}, @columnName{index})")
            );

            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "INSERT OR IGNORE INTO quicker_sync_blob_pending (table_name, key_text, column_name) "
                        + "VALUES "
                        + rows,
                    new
                    {
                        tableName,
                        keyText = chunk.Select(pair => pair.keyText).ToList(),
                        columnName = chunk.Select(pair => pair.column).ToList(),
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Reads the blob copies one table still owes, as key and column pairs.</summary>
    internal async Task<IReadOnlyList<SyncBlobCopyRow>> ReadBlobCopiesAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .QueryProjectionBySqlAsync<SyncBlobCopyRow>(
                "SELECT key_text AS KeyText, column_name AS ColumnName FROM quicker_sync_blob_pending "
                    + "WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes every blob copy one table owes (what a refresh does, having emptied the table).</summary>
    internal async Task RemoveTableBlobCopiesAsync(
        string tableName,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _localSqlExecutor
            .ExecuteSqlAsync(
                "DELETE FROM quicker_sync_blob_pending WHERE table_name = @tableName",
                new { tableName },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Removes the blob copies owed for the given rows (every column of them).</summary>
    internal async Task RemoveBlobCopiesAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        foreach (var chunk in keyTexts.Chunk(SyncInClause.ChunkSize))
        {
            await _localSqlExecutor
                .ExecuteSqlAsync(
                    "DELETE FROM quicker_sync_blob_pending WHERE table_name = @tableName "
                        + "AND key_text IN (@keyTexts)",
                    new { tableName, keyTexts = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>Counts the entries still waiting to be uploaded.</summary>
    public async Task<int> CountPendingAsync(CancellationToken cancellationToken = default)
    {
        await EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

        return await _localSqlExecutor
            .ExecuteScalarSqlAsync<int>(
                "SELECT COUNT(*) FROM quicker_sync_journal",
                null,
                cancellationToken
            )
            .ConfigureAwait(false);
    }
}

/// <summary>One batch of server changes, together with whether the stream it came from has more behind it.</summary>
/// <param name="Rows">The changed rows, in ascending version order.</param>
/// <param name="HasMore">Whether asking again - from the version the last row carries - can still return something.</param>
/// <remarks>
/// The flag is the source's own answer rather than something inferred from the row count. A full batch is the usual way
/// a source says "there is more", but only the source knows: one that trims a batch to fit a transfer limit returns
/// fewer rows and still has more behind them, and inferring from the count alone would stop the download early and
/// leave the rest for a later run without saying so.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record SyncChangeBatch<TEntity>(IReadOnlyList<TEntity> Rows, bool HasMore)
    where TEntity : EntityBaseCore, new();

/// <summary>
/// One side's unbounded binary columns, reachable by column name so the engine can copy them without knowing the entity.
/// </summary>
/// <remarks>
/// <para>
/// The generated accessors are named after their column (<c>ReadPayloadAsync</c> and so on), which an engine written
/// against <c>TEntity</c> cannot call. Both sides expose the same narrow surface instead, and the engine copies through
/// it - which is also what lets a direct database connection and an HTTP client stand in the same place, as they do for
/// every other part of a sync run.
/// </para>
/// <para>
/// A column name outside <see cref="UnboundedBinaryColumnNames"/> is rejected rather than ignored: silently doing
/// nothing would leave the destination as it was and report the copy as done.
/// </para>
/// </remarks>
/// <typeparam name="TKey">The primary key type.</typeparam>
public interface ISyncBinaryColumns<TKey>
{
    /// <summary>The names of the columns the ordinary row transfer leaves out.</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>Reads one column into the destination stream (false = no row, or the column is NULL).</summary>
    /// <param name="columnName">One of <see cref="UnboundedBinaryColumnNames"/>.</param>
    /// <param name="id">The primary key of the row.</param>
    /// <param name="destination">The stream the column's bytes are written to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    );

    /// <summary>Writes one column from a stream, or sets it to NULL (false = no row).</summary>
    /// <param name="columnName">One of <see cref="UnboundedBinaryColumnNames"/>.</param>
    /// <param name="id">The primary key of the row.</param>
    /// <param name="source">The bytes to store, or null to set the column to NULL.</param>
    /// <param name="length">The number of bytes, required when the stream cannot report its own length.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    );
}

/// <summary>One foreign key of a synchronised table, as the engine reads it off a row.</summary>
/// <param name="ParentTableName">The table the row refers to (its name as it appears in the journal).</param>
/// <param name="ReadParentKeyText">Reads the parent's primary key off the row in the journal's text form, or null when the row refers to no parent.</param>
/// <typeparam name="TEntity">The entity type of the referring row.</typeparam>
public sealed record SyncParentReference<TEntity>(
    string ParentTableName,
    Func<TEntity, string?> ReadParentKeyText
);

/// <summary>Helpers for the text form a primary key takes in the journal.</summary>
public static class SyncKeyText
{
    /// <summary>The length of a <see cref="DateTime"/> in round-trip form without a kind (<c>yyyy-MM-ddTHH:mm:ss.fffffff</c>).</summary>
    private const int DateTimeLength = 27;

    /// <summary>
    /// Removes the kind a <see cref="DateTime"/> key in round-trip form carries - a trailing <c>Z</c>, or a
    /// <c>+hh:mm</c> / <c>-hh:mm</c> offset - and leaves the clock time; any other text comes back as it is.
    /// </summary>
    /// <remarks>
    /// A <see cref="DateTime"/> key is written without its kind, because neither database keeps it: a row read back
    /// carries <see cref="DateTimeKind.Unspecified"/> whatever kind it was written with, and a key text that kept the
    /// kind would never meet the text of the row it is about. This also reads a key text an earlier version wrote with
    /// the kind still in it.
    /// </remarks>
    /// <param name="keyText">The key text.</param>
    public static string WithoutDateTimeKind(string keyText)
    {
        ArgumentNullException.ThrowIfNull(keyText);

        if (keyText.Length == DateTimeLength + 1 && keyText[DateTimeLength] == 'Z')
        {
            return keyText[..DateTimeLength];
        }

        if (
            keyText.Length == DateTimeLength + 6
            && keyText[DateTimeLength] is '+' or '-'
            && keyText[DateTimeLength + 3] == ':'
        )
        {
            return keyText[..DateTimeLength];
        }

        return keyText;
    }
}

/// <summary>One unique constraint of a synchronised table, as the local database is asked which row holds a value.</summary>
/// <param name="ReadValues">Reads the constraint's values off a row, in the order the statement binds them.</param>
/// <param name="Sql">Returns the key of the local row holding the values, bound as the collection parameter <c>@values</c> (<c>@values0</c>, <c>@values1</c>, ...).</param>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record SyncUniqueLookup<TEntity>(Func<TEntity, object?[]> ReadValues, string Sql);

/// <summary>One foreign key of the diagram that points at a synchronised table's primary key, as the local database is asked about it.</summary>
/// <param name="TableName">The referring table, as the local database names it.</param>
/// <param name="Sql">Returns which of the given keys (bound as the collection parameter <c>@keys</c>) a row of the referring table refers to.</param>
public sealed record SyncLocalReference(string TableName, string Sql);

/// <summary>How one unbounded binary column is read from and written to a repository that owns it.</summary>
/// <remarks>
/// The repository arrives untyped because these accessors are declared on the concrete generated contract
/// (<c>ISyncOrderRepository</c> and the like), which the fixed engine has no way to name. The generated lambda is the
/// only place that knows the type, and it casts back to it there.
/// </remarks>
/// <param name="Read">Reads the column into the destination stream (false = no row, or the column is NULL).</param>
/// <param name="Write">Writes the column from a stream, or sets it to NULL when the stream is null (false = no row).</param>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record SyncBinaryColumnAccessor<TKey>(
    Func<object, TKey, Stream, CancellationToken, Task<bool>> Read,
    Func<object, TKey, Stream?, long?, CancellationToken, Task<bool>> Write
);

/// <summary>Everything about one synchronised table that the journal recorder needs, with the entity's types erased.</summary>
/// <remarks>
/// The recorder walks a graph of <see cref="EntityBaseCore"/> without knowing any entity type, so it looks a node's table up
/// by its CLR type and asks the descriptor it finds for the two things a journal entry carries.
/// </remarks>
public interface ISyncTableDescriptor
{
    /// <summary>The table name, as it appears in the journal.</summary>
    string TableName { get; }

    /// <summary>The CLR entity type the table synchronises.</summary>
    Type EntityType { get; }

    /// <summary>Renders the entity's primary key into the text form the journal stores.</summary>
    /// <param name="entity">An entity of <see cref="EntityType"/>.</param>
    string FormatEntityKey(EntityBaseCore entity);

    /// <summary>Reads the mirrored server version off the entity (null for a table without a version column).</summary>
    /// <param name="entity">An entity of <see cref="EntityType"/>.</param>
    byte[]? ReadEntityRowVersion(EntityBaseCore entity);

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (what an inserted row is recorded as storing).</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames => [];
}

/// <summary>
/// Everything about one synchronised table that depends on the diagram: its name, the SQL that carries its identity, and
/// how the key and the mirrored version are read off an entity and written back.
/// </summary>
/// <remarks>
/// <para>
/// This is the whole of what the generator emits per table. The behaviour - batching, anchor derivation, delete
/// propagation, the replay of a journal entry - lives once in the fixed classes that take a descriptor
/// (<see cref="SyncTable{TEntity, TKey}"/>, <see cref="VersionlessSyncTable{TEntity, TKey}"/>,
/// <see cref="DirectSyncSource{TEntity, TKey}"/> and its versionless counterpart), so a table contributes data rather
/// than a class of its own.
/// </para>
/// <para>
/// The SQL is text baked in at generation time rather than assembled at run time: the two dialects a sync setup spans
/// (SQL Server for the server, SQLite for the local database) quote differently, and the generator is where both are
/// known.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncTableDescriptor<TEntity, TKey>
    : ISyncTableDescriptor,
        ISyncLocalRowVersionReader,
        ISyncHookKeyFormatter
    where TEntity : EntityBaseCore, new()
{
    /// <inheritdoc />
    public required string TableName { get; init; }

    /// <summary>The remote endpoint route of the entity (for example "SyncOrder").</summary>
    public required string RemoteRouteName { get; init; }

    /// <summary>
    /// Whether the table has no version column - synchronised only by <see cref="SyncMode.LastWriteWins"/> runs,
    /// downloaded as a full key-ordered scan, and uploaded without version guards.
    /// </summary>
    public required bool IsVersionless { get; init; }

    /// <inheritdoc />
    public Type EntityType => typeof(TEntity);

    /// <summary>Reads the entity's primary key.</summary>
    public required Func<TEntity, TKey> ReadKey { get; init; }

    /// <summary>Writes the entity's primary key (used to build the stub a version-guarded delete is sent as).</summary>
    public required Action<TEntity, TKey> WriteKey { get; init; }

    /// <summary>Renders a primary key into the text form the journal stores.</summary>
    public required Func<TKey, string> FormatKey { get; init; }

    /// <summary>Parses a primary key back out of the journal's text form.</summary>
    public required Func<string, TKey> ParseKey { get; init; }

    /// <summary>Rewrites a key text an earlier version wrote into the form <see cref="FormatKey"/> writes now, or null when the form has not changed.</summary>
    /// <remarks>Applied to the journal, the receipts and the owed blob copies before a run reads them (see <see cref="SyncJournal"/>).</remarks>
    public Func<string, string>? NormalizeKeyText { get; init; }

    /// <summary>Reads the mirrored server version off the entity.</summary>
    /// <remarks>
    /// The default answers null, which is what a table without a version column has to say: the delete entries it
    /// records carry no version, and nothing else ever asks.
    /// </remarks>
    public Func<TEntity, byte[]?> ReadRowVersion { get; init; } = static _ => null;

    /// <summary>Writes the mirrored server version onto the entity.</summary>
    /// <remarks>The default does nothing, and is never reached: only a versioned table writes a mirrored version.</remarks>
    public Action<TEntity, byte[]?> WriteRowVersion { get; init; } = static (_, _) => { };

    /// <summary>SELECT that returns every primary key of the server table (SQL Server quoting).</summary>
    public required string ServerKeysSql { get; init; }

    /// <summary>SELECT that returns one ascending batch of server rows above the anchor and below the ceiling (versioned tables).</summary>
    public string ServerChangesSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the first ascending batch of server rows by primary key (versionless tables).</summary>
    public string ServerPageFirstSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the next ascending batch of server rows above a key (versionless tables).</summary>
    public string ServerPageAfterSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the highest mirrored version among the local rows (the derived resume point).</summary>
    public string LocalAnchorSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the mirrored version of one local row (bound as <c>@key</c>); empty for a versionless table.</summary>
    /// <remarks>
    /// Read when a graph save records a delete: the entity it deletes may be a stub carrying only the key, or an object
    /// held since before the row's last download, and either carries no version or an older one than the row has.
    /// </remarks>
    public string LocalRowVersionSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns every local primary key.</summary>
    public required string LocalKeysSql { get; init; }

    /// <summary>SELECT that returns the local primary keys within a given set (bound as the collection parameter <c>@keys</c>).</summary>
    public required string LocalExistingKeysSql { get; init; }

    /// <summary>DELETE that empties the local table (the first half of a refresh).</summary>
    public required string LocalDeleteAllSql { get; init; }

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (empty when the table has none).</summary>
    public IReadOnlyList<string> UnboundedBinaryColumnNames { get; init; } = [];

    /// <summary>The repository accessors for those columns, by column name (empty when the table has none).</summary>
    public IReadOnlyDictionary<string, SyncBinaryColumnAccessor<TKey>> UnboundedBinaryAccessors
    {
        get;
        init;
    } = new Dictionary<string, SyncBinaryColumnAccessor<TKey>>(StringComparer.Ordinal);

    /// <summary>The foreign keys of this table that point at the primary key of another synchronised table (or of itself).</summary>
    /// <remarks>
    /// A single-column foreign key to a synchronised table's primary key is listed; one that refers to a unique
    /// constraint, or spans several columns, is not, because the parent's key cannot be read off the row. The engine
    /// uses them to keep the parents of the rows the delete propagation keeps, to stop a download at a row whose parent
    /// is deleted locally and not yet sent, and to tell a write the server refused for a missing parent.
    /// </remarks>
    public IReadOnlyList<SyncParentReference<TEntity>> ParentReferences { get; init; } = [];

    /// <summary>Gives every NOT NULL unbounded binary column that holds nothing an empty value, before a row is inserted.</summary>
    /// <remarks>
    /// A row read for a sync run arrives without these columns, and a value-object column left unread is null - which a
    /// NOT NULL column refuses when the engine inserts the row locally. The empty value is what the column holds until
    /// the blob is copied, which is the same thing a row new to this side holds when the run does not carry the blobs.
    /// The default does nothing: a table without such a column has nothing to fill.
    /// </remarks>
    public Action<TEntity> FillUnsetUnboundedBinaries { get; init; } = static _ => { };

    /// <summary>The tables of the diagram that refer to this one, synchronised or not.</summary>
    /// <remarks>What makes a failed delete of one of this table's rows worth reporting as refused by the server.</remarks>
    public IReadOnlyList<string> ReferencingTableNames { get; init; } = [];

    /// <summary>The tables of the diagram that refer to this one through a foreign key <see cref="LocalReferences"/> does not list.</summary>
    /// <remarks>
    /// A foreign key that refers to a unique constraint of this table, or spans several columns, cannot be asked which
    /// rows it refers to. A refresh that empties this table and leaves such a table out refuses to run whenever the local
    /// database has that table, without looking at its rows.
    /// </remarks>
    public IReadOnlyList<string> UnlistedReferencingTableNames { get; init; } = [];

    /// <summary>The foreign keys of the diagram that point at this table's primary key, one per referring column.</summary>
    /// <remarks>
    /// Every referring table of the diagram is listed, synchronised or not, and this table itself when it refers to its
    /// own rows: the delete propagation removes only the rows nothing local refers to. A referring table the local
    /// database does not have is skipped, since it holds no rows to refer with. A foreign key that refers to a unique
    /// constraint, or spans several columns, is not listed.
    /// </remarks>
    public IReadOnlyList<SyncLocalReference> LocalReferences { get; init; } = [];

    /// <summary>The unique constraints of the table, one per constraint.</summary>
    /// <remarks>
    /// What a server row that collides with a local one on a unique value is resolved by: the local row holding the value
    /// is found and brought up to date first (see <see cref="SyncParentResolver"/>).
    /// </remarks>
    public IReadOnlyList<SyncUniqueLookup<TEntity>> LocalUniqueLookups { get; init; } = [];

    /// <inheritdoc />
    public string FormatEntityKey(EntityBaseCore entity)
    {
        ArgumentNullException.ThrowIfNull(entity);

        return FormatKey(ReadKey((TEntity)entity));
    }

    /// <inheritdoc />
    public byte[]? ReadEntityRowVersion(EntityBaseCore entity)
    {
        ArgumentNullException.ThrowIfNull(entity);

        return ReadRowVersion((TEntity)entity);
    }

    /// <inheritdoc />
    string ISyncHookKeyFormatter.FormatHookKey(object key)
    {
        ArgumentNullException.ThrowIfNull(key);

        if (key is TKey typed)
        {
            return FormatKey(typed);
        }

        try
        {
{{~ if generate_value_objects ~}}
            var raw = SqlParameterValue.Unwrap(key)!;

            return FormatKey(
                SqlValueObjectActivator.Wrap(raw, typeof(TKey)) is TKey wrapped
                    ? wrapped
                    : (TKey)RawValueConverter.ConvertRaw(raw, typeof(TKey))
            );
{{~ else ~}}
            return FormatKey((TKey)RawValueConverter.ConvertRaw(key, typeof(TKey)));
{{~ end ~}}
        }
        catch (Exception failure)
        {
            throw new InvalidOperationException(
                $"A save hook wrote an unbounded binary column of {typeof(TEntity).Name} with a key of type "
                    + $"{key.GetType().Name}, which cannot be read as the table's key type {typeof(TKey).Name}, so the "
                    + "write cannot be recorded for the sync journal. Pass the key as the table's key type.",
                failure
            );
        }
    }

    /// <inheritdoc />
    async Task<byte[]?> ISyncLocalRowVersionReader.ReadLocalRowVersionAsync(
        ISqlExecutor local,
        string keyText,
        CancellationToken cancellationToken
    )
    {
        if (string.IsNullOrEmpty(LocalRowVersionSql))
        {
            return null;
        }

        return await local
            .ExecuteScalarSqlAsync<byte[]>(
                LocalRowVersionSql,
                new { key = ParseKey(keyText) },
                cancellationToken
            )
            .ConfigureAwait(false);
    }
}

/// <summary>Turns the key a save hook passed when it wrote an unbounded binary column into the journal's key text.</summary>
internal interface ISyncHookKeyFormatter
{
    /// <summary>The key text of the row, from the key as the hook passed it (the key type, or a value convertible to it).</summary>
    /// <param name="key">The key the hook passed.</param>
    /// <exception cref="InvalidOperationException">The key cannot be read as the table's key type.</exception>
    string FormatHookKey(object key);
}

/// <summary>Reads the mirrored version of one local row by its key text (what a recorded delete is guarded by).</summary>
internal interface ISyncLocalRowVersionReader
{
    /// <summary>The mirrored version of the local row with the given key, or null when the row or its version is not there.</summary>
    /// <param name="local">The local database.</param>
    /// <param name="keyText">The row's key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<byte[]?> ReadLocalRowVersionAsync(
        ISqlExecutor local,
        string keyText,
        CancellationToken cancellationToken
    );
}

/// <summary>
/// One side's unbounded binary columns, reached by column name through the repository that owns them.
/// </summary>
/// <remarks>
/// The same class serves the local database and a directly connected server, because both are reached through a
/// generated repository; only the instance differs. A column outside the descriptor's list is rejected rather than
/// ignored, for the reason <see cref="ISyncBinaryColumns{TKey}"/> gives.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncRepositoryBinaryColumns<TEntity, TKey> : ISyncBinaryColumns<TKey>
    where TEntity : EntityBaseCore, new()
{
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;
    private readonly object _repository;

    /// <summary>Creates the surface over the table's descriptor and the repository the columns are stored in.</summary>
    /// <param name="descriptor">The table's descriptor, which names the columns and holds their accessors.</param>
    /// <param name="repository">The generated repository instance the accessors are invoked on.</param>
    public SyncRepositoryBinaryColumns(
        SyncTableDescriptor<TEntity, TKey> descriptor,
        object repository
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(repository);
        _descriptor = descriptor;
        _repository = repository;
    }

    /// <inheritdoc />
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <inheritdoc />
    public Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    ) => Accessor(columnName).Read(_repository, id, destination, cancellationToken);

    /// <inheritdoc />
    public Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    ) => Accessor(columnName).Write(_repository, id, source, length, cancellationToken);

    /// <summary>Looks the accessors of one column up, refusing a name the table does not have.</summary>
    private SyncBinaryColumnAccessor<TKey> Accessor(string columnName) =>
        _descriptor.UnboundedBinaryAccessors.TryGetValue(columnName, out var accessor)
            ? accessor
            : throw new ArgumentOutOfRangeException(
                nameof(columnName),
                columnName,
                "The column is not an unbounded binary column of this table."
            );
}

/// <summary>
/// The server side of the differential source for one entity type: where changed rows, the change ceiling, and the key
/// set come from, and which repository the local changes are replayed against.
/// </summary>
/// <remarks>
/// The engine never talks to the server directly, so a second implementation (over HTTP, say) can replace the direct
/// one without the engine changing. The generated direct implementation reads through the server's raw SQL surface and
/// writes through the server's ordinary repository.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public interface ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>
    /// Gets the exclusive upper bound for this pass: the lowest version of any transaction still in flight.
    /// </summary>
    /// <remarks>
    /// A row committed later can carry a lower version than one committed earlier, so reading up to "the current
    /// maximum" would step over rows that are still uncommitted and never come back for them. Stopping below the
    /// oldest active transaction is what makes the derived anchor (the local mirror's maximum) safe to resume from.
    /// </remarks>
    Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default);

    /// <summary>Gets the rows whose version is above <paramref name="anchor"/> and below <paramref name="ceiling"/>, in ascending version order.</summary>
    /// <param name="anchor">The resume point (null on the first pass, which takes everything below the ceiling).</param>
    /// <param name="ceiling">The exclusive upper bound from <see cref="GetChangeCeilingAsync"/>.</param>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    );

    /// <summary>Gets the first batch of rows in ascending primary-key order (the versionless full scan).</summary>
    /// <remarks>
    /// A table without a version column has no change stream to resume, so its download reads every row, paged by the
    /// primary key. The default refuses rather than answers: a source written for a versioned table has no key-ordered
    /// SQL to serve it with, and only the generated versionless sources override it.
    /// </remarks>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <summary>Gets the next batch of rows whose primary key is above <paramref name="afterKey"/>, in ascending key order.</summary>
    /// <param name="afterKey">The last key of the previous batch (the exclusive lower bound).</param>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <summary>Gets every primary key the server holds for this table (the input to delete propagation).</summary>
    Task<IReadOnlyList<TKey>> GetAllKeysAsync(CancellationToken cancellationToken = default);

    /// <summary>The repository the local changes are replayed against.</summary>
    /// <remarks>
    /// The remote surface rather than the full one: replaying a journal entry only ever reads a row by key, inserts,
    /// updates, saves, or deletes it, and those are exactly the operations that can cross a network boundary. Asking for
    /// no more than that is what lets an HTTP client stand here beside a direct repository, which satisfies the narrower
    /// contract as well.
    /// </remarks>
    IRemoteRepositoryCore<TEntity, TKey> Writer { get; }

    /// <summary>The server's unbounded binary columns, or null when the table has none to copy.</summary>
    /// <remarks>
    /// Null is the answer for every table generated without the unbounded binary columns excluded, which is why it is
    /// the default: a source written before there was anything to copy still satisfies the contract, and a run that asks
    /// for the columns simply finds none.
    /// </remarks>
    ISyncBinaryColumns<TKey>? BinaryColumns => null;
}

/// <summary>What one table's download knows about the local changes of the run it belongs to.</summary>
/// <remarks>
/// <para>
/// Both halves are about the same thing: a download must not undo what the run's own upload has just done, and must not
/// undo what the upload could not do either.
/// </para>
/// <para>
/// <see cref="PendingKeyTexts"/> holds the keys whose local change is still in the journal - a collected conflict, or an
/// entry a failure left behind. The row behind such a key carries local content nobody has agreed to give up, so the
/// download stops there rather than overwriting it.
/// </para>
/// <para>
/// <see cref="AcknowledgedRowVersions"/> holds the version the server stamped on each row this device has uploaded and
/// not yet seen come back. Such a row comes back down as a change like any other, and applying it would be writing the
/// row's own content over itself; only the version is worth keeping, and that is all the download writes for it.
/// </para>
/// </remarks>
public sealed record SyncDownloadContext
{
    /// <summary>A download that knows of no unsent local change and of no outstanding acknowledgement.</summary>
    public static SyncDownloadContext Empty { get; } = new();

    /// <summary>The keys of this table that still hold an unsent journal entry.</summary>
    /// <remarks>
    /// A copy taken as the table's download starts. The engine hands it to a table that implements only the public
    /// surface; the fixed table classes read what is unsent again before each batch instead, so a row the application
    /// edits while the run is downloading is protected as well. A table of your own sees only what was unsent at the
    /// start, and an edit made after that may be overwritten by a batch it then applies.
    /// </remarks>
    public IReadOnlySet<string> PendingKeyTexts { get; init; } =
        new HashSet<string>(StringComparer.Ordinal);

    /// <summary>The acknowledged server version of each uploaded row awaiting its echo, by the key's journal text form.</summary>
    public IReadOnlyDictionary<string, byte[]> AcknowledgedRowVersions { get; init; } =
        new Dictionary<string, byte[]>(StringComparer.Ordinal);

    /// <summary>Reads the unsent changes afresh (set by the engine; replaces <see cref="PendingKeyTexts"/> when present).</summary>
    /// <remarks>
    /// The application may keep writing while a run downloads, so what is still unsent is read again right before each
    /// batch is applied, under the lock those writes take - never once up front, which would let a row edited in the
    /// meantime be overwritten by the batch.
    /// </remarks>
    internal Func<CancellationToken, Task<SyncPendingSnapshot>>? PendingReader { get; init; }

    /// <summary>The locks of the local database (set by the engine together with <see cref="PendingReader"/>).</summary>
    internal SyncLocalGate? Gate { get; init; }

    /// <summary>Makes the resolver one batch brings its missing parents in through (set by the engine together with <see cref="PendingReader"/>).</summary>
    internal Func<SyncPendingSnapshot, SyncParentResolver>? ParentResolverFactory { get; init; }
}

/// <summary>What is still unsent at the moment one download batch is about to be applied.</summary>
/// <param name="KeyTexts">The keys of the downloading table that hold an unsent entry.</param>
/// <param name="DeletedKeyTextsByTable">The keys of every table that hold an unsent delete, by table name.</param>
/// <param name="BinaryColumnsByKeyText">The unbounded binary columns the downloading table's unsent entries stored a value in, by key.</param>
internal sealed record SyncPendingSnapshot(
    IReadOnlySet<string> KeyTexts,
    IReadOnlyDictionary<string, IReadOnlySet<string>> DeletedKeyTextsByTable,
    IReadOnlyDictionary<string, IReadOnlySet<string>> BinaryColumnsByKeyText
)
{
    /// <summary>The keys of every table that hold an unsent entry, by table name.</summary>
    public IReadOnlyDictionary<string, IReadOnlySet<string>> KeyTextsByTable { get; init; } =
        new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal);
}

/// <summary>What one table's download did.</summary>
/// <param name="Applied">The number of server rows applied locally (a row recognised as this device's own echo is not one of them).</param>
/// <param name="TruncatedAtKeyText">The key of the row the download stopped at (see <see cref="SyncDownloadTruncation"/>), or null when the table was drained.</param>
/// <param name="SettledAckKeyTexts">The acknowledged keys whose mirrored version this download has brought up to date, so their receipts can go.</param>
/// <remarks>
/// The settled keys are handed back rather than cleared here because the clearing has to follow the local commit that
/// wrote the versions: a receipt dropped before the commit that replaces it, and a commit that then fails, is the
/// "no receipt, stale mirror" state all over again. The opposite order leaves a receipt behind for a row that no longer
/// needs one, which the next run recognises as an echo, writes the same version for, and clears - a state that repairs
/// itself.
/// </remarks>
public readonly record struct SyncDownloadOutcome(
    int Applied,
    string? TruncatedAtKeyText,
    IReadOnlyList<string> SettledAckKeyTexts
)
{
    /// <summary>An outcome with no receipt to settle (what a table that carries no acknowledgements returns).</summary>
    /// <param name="applied">The number of server rows applied locally.</param>
    /// <param name="truncatedAtKeyText">The key the download stopped at, or null when the table was drained.</param>
    public SyncDownloadOutcome(int applied, string? truncatedAtKeyText)
        : this(applied, truncatedAtKeyText, []) { }

    /// <summary>The table of the parent the row the download stopped at could not have, or null when it stopped for its own unsent change.</summary>
    public string? MissingParentTableName { get; init; }

    /// <summary>Whether the download stopped because a local save hook skipped the row (its Before returned false).</summary>
    public bool SkippedBySaveHook { get; init; }
}

/// <summary>One row a <see cref="SyncConflictPolicy.ServerWins"/> upload wrote the server's copy over.</summary>
/// <param name="KeyText">The primary key in the text form the table's descriptor produces.</param>
/// <param name="ServerRowVersion">The version the server's copy carried when it was read, or null when it had none.</param>
/// <remarks>
/// The version reported is the server's own, not the one written onto the local row - that one is deliberately left
/// where it was. So nothing about the row itself says that its local content is the server's content at that version,
/// and the run records the pair as an acknowledgement instead.
/// </remarks>
public readonly record struct SyncAppliedServerRow(string KeyText, byte[]? ServerRowVersion);

/// <summary>The engine's view of one synchronised table, with the entity's own types erased.</summary>
public interface ISyncTable
{
    /// <summary>The table name, as it appears in the journal.</summary>
    string TableName { get; }

    /// <summary>The CLR entity type the table synchronises (what the exclusion lists are matched against).</summary>
    Type EntityType { get; }

    /// <summary>
    /// Whether the table has no version column - synchronised only by <see cref="SyncMode.LastWriteWins"/> runs,
    /// downloaded as a full key-ordered scan, and uploaded without version guards.
    /// </summary>
    bool IsVersionless { get; }

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (empty when the table has none).</summary>
    /// <remarks>
    /// The engine reads this to decide whether a refresh has local blobs to lose, and callers can read it to see which
    /// columns <c>SyncOptions.IncludeUnboundedBinary</c> would carry.
    /// </remarks>
    IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>Gets the server's change ceiling (the engine asks one table and uses the answer for all of them).</summary>
    Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default);

    /// <summary>Pulls every server change below the ceiling into the local database and returns the number of rows applied.</summary>
    /// <remarks>
    /// A download that knows nothing of the run's local changes: it applies every row it is given. Inside a run the
    /// engine calls the overload that takes a <see cref="SyncDownloadContext"/> instead.
    /// </remarks>
    Task<int> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    );

    /// <summary>Pulls the server's changes down under what the run knows about its own local changes.</summary>
    /// <param name="ceiling">The exclusive upper bound of the pass.</param>
    /// <param name="batchSize">How many rows one batch fetches and applies in a single local transaction.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="context">The table's unsent local changes and its outstanding acknowledgements.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// The default answers as the context-free overload does, applying every row and never stopping early - the only
    /// sound answer for an implementation that has no way to tell a row with an unsent local change from any other.
    /// </remarks>
    async Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    ) =>
        new(
            await DownloadAsync(ceiling, batchSize, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false),
            null
        );

    /// <summary>Overwrites the named local rows with the server's copies.</summary>
    /// <param name="keyTexts">The keys, in the journal's text form, whose local content is to give way to the server's.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried down as well.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// <para>
    /// What <see cref="SyncConflictPolicy.ServerWins"/> is made of. Dropping the journal entry only stops the local
    /// change from being sent; the row keeps the content the entry was about, and the download brings nothing down for
    /// a row the server has not changed since it was last mirrored. The server's row is therefore read back and
    /// written over the local one, which is what "the server wins" says. A key the server no longer holds has nothing
    /// to apply, and is left to the delete propagation - so with propagation turned off that row stays as it is.
    /// </para>
    /// <para>
    /// <b>The mirrored version is left exactly where it was.</b> The row read from the server carries the server's
    /// current version, and writing that onto the local row would raise the derived resume point to it - past every
    /// row of the ordered stream this device has not seen, none of which any later run would ask for again. The
    /// content is applied and the version is not, so the next download reaches the row in its proper order and writes
    /// the version then; applying the same content a second time costs nothing.
    /// </para>
    /// <para>
    /// <b>Which is why the applied rows are reported back.</b> With the mirrored version left behind, nothing on the
    /// device records that the row's local content is the server's content at the version just read - and no download
    /// need ever supply it: a row restored under a server version at or below the derived resume point is one the
    /// ordered stream has already passed. Replaying a later edit to such a row would then find no version to guard it
    /// with and take it for a row that has never been on the server, which the server answers by already having it.
    /// The caller records the pairs as acknowledgements, and the replay reads its original from those too.
    /// </para>
    /// <para>
    /// The default applies nothing, the only sound answer for an implementation with no server of its own to read.
    /// </para>
    /// </remarks>
    /// <returns>The key and the server's version of every row applied, in the order they were applied.</returns>
    Task<IReadOnlyList<SyncAppliedServerRow>> ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) => Task.FromResult<IReadOnlyList<SyncAppliedServerRow>>([]);

    /// <summary>Deletes the local rows whose key the server no longer has, and returns the keys that went.</summary>
    /// <param name="pendingKeyTexts">The keys of this table that still hold an unsent journal entry; they are left alone.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// <para>
    /// A key the journal still holds an entry for is not treated as one the server dropped. The entry is a local
    /// intention this run has not settled - a conflict it collected, or a change it never reached - and deleting the row
    /// underneath it would resolve that in the server's favour without saying so, which is exactly what
    /// <see cref="SyncConflictPolicy.Collect"/> promises not to do. Once the entry is settled - uploaded, discarded as a
    /// stale intent, or dropped by <see cref="SyncConflictPolicy.ServerWins"/> - the next run propagates the deletion as
    /// usual.
    /// </para>
    /// <para>
    /// The protection reaches exactly as far as the journal does. A row written without going through the generated
    /// repositories - raw SQL, most of all - has no entry to hold it back and is deleted like any other row the server
    /// does not have (see <see cref="SyncOptions.PropagateDeletes"/>).
    /// </para>
    /// <para>
    /// The keys are returned rather than counted because a row the server has dropped invalidates whatever else was
    /// recorded about it - its acknowledgement most of all, which would otherwise send the next replay of that key
    /// against a version of a row that is gone.
    /// </para>
    /// </remarks>
    Task<IReadOnlyList<string>> PropagateDeletesAsync(
        IReadOnlySet<string> pendingKeyTexts,
        CancellationToken cancellationToken = default
    );

    /// <summary>Removes every local row of this table and returns how many went (the first half of a refresh).</summary>
    Task<int> DeleteAllLocalAsync(CancellationToken cancellationToken = default);

    /// <summary>Writes every server row below the ceiling into the emptied local table and returns how many arrived.</summary>
    Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    );

    /// <summary>Replays one journal entry against the server.</summary>
    /// <param name="entry">The journal entry to replay.</param>
    /// <param name="mode">The run's mode; <see cref="SyncMode.LastWriteWins"/> replays without version guards and ignores <paramref name="policy"/>.</param>
    /// <param name="policy">How a collision with the server is treated (versioned mode only).</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="acknowledgedRowVersion">The version the server last acknowledged for this key, or null when there is no receipt.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// A version-guarded replay guards against the later of the mirrored version and the acknowledged one. The mirror
    /// is the row's version as of the last download that reached it, the receipt is its version as of the last upload
    /// the server took, and either can be the more recent - the mirror when the receipt has already been cleared, the
    /// receipt when the echo has not come down yet.
    /// </remarks>
    Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    );
}

/// <summary>What one table's delete propagation did.</summary>
/// <param name="Removed">The keys whose local rows went.</param>
/// <param name="KeptParents">The parents in other tables that the rows this table kept refer to.</param>
internal sealed record SyncPropagationOutcome(
    IReadOnlyList<string> Removed,
    IReadOnlyList<(string TableName, string KeyText)> KeptParents
);

/// <summary>Works out which of the rows a delete propagation would remove have to stay, and which parents they need.</summary>
internal static class SyncKeptRows
{
    /// <summary>
    /// Closes the kept set over the parents within the table, and collects the parents in other tables.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A row the server does not have is kept when its key still holds an unsent entry, or when a kept row of a child
    /// table refers to it. A kept row keeps its parents in turn: removing a parent a kept row points at fails on the
    /// local foreign key, or - under <c>ON DELETE CASCADE</c> - takes the kept row with it. A parent in the same table is
    /// kept here, and its own parents are followed from it; a parent in another table is handed back, for that table's
    /// propagation to keep, which runs after this one because tables are propagated children first.
    /// </para>
    /// <para>
    /// Only rows the server does not have are followed. A parent the server still holds is not a candidate for
    /// removal, so there is nothing to keep it from; and a row met twice is followed once, so a reference cycle ends.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table being propagated.</param>
    /// <param name="seeds">The candidates kept on their own account (unsent, or needed by a child).</param>
    /// <param name="candidates">The keys of the local rows the server does not have.</param>
    /// <param name="readParents">Reads the parents a kept row refers to.</param>
    internal static async Task<(
        HashSet<string> Kept,
        List<(string TableName, string KeyText)> OtherParents
    )> CloseAsync(
        string tableName,
        IEnumerable<string> seeds,
        IReadOnlySet<string> candidates,
        Func<string, Task<IReadOnlyList<(string TableName, string KeyText)>>> readParents
    )
    {
        var kept = new HashSet<string>(StringComparer.Ordinal);
        var work = new Queue<string>();
        var otherParents = new List<(string TableName, string KeyText)>();

        foreach (var seed in seeds)
        {
            if (candidates.Contains(seed) && kept.Add(seed))
            {
                work.Enqueue(seed);
            }
        }

        while (work.TryDequeue(out var keyText))
        {
            foreach (var parent in await readParents(keyText).ConfigureAwait(false))
            {
                if (!string.Equals(parent.TableName, tableName, StringComparison.Ordinal))
                {
                    otherParents.Add(parent);
                }
                else if (candidates.Contains(parent.KeyText) && kept.Add(parent.KeyText))
                {
                    work.Enqueue(parent.KeyText);
                }
            }
        }

        return (kept, otherParents);
    }
}

/// <summary>Brings in the parents that rows about to be applied refer to and the local database does not have.</summary>
/// <remarks>
/// <para>
/// A row can arrive before the row it points at. A download applies rows in version order, and a parent changed after
/// its child carries the higher version; a parent changed above the run's ceiling does not come down in this run at
/// all; and the rows <see cref="SyncConflictPolicy.ServerWins"/> puts back arrive in the order they were recorded.
/// Applying such a row fails on the local foreign key.
/// </para>
/// <para>
/// A parent the local database does not have is read from the server and applied first, its own parents the same way,
/// unless one of these says it must not be:
/// </para>
/// <list type="bullet">
/// <item>its table is outside the run's scope (excluded, or versionless in a versioned run): the run does not touch that
/// table;</item>
/// <item>its key holds an unsent local delete the run is not discarding: the delete stands, and bringing the row back
/// would undo it without saying so;</item>
/// <item>the server does not have it either, or it cannot be had for one of these reasons in turn.</item>
/// </list>
/// <para>
/// A parent brought in is written the way a row <see cref="SyncConflictPolicy.ServerWins"/> puts back is: its content is
/// applied and its mirrored version is not, since that version would raise the derived resume point past rows the
/// ordered stream has not delivered. The server's version is recorded as an acknowledgement instead - without it, an
/// edit made to the row before a download reaches it would find no version to guard with.
/// </para>
/// <para>
/// One resolver serves one download batch, one table of a <see cref="SyncConflictPolicy.ServerWins"/> application, or
/// one refresh, and remembers the parents it has looked at, so a parent several rows share is read once.
/// </para>
/// </remarks>
/// <param name="tables">Every table of the engine (a parent's table is looked up by name).</param>
/// <param name="scopeTableNames">The tables the run covers.</param>
/// <param name="pending">What is unsent (the unsent deletes the run is not discarding).</param>
/// <param name="journal">Where the acknowledgements of the parents brought in are recorded.</param>
/// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
/// <param name="propagateDeletes">Whether the run propagates deletes: a local row holding a unique value that the server no longer has is then removed (see <see cref="BringHoldersUpToDateAsync"/>).</param>
/// <param name="changes">Where the rows brought up to date for a unique value are noted, or null when the run does not report them (see <see cref="SyncResult.LocalRowChanges"/>).</param>
internal sealed class SyncParentResolver(
    IReadOnlyList<ISyncTable> tables,
    IReadOnlySet<string> scopeTableNames,
    SyncPendingSnapshot pending,
    SyncJournal journal,
    bool includeUnboundedBinary,
    bool propagateDeletes,
    SyncLocalRowChangeLog? changes = null
)
{
    /// <summary>What is unsent when nothing is (a refresh runs with the journal empty).</summary>
    internal static SyncPendingSnapshot NothingPending { get; } =
        new(
            new HashSet<string>(StringComparer.Ordinal),
            new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal),
            new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal)
        );

    /// <summary>The parents looked at so far: true when the row is there (it was, or it was brought in).</summary>
    private readonly Dictionary<(string TableName, string KeyText), bool> _known = new();

    /// <summary>The parents being brought in right now (met again on the way, they cannot be had: a reference cycle).</summary>
    private readonly HashSet<(string TableName, string KeyText)> _inProgress = new();

    /// <summary>The rows brought in, by table.</summary>
    private readonly Dictionary<string, HashSet<string>> _broughtIn = new(StringComparer.Ordinal);

    /// <summary>Makes the given parents present where it may, and returns the ones that are not.</summary>
    /// <param name="parents">The parents, by table name and key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<IReadOnlySet<(string TableName, string KeyText)>> EnsureAsync(
        IEnumerable<(string TableName, string KeyText)> parents,
        CancellationToken cancellationToken
    )
    {
        var requested = parents.Distinct().ToList();

        foreach (
            var group in requested
                .Where(parent => !_known.ContainsKey(parent) && !_inProgress.Contains(parent))
                .GroupBy(parent => parent.TableName, StringComparer.Ordinal)
        )
        {
            await EnsureTableAsync(
                    group.Key,
                    group.Select(parent => parent.KeyText).ToList(),
                    cancellationToken
                )
                .ConfigureAwait(false);
        }

        return requested
            .Where(parent => !_known.TryGetValue(parent, out var present) || !present)
            .ToHashSet();
    }

    /// <summary>Whether the key holds an unsent local change the run is not discarding.</summary>
    /// <param name="tableName">The table.</param>
    /// <param name="keyText">The key.</param>
    internal bool HoldsUnsentChange(string tableName, string keyText) =>
        pending.KeyTextsByTable.TryGetValue(tableName, out var keyTexts) && keyTexts.Contains(keyText);

    /// <summary>
    /// Brings the local rows that hold a unique value a server row needs up to date from the server: a row the server
    /// still has takes its content, a row it no longer has goes when nothing local refers to it and the run propagates
    /// deletes. Returns whether every one of them was dealt with.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The download sees each row at its latest version only, so a row that gave a unique value up and was changed
    /// again later comes after the row that took the value - and the local copy still holding it refuses the newcomer.
    /// The local copy is what is out of date, so it is the one brought forward. Like a parent brought in, the row keeps
    /// no mirrored version and gets a receipt (see the class remarks).
    /// </para>
    /// <para>
    /// The caller has already ruled out a row with an unsent change and a row whose server copy still holds the value;
    /// a row met again on the way - a cycle of rows each holding the value the next one needs - is not dealt with.
    /// </para>
    /// </remarks>
    /// <param name="tableName">The table.</param>
    /// <param name="keyTexts">The keys of the local rows holding the values.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task<bool> BringHoldersUpToDateAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        if (
            tables.FirstOrDefault(table =>
                string.Equals(table.TableName, tableName, StringComparison.Ordinal)
            )
            is not ISyncTableRunSupport support
            || keyTexts.Any(keyText => _inProgress.Contains((tableName, keyText)))
        )
        {
            return false;
        }

        foreach (var keyText in keyTexts)
        {
            _inProgress.Add((tableName, keyText));
        }

        try
        {
            var (applied, held, removed) = await support
                .ApplyServerRowsAsync(
                    keyTexts,
                    includeUnboundedBinary,
                    removeLocalRowsMissingOnServer: propagateDeletes,
                    this,
                    cancellationToken
                )
                .ConfigureAwait(false);

            foreach (var row in applied)
            {
                if (row.ServerRowVersion is { Length: > 0 } serverRowVersion)
                {
                    await journal
                        .RecordAckAsync(tableName, row.KeyText, serverRowVersion, cancellationToken)
                        .ConfigureAwait(false);
                }
            }

            if (removed.Count > 0)
            {
                await journal
                    .RemoveAcksAsync(tableName, removed, cancellationToken)
                    .ConfigureAwait(false);
            }

            var dealtWith = applied
                .Select(row => row.KeyText)
                .Concat(removed)
                .ToHashSet(StringComparer.Ordinal);

            if (changes is not null)
            {
                foreach (var keyText in dealtWith)
                {
                    changes.Add(tableName, keyText, SyncLocalRowChangeReason.ReloadedForUniqueValue);
                }
            }

            return held.Count == 0 && keyTexts.All(dealtWith.Contains);
        }
        finally
        {
            foreach (var keyText in keyTexts)
            {
                _inProgress.Remove((tableName, keyText));
            }
        }
    }

    /// <summary>The keys of the table this resolver has brought in.</summary>
    /// <param name="tableName">The table.</param>
    internal IReadOnlySet<string> BroughtIn(string tableName) =>
        _broughtIn.TryGetValue(tableName, out var keyTexts)
            ? keyTexts
            : new HashSet<string>(StringComparer.Ordinal);

    /// <summary>Looks at the parents of one table and brings in the missing ones it may.</summary>
    private async Task EnsureTableAsync(
        string tableName,
        IReadOnlyList<string> keyTexts,
        CancellationToken cancellationToken
    )
    {
        // A table the fixed classes do not implement cannot say which rows it holds. Its rows are taken to be there,
        // as every parent was before parents were looked at; the local foreign key has the last word.
        if (
            tables.FirstOrDefault(table =>
                string.Equals(table.TableName, tableName, StringComparison.Ordinal)
            )
            is not ISyncTableRunSupport support
        )
        {
            foreach (var keyText in keyTexts)
            {
                _known[(tableName, keyText)] = true;
            }

            return;
        }

        var present = await support
            .FindLocalKeyTextsAsync(keyTexts, cancellationToken)
            .ConfigureAwait(false);
        var toBringIn = new List<string>();

        foreach (var keyText in keyTexts)
        {
            if (present.Contains(keyText))
            {
                _known[(tableName, keyText)] = true;
            }
            else if (
                !scopeTableNames.Contains(tableName)
                || pending.DeletedKeyTextsByTable.TryGetValue(tableName, out var deleted)
                    && deleted.Contains(keyText)
            )
            {
                _known[(tableName, keyText)] = false;
            }
            else
            {
                toBringIn.Add(keyText);
            }
        }

        if (toBringIn.Count == 0)
        {
            return;
        }

        foreach (var keyText in toBringIn)
        {
            _inProgress.Add((tableName, keyText));
        }

        IReadOnlyList<SyncAppliedServerRow> applied;

        try
        {
            (applied, _, _) = await support
                .ApplyServerRowsAsync(
                    toBringIn,
                    includeUnboundedBinary,
                    removeLocalRowsMissingOnServer: false,
                    this,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        finally
        {
            foreach (var keyText in toBringIn)
            {
                _inProgress.Remove((tableName, keyText));
            }
        }

        if (!_broughtIn.TryGetValue(tableName, out var broughtIn))
        {
            broughtIn = new HashSet<string>(StringComparer.Ordinal);
            _broughtIn.Add(tableName, broughtIn);
        }

        foreach (var row in applied)
        {
            broughtIn.Add(row.KeyText);

            // A table with no version has nothing to acknowledge.
            if (row.ServerRowVersion is { Length: > 0 } serverRowVersion)
            {
                await journal
                    .RecordAckAsync(tableName, row.KeyText, serverRowVersion, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        foreach (var keyText in toBringIn)
        {
            _known[(tableName, keyText)] = broughtIn.Contains(keyText);
        }
    }
}

/// <summary>What the engine asks of the fixed table classes beyond the public <see cref="ISyncTable"/> surface.</summary>
/// <remarks>
/// These are the steps of a run that need the local database's locks, or knowledge the engine has and a table does not.
/// They are kept off the public interface because they are a protocol between the engine and the fixed classes rather
/// than something an implementation of its own would be asked to supply; a table that does not implement this is run
/// the way the public interface describes.
/// </remarks>
internal interface ISyncTableRunSupport
{
    /// <summary>Deletes the local rows whose key the server no longer has, reading the unsent keys under the write lock.</summary>
    /// <param name="gate">The locks of the local database.</param>
    /// <param name="readPendingKeyTexts">Reads this table's unsent keys at the moment it is called.</param>
    /// <param name="keptByChildren">Keys of this table that rows the propagation of child tables kept refer to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The keys that went, and the parents in other tables that the rows kept here refer to.</returns>
    Task<SyncPropagationOutcome> PropagateDeletesAsync(
        SyncLocalGate gate,
        Func<CancellationToken, Task<IReadOnlySet<string>>> readPendingKeyTexts,
        IReadOnlySet<string> keptByChildren,
        CancellationToken cancellationToken
    );

    /// <summary>Whether some table of the diagram refers to this one (what a refused delete is reported by).</summary>
    bool IsReferenced { get; }

    /// <summary>Returns the tables outside the given scope whose local rows refer to a local row of this table (what a refresh refuses to run for).</summary>
    /// <param name="scopeTableNames">The tables the refresh covers.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlyList<string>> FindReferencesFromOutsideAsync(
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    );

    /// <summary>Reads the local row and the parents it refers to (empty when the row is gone or refers to nothing).</summary>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<(object? LocalRow, IReadOnlyList<(string TableName, string KeyText)> Parents)> ReadLocalParentsAsync(
        string keyText,
        CancellationToken cancellationToken
    );

    /// <summary>Reads the server's row (null when the server does not have it).</summary>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<object?> ReadServerRowAsync(string keyText, CancellationToken cancellationToken);

    /// <summary>Returns which of the given keys the local table holds a row for (what decides the operation a replay sends).</summary>
    /// <param name="keyTexts">The keys, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<IReadOnlySet<string>> FindLocalKeyTextsAsync(
        IReadOnlyCollection<string> keyTexts,
        CancellationToken cancellationToken
    );

    /// <summary>
    /// Overwrites the named local rows with the server's copies (see <see cref="ISyncTable.ApplyServerRowsAsync"/>),
    /// bringing in the parents they refer to first; a row whose parent cannot be had, or whose unique values collide with
    /// another local row, is left as it is and handed back.
    /// </summary>
    /// <param name="keyTexts">The keys, in the journal's text form.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried down as well.</param>
    /// <param name="removeLocalRowsMissingOnServer">
    /// Whether a named row the server does not have is removed locally first (when nothing local refers to it), so the
    /// rows put back do not collide with it - what the delete propagation would do later in the run.
    /// </param>
    /// <param name="resolver">Brings in the missing parents it may.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The rows applied, the keys left alone, and the keys of the local rows removed.</returns>
    Task<(
        IReadOnlyList<SyncAppliedServerRow> Applied,
        IReadOnlyList<string> Held,
        IReadOnlyList<string> Removed
    )> ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        bool removeLocalRowsMissingOnServer,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    );

    /// <summary>Rewrites a key text an earlier version wrote into today's form, or null when the table's form has not changed.</summary>
    Func<string, string>? NormalizeKeyText { get; }

    /// <summary>Whether the local row's unique values are held by another row on the server (false when the local row is gone).</summary>
    /// <param name="keyText">The row's key, in the journal's text form.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> CollidesOnServerAsync(string keyText, CancellationToken cancellationToken);

    /// <summary>Reloads the emptied table (see <see cref="ISyncTable.RefreshAsync"/>), bringing in first the parents a row refers to and the reload has not reached.</summary>
    /// <param name="ceiling">The exclusive upper bound of the reload.</param>
    /// <param name="batchSize">How many rows one batch fetches and inserts.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="resolver">Brings in the missing parents (one for the whole refresh).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    );
}

/// <summary>
/// The shared half of one synchronised table: the pieces that do not depend on whether the table carries a version
/// column - batch application, delete propagation, the local wipe of a refresh, the unbounded-binary column copy,
/// and the last-write-wins replay of a journal entry.
/// </summary>
/// <remarks>
/// The two shapes a table can take derive from this: <see cref="SyncTable{TEntity, TKey}"/> for a table with a
/// version column (incremental download, version-guarded replay) and <see cref="VersionlessSyncTable{TEntity, TKey}"/>
/// for one without (full key-ordered download, last-write-wins replay). They are classes rather than a flag because
/// the two differ in what they are able to promise, not in how they are configured.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class SyncTableBase<TEntity, TKey> : ISyncTable, ISyncTableRunSupport
    where TEntity : EntityBaseCore, new()
{
    /// <summary>The local repository, reached through the journaling decorator (engine writes suppress the recording).</summary>
    protected readonly IRepositoryCore<TEntity, TKey> _local;

    /// <summary>The local raw SQL surface (key sets, the derived anchor, the wipe of a refresh).</summary>
    protected readonly ISqlExecutor _localSqlExecutor;

    /// <summary>The server side: where changed rows and key sets come from, and where local changes are replayed to.</summary>
    protected readonly ISyncServerSource<TEntity, TKey> _server;

    /// <summary>The table's generated descriptor (its name, its SQL, and how a key and a version are read and written).</summary>
    protected readonly SyncTableDescriptor<TEntity, TKey> _descriptor;

    /// <summary>The local side's unbounded binary columns, built once because a copy asks for them per row.</summary>
    private readonly ISyncBinaryColumns<TKey>? _localBinaryColumns;

    /// <summary>
    /// The journal of the local database this table writes to: the receipts an upload records before it sends the
    /// blobs, and the copies of blobs a download still owes.
    /// </summary>
    /// <remarks>
    /// Built over the table's own local executor, which is the executor the engine's journal sits on, so both write the
    /// same tables of the same database.
    /// </remarks>
    private protected readonly SyncJournal _localJournal;

    /// <summary>The save hooks of the local repository, or null when the table was built without them.</summary>
    private readonly ISaveHookRegistry? _localSaveHooks;

    /// <summary>Creates the table with its local repository, the local raw SQL surface, the server source, and its descriptor.</summary>
    /// <param name="local">The local repository.</param>
    /// <param name="localSqlExecutor">The local raw SQL surface.</param>
    /// <param name="server">The server source.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="localSaveHooks">The save hooks the local repository runs (the registry it was given); null when it runs none.</param>
    protected SyncTableBase(
        IRepositoryCore<TEntity, TKey> local,
        ISqlExecutor localSqlExecutor,
        ISyncServerSource<TEntity, TKey> server,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISaveHookRegistry? localSaveHooks = null
    )
    {
        ArgumentNullException.ThrowIfNull(local);
        ArgumentNullException.ThrowIfNull(localSqlExecutor);
        ArgumentNullException.ThrowIfNull(server);
        ArgumentNullException.ThrowIfNull(descriptor);
        _local = local;
        _localSqlExecutor = localSqlExecutor;
        _server = server;
        _descriptor = descriptor;
        _localBinaryColumns =
            descriptor.UnboundedBinaryColumnNames.Count == 0
                ? null
                : new SyncRepositoryBinaryColumns<TEntity, TKey>(descriptor, local);
        _localJournal = new SyncJournal(localSqlExecutor);
        _localSaveHooks = localSaveHooks;
    }

    /// <inheritdoc />
    public string TableName => _descriptor.TableName;

    /// <inheritdoc />
    public Type EntityType => typeof(TEntity);

    /// <inheritdoc />
    public bool IsVersionless => _descriptor.IsVersionless;

    /// <summary>The local side's unbounded binary columns, or null when the table has none.</summary>
    /// <remarks>
    /// Null exactly when the descriptor names no such column; the two sides are asked separately because either one can
    /// be absent, and a copy needs both.
    /// </remarks>
    protected ISyncBinaryColumns<TKey>? LocalBinaryColumns => _localBinaryColumns;

    /// <inheritdoc />
    /// <remarks>
    /// The descriptor's own list, which is also what the local copy iterates, so the names the engine reads and the
    /// names the copy walks cannot come apart.
    /// </remarks>
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <summary>SELECT that returns every local primary key.</summary>
    protected string LocalKeysSql => _descriptor.LocalKeysSql;

    /// <summary>SELECT that returns the local primary keys within a given set (bound as the collection parameter <c>@keys</c>).</summary>
    protected string LocalExistingKeysSql => _descriptor.LocalExistingKeysSql;

    /// <summary>DELETE that empties the local table (the first half of a refresh).</summary>
    protected string LocalDeleteAllSql => _descriptor.LocalDeleteAllSql;

    /// <summary>Reads the entity's primary key.</summary>
    protected TKey ReadKey(TEntity entity) => _descriptor.ReadKey(entity);

    /// <summary>Writes the entity's primary key (used to build the stub a version-guarded delete is sent as).</summary>
    protected void WriteKey(TEntity entity, TKey key) => _descriptor.WriteKey(entity, key);

    /// <summary>Renders a primary key into the text form the journal stores.</summary>
    public string FormatKey(TKey key) => _descriptor.FormatKey(key);

    /// <summary>Parses a primary key back out of the journal's text form.</summary>
    public TKey ParseKey(string keyText) => _descriptor.ParseKey(keyText);

    /// <inheritdoc />
    public virtual Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => _server.GetChangeCeilingAsync(cancellationToken);

    /// <inheritdoc />
    /// <remarks>The download that knows of no unsent local change and of no outstanding acknowledgement.</remarks>
    public virtual async Task<int> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) =>
        (
            await DownloadAsync(
                ceiling,
                batchSize,
                includeUnboundedBinary,
                SyncDownloadContext.Empty,
                cancellationToken
            )
                .ConfigureAwait(false)
        ).Applied;

    /// <inheritdoc />
    public abstract Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public abstract Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    );

    /// <summary>The reload behind <see cref="RefreshAsync(byte[], int, bool, CancellationToken)"/>, bringing in missing parents through the resolver when there is one.</summary>
    private protected abstract Task<int> RefreshCoreAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    );

    /// <inheritdoc />
    Task<int> ISyncTableRunSupport.RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    ) => RefreshCoreAsync(ceiling, batchSize, includeUnboundedBinary, resolver, cancellationToken);

    /// <inheritdoc />
    public abstract Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    );

    /// <summary>The later of two server versions (null and empty both mean "no version at all").</summary>
    /// <remarks>See <see cref="SyncRowVersions.Max"/>.</remarks>
    private protected static byte[]? MaxRowVersion(byte[]? left, byte[]? right) =>
        SyncRowVersions.Max(left, right);

    /// <summary>
    /// Replays one journal entry without version guards: the local change overwrites whatever the server holds.
    /// </summary>
    /// <remarks>
    /// One code path for every table. An upsert re-reads the current local row (nothing to send is a stale intent,
    /// discarded), overwrites the server's row with <see cref="ConcurrencyMode.ForceOverwrite"/>, and inserts it when
    /// the update finds no row - which also means a row deleted on the server is resurrected by a local edit, exactly
    /// what last-write-wins promises. A delete needs no version, but it does re-read the local row for the reason an
    /// upsert does: a row that is still there says the business delete never landed, which makes the entry a stale
    /// intent rather than something to carry out on the server. A delete of a row the server no longer has is a no-op.
    /// Nothing can conflict, so nothing is ever collected.
    /// </remarks>
    protected async Task<SyncUploadOutcome> UploadLastWriteWinsAsync(
        SyncJournalRow entry,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var key = ParseKey(entry.KeyText);

        if (
            string.Equals(
                entry.Operation,
                nameof(SyncJournalOperation.Delete),
                StringComparison.Ordinal
            )
        )
        {
            if (await LocalRowSurvivedDeleteAsync(key, cancellationToken).ConfigureAwait(false))
            {
                return SyncUploadOutcome.Discarded;
            }

            await _server.Writer.DeleteAsync(key, cancellationToken).ConfigureAwait(false);

            return SyncUploadOutcome.Uploaded;
        }

        var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);

        if (local is null)
        {
            // A journal-first entry whose business write never landed, or a row deleted afterwards. Nothing to send.
            return SyncUploadOutcome.Discarded;
        }

        // The row was read without its unbounded binary columns, so a NOT NULL one may hold nothing at all, which an
        // insert on the server would refuse; an update never writes these columns, so the empty value goes nowhere.
        _descriptor.FillUnsetUnboundedBinaries(local);

        var inserted = await ForceOverwriteOrInsertAsync(local, cancellationToken)
            .ConfigureAwait(false);
        var columns = ColumnsToSend(entry, inserted, includeUnboundedBinary);

        if (inserted)
        {
            await KeepInsertedBlobsOwedAsync(entry, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        if (columns.Count > 0)
        {
            await RecordInterimAckAsync(entry, local, cancellationToken).ConfigureAwait(false);
            await CopyBinaryColumnsUpAsync(key, columns, cancellationToken).ConfigureAwait(false);
        }

        if (!inserted)
        {
            await OweUnsentBlobCopiesAsync(entry.KeyText, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        return SyncUploadOutcome.UploadedWith(
            await ReadServerRowVersionAsync(local, columns.Count > 0, cancellationToken)
                .ConfigureAwait(false)
        );
    }

    /// <summary>
    /// Records the version the server gave the row it has just taken, before its unbounded binary columns are sent.
    /// </summary>
    /// <remarks>
    /// The row has reached the server once the write returns, and the blobs that follow are separate writes that can
    /// fail on their own. Without a receipt in between, a failed blob copy leaves the entry in the journal with the
    /// mirrored version behind the server's, and the next run reports a conflict against the row this device wrote
    /// itself. The run overwrites the receipt with the version read back after the blobs, as it always does.
    /// </remarks>
    private protected async Task RecordInterimAckAsync(
        SyncJournalRow entry,
        TEntity sent,
        CancellationToken cancellationToken
    )
    {
        if (IsVersionless || _descriptor.ReadRowVersion(sent) is not { Length: > 0 } version)
        {
            return;
        }

        await _localJournal
            .RecordAckAsync(TableName, entry.KeyText, version, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Reads the version the server now holds for a row an upsert has just sent.</summary>
    /// <remarks>
    /// The writer stamps the row it accepted, so the entity in hand already carries the new version. Writing a blob is
    /// another write to the same row, so where the excluded columns were carried the stamp in hand is behind by one and
    /// the server row is read once more. A table without a version column has nothing to report.
    /// </remarks>
    /// <param name="local">The row that was sent, as the writer left it.</param>
    /// <param name="copiedUnboundedBinary">Whether any unbounded binary column was sent after the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task<byte[]?> ReadServerRowVersionAsync(
        TEntity local,
        bool copiedUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        if (IsVersionless)
        {
            return null;
        }

        if (copiedUnboundedBinary)
        {
            var refreshed = await _server
                .Writer.GetByIdAsync(ReadKey(local), cancellationToken)
                .ConfigureAwait(false);

            if (refreshed is not null)
            {
                return _descriptor.ReadRowVersion(refreshed);
            }
        }

        return _descriptor.ReadRowVersion(local);
    }

    /// <summary>Overwrites the server's row without a version guard, inserting it when the update finds no row. Returns whether it inserted.</summary>
    /// <remarks>
    /// The two halves belong together: an update that matches nothing means the server no longer holds the row, and
    /// putting it back is what "the local change wins" amounts to. Shared by the last-write-wins replay and by the
    /// <see cref="SyncConflictPolicy.LocalWins"/> resolution of a version-guarded one, so the two say the same thing.
    /// </remarks>
    /// <param name="local">The current local row, which becomes the server's.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task<bool> ForceOverwriteOrInsertAsync(
        TEntity local,
        CancellationToken cancellationToken
    )
    {
        local.MarkUpdated();
        var updated = await _server
            .Writer.UpdateAsync(local, ConcurrencyMode.ForceOverwrite, cancellationToken)
            .ConfigureAwait(false);

        if (updated)
        {
            return false;
        }

        local.MarkAdded();
        await _server.Writer.InsertAsync(local, cancellationToken).ConfigureAwait(false);

        return true;
    }

    /// <summary>The unbounded binary columns an upload sends after the row: every one for a row it inserted, otherwise the ones the entry's writes stored a value in.</summary>
    /// <remarks>
    /// A row the server is given for the first time - an offline insert, a row a local edit puts back after the server
    /// deleted it, a row created again here - gets its blobs from this device or not at all, so every column goes, as an
    /// ordinary insert writes them. An update leaves the server's blobs in place, so only the columns written here go
    /// (see <see cref="UnboundedBinaryColumnsOf"/>).
    /// </remarks>
    /// <param name="entry">The replayed entry.</param>
    /// <param name="inserted">Whether the row was inserted on the server.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    private protected IReadOnlyList<string> ColumnsToSend(
        SyncJournalRow entry,
        bool inserted,
        bool includeUnboundedBinary
    ) =>
        !includeUnboundedBinary ? []
        : inserted ? UnboundedBinaryColumnNames
        : UnboundedBinaryColumnsOf(entry);

    /// <summary>Keeps every unbounded binary column owed by the entry of a row the upload has just inserted, before they are sent.</summary>
    /// <remarks>See <see cref="SyncJournal.WidenUnboundedBinaryColumnsAsync"/>.</remarks>
    /// <param name="entry">The replayed entry (its id is the newest of the row's entries, which are read together).</param>
    /// <param name="columns">The columns about to be sent.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task KeepInsertedBlobsOwedAsync(
        SyncJournalRow entry,
        IReadOnlyList<string> columns,
        CancellationToken cancellationToken
    )
    {
        if (columns.Count == 0 || columns.Count == UnboundedBinaryColumnsOf(entry).Count)
        {
            return;
        }

        using (SyncSession.Suppress())
        {
            await _localJournal
                .WidenUnboundedBinaryColumnsAsync(entry.Id, columns, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Records, after a write that overwrote the server's row without a version guard, a copy down of each unbounded
    /// binary column the upload did not send.
    /// </summary>
    /// <remarks>
    /// The overwrite leaves the server's blobs as they were, and those may be another writer's, newer than the ones
    /// here. The row that comes back down is this device's own echo, which the download recognises by its receipt and
    /// does not copy anything for - so without this the blobs would differ for good. The copy is made by the next run
    /// that carries the columns (<see cref="CopyOwedBlobsAsync"/>), which leaves a column alone if a later local write
    /// stored a value in it.
    /// </remarks>
    /// <param name="keyText">The row's key text.</param>
    /// <param name="sent">The columns the upload sent.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task OweUnsentBlobCopiesAsync(
        string keyText,
        IReadOnlyList<string> sent,
        CancellationToken cancellationToken
    )
    {
        if (_server.BinaryColumns is null || LocalBinaryColumns is null)
        {
            return;
        }

        var unsent = UnboundedBinaryColumnNames
            .Where(column => !sent.Contains(column, StringComparer.Ordinal))
            .ToList();

        if (unsent.Count > 0)
        {
            await _localJournal
                .RecordBlobCopiesAsync(TableName, [keyText], unsent, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <summary>Whether the local row a delete entry speaks for is still there (the delete never landed).</summary>
    /// <remarks>
    /// The journal records the intent before the business delete runs, so an entry can outlive a delete a foreign key
    /// or a lock refused. Removing the server's row on the strength of such an entry would let a failed local
    /// operation finish itself on the server - and the delete propagation of the same run would then take the
    /// surviving local row with it. An upsert is already protected by re-reading the row it sends; this is the same
    /// guard for the one operation that has nothing to re-read.
    /// </remarks>
    /// <param name="key">The key the entry names.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task<bool> LocalRowSurvivedDeleteAsync(
        TKey key,
        CancellationToken cancellationToken
    ) => await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false) is not null;

    /// <summary>Inserts one batch of a refresh into the emptied table, with its blobs when the run carries them.</summary>
    /// <remarks>
    /// With a resolver, the parents the rows refer to and the reload has not reached are brought in first - a parent of
    /// the same table changed after its child comes later in version order, possibly in a later batch. A row brought in
    /// that way is already there when its own batch arrives, so it is saved over rather than inserted a second time.
    /// A row whose parent cannot be had is inserted all the same and fails on the local foreign key, as it always did.
    /// </remarks>
    private protected async Task<int> InsertRefreshedRowsAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        var inserted = 0;
        IReadOnlyList<TEntity> again = [];

        if (resolver is not null)
        {
            await FindRowsMissingParentsAsync(rows, resolver, cancellationToken)
                .ConfigureAwait(false);
            var broughtIn = resolver.BroughtIn(TableName);

            if (broughtIn.Count > 0)
            {
                again = rows.Where(row => broughtIn.Contains(FormatKey(ReadKey(row)))).ToList();
                rows = rows.Where(row => !broughtIn.Contains(FormatKey(ReadKey(row)))).ToList();
            }
        }

        foreach (var row in rows)
        {
            _descriptor.FillUnsetUnboundedBinaries(row);
        }

        await WriteRowsAndBlobsAsync(
                rows,
                includeUnboundedBinary,
                async () =>
                {
                    using (SyncSession.Suppress())
                    {
                        inserted = await _local
                            .BulkInsertAsync(rows, cancellationToken)
                            .ConfigureAwait(false);
                    }

                    return true;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        if (again.Count > 0)
        {
            await ApplyBatchAsync(again, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false);
            inserted += again.Count;
        }

        return inserted;
    }

    /// <summary>
    /// Works out which of the rows about to be applied cannot be, because a parent they refer to is neither in the
    /// local database nor one the resolver may bring in; the ones it may are brought in on the way.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A parent that is an earlier row of the same list, or the row itself, is taken to be there, since it is applied
    /// first - unless that row cannot be applied either. A parent later in the list is brought in ahead of it like any
    /// other missing parent, and written again when its own turn comes: the rows of a download are committed in the
    /// order they arrived, and that order is what keeps the derived resume point honest.
    /// </para>
    /// <para>
    /// Rows applied together in no particular order - what <see cref="SyncConflictPolicy.ServerWins"/> puts back, or
    /// parents brought in - pass <paramref name="inAnyOrder"/>: a parent anywhere in the list is taken to be there
    /// unless it cannot be applied either, and the caller puts the rows in parent-first order
    /// (<see cref="ParentsFirst"/>) before applying them.
    /// </para>
    /// </remarks>
    /// <param name="rows">The rows, in the order they would be applied.</param>
    /// <param name="resolver">Brings in the missing parents it may (null: no parent is looked at).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <param name="inAnyOrder">Whether a parent later in the list counts as well.</param>
    /// <returns>The rows that cannot be applied, by index, each with the table of the parent it lacks.</returns>
    private protected async Task<Dictionary<int, string>> FindRowsMissingParentsAsync(
        IReadOnlyList<TEntity> rows,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken,
        bool inAnyOrder = false
    )
    {
        var blocked = new Dictionary<int, string>();

        if (resolver is null || _descriptor.ParentReferences.Count == 0 || rows.Count == 0)
        {
            return blocked;
        }

        var positions = new Dictionary<string, int>(StringComparer.Ordinal);

        for (var index = 0; index < rows.Count; index++)
        {
            positions.TryAdd(FormatKey(ReadKey(rows[index])), index);
        }

        var parentsByRow = rows.Select(ReadParents).ToList();
        var missing = await resolver
            .EnsureAsync(
                parentsByRow.SelectMany(
                    (parents, index) =>
                        parents.Where(parent => EarlierRow(parent, index) is null)
                ),
                cancellationToken
            )
            .ConfigureAwait(false);

        // Repeated until nothing changes: in any order, a row can depend on one later in the list that is found
        // unable only afterwards.
        for (var changed = true; changed; )
        {
            changed = false;

            for (var index = 0; index < rows.Count; index++)
            {
                if (blocked.ContainsKey(index))
                {
                    continue;
                }

                foreach (var parent in parentsByRow[index])
                {
                    var cannot = EarlierRow(parent, index) is { } earlier
                        ? blocked.ContainsKey(earlier)
                        : missing.Contains(parent);

                    if (cannot)
                    {
                        blocked[index] = parent.TableName;
                        changed = true;
                        break;
                    }
                }
            }
        }

        return blocked;

        int? EarlierRow((string TableName, string KeyText) parent, int index) =>
            string.Equals(parent.TableName, TableName, StringComparison.Ordinal)
            && positions.TryGetValue(parent.KeyText, out var position)
            && (inAnyOrder || position <= index)
                ? position
                : null;
    }

    /// <summary>Puts rows applied together in no particular order into parent-first order within this table (a reference cycle keeps the order it has).</summary>
    private protected List<TEntity> ParentsFirst(IReadOnlyList<TEntity> rows)
    {
        if (_descriptor.ParentReferences.Count == 0 || rows.Count < 2)
        {
            return rows.ToList();
        }

        var byKey = new Dictionary<string, TEntity>(StringComparer.Ordinal);

        foreach (var row in rows)
        {
            byKey.TryAdd(FormatKey(ReadKey(row)), row);
        }

        var ordered = new List<TEntity>(rows.Count);
        var visited = new HashSet<string>(StringComparer.Ordinal);

        foreach (var row in rows)
        {
            Visit(row);
        }

        return ordered;

        void Visit(TEntity row)
        {
            if (!visited.Add(FormatKey(ReadKey(row))))
            {
                return;
            }

            foreach (var parent in ReadParents(row))
            {
                if (
                    string.Equals(parent.TableName, TableName, StringComparison.Ordinal)
                    && byKey.TryGetValue(parent.KeyText, out var parentRow)
                )
                {
                    Visit(parentRow);
                }
            }

            ordered.Add(row);
        }
    }

    /// <summary>Writes a batch of rows and, when the run carries them, copies their unbounded binary columns down.</summary>
    /// <remarks>
    /// The copies owed are recorded before the rows are written and dropped once they have been made. A copy that fails
    /// leaves its record behind, and the next run that carries the columns makes it first
    /// (<see cref="CopyOwedBlobsAsync"/>): the row itself is already in, its version has moved the resume point past
    /// it, and nothing else would ever bring its blob down.
    /// </remarks>
    /// <param name="rows">The rows of the batch.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="writeRows">Writes the rows themselves, returning false when they did not go in (a local save hook skipped them): no blob is copied then, and the records of the copies go.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task WriteRowsAndBlobsAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        Func<Task<bool>> writeRows,
        CancellationToken cancellationToken
    )
    {
        if (
            !includeUnboundedBinary
            || _server.BinaryColumns is null
            || LocalBinaryColumns is not { } local
            || rows.Count == 0
        )
        {
            await writeRows().ConfigureAwait(false);

            return;
        }

        var keyTexts = rows.Select(row => FormatKey(ReadKey(row))).ToList();
        await _localJournal
            .RecordBlobCopiesAsync(TableName, keyTexts, local.UnboundedBinaryColumnNames, cancellationToken)
            .ConfigureAwait(false);

        // After the rows, not with them: an excluded column is not part of the row, and the copy needs the row to be
        // there to write into.
        if (await writeRows().ConfigureAwait(false))
        {
            await CopyBinaryColumnsDownAsync(rows, cancellationToken).ConfigureAwait(false);
        }

        await _localJournal
            .RemoveBlobCopiesAsync(TableName, keyTexts, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Makes the blob copies an earlier run left owing for this table (when this run carries the columns).</summary>
    /// <remarks>
    /// <para>
    /// Decided per row and column, under the write lock when the engine drives the download:
    /// </para>
    /// <list type="bullet">
    /// <item>The local row is gone (deleted here, or by a delete propagation): there is nothing to copy into, and the
    /// record goes.</item>
    /// <item>An unsent entry of the row stored a value in that column: the local blob was written here since and is the
    /// newer one, so it is not copied over, and the record goes.</item>
    /// <item>The server no longer has the row: there is nothing to copy from - reading its column would come back
    /// empty, and writing that empty value into a NOT NULL column would fail on every run - so the record goes, and the
    /// row is left to the delete propagation.</item>
    /// <item>Otherwise - no unsent entry, or only entries that did not touch the column, such as an edit of the row's
    /// ordinary columns: the server's blob is copied down, and the record goes.</item>
    /// </list>
    /// <para>
    /// A download called without the engine knows which keys are unsent but not which columns their entries wrote, so
    /// a key with an unsent entry keeps its record for a run that does.
    /// </para>
    /// </remarks>
    /// <param name="context">The table's download context (what is unsent, and the lock).</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected async Task CopyOwedBlobsAsync(
        SyncDownloadContext context,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        if (
            !includeUnboundedBinary
            || _server.BinaryColumns is not { } server
            || LocalBinaryColumns is not { } local
        )
        {
            return;
        }

        if (context.Gate is { } gate && context.PendingReader is { } readPending)
        {
            await gate.WriteExclusiveAsync(
                    async () =>
                    {
                        var pending = await readPending(cancellationToken).ConfigureAwait(false);
                        await CopyOwedBlobsCoreAsync(
                                server,
                                local,
                                (keyText, column) =>
                                    pending.BinaryColumnsByKeyText.TryGetValue(keyText, out var written)
                                    && written.Contains(column),
                                _ => false,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        return true;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);

            return;
        }

        var pendingKeyTexts = context.PendingKeyTexts;
        await CopyOwedBlobsCoreAsync(
                server,
                local,
                (_, _) => false,
                pendingKeyTexts.Contains,
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>The body of <see cref="CopyOwedBlobsAsync"/>.</summary>
    /// <param name="server">The server's unbounded binary columns.</param>
    /// <param name="local">The local unbounded binary columns.</param>
    /// <param name="writtenHere">Whether an unsent entry of the row stored a value in the column.</param>
    /// <param name="keepRecord">Whether the row's records are kept as they are, for a run that can decide them.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task CopyOwedBlobsCoreAsync(
        ISyncBinaryColumns<TKey> server,
        ISyncBinaryColumns<TKey> local,
        Func<string, string, bool> writtenHere,
        Func<string, bool> keepRecord,
        CancellationToken cancellationToken
    )
    {
        var owed = await _localJournal
            .ReadBlobCopiesAsync(TableName, cancellationToken)
            .ConfigureAwait(false);

        if (owed.Count == 0)
        {
            return;
        }

        var keyTexts = owed.Select(copy => copy.KeyText)
            .Distinct(StringComparer.Ordinal)
            .Where(keyText => !keepRecord(keyText))
            .ToList();
        var present = await FindLocalKeyTextsAsync(keyTexts.Select(ParseKey), cancellationToken)
            .ConfigureAwait(false);

        // Asked once per row, and only for the rows a copy would be made for.
        var onServer = new Dictionary<string, bool>(StringComparer.Ordinal);

        using (SyncSession.Suppress())
        {
            foreach (var copy in owed)
            {
                if (
                    keepRecord(copy.KeyText)
                    || !present.Contains(copy.KeyText)
                    || writtenHere(copy.KeyText, copy.ColumnName)
                    || !local.UnboundedBinaryColumnNames.Contains(copy.ColumnName, StringComparer.Ordinal)
                )
                {
                    continue;
                }

                if (!onServer.TryGetValue(copy.KeyText, out var serverHasRow))
                {
                    serverHasRow =
                        await _server
                            .Writer.GetByIdAsync(ParseKey(copy.KeyText), cancellationToken)
                            .ConfigureAwait(false)
                            is not null;
                    onServer.Add(copy.KeyText, serverHasRow);
                }

                if (!serverHasRow)
                {
                    continue;
                }

                await CopyBinaryColumnAsync(
                        server,
                        local,
                        copy.ColumnName,
                        ParseKey(copy.KeyText),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }
        }

        await _localJournal
            .RemoveBlobCopiesAsync(TableName, keyTexts, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Copies every unbounded binary column of the given rows from the server down to the local database.</summary>
    /// <remarks>
    /// Suppressed as a whole: the local write goes through the journaling decorator like any other, and a downloaded
    /// blob recorded as a local change would be uploaded straight back on the next run.
    /// </remarks>
    protected async Task CopyBinaryColumnsDownAsync(
        IReadOnlyList<TEntity> rows,
        CancellationToken cancellationToken
    )
    {
        if (_server.BinaryColumns is not { } server || LocalBinaryColumns is not { } local)
        {
            return;
        }

        using (SyncSession.Suppress())
        {
            foreach (var row in rows)
            {
                var key = ReadKey(row);

                foreach (var column in local.UnboundedBinaryColumnNames)
                {
                    await CopyBinaryColumnAsync(server, local, column, key, cancellationToken)
                        .ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>The unbounded binary columns a journal entry says the row's writes stored a value in.</summary>
    /// <remarks>
    /// Only those are sent. A row this device has never had a blob for - one brought down by a run that did not carry
    /// the columns, and edited here since - would otherwise send its empty column over the server's blob.
    /// </remarks>
    private protected IReadOnlyList<string> UnboundedBinaryColumnsOf(SyncJournalRow entry) =>
        string.IsNullOrEmpty(entry.UnboundedBinaryColumns)
            ? []
            : entry
                .UnboundedBinaryColumns.Split(',')
                .Where(column => UnboundedBinaryColumnNames.Contains(column, StringComparer.Ordinal))
                .ToList();

    /// <summary>Copies the given unbounded binary columns of one row from the local database up to the server.</summary>
    protected async Task CopyBinaryColumnsUpAsync(
        TKey key,
        IReadOnlyList<string> columns,
        CancellationToken cancellationToken
    )
    {
        if (
            columns.Count == 0
            || _server.BinaryColumns is not { } server
            || LocalBinaryColumns is not { } local
        )
        {
            return;
        }

        using (SyncSession.Suppress())
        {
            foreach (var column in columns)
            {
                await CopyBinaryColumnAsync(local, server, column, key, cancellationToken)
                    .ConfigureAwait(false);
            }
        }
    }

    /// <summary>Copies one column of one row from one side to the other.</summary>
    /// <remarks>
    /// <para>
    /// The two accessors meet in the middle rather than end to end: reading pushes the bytes into a stream that is
    /// handed to it, writing pulls them out of a stream that is handed to it, and a stream cannot be both. A temporary
    /// file is what joins them without either side holding the blob in memory - and it answers the other question the
    /// write asks, since a length has to be known up front and the finished file reports its own. It lives in the
    /// operating system's temporary folder and is removed once the column has been written.
    /// </para>
    /// <para>
    /// A source column that is NULL (or a row the source no longer has) clears the destination rather than leaving what
    /// was there: the point of carrying these columns is that the two sides end up alike, and a stale blob under a row
    /// whose server copy has none is exactly the disagreement this is here to remove.
    /// </para>
    /// </remarks>
    private static async Task CopyBinaryColumnAsync(
        ISyncBinaryColumns<TKey> from,
        ISyncBinaryColumns<TKey> to,
        string columnName,
        TKey key,
        CancellationToken cancellationToken
    )
    {
        var path = Path.Combine(
            Path.GetTempPath(),
            "quicker-sync-" + Guid.NewGuid().ToString("n") + ".tmp"
        );

        try
        {
            bool present;

            await using (
                var destination = new FileStream(
                    path,
                    FileMode.Create,
                    FileAccess.Write,
                    FileShare.None,
                    bufferSize: 81920,
                    useAsync: true
                )
            )
            {
                present = await from.ReadUnboundedBinaryAsync(
                    columnName,
                    key,
                    destination,
                    cancellationToken
                )
                    .ConfigureAwait(false);
            }

            if (!present)
            {
                await to.WriteUnboundedBinaryAsync(columnName, key, null, null, cancellationToken)
                    .ConfigureAwait(false);

                return;
            }

            await using var source = new FileStream(
                path,
                FileMode.Open,
                FileAccess.Read,
                FileShare.Read,
                bufferSize: 81920,
                useAsync: true
            );
            await to.WriteUnboundedBinaryAsync(
                columnName,
                key,
                source,
                source.Length,
                cancellationToken
            )
                .ConfigureAwait(false);
        }
        finally
        {
            // Swallowed on purpose: this runs while an exception from the copy itself may be in flight, and letting a
            // failure to delete replace it would erase why the copy failed. What is lost by ignoring it is one
            // temporary file left in the operating system's temporary folder.
            try
            {
                File.Delete(path);
            }
            catch
            {
                // Nothing to do here - see above.
            }
        }
    }

    /// <summary>Returns which of the given keys the local table holds a row for, in the journal's text form.</summary>
    /// <remarks>
    /// The lookup is chunked to <see cref="SyncInClause.ChunkSize"/> keys per statement; the list of keys is the
    /// caller's to size, so it is not bounded on its own.
    /// </remarks>
    private async Task<IReadOnlySet<string>> FindLocalKeyTextsAsync(
        IEnumerable<TKey> keys,
        CancellationToken cancellationToken
    )
    {
        var found = new HashSet<string>(StringComparer.Ordinal);

        foreach (var chunk in keys.Chunk(SyncInClause.ChunkSize))
        {
            var existing = await _localSqlExecutor
                .QueryProjectionBySqlAsync<TKey>(
                    LocalExistingKeysSql,
                    new { keys = chunk },
                    cancellationToken
                )
                .ConfigureAwait(false);

            foreach (var key in existing)
            {
                found.Add(FormatKey(key));
            }
        }

        return found;
    }

    /// <inheritdoc />
    Task<IReadOnlySet<string>> ISyncTableRunSupport.FindLocalKeyTextsAsync(
        IReadOnlyCollection<string> keyTexts,
        CancellationToken cancellationToken
    ) => FindLocalKeyTextsAsync(keyTexts.Select(ParseKey), cancellationToken);

    /// <summary>Runs the part of one download batch that reads what is unsent and acts on it, under the write lock.</summary>
    /// <remarks>
    /// <para>
    /// When the engine drives the download, what is unsent is read afresh inside the lock, so a local write made since
    /// the run began is seen before the batch can overwrite or skip it. A download called without that (directly, with
    /// a context of its own) acts on the keys it was handed and takes no lock.
    /// </para>
    /// <para>
    /// A row is held back when its own key holds an unsent entry, or when it refers to a parent whose local delete has
    /// not been sent yet. Applying the second kind would fail on the local foreign key: the parent is gone here, and
    /// the server still has it only because the delete has not reached it - typically because the server refused it, a
    /// row like this one having been added there by another device in the meantime.
    /// </para>
    /// </remarks>
    /// <param name="context">The table's download context.</param>
    /// <param name="body">Decides about the batch and applies it, given which rows are held back at that moment and the resolver the batch brings its missing parents in through (null when the engine does not drive the download).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private protected Task<T> RunBatchSectionAsync<T>(
        SyncDownloadContext context,
        Func<Func<TEntity, (bool Held, string? ParentTableName)>, SyncParentResolver?, Task<T>> body,
        CancellationToken cancellationToken
    )
    {
        if (context.Gate is not { } gate || context.PendingReader is not { } readPending)
        {
            var pendingKeyTexts = context.PendingKeyTexts;

            return body(row => (pendingKeyTexts.Contains(FormatKey(ReadKey(row))), null), null);
        }

        return gate.WriteExclusiveAsync(
            async () =>
            {
                var pending = await readPending(cancellationToken).ConfigureAwait(false);

                return await body(
                        row => HoldOf(row, pending),
                        context.ParentResolverFactory?.Invoke(pending)
                    )
                    .ConfigureAwait(false);
            },
            cancellationToken
        );
    }

    /// <summary>Whether the row is held back from a download batch, and the table of the parent that holds it back when it is a parent (see <see cref="RunBatchSectionAsync"/>).</summary>
    private (bool Held, string? ParentTableName) HoldOf(TEntity row, SyncPendingSnapshot pending)
    {
        if (pending.KeyTexts.Contains(FormatKey(ReadKey(row))))
        {
            return (true, null);
        }

        foreach (var reference in _descriptor.ParentReferences)
        {
            if (
                reference.ReadParentKeyText(row) is { } parentKeyText
                && pending.DeletedKeyTextsByTable.TryGetValue(reference.ParentTableName, out var deleted)
                && deleted.Contains(parentKeyText)
            )
            {
                return (true, reference.ParentTableName);
            }
        }

        return (false, null);
    }

    /// <summary>Applies one ordered batch of server rows to the local database.</summary>
    /// <remarks>
    /// The rows go in as <see cref="ApplyBatchCoreAsync"/> writes them. A row a local save hook skips stops the batch
    /// there, which this method reports by throwing: the rows before it are in, and the row and the ones after it are
    /// not.
    /// </remarks>
    /// <exception cref="InvalidOperationException">A local save hook skipped a row of the batch.</exception>
    protected async Task ApplyBatchAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var skippedAt = await ApplyBatchCoreAsync(rows, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);

        if (skippedAt >= 0)
        {
            throw new InvalidOperationException(
                $"A local save hook skipped the row '{FormatKey(ReadKey(rows[skippedAt]))}' of '{TableName}', so "
                    + "the batch was applied only up to that row."
            );
        }
    }

    /// <summary>
    /// Applies one ordered batch of server rows to the local database and returns the index of the row a local save
    /// hook skipped (-1 when every row went in); that row and the rows after it are not applied.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A table whose local repository runs no save hook for its entity writes the batch with one graph save, which is
    /// one local transaction. A table built with the hooks the repository runs (<see cref="SyncTableBase{TEntity, TKey}"/>'s
    /// <c>localSaveHooks</c>) that has one for its entity writes the rows one at a time instead, each in its own save:
    /// a Before that returns false skips its row, and the rows after it must not go in, or the resume point derived from
    /// the local rows would move past the skipped row and the row would never come down again. The cost is one save,
    /// one transaction, per row.
    /// </para>
    /// <para>
    /// A row a hook skips in a table built without the hooks is found only after the whole batch has gone in, the rows
    /// after it included, so it is reported as an error rather than as a stop.
    /// </para>
    /// <para>
    /// The lookup that decides insert from update is chunked to <see cref="SyncInClause.ChunkSize"/> keys per
    /// statement; the batch size is the caller's to choose, so the list of keys is not bounded on its own.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">A local save hook skipped a row of a table built without the hooks.</exception>
    private protected async Task<int> ApplyBatchCoreAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var existingKeys = await FindLocalKeyTextsAsync(rows.Select(ReadKey), cancellationToken)
            .ConfigureAwait(false);

        foreach (var row in rows)
        {
            if (existingKeys.Contains(FormatKey(ReadKey(row))))
            {
                row.MarkUpdated();
            }
            else
            {
                row.MarkAdded();
                _descriptor.FillUnsetUnboundedBinaries(row);
            }
        }

        if (_localSaveHooks?.GetInvoker(typeof(TEntity)) is null)
        {
            await WriteRowsAndBlobsAsync(
                    rows,
                    includeUnboundedBinary,
                    async () =>
                    {
                        await SaveAppliedRowsAsync(rows, cancellationToken).ConfigureAwait(false);

                        return true;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);

            var skipped = FindSkippedRow(rows);

            if (skipped >= 0)
            {
                throw new InvalidOperationException(
                    $"A local save hook skipped the row '{FormatKey(ReadKey(rows[skipped]))}' of '{TableName}' "
                        + "while the sync engine applied it, but the table was built without the save hooks the local "
                        + "repository runs, so the rows after it were applied as well and the resume point has moved "
                        + "past it. Build the table with the save hook registry the local repository is given."
                );
            }

            return -1;
        }

        for (var index = 0; index < rows.Count; index++)
        {
            IReadOnlyList<TEntity> row = [rows[index]];
            var written = false;

            await WriteRowsAndBlobsAsync(
                    row,
                    includeUnboundedBinary,
                    async () =>
                    {
                        await SaveAppliedRowsAsync(row, cancellationToken).ConfigureAwait(false);
                        written = FindSkippedRow(row) < 0;

                        return written;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);

            if (!written)
            {
                return index;
            }
        }

        return -1;
    }

    /// <summary>Writes the rows with one graph save of the local repository, without recording them.</summary>
    /// <remarks>
    /// The applied rows are flat, so no cascade is wanted. ForceOverwrite is deliberate: the server's row is the truth
    /// here, and the local engine has no version to guard.
    /// </remarks>
    private async Task SaveAppliedRowsAsync(
        IReadOnlyList<TEntity> rows,
        CancellationToken cancellationToken
    )
    {
        using (SyncSession.Suppress())
        {
            await _local
                .SaveAsync(
                    rows,
                    cascadeSave: false,
                    cascadeDelete: false,
                    insertWhenUpdateMissing: false,
                    ConcurrencyMode.ForceOverwrite,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>The index of the first row a save left in its state - one a save hook skipped - or -1 when there is none.</summary>
    private static int FindSkippedRow(IReadOnlyList<TEntity> rows)
    {
        for (var index = 0; index < rows.Count; index++)
        {
            if (rows[index].RowState != RowState.Unchanged)
            {
                return index;
            }
        }

        return -1;
    }

    /// <inheritdoc />
    /// <remarks>
    /// The rows go through the same batch application a download uses, so a key the local database does not have is
    /// put back rather than skipped - a row deleted locally and still held by the server returns, which is the
    /// server winning over a delete exactly as it wins over an edit. A restored row carries no mirrored version until
    /// a download reaches it in order: it may not have one to keep, and the server's own is the one version that must
    /// not be written here.
    /// </remarks>
    public async Task<IReadOnlyList<SyncAppliedServerRow>> ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(keyTexts);

        var (applied, _, _) = await ApplyServerRowsCoreAsync(
                keyTexts,
                includeUnboundedBinary,
                removeLocalRowsMissingOnServer: false,
                null,
                cancellationToken
            )
            .ConfigureAwait(false);

        return applied;
    }

    /// <inheritdoc />
    Task<(
        IReadOnlyList<SyncAppliedServerRow> Applied,
        IReadOnlyList<string> Held,
        IReadOnlyList<string> Removed
    )> ISyncTableRunSupport.ApplyServerRowsAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        bool removeLocalRowsMissingOnServer,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    ) =>
        ApplyServerRowsCoreAsync(
            keyTexts,
            includeUnboundedBinary,
            removeLocalRowsMissingOnServer,
            resolver,
            cancellationToken
        );

    /// <inheritdoc />
    async Task<bool> ISyncTableRunSupport.CollidesOnServerAsync(
        string keyText,
        CancellationToken cancellationToken
    )
    {
        var local = await _local.GetByIdAsync(ParseKey(keyText), cancellationToken)
            .ConfigureAwait(false);

        return local is not null
            && (
                await _server
                    .Writer.CheckUniquenessAsync(local, cancellationToken)
                    .ConfigureAwait(false)
            ).Count > 0;
    }

    /// <summary>Overwrites the named local rows with the server's copies, bringing in their missing parents through the resolver when there is one.</summary>
    /// <returns>The rows applied, the keys of the rows left alone (a parent that cannot be had, or a unique value another local row holds), and the keys of the local rows removed.</returns>
    private async Task<(
        IReadOnlyList<SyncAppliedServerRow> Applied,
        IReadOnlyList<string> Held,
        IReadOnlyList<string> Removed
    )> ApplyServerRowsCoreAsync(
        IReadOnlyList<string> keyTexts,
        bool includeUnboundedBinary,
        bool removeLocalRowsMissingOnServer,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        var rows = new List<TEntity>(keyTexts.Count);
        var applied = new List<SyncAppliedServerRow>(keyTexts.Count);
        var missingOnServer = new Dictionary<string, TKey>(StringComparer.Ordinal);

        foreach (var keyText in keyTexts)
        {
            cancellationToken.ThrowIfCancellationRequested();

            var key = ParseKey(keyText);
            var server = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            if (server is null)
            {
                missingOnServer[keyText] = key;

                continue;
            }

            // Read before it is replaced: this is the version the content about to be applied belongs to, and the
            // only place it survives the write below.
            var serverRowVersion = _descriptor.ReadRowVersion(server);

            // The version has to keep saying how far this device's ordered stream reached, so the local row's own is
            // put back onto the server's copy before it is applied - see the interface for what writing the server's
            // would cost. A row the local database does not have keeps whatever the descriptor makes of "no version",
            // which is the same thing a row created locally starts with.
            var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);
            _descriptor.WriteRowVersion(
                server,
                local is null ? null : _descriptor.ReadRowVersion(local)
            );
            rows.Add(server);
            applied.Add(new SyncAppliedServerRow(keyText, serverRowVersion));
        }

        IReadOnlyList<string> removed = [];

        if (removeLocalRowsMissingOnServer && missingOnServer.Count > 0)
        {
            // A row the server does not have is removed before the server's rows go in, rather than left to the delete
            // propagation later in the run: a row recreated here under another key with the unique value the server's
            // row holds would otherwise refuse that row.
            var present = await FindLocalKeyTextsAsync(missingOnServer.Values, cancellationToken)
                .ConfigureAwait(false);
            removed = await DeleteUnreferencedAsync(
                    missingOnServer
                        .Where(pair => present.Contains(pair.Key))
                        .ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal),
                    cancellationToken
                )
                .ConfigureAwait(false);
        }

        var held = new List<string>();
        var blocked = await FindRowsMissingParentsAsync(
                rows,
                resolver,
                cancellationToken,
                inAnyOrder: true
            )
            .ConfigureAwait(false);

        if (blocked.Count > 0)
        {
            // Left as they are: a row whose parent the run may not bring in - its table is outside the run, or it has a
            // local delete the run is not discarding - would fail on the local foreign key, or undo that delete.
            held.AddRange(blocked.Keys.Select(index => applied[index].KeyText));
            rows = rows.Where((_, index) => !blocked.ContainsKey(index)).ToList();
            applied = applied.Where((_, index) => !blocked.ContainsKey(index)).ToList();
        }

        if (rows.Count == 0)
        {
            return (applied, held, removed);
        }

        // Applied together, so the order within the batch is free: parents go first, or the local foreign key refuses
        // a child whose parent comes later in the list. A row whose unique value another local row still holds is left
        // as it is, like a row whose parent cannot be had.
        //
        // A row a local save hook skips is left as it is as well, and so are the rows after it: the rows go in parents
        // first, so a row after it may be its child.
        var ordered = ParentsFirst(rows);
        var (colliding, skippedAt) = await ApplyBatchOrFindCollisionsAsync(
                ordered,
                includeUnboundedBinary,
                stopAtFirst: false,
                resolver,
                cancellationToken
            )
            .ConfigureAwait(false);
        var leftOut = skippedAt >= 0
            ? colliding.Concat(Enumerable.Range(skippedAt, ordered.Count - skippedAt)).ToList()
            : colliding;

        if (leftOut.Count > 0)
        {
            var leftOutKeys = leftOut
                .Select(index => FormatKey(ReadKey(ordered[index])))
                .ToHashSet(StringComparer.Ordinal);
            held.AddRange(leftOutKeys);
            applied = applied.Where(row => !leftOutKeys.Contains(row.KeyText)).ToList();
        }

        // Reported only once the batch is in: a row whose application never committed is not one anything should be
        // recorded about.
        return (applied, held, removed);
    }

    /// <summary>
    /// Applies the rows as one batch; when that fails, finds the rows whose unique values another local row holds and
    /// applies the others, returning the indexes of the ones left out.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Asked only after the batch has failed, so a batch that goes in makes no extra call. The batch is one local
    /// transaction, so nothing of it is in when the rows are looked at. A row is checked against what the local database
    /// holds, with the repository's own uniqueness check; a failure no row explains is thrown as it was.
    /// </para>
    /// <para>
    /// A server row collides with a local one when the local database still holds a value the server has moved on from:
    /// a row the server deleted and recreated under another key with the same unique value, while the old row is still
    /// here - unsent, referred to, or with the delete propagation turned off. Two rows of the same batch that swapped
    /// their values collide as well, since SQLite checks a unique constraint statement by statement; that one does not
    /// go away by itself (see the known limitations in the documentation).
    /// </para>
    /// </remarks>
    /// <param name="rows">The rows, in the order they are applied.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="stopAtFirst">Whether only the rows before the first collision are applied (an ordered download), rather than every row that does not collide.</param>
    /// <param name="resolver">Brings the local rows holding the values up to date when it may (null: a collision is only looked at, not resolved).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The indexes of the rows left out for a unique value, and the index of the row a local save hook skipped (-1 when none did); that row and the rows after it are not in.</returns>
    /// <remarks>
    /// With a resolver, a collision is resolved before it is given up on: the local rows holding the colliding row's
    /// unique values are found (<see cref="SyncTableDescriptor{TEntity, TKey}.LocalUniqueLookups"/>) and brought up to
    /// date from the server, and the batch is tried again (see <see cref="TryResolveCollisionAsync"/>). The batch is
    /// tried at most as many times as it has rows; each try that does not end the loop has resolved a collision.
    /// </remarks>
    private protected async Task<(IReadOnlyList<int> Colliding, int SkippedAt)> ApplyBatchOrFindCollisionsAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        bool stopAtFirst,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        for (var attempt = 0; ; attempt++)
        {
            var (colliding, skippedAt) = await TryApplyBatchAsync(
                    rows,
                    includeUnboundedBinary,
                    stopAtFirst,
                    applyRest: false,
                    cancellationToken
                )
                .ConfigureAwait(false);

            if (colliding.Count == 0)
            {
                return ([], skippedAt);
            }

            if (resolver is not null && attempt < rows.Count)
            {
                var resolved = false;

                foreach (var index in colliding)
                {
                    resolved |= await TryResolveCollisionAsync(rows[index], resolver, cancellationToken)
                        .ConfigureAwait(false);
                }

                if (resolved)
                {
                    continue;
                }
            }

            return await TryApplyBatchAsync(
                    rows,
                    includeUnboundedBinary,
                    stopAtFirst,
                    applyRest: true,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Finds the local rows holding the row's unique values and, unless that would overwrite an unsent change or the
    /// server still gives them the same value, brings them up to date from the server; returns whether it did.
    /// </summary>
    /// <remarks>
    /// A holder with an unsent change the run is not discarding is left alone - bringing it forward would drop the
    /// change without saying so - and so is a holder whose server copy still holds the value (two rows that swapped
    /// their values, or data the server itself holds twice): the collision stays, and the caller stops at the row.
    /// </remarks>
    private async Task<bool> TryResolveCollisionAsync(
        TEntity row,
        SyncParentResolver resolver,
        CancellationToken cancellationToken
    )
    {
        var rowKeyText = FormatKey(ReadKey(row));
        var holders = new Dictionary<string, TKey>(StringComparer.Ordinal);

        foreach (var lookup in _descriptor.LocalUniqueLookups)
        {
            var values = lookup.ReadValues(row);

            if (values.Any(value => value is null))
            {
                continue;
            }

            var keys = await _localSqlExecutor
                .QueryProjectionBySqlAsync<TKey>(lookup.Sql, new { values }, cancellationToken)
                .ConfigureAwait(false);

            foreach (var key in keys)
            {
                var keyText = FormatKey(key);

                if (!string.Equals(keyText, rowKeyText, StringComparison.Ordinal))
                {
                    holders[keyText] = key;
                }
            }
        }

        if (holders.Count == 0)
        {
            return false;
        }

        foreach (var (keyText, key) in holders)
        {
            if (resolver.HoldsUnsentChange(TableName, keyText))
            {
                return false;
            }

            var server = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            if (
                server is not null
                && _descriptor.LocalUniqueLookups.Any(lookup =>
                    lookup.ReadValues(row) is var wanted
                    && wanted.All(value => value is not null)
                    && lookup.ReadValues(server).SequenceEqual(wanted)
                )
            )
            {
                return false;
            }
        }

        return await resolver
            .BringHoldersUpToDateAsync(TableName, holders.Keys.ToList(), cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>
    /// Applies the rows as one batch; when that fails, finds the rows whose unique values another local row holds and,
    /// with <paramref name="applyRest"/>, applies the others. Returns the indexes of the rows left out for a unique value,
    /// and the index of the row a local save hook skipped (-1 when none did; that row and the rows after it are not in).
    /// </summary>
    private async Task<(IReadOnlyList<int> Colliding, int SkippedAt)> TryApplyBatchAsync(
        IReadOnlyList<TEntity> rows,
        bool includeUnboundedBinary,
        bool stopAtFirst,
        bool applyRest,
        CancellationToken cancellationToken
    )
    {
        try
        {
            var skippedAt = await ApplyBatchCoreAsync(rows, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false);

            return ([], skippedAt);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            var colliding = new List<int>();

            try
            {
                for (var index = 0; index < rows.Count; index++)
                {
                    var violations = await _local
                        .CheckUniquenessAsync(rows[index], cancellationToken)
                        .ConfigureAwait(false);

                    if (violations.Count > 0)
                    {
                        colliding.Add(index);

                        if (stopAtFirst)
                        {
                            break;
                        }
                    }
                }
            }
            catch (Exception lookup) when (lookup is not OperationCanceledException)
            {
                colliding.Clear();
            }

            if (colliding.Count == 0)
            {
                System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(exception).Throw();
            }

            if (!applyRest)
            {
                return (colliding, -1);
            }

            var restAt = stopAtFirst
                ? Enumerable.Range(0, colliding[0]).ToList()
                : Enumerable.Range(0, rows.Count).Where(index => !colliding.Contains(index)).ToList();
            var restSkippedAt = -1;

            if (restAt.Count > 0)
            {
                restSkippedAt = await ApplyBatchCoreAsync(
                        restAt.Select(index => rows[index]).ToList(),
                        includeUnboundedBinary,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            return (colliding, restSkippedAt >= 0 ? restAt[restSkippedAt] : -1);
        }
    }

    /// <inheritdoc />
    public async Task<IReadOnlyList<string>> PropagateDeletesAsync(
        IReadOnlySet<string> pendingKeyTexts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(pendingKeyTexts);

        var serverKeyTexts = await ReadServerKeyTextsAsync(cancellationToken).ConfigureAwait(false);
        var outcome = await DeleteRowsMissingOnServerAsync(
                serverKeyTexts,
                _ => Task.FromResult(pendingKeyTexts),
                new HashSet<string>(StringComparer.Ordinal),
                cancellationToken
            )
            .ConfigureAwait(false);

        return outcome.Removed;
    }

    /// <inheritdoc />
    /// <remarks>
    /// The server's key set is read first and outside the lock - it is the slow half, and nothing local depends on it.
    /// The local key set and the unsent keys are then read under the write lock, in that order, and the rows are deleted
    /// before it is given back. The order is what makes it safe to keep writing during a run: a row created after the
    /// local keys were read is not among the candidates at all, and a row created before was journaled before it was
    /// written, so its entry is already there when the unsent keys are read after.
    /// </remarks>
    async Task<SyncPropagationOutcome> ISyncTableRunSupport.PropagateDeletesAsync(
        SyncLocalGate gate,
        Func<CancellationToken, Task<IReadOnlySet<string>>> readPendingKeyTexts,
        IReadOnlySet<string> keptByChildren,
        CancellationToken cancellationToken
    )
    {
        var serverKeyTexts = await ReadServerKeyTextsAsync(cancellationToken).ConfigureAwait(false);

        return await gate.WriteExclusiveAsync(
                () =>
                    DeleteRowsMissingOnServerAsync(
                        serverKeyTexts,
                        readPendingKeyTexts,
                        keptByChildren,
                        cancellationToken
                    ),
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <inheritdoc />
    bool ISyncTableRunSupport.IsReferenced => _descriptor.ReferencingTableNames.Count > 0;

    /// <inheritdoc />
    Func<string, string>? ISyncTableRunSupport.NormalizeKeyText => _descriptor.NormalizeKeyText;

    /// <inheritdoc />
    async Task<(object? LocalRow, IReadOnlyList<(string TableName, string KeyText)> Parents)> ISyncTableRunSupport.ReadLocalParentsAsync(
        string keyText,
        CancellationToken cancellationToken
    )
    {
        var local = await _local.GetByIdAsync(ParseKey(keyText), cancellationToken)
            .ConfigureAwait(false);

        return (local, local is null ? [] : ReadParents(local));
    }

    /// <inheritdoc />
    async Task<object?> ISyncTableRunSupport.ReadServerRowAsync(
        string keyText,
        CancellationToken cancellationToken
    ) =>
        await _server
            .Writer.GetByIdAsync(ParseKey(keyText), cancellationToken)
            .ConfigureAwait(false);

    /// <summary>The parents the row refers to, by table name and key text (a NULL foreign key refers to none).</summary>
    private List<(string TableName, string KeyText)> ReadParents(TEntity row)
    {
        var parents = new List<(string TableName, string KeyText)>();

        foreach (var reference in _descriptor.ParentReferences)
        {
            if (reference.ReadParentKeyText(row) is { } parentKeyText)
            {
                parents.Add((reference.ParentTableName, parentKeyText));
            }
        }

        return parents;
    }

    /// <summary>Reads every key the server holds for this table, in the journal's text form.</summary>
    private async Task<HashSet<string>> ReadServerKeyTextsAsync(CancellationToken cancellationToken)
    {
        var serverKeys = await _server.GetAllKeysAsync(cancellationToken).ConfigureAwait(false);

        return serverKeys.Select(FormatKey).ToHashSet(StringComparer.Ordinal);
    }

    /// <summary>
    /// Deletes the local rows whose key is not in the server's set and that no local row refers to, sparing the keys that
    /// are still unsent (read after the local keys), the keys kept rows of child tables refer to, and the parents of every
    /// row so spared.
    /// </summary>
    /// <remarks>
    /// <para>
    /// An unsent journal entry outranks the server's key set: the row is the subject of a local intention this run has
    /// not settled, and removing it here would settle it silently against the local side. A row kept that way keeps
    /// what it refers to (see <see cref="SyncKeptRows.CloseAsync"/>).
    /// </para>
    /// <para>
    /// A row is only removed when nothing local refers to it, and the removal is repeated until a pass removes nothing.
    /// The rows that refer to a candidate can be anywhere: a row of the same table (a child within a self-referencing
    /// table, removed in an earlier pass when the server dropped it as well), an unsent row, a row a truncated download
    /// has not brought up to date yet, or a row of a table outside this run's scope. Removing the parent of any of them
    /// fails on the local foreign key, or - under <c>ON DELETE CASCADE</c> - takes the row with it; a parent kept this
    /// way goes on a later run, once nothing refers to it any more.
    /// </para>
    /// </remarks>
    private async Task<SyncPropagationOutcome> DeleteRowsMissingOnServerAsync(
        HashSet<string> serverKeyTexts,
        Func<CancellationToken, Task<IReadOnlySet<string>>> readPendingKeyTexts,
        IReadOnlySet<string> keptByChildren,
        CancellationToken cancellationToken
    )
    {
        var localKeys = await _localSqlExecutor
            .QueryProjectionBySqlAsync<TKey>(LocalKeysSql, null, cancellationToken)
            .ConfigureAwait(false);
        var pendingKeyTexts = await readPendingKeyTexts(cancellationToken).ConfigureAwait(false);
        var candidates = new Dictionary<string, TKey>(StringComparer.Ordinal);

        foreach (var key in localKeys)
        {
            var keyText = FormatKey(key);

            if (!serverKeyTexts.Contains(keyText))
            {
                candidates[keyText] = key;
            }
        }

        var candidateKeyTexts = candidates.Keys.ToHashSet(StringComparer.Ordinal);
        var (kept, keptParents) = await SyncKeptRows
            .CloseAsync(
                TableName,
                candidateKeyTexts.Where(keyText =>
                    pendingKeyTexts.Contains(keyText) || keptByChildren.Contains(keyText)
                ),
                candidateKeyTexts,
                async keyText =>
                    _descriptor.ParentReferences.Count == 0
                    || await _local
                        .GetByIdAsync(candidates[keyText], cancellationToken)
                        .ConfigureAwait(false)
                        is not { } row
                        ? []
                        : ReadParents(row)
            )
            .ConfigureAwait(false);
        var remaining = candidates
            .Where(pair => !kept.Contains(pair.Key))
            .ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
        var removed = await DeleteUnreferencedAsync(remaining, cancellationToken)
            .ConfigureAwait(false);

        return new SyncPropagationOutcome(removed, keptParents);
    }

    /// <summary>Deletes the given local rows that nothing local refers to, repeating until a pass removes nothing, and returns the keys that went.</summary>
    private async Task<IReadOnlyList<string>> DeleteUnreferencedAsync(
        Dictionary<string, TKey> remaining,
        CancellationToken cancellationToken
    )
    {
        var removed = new List<string>();
        var references = remaining.Count == 0
            ? []
            : await ReadPresentLocalReferencesAsync(cancellationToken).ConfigureAwait(false);

        using (SyncSession.Suppress())
        {
            while (remaining.Count > 0)
            {
                var referenced = await FindLocallyReferencedKeyTextsAsync(
                        references,
                        remaining.Values,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
                var removable = remaining.Where(pair => !referenced.Contains(pair.Key)).ToList();

                if (removable.Count == 0)
                {
                    break;
                }

                foreach (var (keyText, key) in removable)
                {
                    remaining.Remove(keyText);

                    if (await _local.DeleteAsync(key, cancellationToken).ConfigureAwait(false))
                    {
                        removed.Add(keyText);
                    }
                }
            }
        }

        return removed;
    }

    /// <summary>The descriptor's <see cref="SyncTableDescriptor{TEntity, TKey}.LocalReferences"/> whose referring table the local database has.</summary>
    /// <remarks>
    /// The local database is not required to hold every table of the diagram - one built from the synchronised tables
    /// alone has always worked - and asking a table it does not have fails the statement. Such a table holds no rows to
    /// refer with, so leaving it out changes nothing about which rows are referred to. The table list is read once per
    /// propagation of this table.
    /// </remarks>
    private async Task<IReadOnlyList<SyncLocalReference>> ReadPresentLocalReferencesAsync(
        CancellationToken cancellationToken
    )
    {
        if (_descriptor.LocalReferences.Count == 0)
        {
            return [];
        }

        var present = await ReadLocalTableNamesAsync(cancellationToken).ConfigureAwait(false);

        return _descriptor.LocalReferences.Where(reference => present.Contains(reference.TableName)).ToList();
    }

    /// <summary>The names of the tables the local database has.</summary>
    private async Task<HashSet<string>> ReadLocalTableNamesAsync(CancellationToken cancellationToken)
    {
        var tables = await _localSqlExecutor
            .QueryProjectionBySqlAsync<string>(
                "SELECT name FROM sqlite_master WHERE type = 'table'",
                null,
                cancellationToken
            )
            .ConfigureAwait(false);

        return tables.ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    /// <inheritdoc />
    /// <remarks>
    /// A table outside the scope is asked through <see cref="SyncTableDescriptor{TEntity, TKey}.LocalReferences"/>,
    /// with every local key of this table - the refresh is about to delete them all - in chunks. A table the local
    /// database does not have is skipped, as in the delete propagation. A table that refers to this one only through a
    /// foreign key those references do not list (<see cref="SyncTableDescriptor{TEntity, TKey}.UnlistedReferencingTableNames"/>)
    /// cannot be asked, so it counts whenever the local database has it.
    /// </remarks>
    async Task<IReadOnlyList<string>> ISyncTableRunSupport.FindReferencesFromOutsideAsync(
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    )
    {
        var listed = _descriptor
            .LocalReferences.Where(reference => !scopeTableNames.Contains(reference.TableName))
            .ToList();
        var unlisted = _descriptor
            .UnlistedReferencingTableNames.Where(name => !scopeTableNames.Contains(name))
            .ToList();

        if (listed.Count == 0 && unlisted.Count == 0)
        {
            return [];
        }

        var present = await ReadLocalTableNamesAsync(cancellationToken).ConfigureAwait(false);
        var referring = unlisted.Where(present.Contains).Distinct(StringComparer.Ordinal).ToList();
        listed = listed
            .Where(reference =>
                present.Contains(reference.TableName)
                && !referring.Contains(reference.TableName, StringComparer.Ordinal)
            )
            .ToList();

        if (listed.Count == 0)
        {
            return referring;
        }

        var localKeys = await _localSqlExecutor
            .QueryProjectionBySqlAsync<TKey>(LocalKeysSql, null, cancellationToken)
            .ConfigureAwait(false);

        foreach (var reference in listed)
        {
            if (referring.Contains(reference.TableName, StringComparer.Ordinal))
            {
                continue;
            }

            var referenced = await FindLocallyReferencedKeyTextsAsync(
                    [reference],
                    localKeys,
                    cancellationToken
                )
                .ConfigureAwait(false);

            if (referenced.Count > 0)
            {
                referring.Add(reference.TableName);
            }
        }

        return referring;
    }

    /// <summary>Returns which of the given keys a local row refers to, through the given foreign keys.</summary>
    /// <remarks>The keys are bound in chunks of <see cref="SyncInClause.ChunkSize"/>, one round trip per chunk and referencing foreign key.</remarks>
    private async Task<HashSet<string>> FindLocallyReferencedKeyTextsAsync(
        IReadOnlyList<SyncLocalReference> references,
        IEnumerable<TKey> keys,
        CancellationToken cancellationToken
    )
    {
        var referenced = new HashSet<string>(StringComparer.Ordinal);

        if (references.Count == 0)
        {
            return referenced;
        }

        foreach (var chunk in keys.Chunk(SyncInClause.ChunkSize))
        {
            foreach (var reference in references)
            {
                var found = await _localSqlExecutor
                    .QueryProjectionBySqlAsync<TKey>(
                        reference.Sql,
                        new { keys = chunk },
                        cancellationToken
                    )
                    .ConfigureAwait(false);

                foreach (var key in found)
                {
                    referenced.Add(FormatKey(key));
                }
            }
        }

        return referenced;
    }

    /// <inheritdoc />
    /// <remarks>
    /// Raw SQL is never journaled, so the suppression here is not what keeps this write out of the journal. It is
    /// there because a refresh is one engine-driven write from beginning to end, and a table whose local repository
    /// happens to be reached some other way inside it should be treated the same as the rest.
    /// </remarks>
    public async Task<int> DeleteAllLocalAsync(CancellationToken cancellationToken = default)
    {
        using (SyncSession.Suppress())
        {
            return await _localSqlExecutor
                .ExecuteSqlAsync(LocalDeleteAllSql, null, cancellationToken)
                .ConfigureAwait(false);
        }
    }
}

/// <summary>
/// The fixed half of one synchronised table that carries a version column: batching, anchor derivation, and the
/// version-guarded journal replay.
/// </summary>
/// <remarks>
/// <para>
/// The descriptor supplies everything that depends on the diagram - the table name, the SQL that reads the local anchor
/// and key set, how to read and write the key and the mirrored version on the entity, and how a key turns into the
/// journal's text form and back.
/// </para>
/// <para>
/// <b>The resume point is derived, never stored.</b> The anchor is the maximum mirrored version among the local rows,
/// so it is a fact about the data rather than a separate bookkeeping row that could disagree with it. Three things make
/// that derivation correct, and all three are load-bearing: rows are fetched in ascending version order, each batch is
/// applied in a single local transaction, and <b>the download is the only thing that writes a mirrored version</b>. A
/// run interrupted anywhere leaves the local database holding a prefix of the ordered stream, and the maximum of that
/// prefix is exactly where the next run must start. Rows created locally and not yet uploaded have no mirrored version,
/// so they drop out of the maximum on their own.
/// </para>
/// <para>
/// The third point is what keeps the first two worth anything. A version written from anywhere but the ordered stream -
/// an upload mirroring the stamp the server just gave its row, say - can stand above rows of that stream the local
/// database has not seen, and every one of them then sits below the anchor for good: no later run asks for them again.
/// The version an upload earns is therefore reported to the run rather than mirrored, and the download writes it when
/// the row reaches it in order.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncTable<TEntity, TKey> : SyncTableBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the table with its local repository, the local raw SQL surface, the server source, and its descriptor.</summary>
    /// <param name="local">The local repository.</param>
    /// <param name="localSqlExecutor">The local raw SQL surface.</param>
    /// <param name="server">The server source.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="localSaveHooks">The save hooks the local repository runs (the registry it was given); null when it runs none.</param>
    public SyncTable(
        IRepositoryCore<TEntity, TKey> local,
        ISqlExecutor localSqlExecutor,
        ISyncServerSource<TEntity, TKey> server,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISaveHookRegistry? localSaveHooks = null
    )
        : base(local, localSqlExecutor, server, descriptor, localSaveHooks) { }

    /// <summary>SELECT that returns the highest mirrored version among the local rows (the derived resume point).</summary>
    private string LocalAnchorSql => _descriptor.LocalAnchorSql;

    /// <summary>Reads the mirrored server version off the entity (null when the row has never been uploaded).</summary>
    private byte[]? ReadRowVersion(TEntity entity) => _descriptor.ReadRowVersion(entity);

    /// <summary>Writes the mirrored server version onto the entity.</summary>
    private void WriteRowVersion(TEntity entity, byte[]? rowVersion) =>
        _descriptor.WriteRowVersion(entity, rowVersion);

    /// <inheritdoc />
    /// <remarks>
    /// <para>
    /// The rows of a batch arrive in ascending version order and are dealt with in that order, so whatever the run
    /// commits is a prefix of the stream and the anchor derived from it is where the next pass must resume.
    /// </para>
    /// <para>
    /// A row whose key still holds an unsent local change ends the table's download at that row. The rows behind it are
    /// left on the server rather than applied out of order: applying them would move the anchor past the stopping point,
    /// and the change that stopped it would then never be seen again.
    /// </para>
    /// </remarks>
    public override async Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(context);

        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The download batch size must be greater than zero."
            );
        }

        // Blobs an earlier run left owing come first, so a row whose copy failed gets its blob even though the stream
        // has moved past it.
        await CopyOwedBlobsAsync(context, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);

        var applied = 0;
        byte[]? previousAnchor = null;
        var appliedAnyBatch = false;

        // The receipts this download makes redundant. Collected rather than cleared as they are met, because the
        // clearing has to follow the local commit that wrote the version - and the caller clears them once this
        // returns, by which time every batch has committed.
        var settledAcks = new List<string>();

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            // The anchor is re-derived for every batch: the previous batch committed, so the maximum has moved on.
            var anchor = await _localSqlExecutor
                .ExecuteScalarSqlAsync<byte[]>(LocalAnchorSql, null, cancellationToken)
                .ConfigureAwait(false);

            if (appliedAnyBatch && SameAnchor(anchor, previousAnchor))
            {
                // A batch was applied and yet the resume point did not move, so asking again would hand back the same
                // rows for ever. Every reason for it is a defect rather than a state to wait out - a source that
                // ignores the anchor it is given, or rows whose version column is empty and cannot raise the maximum -
                // so it is reported instead of spun on. Without this the download has no way to end.
                throw new InvalidOperationException(
                    $"The download of '{TableName}' is not making progress: a batch was applied but the resume point "
                        + "derived from the local rows did not move. The server source is returning rows that do not "
                        + "advance past the anchor it was given."
                );
            }

            previousAnchor = anchor;

            var batch = await _server
                .GetChangesAsync(anchor, ceiling, batchSize, cancellationToken)
                .ConfigureAwait(false);

            if (batch.Rows.Count == 0)
            {
                return new SyncDownloadOutcome(applied, null, settledAcks);
            }

            var (stopAt, missingParentTable, batchApplied, wroteAny, skippedBySaveHook) = await RunBatchSectionAsync(
                    context,
                    async (holdOf, resolver) =>
                    {
                        var (stop, parentTable) = FindHeldRow(batch.Rows, holdOf);
                        var rows = stop < 0 ? batch.Rows : batch.Rows.Take(stop).ToList();

                        // A row whose parent the local database does not have stops the batch as well, unless the
                        // parent can be brought in first - the prefix up to it is what gets applied.
                        var blocked = await FindRowsMissingParentsAsync(rows, resolver, cancellationToken)
                            .ConfigureAwait(false);

                        if (blocked.Count > 0)
                        {
                            stop = blocked.Keys.Min();
                            parentTable = blocked[stop];
                            rows = rows.Take(stop).ToList();
                        }

                        if (rows.Count == 0)
                        {
                            return (stop, parentTable, 0, false, false);
                        }

                        var (appliedRows, stoppedAt, skipped) = await ApplyDownloadedRowsAsync(
                                rows,
                                context,
                                settledAcks,
                                includeUnboundedBinary,
                                resolver,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        if (stoppedAt >= 0)
                        {
                            // A row whose unique value another local row still holds, or that a local save hook
                            // skipped, stops the batch like a held row.
                            return (stoppedAt, (string?)null, appliedRows, true, skipped);
                        }

                        return (stop, parentTable, appliedRows, true, false);
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
            applied += batchApplied;

            // Set even when every row of the batch was this device's own echo: those write a version too, so the
            // resume point did move and the progress guard has nothing to report.
            appliedAnyBatch |= wroteAny;

            if (stopAt >= 0)
            {
                // Stopping is a normal end of this table's download, not a stall: the caller settles the change that
                // stopped it and the next run carries on from the prefix this one left.
                return new SyncDownloadOutcome(
                    applied,
                    FormatKey(ReadKey(batch.Rows[stopAt])),
                    settledAcks
                )
                {
                    MissingParentTableName = missingParentTable,
                    SkippedBySaveHook = skippedBySaveHook,
                };
            }

            // The source itself says whether the stream is drained; what is left over is above the ceiling either way
            // and waits for the next run. Asking again is safe but pointless, so the flag is what ends the loop.
            if (!batch.HasMore)
            {
                return new SyncDownloadOutcome(applied, null, settledAcks);
            }
        }
    }

    /// <summary>Finds the first row that is held back from the batch (-1 when none is), with the table of the parent that holds it back.</summary>
    private static (int Index, string? ParentTableName) FindHeldRow(
        IReadOnlyList<TEntity> rows,
        Func<TEntity, (bool Held, string? ParentTableName)> holdOf
    )
    {
        for (var index = 0; index < rows.Count; index++)
        {
            if (holdOf(rows[index]) is (true, var parentTableName))
            {
                return (index, parentTableName);
            }
        }

        return (-1, null);
    }

    /// <summary>Applies the rows of one batch in order and returns how many of them were applied as content.</summary>
    /// <remarks>
    /// <para>
    /// A row this device uploaded comes back carrying the version the server stamped on it, which is the version the
    /// receipt holds. Such a row holds the local content it was made from, so writing it back would be writing the
    /// row over itself - and, where the excluded columns are carried, copying a blob down that was just copied up. Only
    /// the version is worth taking, and it is taken on its own.
    /// </para>
    /// <para>
    /// Every row that gets this far has its mirrored version written, one way or the other, so a row whose key holds a
    /// receipt leaves that receipt with nothing left to say: the mirror now carries at least what the receipt did. Both
    /// paths therefore add to <paramref name="settledAcks"/> - including a row someone else changed after this device
    /// uploaded it, whose receipt is not merely redundant but stale.
    /// </para>
    /// </remarks>
    /// <param name="rows">The batch's rows, in ascending version order.</param>
    /// <param name="context">The table's unsent local changes and its outstanding acknowledgements.</param>
    /// <param name="settledAcks">The keys whose receipt this download has made redundant; added to as rows are applied.</param>
    /// <param name="includeUnboundedBinary">Whether the excluded unbounded binary columns are carried as well.</param>
    /// <param name="resolver">Brings in missing parents and resolves unique-value collisions when it may (null: neither).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The rows applied as content, the index of the row the batch stopped at - because its unique value another local row holds, or because a local save hook skipped it - (-1 when it did not), and whether a save hook was the reason.</returns>
    private async Task<(int Applied, int StoppedAt, bool SkippedBySaveHook)> ApplyDownloadedRowsAsync(
        IReadOnlyList<TEntity> rows,
        SyncDownloadContext context,
        List<string> settledAcks,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        var applied = 0;
        var content = new List<(TEntity Row, int Index)>();

        for (var index = 0; index < rows.Count; index++)
        {
            var row = rows[index];
            var keyText = FormatKey(ReadKey(row));

            if (context.AcknowledgedRowVersions.ContainsKey(keyText))
            {
                settledAcks.Add(keyText);
            }

            if (!IsEchoOfThisDevicesUpload(row, context))
            {
                content.Add((row, index));

                continue;
            }

            // Flushed before the version-only write so the rows are committed in the order they arrived: every commit
            // boundary then leaves the local database holding a prefix of the ordered stream.
            var (flushed, stoppedAt, skippedBySaveHook) = await FlushContentAsync(
                    content,
                    includeUnboundedBinary,
                    resolver,
                    cancellationToken
                )
                .ConfigureAwait(false);
            applied += flushed;

            if (stoppedAt >= 0)
            {
                return (applied, Unsettle(stoppedAt), skippedBySaveHook);
            }

            if (!await MirrorRowVersionAsync(row, cancellationToken).ConfigureAwait(false))
            {
                // The local row is gone - removed outside the generated repositories since the upload read it - so
                // there is no version to write onto it and the server's row is applied like any other.
                content.Add((row, index));
            }
        }

        var (last, lastStoppedAt, lastSkippedBySaveHook) = await FlushContentAsync(
                content,
                includeUnboundedBinary,
                resolver,
                cancellationToken
            )
            .ConfigureAwait(false);

        return lastStoppedAt >= 0
            ? (applied + last, Unsettle(lastStoppedAt), lastSkippedBySaveHook)
            : (applied + last, -1, false);

        // The rows from the stop on are not in: their receipts have nothing to be settled by.
        int Unsettle(int stoppedAt)
        {
            foreach (var row in rows.Skip(stoppedAt))
            {
                settledAcks.Remove(FormatKey(ReadKey(row)));
            }

            return stoppedAt;
        }
    }

    /// <summary>
    /// Applies the rows accumulated so far and empties the buffer; returns how many went, the batch index of the row it
    /// stopped at - because its unique value another local row holds, or because a local save hook skipped it - (-1 when
    /// it did not), and whether a save hook was the reason.
    /// </summary>
    private async Task<(int Applied, int StoppedAt, bool SkippedBySaveHook)> FlushContentAsync(
        List<(TEntity Row, int Index)> content,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        if (content.Count == 0)
        {
            return (0, -1, false);
        }

        var (colliding, skippedAt) = await ApplyBatchOrFindCollisionsAsync(
                content.Select(item => item.Row).ToList(),
                includeUnboundedBinary,
                stopAtFirst: true,
                resolver,
                cancellationToken
            )
            .ConfigureAwait(false);
        var stop = colliding.Count > 0 ? colliding[0] : -1;
        var skipped = skippedAt >= 0 && (stop < 0 || skippedAt < stop);

        if (skipped)
        {
            stop = skippedAt;
        }

        var applied = stop >= 0 ? stop : content.Count;
        var stoppedAt = stop >= 0 ? content[stop].Index : -1;
        content.Clear();

        return (applied, stoppedAt, skipped);
    }

    /// <summary>Whether the downloaded row is the row this device uploaded, still carrying the version the server gave it.</summary>
    /// <remarks>
    /// The version has to match, not just the key: a row someone else changed after this device uploaded it carries a
    /// different version, and that change is a server-side change like any other and has to be applied.
    /// </remarks>
    private bool IsEchoOfThisDevicesUpload(TEntity row, SyncDownloadContext context) =>
        context.AcknowledgedRowVersions.TryGetValue(FormatKey(ReadKey(row)), out var acknowledged)
        && ReadRowVersion(row) is { } current
        && acknowledged.SequenceEqual(current);

    /// <summary>Writes one downloaded row's version onto the local row without touching its content (false = no local row).</summary>
    private async Task<bool> MirrorRowVersionAsync(
        TEntity row,
        CancellationToken cancellationToken
    )
    {
        using (SyncSession.Suppress())
        {
            var local = await _local
                .GetByIdAsync(ReadKey(row), cancellationToken)
                .ConfigureAwait(false);

            if (local is null)
            {
                return false;
            }

            WriteRowVersion(local, ReadRowVersion(row));
            local.MarkUpdated();
            await _local
                .UpdateAsync(local, ConcurrencyMode.ForceOverwrite, cancellationToken)
                .ConfigureAwait(false);

            return true;
        }
    }

    /// <summary>Compares two derived anchors (null means "no local row carries a version yet").</summary>
    private static bool SameAnchor(byte[]? left, byte[]? right) =>
        left is null || right is null ? left is null && right is null : left.SequenceEqual(right);

    /// <inheritdoc />
    /// <remarks>
    /// <para>
    /// The rows come from the same differential source an ordinary run reads, asked from the very beginning: a refresh
    /// is the degenerate case of a download whose resume point starts at nothing, so no second server surface and no
    /// extra endpoint is involved. The ceiling still applies, and it has to - a row still in flight beneath it must
    /// stay out of the reload, or the anchor the reloaded table yields would sit above a row that never arrived and no
    /// later run would look below it again.
    /// </para>
    /// <para>
    /// The cursor advances by the version of the batch's last row rather than by re-deriving the local maximum. Both
    /// give the same value while the source keeps its promise to return rows in ascending version order, and the row
    /// is already in hand. As in a download, a batch that fails to move the cursor is reported rather than spun on.
    /// </para>
    /// <para>
    /// Rows are inserted rather than saved: the table was emptied first, so there is nothing to compare against and
    /// nothing to update. That - together with the absent anchor query, key set, and journal - is where the speed of a
    /// refresh comes from.
    /// </para>
    /// </remarks>
    public override Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) => RefreshCoreAsync(ceiling, batchSize, includeUnboundedBinary, null, cancellationToken);

    /// <inheritdoc />
    private protected override async Task<int> RefreshCoreAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The refresh batch size must be greater than zero."
            );
        }

        // The table was emptied before this, so a blob an earlier run left owing belongs to a row that is gone; the
        // reloaded rows bring their own copies when the refresh carries the columns.
        await _localJournal.RemoveTableBlobCopiesAsync(TableName, cancellationToken)
            .ConfigureAwait(false);

        var inserted = 0;
        byte[]? anchor = null;

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            var batch = await _server
                .GetChangesAsync(anchor, ceiling, batchSize, cancellationToken)
                .ConfigureAwait(false);

            if (batch.Rows.Count == 0)
            {
                return inserted;
            }

            inserted += await InsertRefreshedRowsAsync(
                    batch.Rows,
                    includeUnboundedBinary,
                    resolver,
                    cancellationToken
                )
                .ConfigureAwait(false);

            var next = ReadRowVersion(batch.Rows[^1]);

            if (next is null || next.Length == 0 || SameAnchor(next, anchor))
            {
                throw new InvalidOperationException(
                    $"The refresh of '{TableName}' is not making progress: the last row of a batch carries no "
                        + "version, or one that does not advance past the anchor the batch was asked for. The server "
                        + "source is not returning rows in ascending version order above the anchor it was given."
                );
            }

            // The source itself says whether the stream is drained; what is left over is above the ceiling either way
            // and belongs to the next ordinary run, which resumes from the anchor this reload leaves behind.
            if (!batch.HasMore)
            {
                return inserted;
            }

            anchor = next;
        }
    }

    /// <inheritdoc />
    public override async Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entry);

        if (mode == SyncMode.LastWriteWins)
        {
            // The run asked for overwrites, so the version guards - and the receipt they would be read against, and
            // the policy that decides what happens when they fire - have nothing to do.
            return await UploadLastWriteWinsAsync(entry, includeUnboundedBinary, cancellationToken)
                .ConfigureAwait(false);
        }

        var key = ParseKey(entry.KeyText);

        // A delete carries nothing extra: the excluded columns go with the row it removes.
        return string.Equals(
            entry.Operation,
            nameof(SyncJournalOperation.Delete),
            StringComparison.Ordinal
        )
            ? await UploadDeleteAsync(
                entry,
                key,
                policy,
                acknowledgedRowVersion,
                cancellationToken
            )
                .ConfigureAwait(false)
            : await UploadUpsertAsync(
                entry,
                key,
                policy,
                includeUnboundedBinary,
                acknowledgedRowVersion,
                cancellationToken
            )
                .ConfigureAwait(false);
    }

    /// <summary>Replays an insert or an update by sending the row's <i>current</i> local content.</summary>
    /// <remarks>
    /// The original the update guards against is the later of the mirrored version and the acknowledged one. Reading
    /// the mirror alone makes a row whose echo has not come down look older than the server's copy of itself, and the
    /// guard then fires against a version this very device wrote - a conflict with nobody. It is also what tells an
    /// offline insert apart from a row already accepted but not yet echoed: both have an empty mirror, and only the
    /// second has a receipt.
    /// <para>
    /// A row deleted here and created again under the same key has no mirror of its own either; the entry carries the
    /// version the server held for the row the delete removed, and that is taken into the same maximum. The server still
    /// has that row, so the new content goes there as an update guarded by that version - a later change on the server
    /// is a conflict, as for any other edit - rather than as an insert the server refuses as a duplicate. A row created,
    /// deleted and created again without ever reaching the server carries no such version and is inserted as before.
    /// </para>
    /// </remarks>
    private async Task<SyncUploadOutcome> UploadUpsertAsync(
        SyncJournalRow entry,
        TKey key,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken
    )
    {
        var local = await _local.GetByIdAsync(key, cancellationToken).ConfigureAwait(false);

        if (local is null)
        {
            // A journal-first entry whose business write never landed, or a row deleted afterwards. Nothing to send.
            return SyncUploadOutcome.Discarded;
        }

        // The row was read without its unbounded binary columns, so a NOT NULL one may hold nothing at all, which an
        // insert on the server would refuse; an update never writes these columns, so the empty value goes nowhere.
        _descriptor.FillUnsetUnboundedBinaries(local);

        var mirror = MaxRowVersion(
            MaxRowVersion(ReadRowVersion(local), acknowledgedRowVersion),
            entry.OriginalRowVersion
        );

        // Whether the server is given the row for the first time (every blob goes), and whether its row was overwritten
        // without a version guard (the blobs not sent are owed a copy down) - see ColumnsToSend and
        // OweUnsentBlobCopiesAsync.
        var inserted = false;
        var forced = false;

        if (mirror is null)
        {
            // Neither a mirrored version nor a receipt means the row was created locally and has never been on the
            // server.
            var alreadyThere = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            if (alreadyThere is not null && policy != SyncConflictPolicy.LocalWins)
            {
                return SyncUploadOutcome.Conflicted(
                    new SyncConflict(
                        TableName,
                        entry.KeyText,
                        SyncJournalOperation.Upsert,
                        SyncConflictReason.DuplicateOnServer,
                        local,
                        alreadyThere
                    )
                );
            }

            if (alreadyThere is null)
            {
                local.MarkAdded();
                await _server.Writer.InsertAsync(local, cancellationToken).ConfigureAwait(false);
                inserted = true;
            }
            else
            {
                // LocalWins: the offline insert overwrites the row the server already holds under that key. The
                // insert the overwrite falls back to covers that row disappearing between the probe and the update.
                inserted = await ForceOverwriteOrInsertAsync(local, cancellationToken)
                    .ConfigureAwait(false);
                forced = !inserted;
            }
        }
        else
        {
            // The guard reads the version off the entity, so the one that is actually going to be guarded against is
            // written onto it first - which matters exactly when the receipt is the later of the two.
            WriteRowVersion(local, mirror);
            local.MarkUpdated();

            try
            {
                var updated = await _server
                    .Writer.UpdateAsync(
                        local,
                        policy == SyncConflictPolicy.LocalWins
                            ? ConcurrencyMode.ForceOverwrite
                            : ConcurrencyMode.Optimistic,
                        cancellationToken
                    )
                    .ConfigureAwait(false);

                forced = updated && policy == SyncConflictPolicy.LocalWins;

                if (!updated)
                {
                    if (policy != SyncConflictPolicy.LocalWins)
                    {
                        return SyncUploadOutcome.Conflicted(
                            new SyncConflict(
                                TableName,
                                entry.KeyText,
                                SyncJournalOperation.Upsert,
                                SyncConflictReason.MissingOnServer,
                                local,
                                null
                            )
                        );
                    }

                    // LocalWins: the server no longer has the row, so the local edit puts it back - the same
                    // resurrection last-write-wins performs, here as the resolution of a collected conflict.
                    local.MarkAdded();
                    await _server.Writer.InsertAsync(local, cancellationToken).ConfigureAwait(false);
                    inserted = true;
                }
            }
            catch (SaveConflictException)
            {
                var current = await _server
                    .Writer.GetByIdAsync(key, cancellationToken)
                    .ConfigureAwait(false);

                return SyncUploadOutcome.Conflicted(
                    new SyncConflict(
                        TableName,
                        entry.KeyText,
                        SyncJournalOperation.Upsert,
                        SyncConflictReason.ModifiedOnServer,
                        local,
                        current
                    )
                );
            }
        }

        var columns = ColumnsToSend(entry, inserted, includeUnboundedBinary);

        if (inserted)
        {
            await KeepInsertedBlobsOwedAsync(entry, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        if (columns.Count > 0)
        {
            await RecordInterimAckAsync(entry, local, cancellationToken).ConfigureAwait(false);
            await CopyBinaryColumnsUpAsync(key, columns, cancellationToken).ConfigureAwait(false);
        }

        if (forced)
        {
            await OweUnsentBlobCopiesAsync(entry.KeyText, columns, cancellationToken)
                .ConfigureAwait(false);
        }

        // The server stamped the row with a new version. It is reported to the run rather than written onto the local
        // row: the mirrored version is the resume point of the download, and only the download may move it.
        return SyncUploadOutcome.UploadedWith(
            await ReadServerRowVersionAsync(local, columns.Count > 0, cancellationToken)
                .ConfigureAwait(false)
        );
    }

    /// <summary>Replays a delete under the protection of the version the row carried when it was deleted.</summary>
    /// <remarks>
    /// The key alone would delete unconditionally, so the delete goes through the graph save instead: a stub carrying
    /// the key, the recorded version, and <c>RowState.Removed</c> is exactly the shape the existing version guard
    /// already covers. A row the server no longer has is a no-op rather than a conflict - the delete's intent is
    /// already satisfied. A row that is still there locally means the opposite, and the entry is discarded unsent.
    /// <para>
    /// The recorded version is the mirror as the row carried it when it was deleted, so it is behind the server's
    /// whenever the row's echo had not come down - and the stub is guarded against the later of it and the receipt for
    /// the same reason an update is.
    /// </para>
    /// </remarks>
    private async Task<SyncUploadOutcome> UploadDeleteAsync(
        SyncJournalRow entry,
        TKey key,
        SyncConflictPolicy policy,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken
    )
    {
        if (await LocalRowSurvivedDeleteAsync(key, cancellationToken).ConfigureAwait(false))
        {
            return SyncUploadOutcome.Discarded;
        }

        if (policy == SyncConflictPolicy.LocalWins)
        {
            await _server.Writer.DeleteAsync(key, cancellationToken).ConfigureAwait(false);

            return SyncUploadOutcome.Uploaded;
        }

        var stub = new TEntity();
        WriteKey(stub, key);
        WriteRowVersion(stub, MaxRowVersion(entry.OriginalRowVersion, acknowledgedRowVersion));
        stub.MarkRemoved();

        try
        {
            await _server
                .Writer.SaveAsync(
                    stub,
                    cascadeSave: false,
                    cascadeDelete: false,
                    insertWhenUpdateMissing: false,
                    ConcurrencyMode.Optimistic,
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        catch (SaveConflictException)
        {
            var current = await _server
                .Writer.GetByIdAsync(key, cancellationToken)
                .ConfigureAwait(false);

            return SyncUploadOutcome.Conflicted(
                new SyncConflict(
                    TableName,
                    entry.KeyText,
                    SyncJournalOperation.Delete,
                    current is null
                        ? SyncConflictReason.MissingOnServer
                        : SyncConflictReason.ModifiedOnServer,
                    null,
                    current
                )
            );
        }

        return SyncUploadOutcome.Uploaded;
    }
}

/// <summary>
/// The fixed half of one synchronised table without a version column: a full key-ordered download and a
/// last-write-wins replay.
/// </summary>
/// <remarks>
/// <para>
/// No version column means no change stream: there is nothing to derive a resume point from and nothing to bound a
/// pass with, so every download reads the whole table in ascending primary-key order and applies each batch as an
/// upsert. The cost is O(table) per run, which is why these tables are meant to be the small, rarely changing kind -
/// a large or busy table is better served by a rowversion column and the incremental download it buys.
/// </para>
/// <para>
/// Uploads carry no version either, so a replay can only overwrite. These tables therefore take part exclusively in
/// <see cref="SyncMode.LastWriteWins"/> runs; a <see cref="SyncMode.Versioned"/> run leaves them - and their journal
/// entries - untouched.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class VersionlessSyncTable<TEntity, TKey> : SyncTableBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the table with its local repository, the local raw SQL surface, the server source, and its descriptor.</summary>
    /// <param name="local">The local repository.</param>
    /// <param name="localSqlExecutor">The local raw SQL surface.</param>
    /// <param name="server">The server source.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="localSaveHooks">The save hooks the local repository runs (the registry it was given); null when it runs none.</param>
    public VersionlessSyncTable(
        IRepositoryCore<TEntity, TKey> local,
        ISqlExecutor localSqlExecutor,
        ISyncServerSource<TEntity, TKey> server,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISaveHookRegistry? localSaveHooks = null
    )
        : base(local, localSqlExecutor, server, descriptor, localSaveHooks) { }

    /// <inheritdoc />
    /// <remarks>A key-ordered scan has no version to bound, so the answer is always null and the engine never asks.</remarks>
    public override Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => Task.FromResult<byte[]?>(null);

    /// <inheritdoc />
    /// <remarks>
    /// <para>
    /// The ceiling is ignored - there is no version to bound by. Every row comes down and is applied as an upsert
    /// through the same batch application a versioned download uses (one local transaction per batch, journaling
    /// suppressed), so a row that did not change is overwritten with itself; the delete propagation that follows a
    /// download is what removes the rows the server dropped.
    /// </para>
    /// <para>
    /// A row whose key still holds an unsent local change, or whose parent the local database does not have and the run
    /// may not bring in, is skipped and the scan carries on: there is no resume point to protect here - every run reads
    /// the whole table - so leaving one row alone costs nothing. The table is still reported as stopped, at the first
    /// row it skipped, once the scan is through. A row of a later table that refers to the row skipped here is held back
    /// in turn - the row is either here already, or cannot be had for the same reason it was skipped.
    /// </para>
    /// </remarks>
    public override async Task<SyncDownloadOutcome> DownloadAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncDownloadContext context,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(context);

        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The download batch size must be greater than zero."
            );
        }

        // Blobs an earlier run left owing come first, so a row whose copy failed gets its blob even though the stream
        // has moved past it.
        await CopyOwedBlobsAsync(context, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);

        var applied = 0;
        string? stoppedAt = null;
        string? missingParentTable = null;
        var skippedBySaveHook = false;

        // A row a local save hook skips stops the table there, as in a versioned download: the scan goes no further.
        var stoppedBySaveHook = false;

        await ScanByKeyAsync(
                batchSize,
                "download",
                async rows =>
                {
                    applied += await RunBatchSectionAsync(
                            context,
                            async (holdOf, resolver) =>
                            {
                                var kept = new List<TEntity>(rows.Count);
                                var keptAt = new List<int>(rows.Count);
                                var firstSkipped = -1;
                                string? firstParentTable = null;

                                for (var index = 0; index < rows.Count; index++)
                                {
                                    if (holdOf(rows[index]) is (true, var parentTable))
                                    {
                                        if (firstSkipped < 0)
                                        {
                                            (firstSkipped, firstParentTable) = (index, parentTable);
                                        }

                                        continue;
                                    }

                                    kept.Add(rows[index]);
                                    keptAt.Add(index);
                                }

                                var blocked = await FindRowsMissingParentsAsync(kept, resolver, cancellationToken)
                                    .ConfigureAwait(false);

                                foreach (var (index, parentTable) in blocked)
                                {
                                    if (firstSkipped < 0 || keptAt[index] < firstSkipped)
                                    {
                                        (firstSkipped, firstParentTable) = (keptAt[index], parentTable);
                                    }
                                }

                                var toApplyAt = keptAt.Where((_, index) => !blocked.ContainsKey(index)).ToList();
                                var toApply = kept.Where((_, index) => !blocked.ContainsKey(index)).ToList();
                                var firstSkippedBySaveHook = false;

                                if (toApply.Count > 0)
                                {
                                    // A row whose unique value another local row still holds is skipped as well. A
                                    // row a local save hook skips stops the batch, and the rows after it stay out.
                                    var (colliding, hookSkippedAt) = await ApplyBatchOrFindCollisionsAsync(
                                            toApply,
                                            includeUnboundedBinary,
                                            stopAtFirst: false,
                                            resolver,
                                            cancellationToken
                                        )
                                        .ConfigureAwait(false);

                                    foreach (var index in colliding)
                                    {
                                        if (firstSkipped < 0 || toApplyAt[index] < firstSkipped)
                                        {
                                            (firstSkipped, firstParentTable) = (toApplyAt[index], null);
                                        }
                                    }

                                    if (hookSkippedAt >= 0)
                                    {
                                        stoppedBySaveHook = true;

                                        if (firstSkipped < 0 || toApplyAt[hookSkippedAt] < firstSkipped)
                                        {
                                            (firstSkipped, firstParentTable) = (toApplyAt[hookSkippedAt], null);
                                            firstSkippedBySaveHook = true;
                                        }
                                    }

                                    toApply = toApply
                                        .Where(
                                            (_, index) =>
                                                !colliding.Contains(index)
                                                && (hookSkippedAt < 0 || index < hookSkippedAt)
                                        )
                                        .ToList();
                                }

                                if (firstSkipped >= 0 && stoppedAt is null)
                                {
                                    stoppedAt = FormatKey(ReadKey(rows[firstSkipped]));
                                    missingParentTable = firstParentTable;
                                    skippedBySaveHook = firstSkippedBySaveHook;
                                }

                                return toApply.Count;
                            },
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return !stoppedBySaveHook;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        return new SyncDownloadOutcome(applied, stoppedAt)
        {
            MissingParentTableName = missingParentTable,
            SkippedBySaveHook = skippedBySaveHook,
        };
    }

    /// <summary>
    /// Reads the whole server table in ascending primary-key order, one batch at a time, and hands each non-empty batch
    /// to <paramref name="onBatch"/> (the scan a download and a refresh of this table share).
    /// </summary>
    /// <remarks>
    /// A source whose last key fails to advance while it still claims more is reported rather than spun on, exactly
    /// like a versioned source that ignores its anchor.
    /// </remarks>
    /// <param name="batchSize">The maximum number of rows one batch carries.</param>
    /// <param name="what">The name of the operation, for the message of the progress guard.</param>
    /// <param name="onBatch">Deals with one batch, returning whether the scan goes on.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task ScanByKeyAsync(
        int batchSize,
        string what,
        Func<IReadOnlyList<TEntity>, Task<bool>> onBatch,
        CancellationToken cancellationToken
    )
    {
        string? previousKeyText = null;
        var batch = await _server
            .GetFirstPageAsync(batchSize, cancellationToken)
            .ConfigureAwait(false);

        while (true)
        {
            cancellationToken.ThrowIfCancellationRequested();

            if (batch.Rows.Count == 0)
            {
                return;
            }

            if (!await onBatch(batch.Rows).ConfigureAwait(false) || !batch.HasMore)
            {
                return;
            }

            var lastKey = ReadKey(batch.Rows[^1]);
            var lastKeyText = FormatKey(lastKey);

            if (string.Equals(lastKeyText, previousKeyText, StringComparison.Ordinal))
            {
                throw new InvalidOperationException(
                    $"The {what} of '{TableName}' is not making progress: the last key of a batch did not advance "
                        + "past the one the batch was asked for. The server source is not returning rows in ascending "
                        + "primary-key order above the key it was given."
                );
            }

            previousKeyText = lastKeyText;
            batch = await _server
                .GetPageAfterAsync(lastKey, batchSize, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <inheritdoc />
    /// <remarks>
    /// Rows are inserted rather than saved - the table was emptied first, so there is nothing to compare against -
    /// and the scan is paged by key like a download, with the same progress guard. The ceiling is ignored for the
    /// same reason it is during a download.
    /// </remarks>
    public override Task<int> RefreshAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken = default
    ) => RefreshCoreAsync(ceiling, batchSize, includeUnboundedBinary, null, cancellationToken);

    /// <inheritdoc />
    private protected override async Task<int> RefreshCoreAsync(
        byte[]? ceiling,
        int batchSize,
        bool includeUnboundedBinary,
        SyncParentResolver? resolver,
        CancellationToken cancellationToken
    )
    {
        if (batchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(batchSize),
                "The refresh batch size must be greater than zero."
            );
        }

        // The table was emptied before this, so a blob an earlier run left owing belongs to a row that is gone; the
        // reloaded rows bring their own copies when the refresh carries the columns.
        await _localJournal.RemoveTableBlobCopiesAsync(TableName, cancellationToken)
            .ConfigureAwait(false);

        var inserted = 0;

        await ScanByKeyAsync(
                batchSize,
                "refresh",
                async rows =>
                {
                    inserted += await InsertRefreshedRowsAsync(
                            rows,
                            includeUnboundedBinary,
                            resolver,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return true;
                },
                cancellationToken
            )
            .ConfigureAwait(false);

        return inserted;
    }

    /// <inheritdoc />
    /// <remarks>
    /// Only <see cref="SyncMode.LastWriteWins"/> runs include this table, and without a version the replay can only
    /// overwrite, so neither the mode nor the policy nor an acknowledged version has anything left to choose. Nothing
    /// ever records a receipt for such a table either: an upload with no version to report leaves none behind.
    /// </remarks>
    public override async Task<SyncUploadOutcome> UploadAsync(
        SyncJournalRow entry,
        SyncMode mode,
        SyncConflictPolicy policy,
        bool includeUnboundedBinary,
        byte[]? acknowledgedRowVersion,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entry);

        return await UploadLastWriteWinsAsync(entry, includeUnboundedBinary, cancellationToken)
            .ConfigureAwait(false);
    }
}

/// <summary>
/// Bidirectional differential sync between the server database and the local one, with the server as the source of truth.
/// </summary>
/// <remarks>
/// <para>
/// A run uploads first and downloads second. Uploading first means a local change reaches the server before the server's
/// rows come back down, so a change accepted by the server is not immediately overwritten by its own pre-upload state.
/// It is also where <see cref="SyncConflictPolicy.ServerWins"/> settles the rows it discards: each one takes the
/// server's content in place of the local change, and a row the server does not have is left to the delete propagation
/// that follows the download.
/// </para>
/// <para>
/// Tables are visited in foreign-key order - parents before children when rows are written, children before parents when
/// rows are deleted - and each table is drained completely before the next one starts, so a child row is never applied
/// before the parent it points at.
/// </para>
/// <para>
/// Nothing here resolves a conflict silently. Under the default policy a local change that collides with the server stays
/// in the journal and comes back in <see cref="SyncResult.Conflicts"/> with both sides of the disagreement attached - and
/// the row it describes stays where it is, because both halves of the download leave every key the journal still holds an
/// entry for alone: the row itself is not overwritten, and the delete propagation does not remove it.
/// </para>
/// <para>
/// Leaving such a row alone has a price, and the run says so rather than paying it quietly. A table's download stops at
/// the first row whose local change is still unsent (the tables after it go on, bringing in from the server any parent
/// that was behind the stopping point); what was left unread is reported in <see cref="SyncResult.Truncations"/> and
/// comes down once the change that stopped it has been settled - which is the caller's to decide and re-run.
/// </para>
/// </remarks>
public sealed class SyncEngine
{
    /// <summary>The key of <see cref="Exception.Data"/> under which a <see cref="SyncAsync"/> that throws hands on the local rows it had changed on its own (an <see cref="IReadOnlyList{T}"/> of <see cref="SyncLocalRowChange"/>; see <see cref="SyncResult.LocalRowChanges"/>).</summary>
    public const string LocalRowChangesDataKey = "QuickER.Sync.LocalRowChanges";

    private readonly IReadOnlyList<ISyncTable> _tables;
    private readonly SyncJournal _journal;

    /// <summary>Where the run in flight notes the local rows it changes on its own (set by <see cref="SyncAsync"/>; runs never overlap).</summary>
    private SyncLocalRowChangeLog? _changeLog;

    /// <summary>Creates the engine over the synchronised tables, ordered parents first.</summary>
    /// <param name="tables">The synchronised tables in foreign-key order (a parent always precedes its children).</param>
    /// <param name="journal">The local journal of offline edits.</param>
    public SyncEngine(IEnumerable<ISyncTable> tables, SyncJournal journal)
    {
        ArgumentNullException.ThrowIfNull(tables);
        ArgumentNullException.ThrowIfNull(journal);
        _tables = tables.ToList();
        _journal = journal;
        _keyTextNormalizers = _tables
            .Where(table => table is ISyncTableRunSupport { NormalizeKeyText: not null })
            .ToDictionary(
                table => table.TableName,
                table => ((ISyncTableRunSupport)table).NormalizeKeyText!,
                StringComparer.Ordinal
            );
    }

    /// <summary>The rewrite of each table whose key text form has changed (see <see cref="SyncJournal.NormalizeKeyTextsAsync"/>).</summary>
    private readonly IReadOnlyDictionary<string, Func<string, string>> _keyTextNormalizers;

    /// <summary>Creates the journal's tables when they are missing and brings the key texts in them to today's form.</summary>
    private async Task PrepareJournalAsync(CancellationToken cancellationToken)
    {
        await _journal.EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        await _journal
            .NormalizeKeyTextsAsync(_keyTextNormalizers, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Runs one full sync: replays the local journal, then pulls the server's changes down.</summary>
    /// <remarks>
    /// What the upload learns is carried into the download through the acknowledgement table rather than through the
    /// run: the version the server stamped on each row that went up is written down as it goes, so the download can
    /// tell an echo from a change worth applying. Calling <see cref="UploadAsync"/> and <see cref="DownloadAsync"/>
    /// separately is therefore not a lesser arrangement - the receipts outlive the call that wrote them, and a
    /// download run on its own recognises the echoes of every upload whose row has yet to come back down.
    /// </remarks>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task<SyncResult> SyncAsync(
        SyncOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncOptions();

        // Checked before the upload rather than left to the download: by then the upload may already have changed
        // both databases, and a run that does that and only then reports a bad argument is not one anybody asked for.
        if (options.DownloadBatchSize <= 0)
        {
            return Task.FromException<SyncResult>(
                new ArgumentOutOfRangeException(
                    nameof(options),
                    options.DownloadBatchSize,
                    "The download batch size must be greater than zero."
                )
            );
        }

        return _journal.Gate.RunExclusiveAsync(
            async () =>
            {
                var changes = new SyncLocalRowChangeLog();
                _changeLog = changes;

                try
                {
                    await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

                    var conflicts = new List<SyncConflict>();
                    var upload = await UploadCoreAsync(
                            options,
                            conflicts,
                            deferServerWins: true,
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                    var download = await DownloadCoreAsync(
                            options,
                            upload.DeferredServerWins,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return new SyncResult(
                        upload.Uploaded,
                        download.Downloaded,
                        download.DeletedLocally,
                        upload.Discarded + download.Discarded,
                        conflicts
                    )
                    {
                        Truncations = download.Truncations,
                        LocalRowChanges = changes.ToList(),
                    };
                }
                catch (Exception failure)
                {
                    // The run stops, but what it did to local rows on its own stays done; the caller learns which rows
                    // through the exception, whose type is left as it is.
                    if (changes.ToList() is { Count: > 0 } changed)
                    {
                        failure.Data[LocalRowChangesDataKey] = changed;
                    }

                    throw;
                }
                finally
                {
                    _changeLog = null;
                }
            },
            cancellationToken
        );
    }

    /// <summary>Rebuilds the local database from the server's rows: every synchronised table is emptied and reloaded.</summary>
    /// <remarks>
    /// <para>
    /// This is for building the local database the first time, for recovering one that was lost or corrupted, and for
    /// starting over when a database has fallen so far behind that catching up row by row is not worth it. It is not a
    /// faster <see cref="SyncAsync"/> and does not replace one: it transfers every row of every synchronised table, so
    /// over a slow link and a large table the transfer is what dominates and an ordinary run - which carries only what
    /// changed - is the cheaper one from the second run onwards.
    /// </para>
    /// <para>
    /// What makes it fast is what it leaves out. Nothing is compared with the row it replaces, no anchor is derived
    /// per batch, no key set is fetched to find the rows the server dropped (they are gone by construction), and no
    /// journal is replayed. All of it is skipped because the answer is known in advance: the local side ends up as a
    /// copy of the server's.
    /// </para>
    /// <para>
    /// It touches the synchronised tables and nothing else. A table the local database keeps for itself - a settings
    /// table, a cache, anything excluded where the engine was put together - is not part of this and is left
    /// exactly as it was; and <see cref="SyncRefreshOptions.Mode"/> can narrow a run further.
    /// </para>
    /// <para>
    /// Rows outside the refresh that refer to the tables it empties are refused rather than lost. When a local row of
    /// a table the run leaves out - one narrowed away by <see cref="SyncRefreshOptions.Mode"/> or
    /// <see cref="SyncRefreshOptions.ExcludedEntityTypes"/>, one excluded where the engine was put together, or one the
    /// engine does not synchronise at all - refers to a row of a table the run empties, the run throws
    /// <see cref="SyncRefreshScopeException"/> before it reads or deletes anything: emptying the table would take that
    /// row with it under <c>ON DELETE CASCADE</c>, or fail on the local foreign key. The check looks at the rows, so a
    /// table left out that holds no such row does not stand in the way; a table the local database does not have is
    /// not asked. A foreign key that refers to a unique constraint, or spans several columns, cannot be asked which rows
    /// it refers to, so such a table refuses the run whenever the local database has it. A table implemented outside
    /// the generated code is not checked.
    /// </para>
    /// <para>
    /// Unsent local changes are refused rather than lost. When the journal is not empty the run throws
    /// <see cref="SyncPendingChangesException"/> before deleting anything;
    /// <see cref="SyncRefreshOptions.Force"/> is the explicit request to drop them instead.
    /// </para>
    /// <para>
    /// Local blobs are refused on the same terms. When a synchronised table has unbounded binary columns - which the
    /// row transfer leaves out, so the reload does not bring them back - the run throws
    /// <see cref="SyncUnboundedBinaryLossException"/> before deleting anything, until
    /// <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> says to reload them too or
    /// <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> says the loss is intended. A generated setup
    /// without such columns never sees this.
    /// </para>
    /// <para>
    /// <b>Crash safety.</b> The run is not one transaction - the generated repositories manage their own connections,
    /// so nothing here can enlist in a transaction of its own making - but every point at which it commits is a state
    /// a later run can start from, which is the property that actually matters. The deletes go children first and the
    /// reloads parents first, so no foreign key ever points at a row that is not there; and each table's rows arrive
    /// in ascending version order, so a table interrupted part way holds exactly the rows below the version it
    /// stopped at - precisely the resume point that the local maximum yields. A refresh cut short anywhere is
    /// therefore repaired by running it again, and an ordinary <see cref="SyncAsync"/> in the meantime picks up from
    /// where it stopped rather than mistaking the gap for a server-side deletion.
    /// </para>
    /// <para>
    /// The one state this leaves that a single transaction would not is a partly rebuilt local database: between the
    /// first delete and the last row of the last table, a reader of the local database sees fewer rows than either
    /// side holds. Nothing is lost by it - the server still has everything - but a refresh is not something to run
    /// underneath a live screen.
    /// </para>
    /// </remarks>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <exception cref="SyncRefreshScopeException">A local row of a table outside the refresh refers to a row of a table it would empty.</exception>
    /// <exception cref="SyncPendingChangesException">The journal holds unsent local changes and <see cref="SyncRefreshOptions.Force"/> was not set.</exception>
    /// <exception cref="SyncUnboundedBinaryLossException">A synchronised table has unbounded binary columns and neither <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> nor <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> was set.</exception>
    public async Task<SyncRefreshResult> RefreshAsync(
        SyncRefreshOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncRefreshOptions();

        // Checked here rather than left to the per-table call: by then the local tables have already been emptied, and
        // a run that wipes the local database and only then reports a bad argument is not one anybody asked for.
        if (options.BatchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.BatchSize,
                "The refresh batch size must be greater than zero."
            );
        }

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);

        // Also before anything is deleted, and before the journal is even read: a local blob that only exists here is
        // gone for good once its row is, and neither answer to that is one the engine may pick on the caller's behalf.
        if (!options.IncludeUnboundedBinary && !options.DiscardLocalUnboundedBinaries)
        {
            var atStake = scope
                .Where(table => table.UnboundedBinaryColumnNames.Count > 0)
                .Select(table => new SyncUnboundedBinaryColumns(
                    table.TableName,
                    table.UnboundedBinaryColumnNames
                ))
                .ToList();

            if (atStake.Count > 0)
            {
                throw new SyncUnboundedBinaryLossException(atStake);
            }
        }

        var startedAt = Stopwatch.GetTimestamp();

        // The whole refresh holds the run lock and the write lock: it wipes tables wholesale, so a local write landing
        // part way through would be deleted, or would point at a parent the wipe is about to remove. Its own writes run
        // suppressed and take no lock.
        return await _journal
            .Gate.RunExclusiveAsync(
                () =>
                    _journal.Gate.WriteExclusiveAsync(
                        () => RefreshCoreAsync(options, scope, startedAt, cancellationToken),
                        cancellationToken
                    ),
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>The body of <see cref="RefreshAsync"/>, run under both locks once the arguments have been checked.</summary>
    private async Task<SyncRefreshResult> RefreshCoreAsync(
        SyncRefreshOptions options,
        IReadOnlyList<ISyncTable> scope,
        long startedAt,
        CancellationToken cancellationToken
    )
    {
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);

        // Before anything is read or changed: a row outside the scope that refers to a row the run is about to delete
        // goes with it under CASCADE, or makes the deletion fail. Both locks are held, so no journaled write can add
        // such a row between this check and the deletion.
        var blocking = new List<SyncRefreshScopeReference>();

        foreach (var table in scope)
        {
            if (table is not ISyncTableRunSupport support)
            {
                continue;
            }

            foreach (
                var referring in await support
                    .FindReferencesFromOutsideAsync(scopeTableNames, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                blocking.Add(new SyncRefreshScopeReference(referring, table.TableName));
            }
        }

        if (blocking.Count > 0)
        {
            throw new SyncRefreshScopeException(blocking);
        }

        await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

        // Only the entries of the tables this refresh covers count as being at stake: an entry of a table outside
        // the scope describes rows the run will not touch, so it neither blocks the run nor is dropped by Force.
        var pending = (await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false))
            .Where(entry => scopeTableNames.Contains(entry.TableName))
            .ToList();

        if (pending.Count > 0 && !options.Force)
        {
            throw new SyncPendingChangesException(
                pending
                    .GroupBy(entry => entry.TableName, StringComparer.Ordinal)
                    .Select(group => new SyncPendingChange(group.Key, group.Count()))
                    .ToList()
            );
        }

        if (pending.Count > 0)
        {
            // Dropped before anything is deleted, so an interrupted forced run does not leave entries describing rows
            // that the reload has already replaced.
            await RemoveAsync(pending.Select(entry => entry.Id).ToList(), cancellationToken)
                .ConfigureAwait(false);
        }

        if (scope.Count == 0)
        {
            return new SyncRefreshResult([], pending.Count, Stopwatch.GetElapsedTime(startedAt));
        }

        // One ceiling for the whole run, for the same reason an ordinary run uses one (and from a versioned table,
        // for the same reason as well).
        var ceilingTable = scope.FirstOrDefault(table => !table.IsVersionless);
        var ceiling = ceilingTable is null
            ? null
            : await ceilingTable.GetChangeCeilingAsync(cancellationToken).ConfigureAwait(false);
        var deleted = new int[scope.Count];

        // Children first: emptying a parent while its children are still there is what a foreign key forbids.
        for (var index = scope.Count - 1; index >= 0; index--)
        {
            deleted[index] = await scope[index]
                .DeleteAllLocalAsync(cancellationToken)
                .ConfigureAwait(false);
        }

        // The receipts go once the rows they are about have: a refresh replaces every row of these tables along with
        // its mirrored version, so a per-row record of what the server once acknowledged has nothing left to be about.
        // Not before the deletion, which can fail - the rows would then stay, with nothing left to tell an edit of one
        // the server has already taken from a row it has never seen. A run that stops between the two leaves receipts
        // for rows that are gone; the reload writes the server's version, which is never behind a receipt, so such a
        // receipt changes nothing - unless the server has lost the row too, when a row later made under the same key
        // locally is sent as an update and reported missing on the server.
        foreach (var table in scope)
        {
            await _journal
                .RemoveTableAcksAsync(table.TableName, cancellationToken)
                .ConfigureAwait(false);
        }

        var tables = new List<SyncRefreshTableResult>(scope.Count);

        // One resolver for the whole reload: a parent brought in ahead of its own batch has to be recognised when that
        // batch arrives, whichever table it belongs to.
        var resolver = new SyncParentResolver(
            _tables,
            scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal),
            SyncParentResolver.NothingPending,
            _journal,
            options.IncludeUnboundedBinary,

            // The reload starts from emptied tables: there is no local row the server does not have.
            propagateDeletes: false
        );

        // Parents first, for the same reason in reverse.
        for (var index = 0; index < scope.Count; index++)
        {
            var table = scope[index];
            var inserted = table is ISyncTableRunSupport support
                ? await support
                    .RefreshAsync(
                        ceiling,
                        options.BatchSize,
                        options.IncludeUnboundedBinary,
                        resolver,
                        cancellationToken
                    )
                    .ConfigureAwait(false)
                : await table
                    .RefreshAsync(
                        ceiling,
                        options.BatchSize,
                        options.IncludeUnboundedBinary,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            tables.Add(new SyncRefreshTableResult(table.TableName, deleted[index], inserted));
        }

        return new SyncRefreshResult(tables, pending.Count, Stopwatch.GetElapsedTime(startedAt));
    }

    /// <summary>Replays the journal against the server and returns how many entries went and how many were dropped.</summary>
    /// <remarks>
    /// Each entry is settled - its receipt written, then the entry removed - the moment the server has taken it,
    /// rather than all of them at the end of the run. An upload interrupted part way then leaves behind entries for
    /// exactly the changes that did not reach the server; the whole-run alternative leaves entries for changes that
    /// did, and the next run resends them, reports a conflict against the row it wrote itself, or overwrites a newer
    /// server row with a stale local one.
    /// </remarks>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="conflicts">The collection the collected conflicts are added to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task<(int Uploaded, int Discarded)> UploadAsync(
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(options);
        ArgumentNullException.ThrowIfNull(conflicts);

        return _journal.Gate.RunExclusiveAsync<(int Uploaded, int Discarded)>(
            async () =>
            {
                await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

                var upload = await UploadCoreAsync(
                        options,
                        conflicts,
                        deferServerWins: false,
                        cancellationToken
                    )
                    .ConfigureAwait(false);

                return (upload.Uploaded, upload.Discarded);
            },
            cancellationToken
        );
    }

    /// <summary>The body of <see cref="UploadAsync"/>, run under the run lock.</summary>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="conflicts">The collection the collected conflicts are added to.</param>
    /// <param name="deferServerWins">
    /// Whether a <see cref="SyncConflictPolicy.ServerWins"/> run leaves applying the server's rows to the download that
    /// follows (what <see cref="SyncAsync"/> asks for) rather than doing it here.
    /// </param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<(
        int Uploaded,
        int Discarded,
        Dictionary<(string TableName, string KeyText), List<long>>? DeferredServerWins
    )> UploadCoreAsync(
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        bool deferServerWins,
        CancellationToken cancellationToken
    )
    {
        var entries = await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false);

        if (entries.Count == 0)
        {
            return (0, 0, null);
        }

        // The journal is append-only, so a row edited several times has several entries. Together they describe the
        // row, and they are settled together. A tuple key needs no separator, so two rows can never collide the way a
        // concatenated string key can when one table name is a prefix of another.
        var rows = new Dictionary<(string TableName, string KeyText), PendingRow>();

        foreach (var entry in entries)
        {
            var rowId = (entry.TableName, entry.KeyText);

            if (!rows.TryGetValue(rowId, out var row))
            {
                row = new PendingRow();
                rows.Add(rowId, row);
            }

            row.Add(entry);
        }

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);

        if (options.Mode == SyncMode.Versioned && options.ConflictPolicy == SyncConflictPolicy.ServerWins)
        {
            // Nothing local is worth sending, so each row this run holds an entry for takes the server's content
            // instead. Only the rows of the tables the run covers: an entry of a table outside it is not this run's to
            // discard, and it goes on counting as unsent - a delete of a parent there still holds its children back.
            // (A last-write-wins run consults the policy only for the conflicts below.)
            var serverWins = rows.Where(pair => scopeTableNames.Contains(pair.Key.TableName))
                .ToDictionary(pair => pair.Key, pair => pair.Value.Ids);

            if (deferServerWins)
            {
                // Applied table by table right after each table's download, parents first: a row put back may point
                // at a parent the server has changed or added since, and that parent is only here once its own table
                // has been downloaded.
                return (0, 0, serverWins);
            }

            var dropped = await ApplyServerWinsAsync(
                    scope,
                    serverWins,
                    options.IncludeUnboundedBinary,
                    cancellationToken
                )
                .ConfigureAwait(false);

            return (0, dropped, null);
        }

        var uploaded = 0;
        var discarded = 0;
        var plans = new List<TableReplayPlan>(scope.Count);

        // A last-write-wins run has no version to decide a conflict by, so the policy has nothing to say about the
        // write itself. The three conflicts the server refuses a write for are the exception (two for a foreign key, one
        // for a unique value): the row will not go up until something changes. ServerWins settles them the way it
        // settles everything in a versioned run - the entries go, and the row takes the server's content - which is the
        // one way to settle a row of a table without a version, since no versioned run ever reaches it.
        var settled =
            options.Mode == SyncMode.LastWriteWins
            && options.ConflictPolicy == SyncConflictPolicy.ServerWins
                ? new Dictionary<(string TableName, string KeyText), List<long>>()
                : null;

        foreach (var table in scope)
        {
            // Planned and the discards settled under the write lock, as one step. The entries were read before the
            // lock, so one of them can belong to a write the application is still in the middle of - recorded, its
            // business write not yet landed. Looking at the local row then would see the row as it was before that
            // write, and settling on what it saw would drop the entry of a write that lands a moment later. Inside the
            // lock every such write has finished, so what the row is now is what the entries describe. Writes the
            // application starts afterwards record entries of their own, which this run never read and never drops.
            var plan = await _journal
                .Gate.WriteExclusiveAsync(
                    async () =>
                    {
                        var planned = await PlanReplayAsync(table, rows, cancellationToken)
                            .ConfigureAwait(false);

                        // A row there is nothing to send for is settled straight away, as a discard.
                        foreach (var ids in planned.Discards)
                        {
                            await RemoveAsync(ids, cancellationToken).ConfigureAwait(false);
                        }

                        return planned;
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
            plans.Add(plan);
            discarded += plan.Discards.Count;
        }

        // An upsert whose unique values the server still holds under a row this run deletes goes after the deletes,
        // with the upserts that refer to it - see FindUpsertsToDeferAsync.
        var deferred = await FindUpsertsToDeferAsync(plans, cancellationToken)
            .ConfigureAwait(false);

        // Upserts run parents first so a child never reaches the server before the row it points at.
        foreach (var plan in plans)
        {
            await ReplayAndSettleAsync(
                    plan,
                    plan.Upserts.Where(upsert =>
                            !deferred.Contains((plan.Table.TableName, upsert.Entry.KeyText))
                        )
                        .ToList()
                )
                .ConfigureAwait(false);
        }

        // Deletes run the other way round, children first, for the same reason in reverse.
        for (var index = plans.Count - 1; index >= 0; index--)
        {
            await ReplayAndSettleAsync(plans[index], plans[index].Deletes).ConfigureAwait(false);
        }

        // The deferred upserts, parents first again, now that the deletes have freed the values they need.
        if (deferred.Count > 0)
        {
            foreach (var plan in plans)
            {
                await ReplayAndSettleAsync(
                        plan,
                        plan.Upserts.Where(upsert =>
                                deferred.Contains((plan.Table.TableName, upsert.Entry.KeyText))
                            )
                            .ToList()
                    )
                    .ConfigureAwait(false);
            }
        }

        if (settled is not { Count: > 0 })
        {
            return (uploaded, discarded, null);
        }

        if (deferServerWins)
        {
            // Applied after each table's download, parents first, exactly like a versioned ServerWins run.
            return (uploaded, discarded, settled);
        }

        discarded += await ApplyServerWinsAsync(
                scope,
                settled,
                options.IncludeUnboundedBinary,
                cancellationToken
            )
            .ConfigureAwait(false);

        return (uploaded, discarded, null);

        async Task ReplayAndSettleAsync(
            TableReplayPlan plan,
            IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> entries
        )
        {
            if (entries.Count == 0)
            {
                return;
            }

            var replayConflicts = settled is null ? conflicts : new List<SyncConflict>();
            var (sent, dropped) = await ReplayAsync(
                    plan.Table,
                    entries,
                    plan.Acknowledged,
                    replayConflicts,
                    options,
                    cancellationToken
                )
                .ConfigureAwait(false);
            uploaded += sent;
            discarded += dropped;
            SettleOrCollect(plan.Table, entries, replayConflicts);
        }

        // In a last-write-wins ServerWins run, a foreign-key conflict goes to the rows the server wins over; anything
        // else is collected as it always is.
        void SettleOrCollect(
            ISyncTable table,
            IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> planned,
            ICollection<SyncConflict> replayConflicts
        )
        {
            if (settled is null)
            {
                return;
            }

            foreach (var conflict in replayConflicts)
            {
                if (
                    conflict.Reason
                        is SyncConflictReason.ParentMissingOnServer
                            or SyncConflictReason.DeleteRefusedOnServer
                            or SyncConflictReason.UniqueValueTakenOnServer
                    && planned.FirstOrDefault(entry =>
                        string.Equals(entry.Entry.KeyText, conflict.KeyText, StringComparison.Ordinal)
                    )
                        is { Ids: { } ids }
                )
                {
                    settled[(table.TableName, conflict.KeyText)] = ids;
                }
                else
                {
                    conflicts.Add(conflict);
                }
            }
        }
    }

    /// <summary>Decides, for every row of one table the journal holds entries for, what the replay sends.</summary>
    /// <remarks>
    /// <para>
    /// The decision is made from what the local row is now and from everything recorded about it, never from the last
    /// entry alone. The journal is written before the business write, so its last entry can describe a write that
    /// never landed - and acting on that one would throw away whatever the earlier entries were about.
    /// </para>
    /// <list type="table">
    /// <listheader><term>Local row</term><description>What the replay does</description></listheader>
    /// <item><term>There, with an insert or update recorded</term><description>Sends its current content.</description></item>
    /// <item><term>There, with only deletes recorded</term><description>Drops the entries: the delete never landed.</description></item>
    /// <item><term>Gone, with a delete recorded and a server version known</term><description>Deletes it on the server, guarded by the latest version the server is known to have held (the deletes' recorded versions and the receipt).</description></item>
    /// <item><term>Gone, otherwise</term><description>Drops the entries: the row never reached the server.</description></item>
    /// </list>
    /// <para>
    /// A table without a version column has no version to know, so a delete recorded for a row that is gone is sent
    /// unconditionally. A table the fixed classes do not implement has no way to report which rows are there, and its
    /// rows are replayed by the last entry, as they always were.
    /// </para>
    /// </remarks>
    private async Task<TableReplayPlan> PlanReplayAsync(
        ISyncTable table,
        Dictionary<(string TableName, string KeyText), PendingRow> rows,
        CancellationToken cancellationToken
    )
    {
        var tableRows = rows.Where(pair =>
                string.Equals(pair.Key.TableName, table.TableName, StringComparison.Ordinal)
            )
            .OrderBy(pair => pair.Value.Ids[0])
            .ToList();
        var plan = new TableReplayPlan(table);

        if (tableRows.Count == 0)
        {
            return plan;
        }

        // Read once for this table's pass: the receipts of the keys about to be replayed are what their version
        // guards are read against.
        plan.Acknowledged = await _journal
            .ReadAcksAsync(table.TableName, cancellationToken)
            .ConfigureAwait(false);
        var localKeyTexts = table is ISyncTableRunSupport support
            ? await support
                .FindLocalKeyTextsAsync(
                    tableRows.Select(pair => pair.Key.KeyText).ToList(),
                    cancellationToken
                )
                .ConfigureAwait(false)
            : null;

        foreach (var (rowId, row) in tableRows)
        {
            var operation = localKeyTexts is null
                ? row.LatestOperation
                : Decide(
                    row,
                    localKeyTexts.Contains(rowId.KeyText),
                    table.IsVersionless,
                    plan.Acknowledged.TryGetValue(rowId.KeyText, out var acknowledged)
                        ? acknowledged
                        : null
                );

            switch (operation)
            {
                case SyncJournalOperation.Upsert:
                    // A row deleted and created again under the same key carries the version the server held for
                    // the row it deleted: the new local row has no mirrored version of its own, and without it the
                    // upload takes the row for one the server has never seen and inserts it (see UploadUpsertAsync).
                    plan.Upserts.Add(
                        (row.ToEntry(rowId, SyncJournalOperation.Upsert, row.DeletedRowVersion), row.Ids)
                    );
                    break;

                case SyncJournalOperation.Delete:
                    plan.Deletes.Add(
                        (
                            row.ToEntry(
                                rowId,
                                SyncJournalOperation.Delete,
                                localKeyTexts is null ? row.LatestRowVersion : row.DeletedRowVersion
                            ),
                            row.Ids
                        )
                    );
                    break;

                default:
                    plan.Discards.Add(row.Ids);
                    break;
            }
        }

        return plan;
    }

    /// <summary>The operation a row's replay sends, or null when there is nothing to send (see <see cref="PlanReplayAsync"/>).</summary>
    /// <param name="row">Everything the journal holds about the row.</param>
    /// <param name="existsLocally">Whether the local table holds the row now.</param>
    /// <param name="versionless">Whether the table has no version column.</param>
    /// <param name="acknowledged">The receipt of the row, or null when there is none.</param>
    private static SyncJournalOperation? Decide(
        PendingRow row,
        bool existsLocally,
        bool versionless,
        byte[]? acknowledged
    )
    {
        if (existsLocally)
        {
            return row.HasUpsert ? SyncJournalOperation.Upsert : null;
        }

        if (!row.HasDelete)
        {
            return null;
        }

        return versionless || SyncRowVersions.Max(row.DeletedRowVersion, acknowledged) is not null
            ? SyncJournalOperation.Delete
            : null;
    }

    /// <summary>
    /// Settles the run's journal entries in the server's favour: each row they name takes the server's content, and the
    /// entries go. Returns how many entries were dropped.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Scoped to the tables the run covers - an entry of an excluded or out-of-mode table is not this run's to decide
    /// about, so it stays for the run that does cover it.
    /// </para>
    /// <para>
    /// The download alone cannot stand in for this: it only carries rows the server has changed since they were last
    /// mirrored, and a local edit to a row nobody else has touched would survive the run that was told to discard it -
    /// with its entry gone, for good.
    /// </para>
    /// <para>
    /// Each table is settled under the write lock, parents first (a row put back may be the one another row points
    /// at), and the journal is read again inside it. What is dropped is exactly the entries the run read at its start:
    /// a key that has picked up a newer entry since - the application kept writing while the run was in flight - is
    /// left with that entry and its content untouched, because the newer edit is not one the caller asked to discard.
    /// </para>
    /// <para>
    /// Within a table the order is apply, record the receipts, drop the entries. The applied row's local content is the
    /// server's content at the version just read, and the mirrored version deliberately does not say so; the receipt is
    /// the only thing that does. Interrupted either side of the receipts the run is still sound: before them, the
    /// entries stay and the next run applies the same rows and records them then; after them but before the entries
    /// go, the next run applies the same rows again - which changes nothing - and writes the same receipts over
    /// themselves. The other order would leave a local edit standing with nothing left to say it is there.
    /// </para>
    /// </remarks>
    private async Task<int> ApplyServerWinsAsync(
        IReadOnlyList<ISyncTable> scope,
        Dictionary<(string TableName, string KeyText), List<long>> idsByRow,
        bool includeUnboundedBinary,
        CancellationToken cancellationToken
    )
    {
        var discarded = 0;
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        IReadOnlySet<long> droppedIds = idsByRow.Values.SelectMany(ids => ids).ToHashSet();

        foreach (var table in scope)
        {
            var rows = idsByRow
                .Where(pair =>
                    string.Equals(pair.Key.TableName, table.TableName, StringComparison.Ordinal)
                )
                .OrderBy(pair => pair.Value[0])
                .ToList();

            if (rows.Count == 0)
            {
                continue;
            }

            var (dropped, _) = await _journal
                .Gate.WriteExclusiveAsync(
                    () =>
                        ApplyServerWinsToTableAsync(
                            table,
                            rows,
                            includeUnboundedBinary,

                            // An upload on its own is followed by no delete propagation, so a row the server does not
                            // have stays where it is, as it always did.
                            propagateDeletes: false,
                            droppedIds,
                            scopeTableNames,
                            cancellationToken
                        ),
                    cancellationToken
                )
                .ConfigureAwait(false);
            discarded += dropped;
        }

        return discarded;
    }

    /// <summary>Settles one table's entries in the server's favour (see <see cref="ApplyServerWinsAsync"/>); runs under the write lock.</summary>
    /// <remarks>
    /// A row put back can refer to a parent the local database does not have. The parent is brought in first when the
    /// run may (see <see cref="SyncParentResolver"/>); a row whose parent it may not bring in - the parent's table is
    /// outside the run, or the parent has an unsent delete the run is not discarding - is left as it is, and its entries
    /// stay for a run that can settle it.
    /// </remarks>
    /// <param name="table">The table.</param>
    /// <param name="rows">The table's rows the run settles, with the entries of each.</param>
    /// <param name="includeUnboundedBinary">Whether the run carries the unbounded binary columns.</param>
    /// <param name="propagateDeletes">Whether a delete propagation follows in the run: a row the server does not have is then removed before the server's rows are put back rather than after (see <see cref="ISyncTableRunSupport.ApplyServerRowsAsync"/>).</param>
    /// <param name="droppedIds">Every entry the run is settling this way (they hold no parent back).</param>
    /// <param name="scopeTableNames">The tables the run covers.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The entries dropped, and the local rows removed because the server does not have them.</returns>
    private async Task<(int Dropped, int Removed)> ApplyServerWinsToTableAsync(
        ISyncTable table,
        IReadOnlyList<KeyValuePair<(string TableName, string KeyText), List<long>>> rows,
        bool includeUnboundedBinary,
        bool propagateDeletes,
        IReadOnlySet<long> droppedIds,
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    )
    {
        // The keys that picked up an entry the run did not read: their newer local edit stands.
        var readIds = rows.SelectMany(pair => pair.Value).ToHashSet();
        var editedSince = (await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false))
            .Where(entry =>
                string.Equals(entry.TableName, table.TableName, StringComparison.Ordinal)
                && !readIds.Contains(entry.Id)
            )
            .Select(entry => entry.KeyText)
            .ToHashSet(StringComparer.Ordinal);
        var keyTexts = rows.Select(pair => pair.Key.KeyText)
            .Where(keyText => !editedSince.Contains(keyText))
            .ToList();

        IReadOnlyList<string> held = [];
        IReadOnlyList<string> removed = [];

        if (keyTexts.Count > 0)
        {
            IReadOnlyList<SyncAppliedServerRow> applied;

            if (table is ISyncTableRunSupport support)
            {
                var pending = await ReadPendingAsync(table.TableName, droppedIds, cancellationToken)
                    .ConfigureAwait(false);
                (applied, held, removed) = await support
                    .ApplyServerRowsAsync(
                        keyTexts,
                        includeUnboundedBinary,
                        propagateDeletes,
                        new SyncParentResolver(
                            _tables,
                            scopeTableNames,
                            pending,
                            _journal,
                            includeUnboundedBinary,
                            propagateDeletes,
                            _changeLog
                        ),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }
            else
            {
                applied = await table
                    .ApplyServerRowsAsync(keyTexts, includeUnboundedBinary, cancellationToken)
                    .ConfigureAwait(false);
            }

            foreach (var row in applied)
            {
                // A table with no version has nothing to acknowledge (and no versioned run to reach it here).
                if (row.ServerRowVersion is not { Length: > 0 } serverRowVersion)
                {
                    continue;
                }

                await _journal
                    .RecordAckAsync(table.TableName, row.KeyText, serverRowVersion, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        // A removed row takes its receipt with it, as in the delete propagation.
        if (removed.Count > 0)
        {
            await _journal
                .RemoveAcksAsync(table.TableName, removed, cancellationToken)
                .ConfigureAwait(false);
        }

        var dropRows = rows.Where(pair => !held.Contains(pair.Key.KeyText, StringComparer.Ordinal))
            .ToList();
        var dropIds = dropRows.SelectMany(pair => pair.Value).ToList();
        await RemoveAsync(dropIds, cancellationToken).ConfigureAwait(false);

        if (_changeLog is { } changes)
        {
            foreach (var pair in dropRows)
            {
                changes.Add(
                    table.TableName,
                    pair.Key.KeyText,
                    SyncLocalRowChangeReason.DiscardedByServerWins
                );
            }

            foreach (var keyText in removed)
            {
                changes.Add(table.TableName, keyText, SyncLocalRowChangeReason.RemovedBeforeDownload);
            }
        }

        return (dropIds.Count, removed.Count);
    }

    /// <summary>
    /// Finds the upserts that have to wait until the run's deletes have gone: the ones whose unique values the server
    /// still holds under another row, and the upserts that refer to one of those.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Upserts go before deletes, parents first, and deletes after, children first - the order the foreign keys need.
    /// A row deleted here and recreated under another key with the same unique value turns that around: the insert
    /// reaches the server while the old row still holds the value, and the server refuses it. So in a table the run
    /// also deletes rows of, each upsert is checked against the server's unique constraints first, and one that would
    /// collide goes after the deletes. If it still collides then - the delete it waited for did not go through - it is
    /// reported as <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>.
    /// </para>
    /// <para>
    /// An upsert that refers to a deferred row - in another table, or in the same table - goes with it: sent before its
    /// parent, it would be refused for the parent the server does not have yet. The check costs a round trip per upsert,
    /// and only in a table with deletes in the same run.
    /// </para>
    /// </remarks>
    private async Task<HashSet<(string TableName, string KeyText)>> FindUpsertsToDeferAsync(
        IReadOnlyList<TableReplayPlan> plans,
        CancellationToken cancellationToken
    )
    {
        var deferred = new HashSet<(string TableName, string KeyText)>();

        foreach (var plan in plans)
        {
            if (
                plan.Deletes.Count == 0
                || plan.Upserts.Count == 0
                || plan.Table is not ISyncTableRunSupport support
            )
            {
                continue;
            }

            foreach (var (entry, _) in plan.Upserts)
            {
                if (
                    await support
                        .CollidesOnServerAsync(entry.KeyText, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    deferred.Add((plan.Table.TableName, entry.KeyText));
                }
            }
        }

        if (deferred.Count == 0)
        {
            return deferred;
        }

        // The rows that refer to a deferred row, as far as it reaches.
        var parentsOf = new Dictionary<(string TableName, string KeyText), IReadOnlyList<(string TableName, string KeyText)>>();

        foreach (var plan in plans)
        {
            if (plan.Table is not ISyncTableRunSupport support)
            {
                continue;
            }

            foreach (var (entry, _) in plan.Upserts)
            {
                if (!deferred.Contains((plan.Table.TableName, entry.KeyText)))
                {
                    var (_, parents) = await support
                        .ReadLocalParentsAsync(entry.KeyText, cancellationToken)
                        .ConfigureAwait(false);
                    parentsOf[(plan.Table.TableName, entry.KeyText)] = parents;
                }
            }
        }

        for (var changed = true; changed; )
        {
            changed = false;

            foreach (var (row, parents) in parentsOf)
            {
                if (!deferred.Contains(row) && parents.Any(deferred.Contains))
                {
                    deferred.Add(row);
                    changed = true;
                }
            }
        }

        return deferred;
    }

    /// <summary>Replays the planned entries of one table, in the order they were first recorded.</summary>
    /// <remarks>
    /// <para>
    /// The receipt is written <i>before</i> the entry is removed, which is what a crash between the two is measured
    /// against: both records survive, the next run replays the same local content with the acknowledged version as its
    /// original, and the server takes it again. The other order leaves the row with a stale mirror and no receipt to
    /// correct it, and the next version-guarded replay of that key reports a conflict with nobody.
    /// </para>
    /// <para>
    /// A delete that reached the server goes the other way: the row is gone, so its receipt is dropped rather than
    /// written, and dropping it first means a crash in between leaves an entry whose replay deletes a row the server
    /// no longer has - a no-op.
    /// </para>
    /// <para>
    /// A replay that finds nothing to send after all - an upsert whose row has gone since it was planned, a delete whose
    /// row is back - drops the entries without taking the lock, and that is sound. They are the entries the plan looked
    /// at under the lock, so every write they describe had finished by then; whatever the application has done to the
    /// row since was recorded in entries of its own, which this run never read and leaves where they are.
    /// </para>
    /// <para>
    /// A write the server refuses for a foreign key is tried again once the others have gone, as long as another write
    /// of the table went through in between. The entries of a table are replayed in the order they were first recorded,
    /// which is not parent-first within a table that refers to itself: a row edited before a new parent was created and
    /// then moved under it goes up before the parent, and a parent whose delete was recorded first goes before its
    /// child's. Each further pass needs a write of the previous one to have gone through, so there are fewer passes than
    /// entries. What is still refused when no write goes through any more is reported - or, in a last-write-wins
    /// <see cref="SyncConflictPolicy.ServerWins"/> run, settled - and only that. A write refused for a unique value is not
    /// tried again: no other write of the table frees the value (a delete that does goes before it - see
    /// <see cref="FindUpsertsToDeferAsync"/>).
    /// </para>
    /// </remarks>
    private async Task<(int Uploaded, int Discarded)> ReplayAsync(
        ISyncTable table,
        IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> planned,
        IReadOnlyDictionary<string, byte[]> acknowledged,
        ICollection<SyncConflict> conflicts,
        SyncOptions options,
        CancellationToken cancellationToken
    )
    {
        var uploaded = 0;
        var discarded = 0;
        var remaining = planned;

        for (var pass = 0; pass < planned.Count; pass++)
        {
            var refused = new List<((SyncJournalRow Entry, List<long> Ids) Planned, SyncConflict Conflict)>();
            var (sent, dropped) = await ReplayPassAsync(
                    table,
                    remaining,
                    acknowledged,
                    conflicts,
                    refused,
                    options,
                    cancellationToken
                )
                .ConfigureAwait(false);
            uploaded += sent;
            discarded += dropped;

            if (refused.Count == 0)
            {
                break;
            }

            if (sent == 0 || pass + 1 >= planned.Count)
            {
                foreach (var (_, conflict) in refused)
                {
                    conflicts.Add(conflict);
                }

                break;
            }

            remaining = refused.Select(item => item.Planned).ToList();
        }

        return (uploaded, discarded);
    }

    /// <summary>Replays the planned entries once, in order; a write refused for a foreign key goes to <paramref name="refused"/> rather than <paramref name="conflicts"/>.</summary>
    private async Task<(int Uploaded, int Discarded)> ReplayPassAsync(
        ISyncTable table,
        IReadOnlyList<(SyncJournalRow Entry, List<long> Ids)> planned,
        IReadOnlyDictionary<string, byte[]> acknowledged,
        ICollection<SyncConflict> conflicts,
        List<((SyncJournalRow Entry, List<long> Ids) Planned, SyncConflict Conflict)> refused,
        SyncOptions options,
        CancellationToken cancellationToken
    )
    {
        var uploaded = 0;
        var discarded = 0;

        foreach (var (entry, ids) in planned)
        {
            SyncUploadOutcome outcome;

            // Only the call that writes to the server is guarded: a failure of the local receipt or of the journal
            // clean-up below is the local database's own, and reporting it as a refusal by the server would hide it.
            try
            {
                outcome = await table
                    .UploadAsync(
                        entry,
                        options.Mode,
                        options.ConflictPolicy,
                        options.IncludeUnboundedBinary,
                        acknowledged.TryGetValue(entry.KeyText, out var acknowledgedRowVersion)
                            ? acknowledgedRowVersion
                            : null,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }
            catch (Exception exception)
                when (exception is not OperationCanceledException
                    && table is ISyncTableRunSupport support
                )
            {
                var refusal = await ExplainServerRefusalAsync(
                        table,
                        support,
                        entry,
                        cancellationToken
                    )
                    .ConfigureAwait(false);

                if (refusal is null)
                {
                    System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(exception).Throw();
                    throw;
                }

                outcome = SyncUploadOutcome.Conflicted(refusal);
            }

            if (outcome.Conflict is { } conflict)
            {
                // The entries stay in the journal so the caller can decide and re-run - unless the server refused the
                // write for a foreign key, which the next pass may get past (see ReplayAsync).
                if (
                    conflict.Reason
                    is SyncConflictReason.ParentMissingOnServer
                        or SyncConflictReason.DeleteRefusedOnServer
                )
                {
                    refused.Add(((entry, ids), conflict));
                }
                else
                {
                    conflicts.Add(conflict);
                }

                continue;
            }

            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                if (outcome.Sent)
                {
                    await _journal
                        .RemoveAcksAsync(table.TableName, [entry.KeyText], cancellationToken)
                        .ConfigureAwait(false);
                }
            }
            else if (outcome.ServerRowVersion is { Length: > 0 } serverRowVersion)
            {
                await _journal
                    .RecordAckAsync(
                        table.TableName,
                        entry.KeyText,
                        serverRowVersion,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            await RemoveAsync(ids, cancellationToken).ConfigureAwait(false);

            // A settled entry that never reached the server (a stale intent) is a discard, not an upload:
            // counting it as one would report a change as delivered when nothing was sent.
            if (outcome.Sent)
            {
                uploaded++;
            }
            else
            {
                discarded++;
            }
        }

        return (uploaded, discarded);
    }

    /// <summary>
    /// Works out whether a write the server failed is one it refused for a foreign key or a unique value, and returns the
    /// conflict to report (null when it is not, or when the question cannot be answered).
    /// </summary>
    /// <remarks>
    /// <para>
    /// Asked only after the write has failed, so the run makes no extra call while nothing goes wrong. The failure itself
    /// cannot say why: over HTTP the server's foreign key error arrives as a 500 with its details withheld. So the state
    /// the failure would follow from is looked up instead.
    /// </para>
    /// <list type="bullet">
    /// <item>An upsert whose local row refers to a parent the server no longer holds is
    /// <see cref="SyncConflictReason.ParentMissingOnServer"/>.</item>
    /// <item>A delete of a row the server still holds, in a table other tables of the diagram refer to, is
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>. Which row stands in the way is not looked up.</item>
    /// <item>An upsert whose local row's unique values another row holds on the server - the server's own uniqueness
    /// check, asked with the local row - is <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>.</item>
    /// </list>
    /// <para>
    /// Anything else - and a lookup that fails in turn - is not explained, and the caller throws the original failure:
    /// a dropped connection must not turn into a conflict the run quietly moves past.
    /// </para>
    /// </remarks>
    private async Task<SyncConflict?> ExplainServerRefusalAsync(
        ISyncTable table,
        ISyncTableRunSupport support,
        SyncJournalRow entry,
        CancellationToken cancellationToken
    )
    {
        try
        {
            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                if (!support.IsReferenced)
                {
                    return null;
                }

                var server = await support
                    .ReadServerRowAsync(entry.KeyText, cancellationToken)
                    .ConfigureAwait(false);

                return server is null
                    ? null
                    : new SyncConflict(
                        table.TableName,
                        entry.KeyText,
                        SyncJournalOperation.Delete,
                        SyncConflictReason.DeleteRefusedOnServer,
                        null,
                        server
                    );
            }

            var (local, parents) = await support
                .ReadLocalParentsAsync(entry.KeyText, cancellationToken)
                .ConfigureAwait(false);

            foreach (var (parentTableName, parentKeyText) in parents)
            {
                if (
                    _tables.FirstOrDefault(candidate =>
                        string.Equals(candidate.TableName, parentTableName, StringComparison.Ordinal)
                    )
                    is not ISyncTableRunSupport parent
                )
                {
                    continue;
                }

                if (
                    await parent.ReadServerRowAsync(parentKeyText, cancellationToken).ConfigureAwait(false)
                    is null
                )
                {
                    return new SyncConflict(
                        table.TableName,
                        entry.KeyText,
                        SyncJournalOperation.Upsert,
                        SyncConflictReason.ParentMissingOnServer,
                        local,
                        null
                    );
                }
            }

            if (
                local is not null
                && await support
                    .CollidesOnServerAsync(entry.KeyText, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                return new SyncConflict(
                    table.TableName,
                    entry.KeyText,
                    SyncJournalOperation.Upsert,
                    SyncConflictReason.UniqueValueTakenOnServer,
                    local,
                    null
                );
            }

            return null;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            return null;
        }
    }

    /// <summary>Everything the journal holds about one row, folded from its entries in the order they were recorded.</summary>
    private sealed class PendingRow
    {
        /// <summary>The ids of every entry about the row, oldest first (they are settled together).</summary>
        public List<long> Ids { get; } = [];

        /// <summary>Whether any entry records an insert or an update.</summary>
        public bool HasUpsert { get; private set; }

        /// <summary>Whether any entry records a delete.</summary>
        public bool HasDelete { get; private set; }

        /// <summary>The latest of the versions the row's delete entries carried (null when none carried one).</summary>
        public byte[]? DeletedRowVersion { get; private set; }

        /// <summary>The operation of the newest entry (what a table outside the fixed classes is replayed by).</summary>
        public SyncJournalOperation LatestOperation { get; private set; }

        /// <summary>The version the newest entry carried.</summary>
        public byte[]? LatestRowVersion { get; private set; }

        /// <summary>The unbounded binary columns any entry stored a value in (what a run that carries them sends).</summary>
        public SortedSet<string> UnboundedBinaryColumns { get; } = new(StringComparer.Ordinal);

        /// <summary>Folds one more entry in.</summary>
        public void Add(SyncJournalRow entry)
        {
            Ids.Add(entry.Id);
            LatestRowVersion = entry.OriginalRowVersion;

            if (!string.IsNullOrEmpty(entry.UnboundedBinaryColumns))
            {
                UnboundedBinaryColumns.UnionWith(entry.UnboundedBinaryColumns.Split(','));
            }

            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                HasDelete = true;
                LatestOperation = SyncJournalOperation.Delete;
                DeletedRowVersion = SyncRowVersions.Max(DeletedRowVersion, entry.OriginalRowVersion);
            }
            else
            {
                HasUpsert = true;
                LatestOperation = SyncJournalOperation.Upsert;
            }
        }

        /// <summary>Builds the entry the table replays for the row (the newest id stands for all of them).</summary>
        public SyncJournalRow ToEntry(
            (string TableName, string KeyText) rowId,
            SyncJournalOperation operation,
            byte[]? originalRowVersion
        ) =>
            new()
            {
                Id = Ids[^1],
                TableName = rowId.TableName,
                KeyText = rowId.KeyText,
                Operation = operation.ToString(),
                OriginalRowVersion = originalRowVersion,
                UnboundedBinaryColumns =
                    UnboundedBinaryColumns.Count == 0 ? null : string.Join(',', UnboundedBinaryColumns),
            };
    }

    /// <summary>What the replay of one table sends, and what it drops unsent.</summary>
    private sealed class TableReplayPlan(ISyncTable table)
    {
        /// <summary>The table.</summary>
        public ISyncTable Table { get; } = table;

        /// <summary>The table's receipts, by key.</summary>
        public IReadOnlyDictionary<string, byte[]> Acknowledged { get; set; } =
            new Dictionary<string, byte[]>(StringComparer.Ordinal);

        /// <summary>The rows whose current content is sent.</summary>
        public List<(SyncJournalRow Entry, List<long> Ids)> Upserts { get; } = [];

        /// <summary>The rows deleted on the server.</summary>
        public List<(SyncJournalRow Entry, List<long> Ids)> Deletes { get; } = [];

        /// <summary>The entries of the rows there is nothing to send for.</summary>
        public List<List<long>> Discards { get; } = [];
    }

    /// <summary>Removes settled journal entries without letting the removal itself be journaled.</summary>
    private async Task RemoveAsync(IReadOnlyList<long> ids, CancellationToken cancellationToken)
    {
        using (SyncSession.Suppress())
        {
            await _journal.RemoveAsync(ids, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>Pulls the server's changes down and, unless it is turned off, removes the local rows the server dropped.</summary>
    /// <remarks>
    /// A table whose journal still holds an unsent change stops at the row that change belongs to; the tables after it
    /// go on. <see cref="SyncAsync"/> reports where that happened in
    /// <see cref="SyncResult.Truncations"/>; called on its own, this returns only what it applied.
    /// </remarks>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public Task<(int Downloaded, int DeletedLocally)> DownloadAsync(
        SyncOptions options,
        CancellationToken cancellationToken = default
    ) =>
        _journal.Gate.RunExclusiveAsync<(int Downloaded, int DeletedLocally)>(
            async () =>
            {
                await PrepareJournalAsync(cancellationToken).ConfigureAwait(false);

                var download = await DownloadCoreAsync(options, null, cancellationToken)
                    .ConfigureAwait(false);

                return (download.Downloaded, download.DeletedLocally);
            },
            cancellationToken
        );

    /// <summary>Pulls the server's changes down, knowing what is still unsent and what the server has acknowledged.</summary>
    /// <remarks>
    /// <para>
    /// Under a <see cref="SyncConflictPolicy.ServerWins"/> run, the rows whose entries the run drops take the server's
    /// content table by table, right after that table's download and parents first. By then the parents the server's
    /// rows point at - including a parent the server added or another device changed since - have come down, so putting
    /// a row back does not fail on a foreign key; and a row put back is there before the child tables that may point at
    /// it are downloaded. The entries being dropped do not hold the table's download back. A row put back brings in the
    /// parents it refers to first, or stays as it is with its entries when it cannot have them (see
    /// <see cref="SyncParentResolver"/>).
    /// </para>
    /// <para>
    /// A table that stops part way stops only itself. The tables after it go on: a row whose parent was behind the
    /// stopping point brings the parent in from the server, or stops its own table when the parent cannot be had.
    /// </para>
    /// <para>
    /// The delete propagation runs before the download and again after it, children first. Each table spares the rows
    /// that are still unsent (the entries a <see cref="SyncConflictPolicy.ServerWins"/> run drops keep nothing), the rows
    /// the tables already propagated keep pointing at, the parents of every row so spared (see
    /// <see cref="SyncKeptRows.CloseAsync"/>), and the rows a local row refers to.
    /// </para>
    /// </remarks>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="serverWins">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run drops, by row, or null.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<(
        int Downloaded,
        int DeletedLocally,
        int Discarded,
        IReadOnlyList<SyncDownloadTruncation> Truncations
    )> DownloadCoreAsync(
        SyncOptions options,
        Dictionary<(string TableName, string KeyText), List<long>>? serverWins,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(options);

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);
        var truncations = new List<SyncDownloadTruncation>();

        if (scope.Count == 0)
        {
            return (0, 0, 0, truncations);
        }

        // One ceiling for the whole pass: asking per table would let a row committed between two tables slip through
        // the gap between their bounds. Only a versioned table can answer - a key-ordered scan has no bound to apply -
        // so an all-versionless scope runs without one.
        var ceilingTable = scope.FirstOrDefault(table => !table.IsVersionless);
        var ceiling = ceilingTable is null
            ? null
            : await ceilingTable.GetChangeCeilingAsync(cancellationToken).ConfigureAwait(false);

        IReadOnlySet<long> droppedIds =
            serverWins?.Values.SelectMany(ids => ids).ToHashSet() ?? new HashSet<long>();
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        var removedByServerWins = 0;

        // Before the download as well as after it - see PropagateDeletesAcrossAsync.
        var deletedBefore = options.PropagateDeletes
            ? await PropagateDeletesAcrossAsync(
                    scope,
                    droppedIds,
                    cancellationToken,
                    serverWins?.Keys.ToHashSet()
                )
                .ConfigureAwait(false)
            : 0;
        var downloaded = 0;
        var discarded = 0;

        // A table that stops part way does not stop the tables after it. Their rows may point at parents that were
        // behind the stopping point, but each such parent is brought in from the server first, or the row stops its
        // own table when the parent cannot be had (the resolver below), so no row goes in without its parent. Waiting
        // for the earlier table instead could wait for good: the row it stopped at may be held there by a stale row of
        // a later table, which only that table's download brings up to date.
        foreach (var table in scope)
        {
            // Read per table alongside the pending keys: the receipts say which of the rows about to come down are
            // this device's own echoes, and - once they have come down - which receipts have served their purpose.
            var acknowledged = await _journal
                .ReadAcksAsync(table.TableName, cancellationToken)
                .ConfigureAwait(false);

            // A table of the fixed classes reads what is unsent before each batch (PendingReader below). One that only
            // has the public surface cannot, so it is handed what is unsent as the download starts: without it, it
            // would take every row for one it may overwrite, the row of a conflict this run has just reported included.
            var pendingAtStart = table is ISyncTableRunSupport
                ? new HashSet<string>(StringComparer.Ordinal)
                : (await ReadPendingAsync(table.TableName, droppedIds, cancellationToken).ConfigureAwait(false)).KeyTexts;
            var outcome = await table
                .DownloadAsync(
                    ceiling,
                    options.DownloadBatchSize,
                    options.IncludeUnboundedBinary,
                    new SyncDownloadContext
                    {
                        PendingKeyTexts = pendingAtStart,
                        AcknowledgedRowVersions = acknowledged,

                        // What is unsent is read afresh before each batch, under the lock the application's writes
                        // take, rather than once for the whole pass: the application may keep writing while the run
                        // is in flight, and a row it edits after the pass began must not be overwritten by a batch.
                        PendingReader = token => ReadPendingAsync(table.TableName, droppedIds, token),
                        Gate = _journal.Gate,

                        // A row whose parent the local database does not have brings the parent in first when the
                        // run may - see SyncParentResolver.
                        ParentResolverFactory = pending =>
                            new SyncParentResolver(
                                _tables,
                                scopeTableNames,
                                pending,
                                _journal,
                                options.IncludeUnboundedBinary,
                                options.PropagateDeletes,
                                _changeLog
                            ),
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
            downloaded += outcome.Applied;

            // After the download, so every batch that wrote one of these versions has committed: a receipt dropped
            // ahead of the commit that replaces it would be gone for a commit that then failed.
            if (outcome.SettledAckKeyTexts is { Count: > 0 } settledAcks)
            {
                await _journal
                    .RemoveAcksAsync(table.TableName, settledAcks, cancellationToken)
                    .ConfigureAwait(false);
            }

            await SettleServerWinsAsync(table).ConfigureAwait(false);

            if (outcome.TruncatedAtKeyText is { } stoppedAt)
            {
                truncations.Add(
                    new SyncDownloadTruncation(table.TableName, stoppedAt, null)
                    {
                        MissingParentTableName = outcome.MissingParentTableName,
                        SkippedBySaveHook = outcome.SkippedBySaveHook,
                    }
                );
            }
        }

        if (!options.PropagateDeletes)
        {
            return (downloaded, removedByServerWins, discarded, truncations);
        }

        var deleted =
            deletedBefore
            + removedByServerWins
            + await PropagateDeletesAcrossAsync(scope, droppedIds, cancellationToken)
                .ConfigureAwait(false);

        return (downloaded, deleted, discarded, truncations);

        // Settles the table's entries a ServerWins run is dropping, right after the table's download.
        async Task SettleServerWinsAsync(ISyncTable table)
        {
            if (serverWins is null)
            {
                return;
            }

            var rows = serverWins
                .Where(pair => string.Equals(pair.Key.TableName, table.TableName, StringComparison.Ordinal))
                .OrderBy(pair => pair.Value[0])
                .ToList();

            if (rows.Count == 0)
            {
                return;
            }

            var (dropped, removed) = await _journal
                .Gate.WriteExclusiveAsync(
                    () =>
                        ApplyServerWinsToTableAsync(
                            table,
                            rows,
                            options.IncludeUnboundedBinary,
                            options.PropagateDeletes,
                            droppedIds,
                            scopeTableNames,
                            cancellationToken
                        ),
                    cancellationToken
                )
                .ConfigureAwait(false);
            discarded += dropped;
            removedByServerWins += removed;
        }
    }

    /// <summary>Runs the delete propagation over the tables of a run, children first, and returns how many local rows went.</summary>
    /// <remarks>
    /// It runs twice per download. Once before it: a row the server deleted is gone before the download applies the
    /// server's rows, so a row the server recreated under another key with the same unique value does not collide with
    /// the old one locally. And once after it, as it always has: the download may have made rows unreferenced that were
    /// referenced before, and the server's key set is read again, so a row the server added while the run was in flight
    /// is not taken for one it dropped.
    /// </remarks>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="droppedIds">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run is dropping, which keep no row: a row created only here, whose entry the run discards, goes before the download rather than standing in the way of a server row with the same unique value.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <param name="discardedRows">The rows a <see cref="SyncConflictPolicy.ServerWins"/> run is discarding the changes of, when this is the pass before the download: such a row that goes is noted as <see cref="SyncLocalRowChangeReason.RemovedBeforeDownload"/>.</param>
    private async Task<int> PropagateDeletesAcrossAsync(
        IReadOnlyList<ISyncTable> scope,
        IReadOnlySet<long> droppedIds,
        CancellationToken cancellationToken,
        IReadOnlySet<(string TableName, string KeyText)>? discardedRows = null
    )
    {
        var deleted = 0;
        var keptByTable = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);

        for (var index = scope.Count - 1; index >= 0; index--)
        {
            var table = scope[index];
            IReadOnlyList<string> removedKeyTexts;

            // The unsent keys are read under the write lock, after the local keys, by the same reasoning the download
            // reads them per batch (see ISyncTableRunSupport.PropagateDeletesAsync). A table outside the fixed classes
            // is handed the keys as they stand now.
            if (table is ISyncTableRunSupport support)
            {
                var propagation = await support
                    .PropagateDeletesAsync(
                        _journal.Gate,
                        token => ReadPendingKeyTextsAsync(table.TableName, droppedIds, token),
                        keptByTable.TryGetValue(table.TableName, out var keptHere)
                            ? keptHere
                            : new HashSet<string>(StringComparer.Ordinal),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
                removedKeyTexts = propagation.Removed;

                foreach (var (parentTableName, parentKeyText) in propagation.KeptParents)
                {
                    if (!keptByTable.TryGetValue(parentTableName, out var keys))
                    {
                        keys = new HashSet<string>(StringComparer.Ordinal);
                        keptByTable.Add(parentTableName, keys);
                    }

                    keys.Add(parentKeyText);
                }
            }
            else
            {
                removedKeyTexts = await table
                    .PropagateDeletesAsync(
                        await ReadPendingKeyTextsAsync(table.TableName, droppedIds, cancellationToken)
                            .ConfigureAwait(false),
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            deleted += removedKeyTexts.Count;

            if (discardedRows is not null && _changeLog is { } changes)
            {
                foreach (var keyText in removedKeyTexts)
                {
                    if (discardedRows.Contains((table.TableName, keyText)))
                    {
                        changes.Add(
                            table.TableName,
                            keyText,
                            SyncLocalRowChangeReason.RemovedBeforeDownload
                        );
                    }
                }
            }

            // A key the server has dropped takes its receipt with it. Left behind, it would be the original of the
            // next replay of that key - a version-guarded update against a row that is gone, reported as a conflict
            // with a row nobody can produce - which is exactly what a local row recreated under the same key runs into.
            if (removedKeyTexts.Count > 0)
            {
                await _journal
                    .RemoveAcksAsync(table.TableName, removedKeyTexts, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        return deleted;
    }

    /// <summary>Resolves which tables one run covers: the mode keeps the versionless ones out of a versioned run, and the exclusions take named types away.</summary>
    /// <remarks>
    /// A type the engine does not synchronise is rejected rather than skipped: the caller either mistyped, or named a
    /// table that was already excluded where the engine was put together - and a silently ignored exclusion would read
    /// as if it had worked. The order of the remaining tables is the foreign-key order the engine was built with.
    /// </remarks>
    private IReadOnlyList<ISyncTable> ResolveScope(
        SyncMode mode,
        IReadOnlyCollection<Type> excludedEntityTypes
    )
    {
        ArgumentNullException.ThrowIfNull(excludedEntityTypes);

        foreach (var type in excludedEntityTypes)
        {
            if (_tables.All(table => table.EntityType != type))
            {
                throw new ArgumentException(
                    $"The type '{type}' is not an entity type this engine synchronises - a typo, or a table that was "
                        + "already excluded where the engine was put together.",
                    nameof(excludedEntityTypes)
                );
            }
        }

        return _tables
            .Where(table =>
                (mode == SyncMode.LastWriteWins || !table.IsVersionless)
                && !excludedEntityTypes.Contains(table.EntityType)
            )
            .ToList();
    }

    /// <summary>Reads what is still unsent when one table's download batch is about to be applied.</summary>
    /// <param name="tableName">The downloading table.</param>
    /// <param name="ignoredIds">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run is about to drop, which hold nothing back.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<SyncPendingSnapshot> ReadPendingAsync(
        string tableName,
        IReadOnlySet<long> ignoredIds,
        CancellationToken cancellationToken
    )
    {
        var entries = await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false);
        var keyTexts = new HashSet<string>(StringComparer.Ordinal);
        var deleted = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        var unsent = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
        var binaryColumns = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);

        foreach (var entry in entries)
        {
            if (ignoredIds.Contains(entry.Id))
            {
                continue;
            }

            if (!unsent.TryGetValue(entry.TableName, out var tableKeys))
            {
                tableKeys = new HashSet<string>(StringComparer.Ordinal);
                unsent.Add(entry.TableName, tableKeys);
            }

            tableKeys.Add(entry.KeyText);

            if (string.Equals(entry.TableName, tableName, StringComparison.Ordinal))
            {
                keyTexts.Add(entry.KeyText);

                if (!string.IsNullOrEmpty(entry.UnboundedBinaryColumns))
                {
                    if (!binaryColumns.TryGetValue(entry.KeyText, out var columns))
                    {
                        columns = new HashSet<string>(StringComparer.Ordinal);
                        binaryColumns.Add(entry.KeyText, columns);
                    }

                    columns.UnionWith(entry.UnboundedBinaryColumns.Split(','));
                }
            }

            if (
                string.Equals(
                    entry.Operation,
                    nameof(SyncJournalOperation.Delete),
                    StringComparison.Ordinal
                )
            )
            {
                if (!deleted.TryGetValue(entry.TableName, out var keys))
                {
                    keys = new HashSet<string>(StringComparer.Ordinal);
                    deleted.Add(entry.TableName, keys);
                }

                keys.Add(entry.KeyText);
            }
        }

        return new SyncPendingSnapshot(
            keyTexts,
            deleted.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlySet<string>)pair.Value,
                StringComparer.Ordinal
            ),
            binaryColumns.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlySet<string>)pair.Value,
                StringComparer.Ordinal
            )
        )
        {
            KeyTextsByTable = unsent.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlySet<string>)pair.Value,
                StringComparer.Ordinal
            ),
        };
    }

    /// <summary>Reads the keys of one table's still-unsent journal entries: the rows a download and a delete propagation both leave alone.</summary>
    /// <param name="tableName">The table whose keys are read.</param>
    /// <param name="ignoredIds">The entries a <see cref="SyncConflictPolicy.ServerWins"/> run is about to drop, which keep nothing.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<IReadOnlySet<string>> ReadPendingKeyTextsAsync(
        string tableName,
        IReadOnlySet<long> ignoredIds,
        CancellationToken cancellationToken
    )
    {
        var entries = await _journal.ReadAllAsync(cancellationToken).ConfigureAwait(false);

        return entries
            .Where(entry =>
                string.Equals(entry.TableName, tableName, StringComparison.Ordinal)
                && !ignoredIds.Contains(entry.Id)
            )
            .Select(entry => entry.KeyText)
            .ToHashSet(StringComparer.Ordinal);
    }
}

/// <summary>
/// Records the journal entries a graph save is about to need, before the save itself runs ("journal-first").
/// </summary>
/// <remarks>
/// <para>
/// The traversal mirrors the decision procedure of the graph saver: a removed node has its cascade subtree recorded as
/// deletes (children first, each regardless of its own state) followed by the node itself, an added or updated node is
/// recorded as an upsert, and an unchanged node contributes nothing of its own - but its children are still visited
/// while the save cascades, because a changed child under an unchanged root is written all the same.
/// </para>
/// <para>
/// It is one traversal rather than one per entity type: the children come from
/// <see cref="EntityBaseCore.EnumerateCascadeChildren"/>, which yields the same cascade navigations the saver's own walk
/// enumerates (the saver reads them from its EntitySaveMetadata.CascadeNavigations rather than calling this method), and
/// a node is recorded only when its CLR type has a descriptor. A table on the path that is not synchronised is therefore
/// walked through without an entry of its own, and a subtree holding no synchronised table records nothing.
/// </para>
/// <para>
/// Recording the whole graph first keeps the journal-first safety order for every row the save is going to touch: an
/// entry whose write then fails or is rolled back describes a row the upload re-reads and settles without a round trip.
/// </para>
/// </remarks>
public sealed class SyncGraphRecorder
{
    private readonly Dictionary<Type, ISyncTableDescriptor> _descriptors;
    private readonly Dictionary<string, ISyncTableDescriptor> _descriptorsByTable;

    /// <summary>Creates the recorder over the descriptors of every synchronised table.</summary>
    /// <remarks>
    /// Every table the diagram synchronises belongs here, including one a particular engine was built without: the
    /// journal is shared, and a graph save reaching such a table records it exactly as it did before the exclusion.
    /// </remarks>
    /// <param name="descriptors">The descriptors, one per synchronised table.</param>
    public SyncGraphRecorder(IEnumerable<ISyncTableDescriptor> descriptors)
    {
        ArgumentNullException.ThrowIfNull(descriptors);
        _descriptors = descriptors.ToDictionary(descriptor => descriptor.EntityType);
        _descriptorsByTable = _descriptors.Values.ToDictionary(
            descriptor => descriptor.TableName,
            StringComparer.Ordinal
        );
    }

    /// <summary>Records the entries for a graph save rooted at the given entity (the cascade children included).</summary>
    /// <param name="journal">The journal the entries are recorded to.</param>
    /// <param name="entity">The root of the graph the save was asked for.</param>
    /// <param name="cascadeSave">Whether the save cascades into the children.</param>
    /// <param name="cascadeDelete">Whether removing the root removes its subtree.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// The whole graph is recorded in one call to <see cref="SyncJournal.RecordManyAsync"/>, in the order below. A delete
    /// carries the later of the version on the entity and the version the local row has (see
    /// <see cref="RecordCollectedAsync"/>).
    /// </remarks>
    public Task RecordSaveAsync(
        SyncJournal journal,
        EntityBaseCore entity,
        bool cascadeSave,
        bool cascadeDelete,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(journal);
        ArgumentNullException.ThrowIfNull(entity);

        var records = new List<SyncJournalRecord>();
        CollectSave(entity, cascadeSave, cascadeDelete, records);

        return RecordCollectedAsync(journal, records, cancellationToken);
    }

    /// <summary>Records the collected entries, giving each delete of a versioned table the version its local row has.</summary>
    /// <remarks>
    /// A delete is replayed under the version it carries, and one that carries none for a row the server has is dropped
    /// unsent. The entity a graph save deletes cannot be relied on for it: a stub made from the key alone carries no
    /// version, and an object held since before the row's last download carries an older one. The local row is read for
    /// it before it goes - one SELECT per such delete - and the later of the two is recorded. A row that is not there, or
    /// a table without a version column, keeps what the entity carries.
    /// </remarks>
    /// <param name="journal">The journal the entries are recorded to.</param>
    /// <param name="records">The entries, in the order they are to be recorded.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    internal async Task RecordCollectedAsync(
        SyncJournal journal,
        List<SyncJournalRecord> records,
        CancellationToken cancellationToken
    )
    {
        if (!SyncSession.IsSuppressed)
        {
            for (var index = 0; index < records.Count; index++)
            {
                var record = records[index];

                if (
                    record.Operation == SyncJournalOperation.Delete
                    && _descriptorsByTable.GetValueOrDefault(record.TableName)
                        is ISyncLocalRowVersionReader reader
                    && await reader
                        .ReadLocalRowVersionAsync(
                            journal.LocalSqlExecutor,
                            record.KeyText,
                            cancellationToken
                        )
                        .ConfigureAwait(false)
                        is { } local
                )
                {
                    records[index] = record with
                    {
                        OriginalRowVersion = SyncRowVersions.Max(record.OriginalRowVersion, local),
                    };
                }
            }
        }

        await journal.RecordManyAsync(records, cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Collects the entries for a graph save rooted at the given entity, in the order they are to be recorded.</summary>
    /// <param name="entity">The root of the graph the save was asked for.</param>
    /// <param name="cascadeSave">Whether the save cascades into the children.</param>
    /// <param name="cascadeDelete">Whether removing the root removes its subtree.</param>
    /// <param name="records">The list the entries are appended to.</param>
    internal void CollectSave(
        EntityBaseCore entity,
        bool cascadeSave,
        bool cascadeDelete,
        List<SyncJournalRecord> records
    )
    {
        if (entity.RowState == RowState.Removed)
        {
            if (cascadeDelete)
            {
                CollectDeleteGraph(entity, records);
            }
            else
            {
                CollectDelete(entity, records);
            }

            return;
        }

        if (entity.RowState != RowState.Unchanged && Find(entity) is { } descriptor)
        {
            records.Add(
                new SyncJournalRecord(
                    descriptor.TableName,
                    descriptor.FormatEntityKey(entity),
                    SyncJournalOperation.Upsert,
                    null
                )
                {
                    // An added row is written with every column, the excluded ones included; an updated one is not.
                    UnboundedBinaryColumns =
                        entity.RowState == RowState.Added ? descriptor.UnboundedBinaryColumnNames : null,
                    Entity = entity,
                    Descriptor = descriptor,
                    SavedByGraph = true,
                }
            );
        }

        if (!cascadeSave)
        {
            return;
        }

        foreach (var child in entity.EnumerateCascadeChildren())
        {
            CollectSave(child, cascadeSave, cascadeDelete, records);
        }
    }

    /// <summary>Collects the whole subtree as deletes, children first (the saver removes them regardless of their own state).</summary>
    private void CollectDeleteGraph(EntityBaseCore entity, List<SyncJournalRecord> records)
    {
        foreach (var child in entity.EnumerateCascadeChildren())
        {
            CollectDeleteGraph(child, records);
        }

        CollectDelete(entity, records);
    }

    /// <summary>Collects the delete of one node, carrying the mirrored version the row holds (nothing for an unsynchronised table).</summary>
    private void CollectDelete(EntityBaseCore entity, List<SyncJournalRecord> records)
    {
        if (Find(entity) is { } descriptor)
        {
            records.Add(
                new SyncJournalRecord(
                    descriptor.TableName,
                    descriptor.FormatEntityKey(entity),
                    SyncJournalOperation.Delete,
                    descriptor.ReadEntityRowVersion(entity)
                )
            );
        }
    }

    /// <summary>Finds the descriptor of the node's table, or null when the table is not synchronised.</summary>
    private ISyncTableDescriptor? Find(EntityBaseCore entity) =>
        _descriptors.GetValueOrDefault(entity.GetType());

    /// <summary>Finds the descriptor of the given entity type's table, or null when the table is not synchronised.</summary>
    internal ISyncTableDescriptor? Find(Type entityType) =>
        _descriptors.GetValueOrDefault(entityType);
}

/// <summary>
/// Generic core of the journaling repository decorator: every write entry point on the repository contract records
/// its intent to the journal before the write is performed, and everything else is forwarded untouched.
/// </summary>
/// <remarks>
/// <para>
/// It wraps the repository rather than hooking into the save pipeline because a save hook only fires for a graph save -
/// a direct Insert, Update, Delete, or BulkInsert passes it by. Offline editing has to be caught at every write, so
/// every write entry point on the contract records here. What stays with the generated derived class is only what the
/// generic core cannot reach: the members the concrete interface adds - named queries and the binary column accessors -
/// which the derived class forwards itself.
/// </para>
/// <para>
/// Raw SQL (<c>ExecuteSqlAsync</c>) is forwarded untouched and is <b>not</b> recorded: the statement's shape is opaque
/// to the decorator, so there is no key to journal. The same holds for the bulk delete behind
/// <c>Query().ExecuteDeleteAsync</c>, whose rows are chosen by a predicate the decorator never sees. Rows changed
/// either way reach the server only if something else records them.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class JournalingRepositoryBase<TEntity, TKey> : IRepositoryCore<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder.</summary>
    protected JournalingRepositoryBase(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(graphRecorder);
        Inner = inner;
        Journal = journal;
        Descriptor = descriptor;
        GraphRecorder = graphRecorder;
    }

    /// <summary>Gets the wrapped repository every call is forwarded to.</summary>
    protected IRepositoryCore<TEntity, TKey> Inner { get; }

    /// <summary>Gets the journal the write intents are recorded to.</summary>
    protected SyncJournal Journal { get; }

    /// <summary>Gets the table's descriptor (its journal name, and how its key and mirrored version are read).</summary>
    protected SyncTableDescriptor<TEntity, TKey> Descriptor { get; }

    /// <summary>Gets the recorder that journals the whole cascade a graph save is about to write.</summary>
    protected SyncGraphRecorder GraphRecorder { get; }

    /// <summary>Gets the server-side table name the journal entries are recorded under.</summary>
    protected string TableName => Descriptor.TableName;

    /// <summary>Reads the primary key of the given entity.</summary>
    protected TKey ReadKey(TEntity entity) => Descriptor.ReadKey(entity);

    /// <summary>Formats a key into the journal's key text (the same serialization the sync engine reads back).</summary>
    protected string FormatKey(TKey key) => Descriptor.FormatKey(key);

    /// <summary>Records a delete intent for the given key (the versioned and versionless subclasses differ here).</summary>
    protected abstract Task RecordDeleteAsync(TKey id, CancellationToken cancellationToken);

    /// <summary>Records the whole cascade a graph save is about to write, before the save itself runs.</summary>
    /// <remarks>
    /// The decorator sees only the root, while the saver walks the cascade navigations and writes the descendants too.
    /// The recorder walks the same navigations, so the children a save writes or deletes are journaled exactly like the
    /// root - and a table on the path that is not synchronised is walked through without an entry of its own.
    /// </remarks>
    protected Task RecordGraphSaveAsync(
        TEntity entity,
        bool cascadeSave,
        bool cascadeDelete,
        CancellationToken cancellationToken
    ) =>
        GraphRecorder.RecordSaveAsync(
            Journal,
            entity,
            cascadeSave,
            cascadeDelete,
            cancellationToken
        );

    /// <summary>Records the intent to write the given row, unless the sync engine is the one writing.</summary>
    protected Task RecordUpsertAsync(TEntity entity, CancellationToken cancellationToken) =>
        Journal.RecordAsync(
            TableName,
            FormatKey(ReadKey(entity)),
            SyncJournalOperation.Upsert,
            null,
            cancellationToken
        );

    /// <summary>Records the intent to insert the given row, which stores every unbounded binary column as well.</summary>
    private Task RecordInsertAsync(TEntity entity, CancellationToken cancellationToken) =>
        Journal.RecordManyAsync([InsertRecord(entity)], cancellationToken);

    /// <summary>The entry an insert of the given row records.</summary>
    private SyncJournalRecord InsertRecord(TEntity entity) =>
        new(TableName, FormatKey(ReadKey(entity)), SyncJournalOperation.Upsert, null)
        {
            UnboundedBinaryColumns = Descriptor.UnboundedBinaryColumnNames,
            Entity = entity,
            Descriptor = Descriptor,
        };

    /// <summary>Records an intent and performs the write it describes, as one step under the local write lock.</summary>
    /// <remarks>
    /// <para>
    /// The two belong together because a sync run reads what is still unsent and then acts on it: a write slipping in
    /// between - recorded, but not yet there, or there but not yet recorded - is a write that run either overwrites or
    /// deletes. Holding the lock across both means the run sees the write whole or not at all, and a write that has to
    /// wait waits for at most one batch of the run.
    /// </para>
    /// <para>
    /// The engine's own writes run suppressed and are made while it already holds the lock, so they neither record nor
    /// wait; a write made while this flow already holds the lock - from a save hook, say - goes straight through as well.
    /// </para>
    /// <para>
    /// When the business write throws, the entries this call recorded are taken back before the exception goes on, still
    /// under the lock: the write did not land, and an entry left behind would upload content the local database never
    /// committed - over another writer's newer row or blob. Only the entries of this call go; earlier entries for the
    /// same row stay. The repositories behind this commit as their last step, so an exception means the write did not
    /// land; a repository of your own put behind the decorator has to keep to that, since an exception it throws after
    /// committing takes back the entry of a write that did land. A process that ends between recording and writing
    /// still leaves its entries behind, which the upload re-reads and drops when the row is not there. Should taking the
    /// entries back fail as well, the write's exception still goes on, with the failure in its
    /// <see cref="Exception.Data"/> under <see cref="JournalCleanupFailureKey"/>.
    /// </para>
    /// <para>
    /// When the write succeeds, the entries are checked against what it did (see <see cref="SettleRecordedAsync"/>): an
    /// entry for a row a save hook skipped is taken back, and one whose row a save hook gave its key is moved to that key.
    /// </para>
    /// <para>
    /// An unbounded binary column a save hook writes through its context during the write is recorded as well, inside
    /// the save's transaction (see <see cref="RecordHookBinaryWriteAsync"/>), so the entry goes with the save whichever
    /// way it ends.
    /// </para>
    /// </remarks>
    /// <param name="record">Records the intent (called first).</param>
    /// <param name="write">Performs the business write (called second).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    protected Task<TResult> RecordAndWriteAsync<TResult>(
        Func<Task> record,
        Func<Task<TResult>> write,
        CancellationToken cancellationToken
    )
    {
        ArgumentNullException.ThrowIfNull(record);
        ArgumentNullException.ThrowIfNull(write);

        if (SyncSession.IsSuppressed)
        {
            return write();
        }

        return Journal.Gate.WriteExclusiveAsync(
            async () =>
            {
                var recorded = new SyncRecordingScope();
                TResult result;

                try
                {
                    // A save hook's write is recorded by the save's own connection, which cannot create the table
                    await Journal.EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);

                    using (recorded.Begin())
                    {
                        await record().ConfigureAwait(false);
                    }

                    using (SaveHookContextWrites.Observe(RecordHookBinaryWriteAsync))
                    {
                        result = await write().ConfigureAwait(false);
                    }
                }
                catch (Exception failure) when (recorded.Ids.Count > 0)
                {
                    await TakeBackAsync(recorded.Ids, failure).ConfigureAwait(false);

                    throw;
                }

                await SettleRecordedAsync(recorded).ConfigureAwait(false);

                return result;
            },
            cancellationToken
        );
    }

    /// <summary>Records an unbounded binary column a save hook wrote during a write, inside the save's transaction.</summary>
    /// <remarks>
    /// <para>
    /// The entries a graph save records are made before it runs, from what the graph holds, and an After hook can write
    /// a column of a row the save wrote, or of another row, through its context. Left out of the journal, that blob would
    /// never be uploaded, and the next download would put the server's value back over it. The entry is written by the
    /// save's own connection, so it commits or rolls back with the save; a write that matched no row is not reported.
    /// </para>
    /// <para>
    /// A table that is not synchronised, and a column the table does not leave out of the row transfer, record nothing.
    /// A key that cannot be read as the table's key type fails the save rather than leaving the blob unrecorded.
    /// </para>
    /// </remarks>
    /// <param name="write">The column the hook wrote.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private Task RecordHookBinaryWriteAsync(
        SaveHookBinaryColumnWrite write,
        CancellationToken cancellationToken
    )
    {
        if (
            GraphRecorder.Find(write.EntityType) is not { } descriptor
            || !descriptor.UnboundedBinaryColumnNames.Contains(write.PropertyName, StringComparer.Ordinal)
        )
        {
            return Task.CompletedTask;
        }

        if (descriptor is not ISyncHookKeyFormatter formatter)
        {
            throw new InvalidOperationException(
                $"The sync descriptor of {descriptor.TableName} cannot read the key a save hook passed, so the "
                    + "unbounded binary column the hook wrote cannot be recorded for the sync journal."
            );
        }

        return Journal.RecordWithinSaveAsync(
            write.Context,
            descriptor.TableName,
            formatter.FormatHookKey(write.Key),
            write.PropertyName,
            cancellationToken
        );
    }

    /// <summary>
    /// Brings the entries a write recorded into line with what the write did, once it has succeeded: an entry for a row
    /// a save hook skipped goes, and an entry whose row took another key as it was saved is moved to that key.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The entries are recorded before the write, from the entities as they stood then, and a graph save's hooks can
    /// change the outcome afterwards. A Before hook that returns false skips the row: nothing is written, yet its entry
    /// would upload the row's current content - over another writer's newer row, or as a write that moves the server's
    /// version on and raises a conflict elsewhere. A skipped row is the one the save leaves in its old state rather
    /// than marking it unchanged, which is how it is told apart. A hook can also give a new row its key; the entry,
    /// made under the key the row had before, would then name a row that does not exist and the upload would drop it.
    /// </para>
    /// <para>
    /// A delete a hook skipped needs nothing here: its row is still there, which already makes the upload drop the
    /// entry. A write made directly rather than through a graph save runs no hooks and leaves the entity's state alone,
    /// so only a key settled as it ran is looked at.
    /// </para>
    /// <para>
    /// Done under the same lock right after the write, and as a best effort: the write has landed by then, and failing
    /// the call over its bookkeeping would tell the caller it did not. A process that ends in between, or a failure
    /// here, leaves the entries as they were recorded.
    /// </para>
    /// </remarks>
    /// <param name="recorded">What the write recorded.</param>
    private async Task SettleRecordedAsync(SyncRecordingScope recorded)
    {
        var skipped = new List<long>();
        var rekeyed = new List<(long Id, string KeyText)>();

        foreach (var (id, record) in recorded.Recorded)
        {
            if (
                record.Operation != SyncJournalOperation.Upsert
                || record.Entity is not { } entity
                || record.Descriptor is not { } descriptor
            )
            {
                continue;
            }

            if (record.SavedByGraph && entity.RowState != RowState.Unchanged)
            {
                skipped.Add(id);

                continue;
            }

            var keyText = descriptor.FormatEntityKey(entity);

            if (!string.Equals(keyText, record.KeyText, StringComparison.Ordinal))
            {
                rekeyed.Add((id, keyText));
            }
        }

        if (skipped.Count == 0 && rekeyed.Count == 0)
        {
            return;
        }

        try
        {
            await Journal.RemoveAsync(skipped, CancellationToken.None).ConfigureAwait(false);
            await Journal
                .RewriteKeyTextsAsync(rekeyed, CancellationToken.None)
                .ConfigureAwait(false);
        }
        catch (Exception)
        {
            // Best effort (see the remarks): the entries stay as recorded.
        }
    }

    /// <summary>The key of <see cref="Exception.Data"/> that carries a failure to take back the entries of a write that failed.</summary>
    public const string JournalCleanupFailureKey = "QuickER.Sync.JournalCleanupFailure";

    /// <summary>Removes the entries a failed write recorded, leaving a failure to do so on the write's exception.</summary>
    private async Task TakeBackAsync(IReadOnlyList<long> ids, Exception failure)
    {
        try
        {
            // Not the caller's token: the write has already failed, and a cancellation that stopped it must not leave
            // its entries behind as well.
            await Journal.RemoveAsync(ids, CancellationToken.None).ConfigureAwait(false);
        }
        catch (Exception cleanupFailure)
        {
            failure.Data[JournalCleanupFailureKey] = cleanupFailure;
        }
    }

    /// <summary>Records a write of one unbounded binary column and performs it, as one step under the local write lock.</summary>
    /// <remarks>What a generated accessor that writes one column of a row on its own goes through.</remarks>
    /// <param name="id">The key of the row being written.</param>
    /// <param name="columnName">The column the write stores a value in.</param>
    /// <param name="write">Performs the business write.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    protected Task<TResult> RecordUnboundedBinaryWriteAsync<TResult>(
        TKey id,
        string columnName,
        Func<Task<TResult>> write,
        CancellationToken cancellationToken
    ) =>
        RecordAndWriteAsync(
            () =>
                Journal.RecordManyAsync(
                    [
                        new SyncJournalRecord(
                            TableName,
                            FormatKey(id),
                            SyncJournalOperation.Upsert,
                            null
                        )
                        {
                            UnboundedBinaryColumns = [columnName],
                        },
                    ],
                    cancellationToken
                ),
            write,
            cancellationToken
        );

    /// <inheritdoc />
    public Task<TEntity?> GetByIdAsync(TKey id, CancellationToken cancellationToken = default) =>
        Inner.GetByIdAsync(id, cancellationToken);

    /// <inheritdoc />
    public Task<IReadOnlyList<TEntity>> GetAllAsync(CancellationToken cancellationToken = default) =>
        Inner.GetAllAsync(cancellationToken);

    /// <inheritdoc />
    /// <remarks>A read-only check: it writes nothing, so there is nothing to journal.</remarks>
    public Task<IReadOnlyList<UniquenessViolation>> CheckUniquenessAsync(
        TEntity entity,
        CancellationToken cancellationToken = default
    ) => Inner.CheckUniquenessAsync(entity, cancellationToken);

    /// <inheritdoc />
    public async Task InsertAsync(TEntity entity, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entity);
        await RecordAndWriteAsync(
                () => RecordInsertAsync(entity, cancellationToken),
                async () =>
                {
                    await Inner.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

                    return true;
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <inheritdoc />
    public Task<bool> UpdateAsync(
        TEntity entity,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entity);

        return RecordAndWriteAsync(
            () => RecordUpsertAsync(entity, cancellationToken),
            () => Inner.UpdateAsync(entity, mode, cancellationToken),
            cancellationToken
        );
    }

    /// <inheritdoc />
    public Task<bool> DeleteAsync(TKey id, CancellationToken cancellationToken = default) =>
        RecordAndWriteAsync(
            () => RecordDeleteAsync(id, cancellationToken),
            () => Inner.DeleteAsync(id, cancellationToken),
            cancellationToken
        );

    /// <inheritdoc />
    /// <remarks>Every row is recorded in one call to <see cref="SyncJournal.RecordManyAsync"/>, not one statement per row.</remarks>
    public Task<int> BulkInsertAsync(
        IEnumerable<TEntity> entities,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entities);
        var materialized = entities.ToList();

        return RecordAndWriteAsync(
            () =>
                Journal.RecordManyAsync(
                    materialized.Where(entity => entity is not null).Select(InsertRecord).ToList(),
                    cancellationToken
                ),
            () => Inner.BulkInsertAsync(materialized, cancellationToken),
            cancellationToken
        );
    }

    /// <inheritdoc />
    /// <remarks>
    /// The decorator sees only the root, while the saver walks the cascade navigations and writes the descendants too.
    /// The recorder walks the same navigations, so the children a save writes or deletes are journaled exactly like the
    /// root - and a table on the path that is not synchronised is walked through without an entry of its own.
    /// </remarks>
    public Task<int> SaveAsync(
        TEntity entity,
        bool cascadeSave = true,
        bool cascadeDelete = true,
        bool insertWhenUpdateMissing = false,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entity);

        return RecordAndWriteAsync(
            () =>
                GraphRecorder.RecordSaveAsync(
                    Journal,
                    entity,
                    cascadeSave,
                    cascadeDelete,
                    cancellationToken
                ),
            () =>
                Inner.SaveAsync(
                    entity,
                    cascadeSave,
                    cascadeDelete,
                    insertWhenUpdateMissing,
                    mode,
                    cancellationToken
                ),
            cancellationToken
        );
    }

    /// <inheritdoc />
    /// <remarks>The graphs of every root are recorded together, in one call to <see cref="SyncJournal.RecordManyAsync"/>.</remarks>
    public Task<int> SaveAsync(
        IEnumerable<TEntity> entities,
        bool cascadeSave = true,
        bool cascadeDelete = true,
        bool insertWhenUpdateMissing = false,
        ConcurrencyMode mode = ConcurrencyMode.Optimistic,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(entities);
        var materialized = entities.ToList();

        return RecordAndWriteAsync(
            () =>
            {
                var records = new List<SyncJournalRecord>();

                foreach (var entity in materialized)
                {
                    if (entity is not null)
                    {
                        GraphRecorder.CollectSave(entity, cascadeSave, cascadeDelete, records);
                    }
                }

                return GraphRecorder.RecordCollectedAsync(Journal, records, cancellationToken);
            },
            () =>
                Inner.SaveAsync(
                    materialized,
                    cascadeSave,
                    cascadeDelete,
                    insertWhenUpdateMissing,
                    mode,
                    cancellationToken
                ),
            cancellationToken
        );
    }

    /// <inheritdoc />
    public SqlQuery<TEntity> Query() => Inner.Query();

    /// <inheritdoc />
    public Task<IReadOnlyList<TEntity>> QueryBySqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => Inner.QueryBySqlAsync(sql, parameters, cancellationToken);

    /// <inheritdoc />
    public Task<int> ExecuteSqlAsync(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => Inner.ExecuteSqlAsync(sql, parameters, cancellationToken);

    /// <inheritdoc />
    public Task<TResult?> ExecuteScalarSqlAsync<TResult>(
        string sql,
        object? parameters = null,
        CancellationToken cancellationToken = default
    ) => Inner.ExecuteScalarSqlAsync<TResult>(sql, parameters, cancellationToken);
}

/// <summary>Journaling decorator core for a table with a row-version column (a delete intent carries the mirrored version).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class JournalingRepository<TEntity, TKey> : JournalingRepositoryBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder.</summary>
    protected JournalingRepository(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder
    )
        : base(inner, journal, descriptor, graphRecorder) { }

    /// <summary>Reads the mirrored row version of the given entity.</summary>
    private byte[]? ReadRowVersion(TEntity entity) => Descriptor.ReadRowVersion(entity);

    /// <inheritdoc />
    protected sealed override async Task RecordDeleteAsync(
        TKey id,
        CancellationToken cancellationToken
    )
    {
        // The row has to be read before it goes: its mirrored version is the only thing that lets the delete be
        // replayed under a version guard, and once the row is gone there is nowhere left to read it from.
        if (!SyncSession.IsSuppressed)
        {
            var existing = await Inner.GetByIdAsync(id, cancellationToken).ConfigureAwait(false);
            await Journal.RecordAsync(
                TableName,
                FormatKey(id),
                SyncJournalOperation.Delete,
                existing is null ? null : ReadRowVersion(existing),
                cancellationToken
            )
                .ConfigureAwait(false);
        }
    }
}

/// <summary>Journaling decorator core for a table without a row-version column (a delete intent carries no version and replays unguarded).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class VersionlessJournalingRepository<TEntity, TKey>
    : JournalingRepositoryBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the decorator over the repository it wraps, the journal, the table's descriptor, and the graph recorder.</summary>
    protected VersionlessJournalingRepository(
        IRepositoryCore<TEntity, TKey> inner,
        SyncJournal journal,
        SyncTableDescriptor<TEntity, TKey> descriptor,
        SyncGraphRecorder graphRecorder
    )
        : base(inner, journal, descriptor, graphRecorder) { }

    /// <inheritdoc />
    protected sealed override Task RecordDeleteAsync(TKey id, CancellationToken cancellationToken) =>
        // No version column means there is no mirrored version to capture before the row goes; the delete replays
        // without a guard, which is all a last-write-wins table can promise anyway.
        Journal.RecordAsync(
            TableName,
            FormatKey(id),
            SyncJournalOperation.Delete,
            null,
            cancellationToken
        );
}

/// <summary>
/// Generic core of the direct (same-process database connection) server source: the key set and the change stream
/// come through the server's raw SQL surface, and the local changes are replayed through the server's ordinary
/// repository. What stays with the generated derived class is only the SQL text, which carries the table's identity.
/// </summary>
/// <remarks>
/// The paging members are virtual here rather than left to the interface's default implementations on purpose:
/// interface mapping is fixed at the class that lists the interface - this one - so a member a derived class adds later
/// would never be reached through the interface. A virtual with the same default keeps the dispatch open for the
/// versionless subclass, which does override them.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class DirectSyncSourceBase<TEntity, TKey> : ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    protected DirectSyncSourceBase(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
    {
        ArgumentNullException.ThrowIfNull(serverSqlExecutor);
        ArgumentNullException.ThrowIfNull(writer);
        ArgumentNullException.ThrowIfNull(descriptor);
        ServerSqlExecutor = serverSqlExecutor;
        Writer = writer;
        Descriptor = descriptor;
        BinaryColumns =
            descriptor.UnboundedBinaryColumnNames.Count == 0
                ? null
                : new SyncRepositoryBinaryColumns<TEntity, TKey>(descriptor, writer);
    }

    /// <summary>Gets the server's raw SQL surface the scans read through.</summary>
    protected ISqlExecutor ServerSqlExecutor { get; }

    /// <summary>Gets the table's descriptor (the SQL text that carries the table's identity).</summary>
    protected SyncTableDescriptor<TEntity, TKey> Descriptor { get; }

    /// <inheritdoc />
    public IRemoteRepositoryCore<TEntity, TKey> Writer { get; }

    /// <inheritdoc />
    /// <remarks>
    /// Null exactly when the descriptor names no unbounded binary column. The accessors are invoked on
    /// <see cref="Writer"/>, which is the generated server repository the direct registration hands in.
    /// </remarks>
    public ISyncBinaryColumns<TKey>? BinaryColumns { get; }

    /// <summary>SELECT that returns every primary key of the table (SQL Server quoting).</summary>
    protected string ServerKeysSql => Descriptor.ServerKeysSql;

    /// <inheritdoc />
    public abstract Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public abstract Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public virtual Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <inheritdoc />
    public virtual Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <inheritdoc />
    public async Task<IReadOnlyList<TKey>> GetAllKeysAsync(
        CancellationToken cancellationToken = default
    ) =>
        await ServerSqlExecutor.QueryProjectionBySqlAsync<TKey>(
            ServerKeysSql,
            null,
            cancellationToken
        )
            .ConfigureAwait(false);
}

/// <summary>Direct server source for a table with a row-version column (an ascending, anchored change scan).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class DirectSyncSource<TEntity, TKey> : DirectSyncSourceBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    public DirectSyncSource(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(serverSqlExecutor, writer, descriptor) { }

    /// <summary>SELECT that returns one ascending batch of rows above the anchor and below the ceiling (SQL Server quoting).</summary>
    private string ServerChangesSql => Descriptor.ServerChangesSql;

    /// <inheritdoc />
    public override async Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) =>
        await ServerSqlExecutor.ExecuteScalarSqlAsync<byte[]>(
            "SELECT MIN_ACTIVE_ROWVERSION()",
            null,
            cancellationToken
        )
            .ConfigureAwait(false);

    /// <inheritdoc />
    /// <remarks>
    /// A full batch is reported as "there is more", which the next call settles: it either returns the rest or comes
    /// back empty when the batch happened to end exactly on the boundary. The extra round trip in that case is the
    /// price of not fetching a row beyond the batch to peek with, and it costs one empty query per drained table.
    /// </remarks>
    public override async Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerChangesSql,
            new
            {
                anchor,
                ceiling,
                batchSize,
            },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }
}

/// <summary>Direct server source for a table without a row-version column (a key-ordered full scan, paged by primary key).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class VersionlessDirectSyncSource<TEntity, TKey>
    : DirectSyncSourceBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    public VersionlessDirectSyncSource(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(serverSqlExecutor, writer, descriptor) { }

    /// <summary>SELECT that returns the first ascending batch of rows by primary key (SQL Server quoting).</summary>
    private string ServerPageFirstSql => Descriptor.ServerPageFirstSql;

    /// <summary>SELECT that returns the next ascending batch of rows above a key (SQL Server quoting).</summary>
    private string ServerPageAfterSql => Descriptor.ServerPageAfterSql;

    /// <inheritdoc />
    /// <remarks>A key-ordered scan has no version to bound, so there is no ceiling to read.</remarks>
    public override Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => Task.FromResult<byte[]?>(null);

    /// <inheritdoc />
    /// <remarks>Never called for a table without a version column; the download pages by key instead.</remarks>
    public override Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "The table has no version column; its download pages by primary key."
        );

    /// <inheritdoc />
    /// <remarks>
    /// A full batch is reported as "there is more", which the next call settles: it either returns the rest or comes
    /// back empty when the batch happened to end exactly on the boundary - the same trade the versioned change scan
    /// makes.
    /// </remarks>
    public override async Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerPageFirstSql,
            new { batchSize },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }

    /// <inheritdoc />
    public override async Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerPageAfterSql,
            new { afterKey, batchSize },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }
}
{{~ if remote_services || runtime_package_export ~}}

/// <summary>The operation names of the sync-only endpoints (<c>POST {prefix}/{entity}/{operation}</c>).</summary>
/// <remarks>
/// The server maps them and the client posts to them, so both sides read the route from here and cannot drift apart.
/// They are additions to the same endpoint group as the CRUD operations, which is what makes authorization applied to
/// the group (<c>RemoteAccess.RequireAuthorization</c> at mapping time) cover them as well - and it has to: the
/// changed-rows endpoint hands out whole rows and the key endpoint hands out the entire key set of a table.
/// </remarks>
public static class RemoteSyncOperations
{
    /// <summary>Reads the exclusive upper bound for a sync pass (<c>MIN_ACTIVE_ROWVERSION()</c> on SQL Server).</summary>
    public const string Ceiling = "SyncCeiling";

    /// <summary>Reads one ascending batch of rows above an anchor and below a ceiling.</summary>
    public const string Changes = "SyncChanges";

    /// <summary>Reads every primary key the server holds for a table.</summary>
    public const string Keys = "SyncKeys";

    /// <summary>Reads one ascending batch of rows above a primary key (the versionless full scan; mapped only for tables without a version column).</summary>
    public const string Page = "SyncPage";
}

/// <summary>The response of <see cref="RemoteSyncOperations.Ceiling"/>.</summary>
/// <param name="Ceiling">The exclusive upper bound, or null when the server applies none.</param>
public sealed record RemoteSyncCeilingResult(byte[]? Ceiling);

/// <summary>The request of <see cref="RemoteSyncOperations.Changes"/>.</summary>
/// <param name="Anchor">The resume point (null takes everything below the ceiling).</param>
/// <param name="Ceiling">The exclusive upper bound the caller obtained for this pass (null applies none).</param>
/// <param name="BatchSize">The maximum number of rows to return (must be greater than zero).</param>
/// <remarks>
/// The ceiling travels from the client rather than being read again per request, because one pass has to use a single
/// bound: a bound re-read between two tables would let a row committed in between fall into the gap between them. The
/// consequence is that the guarantee behind the derived anchor only holds while the client sends the value
/// <see cref="RemoteSyncOperations.Ceiling"/> returned for the same pass. A ceiling above the server's own lowest
/// active version skips the rows still in flight beneath it permanently - the anchor moves past them and no later pass
/// looks below it again - so the value is not something a caller should invent.
/// </remarks>
public sealed record RemoteSyncChangesRequest(byte[]? Anchor, byte[]? Ceiling, int BatchSize);

/// <summary>The response of <see cref="RemoteSyncOperations.Changes"/>.</summary>
/// <param name="Rows">The changed rows, in ascending version order.</param>
/// <param name="HasMore">Whether asking again from the last row's version can still return something.</param>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record RemoteSyncChangesResult<TEntity>(IReadOnlyList<TEntity> Rows, bool HasMore)
    where TEntity : EntityBaseCore, new();

/// <summary>The response of <see cref="RemoteSyncOperations.Keys"/>.</summary>
/// <param name="Keys">Every primary key the server holds for the table.</param>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record RemoteSyncKeysResult<TKey>(IReadOnlyList<TKey> Keys);

/// <summary>The request of <see cref="RemoteSyncOperations.Page"/> (the response is a <see cref="RemoteSyncChangesResult{TEntity}"/>).</summary>
/// <param name="HasAfterKey">Whether <paramref name="AfterKey"/> carries a cursor (false asks for the first page).</param>
/// <param name="AfterKey">The last key of the previous batch (the exclusive lower bound), meaningful only when <paramref name="HasAfterKey"/> is true.</param>
/// <param name="BatchSize">The maximum number of rows to return (must be greater than zero).</param>
/// <remarks>
/// The cursor travels beside a flag rather than as a nullable value, because the key type is generic: a value-typed
/// key has no null to stand for "from the beginning", and a default value (zero, say) is a legitimate key.
/// </remarks>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record RemoteSyncPageRequest<TKey>(bool HasAfterKey, TKey? AfterKey, int BatchSize);

/// <summary>
/// The differential source for one entity type over HTTP: the sync-only endpoints for reading, and the ordinary remote
/// endpoints for replaying the local changes.
/// </summary>
/// <remarks>
/// <para>
/// It is an <see cref="HttpRemoteRepositoryCore{TEntity, TKey}"/> as well as a source, so <see cref="Writer"/> is the very
/// same client: the reads and the writes of one pass travel over one connection with one configuration, and every
/// failure - a conflict restored as <see cref="SaveConflictException"/>, a body that could not be read, a withheld
/// server message and its correlation id - is classified exactly as it is for any other remote call.
/// </para>
/// <para>
/// Nothing here is stateful. The resume point travels as the anchor in each request and the bound as the ceiling, so a
/// run interrupted at any point resumes by asking again with the anchor the local data now yields; the server keeps no
/// per-client bookkeeping and two clients on the same table do not interfere.
/// </para>
/// <para>
/// The wire format these endpoints speak is not promised to stay compatible across QuickER versions while the tool is
/// at 0.x, and nothing on the wire announces a mismatch, so regenerate the client and the server from the same diagram
/// and deploy them together.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
public sealed class HttpSyncServerSource<TEntity, TKey>
    : HttpRemoteRepositoryCore<TEntity, TKey>,
        ISyncServerSource<TEntity, TKey>,
        ISyncBinaryColumns<TKey>
    where TEntity : EntityBaseCore, new()
{
{{~ else ~}}
public sealed class HttpSyncServerSource<TEntity, TKey>
    : HttpRemoteRepositoryCore<TEntity, TKey>, ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
{{~ end ~}}
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;

    /// <summary>Initializes a new instance with the HTTP client and the table's descriptor (which names the route).</summary>
    public HttpSyncServerSource(
        HttpClient httpClient,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(httpClient, RouteOf(descriptor))
    {
        _descriptor = descriptor;
    }
{{~ else ~}}
    /// <summary>Initializes a new instance with the HTTP client and the table's descriptor (which names the route).</summary>
    public HttpSyncServerSource(
        HttpClient httpClient,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(httpClient, RouteOf(descriptor)) { }
{{~ end ~}}

    /// <summary>Reads the route off the descriptor before the base constructor runs (which is why it is static).</summary>
    private static string RouteOf(SyncTableDescriptor<TEntity, TKey> descriptor)
    {
        ArgumentNullException.ThrowIfNull(descriptor);

        return descriptor.RemoteRouteName;
    }

    /// <inheritdoc />
    /// <remarks>The client itself: the same connection, the same configuration, and the same failure classification.</remarks>
    public IRemoteRepositoryCore<TEntity, TKey> Writer => this;

{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    /// <inheritdoc />
    /// <remarks>
    /// The client itself again, when the table has such columns: they stream over the same binary endpoints the remote
    /// repository uses, so no second connection or configuration is involved.
    /// </remarks>
    public ISyncBinaryColumns<TKey>? BinaryColumns =>
        _descriptor.UnboundedBinaryColumnNames.Count == 0 ? null : this;

    /// <inheritdoc />
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <inheritdoc />
    public Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    ) =>
        DownloadUnboundedBinaryColumnAsync(
            KnownColumn(columnName),
            id,
            destination,
            cancellationToken
        );

    /// <inheritdoc />
    public Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    ) =>
        UploadUnboundedBinaryColumnAsync(
            KnownColumn(columnName),
            id,
            source,
            length,
            cancellationToken
        );

    /// <summary>Refuses a column name the table does not have, rather than asking the server for a route that has none.</summary>
    private string KnownColumn(string columnName) =>
        _descriptor.UnboundedBinaryColumnNames.Contains(columnName)
            ? columnName
            : throw new ArgumentOutOfRangeException(
                nameof(columnName),
                columnName,
                "The column is not an unbounded binary column of this table."
            );
{{~ end ~}}

    /// <inheritdoc />
    public async Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default)
    {
        var result = await InvokeAsync<RemoteSyncCeilingResult>(
            RemoteSyncOperations.Ceiling,
            null,
            cancellationToken
        ).ConfigureAwait(false);

        return result.Ceiling;
    }

    /// <inheritdoc />
    public async Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Changes,
            new RemoteSyncChangesRequest(anchor, ceiling, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }

    /// <inheritdoc />
    public async Task<IReadOnlyList<TKey>> GetAllKeysAsync(
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncKeysResult<TKey>>(
            RemoteSyncOperations.Keys,
            null,
            cancellationToken
        ).ConfigureAwait(false);

        return result.Keys;
    }

    /// <inheritdoc />
    /// <remarks>The server maps the page endpoint only for tables without a version column; nothing asks a versioned table for it.</remarks>
    public async Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Page,
            new RemoteSyncPageRequest<TKey>(false, default, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }

    /// <inheritdoc />
    public async Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Page,
            new RemoteSyncPageRequest<TKey>(true, afterKey, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }
}
{{~ end ~}}
{{~ end ~}}
{{~ if render_sync && emit_schema_dependent ~}}

/// <summary>The descriptors of the synchronised tables, and the graph recorder that reads them.</summary>

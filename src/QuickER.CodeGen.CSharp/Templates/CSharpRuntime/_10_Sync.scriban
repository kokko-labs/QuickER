{{~ if render_sync && emit_shared_infra ~}}

/// <summary>The kind of local change a sync run sends.</summary>
public enum SyncOperation
{
    /// <summary>An insert or an update. The row's current local content is what gets uploaded.</summary>
    Upsert,

    /// <summary>A delete. The key is what gets uploaded, guarded by the server version the row's state last recorded as its base (a table without a version column deletes by key alone).</summary>
    Delete,
}

/// <summary>Why a local change could not be sent to the server.</summary>
public enum SyncConflictReason
{
    /// <summary>Someone else changed the server row after the local copy was taken.</summary>
    ModifiedOnServer,

    /// <summary>The server row the local change was meant to update no longer exists.</summary>
    MissingOnServer,

    /// <summary>The row was created locally, but a row with the same key already exists on the server.</summary>
    DuplicateOnServer,

    /// <summary>The server refused the row because a row it refers to is no longer there.</summary>
    /// <remarks>
    /// Reported when writing the row to the server failed and a parent the local row points at turned out to be gone
    /// from the server - deleted there while the row was being edited here. Neither policy brings the parent back:
    /// <see cref="SyncConflictPolicy.LocalWins"/> makes the local change win, not the local view of rows this device did
    /// not change. Running with <see cref="SyncConflictPolicy.ServerWins"/> (in either mode), pointing the row at another
    /// parent, or editing the parent locally (which records a change of its own) settles it.
    /// </remarks>
    ParentMissingOnServer,

    /// <summary>The server refused to delete the row, which it still holds and which a row it holds refers to.</summary>
    /// <remarks>
    /// Reported when deleting the row on the server failed while the server still holds it and a row the server holds
    /// refers to it - typically because another device has added one. The rows looked at are the server rows of the
    /// synchronized tables that refer to the row by its primary key; a referring table outside that reach (one the engine
    /// does not synchronize, or a foreign key that refers to a unique constraint or spans several columns) cannot be
    /// asked, and its presence alone reports the delete this way. The change stays unsent and the next run tries
    /// again. Running with <see cref="SyncConflictPolicy.ServerWins"/> (in either mode) brings the row back, together with
    /// whatever now points at it.
    /// </remarks>
    DeleteRefusedOnServer,

    /// <summary>The server refused the row because another row there holds one of its unique values.</summary>
    /// <remarks>
    /// Reported when writing the row to the server failed and the server's uniqueness check, asked with the local row,
    /// finds another row holding the value - typically another device took it in the meantime, or the row this device
    /// deleted to free it is still there because the delete did not go through. Neither policy takes the value from
    /// the other row: <see cref="SyncConflictPolicy.LocalWins"/> makes the local change win, not the local view of rows
    /// this device did not change. Changing the value, or running with <see cref="SyncConflictPolicy.ServerWins"/> (in
    /// either mode), settles it.
    /// </remarks>
    UniqueValueTakenOnServer,
}

/// <summary>How the engine treats a local change that collides with the server.</summary>
public enum SyncConflictPolicy
{
    /// <summary>Leaves the change unsent and reports it (the default: nothing is resolved silently).</summary>
    Collect,

    /// <summary>Discards the local change and makes the row match the server's state: the server's row is read back over the local one when the server has the key, and delete propagation removes the row when it does not (a local insert the server never received).</summary>
    /// <remarks>
    /// A <see cref="SyncMode.Versioned"/> run discards every local change of the tables it covers. A
    /// <see cref="SyncMode.LastWriteWins"/> run uploads as it always does and discards only the changes the server
    /// refuses (<see cref="SyncConflictReason.ParentMissingOnServer"/>,
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>, <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>),
    /// which are not reported as conflicts then. That is the one way to settle such a change to a table without a version
    /// column, which no versioned run reaches.
    /// </remarks>
    ServerWins,

    /// <summary>Resends the local change with <see cref="ConcurrencyMode.ForceOverwrite"/>, overwriting the server row - and inserting it again when the server has no such row, so a row deleted on the server is resurrected by a local edit.</summary>
    LocalWins,
}

/// <summary>One local change that could not be replayed against the server.</summary>
/// <param name="TableName">The table the row belongs to.</param>
/// <param name="KeyText">The primary key, in its text form (see <see cref="SyncKeyText"/>).</param>
/// <param name="Operation">The local operation that was being replayed.</param>
/// <param name="Reason">Why the replay did not go through.</param>
/// <param name="LocalEntity">The local row as it stands (null for a delete, whose row is already gone locally).</param>
/// <param name="ServerEntity">The server row as it stands (null when the server has no such row).</param>
public sealed record SyncConflict(
    string TableName,
    string KeyText,
    SyncOperation Operation,
    SyncConflictReason Reason,
    object? LocalEntity,
    object? ServerEntity
);

/// <summary>How one run treats versions and conflicts.</summary>
public enum SyncMode
{
    /// <summary>
    /// Versioned differential sync (the default): tables with a version column sync incrementally under version
    /// guards, and tables without one take no part in the run.
    /// </summary>
    Versioned,

    /// <summary>
    /// Last-write-wins: every table takes part. Uploads overwrite the server unconditionally - an update that finds
    /// no row inserts it, a delete needs no version - so nothing is reported as a conflict except a write the server
    /// refuses (<see cref="SyncConflictReason.ParentMissingOnServer"/>,
    /// <see cref="SyncConflictReason.DeleteRefusedOnServer"/>, <see cref="SyncConflictReason.UniqueValueTakenOnServer"/>),
    /// and <see cref="SyncOptions.ConflictPolicy"/> is ignored except that <see cref="SyncConflictPolicy.ServerWins"/>
    /// settles those three. Tables without a version column download as a full
    /// key-ordered scan on every run; tables with one still download incrementally, because the result is the same
    /// and the transfer is smaller. The winner is whoever <i>uploads</i> last, not whoever edited last, and a lost
    /// update is neither detected nor reported - that is the trade this mode names.
    /// </summary>
    LastWriteWins,
}

/// <summary>Knobs for one sync run.</summary>
public sealed class SyncOptions
{
    /// <summary>How versions and conflicts are treated in this run (default <see cref="SyncMode.Versioned"/>).</summary>
    public SyncMode Mode { get; init; } = SyncMode.Versioned;

    /// <summary>The entity types this run leaves out entirely (upload, download, and delete propagation alike).</summary>
    /// <remarks>
    /// This is a per-run scope, not a way to keep a table local: the change tracking keeps recording the
    /// excluded tables' writes, and the next run that includes them sends what accumulated. A table that should
    /// never sync is excluded where the engine is put together instead (the <c>excludeFromSync</c> argument of
    /// <c>AddGeneratedSyncEngine</c>), which also stops the recording. A type the engine does not synchronise -
    /// including one excluded at construction - is rejected with <see cref="ArgumentException"/> rather than
    /// silently skipped.
    /// </remarks>
    public IReadOnlyCollection<Type> ExcludedEntityTypes { get; init; } = [];

    /// <summary>How many rows one download batch fetches and applies in a single local transaction (default 500).</summary>
    public int DownloadBatchSize { get; init; } = 500;

    /// <summary>
    /// How many rows one fetch and apply of <see cref="SyncEngine"/> may bring down before it checks for unsent
    /// changes (default 300,000; must be greater than zero).
    /// </summary>
    /// <remarks>
    /// The fetched rows are held in memory until they are applied. When the rows fetched exceed this limit and the tables
    /// of the run hold unsent local changes, the run throws <see cref="SyncDownloadTooLargeException"/> and applies
    /// nothing. Without unsent changes it applies the rest of the download a chunk at a time, committing as it goes (see
    /// <see cref="SyncEngine"/>), as a fetch over 50,000 rows without unsent changes does even below this limit.
    /// </remarks>
    public int DownloadRowLimit { get; init; } = 300_000;

    /// <summary>Whether to delete local rows whose key no longer exists on the server (default true).</summary>
    /// <remarks>
    /// <para>
    /// The check compares the full key set of each table, which costs a key-only pass over the server table each time it
    /// runs - and a run runs it twice, before the download and again after it, reading the keys afresh. Turn it off (and
    /// run it on a slower schedule) when the tables are large enough for those passes to matter.
    /// </para>
    /// <para>
    /// A key that still holds an unsent local change is spared, so a local edit awaiting upload - including one this
    /// run reported as a conflict - is not removed underneath the caller. The change tracking records a write to a
    /// synchronised table whichever entry point makes it - a repository or raw SQL. Rows the local database is meant to
    /// keep to itself belong in a table that is not synchronised (one excluded where the engine is put together - the
    /// <c>excludeFromSync</c> argument of <c>AddGeneratedSyncEngine</c>).
    /// </para>
    /// </remarks>
    public bool PropagateDeletes { get; init; } = true;

    /// <summary>How a local change that collides with the server is treated (default <see cref="SyncConflictPolicy.Collect"/>).</summary>
    public SyncConflictPolicy ConflictPolicy { get; init; } = SyncConflictPolicy.Collect;

    /// <summary>Whether to carry the unbounded binary columns the row transfer leaves out (default false).</summary>
    /// <remarks>
    /// <para>
    /// Only tables generated with the unbounded binary columns excluded have any (<see cref="ISyncTableDescriptor.UnboundedBinaryColumnNames"/>
    /// names them); for every other table this changes nothing. Those columns are not part of the row a run reads or
    /// writes, so with this off a downloaded row arrives without its blob and an uploaded row is sent without it. What is
    /// already stored on the receiving side stays there - an update never touches an excluded column - but a row that is
    /// new to that side has nothing to keep, and arrives with the column empty.
    /// </para>
    /// <para>
    /// With it on, each such column is copied separately after the row itself has been transferred, streamed through a
    /// temporary file so neither side has to hold the blob in memory. That is one round trip per column per changed row,
    /// which is why it is not the default: a table of large blobs whose rows change often pays for it on every run.
    /// </para>
    /// <para>
    /// That file is created in the operating system's temporary folder (<c>Path.GetTempPath()</c>) and deleted when the
    /// column has been written, so a blob whose contents are sensitive passes through the file system unencrypted for the
    /// duration of its copy - on a machine where that matters, point the temporary folder somewhere it does not.
    /// </para>
    /// </remarks>
    public bool IncludeUnboundedBinary { get; init; }
}

/// <summary>One table whose download stopped before the end of the server's changes.</summary>
/// <remarks>
/// <para>
/// A table stops at a row it cannot apply yet; only that table stops, and the tables after it in foreign-key order go
/// on. The table's resume point stays before the row, so the row comes down again on a later run.
/// </para>
/// <para>
/// A row cannot be applied yet when it collides on a unique value with local rows and not even a rotation of the rows
/// left can place it, when its key holds a row this device created that the server does not know yet, or when it refers
/// to a parent the local database does not have once the server's rows are written. The last kind names the parent's
/// table in <see cref="MissingParentTableName"/>.
/// </para>
/// </remarks>
/// <param name="TableName">The table whose download stopped early.</param>
/// <param name="PendingKeyText">The key of the row the download stopped at.</param>
public sealed record SyncDownloadTruncation(string TableName, string? PendingKeyText)
{
    /// <summary>The table of the parent the row the download stopped at refers to and could not have, or null when the row stopped for another reason.</summary>
    public string? MissingParentTableName { get; init; }
}

/// <summary>What one sync run did.</summary>
/// <param name="Uploaded">The number of local changes replayed against the server.</param>
/// <param name="Downloaded">The number of server rows applied locally.</param>
/// <param name="DeletedLocally">The number of local rows removed because the server no longer has that key.</param>
/// <param name="Discarded">The number of local changes dropped without being sent (a change with nothing left to send, or ServerWins).</param>
/// <param name="Conflicts">The local changes that could not be replayed; they stay unsent.</param>
public sealed record SyncResult(
    int Uploaded,
    int Downloaded,
    int DeletedLocally,
    int Discarded,
    IReadOnlyList<SyncConflict> Conflicts
)
{
    /// <summary>The tables whose download stopped early, empty when every table was drained.</summary>
    /// <remarks>
    /// A run that reports a conflict usually reports a truncation as well: the conflicted row's own table stops at it.
    /// The rows behind the stopping point are still on the server and come down once the row that stopped them is
    /// settled, which is the caller's to decide and re-run.
    /// </remarks>
    public IReadOnlyList<SyncDownloadTruncation> Truncations { get; init; } = [];

    /// <summary>Whether any local change was left unsent.</summary>
    public bool HasConflicts => Conflicts.Count > 0;

    /// <summary>Whether any table's download stopped early.</summary>
    public bool HasTruncations => Truncations.Count > 0;

    /// <summary>The local rows the run discarded the changes of, empty when it discarded none.</summary>
    /// <remarks>
    /// <para>
    /// A run changes local rows that are not just the server's changes coming down: under
    /// <see cref="SyncConflictPolicy.ServerWins"/> it discards the unsent changes of the rows it settles and puts the
    /// server's content back. Each such row is listed once per reason (see <see cref="SyncLocalRowChangeReason"/>); the
    /// count in <see cref="Discarded"/> includes them.
    /// </para>
    /// <para>
    /// Only <see cref="SyncEngine.SyncAsync"/> fills this; <see cref="SyncEngine.UploadAsync"/> and
    /// <see cref="SyncEngine.DownloadAsync"/> called on their own return what they always did. A run that throws hands the
    /// rows it had changed so far on in the exception's <see cref="Exception.Data"/>, under
    /// <see cref="SyncEngine.LocalRowChangesDataKey"/>.
    /// </para>
    /// </remarks>
    public IReadOnlyList<SyncLocalRowChange> LocalRowChanges { get; init; } = [];
}

/// <summary>Why a sync run changed a local row other than by applying the server's change to it.</summary>
public enum SyncLocalRowChangeReason
{
    /// <summary>A <see cref="SyncConflictPolicy.ServerWins"/> run discarded the row's unsent changes and put the server's content back (or left the row for the delete propagation when the server no longer has it).</summary>
    DiscardedByServerWins,
}

/// <summary>One local row a sync run changed other than by applying the server's change to it (see <see cref="SyncResult.LocalRowChanges"/>).</summary>
/// <param name="TableName">The row's table.</param>
/// <param name="KeyText">The row's key in its text form (see <see cref="SyncKeyText"/>).</param>
/// <param name="Reason">Why the run changed it.</param>
public sealed record SyncLocalRowChange(string TableName, string KeyText, SyncLocalRowChangeReason Reason);

/// <summary>Collects the local rows one run changes on its own, each once per reason.</summary>
internal sealed class SyncLocalRowChangeLog
{
    private readonly List<SyncLocalRowChange> _changes = [];
    private readonly HashSet<SyncLocalRowChange> _seen = [];

    /// <summary>Notes one row.</summary>
    public void Add(string tableName, string keyText, SyncLocalRowChangeReason reason)
    {
        var change = new SyncLocalRowChange(tableName, keyText, reason);

        if (_seen.Add(change))
        {
            _changes.Add(change);
        }
    }

    /// <summary>The rows noted so far, in the order they were noted.</summary>
    public IReadOnlyList<SyncLocalRowChange> ToList() => _changes.ToList();
}

/// <summary>Knobs for one refresh run.</summary>
public sealed class SyncRefreshOptions
{
    /// <summary>Which tables the refresh covers (default <see cref="SyncMode.LastWriteWins"/> = every synchronised table).</summary>
    /// <remarks>
    /// <para>
    /// A refresh has no upload, so the mode is purely a scope here - and unlike an ordinary run, the default takes
    /// everything: a refresh rebuilds the local database as a copy of the server's, and leaving the versionless
    /// tables out of that rebuild would keep stale rows pointing at parents the refresh is about to remove (a foreign
    /// key failure whenever a versionless table references a versioned one). On a diagram whose tables all carry a
    /// version column the two defaults cover the same set, so nothing changes there.
    /// </para>
    /// <para>
    /// <see cref="SyncMode.Versioned"/> narrows the refresh to the versioned tables. While a local row of a versionless
    /// table refers to a row of a versioned table, the run throws <see cref="SyncRefreshScopeException"/> before it
    /// deletes anything, rather than removing rows of the versioned table underneath that row.
    /// The unsent-changes refusal and the forced discard follow the scope either way: unsent changes of tables outside
    /// this refresh are neither counted nor dropped.
    /// </para>
    /// </remarks>
    public SyncMode Mode { get; init; } = SyncMode.LastWriteWins;

    /// <summary>The entity types this refresh leaves out (neither replaced nor reloaded).</summary>
    /// <remarks>
    /// The same per-run scope as <see cref="SyncOptions.ExcludedEntityTypes"/>, with the same rejection of a type the
    /// engine does not synchronise. Leaving a child table out while one of its local rows refers to a row of a table
    /// the run rebuilds makes the run throw <see cref="SyncRefreshScopeException"/> before it deletes anything. Leaving
    /// a parent table out while reloading its children can break a foreign key mid-run; the scope is the caller's to
    /// choose soundly there.
    /// </remarks>
    public IReadOnlyCollection<Type> ExcludedEntityTypes { get; init; } = [];

    /// <summary>How many rows one batch fetches from the server and writes locally (default 2000).</summary>
    /// <remarks>
    /// <para>
    /// Each batch is one local transaction, and on a local database that commit costs more than the inserts it commits.
    /// The default is therefore several times the one an ordinary run downloads with: a refresh writes whole tables and
    /// gains most of its speed here, while a run interrupted part way is repaired by running it again, so the finer
    /// resume granularity a small batch buys is worth less.
    /// </para>
    /// <para>
    /// The cost of raising it is memory - a batch is held in full - and, when the server is reached over HTTP, the size
    /// of one response body. A table with large binary columns is the case that wants a smaller value than the default,
    /// not a larger one.
    /// </para>
    /// </remarks>
    public int BatchSize { get; init; } = 2000;

    /// <summary>
    /// How many rows one fetch and apply of <see cref="SyncEngine"/> may bring down before it checks for unsent
    /// changes (default 300,000; must be greater than zero).
    /// </summary>
    /// <remarks>
    /// The fetched rows are held in memory until they are applied. When the rows fetched exceed this limit and the tables
    /// of the refresh hold unsent local changes other than the ones the refresh discards (changes written while the
    /// refresh runs), the run throws <see cref="SyncDownloadTooLargeException"/> and applies nothing. Otherwise it
    /// applies the rest of the refresh a chunk at a time, committing as it goes (see <see cref="SyncEngine"/>), as
    /// a fetch over 50,000 rows without such changes does even below this limit.
    /// </remarks>
    public int DownloadRowLimit { get; init; } = 300_000;

    /// <summary>Whether to discard the unsent local changes instead of refusing to run (default false).</summary>
    /// <remarks>
    /// A refresh replaces the local rows wholesale, so an offline edit that has not reached the server yet goes with
    /// them. Leaving this off makes the run throw <see cref="SyncPendingChangesException"/> before it touches
    /// anything, which leaves the caller free to send those changes first - an ordinary
    /// <see cref="SyncEngine.SyncAsync"/> is what sends them - and refresh afterwards. Turning it on says the loss is
    /// intended.
    /// </remarks>
    public bool Force { get; init; }

    /// <summary>Whether to reload the unbounded binary columns as well (default false).</summary>
    /// <remarks>
    /// A refresh replaces the local rows with the server's, and the ordinary row transfer leaves the excluded columns
    /// out. Turning this on copies each such column down after its row has been written, which makes the rebuilt local
    /// database a complete copy at the cost of one round trip per column per row. Leaving it off means the rebuilt rows
    /// carry no blobs: the refresh empties those columns on every row it does not leave unsent - which is why a table
    /// that has such columns refuses to be refreshed until one of this and <see cref="DiscardLocalUnboundedBinaries"/> says which of the two was meant.
    /// </remarks>
    public bool IncludeUnboundedBinary { get; init; }

    /// <summary>Whether to accept losing the local unbounded binary columns instead of refusing to run (default false).</summary>
    /// <remarks>
    /// This is the other answer to the same question <see cref="IncludeUnboundedBinary"/> answers, for the case where the
    /// blobs are not worth transferring - a local cache of thumbnails that can be rebuilt, say. It says the loss is
    /// intended; it does not make the rows arrive with their blobs. Setting both is not a contradiction, because
    /// carrying the columns means nothing is lost for the flag to permit.
    /// </remarks>
    public bool DiscardLocalUnboundedBinaries { get; init; }
}

/// <summary>The unbounded binary columns one table would lose in a refresh.</summary>
/// <param name="TableName">The table.</param>
/// <param name="ColumnNames">The columns the ordinary row transfer leaves out.</param>
public sealed record SyncUnboundedBinaryColumns(
    string TableName,
    IReadOnlyList<string> ColumnNames
);

/// <summary>Thrown when a refresh would drop local blobs without having been told which of the two outcomes was meant.</summary>
/// <remarks>
/// The run throws before it deletes anything. Set <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> to reload the
/// columns with the rows, or <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> to say the loss is intended.
/// </remarks>
public sealed class SyncUnboundedBinaryLossException : InvalidOperationException
{
    /// <summary>Creates the exception from the per-table breakdown of the columns at stake.</summary>
    /// <param name="columns">The unbounded binary columns, grouped by table.</param>
    public SyncUnboundedBinaryLossException(IReadOnlyList<SyncUnboundedBinaryColumns> columns)
        : base(BuildMessage(columns))
    {
        ArgumentNullException.ThrowIfNull(columns);
        Columns = columns;
    }

    /// <summary>The unbounded binary columns the refresh would have dropped, grouped by table.</summary>
    public IReadOnlyList<SyncUnboundedBinaryColumns> Columns { get; }

    /// <summary>Builds the message, which names the columns so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncUnboundedBinaryColumns> columns)
    {
        ArgumentNullException.ThrowIfNull(columns);
        var breakdown = string.Join(
            ", ",
            columns.Select(table =>
                $"{table.TableName}: {string.Join('/', table.ColumnNames)}"
            )
        );

        return "A refresh replaces the local rows, and the unbounded binary columns of these tables go with them "
            + $"({breakdown}). Set SyncRefreshOptions.IncludeUnboundedBinary to reload them as well, or "
            + "SyncRefreshOptions.DiscardLocalUnboundedBinaries to say the loss is intended.";
    }
}

/// <summary>How many unsent local changes one table has.</summary>
/// <param name="TableName">The table the changes belong to.</param>
/// <param name="Count">The number of rows with an unsent local change.</param>
public sealed record SyncPendingChange(string TableName, int Count);

/// <summary>Thrown when a refresh is asked for while the tables still hold unsent local changes.</summary>
/// <remarks>
/// The run throws before it deletes anything, so the local database is exactly as it was and the changes are still
/// there to be uploaded.
/// </remarks>
public sealed class SyncPendingChangesException : InvalidOperationException
{
    /// <summary>Creates the exception from the per-table breakdown of what the refresh would have discarded.</summary>
    /// <param name="pendingChanges">The unsent local changes, grouped by table.</param>
    public SyncPendingChangesException(IReadOnlyList<SyncPendingChange> pendingChanges)
        : base(BuildMessage(pendingChanges))
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        PendingChanges = pendingChanges;
        PendingCount = pendingChanges.Sum(change => change.Count);
    }

    /// <summary>The unsent local changes the refresh would have discarded, grouped by table.</summary>
    public IReadOnlyList<SyncPendingChange> PendingChanges { get; }

    /// <summary>The total number of unsent local changes.</summary>
    public int PendingCount { get; }

    /// <summary>Builds the message, which names the tables so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncPendingChange> pendingChanges)
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        var breakdown = string.Join(
            ", ",
            pendingChanges.Select(change => $"{change.TableName}: {change.Count}")
        );

        return $"A refresh would discard {pendingChanges.Sum(change => change.Count)} unsent local "
            + $"change(s) ({breakdown}). Upload them with SyncAsync first, or set "
            + "SyncRefreshOptions.Force to discard them.";
    }
}

/// <summary>One table outside a refresh whose local rows refer to a table the refresh rebuilds.</summary>
/// <param name="ReferencingTableName">The table outside the refresh that holds the referring rows.</param>
/// <param name="ReferencedTableName">The table the refresh would rebuild, which those rows refer to.</param>
public sealed record SyncRefreshScopeReference(string ReferencingTableName, string ReferencedTableName);

/// <summary>Thrown when a refresh would rebuild a table that rows of a table outside the refresh refer to.</summary>
/// <remarks>
/// <para>
/// A refresh replaces the rows of every table it covers with the server's, and removes the local rows the server does
/// not hold. A local row of a table outside the refresh that refers to one of those rows would either go with it, under
/// <c>ON DELETE CASCADE</c>, taking any unsent edit of it along, or make the refresh fail on the local foreign key. The run throws before it reads or deletes anything, so
/// the local database and its change tracking are exactly as they were.
/// </para>
/// <para>
/// Bring the referring table into the refresh (drop it from <see cref="SyncRefreshOptions.ExcludedEntityTypes"/>, or
/// use <see cref="SyncMode.LastWriteWins"/> when it is a table without a version column), or remove the referring rows
/// first. A table that is not synchronised at all - one excluded when the engine was built, or one the diagram has but
/// the engine does not - can only be dealt with the second way.
/// </para>
/// </remarks>
public sealed class SyncRefreshScopeException : InvalidOperationException
{
    /// <summary>Creates the exception from the references that block the refresh.</summary>
    /// <param name="references">The tables outside the refresh whose rows refer to a table it rebuilds.</param>
    public SyncRefreshScopeException(IReadOnlyList<SyncRefreshScopeReference> references)
        : base(BuildMessage(references))
    {
        ArgumentNullException.ThrowIfNull(references);
        References = references;
    }

    /// <summary>The tables outside the refresh whose rows refer to a table it rebuilds.</summary>
    public IReadOnlyList<SyncRefreshScopeReference> References { get; }

    /// <summary>Builds the message, which names the tables so the caller does not have to read the property to act.</summary>
    private static string BuildMessage(IReadOnlyList<SyncRefreshScopeReference> references)
    {
        ArgumentNullException.ThrowIfNull(references);
        var breakdown = string.Join(
            ", ",
            references.Select(reference =>
                $"{reference.ReferencingTableName} -> {reference.ReferencedTableName}"
            )
        );

        return "A refresh rebuilds the tables it covers from the server's rows, and local rows of tables outside it refer to them "
            + $"({breakdown}). Bring the referring tables into the refresh, or remove the referring rows first.";
    }
}

/// <summary>What a refresh did to one table.</summary>
/// <param name="TableName">The table.</param>
/// <param name="Deleted">How many local rows were removed because the server no longer holds them.</param>
/// <param name="Inserted">How many server rows were written.</param>
public sealed record SyncRefreshTableResult(string TableName, int Deleted, int Inserted);

/// <summary>What one refresh run did.</summary>
/// <param name="Tables">The per-table counts, in the order the rows were written (parents first).</param>
/// <param name="DiscardedChanges">The number of rows whose unsent change the refresh actually discarded: the rows it put the server's row over and the rows the server no longer holds that only lost their change. Those are the unsent rows when <see cref="SyncRefreshOptions.Force"/> was set and the rows marked to be discarded (<see cref="SyncEngine.DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>); a row written again on the device during the refresh keeps its change and is not counted.</param>
/// <param name="Elapsed">How long the whole run took, measured around it rather than accumulated per table.</param>
public sealed record SyncRefreshResult(
    IReadOnlyList<SyncRefreshTableResult> Tables,
    int DiscardedChanges,
    TimeSpan Elapsed
)
{
    /// <summary>The total number of local rows removed.</summary>
    public int Deleted => Tables.Sum(table => table.Deleted);

    /// <summary>The total number of server rows written locally.</summary>
    public int Inserted => Tables.Sum(table => table.Inserted);
}

/// <summary>One batch of server changes, together with whether the stream it came from has more behind it.</summary>
/// <param name="Rows">The changed rows, in ascending version order.</param>
/// <param name="HasMore">Whether asking again - from the version the last row carries - can still return something.</param>
/// <remarks>
/// The flag is the source's own answer rather than something inferred from the row count. A full batch is the usual way
/// a source says "there is more", but only the source knows: one that trims a batch to fit a transfer limit returns
/// fewer rows and still has more behind them, and inferring from the count alone would stop the download early and
/// leave the rest for a later run without saying so.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record SyncChangeBatch<TEntity>(IReadOnlyList<TEntity> Rows, bool HasMore)
    where TEntity : EntityBaseCore, new();

/// <summary>
/// One side's unbounded binary columns, reachable by column name so the engine can copy them without knowing the entity.
/// </summary>
/// <remarks>
/// <para>
/// The generated accessors are named after their column (<c>ReadPayloadAsync</c> and so on), which an engine written
/// against <c>TEntity</c> cannot call. Both sides expose the same narrow surface instead, and the engine copies through
/// it - which is also what lets a direct database connection and an HTTP client stand in the same place, as they do for
/// every other part of a sync run.
/// </para>
/// <para>
/// A column name outside <see cref="UnboundedBinaryColumnNames"/> is rejected rather than ignored: silently doing
/// nothing would leave the destination as it was and report the copy as done.
/// </para>
/// </remarks>
/// <typeparam name="TKey">The primary key type.</typeparam>
public interface ISyncBinaryColumns<TKey>
{
    /// <summary>The names of the columns the ordinary row transfer leaves out.</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>Reads one column into the destination stream (false = no row, or the column is NULL).</summary>
    /// <param name="columnName">One of <see cref="UnboundedBinaryColumnNames"/>.</param>
    /// <param name="id">The primary key of the row.</param>
    /// <param name="destination">The stream the column's bytes are written to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    );

    /// <summary>Writes one column from a stream, or sets it to NULL (false = no row).</summary>
    /// <param name="columnName">One of <see cref="UnboundedBinaryColumnNames"/>.</param>
    /// <param name="id">The primary key of the row.</param>
    /// <param name="source">The bytes to store, or null to set the column to NULL.</param>
    /// <param name="length">The number of bytes, required when the stream cannot report its own length.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    );
}

/// <summary>One foreign key of a synchronised table, as the engine reads it off a row.</summary>
/// <param name="ParentTableName">The table the row refers to (its name as the descriptors carry it).</param>
/// <param name="ReadParentKeyText">Reads the parent's primary key off the row in its text form, or null when the row refers to no parent.</param>
/// <typeparam name="TEntity">The entity type of the referring row.</typeparam>
public sealed record SyncParentReference<TEntity>(
    string ParentTableName,
    Func<TEntity, string?> ReadParentKeyText
);

/// <summary>Helpers for the text form a primary key takes in the sync state.</summary>
public static class SyncKeyText
{
    /// <summary>The length of a <see cref="DateTime"/> in round-trip form without a kind (<c>yyyy-MM-ddTHH:mm:ss.fffffff</c>).</summary>
    private const int DateTimeLength = 27;

    /// <summary>
    /// Removes the kind a <see cref="DateTime"/> key in round-trip form carries - a trailing <c>Z</c>, or a
    /// <c>+hh:mm</c> / <c>-hh:mm</c> offset - and leaves the clock time; any other text comes back as it is.
    /// </summary>
    /// <remarks>
    /// A <see cref="DateTime"/> key is written without its kind, because neither database keeps it: a row read back
    /// carries <see cref="DateTimeKind.Unspecified"/> whatever kind it was written with, and a key text that kept the
    /// kind would never meet the text of the row it is about. This also reads a key text an earlier version wrote with
    /// the kind still in it.
    /// </remarks>
    /// <param name="keyText">The key text.</param>
    public static string WithoutDateTimeKind(string keyText)
    {
        ArgumentNullException.ThrowIfNull(keyText);

        if (keyText.Length == DateTimeLength + 1 && keyText[DateTimeLength] == 'Z')
        {
            return keyText[..DateTimeLength];
        }

        if (
            keyText.Length == DateTimeLength + 6
            && keyText[DateTimeLength] is '+' or '-'
            && keyText[DateTimeLength + 3] == ':'
        )
        {
            return keyText[..DateTimeLength];
        }

        return keyText;
    }

    /// <summary>The fixed-point pattern a <see cref="decimal"/> key is written with: no exponent, no trailing zeros, every one of the 28 decimal places a value can have.</summary>
    private const string DecimalPattern = "0.############################";

    /// <summary>Writes a <see cref="decimal"/> key in its text form.</summary>
    /// <remarks>
    /// The scale is normalised (no trailing zeros): SQL Server returns a value at the scale the column declares
    /// (<c>1.50</c> in a <c>decimal(10,2)</c>) while SQLite keeps the digits it was given, and the same row has to give
    /// the same text on both sides. The text never uses an exponent, so <see cref="ParseDecimal"/> reads it back - a
    /// general format writes a value below 1e-5 in magnitude as <c>1E-06</c>.
    /// </remarks>
    /// <param name="value">The key.</param>
    public static string FormatDecimal(decimal value) =>
        value.ToString(DecimalPattern, CultureInfo.InvariantCulture);

    /// <summary>Reads a <see cref="decimal"/> key from its text form, including the exponent form an earlier version wrote.</summary>
    /// <param name="keyText">The key text.</param>
    public static decimal ParseDecimal(string keyText)
    {
        ArgumentNullException.ThrowIfNull(keyText);

        return decimal.Parse(keyText, NumberStyles.Float, CultureInfo.InvariantCulture);
    }
}

/// <summary>One foreign key of the diagram that points at a synchronised table's primary key, as the local database is asked about it.</summary>
/// <param name="TableName">The referring table, as the local database names it.</param>
/// <param name="Sql">Returns which of the given keys (bound as the collection parameter <c>@keys</c>) a row of the referring table refers to.</param>
public sealed record SyncLocalReference(string TableName, string Sql);

/// <summary>How one unbounded binary column is read from and written to a repository that owns it.</summary>
/// <remarks>
/// The repository arrives untyped because these accessors are declared on the concrete generated contract
/// (<c>ISyncOrderRepository</c> and the like), which the fixed engine has no way to name. The generated lambda is the
/// only place that knows the type, and it casts back to it there.
/// </remarks>
/// <param name="Read">Reads the column into the destination stream (false = no row, or the column is NULL).</param>
/// <param name="Write">Writes the column from a stream, or sets it to NULL when the stream is null (false = no row).</param>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record SyncBinaryColumnAccessor<TKey>(
    Func<object, TKey, Stream, CancellationToken, Task<bool>> Read,
    Func<object, TKey, Stream?, long?, CancellationToken, Task<bool>> Write
);

/// <summary>One trigger that records the changes of a synchronised table in the local database.</summary>
/// <param name="Name">The trigger name, unquoted (it starts with <see cref="SyncLocalTracking.TriggerNamePrefix"/>).</param>
/// <param name="TableName">The table the trigger is on (<see cref="ISyncTableDescriptor.LocalTableName"/>).</param>
/// <param name="Sql">The statement that creates the trigger.</param>
public sealed record SyncLocalTrigger(string Name, string TableName, string Sql);

/// <summary>
/// The tables and triggers that record, inside the local (SQLite) database itself, which rows of the synchronised tables
/// have changed.
/// </summary>
/// <remarks>
/// <para>
/// <c>quicker_sync_state</c> holds one row: the format of these tables, an identifier of the database, whether the
/// engine is applying server rows (<c>applying</c>, which the triggers check so that what the engine writes is not
/// recorded as a local change), and the next change number. <c>quicker_sync_row</c> holds one row per changed row of a
/// synchronised table: its table, its key as the table stores it, whether it is still to be sent (<c>dirty</c>), whether
/// it was deleted, the unbounded binary columns written since it was last sent, and the number of its latest change.
/// It also has columns only the engine writes (<c>base_version</c>, <c>known</c>, <c>sw_seq</c>, <c>blob_owed</c>,
/// <c>applied_version</c>: the version of the latest content of another writer the engine put into the row).
/// The anchor table <c>quicker_sync_table</c> holds one row per synchronised table: where its next download resumes
/// (<c>anchor</c>).
/// </para>
/// <para>
/// Each synchronised table gets an insert, an update and a delete trigger, and one trigger per unbounded binary column
/// the ordinary row transfer leaves out (fired only by an update of that column). The triggers write only the columns
/// named here, so the engine's columns of <c>quicker_sync_row</c> keep their values across a delete, a re-insert under
/// the same key and a change of the primary key.
/// </para>
/// </remarks>
public static class SyncLocalTracking
{
    /// <summary>The name of the table that holds the state of the change tracking.</summary>
    public const string StateTableName = "quicker_sync_state";

    /// <summary>The name of the table that holds one row per changed row of a synchronised table.</summary>
    public const string RowTableName = "quicker_sync_row";

    /// <summary>The name of the anchor table: one row per synchronised table, holding where its next download resumes.</summary>
    public const string AnchorTableName = "quicker_sync_table";

    /// <summary>The prefix of the names of the triggers the change tracking puts on the synchronised tables.</summary>
    public const string TriggerNamePrefix = "quicker_sync_trg_";

    /// <summary>The statement that creates the state table when it is missing.</summary>
    private const string CreateStateTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_state ("
        + "id INTEGER PRIMARY KEY CHECK (id = 1), "
        + "format INTEGER NOT NULL, "
        + "db_id TEXT NOT NULL, "
        + "applying INTEGER NOT NULL, "
        + "next_seq INTEGER NOT NULL)";

    /// <summary>The statement that puts the one row into the state table when it is not there yet.</summary>
    private const string SeedStateSql =
        "INSERT OR IGNORE INTO quicker_sync_state (id, format, db_id, applying, next_seq) "
        + "VALUES (1, 1, lower(hex(randomblob(16))), 0, 1)";

    /// <summary>The declaration of the engine's column <c>base_version</c> of the row state table.</summary>
    private const string BaseVersionColumn = "base_version BLOB NULL";

    /// <summary>The declaration of the engine's column <c>known</c> of the row state table.</summary>
    private const string KnownColumn = "known INTEGER NOT NULL DEFAULT 0";

    /// <summary>The declaration of the engine's column <c>sw_seq</c> of the row state table.</summary>
    private const string ServerWinsSequenceColumn = "sw_seq INTEGER NULL";

    /// <summary>The declaration of the engine's column <c>blob_owed</c> of the row state table.</summary>
    private const string BlobOwedColumn = "blob_owed TEXT NOT NULL DEFAULT ''";

    /// <summary>The declaration of the engine's column <c>applied_version</c> of the row state table.</summary>
    private const string AppliedVersionColumn = "applied_version BLOB NULL";

    /// <summary>The statement that creates the row state table when it is missing.</summary>
    /// <remarks>The key column has no declared type, so it keeps each key exactly as the synchronised table stores it.</remarks>
    private const string CreateRowTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_row ("
        + "table_name TEXT NOT NULL, "
        + "\"key\", "
        + "dirty INTEGER NOT NULL, "
        + "deleted INTEGER NOT NULL, "
        + "blob_columns TEXT NOT NULL DEFAULT '', "
        + "change_seq INTEGER NOT NULL, "
        + BaseVersionColumn
        + ", "
        + KnownColumn
        + ", "
        + ServerWinsSequenceColumn
        + ", "
        + BlobOwedColumn
        + ", "
        + AppliedVersionColumn
        + ", "
        + "PRIMARY KEY (table_name, \"key\"))";

    /// <summary>The statement that creates the anchor table (where each synchronised table's next download resumes) when it is missing.</summary>
    private const string CreateAnchorTableSql =
        "CREATE TABLE IF NOT EXISTS quicker_sync_table ("
        + "table_name TEXT NOT NULL PRIMARY KEY, "
        + "anchor BLOB NULL)";

    /// <summary>The columns an upsert into the row state table writes.</summary>
    private const string RowColumns =
        "quicker_sync_row (table_name, \"key\", dirty, deleted, blob_columns, change_seq)";

    /// <summary>The conflict target of an upsert into the row state table.</summary>
    private const string RowConflict = "ON CONFLICT (table_name, \"key\") DO UPDATE SET";

    /// <summary>The next change number, as an expression.</summary>
    private const string NextSequence = "(SELECT next_seq FROM quicker_sync_state)";

    /// <summary>The statement that moves the next change number on.</summary>
    private const string AdvanceSequence = "UPDATE quicker_sync_state SET next_seq = next_seq + 1";

    /// <summary>The characters a comparison of two trigger statements treats as white space.</summary>
    private static readonly char[] StatementWhiteSpace = [' ', '\t', '\r', '\n'];

    /// <summary>The triggers that record the changes of one synchronised table.</summary>
    /// <param name="table">The table.</param>
    /// <returns>The insert, update and delete triggers, then one trigger per unbounded binary column, in column order.</returns>
    public static IReadOnlyList<SyncLocalTrigger> TriggersFor(ISyncTableDescriptor table)
    {
        ArgumentNullException.ThrowIfNull(table);

        var accessorNames = table.UnboundedBinaryColumnNames;
        var columnNames = table.LocalUnboundedBinaryColumnNames;

        if (accessorNames.Count != columnNames.Count)
        {
            throw new ArgumentException(
                $"The table '{table.TableName}' names {accessorNames.Count.ToString(CultureInfo.InvariantCulture)} "
                    + $"unbounded binary columns but {columnNames.Count.ToString(CultureInfo.InvariantCulture)} "
                    + "database columns for them.",
                nameof(table)
            );
        }

        var tableText = Text(table.TableName);
        var newKey = "NEW." + Identifier(table.LocalKeyColumnName);
        var oldKey = "OLD." + Identifier(table.LocalKeyColumnName);
        var keyChanged = $"{oldKey} IS NOT {newKey}";

        var triggers = new List<SyncLocalTrigger>(3 + accessorNames.Count)
        {
            // An insert records the row with every excluded binary column, since the insert wrote them all.
            Create(
                table,
                "ai",
                "AFTER INSERT",
                $"INSERT INTO {RowColumns} VALUES ({tableText}, {newKey}, 1, 0, "
                    + $"{Text(string.Join(",", accessorNames))}, {NextSequence}) "
                    + $"{RowConflict} dirty = 1, deleted = 0, change_seq = excluded.change_seq, "
                    + "blob_columns = excluded.blob_columns; "
                    + $"{AdvanceSequence};"
            ),
            // An update records the row under its new key and, when the key changed, the old key as deleted.
            Create(
                table,
                "au",
                "AFTER UPDATE",
                $"INSERT INTO {RowColumns} VALUES ({tableText}, {newKey}, 1, 0, '', {NextSequence}) "
                    + $"{RowConflict} dirty = 1, deleted = 0, change_seq = excluded.change_seq; "
                    + $"{AdvanceSequence}; "
                    + $"INSERT INTO {RowColumns} SELECT {tableText}, {oldKey}, 1, 1, '', {NextSequence} "
                    + $"WHERE {keyChanged} "
                    + $"{RowConflict} dirty = 1, deleted = 1, change_seq = excluded.change_seq; "
                    + $"{AdvanceSequence} WHERE {keyChanged};"
            ),
            Create(
                table,
                "ad",
                "AFTER DELETE",
                $"INSERT INTO {RowColumns} VALUES ({tableText}, {oldKey}, 1, 1, '', {NextSequence}) "
                    + $"{RowConflict} dirty = 1, deleted = 1, change_seq = excluded.change_seq; "
                    + $"{AdvanceSequence};"
            ),
        };

        for (var index = 0; index < accessorNames.Count; index++)
        {
            var accessorName = accessorNames[index];

            // An update of an excluded binary column adds the column (by its accessor name) to the row's list, once.
            triggers.Add(
                Create(
                    table,
                    "b" + (index + 1).ToString(CultureInfo.InvariantCulture),
                    $"AFTER UPDATE OF {Identifier(columnNames[index])}",
                    $"INSERT INTO {RowColumns} VALUES ({tableText}, {newKey}, 1, 0, {Text(accessorName)}, {NextSequence}) "
                        + $"{RowConflict} dirty = 1, change_seq = excluded.change_seq, blob_columns = CASE "
                        + $"WHEN instr(',' || blob_columns || ',', {Text("," + accessorName + ",")}) > 0 THEN blob_columns "
                        + $"WHEN blob_columns = '' THEN {Text(accessorName)} "
                        + $"ELSE blob_columns || ',' || {Text(accessorName)} END; "
                        + $"{AdvanceSequence};"
                )
            );
        }

        return triggers;
    }

    /// <summary>
    /// Creates the state tables when they are missing, and brings the triggers of each table to the expected form.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tables">The synchronised tables.</param>
    /// <returns>The <see cref="ISyncTableDescriptor.TableName"/> of each table whose triggers were created or recreated.</returns>
    /// <remarks>
    /// <para>
    /// Everything runs in one immediate transaction. A table missing from the database is skipped. A table whose triggers
    /// already have the expected names and statements (compared with runs of white space folded to one space and a
    /// trailing semicolon dropped) is left as it is; for any other, every trigger whose name starts with
    /// <see cref="TriggerNamePrefix"/> is dropped and the expected ones are created. Triggers on tables outside
    /// <paramref name="tables"/> are not touched.
    /// </para>
    /// <para>
    /// Before replacing the triggers of a table, the key column and the excluded binary columns are looked up in the
    /// table. SQLite does not check the columns a trigger names when it creates the trigger, so a trigger naming a column
    /// the table does not have would be created without complaint and then make every write to the table fail; a
    /// missing column therefore rolls everything back and throws instead.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">The connection is not open, or a table lacks a column its triggers name.</exception>
    public static IReadOnlyList<string> Ensure(
        DbConnection connection,
        IReadOnlyList<ISyncTableDescriptor> tables
    )
    {
        ArgumentNullException.ThrowIfNull(connection);
        ArgumentNullException.ThrowIfNull(tables);

        if (connection.State != System.Data.ConnectionState.Open)
        {
            throw new InvalidOperationException(
                "The connection must be open before the change tracking is set up."
            );
        }

        return EnsureExpected(connection, Expect(tables), beforeCommit: null);
    }

    /// <summary>
    /// Runs writes that the change tracking does not record: what <paramref name="write"/> writes to the synchronised
    /// tables is not sent by a later synchronisation.
    /// </summary>
    /// <param name="connection">An open connection to the local database, outside any transaction.</param>
    /// <param name="write">
    /// The writes. It receives <paramref name="connection"/> and writes through it: with SQL, or with an
    /// <see cref="ILocalRowStore"/>.
    /// </param>
    /// <param name="cancellationToken">The cancellation token (passed on to <paramref name="write"/>).</param>
    /// <remarks>
    /// <para>
    /// Everything runs in one transaction on <paramref name="connection"/> that holds the write lock of the database from
    /// its first statement: the applying flag of <c>quicker_sync_state</c> is set, <paramref name="write"/> runs, the flag
    /// is cleared, and the transaction commits. The triggers record nothing while the flag is set, and what was recorded
    /// before (the rows still to be sent, the engine's columns, the change numbers) stays as it is. No other connection
    /// ever sees the flag set: until the commit it reads the database as it was, and its writes wait for the commit (as long
    /// as its busy timeout allows) and are recorded as usual.
    /// </para>
    /// <para>
    /// When <paramref name="write"/> throws or is cancelled, or the commit fails, the transaction is rolled back before the
    /// exception leaves: nothing that was written stays, and the connection is outside a transaction again. A pooled
    /// connection may therefore be passed. A connection from <see cref="ILocalRowStore.CreateDedicatedConnection"/> (not
    /// pooled) is the safer choice: should the rollback itself fail, closing it releases the write lock, whereas a pooled
    /// connection keeps the transaction and the lock until it is opened again through a
    /// <see cref="SyncLocalTrackingGuard"/> (which rolls the transaction back) or the pool discards it.
    /// </para>
    /// <para>
    /// Inside <paramref name="write"/>:
    /// </para>
    /// <list type="bullet">
    /// <item>Write only through the given connection. A generated repository or an <c>ISqlExecutor</c> opens a connection
    /// of its own, and a write through it waits for the lock this transaction holds until its busy timeout runs out.</item>
    /// <item>Do not begin, commit or roll back a transaction (a savepoint, started and ended with SQL, is fine), and do not
    /// close the connection.</item>
    /// <item>Do not call this method again, and do not run a synchronisation.</item>
    /// </list>
    /// <para>
    /// Foreign keys are checked as <paramref name="connection"/> is set to check them.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">
    /// The connection is not open or is already inside a transaction (nothing has been changed); the change tracking is not
    /// set up in the database; or <paramref name="write"/> closed the connection (nothing was committed, but a pooled
    /// connection keeps the transaction and the write lock until it is opened again through a
    /// <see cref="SyncLocalTrackingGuard"/> or the pool discards it).
    /// </exception>
    public static async Task WriteUntrackedAsync(
        DbConnection connection,
        Func<DbConnection, CancellationToken, Task> write,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(connection);
        ArgumentNullException.ThrowIfNull(write);

        if (connection.State != System.Data.ConnectionState.Open)
        {
            throw new InvalidOperationException(
                "The connection must be open before an untracked write runs."
            );
        }

        try
        {
            // A deferred BEGIN takes no lock and waits for nothing: it fails only when the connection is already inside a
            // transaction. The first statement after it takes the write lock
            await SyncState.ExecuteAsync(connection, "BEGIN", cancellationToken).ConfigureAwait(false);
        }
        catch (DbException exception)
        {
            throw new InvalidOperationException(
                "An untracked write could not start its transaction: the connection is already inside a transaction. "
                    + "Pass a connection that is outside any transaction; an untracked write cannot run inside another "
                    + "one, and the writes it runs must not begin a transaction of their own.",
                exception
            );
        }

        try
        {
            // Takes the write lock (waiting for another writer as long as the connection's busy timeout allows). A flag
            // found set here was left by a write that committed without clearing it: no writer is in the middle of
            // anything while this transaction holds the lock, so it is simply set and cleared again
            if (await SyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false) != 1)
            {
                throw new InvalidOperationException(
                    "The change tracking is not set up in this database (" + StateTableName + " has no row). "
                        + "Call SyncLocalTracking.Ensure before an untracked write."
                );
            }

            await write(connection, cancellationToken).ConfigureAwait(false);

            if (connection.State != System.Data.ConnectionState.Open)
            {
                throw new InvalidOperationException(
                    "The writes of an untracked write closed the connection they were given. Nothing was committed, but "
                        + "the transaction could not be rolled back: a pooled connection keeps it, together with the "
                        + "write lock of the database, until it is opened again through a SyncLocalTrackingGuard or the "
                        + "pool discards it. Do not close the connection inside the writes."
                );
            }

            // What is left only tidies up after writes that have run: it is not cancelled half way
            await SyncState.SetApplyingAsync(connection, false, CancellationToken.None).ConfigureAwait(false);
            await SyncState.ExecuteAsync(connection, "COMMIT", CancellationToken.None).ConfigureAwait(false);
        }
        catch
        {
            if (connection.State == System.Data.ConnectionState.Open)
            {
                try
                {
                    await SyncState.ExecuteAsync(connection, "ROLLBACK", CancellationToken.None).ConfigureAwait(false);
                }
                catch (DbException)
                {
                    // The rollback failing must not hide what went wrong first
                }
            }

            throw;
        }
    }

    /// <summary>Builds the expected triggers of every table, refusing a table that cannot be tracked before anything changes.</summary>
    /// <param name="tables">The synchronised tables.</param>
    /// <returns>Each table with its expected triggers, in the order of <paramref name="tables"/>.</returns>
    internal static IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> Expect(
        IReadOnlyList<ISyncTableDescriptor> tables
    )
    {
        ArgumentNullException.ThrowIfNull(tables);

        var expected = new List<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)>(
            tables.Count
        );

        foreach (var table in tables)
        {
            ArgumentNullException.ThrowIfNull(table, nameof(tables));
            expected.Add((table, TriggersFor(table)));
        }

        return expected;
    }

    /// <summary>
    /// The SHA-256 (hexadecimal) of the expected definition: the statements that create the state tables, then the name
    /// and statement of every trigger of every table, in order.
    /// </summary>
    /// <param name="expected">The tables with their expected triggers (see <see cref="Expect"/>).</param>
    internal static string DefinitionHash(
        IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> expected
    )
    {
        var definition = new System.Text.StringBuilder();
        definition.Append(CreateStateTableSql).Append('\n');
        definition.Append(CreateRowTableSql).Append('\n');
        definition.Append(CreateAnchorTableSql).Append('\n');
        definition.Append(SeedStateSql).Append('\n');

        foreach (var (_, triggers) in expected)
        {
            foreach (var trigger in triggers)
            {
                definition.Append(trigger.Name).Append('\n').Append(trigger.Sql).Append('\n');
            }
        }

        return Convert.ToHexString(
            System.Security.Cryptography.SHA256.HashData(
                System.Text.Encoding.UTF8.GetBytes(definition.ToString())
            )
        );
    }

    /// <summary>
    /// Whether the database already has everything <see cref="Ensure"/> would set up: the three state tables, the one row
    /// of the state table, and the expected triggers on each table the database has. It only reads.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="expected">The tables with their expected triggers (see <see cref="Expect"/>).</param>
    internal static bool HasExpectedState(
        DbConnection connection,
        IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> expected
    )
    {
        if (
            !TableExists(connection, StateTableName)
            || !TableExists(connection, RowTableName)
            || !TableExists(connection, AnchorTableName)
        )
        {
            return false;
        }

        using (var command = connection.CreateCommand())
        {
            command.CommandText = "SELECT count(*) FROM quicker_sync_state WHERE id = 1";

            if (Convert.ToInt64(command.ExecuteScalar(), CultureInfo.InvariantCulture) == 0)
            {
                return false;
            }
        }

        foreach (var (table, triggers) in expected)
        {
            if (CurrentTriggersIfDifferent(connection, table, triggers) is not null)
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>
    /// The body of <see cref="Ensure"/>: in one immediate transaction, creates the state tables when they are missing and
    /// brings the triggers of each table to the expected form.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="expected">The tables with their expected triggers (see <see cref="Expect"/>).</param>
    /// <param name="beforeCommit">Runs inside the transaction after everything is in place and before it commits (null = nothing).</param>
    /// <returns>The <see cref="ISyncTableDescriptor.TableName"/> of each table whose triggers were created or recreated.</returns>
    internal static IReadOnlyList<string> EnsureExpected(
        DbConnection connection,
        IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> expected,
        Action<DbConnection>? beforeCommit
    )
    {
        Execute(connection, "BEGIN IMMEDIATE");

        try
        {
            Execute(connection, CreateStateTableSql);
            Execute(connection, CreateRowTableSql);
            Execute(connection, CreateAnchorTableSql);
            Execute(connection, SeedStateSql);

            var changed = new List<string>();

            foreach (var (table, triggers) in expected)
            {
                var current = CurrentTriggersIfDifferent(connection, table, triggers);

                if (current is null)
                {
                    continue;
                }

                var missing = MissingColumns(connection, table);

                if (missing.Count > 0)
                {
                    throw new InvalidOperationException(
                        $"The change tracking of the table '{table.TableName}' cannot be set up: the local table "
                            + $"'{table.LocalTableName}' has no column "
                            + string.Join(", ", missing.Select(column => $"'{column}'"))
                            + ". Make the column names of the diagram and of the database agree, then generate "
                            + "the code again."
                    );
                }

                foreach (var name in current.Keys)
                {
                    Execute(connection, "DROP TRIGGER " + Identifier(name));
                }

                foreach (var trigger in triggers)
                {
                    Execute(connection, trigger.Sql);
                }

                changed.Add(table.TableName);
            }

            beforeCommit?.Invoke(connection);
            Execute(connection, "COMMIT");
            return changed;
        }
        catch
        {
            try
            {
                Execute(connection, "ROLLBACK");
            }
            catch (DbException)
            {
                // The rollback failing must not hide what went wrong first
            }

            throw;
        }
    }

    /// <summary>Builds one trigger of a table.</summary>
    /// <param name="table">The table.</param>
    /// <param name="suffix">What follows the table name in the trigger name.</param>
    /// <param name="timing">When the trigger fires (for example <c>AFTER INSERT</c>).</param>
    /// <param name="body">The statements of the trigger, each ending with a semicolon.</param>
    private static SyncLocalTrigger Create(
        ISyncTableDescriptor table,
        string suffix,
        string timing,
        string body
    )
    {
        var escapedTable = EscapeIdentifier(table.LocalTableName);

        return new SyncLocalTrigger(
            TriggerNamePrefix + table.LocalTableName + "_" + suffix,
            table.LocalTableName,
            $"CREATE TRIGGER \"quicker_sync_trg_{escapedTable}_{suffix}\" {timing} ON \"{escapedTable}\" "
                + "WHEN (SELECT applying FROM quicker_sync_state) = 0 "
                + $"BEGIN {body} END"
        );
    }

    /// <summary>The triggers of a table, when the table is in the database and its triggers are not the expected ones.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="table">The table.</param>
    /// <param name="expected">The table's expected triggers.</param>
    /// <returns>
    /// The table's triggers whose names start with the prefix, by name; null when the database has no such table or its
    /// triggers are already the expected ones.
    /// </returns>
    private static Dictionary<string, string>? CurrentTriggersIfDifferent(
        DbConnection connection,
        ISyncTableDescriptor table,
        IReadOnlyList<SyncLocalTrigger> expected
    )
    {
        if (!TableExists(connection, table.LocalTableName))
        {
            return null;
        }

        var current = ReadTriggers(connection, table.LocalTableName);

        return HasExpectedTriggers(current, expected) ? null : current;
    }

    /// <summary>Whether the triggers a table has are exactly the expected ones.</summary>
    /// <param name="current">The table's triggers whose names start with the prefix, by name.</param>
    /// <param name="expected">The expected triggers.</param>
    private static bool HasExpectedTriggers(
        IReadOnlyDictionary<string, string> current,
        IReadOnlyList<SyncLocalTrigger> expected
    )
    {
        if (current.Count != expected.Count)
        {
            return false;
        }

        foreach (var trigger in expected)
        {
            if (
                !current.TryGetValue(trigger.Name, out var sql)
                || !string.Equals(NormalizeStatement(sql), NormalizeStatement(trigger.Sql), StringComparison.Ordinal)
            )
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>A statement with every run of white space folded to one space, and a trailing semicolon and the white space around it dropped.</summary>
    /// <param name="sql">The statement.</param>
    private static string NormalizeStatement(string sql) =>
        string.Join(' ', sql.Split(StatementWhiteSpace, StringSplitOptions.RemoveEmptyEntries))
            .TrimEnd(';')
            .Trim();

    /// <summary>Whether the main database has the table (the name compared ignoring case).</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="tableName">The table name, unquoted.</param>
    private static bool TableExists(DbConnection connection, string tableName)
    {
        using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = @table COLLATE NOCASE";
        AddParameter(command, "@table", tableName);

        return Convert.ToInt64(command.ExecuteScalar(), CultureInfo.InvariantCulture) > 0;
    }

    /// <summary>The triggers on a table whose names start with <see cref="TriggerNamePrefix"/>, with their statements.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="tableName">The table name, unquoted (compared ignoring case).</param>
    /// <returns>The statements by trigger name (names compared ignoring case).</returns>
    private static Dictionary<string, string> ReadTriggers(DbConnection connection, string tableName)
    {
        var triggers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT name, sql FROM sqlite_master WHERE type = 'trigger' AND tbl_name = @table COLLATE NOCASE";
        AddParameter(command, "@table", tableName);

        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            var name = reader.GetString(0);

            // The prefix is compared here rather than with LIKE, where its underscores would match any character
            if (!name.StartsWith(TriggerNamePrefix, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            triggers[name] = reader.IsDBNull(1) ? string.Empty : reader.GetString(1);
        }

        return triggers;
    }

    /// <summary>The columns the triggers of a table name that the table does not have (the key column first).</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="table">The table.</param>
    private static List<string> MissingColumns(DbConnection connection, ISyncTableDescriptor table)
    {
        var present = ColumnNames(connection, table.LocalTableName);

        return new[] { table.LocalKeyColumnName }
            .Concat(table.LocalUnboundedBinaryColumnNames)
            .Where(column => !present.Contains(column))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>The column names of a table of the main database (compared ignoring case).</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="tableName">The table name, unquoted.</param>
    private static HashSet<string> ColumnNames(DbConnection connection, string tableName)
    {
        var present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        using var command = connection.CreateCommand();
        command.CommandText = "SELECT name FROM pragma_table_info(@table, 'main')";
        AddParameter(command, "@table", tableName);

        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            present.Add(reader.GetString(0));
        }

        return present;
    }

    /// <summary>Runs one statement that returns no rows.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="sql">One statement (never several, so none of them can be left unrun).</param>
    private static void Execute(DbConnection connection, string sql)
    {
        using var command = connection.CreateCommand();
        command.CommandText = sql;
        command.ExecuteNonQuery();
    }

    /// <summary>Adds a text parameter to a command.</summary>
    private static void AddParameter(DbCommand command, string name, string value)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.Value = value;
        command.Parameters.Add(parameter);
    }

    /// <summary>A name quoted as an SQLite identifier.</summary>
    private static string Identifier(string name) => "\"" + EscapeIdentifier(name) + "\"";

    /// <summary>A name with its double quotes doubled, ready to go between double quotes.</summary>
    private static string EscapeIdentifier(string name) =>
        name.Replace("\"", "\"\"", StringComparison.Ordinal);

    /// <summary>A value written as an SQL string literal.</summary>
    private static string Text(string value) =>
        "'" + value.Replace("'", "''", StringComparison.Ordinal) + "'";
}

/// <summary>
/// Checks, every time a connection to the local database opens, that the change tracking of
/// <see cref="SyncLocalTracking"/> is in place, and puts it back when it is not.
/// </summary>
/// <remarks>
/// <para>
/// The check costs one statement in the usual case: it reads the database's schema version together with the identifier
/// in <c>quicker_sync_state</c>, and stops when the pair is the one remembered after the last full check of the same
/// database file. Any change to the schema (a dropped trigger, an unrelated table) moves the schema version on, and a
/// different file at the same path has a different identifier, so either leads to the full check.
/// </para>
/// <para>
/// The full check runs in a read transaction and writes nothing, so a read-only connection passes it when everything is
/// in place. Only when something is missing or different does it take the write lock and do what
/// <see cref="SyncLocalTracking.Ensure"/> does.
/// </para>
/// <para>
/// The remembered pairs are kept for the whole process, by database file and by the expected definition (the state tables
/// and every trigger of the given tables), so guards made per scope share them, and two registrations with different sets
/// of tables over the same file do not take each other's result. An in-memory database (an empty
/// <see cref="DbConnection.DataSource"/> once open) is never remembered and gets the full check every time.
/// </para>
/// <para>
/// When the full check or the repair fails, the connection is closed before the exception leaves, so a connection whose
/// tracking could not be confirmed is never handed on open, and nothing is remembered: the next connection that opens
/// checks again.
/// </para>
/// <para>
/// The check also clears an applying flag that was left set. The engine and
/// <see cref="SyncLocalTracking.WriteUntrackedAsync"/> set and clear the flag inside one transaction, and no other
/// connection sees the flag of a transaction still open. A connection that has just opened therefore sees it set in two
/// cases only. A write committed without clearing it (the writes of an untracked write committed the transaction
/// themselves, or something outside set it): while it stayed set nothing was recorded, and those writes are not
/// recovered; clearing it makes the following ones recorded again. Or the connection is a pooled one that was closed in
/// the middle of such a transaction (the writes of an untracked write closed it, or its rollback failed): the check rolls
/// that transaction back, which also releases the write lock it held. The flag is read together with the pair, so the
/// usual case still costs one statement; clearing a committed flag needs the write lock, and fails like the repair does.
/// </para>
/// </remarks>
public sealed class SyncLocalTrackingGuard
{
    /// <summary>The pair read from the database after its last successful full check, by database file and definition.</summary>
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<
        (string DataSource, string DefinitionHash),
        (long SchemaVersion, string DatabaseId)
    > Confirmed = new();

    /// <summary>The statement that reads the schema version, the database identifier and the applying flag together.</summary>
    private const string ReadPairSql =
        "SELECT (SELECT schema_version FROM pragma_schema_version), (SELECT db_id FROM quicker_sync_state), "
        + "(SELECT applying FROM quicker_sync_state)";

    /// <summary>The statement that clears an applying flag left set in the database.</summary>
    private const string ClearLeftoverFlagSql = "UPDATE quicker_sync_state SET applying = 0 WHERE applying <> 0";

    /// <summary>The tables with their expected triggers.</summary>
    private readonly IReadOnlyList<(ISyncTableDescriptor Table, IReadOnlyList<SyncLocalTrigger> Triggers)> _expected;

    /// <summary>The SHA-256 of the expected definition (see <see cref="SyncLocalTracking.DefinitionHash"/>).</summary>
    private readonly string _definitionHash;

    /// <summary>How many times this guard has run the full check.</summary>
    private int _fullCheckCount;

    /// <summary>How many times this guard has run the repair.</summary>
    private int _repairCount;

    /// <summary>Creates the guard for the given synchronised tables.</summary>
    /// <param name="tables">The synchronised tables.</param>
    public SyncLocalTrackingGuard(IReadOnlyList<ISyncTableDescriptor> tables)
    {
        _expected = SyncLocalTracking.Expect(tables);
        _definitionHash = SyncLocalTracking.DefinitionHash(_expected);
    }

    /// <summary>How many times this guard has run the full check (for diagnostics).</summary>
    internal int FullCheckCount => Volatile.Read(ref _fullCheckCount);

    /// <summary>How many times this guard has run the repair (for diagnostics).</summary>
    internal int RepairCount => Volatile.Read(ref _repairCount);

    /// <summary>
    /// The handler to add to a connection's <see cref="DbConnection.StateChange"/>: it runs <see cref="Check"/> when the
    /// connection has just opened.
    /// </summary>
    /// <param name="sender">The connection.</param>
    /// <param name="e">The state change.</param>
    public void OnStateChange(object? sender, System.Data.StateChangeEventArgs e)
    {
        ArgumentNullException.ThrowIfNull(e);

        if (
            e.CurrentState != System.Data.ConnectionState.Open
            || e.OriginalState == System.Data.ConnectionState.Open
        )
        {
            return;
        }

        Check((DbConnection)sender!);
    }

    /// <summary>Checks the change tracking on a connection that has just opened, and puts it back when it is not in place.</summary>
    /// <param name="connection">An open connection to the local database, outside any transaction.</param>
    /// <exception cref="InvalidOperationException">
    /// The change tracking could not be confirmed or put back (the connection has been closed): a table lacks a column its
    /// triggers name, or the database refused the check, the repair or the clearing of an applying flag left set (the
    /// original error is the inner exception).
    /// </exception>
    public void Check(DbConnection connection)
    {
        ArgumentNullException.ThrowIfNull(connection);

        var source = connection.DataSource;
        (string DataSource, string DefinitionHash)? key = string.IsNullOrEmpty(source)
            ? null
            : (source, _definitionHash);

        var inPlace = false;
        var flagLeftSet = false;

        if (key is { } known && Confirmed.TryGetValue(known, out var remembered))
        {
            try
            {
                var read = ReadPair(connection);
                inPlace = (read.SchemaVersion, read.DatabaseId) == remembered;
                flagLeftSet = read.Applying;
            }
            catch (DbException)
            {
                // The state table is gone (or cannot be read): the full check finds out what is missing
            }
        }

        var doing = "checked";

        try
        {
            if (!inPlace)
            {
                Interlocked.Increment(ref _fullCheckCount);

                if (ConfirmWithoutWriting(connection) is { } confirmed)
                {
                    Remember(key, (confirmed.SchemaVersion, confirmed.DatabaseId));
                    flagLeftSet = confirmed.Applying;
                }
                else
                {
                    doing = "put in place";
                    Interlocked.Increment(ref _repairCount);

                    (long SchemaVersion, string? DatabaseId, bool Applying) repaired = default;
                    SyncLocalTracking.EnsureExpected(
                        connection,
                        _expected,
                        beforeCommit: inside => repaired = ReadPair(inside)
                    );
                    Remember(key, (repaired.SchemaVersion, repaired.DatabaseId));
                    flagLeftSet = repaired.Applying;
                }
            }

            if (flagLeftSet)
            {
                // A connection that has just opened sees the flag set in two cases. Either a write committed without
                // clearing it, and nothing clears it any more. Or this is a pooled connection that was closed in the middle
                // of a transaction (the writes of an untracked write closed it, or its rollback failed): the flag belongs
                // to that transaction, which still holds the write lock. Rolling back ends such a transaction; when there
                // is none, the rollback fails and changes nothing
                doing = "cleared of the applying flag an earlier write left set";

                try
                {
                    Execute(connection, "ROLLBACK");
                }
                catch (DbException)
                {
                    // No transaction was left open on the connection
                }

                if (ReadPair(connection).Applying)
                {
                    Execute(connection, ClearLeftoverFlagSql);
                }
            }
        }
        catch (DbException exception)
        {
            CloseQuietly(connection);

            throw new InvalidOperationException(
                $"The change tracking of the local database '{source}' could not be "
                    + doing
                    + $": {exception.Message} The connection has been closed. The next connection that opens checks "
                    + "again; if another writer held the database, open the connection again once it has finished. If "
                    + "the database was opened read-only, open it once with a connection that can write, so that the "
                    + "change tracking can be put in place.",
                exception
            );
        }
        catch
        {
            CloseQuietly(connection);
            throw;
        }
    }

    /// <summary>
    /// The full check that only reads: in one read transaction, the schema version first, then whether everything is in
    /// place, then the database identifier and the applying flag.
    /// </summary>
    /// <param name="connection">The connection.</param>
    /// <returns>The pair to remember with the applying flag, or null when something is missing or different.</returns>
    private (long SchemaVersion, string? DatabaseId, bool Applying)? ConfirmWithoutWriting(DbConnection connection)
    {
        Execute(connection, "BEGIN");

        try
        {
            // The first read fixes the snapshot, so the version read here belongs to the state checked next
            long schemaVersion;

            using (var command = connection.CreateCommand())
            {
                command.CommandText = "PRAGMA schema_version";
                schemaVersion = Convert.ToInt64(command.ExecuteScalar(), CultureInfo.InvariantCulture);
            }

            (long, string?, bool)? confirmed = null;

            if (SyncLocalTracking.HasExpectedState(connection, _expected))
            {
                var pair = ReadPair(connection);
                confirmed = (schemaVersion, pair.DatabaseId, pair.Applying);
            }

            Execute(connection, "COMMIT");
            return confirmed;
        }
        catch
        {
            try
            {
                Execute(connection, "ROLLBACK");
            }
            catch (DbException)
            {
                // The rollback failing must not hide what went wrong first
            }

            throw;
        }
    }

    /// <summary>Remembers the pair confirmed for a database file (nothing for an in-memory database or a missing identifier).</summary>
    private static void Remember(
        (string DataSource, string DefinitionHash)? key,
        (long SchemaVersion, string? DatabaseId) pair
    )
    {
        if (key is { } known && pair.DatabaseId is not null)
        {
            Confirmed[known] = (pair.SchemaVersion, pair.DatabaseId);
        }
    }

    /// <summary>
    /// Reads the schema version, the database identifier (null when the state table has no row) and whether the applying
    /// flag is set.
    /// </summary>
    private static (long SchemaVersion, string? DatabaseId, bool Applying) ReadPair(DbConnection connection)
    {
        using var command = connection.CreateCommand();
        command.CommandText = ReadPairSql;

        using var reader = command.ExecuteReader();

        if (!reader.Read())
        {
            return (-1, null, false);
        }

        return (
            Convert.ToInt64(reader.GetValue(0), CultureInfo.InvariantCulture),
            reader.IsDBNull(1) ? null : reader.GetString(1),
            !reader.IsDBNull(2) && Convert.ToInt64(reader.GetValue(2), CultureInfo.InvariantCulture) != 0
        );
    }

    /// <summary>Closes the connection, keeping a failure to close from hiding what went wrong first.</summary>
    private static void CloseQuietly(DbConnection connection)
    {
        try
        {
            connection.Close();
        }
        catch (DbException)
        {
            // The error that led here is the one to report
        }
    }

    /// <summary>Runs one statement that returns no rows.</summary>
    private static void Execute(DbConnection connection, string sql)
    {
        using var command = connection.CreateCommand();
        command.CommandText = sql;
        command.ExecuteNonQuery();
    }
}

/// <summary>One synchronised table's descriptor, with the entity's types erased.</summary>
public interface ISyncTableDescriptor
{
    /// <summary>The table name, as the sync state and the conflicts name it.</summary>
    string TableName { get; }

    /// <summary>The CLR entity type the table synchronises.</summary>
    Type EntityType { get; }

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (what an inserted row is recorded as storing).</summary>
    IReadOnlyList<string> UnboundedBinaryColumnNames => [];

    /// <summary>
    /// The name of the local (SQLite) table, unquoted: what <c>sqlite_master.tbl_name</c> holds for it. A synchronised
    /// table always lives in the main database; a table whose name has a schema part is left out of synchronisation when
    /// the code is generated.
    /// </summary>
    string LocalTableName { get; }

    /// <summary>The database column name of the primary key, unquoted.</summary>
    string LocalKeyColumnName { get; }

    /// <summary>
    /// The database column names of <see cref="UnboundedBinaryColumnNames"/>, unquoted, in the same order and of the same
    /// count (those are the accessor names; these are the columns of the local table).
    /// </summary>
    IReadOnlyList<string> LocalUnboundedBinaryColumnNames => [];
}

/// <summary>
/// Everything about one synchronised table that depends on the diagram: its name, the SQL that carries its identity, and
/// how the key and the mirrored version are read off an entity and written back.
/// </summary>
/// <remarks>
/// <para>
/// This is the whole of what the generator emits per table. The behaviour - batching, resume points, delete
/// propagation, sending a local change - lives once in the fixed classes that take a descriptor
/// (<see cref="SyncTable{TEntity, TKey}"/>,
/// <see cref="DirectSyncSource{TEntity, TKey}"/> and its versionless counterpart), so a table contributes data rather
/// than a class of its own.
/// </para>
/// <para>
/// The SQL is text baked in at generation time rather than assembled at run time: the two dialects a sync setup spans
/// (SQL Server for the server, SQLite for the local database) quote differently, and the generator is where both are
/// known.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncTableDescriptor<TEntity, TKey> : ISyncTableDescriptor
    where TEntity : EntityBaseCore, new()
{
    /// <inheritdoc />
    public required string TableName { get; init; }

    /// <summary>The remote endpoint route of the entity (for example "SyncOrder").</summary>
    public required string RemoteRouteName { get; init; }

    /// <summary>
    /// Whether the table has no version column - synchronised only by <see cref="SyncMode.LastWriteWins"/> runs,
    /// downloaded as a full key-ordered scan, and uploaded without version guards.
    /// </summary>
    public required bool IsVersionless { get; init; }

    /// <inheritdoc />
    public Type EntityType => typeof(TEntity);

    /// <summary>Reads the entity's primary key.</summary>
    public required Func<TEntity, TKey> ReadKey { get; init; }

    /// <summary>Writes the entity's primary key (used to build the stub a version-guarded delete is sent as).</summary>
    public required Action<TEntity, TKey> WriteKey { get; init; }

    /// <summary>Renders a primary key into its text form.</summary>
    public required Func<TKey, string> FormatKey { get; init; }

    /// <summary>Parses a primary key back out of its text form.</summary>
    public required Func<string, TKey> ParseKey { get; init; }

    /// <summary>Reads the mirrored server version off the entity.</summary>
    /// <remarks>
    /// The default answers null, which is what a table without a version column has to say.
    /// </remarks>
    public Func<TEntity, byte[]?> ReadRowVersion { get; init; } = static _ => null;

    /// <summary>Writes the mirrored server version onto the entity.</summary>
    /// <remarks>The default does nothing, and is never reached: only a versioned table writes a mirrored version.</remarks>
    public Action<TEntity, byte[]?> WriteRowVersion { get; init; } = static (_, _) => { };

    /// <summary>SELECT that returns every primary key of the server table (SQL Server quoting).</summary>
    public required string ServerKeysSql { get; init; }

    /// <summary>SELECT that returns one ascending batch of server rows above the anchor and below the ceiling (versioned tables).</summary>
    public string ServerChangesSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the first ascending batch of server rows by primary key (versionless tables).</summary>
    public string ServerPageFirstSql { get; init; } = string.Empty;

    /// <summary>SELECT that returns the next ascending batch of server rows above a key (versionless tables).</summary>
    public string ServerPageAfterSql { get; init; } = string.Empty;

    /// <summary>The unbounded binary columns the ordinary row transfer leaves out (empty when the table has none).</summary>
    public IReadOnlyList<string> UnboundedBinaryColumnNames { get; init; } = [];

    /// <inheritdoc />
    public required string LocalTableName { get; init; }

    /// <inheritdoc />
    public required string LocalKeyColumnName { get; init; }

    /// <inheritdoc />
    public IReadOnlyList<string> LocalUnboundedBinaryColumnNames { get; init; } = [];

    /// <summary>The repository accessors for those columns, by column name (empty when the table has none).</summary>
    public IReadOnlyDictionary<string, SyncBinaryColumnAccessor<TKey>> UnboundedBinaryAccessors
    {
        get;
        init;
    } = new Dictionary<string, SyncBinaryColumnAccessor<TKey>>(StringComparer.Ordinal);

    /// <summary>The foreign keys of this table that point at the primary key of another synchronised table (or of itself).</summary>
    /// <remarks>
    /// A single-column foreign key to a synchronised table's primary key is listed; one that refers to a unique
    /// constraint, or spans several columns, is not, because the parent's key cannot be read off the row. The engine
    /// uses them to keep the parents of the rows the delete propagation keeps, to stop a download at a row whose parent
    /// is deleted locally and not yet sent, and to tell a write the server refused for a missing parent.
    /// </remarks>
    public IReadOnlyList<SyncParentReference<TEntity>> ParentReferences { get; init; } = [];

    /// <summary>Gives every NOT NULL unbounded binary column that holds nothing an empty value, before a row is inserted.</summary>
    /// <remarks>
    /// A row read for a sync run arrives without these columns, and a value-object column left unread is null - which a
    /// NOT NULL column refuses when the engine inserts the row locally. The empty value is what the column holds until
    /// the blob is copied, which is the same thing a row new to this side holds when the run does not carry the blobs.
    /// The default does nothing: a table without such a column has nothing to fill.
    /// </remarks>
    public Action<TEntity> FillUnsetUnboundedBinaries { get; init; } = static _ => { };

    /// <summary>The tables of the diagram that refer to this one through a foreign key <see cref="LocalReferences"/> does not list.</summary>
    /// <remarks>
    /// A foreign key that refers to a unique constraint of this table, or spans several columns, cannot be asked which
    /// rows it refers to. A refresh that rebuilds this table and leaves such a table out refuses to run whenever the local
    /// database has that table, without looking at its rows.
    /// </remarks>
    public IReadOnlyList<string> UnlistedReferencingTableNames { get; init; } = [];

    /// <summary>The foreign keys of the diagram that point at this table's primary key, one per referring column.</summary>
    /// <remarks>
    /// Every referring table of the diagram is listed, synchronised or not, and this table itself when it refers to its
    /// own rows: the delete propagation removes only the rows nothing local refers to. A referring table the local
    /// database does not have is skipped, since it holds no rows to refer with. A foreign key that refers to a unique
    /// constraint, or spans several columns, is not listed.
    /// </remarks>
    public IReadOnlyList<SyncLocalReference> LocalReferences { get; init; } = [];
}

/// <summary>
/// One side's unbounded binary columns, reached by column name through the repository that owns them.
/// </summary>
/// <remarks>
/// The directly connected server's side: the direct server source reaches the server's columns through the server's
/// generated repository. The local side does not use this class; the engine reads and writes the local columns through
/// <see cref="ILocalRowStore"/>. A column outside the descriptor's list is rejected rather than ignored, for the reason
/// <see cref="ISyncBinaryColumns{TKey}"/> gives.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncRepositoryBinaryColumns<TEntity, TKey> : ISyncBinaryColumns<TKey>
    where TEntity : EntityBaseCore, new()
{
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;
    private readonly object _repository;

    /// <summary>Creates the surface over the table's descriptor and the repository the columns are stored in.</summary>
    /// <param name="descriptor">The table's descriptor, which names the columns and holds their accessors.</param>
    /// <param name="repository">The generated repository instance the accessors are invoked on.</param>
    public SyncRepositoryBinaryColumns(
        SyncTableDescriptor<TEntity, TKey> descriptor,
        object repository
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(repository);
        _descriptor = descriptor;
        _repository = repository;
    }

    /// <inheritdoc />
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <inheritdoc />
    public Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    ) => Accessor(columnName).Read(_repository, id, destination, cancellationToken);

    /// <inheritdoc />
    public Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    ) => Accessor(columnName).Write(_repository, id, source, length, cancellationToken);

    /// <summary>Looks the accessors of one column up, refusing a name the table does not have.</summary>
    private SyncBinaryColumnAccessor<TKey> Accessor(string columnName) =>
        _descriptor.UnboundedBinaryAccessors.TryGetValue(columnName, out var accessor)
            ? accessor
            : throw new ArgumentOutOfRangeException(
                nameof(columnName),
                columnName,
                "The column is not an unbounded binary column of this table."
            );
}

/// <summary>
/// The server side of the differential source for one entity type: where changed rows, the change ceiling, and the key
/// set come from, and which repository the local changes are replayed against.
/// </summary>
/// <remarks>
/// The engine never talks to the server directly, so a second implementation (over HTTP, say) can replace the direct
/// one without the engine changing. The generated direct implementation reads through the server's raw SQL surface and
/// writes through the server's ordinary repository.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public interface ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>
    /// Gets the exclusive upper bound for this pass: the lowest version of any transaction still in flight.
    /// </summary>
    /// <remarks>
    /// A row committed later can carry a lower version than one committed earlier, so reading up to "the current
    /// maximum" would step over rows that are still uncommitted and never come back for them. Stopping below the
    /// oldest active transaction is what makes the stored resume point safe to resume from.
    /// </remarks>
    Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default);

    /// <summary>Gets the rows whose version is above <paramref name="anchor"/> and below <paramref name="ceiling"/>, in ascending version order.</summary>
    /// <param name="anchor">The resume point (null on the first pass, which takes everything below the ceiling).</param>
    /// <param name="ceiling">The exclusive upper bound from <see cref="GetChangeCeilingAsync"/>.</param>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    );

    /// <summary>Gets the first batch of rows in ascending primary-key order (the versionless full scan).</summary>
    /// <remarks>
    /// A table without a version column has no change stream to resume, so its download reads every row, paged by the
    /// primary key. The default refuses rather than answers: a source written for a versioned table has no key-ordered
    /// SQL to serve it with, and only the generated versionless sources override it.
    /// </remarks>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <summary>Gets the next batch of rows whose primary key is above <paramref name="afterKey"/>, in ascending key order.</summary>
    /// <param name="afterKey">The last key of the previous batch (the exclusive lower bound).</param>
    /// <param name="batchSize">The maximum number of rows to return.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <summary>Gets every primary key the server holds for this table (the input to delete propagation).</summary>
    Task<IReadOnlyList<TKey>> GetAllKeysAsync(CancellationToken cancellationToken = default);

    /// <summary>The repository the local changes are replayed against.</summary>
    /// <remarks>
    /// The remote surface rather than the full one: sending a local change only ever reads a row by key, inserts,
    /// updates, saves, or deletes it, and those are exactly the operations that can cross a network boundary. Asking for
    /// no more than that is what lets an HTTP client stand here beside a direct repository, which satisfies the narrower
    /// contract as well.
    /// </remarks>
    IRemoteRepositoryCore<TEntity, TKey> Writer { get; }

    /// <summary>The server's unbounded binary columns, or null when the table has none to copy.</summary>
    /// <remarks>
    /// Null is the answer for every table generated without the unbounded binary columns excluded, which is why it is
    /// the default: a source written before there was anything to copy still satisfies the contract, and a run that asks
    /// for the columns simply finds none.
    /// </remarks>
    ISyncBinaryColumns<TKey>? BinaryColumns => null;
}

/// <summary>
/// Generic core of the direct (same-process database connection) server source: the key set and the change stream
/// come through the server's raw SQL surface, and the local changes are replayed through the server's ordinary
/// repository. What stays with the generated derived class is only the SQL text, which carries the table's identity.
/// </summary>
/// <remarks>
/// The paging members are virtual here rather than left to the interface's default implementations on purpose:
/// interface mapping is fixed at the class that lists the interface - this one - so a member a derived class adds later
/// would never be reached through the interface. A virtual with the same default keeps the dispatch open for the
/// versionless subclass, which does override them.
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public abstract class DirectSyncSourceBase<TEntity, TKey> : ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    protected DirectSyncSourceBase(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
    {
        ArgumentNullException.ThrowIfNull(serverSqlExecutor);
        ArgumentNullException.ThrowIfNull(writer);
        ArgumentNullException.ThrowIfNull(descriptor);
        ServerSqlExecutor = serverSqlExecutor;
        Writer = writer;
        Descriptor = descriptor;
        BinaryColumns =
            descriptor.UnboundedBinaryColumnNames.Count == 0
                ? null
                : new SyncRepositoryBinaryColumns<TEntity, TKey>(descriptor, writer);
    }

    /// <summary>Gets the server's raw SQL surface the scans read through.</summary>
    protected ISqlExecutor ServerSqlExecutor { get; }

    /// <summary>Gets the table's descriptor (the SQL text that carries the table's identity).</summary>
    protected SyncTableDescriptor<TEntity, TKey> Descriptor { get; }

    /// <inheritdoc />
    public IRemoteRepositoryCore<TEntity, TKey> Writer { get; }

    /// <inheritdoc />
    /// <remarks>
    /// Null exactly when the descriptor names no unbounded binary column. The accessors are invoked on
    /// <see cref="Writer"/>, which is the generated server repository the direct registration hands in.
    /// </remarks>
    public ISyncBinaryColumns<TKey>? BinaryColumns { get; }

    /// <summary>SELECT that returns every primary key of the table (SQL Server quoting).</summary>
    protected string ServerKeysSql => Descriptor.ServerKeysSql;

    /// <inheritdoc />
    public abstract Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public abstract Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    );

    /// <inheritdoc />
    public virtual Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <inheritdoc />
    public virtual Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "This source does not page by primary key; it serves a versioned table."
        );

    /// <inheritdoc />
    public async Task<IReadOnlyList<TKey>> GetAllKeysAsync(
        CancellationToken cancellationToken = default
    ) =>
        await ServerSqlExecutor.QueryProjectionBySqlAsync<TKey>(
            ServerKeysSql,
            null,
            cancellationToken
        )
            .ConfigureAwait(false);
}

/// <summary>Direct server source for a table with a row-version column (an ascending, anchored change scan).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class DirectSyncSource<TEntity, TKey> : DirectSyncSourceBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    public DirectSyncSource(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(serverSqlExecutor, writer, descriptor) { }

    /// <summary>SELECT that returns one ascending batch of rows above the anchor and below the ceiling (SQL Server quoting).</summary>
    private string ServerChangesSql => Descriptor.ServerChangesSql;

    /// <inheritdoc />
    public override async Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) =>
        await ServerSqlExecutor.ExecuteScalarSqlAsync<byte[]>(
            "SELECT MIN_ACTIVE_ROWVERSION()",
            null,
            cancellationToken
        )
            .ConfigureAwait(false);

    /// <inheritdoc />
    /// <remarks>
    /// A full batch is reported as "there is more", which the next call settles: it either returns the rest or comes
    /// back empty when the batch happened to end exactly on the boundary. The extra round trip in that case is the
    /// price of not fetching a row beyond the batch to peek with, and it costs one empty query per drained table.
    /// </remarks>
    public override async Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerChangesSql,
            new
            {
                anchor,
                ceiling,
                batchSize,
            },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }
}

/// <summary>Direct server source for a table without a row-version column (a key-ordered full scan, paged by primary key).</summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class VersionlessDirectSyncSource<TEntity, TKey>
    : DirectSyncSourceBase<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
    /// <summary>Creates the source over the server's raw SQL surface, the repository local changes replay against, and the table's descriptor.</summary>
    public VersionlessDirectSyncSource(
        ISqlExecutor serverSqlExecutor,
        IRemoteRepositoryCore<TEntity, TKey> writer,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(serverSqlExecutor, writer, descriptor) { }

    /// <summary>SELECT that returns the first ascending batch of rows by primary key (SQL Server quoting).</summary>
    private string ServerPageFirstSql => Descriptor.ServerPageFirstSql;

    /// <summary>SELECT that returns the next ascending batch of rows above a key (SQL Server quoting).</summary>
    private string ServerPageAfterSql => Descriptor.ServerPageAfterSql;

    /// <inheritdoc />
    /// <remarks>A key-ordered scan has no version to bound, so there is no ceiling to read.</remarks>
    public override Task<byte[]?> GetChangeCeilingAsync(
        CancellationToken cancellationToken = default
    ) => Task.FromResult<byte[]?>(null);

    /// <inheritdoc />
    /// <remarks>Never called for a table without a version column; the download pages by key instead.</remarks>
    public override Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    ) =>
        throw new NotSupportedException(
            "The table has no version column; its download pages by primary key."
        );

    /// <inheritdoc />
    /// <remarks>
    /// A full batch is reported as "there is more", which the next call settles: it either returns the rest or comes
    /// back empty when the batch happened to end exactly on the boundary - the same trade the versioned change scan
    /// makes.
    /// </remarks>
    public override async Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerPageFirstSql,
            new { batchSize },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }

    /// <inheritdoc />
    public override async Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var rows = await ServerSqlExecutor.QueryBySqlAsync<TEntity>(
            ServerPageAfterSql,
            new { afterKey, batchSize },
            cancellationToken
        )
            .ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(rows, rows.Count >= batchSize);
    }
}

/// <summary>
/// Thrown when a run finds a synchronised table empty locally while the change tracking holds rows of it that the server
/// knows and that have nothing to send: the table appears to have been made again empty.
/// </summary>
/// <remarks>
/// The run throws before it sends or downloads anything, so neither the local database nor the server changes. A run
/// would not bring the missing rows back (the download resumes after the rows it has already received) and could remove
/// the server's copies of rows it believes the device deleted. Rebuild the tables from the server with a refresh
/// (<c>RefreshAsync</c>).
/// </remarks>
public sealed class SyncLocalTableEmptiedException : InvalidOperationException
{
    /// <summary>Creates the exception from the tables found emptied.</summary>
    /// <param name="tableNames">The tables found emptied.</param>
    public SyncLocalTableEmptiedException(IReadOnlyList<string> tableNames)
        : base(BuildMessage(tableNames))
    {
        TableNames = tableNames;
    }

    /// <summary>The tables found emptied.</summary>
    public IReadOnlyList<string> TableNames { get; }

    /// <summary>Builds the message, which names the tables and the way back.</summary>
    private static string BuildMessage(IReadOnlyList<string> tableNames)
    {
        ArgumentNullException.ThrowIfNull(tableNames);

        return "The local table(s) "
            + string.Join(", ", tableNames)
            + " are empty, while the change tracking holds rows of them that this device had received from the server: "
            + "the tables appear to have been made again empty. Nothing was sent or downloaded. Rebuild them from the "
            + "server with a refresh (RefreshAsync).";
    }
}

/// <summary>
/// Thrown when one fetch of <see cref="SyncEngine"/> brings down more rows than
/// <see cref="SyncOptions.DownloadRowLimit"/> (or <see cref="SyncRefreshOptions.DownloadRowLimit"/>) while the tables of
/// the run hold unsent local changes.
/// </summary>
/// <remarks>
/// The rows fetched are dropped. The local database, the row state and the resume points are left unchanged, so the
/// unsent changes are still there to be sent and the next run fetches the same rows again.
/// </remarks>
public sealed class SyncDownloadTooLargeException : InvalidOperationException
{
    /// <summary>Creates the exception from the rows fetched, the limit and the per-table breakdown of the unsent changes.</summary>
    /// <param name="fetchedRowCount">The rows fetched when the run stopped.</param>
    /// <param name="rowLimit">The limit the fetch went over.</param>
    /// <param name="pendingChanges">The unsent local changes of the run's tables, grouped by table.</param>
    public SyncDownloadTooLargeException(
        int fetchedRowCount,
        int rowLimit,
        IReadOnlyList<SyncPendingChange> pendingChanges
    )
        : base(BuildMessage(fetchedRowCount, rowLimit, pendingChanges))
    {
        FetchedRowCount = fetchedRowCount;
        RowLimit = rowLimit;
        PendingChanges = pendingChanges;
        PendingCount = pendingChanges.Sum(change => change.Count);
    }

    /// <summary>The rows fetched when the run stopped.</summary>
    public int FetchedRowCount { get; }

    /// <summary>The limit the fetch went over.</summary>
    public int RowLimit { get; }

    /// <summary>The unsent local changes of the run's tables, grouped by table.</summary>
    public IReadOnlyList<SyncPendingChange> PendingChanges { get; }

    /// <summary>The total number of unsent local changes.</summary>
    public int PendingCount { get; }

    /// <summary>Builds the message, which names the counts, the tables and the ways out.</summary>
    private static string BuildMessage(int fetchedRowCount, int rowLimit, IReadOnlyList<SyncPendingChange> pendingChanges)
    {
        ArgumentNullException.ThrowIfNull(pendingChanges);
        var breakdown = string.Join(
            ", ",
            pendingChanges.Select(change => $"{change.TableName}: {change.Count}")
        );

        return $"The download fetched {fetchedRowCount} row(s), more than the limit of {rowLimit}, while "
            + $"{pendingChanges.Sum(change => change.Count)} unsent local change(s) wait ({breakdown}). Nothing was "
            + "applied. Send the changes first with UploadAsync (and resolve any conflicts it reports), raise "
            + "DownloadRowLimit, or - if the local changes may be discarded - refresh with SyncRefreshOptions.Force.";
    }
}

/// <summary>One unsent local change of <see cref="SyncEngine"/>, as <see cref="SyncEngine.GetPendingChangesAsync"/> lists it.</summary>
/// <param name="TableName">The synchronised table the row belongs to (the table name of its descriptor).</param>
/// <param name="KeyText">The row's key as text, in the same form as <see cref="SyncConflict.KeyText"/>.</param>
/// <param name="IsDelete">Whether the row's latest change deleted it.</param>
/// <param name="KnownToServer">Whether the server is known to hold the row.</param>
/// <param name="IsDiscarded">
/// Whether the row's change is to be discarded and no run has carried that out yet: the next run whose scope covers the
/// table does not send it and puts the server's row back instead.
/// </param>
/// <param name="ChangeNumber">
/// The number of the row's latest change when the list was read. <see cref="SyncEngine.DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>
/// discards the row only while its change number is still this one, so a row written again since keeps its change.
/// </param>
public sealed record SyncPendingRow(
    string TableName,
    string KeyText,
    bool IsDelete,
    bool KnownToServer,
    bool IsDiscarded,
    long ChangeNumber
);

/// <summary>One unsent row of the row state table of <see cref="SyncLocalTracking"/> (a row whose <c>dirty</c> is set).</summary>
/// <param name="TableName">The synchronised table the row belongs to.</param>
/// <param name="RawKey">The key exactly as the row state table stores it (the value the synchronised table stores).</param>
/// <param name="Deleted">Whether the row's latest change deleted it.</param>
/// <param name="Known">Whether the server is known to hold the row.</param>
/// <param name="ChangeSequence">The number of the row's latest change.</param>
/// <param name="BaseVersion">The server version the local content is based on (null when none is known).</param>
/// <param name="BlobColumns">The unbounded binary columns written since the row was last sent (accessor names, comma separated).</param>
/// <param name="ServerWinsSequence">The change number a <see cref="SyncConflictPolicy.ServerWins"/> run decided to discard and could not, or null.</param>
/// <param name="AppliedVersion">
/// The version of the latest content of another writer the engine put into the row (null when none, or when this device
/// overwrote the server's row since). A row carrying an older version was saved from an entity read before that content
/// came down.
/// </param>
internal sealed record SyncUnsentRow(
    string TableName,
    object RawKey,
    bool Deleted,
    bool Known,
    long ChangeSequence,
    byte[]? BaseVersion,
    string BlobColumns,
    long? ServerWinsSequence,
    byte[]? AppliedVersion
)
{
    /// <summary>Whether the row's latest change inserted or updated it (rather than deleting it).</summary>
    public bool Upserted => !Deleted;
}

/// <summary>What the row state table of <see cref="SyncLocalTracking"/> holds for one row.</summary>
internal sealed record SyncRowState
{
    /// <summary>The key exactly as the row state table stores it.</summary>
    public required object RawKey { get; init; }

    /// <summary>The server version the local content is based on (null when none is known).</summary>
    public byte[]? BaseVersion { get; init; }

    /// <summary>Whether the server is known to hold the row.</summary>
    public bool Known { get; init; }

    /// <summary>Whether the row holds an unsent change.</summary>
    public bool Dirty { get; init; }

    /// <summary>The number of the row's latest change.</summary>
    public long ChangeSequence { get; init; }

    /// <summary>The unbounded binary columns written since the row was last sent (accessor names, comma separated).</summary>
    public string BlobColumns { get; init; } = string.Empty;

    /// <summary>The unbounded binary columns still to be copied down from the server (accessor names, comma separated).</summary>
    public string BlobOwed { get; init; } = string.Empty;
}

/// <summary>
/// Every read and write of the state tables of <see cref="SyncLocalTracking"/> that <see cref="SyncEngine"/>
/// makes: the row state table, the state table and the anchor table.
/// </summary>
/// <remarks>
/// The statements run on the connection passed in, inside whatever transaction the caller started with an SQL statement.
/// Keys are bound exactly as the row state table stores them (the raw value the triggers copied from the synchronised
/// table), so a key read from it can be bound back unchanged.
/// </remarks>
internal static class SyncState
{
    /// <summary>The columns of a row state read, in the order <see cref="ReadRowState"/> reads them.</summary>
    private const string RowStateColumns =
        "\"key\", base_version, known, dirty, change_seq, blob_columns, blob_owed";

    /// <summary>
    /// Whether one server version is older than another: the versions are read as big-endian unsigned integers, so the one
    /// shorter without its leading zero bytes is older, and of two as long the lesser byte by byte is.
    /// </summary>
    /// <remarks>
    /// A server's versions only grow, and the download of the changes relies on the same order.
    /// </remarks>
    /// <param name="version">The version that may be older.</param>
    /// <param name="than">The version to compare it with.</param>
    public static bool IsOlderVersion(ReadOnlySpan<byte> version, ReadOnlySpan<byte> than)
    {
        version = version.TrimStart((byte)0);
        than = than.TrimStart((byte)0);

        return version.Length != than.Length ? version.Length < than.Length : version.SequenceCompareTo(than) < 0;
    }

    /// <summary>
    /// Reads every unsent row (the table, the key, whether it was inserted or updated or deleted, and the change number),
    /// in the order of the changes.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<IReadOnlyList<SyncUnsentRow>> ReadPendingAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    )
    {
        var pending = new List<SyncUnsentRow>();

        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT table_name, \"key\", deleted, known, change_seq, base_version, blob_columns, sw_seq, applied_version FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE dirty = 1 ORDER BY change_seq";

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            pending.Add(
                new SyncUnsentRow(
                    reader.GetString(0),
                    reader.GetValue(1),
                    reader.GetInt64(2) != 0,
                    reader.GetInt64(3) != 0,
                    reader.GetInt64(4),
                    reader.IsDBNull(5) ? null : (byte[])reader.GetValue(5),
                    reader.GetString(6),
                    reader.IsDBNull(7) ? null : reader.GetInt64(7),
                    reader.IsDBNull(8) ? null : (byte[])reader.GetValue(8)
                )
            );
        }

        return pending;
    }

    /// <summary>
    /// Drops the state of a row with nothing to send (gone locally and never on the server), only while its change number is
    /// still the one read.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="changeSequence">The change number read with the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task ForgetPendingAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        long changeSequence,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "DELETE FROM "
                + SyncLocalTracking.RowTableName
                + " WHERE table_name = @table AND \"key\" = @key AND change_seq = @seq",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey),
            ("@seq", changeSequence)
        );

    /// <summary>
    /// Records, before a row's unbounded binary columns are sent, the version its row write earned and that the server knows
    /// it (the unsent change stays), widens the columns written to every column for a row the server took as an insert, and
    /// adds the columns an overwrite leaves owing - so that a failure while the columns go leaves the next run guarding
    /// against this device's own write and sending every column a new server row lacks.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="version">The version the row write earned (null for a table without a version column).</param>
    /// <param name="widen">Every unbounded binary column, for a row the server took as an insert; otherwise empty.</param>
    /// <param name="owed">The unbounded binary columns an overwrite leaves owing from the server.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task RecordInterimAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        byte[]? version,
        IReadOnlyList<string> widen,
        IReadOnlyList<string> owed,
        CancellationToken cancellationToken
    )
    {
        await ExecuteAsync(
                connection,
                "UPDATE "
                    + SyncLocalTracking.RowTableName
                    + " SET base_version = @version, known = 1, "
                    + "blob_columns = CASE WHEN @widen = '' THEN blob_columns ELSE @widen END "
                    + "WHERE table_name = @table AND \"key\" = @key",
                cancellationToken,
                ("@version", version),
                ("@widen", string.Join(",", widen)),
                ("@table", tableName),
                ("@key", rawKey)
            )
            .ConfigureAwait(false);

        if (owed.Count > 0)
        {
            await AddOwedAsync(connection, tableName, rawKey, owed, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Records that a row's write reached the server: its base version and that the server knows it, and - only while its
    /// change number is still the one read - that it has nothing more to send. A write that overwrote the server's row
    /// without a version check also forgets the version of the other writer's content put into the row (whatever the
    /// change number): that content is overwritten, so an entity read before it came down no longer saves over it. Any
    /// other write keeps that version, since this device's own write is not another writer's content.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="version">The version the server now holds for the row (null for a table without a version column).</param>
    /// <param name="changeSequence">The change number read with the row.</param>
    /// <param name="forced">Whether the write overwrote the server's row without a version check.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task SettleSentAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        byte[]? version,
        long changeSequence,
        bool forced,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE "
                + SyncLocalTracking.RowTableName
                + " SET base_version = @version, known = 1, "
                + "dirty = CASE WHEN change_seq = @seq THEN 0 ELSE dirty END, "
                + "deleted = CASE WHEN change_seq = @seq THEN 0 ELSE deleted END, "
                + "blob_columns = CASE WHEN change_seq = @seq THEN '' ELSE blob_columns END, "
                + "applied_version = CASE WHEN @forced = 1 THEN NULL ELSE applied_version END "
                + "WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@version", version),
            ("@seq", changeSequence),
            ("@forced", forced ? 1 : 0),
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>
    /// Records that a row's delete reached the server: the state goes while its change number is still the one read, and a
    /// row made again under the key since stays as a row the server does not have.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="changeSequence">The change number read with the row.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task SettleDeletedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        long changeSequence,
        CancellationToken cancellationToken
    )
    {
        await ForgetPendingAsync(connection, tableName, rawKey, changeSequence, cancellationToken)
            .ConfigureAwait(false);
        await ExecuteAsync(
                connection,
                "UPDATE "
                    + SyncLocalTracking.RowTableName
                    + " SET known = 0, base_version = NULL WHERE table_name = @table AND \"key\" = @key",
                cancellationToken,
                ("@table", tableName),
                ("@key", rawKey)
            )
            .ConfigureAwait(false);
    }

    /// <summary>Adds unbounded binary columns to the ones a row still has to copy down (merged, without repeats).</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="columns">The columns (accessor names) to add.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task AddOwedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        IEnumerable<string> columns,
        CancellationToken cancellationToken
    )
    {
        if (await ReadRowAsync(connection, tableName, rawKey, cancellationToken).ConfigureAwait(false) is not { } row)
        {
            return;
        }

        var merged = row
            .BlobOwed.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Concat(columns)
            .Distinct(StringComparer.Ordinal)
            .Order(StringComparer.Ordinal);
        await WriteOwedAsync(connection, tableName, rawKey, string.Join(",", merged), cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>Clears the unsent change of a row a <see cref="SyncConflictPolicy.ServerWins"/> run discards.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task ClearDiscardedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE "
                + SyncLocalTracking.RowTableName
                + " SET dirty = 0, deleted = 0, blob_columns = '', sw_seq = NULL WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>
    /// Carries a <see cref="SyncConflictPolicy.ServerWins"/> decision the run could not carry out over to later runs: the row's
    /// current change number is marked, so later runs do not send the row and put the server's content back instead. A
    /// later local write moves the change number on, and the mark no longer applies.
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task MarkServerWinsAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE "
                + SyncLocalTracking.RowTableName
                + " SET sw_seq = change_seq WHERE table_name = @table AND \"key\" = @key AND dirty = 1",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>
    /// Whether the local table is empty while the row state table holds rows of it the server knows and that have nothing
    /// to send (the table appears to have been made again empty).
    /// </summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="qualifiedLocalName">The local table's name, quoted.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<bool> IsEmptiedAsync(
        DbConnection connection,
        string tableName,
        string qualifiedLocalName,
        CancellationToken cancellationToken
    )
    {
        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT NOT EXISTS (SELECT 1 FROM "
            + qualifiedLocalName
            + ") AND EXISTS (SELECT 1 FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE table_name = @table AND known = 1 AND dirty = 0)";
        AddParameter(command, "@table", tableName);

        return Convert.ToInt64(
                await command.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false),
                CultureInfo.InvariantCulture
            ) != 0;
    }

    /// <summary>Reads the state of every row of one table, by the key text the table gives each raw key.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="keyText">Renders a raw key into the table's key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<Dictionary<string, SyncRowState>> ReadRowsAsync(
        DbConnection connection,
        string tableName,
        Func<object, string> keyText,
        CancellationToken cancellationToken
    )
    {
        var rows = new Dictionary<string, SyncRowState>(StringComparer.Ordinal);

        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT " + RowStateColumns + " FROM " + SyncLocalTracking.RowTableName + " WHERE table_name = @table";
        AddParameter(command, "@table", tableName);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            var state = ReadRowState(reader);
            rows[keyText(state.RawKey)] = state;
        }

        return rows;
    }

    /// <summary>The temporary table <see cref="ReadRowsByKeyAsync"/> turns keys into stored keys through.</summary>
    private const string StoredKeyTableName = "quicker_sync_stored_keys";

    /// <summary>The most keys bound in one statement (well under SQLite's limit on the number of parameters).</summary>
    private const int MaxKeysPerStatement = 500;

    /// <summary>
    /// Reads the states of the rows with the given keys only (never every row state of the table), by the key text the
    /// table gives each raw key, together with each key exactly as the synchronised table stores it, by key text.
    /// </summary>
    /// <remarks>
    /// Each key is bound the way the local row store binds a key (a value object as its underlying value) into a temporary
    /// table whose column takes the affinity of the synchronised table's key column, so the value read back is the key as
    /// that table stores it - and as the row state table, which copies it, stores it. The row states are then read by those
    /// values, a bounded number at a time.
    /// </remarks>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="qualifiedLocalName">The synchronised table's local name, quoted.</param>
    /// <param name="quotedKeyColumn">The synchronised table's key column, quoted.</param>
    /// <param name="keys">The keys, of the table's key type.</param>
    /// <param name="keyText">Renders a raw key into the table's key text.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<(
        Dictionary<string, SyncRowState> States,
        Dictionary<string, object> RawKeys
    )> ReadRowsByKeyAsync(
        DbConnection connection,
        string tableName,
        string qualifiedLocalName,
        string quotedKeyColumn,
        IReadOnlyList<object> keys,
        Func<object, string> keyText,
        CancellationToken cancellationToken
    )
    {
        var states = new Dictionary<string, SyncRowState>(StringComparer.Ordinal);
        var rawKeys = new Dictionary<string, object>(StringComparer.Ordinal);

        if (keys.Count == 0)
        {
            return (states, rawKeys);
        }

        await ExecuteAsync(connection, "DROP TABLE IF EXISTS temp." + StoredKeyTableName, cancellationToken)
            .ConfigureAwait(false);
        await ExecuteAsync(
                connection,
                "CREATE TEMP TABLE "
                    + StoredKeyTableName
                    + " AS SELECT "
                    + quotedKeyColumn
                    + " AS k FROM "
                    + qualifiedLocalName
                    + " WHERE 0",
                cancellationToken
            )
            .ConfigureAwait(false);

        for (var start = 0; start < keys.Count; start += MaxKeysPerStatement)
        {
            var count = Math.Min(MaxKeysPerStatement, keys.Count - start);
            await using var insert = connection.CreateCommand();
            insert.CommandText =
                "INSERT INTO temp."
                + StoredKeyTableName
                + " (k) VALUES "
                + string.Join(
                    ", ",
                    Enumerable.Range(0, count).Select(index => "(@k" + index.ToString(CultureInfo.InvariantCulture) + ")")
                );

            for (var index = 0; index < count; index++)
            {
{{~ if generate_value_objects ~}}
                AddParameter(
                    insert,
                    "@k" + index.ToString(CultureInfo.InvariantCulture),
                    SqlParameterValue.Unwrap(keys[start + index])
                );
{{~ else ~}}
                AddParameter(insert, "@k" + index.ToString(CultureInfo.InvariantCulture), keys[start + index]);
{{~ end ~}}
            }

            await insert.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
        }

        var stored = new List<object>(keys.Count);

        await using (var read = connection.CreateCommand())
        {
            read.CommandText = "SELECT k FROM temp." + StoredKeyTableName;
            await using var reader = await read.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                if (!reader.IsDBNull(0))
                {
                    var rawKey = reader.GetValue(0);
                    stored.Add(rawKey);
                    rawKeys[keyText(rawKey)] = rawKey;
                }
            }
        }

        await ExecuteAsync(connection, "DROP TABLE temp." + StoredKeyTableName, cancellationToken).ConfigureAwait(false);

        for (var start = 0; start < stored.Count; start += MaxKeysPerStatement)
        {
            var count = Math.Min(MaxKeysPerStatement, stored.Count - start);
            await using var command = connection.CreateCommand();
            command.CommandText =
                "SELECT "
                + RowStateColumns
                + " FROM "
                + SyncLocalTracking.RowTableName
                + " WHERE table_name = @table AND \"key\" IN ("
                + string.Join(
                    ", ",
                    Enumerable.Range(0, count).Select(index => "@k" + index.ToString(CultureInfo.InvariantCulture))
                )
                + ")";
            AddParameter(command, "@table", tableName);

            for (var index = 0; index < count; index++)
            {
                AddParameter(command, "@k" + index.ToString(CultureInfo.InvariantCulture), stored[start + index]);
            }

            await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                var state = ReadRowState(reader);
                states[keyText(state.RawKey)] = state;
            }
        }

        return (states, rawKeys);
    }

    /// <summary>Reads the state of one row (null when the row state table has no row for it).</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<SyncRowState?> ReadRowAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    )
    {
        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT "
            + RowStateColumns
            + " FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE table_name = @table AND \"key\" = @key";
        AddParameter(command, "@table", tableName);
        AddParameter(command, "@key", rawKey);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        return await reader.ReadAsync(cancellationToken).ConfigureAwait(false) ? ReadRowState(reader) : null;
    }

    /// <summary>
    /// Records that a row now holds the server's content: its base version, that the server knows it, and no unsent
    /// change. A non-empty <paramref name="owed"/> replaces the columns still to be copied down; an empty one keeps them.
    /// </summary>
    /// <remarks>
    /// The version also becomes the version of the latest content of another writer put into the row
    /// (<c>applied_version</c>), unless the row's base version already is that version: writing the same version again
    /// (a refresh rewriting every row, or <see cref="SyncConflictPolicy.ServerWins"/> putting back a row the server did
    /// not change) is not another writer's content, and must not count a version this device itself raised as one.
    /// </remarks>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the synchronised table stores it.</param>
    /// <param name="version">The server version of the content written (null for a table without a version column).</param>
    /// <param name="owed">The unbounded binary columns to copy down from the server (accessor names, comma separated), or empty.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task WriteAppliedRowAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        byte[]? version,
        string owed,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "INSERT INTO "
                + SyncLocalTracking.RowTableName
                + " (table_name, \"key\", dirty, deleted, blob_columns, change_seq, base_version, known, blob_owed, applied_version) "
                + "VALUES (@table, @key, 0, 0, '', 0, @version, 1, @owed, @version) "
                + "ON CONFLICT (table_name, \"key\") DO UPDATE SET "
                + "applied_version = CASE WHEN base_version IS excluded.base_version THEN applied_version "
                + "ELSE excluded.base_version END, "
                + "base_version = excluded.base_version, known = 1, "
                + "dirty = 0, deleted = 0, blob_columns = '', sw_seq = NULL, "
                + "blob_owed = CASE WHEN @owed = '' THEN blob_owed ELSE @owed END",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey),
            ("@version", version),
            ("@owed", owed)
        );

    /// <summary>Drops the unbounded binary columns every row of one table still owes.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task ClearTableOwedAsync(
        DbConnection connection,
        string tableName,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE " + SyncLocalTracking.RowTableName + " SET blob_owed = '' WHERE table_name = @table",
            cancellationToken,
            ("@table", tableName)
        );

    /// <summary>Removes the state of one row.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task RemoveRowAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "DELETE FROM " + SyncLocalTracking.RowTableName + " WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>Reads the rows of one table that still have unbounded binary columns to copy down.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<IReadOnlyList<SyncRowState>> ReadOwedAsync(
        DbConnection connection,
        string tableName,
        CancellationToken cancellationToken
    )
    {
        var rows = new List<SyncRowState>();

        await using var command = connection.CreateCommand();
        command.CommandText =
            "SELECT "
            + RowStateColumns
            + " FROM "
            + SyncLocalTracking.RowTableName
            + " WHERE table_name = @table AND blob_owed <> ''";
        AddParameter(command, "@table", tableName);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            rows.Add(ReadRowState(reader));
        }

        return rows;
    }

    /// <summary>Replaces the unbounded binary columns one row still has to copy down.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="rawKey">The key as the row state table stores it.</param>
    /// <param name="owed">The columns still owed (accessor names, comma separated; empty when none is).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task WriteOwedAsync(
        DbConnection connection,
        string tableName,
        object rawKey,
        string owed,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE " + SyncLocalTracking.RowTableName + " SET blob_owed = @owed WHERE table_name = @table AND \"key\" = @key",
            cancellationToken,
            ("@owed", owed),
            ("@table", tableName),
            ("@key", rawKey)
        );

    /// <summary>Sets or clears the applying flag the triggers check (what is written while it is set is not recorded).</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="applying">Whether the flag is set.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The number of rows of the state table that were written (1 when the change tracking is set up).</returns>
    public static Task<int> SetApplyingAsync(
        DbConnection connection,
        bool applying,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "UPDATE " + SyncLocalTracking.StateTableName + " SET applying = " + (applying ? "1" : "0"),
            cancellationToken
        );

    /// <summary>Reads where each table's next download resumes, by table name.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static async Task<Dictionary<string, byte[]?>> ReadAnchorsAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    )
    {
        var anchors = new Dictionary<string, byte[]?>(StringComparer.Ordinal);

        await using var command = connection.CreateCommand();
        command.CommandText = "SELECT table_name, anchor FROM " + SyncLocalTracking.AnchorTableName;

        await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
        {
            anchors[reader.GetString(0)] = reader.IsDBNull(1) ? null : (byte[])reader.GetValue(1);
        }

        return anchors;
    }

    /// <summary>Saves where one table's next download resumes.</summary>
    /// <param name="connection">An open connection to the local database.</param>
    /// <param name="tableName">The synchronised table.</param>
    /// <param name="anchor">The version to resume above (null to take everything).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public static Task WriteAnchorAsync(
        DbConnection connection,
        string tableName,
        byte[]? anchor,
        CancellationToken cancellationToken
    ) =>
        ExecuteAsync(
            connection,
            "INSERT INTO "
                + SyncLocalTracking.AnchorTableName
                + " (table_name, anchor) VALUES (@table, @anchor) "
                + "ON CONFLICT (table_name) DO UPDATE SET anchor = excluded.anchor",
            cancellationToken,
            ("@table", tableName),
            ("@anchor", anchor)
        );

    /// <summary>Runs one statement that returns no rows, and returns the number of rows it changed.</summary>
    /// <param name="connection">The connection.</param>
    /// <param name="sql">One statement.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <param name="parameters">The parameters, by name (a null value is bound as NULL).</param>
    internal static async Task<int> ExecuteAsync(
        DbConnection connection,
        string sql,
        CancellationToken cancellationToken,
        params (string Name, object? Value)[] parameters
    )
    {
        await using var command = connection.CreateCommand();
        command.CommandText = sql;

        foreach (var (name, value) in parameters)
        {
            AddParameter(command, name, value);
        }

        return await command.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
    }

    /// <summary>Adds a parameter to a command (null is bound as NULL).</summary>
    internal static void AddParameter(DbCommand command, string name, object? value)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.Value = value ?? DBNull.Value;
        command.Parameters.Add(parameter);
    }

    /// <summary>Reads the columns of <see cref="RowStateColumns"/> off the current row of the reader.</summary>
    private static SyncRowState ReadRowState(DbDataReader reader) =>
        new()
        {
            RawKey = reader.GetValue(0),
            BaseVersion = reader.IsDBNull(1) ? null : (byte[])reader.GetValue(1),
            Known = reader.GetInt64(2) != 0,
            Dirty = reader.GetInt64(3) != 0,
            ChangeSequence = reader.GetInt64(4),
            BlobColumns = reader.GetString(5),
            BlobOwed = reader.GetString(6),
        };
}

/// <summary>How one write of an unsent row to the server ended.</summary>
internal enum SyncSendKind
{
    /// <summary>The write reached the server.</summary>
    Sent,

    /// <summary>The server's version disagreed (<see cref="SyncConflictReason.ModifiedOnServer"/>, <see cref="SyncConflictReason.MissingOnServer"/>, <see cref="SyncConflictReason.DuplicateOnServer"/>).</summary>
    Conflict,

    /// <summary>There was nothing to send (the row is gone locally and the server never had it).</summary>
    Discarded,

    /// <summary>The write to the server threw; why is for the engine to look up.</summary>
    Failed,
}

/// <summary>What one write of an unsent row to the server did.</summary>
/// <param name="Kind">How it ended.</param>
internal sealed record SyncSend(SyncSendKind Kind)
{
    /// <summary>Whether the write deleted the row on the server.</summary>
    public bool Deleted { get; init; }

    /// <summary>Whether the write inserted the row on the server.</summary>
    public bool Inserted { get; init; }

    /// <summary>Whether the write overwrote the server row without a version check.</summary>
    public bool Forced { get; init; }

    /// <summary>The disagreement, for a <see cref="SyncSendKind.Conflict"/>.</summary>
    public SyncConflictReason Reason { get; init; }

    /// <summary>The local row sent (null for a delete).</summary>
    public object? Local { get; init; }

    /// <summary>The server row as it stands, for a <see cref="SyncSendKind.Conflict"/> (null when the server has none).</summary>
    public object? Server { get; init; }

    /// <summary>The exception the server write threw, for a <see cref="SyncSendKind.Failed"/>.</summary>
    public Exception? Error { get; init; }

    /// <summary>
    /// The version the writer stamped on the row it accepted, for a <see cref="SyncSendKind.Sent"/> upsert (null when
    /// the writer left the version the row carried before the write, or for a table without a version column).
    /// </summary>
    public byte[]? Version { get; init; }
}

/// <summary>
/// One synchronised table, without its entity and key types: what <see cref="SyncEngine"/> asks of a table, and the
/// type its constructor takes. The only derived type is <see cref="SyncTable{TEntity, TKey}"/>; it cannot be
/// derived from outside this assembly.
/// </summary>
public abstract class SyncTable
{
    private protected SyncTable() { }

    /// <summary>Reads the local row with the key (null when there is none).</summary>
    internal abstract Task<EntityBaseCore?> FindAsync(DbConnection connection, object key, CancellationToken cancellationToken);

    /// <summary>
    /// Writes one unsent row to the server: an update guarded by the base version when the local row is there and the
    /// server knows it, an insert (after making sure the server has no such key) when the server does not know it, a delete
    /// guarded by the base version when the local row is gone and the server knows it, and nothing when the local row is
    /// gone and the server never had it. A forced write (or a table without a version column) overwrites without a version
    /// check, inserting when the server has no such row, and deletes unconditionally. Only the row goes: the unbounded
    /// binary columns are sent afterwards by the engine.
    /// </summary>
    internal abstract Task<SyncSend> SendAsync(
        SyncUnsentRow pending,
        object key,
        EntityBaseCore? local,
        bool force,
        CancellationToken cancellationToken
    );

    /// <summary>Reads one unbounded binary column of the local row into the stream (false when the row is gone or the column is NULL).</summary>
    internal abstract Task<bool> ReadLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream destination,
        CancellationToken cancellationToken
    );

    /// <summary>Writes one unbounded binary column of the server row from the stream (NULL when the stream is null).</summary>
    internal abstract Task WriteServerBinaryAsync(
        string propertyName,
        object key,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    );

    /// <summary>The database column names of the unbounded binary columns, unquoted, in the same order.</summary>
    internal abstract IReadOnlyList<string> LocalUnboundedBinaryColumnNames { get; }

    /// <summary>Returns the tables outside the given scope whose local rows refer to a local row of this table (what a refresh refuses to run for).</summary>
    internal abstract Task<IReadOnlyList<string>> FindReferencesFromOutsideAsync(
        DbConnection connection,
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    );

    /// <summary>Reads the server row with the key (null when there is none).</summary>
    internal abstract Task<EntityBaseCore?> ReadServerAsync(object key, CancellationToken cancellationToken);

    /// <summary>Whether the server holds the row with the key text.</summary>
    internal abstract Task<bool> ServerHasAsync(string keyText, CancellationToken cancellationToken);

    /// <summary>Whether a server row of this table refers to the given row by its primary key.</summary>
    internal abstract Task<bool> ServerReferencesAsync(
        string parentTableName,
        string parentKeyText,
        CancellationToken cancellationToken
    );

    /// <summary>Whether another server row holds one of the row's unique values.</summary>
    internal abstract Task<bool> CollidesOnServerAsync(EntityBaseCore local, CancellationToken cancellationToken);

    /// <summary>The parents a row refers to by their primary keys (the parent's table and key text, null for no parent).</summary>
    internal abstract IEnumerable<(string TableName, string? KeyText)> ParentsOf(EntityBaseCore row);

    /// <summary>The table name, as the row state table records it.</summary>
    internal abstract string TableName { get; }

    /// <summary>The entity type the table synchronises.</summary>
    internal abstract Type EntityType { get; }

    /// <summary>Whether the table has no version column.</summary>
    internal abstract bool IsVersionless { get; }

    /// <summary>The excluded unbounded binary columns (accessor names).</summary>
    internal abstract IReadOnlyList<string> UnboundedBinaryColumnNames { get; }

    /// <summary>The local table name, unquoted (the table lives in the main database).</summary>
    internal abstract string LocalTableName { get; }

    /// <summary>The local primary key column, unquoted.</summary>
    internal abstract string LocalKeyColumnName { get; }

    /// <summary>The local row store the table reads and writes its rows through.</summary>
    internal abstract ILocalRowStore Rows { get; }

    /// <summary>The key text of a key of the table's key type.</summary>
    internal abstract string KeyText(object key);

    /// <summary>The key of the table's key type for a key as the database stores it.</summary>
    internal abstract object KeyOfRaw(object rawKey);

    /// <summary>The key text of a key as the database stores it.</summary>
    internal abstract string KeyTextOfRaw(object rawKey);

    /// <summary>The key of a row.</summary>
    internal abstract object KeyOf(EntityBaseCore row);

    /// <summary>The server version a row carries (null for a table without a version column).</summary>
    internal abstract byte[]? VersionOf(EntityBaseCore row);

    /// <summary>Sets the server version a row carries (nothing for a table without a version column).</summary>
    internal abstract void SetVersion(EntityBaseCore row, byte[]? version);

    /// <summary>Gets the server's change ceiling (null for a table without a version column).</summary>
    internal abstract Task<byte[]?> GetCeilingAsync(CancellationToken cancellationToken);

    /// <summary>
    /// Fetches every server row above the anchor and below the ceiling (every row for a table without a version column),
    /// one page at a time, in the order they come (ascending version, or ascending key for a table without a version
    /// column). Empty pages are not returned. A source that says more rows follow a page whose last row does not advance
    /// past the anchor (or key) the page was asked for ends the enumeration with an <see cref="InvalidOperationException"/>.
    /// </summary>
    internal abstract IAsyncEnumerable<IReadOnlyList<EntityBaseCore>> FetchPagesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken
    );

    /// <summary>Fetches the key texts of every row the server holds.</summary>
    internal abstract Task<IReadOnlySet<string>> FetchServerKeysAsync(CancellationToken cancellationToken);

    /// <summary>Whether the local table has a row with the key.</summary>
    internal abstract Task<bool> ExistsAsync(DbConnection connection, object key, CancellationToken cancellationToken);

    /// <summary>Inserts a server row locally, giving its unset NOT NULL excluded binary columns an empty value first.</summary>
    internal abstract Task InsertAsync(DbConnection connection, EntityBaseCore row, CancellationToken cancellationToken);

    /// <summary>Overwrites the local row with a server row (the excluded binary columns are not touched).</summary>
    internal abstract Task UpdateAsync(DbConnection connection, EntityBaseCore row, CancellationToken cancellationToken);

    /// <summary>Deletes the local row with the key.</summary>
    internal abstract Task<bool> DeleteAsync(DbConnection connection, object key, CancellationToken cancellationToken);

    /// <summary>Reads every local key.</summary>
    internal abstract Task<IReadOnlyList<object>> ListKeysAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    );

    /// <summary>Copies one excluded binary column of the server row into the stream (false when the server has no such row or the column is NULL).</summary>
    internal abstract Task<bool> ReadServerBinaryAsync(
        string propertyName,
        object key,
        Stream destination,
        CancellationToken cancellationToken
    );

    /// <summary>Writes one excluded binary column of the local row from the stream (NULL when the stream is null), inside the caller's transaction.</summary>
    internal abstract Task<bool> WriteLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    );
}

/// <summary>
/// One synchronised table of <see cref="SyncEngine"/>: its descriptor, the server's differential source, and the
/// local row store its rows are read and written through.
/// </summary>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed class SyncTable<TEntity, TKey> : SyncTable
    where TEntity : EntityBaseCore, new()
{
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;
    private readonly ISyncServerSource<TEntity, TKey> _source;
    private readonly ILocalRowStore _rows;

    /// <summary>Creates the table over its descriptor, the server's differential source and the local row store.</summary>
    /// <param name="descriptor">The table's descriptor.</param>
    /// <param name="source">The server's differential source of the table (and its unbounded binary columns).</param>
    /// <param name="rows">The local row store (every table of one engine shares the same one).</param>
    public SyncTable(
        SyncTableDescriptor<TEntity, TKey> descriptor,
        ISyncServerSource<TEntity, TKey> source,
        ILocalRowStore rows
    )
    {
        ArgumentNullException.ThrowIfNull(descriptor);
        ArgumentNullException.ThrowIfNull(source);
        ArgumentNullException.ThrowIfNull(rows);
        _descriptor = descriptor;
        _source = source;
        _rows = rows;
    }

    internal override string TableName => _descriptor.TableName;

    internal override Type EntityType => typeof(TEntity);

    internal override bool IsVersionless => _descriptor.IsVersionless;

    internal override IReadOnlyList<string> UnboundedBinaryColumnNames => _descriptor.UnboundedBinaryColumnNames;

    internal override string LocalTableName => _descriptor.LocalTableName;

    internal override string LocalKeyColumnName => _descriptor.LocalKeyColumnName;

    internal override ILocalRowStore Rows => _rows;

    internal override string KeyText(object key) => _descriptor.FormatKey((TKey)key);

    internal override object KeyOfRaw(object rawKey) => _rows.ConvertKey<TEntity>(rawKey);

    internal override string KeyTextOfRaw(object rawKey) =>
        _descriptor.FormatKey((TKey)_rows.ConvertKey<TEntity>(rawKey));

    internal override async Task<EntityBaseCore?> FindAsync(
        DbConnection connection,
        object key,
        CancellationToken cancellationToken
    ) => await _rows.FindAsync<TEntity>(connection, key, cancellationToken).ConfigureAwait(false);

    internal override async Task<SyncSend> SendAsync(
        SyncUnsentRow pending,
        object key,
        EntityBaseCore? local,
        bool force,
        CancellationToken cancellationToken
    )
    {
        var typedKey = (TKey)key;
        var writer = _source.Writer;
        var versionless = _descriptor.IsVersionless;

        try
        {
            if (local is null)
            {
                // Gone locally: a row the server never had has nothing to send (a table without a version column is always known)
                if (!versionless && !pending.Known)
                {
                    return new(SyncSendKind.Discarded);
                }

                if (versionless || force)
                {
                    await writer.DeleteAsync(typedKey, cancellationToken).ConfigureAwait(false);

                    return new(SyncSendKind.Sent) { Deleted = true };
                }

                // A delete guarded by the base version: a delete by key alone is not version-checked, so a stub carrying the
                // version is saved as removed
                var stub = new TEntity();
                _descriptor.WriteKey(stub, typedKey);
                _descriptor.WriteRowVersion(stub, pending.BaseVersion);
                stub.MarkRemoved();

                try
                {
                    await writer.SaveAsync(stub, cancellationToken: cancellationToken).ConfigureAwait(false);
                }
                catch (SaveConflictException conflict) when (conflict.Reason == SaveConflictReason.Modified)
                {
                    return new(SyncSendKind.Conflict)
                    {
                        Reason = SyncConflictReason.ModifiedOnServer,
                        Server = await writer.GetByIdAsync(typedKey, cancellationToken).ConfigureAwait(false),
                    };
                }

                return new(SyncSendKind.Sent) { Deleted = true };
            }

            var entity = (TEntity)local;

            if (versionless || force)
            {
                var beforeOverwrite = VersionCarried(entity);

                if (
                    await writer
                        .UpdateAsync(entity, ConcurrencyMode.ForceOverwrite, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    return new(SyncSendKind.Sent) { Forced = true, Version = Stamped(entity, beforeOverwrite) };
                }

                // The server has no such row: it is inserted, and the engine then sends every binary column
                _descriptor.FillUnsetUnboundedBinaries(entity);
                var beforeForcedInsert = VersionCarried(entity);
                await writer.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

                return new(SyncSendKind.Sent)
                {
                    Inserted = true,
                    Forced = true,
                    Version = Stamped(entity, beforeForcedInsert),
                };
            }

            if (pending.Known)
            {
                // The version guard starts from the base version, unless the local row carries a version older than the
                // latest content of another writer the engine put into it: the row was then saved from an entity read
                // before that content came down, and the version it carries makes the server report the conflict
                var carried = _descriptor.ReadRowVersion(entity);
                var original =
                    carried is { Length: > 0 }
                    && pending.AppliedVersion is { Length: > 0 } applied
                    && SyncState.IsOlderVersion(carried, applied)
                        ? carried
                        : pending.BaseVersion;
                _descriptor.WriteRowVersion(entity, original);

                try
                {
                    if (
                        !await writer
                            .UpdateAsync(entity, ConcurrencyMode.Optimistic, cancellationToken)
                            .ConfigureAwait(false)
                    )
                    {
                        return new(SyncSendKind.Conflict)
                        {
                            Reason = SyncConflictReason.MissingOnServer,
                            Local = entity,
                        };
                    }
                }
                catch (SaveConflictException conflict)
                {
                    var server = await writer.GetByIdAsync(typedKey, cancellationToken).ConfigureAwait(false);

                    return new(SyncSendKind.Conflict)
                    {
                        Reason =
                            conflict.Reason == SaveConflictReason.NotFound || server is null
                                ? SyncConflictReason.MissingOnServer
                                : SyncConflictReason.ModifiedOnServer,
                        Local = entity,
                        Server = server,
                    };
                }

                return new(SyncSendKind.Sent) { Version = Stamped(entity, original) };
            }

            // Made here under a key the server does not know: the server must not have the key already
            if (await writer.GetByIdAsync(typedKey, cancellationToken).ConfigureAwait(false) is { } existing)
            {
                return new(SyncSendKind.Conflict)
                {
                    Reason = SyncConflictReason.DuplicateOnServer,
                    Local = entity,
                    Server = existing,
                };
            }

            _descriptor.FillUnsetUnboundedBinaries(entity);
            var beforeInsert = VersionCarried(entity);
            await writer.InsertAsync(entity, cancellationToken).ConfigureAwait(false);

            return new(SyncSendKind.Sent) { Inserted = true, Version = Stamped(entity, beforeInsert) };
        }
        catch (Exception failure) when (failure is not OperationCanceledException)
        {
            return new(SyncSendKind.Failed) { Error = failure, Local = local };
        }

        // The version the row carries before a write (null for a table without a version column)
        byte[]? VersionCarried(TEntity row) => versionless ? null : _descriptor.ReadRowVersion(row);

        // The version the writer stamped on the row it accepted: null when it left the version the row carried before
        // the write, which the engine then reads back from the server instead
        byte[]? Stamped(TEntity row, byte[]? before) =>
            !versionless
            && _descriptor.ReadRowVersion(row) is { Length: > 0 } after
            && !(before is not null && after.AsSpan().SequenceEqual(before))
                ? after
                : null;
    }

    internal override async Task<EntityBaseCore?> ReadServerAsync(object key, CancellationToken cancellationToken) =>
        await _source.Writer.GetByIdAsync((TKey)key, cancellationToken).ConfigureAwait(false);

    internal override async Task<bool> ServerHasAsync(string keyText, CancellationToken cancellationToken) =>
        await _source.Writer.GetByIdAsync(_descriptor.ParseKey(keyText), cancellationToken).ConfigureAwait(false)
            is not null;

    internal override async Task<bool> ServerReferencesAsync(
        string parentTableName,
        string parentKeyText,
        CancellationToken cancellationToken
    )
    {
        if (!_descriptor.ParentReferences.Any(reference => reference.ParentTableName == parentTableName))
        {
            return false;
        }

        var rows = await _source.Writer.GetAllAsync(cancellationToken).ConfigureAwait(false);

        return rows.Any(row =>
            _descriptor.ParentReferences.Any(reference =>
                reference.ParentTableName == parentTableName
                && string.Equals(reference.ReadParentKeyText(row), parentKeyText, StringComparison.Ordinal)
            )
        );
    }

    internal override async Task<bool> CollidesOnServerAsync(EntityBaseCore local, CancellationToken cancellationToken) =>
        (await _source.Writer.CheckUniquenessAsync((TEntity)local, cancellationToken).ConfigureAwait(false)).Count > 0;

    internal override IEnumerable<(string TableName, string? KeyText)> ParentsOf(EntityBaseCore row) =>
        _descriptor.ParentReferences.Select(reference =>
            (reference.ParentTableName, reference.ReadParentKeyText((TEntity)row))
        );

    internal override object KeyOf(EntityBaseCore row) => _descriptor.ReadKey((TEntity)row)!;

    internal override byte[]? VersionOf(EntityBaseCore row) =>
        _descriptor.IsVersionless ? null : _descriptor.ReadRowVersion((TEntity)row);

    internal override void SetVersion(EntityBaseCore row, byte[]? version)
    {
        if (!_descriptor.IsVersionless)
        {
            _descriptor.WriteRowVersion((TEntity)row, version);
        }
    }

    internal override async Task<byte[]?> GetCeilingAsync(CancellationToken cancellationToken) =>
        _descriptor.IsVersionless
            ? null
            : await _source.GetChangeCeilingAsync(cancellationToken).ConfigureAwait(false);

    internal override async IAsyncEnumerable<IReadOnlyList<EntityBaseCore>> FetchPagesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken cancellationToken
    )
    {
        if (_descriptor.IsVersionless)
        {
            var page = await _source.GetFirstPageAsync(batchSize, cancellationToken).ConfigureAwait(false);

            if (page.Rows.Count > 0)
            {
                yield return page.Rows;
            }

            while (page.HasMore && page.Rows.Count > 0)
            {
                var afterKey = _descriptor.ReadKey(page.Rows[^1]);
                page = await _source
                    .GetPageAfterAsync(afterKey, batchSize, cancellationToken)
                    .ConfigureAwait(false);

                if (page.Rows.Count > 0)
                {
                    yield return page.Rows;
                }

                if (
                    page.HasMore
                    && page.Rows.Count > 0
                    && string.Equals(
                        _descriptor.FormatKey(_descriptor.ReadKey(page.Rows[^1])),
                        _descriptor.FormatKey(afterKey),
                        StringComparison.Ordinal
                    )
                )
                {
                    throw new InvalidOperationException(
                        $"The download of '{_descriptor.TableName}' is not making progress: the last key of a batch did "
                            + "not advance past the one the batch was asked for. The server source is not returning rows in "
                            + "ascending primary-key order above the key it was given."
                    );
                }
            }
        }
        else
        {
            var resume = anchor;

            while (true)
            {
                var batch = await _source
                    .GetChangesAsync(resume, ceiling, batchSize, cancellationToken)
                    .ConfigureAwait(false);

                if (batch.Rows.Count > 0)
                {
                    yield return batch.Rows;
                }

                if (!batch.HasMore || batch.Rows.Count == 0)
                {
                    break;
                }

                var next = _descriptor.ReadRowVersion(batch.Rows[^1]);

                if (
                    next is null
                    || next.Length == 0
                    || (resume is not null && next.AsSpan().SequenceEqual(resume))
                )
                {
                    throw new InvalidOperationException(
                        $"The download of '{_descriptor.TableName}' is not making progress: the last row of a batch "
                            + "carries no version, or one that does not advance past the anchor the batch was asked for. The "
                            + "server source is not returning rows in ascending version order above the anchor it was given."
                    );
                }

                resume = next;
            }
        }
    }

    internal override async Task<IReadOnlySet<string>> FetchServerKeysAsync(CancellationToken cancellationToken)
    {
        var keys = await _source.GetAllKeysAsync(cancellationToken).ConfigureAwait(false);

        return keys.Select(_descriptor.FormatKey).ToHashSet(StringComparer.Ordinal);
    }

    internal override Task<bool> ExistsAsync(
        DbConnection connection,
        object key,
        CancellationToken cancellationToken
    ) => _rows.ExistsAsync<TEntity>(connection, key, cancellationToken);

    internal override Task InsertAsync(
        DbConnection connection,
        EntityBaseCore row,
        CancellationToken cancellationToken
    )
    {
        var entity = (TEntity)row;
        _descriptor.FillUnsetUnboundedBinaries(entity);

        return _rows.InsertAsync(connection, entity, cancellationToken);
    }

    internal override Task UpdateAsync(
        DbConnection connection,
        EntityBaseCore row,
        CancellationToken cancellationToken
    ) => _rows.UpdateAsync(connection, (TEntity)row, cancellationToken);

    internal override Task<bool> DeleteAsync(
        DbConnection connection,
        object key,
        CancellationToken cancellationToken
    ) => _rows.DeleteAsync<TEntity>(connection, key, cancellationToken);

    internal override Task<IReadOnlyList<object>> ListKeysAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    ) => _rows.ListKeysAsync<TEntity>(connection, cancellationToken);

    internal override async Task<bool> ReadServerBinaryAsync(
        string propertyName,
        object key,
        Stream destination,
        CancellationToken cancellationToken
    ) =>
        _source.BinaryColumns is { } binaries
        && await binaries
            .ReadUnboundedBinaryAsync(propertyName, (TKey)key, destination, cancellationToken)
            .ConfigureAwait(false);

    internal override Task<bool> WriteLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    ) => _rows.WriteBinaryAsync<TEntity>(connection, key, propertyName, source, length, cancellationToken);

    internal override Task<bool> ReadLocalBinaryAsync(
        DbConnection connection,
        object key,
        string propertyName,
        Stream destination,
        CancellationToken cancellationToken
    ) => _rows.ReadBinaryAsync<TEntity>(connection, key, propertyName, destination, cancellationToken);

    internal override async Task WriteServerBinaryAsync(
        string propertyName,
        object key,
        Stream? source,
        long? length,
        CancellationToken cancellationToken
    )
    {
        // A server without the binary surface has nothing to write to (its rows carry no excluded columns)
        if (_source.BinaryColumns is { } binaries)
        {
            await binaries
                .WriteUnboundedBinaryAsync(propertyName, (TKey)key, source, length, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    internal override IReadOnlyList<string> LocalUnboundedBinaryColumnNames =>
        _descriptor.LocalUnboundedBinaryColumnNames;

    /// <remarks>
    /// A table outside the scope is asked through <see cref="SyncTableDescriptor{TEntity, TKey}.LocalReferences"/>, against
    /// every local key of this table (the refresh may delete any of them). A table the local database does not have is
    /// skipped. A table that refers to this one only through a foreign key those references do not list
    /// (<see cref="SyncTableDescriptor{TEntity, TKey}.UnlistedReferencingTableNames"/>) cannot be asked, so it counts whenever
    /// the local database has it.
    /// </remarks>
    internal override async Task<IReadOnlyList<string>> FindReferencesFromOutsideAsync(
        DbConnection connection,
        IReadOnlySet<string> scopeTableNames,
        CancellationToken cancellationToken
    )
    {
        var listed = _descriptor
            .LocalReferences.Where(reference => !scopeTableNames.Contains(reference.TableName))
            .ToList();
        var unlisted = _descriptor
            .UnlistedReferencingTableNames.Where(name => !scopeTableNames.Contains(name))
            .ToList();

        if (listed.Count == 0 && unlisted.Count == 0)
        {
            return [];
        }

        var present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using (var command = connection.CreateCommand())
        {
            command.CommandText = "SELECT name FROM sqlite_master WHERE type = 'table'";
            await using var reader = await command.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                present.Add(reader.GetString(0));
            }
        }

        var referring = unlisted.Where(present.Contains).Distinct(StringComparer.Ordinal).ToList();
        var localKeys =
            "SELECT "
            + SyncEngine.Identifier(_descriptor.LocalKeyColumnName)
            + " FROM "
            + SyncEngine.QualifiedName(this);

        foreach (var reference in listed)
        {
            if (
                !present.Contains(reference.TableName)
                || referring.Contains(reference.TableName, StringComparer.Ordinal)
            )
            {
                continue;
            }

            // The reference reads the referring values among a set of keys (its one "IN (@keys)"); here the set is every
            // local key. A reference of any other form is not one the generator writes
            const string KeySet = "IN (@keys)";
            var at = reference.Sql.IndexOf(KeySet, StringComparison.Ordinal);

            if (
                at < 0
                || reference.Sql.IndexOf("@keys", at + KeySet.Length, StringComparison.Ordinal) >= 0
                || reference.Sql.IndexOf("@keys", StringComparison.Ordinal) != at + 4
            )
            {
                throw new InvalidOperationException(
                    $"The local reference from '{reference.TableName}' to '{_descriptor.TableName}' does not read one key set."
                );
            }

            await using var probe = connection.CreateCommand();
            probe.CommandText =
                "SELECT EXISTS ("
                + reference.Sql[..at]
                + "IN ("
                + localKeys
                + ")"
                + reference.Sql[(at + KeySet.Length)..]
                + ")";

            if (
                Convert.ToInt64(
                    await probe.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false),
                    CultureInfo.InvariantCulture
                ) != 0
            )
            {
                referring.Add(reference.TableName);
            }
        }

        return referring;
    }
}

/// <summary>
/// The sync engine over the change tracking of <see cref="SyncLocalTracking"/>: local changes are recorded by triggers in
/// the row state table, and a download brings the server's changes into memory and applies them in one local transaction.
/// </summary>
/// <remarks>
/// <para>
/// A download takes the change ceiling once at the start of the run and shares it among the tables, fetches every table
/// of the run's scope, and then applies everything on a dedicated connection (foreign keys checked off, one
/// <c>BEGIN IMMEDIATE</c> transaction, the applying flag set so that the triggers do not record what it writes). Within
/// that transaction it first removes, in every table, the local rows the server no longer has (delete propagation), then
/// writes the server rows, then checks the foreign keys, and finally saves each table's resume point - all or nothing.
/// When the apply holds rows back, the run takes the ceiling again and fetches and applies once more from the resume
/// points.
/// </para>
/// <para>
/// A sync, a download-only run or a refresh whose fetch brings more than 50,000 rows down while the run's tables hold no
/// unsent change (or more than the download row limit with none; a forced refresh does not count the rows it discards)
/// applies the download a chunk at a time instead: every 10,000 rows of a table are committed in a transaction of their
/// own, so the state in between is visible to other connections (it never leaves a foreign key violation: a row whose
/// parent or unique value is not in place yet is held back and written, with the other rows held back, in one last
/// transaction). Such a run is not all or nothing: one that fails half-way keeps the chunks it committed, and the next
/// run goes on from the resume points, which never pass a row held back (a failed refresh is run again to finish the
/// rebuild; a sync after it goes on downloading from where the refresh stopped, and sends a row it was discarding and had
/// not yet replaced as an ordinary unsent change). Before the first chunk, the run takes the server keys of the tables it
/// has not fetched yet and removes the local rows the server no longer holds, in a transaction of its own: a row the
/// server deletes between those keys and its rows stays on the device until the next run's delete propagation, and so
/// does a parent that still has a local child the server moved elsewhere (the child moves in a later chunk). For a
/// refresh, that transaction also forgets the rows neither side holds, empties every unbounded binary column of the
/// scope's tables when the refresh gives them up, settles the rows it discards that the server no longer holds, and sets
/// every table's resume point back to nothing fetched, from which the chunks move it.
/// </para>
/// <para>
/// The apply never calls the local save hooks. It writes rows through <see cref="ILocalRowStore"/>, which leaves the
/// excluded unbounded binary columns alone on an update; when the run carries those columns, each row the apply wrote
/// owes them, and they are copied down from the server afterwards, each through a temporary file and a short transaction
/// of its own, so no blob is held in memory.
/// </para>
/// <para>
/// A run reads and writes the local database through one dedicated connection (not pooled, foreign keys checked off),
/// opened at the start of the run and closed at its end, whether the run ends normally or by an exception. Between its
/// transactions the run holds no statement and no transaction open on that connection, so it holds no local lock: other
/// connections write freely while the run talks to the server.
/// </para>
/// <para>
/// The change tracking must be in place in the local database before a run. The DI registration
/// (<c>AddGeneratedSyncEngine</c>) puts it in place: the local connection factory it registers checks it, and puts it in
/// place if it is missing, every time a connection opens. An engine built by hand calls
/// <see cref="SyncLocalTracking.Ensure"/> before the first run, or opens the local connections through a connection
/// factory that runs <see cref="SyncLocalTrackingGuard.OnStateChange"/> when a connection opens.
/// </para>
/// </remarks>
public sealed class SyncEngine
{
    /// <summary>The key of <see cref="Exception.Data"/> under which a <see cref="SyncAsync"/> that throws hands on the local rows it had changed on its own (an <see cref="IReadOnlyList{T}"/> of <see cref="SyncLocalRowChange"/>; see <see cref="SyncResult.LocalRowChanges"/>).</summary>
    public const string LocalRowChangesDataKey = "QuickER.Sync.LocalRowChanges";

    /// <summary>
    /// The most attempts one apply makes. Every attempt that finds a foreign key violation holds a row back or keeps a
    /// parent, so the attempts are bounded by the rows; this only stops a runaway.
    /// </summary>
    private const int MaxApplyAttempts = 200;

    /// <summary>The savepoint one row write runs inside.</summary>
    private const string WriteSavepoint = "quicker_sync_apply_write";

    /// <summary>The savepoint one rotation (delete and insert again) runs inside.</summary>
    private const string RotateSavepoint = "quicker_sync_apply_rotate";

    /// <summary>The buffer size of the temporary file an owed binary column passes through.</summary>
    private const int TemporaryFileBufferSize = 81920;

    private readonly IReadOnlyList<SyncTable> _tables;
    private readonly ILocalRowStore _rows;

    /// <summary>
    /// The number of rows one fetch of a sync or a download-only run may hold before it reads the unsent changes of the
    /// run's tables, and - when there are none - applies the rest of the download a chunk at a time (default 20,000).
    /// </summary>
    /// <remarks>
    /// A fetch at or under the threshold is applied in one transaction, which holds the local database's write lock for a
    /// time in proportion to its rows: the default keeps that transaction well under two seconds on a slow machine.
    /// </remarks>
    internal int ChunkThreshold { get; set; } = 20_000;

    /// <summary>The most rows one chunk of a download applied a chunk at a time holds (default 10,000).</summary>
    internal int ChunkSize { get; set; } = 10_000;

    /// <summary>
    /// The least time between the commit of one transaction of a download applied a chunk at a time and the start of the
    /// next (default 170 ms): when less has passed since the commit, the next transaction first waits for the rest.
    /// </summary>
    /// <remarks>
    /// Another connection waiting to write retries its lock only now and then - SQLite's busy handler (the
    /// <c>busy_timeout</c> setting) sleeps up to 100 ms between tries, and Microsoft.Data.Sqlite on a connection without a
    /// busy timeout sleeps 150 ms - so it does not get in through a gap shorter than that. Without the gap, the chunks
    /// applied from rows already fetched follow each other a millisecond or two apart, and such a writer waits for all of
    /// them. The default is over 150 ms by more than the Windows sleep granularity (about 15.6 ms), so a waiting writer
    /// gets in after at most the transaction it waits behind.
    /// </remarks>
    internal TimeSpan ChunkWriteGap { get; set; } = TimeSpan.FromMilliseconds(170);

    /// <summary>The clock that times <see cref="ChunkWriteGap"/> and waits for it (the system clock by default).</summary>
    internal TimeProvider TimeProvider { get; set; } = TimeProvider.System;

    /// <summary>
    /// Called once for every fetch of a run, as soon as the way it is applied is decided: in one transaction, a chunk at
    /// a time, or refused (null calls nothing).
    /// </summary>
    internal Action<SyncDownloadRoute>? DownloadRouteObserved { get; set; }

    /// <summary>
    /// Called with the number of carried rows each time a download applied a chunk at a time runs its last apply (the
    /// rows its chunks held back; not called when they held none back). Null calls nothing.
    /// </summary>
    internal Action<int>? CarriedRowsApplied { get; set; }

    /// <summary>Creates the engine over the synchronised tables, ordered parents first.</summary>
    /// <param name="tables">The synchronised tables in foreign-key order; every one shares the same local row store.</param>
    /// <exception cref="ArgumentException">No table is given, or the tables do not share one local row store.</exception>
    public SyncEngine(IEnumerable<SyncTable> tables)
    {
        ArgumentNullException.ThrowIfNull(tables);
        _tables = tables.ToList();

        if (_tables.Count == 0)
        {
            throw new ArgumentException("The engine needs at least one table.", nameof(tables));
        }

        _rows = _tables[0].Rows;

        if (_tables.Any(table => !ReferenceEquals(table.Rows, _rows)))
        {
            throw new ArgumentException("Every table of one engine shares the same local row store.", nameof(tables));
        }
    }

    /// <summary>Runs one full sync: sends the local changes, then pulls the server's changes down.</summary>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// A run that throws hands the local rows it had changed on its own on in the exception's
    /// <see cref="Exception.Data"/>, under <see cref="LocalRowChangesDataKey"/>.
    /// </remarks>
    /// <exception cref="SyncDownloadTooLargeException">The fetch went over <see cref="SyncOptions.DownloadRowLimit"/> while the run's tables held unsent changes, including the ones the run discards.</exception>
    public async Task<SyncResult> SyncAsync(
        SyncOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncOptions();
        var scope = ResolveScope(options);
        var changes = new SyncLocalRowChangeLog();

        try
        {
            return await RunExclusiveAsync(
                    async () =>
                    {
                        await RefuseEmptiedTablesAsync(scope, cancellationToken).ConfigureAwait(false);
                        var discards = await ReadCarriedDecisionsAsync(scope, cancellationToken)
                            .ConfigureAwait(false);
                        var conflicts = new List<SyncConflict>();
                        var (uploaded, discarded) = await UploadCoreAsync(
                                scope,
                                options,
                                conflicts,
                                discards,
                                cancellationToken
                            )
                            .ConfigureAwait(false);
                        var download = await DownloadCoreAsync(
                                scope,
                                options,
                                discards,
                                fetch: true,
                                changes,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        return new SyncResult(
                            uploaded,
                            download.Downloaded,
                            download.DeletedLocally,
                            discarded + download.Discarded,
                            conflicts
                        )
                        {
                            Truncations = download.Truncations,
                            LocalRowChanges = changes.ToList(),
                        };
                    },
                    cancellationToken
                )
                .ConfigureAwait(false);
        }
        catch (Exception failure)
        {
            failure.Data[LocalRowChangesDataKey] = changes.ToList();
            throw;
        }
    }

    /// <summary>Sends the local changes and returns how many went and how many were dropped.</summary>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="conflicts">The collection the collected conflicts are added to.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    public async Task<(int Uploaded, int Discarded)> UploadAsync(
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(options);
        ArgumentNullException.ThrowIfNull(conflicts);
        var scope = ResolveScope(options);

        return await RunExclusiveAsync(
                async () =>
                {
                    await RefuseEmptiedTablesAsync(scope, cancellationToken).ConfigureAwait(false);
                    var discards = await ReadCarriedDecisionsAsync(scope, cancellationToken).ConfigureAwait(false);
                    var (uploaded, discarded) = await UploadCoreAsync(
                            scope,
                            options,
                            conflicts,
                            discards,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    // With no download to follow, the rows ServerWins discards are put back here, each read from the server
                    // by key (nothing is fetched and no resume point moves)
                    if (discards.Count == 0)
                    {
                        return (uploaded, discarded);
                    }

                    var settled = await DownloadOnceAsync(
                            scope,
                            options,
                            discards,
                            fetch: false,
                            changes: null,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return (uploaded, discarded + settled.Discarded);
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Pulls the server's changes down and, unless it is turned off, removes the local rows the server dropped.</summary>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <exception cref="SyncDownloadTooLargeException">The fetch went over <see cref="SyncOptions.DownloadRowLimit"/> while the run's tables held unsent changes, including the ones the run discards.</exception>
    public async Task<(int Downloaded, int DeletedLocally)> DownloadAsync(
        SyncOptions options,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(options);
        var scope = ResolveScope(options);

        return await RunExclusiveAsync(
                async () =>
                {
                    await RefuseEmptiedTablesAsync(scope, cancellationToken).ConfigureAwait(false);
                    var discards = await ReadCarriedDecisionsAsync(scope, cancellationToken).ConfigureAwait(false);
                    var download = await DownloadCoreAsync(
                            scope,
                            options,
                            discards,
                            fetch: true,
                            changes: null,
                            cancellationToken
                        )
                        .ConfigureAwait(false);

                    return (download.Downloaded, download.DeletedLocally);
                },
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Rebuilds the tables of the run's scope as a copy of the server's.</summary>
    /// <param name="options">The knobs for this run (null takes the defaults).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// <para>
    /// The refusals come first, in this order, each before anything is read or written: a batch size or a download row
    /// limit that is not greater than zero, an excluded type the engine does not synchronise, unbounded binary columns
    /// neither carried nor given up (decided from the tables alone, without reading the database), a local row of a table
    /// outside the scope referring to a row of a table inside it, and unsent changes in the scope's tables unless
    /// <see cref="SyncRefreshOptions.Force"/> is set. A table found emptied outside a run is not refused: the refresh is
    /// what rebuilds it.
    /// </para>
    /// <para>
    /// The refresh then fetches every row of the scope's tables below one change ceiling and applies them the way a
    /// download does - one transaction, the same holding back for missing parents and colliding unique values - except
    /// that no row is skipped as an echo, every local row the server does not hold goes, the rows to be discarded (see
    /// <see cref="DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>) are replaced by the
    /// server's rows, and the other unsent changes are discarded when forced. Rows held back are fetched once more from the resume points; when some are still held, the
    /// run throws. A row the server changed after the ceiling is left to the next run. A row being discarded whose server
    /// row cannot be put in place (a local row the refresh does not replace holds its unique value) is left as it is: it
    /// stays unsent with its local content, its unbounded binary columns included, also when the refresh gives those
    /// columns up.
    /// </para>
    /// <para>
    /// A refresh whose fetch goes over 50,000 rows (or over <see cref="SyncRefreshOptions.DownloadRowLimit"/>) while the
    /// scope's tables hold no unsent change other than the rows it discards applies a chunk at a time instead, as a
    /// download does (see the remarks of <see cref="SyncEngine"/>). It is then not all or nothing: a refresh that
    /// fails keeps what it committed, and is run again to finish the rebuild.
    /// </para>
    /// <para>
    /// The counts are per table: <see cref="SyncRefreshTableResult.Deleted"/> is the local rows removed because the server
    /// does not hold them, and <see cref="SyncRefreshTableResult.Inserted"/> the server rows written locally, inserted or
    /// overwritten. <see cref="SyncRefreshResult.DiscardedChanges"/> is the number of rows whose unsent change the refresh
    /// actually discarded, by putting the server's row over the row or, for a row the server no longer holds, by dropping
    /// its change; a row written again on the device during the refresh keeps its change and is not counted.
    /// </para>
    /// </remarks>
    /// <exception cref="SyncUnboundedBinaryLossException">A table of the scope has unbounded binary columns and neither <see cref="SyncRefreshOptions.IncludeUnboundedBinary"/> nor <see cref="SyncRefreshOptions.DiscardLocalUnboundedBinaries"/> was set.</exception>
    /// <exception cref="SyncRefreshScopeException">A local row of a table outside the refresh refers to a row of a table it rebuilds.</exception>
    /// <exception cref="SyncPendingChangesException">The scope's tables hold unsent local changes other than rows to be discarded, and <see cref="SyncRefreshOptions.Force"/> was not set.</exception>
    /// <exception cref="SyncDownloadTooLargeException">The fetch went over <see cref="SyncRefreshOptions.DownloadRowLimit"/> while the scope's tables held unsent changes written during the refresh.</exception>
    public async Task<SyncRefreshResult> RefreshAsync(
        SyncRefreshOptions? options = null,
        CancellationToken cancellationToken = default
    )
    {
        options ??= new SyncRefreshOptions();

        if (options.BatchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.BatchSize,
                "The refresh batch size must be greater than zero."
            );
        }

        if (options.DownloadRowLimit <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.DownloadRowLimit,
                "The download row limit must be greater than zero."
            );
        }

        var scope = ResolveScope(options.Mode, options.ExcludedEntityTypes);

        if (!options.IncludeUnboundedBinary && !options.DiscardLocalUnboundedBinaries)
        {
            var atStake = scope
                .Where(table => table.UnboundedBinaryColumnNames.Count > 0)
                .Select(table => new SyncUnboundedBinaryColumns(table.TableName, table.UnboundedBinaryColumnNames))
                .ToList();

            if (atStake.Count > 0)
            {
                throw new SyncUnboundedBinaryLossException(atStake);
            }
        }

        var startedAt = Stopwatch.GetTimestamp();

        return await RunExclusiveAsync(
                () => RefreshCoreAsync(options, scope, startedAt, cancellationToken),
                cancellationToken
            )
            .ConfigureAwait(false);
    }

    /// <summary>Lists the unsent local changes of the engine's tables, in the order of the changes.</summary>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <remarks>
    /// Only rows of the tables the engine was put together with are listed. The list does not wait for a run on the same
    /// local database to end; a list read while a run is going on shows the state committed up to that point.
    /// </remarks>
    public async Task<IReadOnlyList<SyncPendingRow>> GetPendingChangesAsync(CancellationToken cancellationToken = default)
    {
        var byName = _tables.ToDictionary(table => table.TableName, StringComparer.Ordinal);
        await using var connection = await OpenDedicatedAsync(cancellationToken).ConfigureAwait(false);
        var listed = new List<SyncPendingRow>();

        foreach (var row in await SyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
        {
            if (!byName.TryGetValue(row.TableName, out var table))
            {
                continue;
            }

            listed.Add(
                new SyncPendingRow(
                    row.TableName,
                    table.KeyText(table.KeyOfRaw(row.RawKey)),
                    row.Deleted,
                    row.Known,
                    row.ServerWinsSequence == row.ChangeSequence,
                    row.ChangeSequence
                )
            );
        }

        return listed;
    }

    /// <summary>
    /// Discards the unsent changes of the rows given, each only while it is still unsent and its change number is still the
    /// one listed.
    /// </summary>
    /// <param name="rows">Rows listed by <see cref="GetPendingChangesAsync"/>.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many of the rows given are to be discarded after the call, counting the ones already marked.</returns>
    /// <remarks>
    /// <para>
    /// A discarded row stays unsent until a run carries the discard out: the next run whose scope covers its table
    /// (<see cref="SyncAsync"/>, <see cref="UploadAsync"/> or <see cref="DownloadAsync"/>), whatever its conflict policy,
    /// does not send the row and puts the server's row back over it, reading it from the server by key when the download
    /// does not bring it; a row the server does not hold goes from the device. A run that leaves the table out of its
    /// scope leaves the row as it is, still to be discarded.
    /// </para>
    /// <para>
    /// Writing the row again after the discard moves its change number on: the discard no longer applies, and what was
    /// written is sent. A row written again after it was listed is not discarded. A refresh
    /// (<see cref="RefreshAsync"/>) does not count a row to be discarded as an unsent change: forced or not, it replaces
    /// the row with the server's row (a row the server does not hold goes from the device). A row written again after the
    /// discard counts as unsent for the refresh as well.
    /// </para>
    /// <para>The call waits for a run on the same local database in this process to end, as the runs wait for each other.</para>
    /// </remarks>
    /// <exception cref="ArgumentNullException"><paramref name="rows"/> is null.</exception>
    /// <exception cref="ArgumentException">A row belongs to a table the engine does not synchronise; nothing is changed.</exception>
    public Task<int> DiscardPendingChangesAsync(
        IEnumerable<SyncPendingRow> rows,
        CancellationToken cancellationToken = default
    )
    {
        ArgumentNullException.ThrowIfNull(rows);
        var given = rows.ToList();
        var known = _tables.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        var unknown = given
            .Select(row => row.TableName)
            .Where(name => !known.Contains(name))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        if (unknown.Count > 0)
        {
            throw new ArgumentException(
                "The engine does not synchronise the table "
                    + string.Join(", ", unknown)
                    + "; discard only rows of the tables it synchronises.",
                nameof(rows)
            );
        }

        var wanted = given
            .GroupBy(row => (row.TableName, row.KeyText))
            .ToDictionary(group => group.Key, group => group.Select(row => row.ChangeNumber).ToHashSet());

        return MarkDiscardedAsync(
            (table, keyText, row) =>
                wanted.TryGetValue((table.TableName, keyText), out var numbers) && numbers.Contains(row.ChangeSequence),
            cancellationToken
        );
    }

    /// <summary>Discards every unsent change of the table of one entity type.</summary>
    /// <param name="entityType">The entity type of one of the engine's tables.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many rows are marked to be discarded.</returns>
    /// <remarks>
    /// The rows are discarded at the change numbers they have when the call runs, and the discard is carried out by later
    /// runs as with <see cref="DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>.
    /// </remarks>
    /// <exception cref="ArgumentNullException"><paramref name="entityType"/> is null.</exception>
    /// <exception cref="ArgumentException"><paramref name="entityType"/> is not a type the engine synchronises.</exception>
    public Task<int> DiscardPendingChangesAsync(Type entityType, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entityType);

        if (_tables.FirstOrDefault(candidate => candidate.EntityType == entityType) is not { } target)
        {
            throw new ArgumentException(
                "The engine does not synchronise "
                    + entityType.Name
                    + "; discard only the changes of the types it synchronises.",
                nameof(entityType)
            );
        }

        return MarkDiscardedAsync((table, _, _) => ReferenceEquals(table, target), cancellationToken);
    }

    /// <summary>Discards every unsent change of the engine's tables.</summary>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many rows are marked to be discarded.</returns>
    /// <remarks>
    /// The rows are discarded at the change numbers they have when the call runs, and the discard is carried out by later
    /// runs as with <see cref="DiscardPendingChangesAsync(IEnumerable{SyncPendingRow}, CancellationToken)"/>.
    /// </remarks>
    public Task<int> DiscardAllPendingChangesAsync(CancellationToken cancellationToken = default) =>
        MarkDiscardedAsync((_, _, _) => true, cancellationToken);

    /// <summary>
    /// Marks the unsent rows of the engine's tables the filter takes to be discarded at their current change numbers, read
    /// in the same write transaction, under the run lock.
    /// </summary>
    /// <param name="take">Whether to mark a row, given its table, its key text and its state.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>How many rows were marked.</returns>
    private Task<int> MarkDiscardedAsync(
        Func<SyncTable, string, SyncUnsentRow, bool> take,
        CancellationToken cancellationToken
    )
    {
        var byName = _tables.ToDictionary(table => table.TableName, StringComparer.Ordinal);

        return RunExclusiveAsync(
            async () =>
            {
                var connection = RunConnection;
                await SyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);

                try
                {
                    var marked = 0;

                    foreach (
                        var row in await SyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false)
                    )
                    {
                        if (
                            !byName.TryGetValue(row.TableName, out var table)
                            || !take(table, table.KeyText(table.KeyOfRaw(row.RawKey)), row)
                        )
                        {
                            continue;
                        }

                        // Read in this transaction, so the change number marked is the one the filter saw
                        await SyncState
                            .MarkServerWinsAsync(connection, row.TableName, row.RawKey, cancellationToken)
                            .ConfigureAwait(false);
                        marked++;
                    }

                    await SyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);

                    return marked;
                }
                catch
                {
                    try
                    {
                        await SyncState
                            .ExecuteAsync(connection, "ROLLBACK", CancellationToken.None)
                            .ConfigureAwait(false);
                    }
                    catch (DbException)
                    {
                        // The rollback failing must not hide what went wrong first
                    }

                    throw;
                }
            },
            cancellationToken
        );
    }

    /// <summary>The body of <see cref="RefreshAsync"/>, run under the run lock once the arguments have been checked.</summary>
    private async Task<SyncRefreshResult> RefreshCoreAsync(
        SyncRefreshOptions options,
        List<SyncTable> scope,
        long startedAt,
        CancellationToken cancellationToken
    )
    {
        var scopeTableNames = scope.Select(table => table.TableName).ToHashSet(StringComparer.Ordinal);
        var blocking = new List<SyncRefreshScopeReference>();
        IReadOnlyList<SyncUnsentRow> pending;

        {
            var connection = RunConnection;

            foreach (var table in scope)
            {
                foreach (
                    var referring in await table
                        .FindReferencesFromOutsideAsync(connection, scopeTableNames, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    blocking.Add(new SyncRefreshScopeReference(referring, table.TableName));
                }
            }

            if (blocking.Count > 0)
            {
                throw new SyncRefreshScopeException(blocking);
            }

            pending = (await SyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
                .Where(row => scopeTableNames.Contains(row.TableName))
                .ToList();
        }

        // A row marked to be discarded at its current change number is given up already: it does not stand in the way of
        // the refresh, forced or not. A row written again after it was marked has moved on and counts as unsent
        var unsent = pending.Where(row => row.ServerWinsSequence != row.ChangeSequence).ToList();

        if (unsent.Count > 0 && !options.Force)
        {
            throw new SyncPendingChangesException(
                unsent
                    .GroupBy(row => row.TableName, StringComparer.Ordinal)
                    .Select(group => new SyncPendingChange(group.Key, group.Count()))
                    .ToList()
            );
        }

        if (scope.Count == 0)
        {
            return new SyncRefreshResult([], 0, Stopwatch.GetElapsedTime(startedAt));
        }

        // Every unsent row left here is discarded (the rows marked to be discarded and, when forced, the rest), taking
        // the server's row when the fetch brings it
        var discards = new Dictionary<(string Table, string Key), SyncDiscard>();

        foreach (var row in pending)
        {
            var table = scope.First(candidate => candidate.TableName == row.TableName);
            var key = table.KeyOfRaw(row.RawKey);
            discards[(table.TableName, table.KeyText(key))] = new SyncDiscard(key, row.ChangeSequence);
        }

        var syncOptions = new SyncOptions
        {
            Mode = options.Mode,
            DownloadBatchSize = options.BatchSize,
            DownloadRowLimit = options.DownloadRowLimit,
            PropagateDeletes = true,
            IncludeUnboundedBinary = options.IncludeUnboundedBinary,
        };
        var refresh = new SyncRefresh(BlankBinaries: !options.IncludeUnboundedBinary);
        var first = await DownloadOnceAsync(
                scope,
                syncOptions,
                discards,
                true,
                null,
                cancellationToken,
                refresh,
                chunkable: true
            )
            .ConfigureAwait(false);
        var outcome = first;

        if (first.Truncations.Count > 0)
        {
            // The rows held back are fetched once more from the resume points the refresh left
            var second = await DownloadOnceAsync(
                    scope,
                    syncOptions,
                    [],
                    true,
                    null,
                    cancellationToken,
                    chunkable: true
                )
                .ConfigureAwait(false);
            outcome = new SyncDownload(
                first.Downloaded + second.Downloaded,
                first.DeletedLocally + second.DeletedLocally,
                second.Truncations
            )
            {
                Discarded = first.Discarded + second.Discarded,
                PerTable = scope.ToDictionary(
                    table => table.TableName,
                    table =>
                    {
                        var a = first.PerTable.GetValueOrDefault(table.TableName);
                        var b = second.PerTable.GetValueOrDefault(table.TableName);

                        return (a.Deleted + b.Deleted, a.Written + b.Written);
                    },
                    StringComparer.Ordinal
                ),
            };
        }

        if (outcome.Truncations.Count > 0)
        {
            throw new InvalidOperationException(
                "The refresh could not replace every row; these are held back: "
                    + string.Join(
                        ", ",
                        outcome.Truncations.Select(truncation => truncation.TableName + "/" + truncation.PendingKeyText)
                    )
            );
        }

        return new SyncRefreshResult(
            scope
                .Select(table =>
                {
                    var counts = outcome.PerTable.GetValueOrDefault(table.TableName);

                    return new SyncRefreshTableResult(table.TableName, counts.Deleted, counts.Written);
                })
                .ToList(),
            outcome.Discarded,
            Stopwatch.GetElapsedTime(startedAt)
        );
    }

    /// <summary>The tables a run covers, after checking the run's arguments.</summary>
    /// <param name="options">The knobs for the run.</param>
    /// <exception cref="ArgumentOutOfRangeException">The download batch size is not greater than zero.</exception>
    /// <exception cref="ArgumentException">An excluded type is not one the engine synchronises.</exception>
    private List<SyncTable> ResolveScope(SyncOptions options)
    {
        if (options.DownloadBatchSize <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.DownloadBatchSize,
                "The download batch size must be greater than zero."
            );
        }

        if (options.DownloadRowLimit <= 0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(options),
                options.DownloadRowLimit,
                "The download row limit must be greater than zero."
            );
        }

        return ResolveScope(options.Mode, options.ExcludedEntityTypes);
    }

    /// <summary>The tables a mode and a set of excluded types cover.</summary>
    /// <param name="mode">The run's mode (<see cref="SyncMode.Versioned"/> leaves the tables without a version column out).</param>
    /// <param name="excludedEntityTypes">The entity types the run leaves out.</param>
    /// <exception cref="ArgumentException">An excluded type is not one the engine synchronises.</exception>
    private List<SyncTable> ResolveScope(SyncMode mode, IReadOnlyCollection<Type> excludedEntityTypes)
    {
        var known = _tables.Select(table => table.EntityType).ToHashSet();
        var unknown = excludedEntityTypes.Where(type => !known.Contains(type)).ToList();

        if (unknown.Count > 0)
        {
            throw new ArgumentException(
                "The engine does not synchronise "
                    + string.Join(", ", unknown.Select(type => type.Name))
                    + "; exclude only the types it synchronises.",
                "options"
            );
        }

        var excluded = excludedEntityTypes.ToHashSet();

        return _tables
            .Where(table => !(mode == SyncMode.Versioned && table.IsVersionless))
            .Where(table => !excluded.Contains(table.EntityType))
            .ToList();
    }

    /// <summary>The locks that keep the runs on one local database in this process one at a time, by database file.</summary>
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, SemaphoreSlim> RunLocks =
        new(StringComparer.Ordinal);

    /// <summary>The lock of this engine's runs when the database has no file name to share a lock by (an in-memory database).</summary>
    private readonly SemaphoreSlim _ownRunLock = new(1, 1);

    /// <summary>
    /// The run's dedicated connection, set while a run holds the run lock and null outside a run (see
    /// <see cref="RunConnection"/>).
    /// </summary>
    private DbConnection? _runConnection;

    /// <summary>
    /// Runs the body while no other run on the same local database (the same <see cref="DbConnection.DataSource"/> once
    /// open) in this process is running: a run waits for the one before it to end.
    /// </summary>
    /// <remarks>
    /// The run's dedicated connection is opened first (its data source names the run lock), handed to the body through
    /// <see cref="RunConnection"/> once the lock is taken, and closed when the body ends - normally, by an exception or by
    /// cancellation, also while the lock is still being waited for - before the lock is released.
    /// </remarks>
    private async Task<T> RunExclusiveAsync<T>(Func<Task<T>> body, CancellationToken cancellationToken)
    {
        var connection = await OpenDedicatedAsync(cancellationToken).ConfigureAwait(false);
        SemaphoreSlim? held = null;

        try
        {
            var dataSource = connection.DataSource;
            var runLock = string.IsNullOrEmpty(dataSource)
                ? _ownRunLock
                : RunLocks.GetOrAdd(dataSource, static _ => new SemaphoreSlim(1, 1));
            await runLock.WaitAsync(cancellationToken).ConfigureAwait(false);
            held = runLock;
            _runConnection = connection;

            return await body().ConfigureAwait(false);
        }
        finally
        {
            if (held is not null)
            {
                _runConnection = null;
            }

            // Closed before the lock is released: the next run on the database starts with no connection of this run open
            await connection.DisposeAsync().ConfigureAwait(false);
            held?.Release();
        }
    }

    /// <summary>
    /// The run's dedicated connection: one connection from <see cref="ILocalRowStore.CreateDedicatedConnection"/>, open
    /// with foreign keys checked off from the start of the run to its end, that every read and write of the run's body uses.
    /// </summary>
    /// <exception cref="InvalidOperationException">Asked for outside a run (an internal error).</exception>
    private DbConnection RunConnection =>
        _runConnection
        ?? throw new InvalidOperationException(
            "The run's dedicated connection was asked for outside a run; only the body of a run, under the run lock, uses it."
        );

    /// <summary>
    /// Refuses the run when a table of its scope is empty locally while the row state table holds rows of it the server knows
    /// and that have nothing to send: the table appears to have been made again empty, and a run would send nothing for its
    /// missing rows and download only what changed since its resume point.
    /// </summary>
    /// <exception cref="SyncLocalTableEmptiedException">A table of the run's scope appears to have been made again empty.</exception>
    private async Task RefuseEmptiedTablesAsync(List<SyncTable> scope, CancellationToken cancellationToken)
    {
        var emptied = new List<string>();

        {
            var connection = RunConnection;

            foreach (var table in scope)
            {
                if (
                    await SyncState
                        .IsEmptiedAsync(connection, table.TableName, QualifiedName(table), cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    emptied.Add(table.TableName);
                }
            }
        }

        if (emptied.Count > 0)
        {
            throw new SyncLocalTableEmptiedException(emptied);
        }
    }

    /// <summary>
    /// Reads the <see cref="SyncConflictPolicy.ServerWins"/> decisions earlier runs could not carry out (rows still marked
    /// at their current change number): whatever this run's policy, such a row is not sent, and the server's content is put
    /// back over it.
    /// </summary>
    private async Task<Dictionary<(string Table, string Key), SyncDiscard>> ReadCarriedDecisionsAsync(
        List<SyncTable> scope,
        CancellationToken cancellationToken
    )
    {
        var byName = scope.ToDictionary(table => table.TableName, StringComparer.Ordinal);
        var discards = new Dictionary<(string Table, string Key), SyncDiscard>();

        var connection = RunConnection;

        foreach (var row in await SyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
        {
            if (row.ServerWinsSequence != row.ChangeSequence || !byName.TryGetValue(row.TableName, out var table))
            {
                continue;
            }

            var key = table.KeyOfRaw(row.RawKey);
            discards[(table.TableName, table.KeyText(key))] = new SyncDiscard(key, row.ChangeSequence);
        }

        return discards;
    }

    /// <summary>
    /// Sends the unsent changes of the run's tables, in rounds: the inserts and updates parents first, then the deletes
    /// children first; a write the server refused goes into the next round as long as the round got anything through.
    /// </summary>
    /// <remarks>
    /// A <see cref="SyncMode.Versioned"/> run under <see cref="SyncConflictPolicy.ServerWins"/> sends nothing and discards
    /// every unsent change of its tables. A <see cref="SyncMode.LastWriteWins"/> run (and every table without a version
    /// column) overwrites without a version check; <see cref="SyncConflictPolicy.LocalWins"/> settles a version conflict by
    /// overwriting. A failed write is explained by the server's state (a missing parent, a row still referring to the deleted
    /// one, another row holding a unique value); a failure nothing explains is thrown back unchanged. The rows a
    /// last-write-wins run under <see cref="SyncConflictPolicy.ServerWins"/> sees refused are discarded instead of reported.
    /// </remarks>
    /// <returns>How many changes reached the server, and how many were dropped with nothing to send.</returns>
    private async Task<(int Uploaded, int Discarded)> UploadCoreAsync(
        List<SyncTable> scope,
        SyncOptions options,
        ICollection<SyncConflict> conflicts,
        Dictionary<(string Table, string Key), SyncDiscard> discards,
        CancellationToken cancellationToken
    )
    {
        var byName = scope.ToDictionary(table => table.TableName, StringComparer.Ordinal);
        List<SyncQueued> queue;

        {
            var connection = RunConnection;
            queue = [];

            foreach (
                var row in await SyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false)
            )
            {
                if (!byName.TryGetValue(row.TableName, out var table))
                {
                    continue;
                }

                var key = table.KeyOfRaw(row.RawKey);
                var keyText = table.KeyText(key);

                // A row a carried decision is discarding is not sent
                if (!discards.ContainsKey((table.TableName, keyText)))
                {
                    queue.Add(new SyncQueued(table, row, key, keyText));
                }
            }
        }

        if (options is { Mode: SyncMode.Versioned, ConflictPolicy: SyncConflictPolicy.ServerWins })
        {
            foreach (var queued in queue)
            {
                discards[(queued.Table.TableName, queued.KeyText)] = new SyncDiscard(
                    queued.Key,
                    queued.Row.ChangeSequence
                );
            }

            return (0, 0);
        }

        var lastWriteWins = options.Mode == SyncMode.LastWriteWins;
        var uploaded = 0;
        var discarded = 0;
        var refused = new List<(SyncQueued Queued, EntityBaseCore? Local, SyncConflictReason Reason)>();

        while (queue.Count > 0)
        {
            refused.Clear();
            var progress = false;
            var withLocal = new List<(SyncQueued Queued, EntityBaseCore? Local)>(queue.Count);

            {
                var connection = RunConnection;

                foreach (var queued in queue)
                {
                    withLocal.Add(
                        (
                            queued,
                            await queued.Table.FindAsync(connection, queued.Key, cancellationToken).ConfigureAwait(false)
                        )
                    );
                }
            }

            var order = withLocal
                .Where(item => item.Local is not null)
                .OrderBy(item => IndexOf(item.Queued.Table))
                .ThenBy(item => item.Queued.Row.ChangeSequence)
                .Concat(
                    withLocal
                        .Where(item => item.Local is null)
                        .OrderByDescending(item => IndexOf(item.Queued.Table))
                        .ThenBy(item => item.Queued.Row.ChangeSequence)
                )
                .ToList();

            foreach (var (queued, local) in order)
            {
                var force = lastWriteWins || queued.Table.IsVersionless;
                var result = await queued
                    .Table.SendAsync(queued.Row, queued.Key, local, force, cancellationToken)
                    .ConfigureAwait(false);

                // LocalWins settles a version conflict by overwriting (a write the server refused is not settled this way)
                if (
                    result.Kind == SyncSendKind.Conflict
                    && options.ConflictPolicy == SyncConflictPolicy.LocalWins
                )
                {
                    result = await queued
                        .Table.SendAsync(
                            queued.Row,
                            queued.Key,
                            local,
                            force: true,
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }

                switch (result.Kind)
                {
                    case SyncSendKind.Discarded:
                        {
                            var connection = RunConnection;
                            await SyncState
                                .ForgetPendingAsync(
                                    connection,
                                    queued.Table.TableName,
                                    queued.Row.RawKey,
                                    queued.Row.ChangeSequence,
                                    cancellationToken
                                )
                                .ConfigureAwait(false);
                        }

                        discarded++;
                        break;

                    case SyncSendKind.Sent:
                        await SettleSentAsync(queued, result, options.IncludeUnboundedBinary, cancellationToken)
                            .ConfigureAwait(false);
                        uploaded++;
                        progress = true;
                        break;

                    case SyncSendKind.Conflict:
                        conflicts.Add(
                            new SyncConflict(
                                queued.Table.TableName,
                                queued.KeyText,
                                local is null ? SyncOperation.Delete : SyncOperation.Upsert,
                                result.Reason,
                                result.Local,
                                result.Server
                            )
                        );
                        break;

                    default:
                        SyncConflictReason? reason;

                        try
                        {
                            reason = await ExplainRefusalAsync(queued, local, cancellationToken).ConfigureAwait(false);
                        }
                        catch (Exception lookup) when (lookup is not OperationCanceledException)
                        {
                            throw new AggregateException(result.Error!, lookup);
                        }

                        if (reason is null)
                        {
                            // A failure none of the three reasons explains (a dropped connection, say) is thrown back as it was
                            System.Runtime.ExceptionServices.ExceptionDispatchInfo.Throw(result.Error!);
                        }

                        refused.Add((queued, local, reason.Value));
                        break;
                }
            }

            if (refused.Count == 0 || !progress)
            {
                break;
            }

            queue = [.. refused.Select(item => item.Queued)];
        }

        foreach (var (queued, local, reason) in refused)
        {
            // A last-write-wins run under ServerWins gives up the change the server refused and puts the server's row back
            if (lastWriteWins && options.ConflictPolicy == SyncConflictPolicy.ServerWins)
            {
                discards[(queued.Table.TableName, queued.KeyText)] = new SyncDiscard(
                    queued.Key,
                    queued.Row.ChangeSequence
                );
                continue;
            }

            conflicts.Add(
                new SyncConflict(
                    queued.Table.TableName,
                    queued.KeyText,
                    local is null ? SyncOperation.Delete : SyncOperation.Upsert,
                    reason,
                    local,
                    await queued.Table.ReadServerAsync(queued.Key, cancellationToken).ConfigureAwait(false)
                )
            );
        }

        return (uploaded, discarded);
    }

    /// <summary>
    /// Records a write that reached the server and sends its unbounded binary columns. When there are columns to send, the
    /// version the row write earned is recorded first (with every column kept as written for a row the server took as an
    /// insert), so that a failure while the columns go leaves the next run guarding against this device's own write; the
    /// columns are then copied up one by one through a temporary file, and the version is read back from the server, since
    /// writing a column moves it on. Last, in one short local transaction: the version becomes the row's base version and,
    /// while the row's change number is still the one read, the version the local row carries (its content stays as sent and
    /// the change is not recorded), and the row loses its unsent change only while its change number is still the one read.
    /// An overwrite without a version check leaves the server's other unbounded binary columns as they were, so the row owes
    /// them from the server.
    /// </summary>
    /// <remarks>
    /// The columns sent are every one for a row the server took as an insert (it gets its blobs from this device or not at
    /// all), otherwise the ones the device wrote; none at all for a run that does not carry them, whose settlement then
    /// drops the columns written along with the rest of the change.
    /// </remarks>
    private async Task SettleSentAsync(
        SyncQueued queued,
        SyncSend result,
        bool includeBinaries,
        CancellationToken cancellationToken
    )
    {
        var table = queued.Table;

        if (result.Deleted)
        {
            var deleteConnection = RunConnection;
            await SyncState
                .SettleDeletedAsync(
                    deleteConnection,
                    table.TableName,
                    queued.Row.RawKey,
                    queued.Row.ChangeSequence,
                    cancellationToken
                )
                .ConfigureAwait(false);
            return;
        }

        // The version the writer stamped on the row it accepted; read back from the server only when the writer left none
        // (a version read back can already be another writer's, written after this one)
        var version =
            table.IsVersionless ? null
            : result.Version is { } stamped ? stamped
            : await ReadBackVersionAsync(queued, cancellationToken).ConfigureAwait(false);

        List<string> columns =
            !includeBinaries || table.UnboundedBinaryColumnNames.Count == 0 ? []
            : result.Inserted ? table.UnboundedBinaryColumnNames.ToList()
            : SplitColumns(queued.Row.BlobColumns)
                .Where(column => table.UnboundedBinaryColumnNames.Contains(column, StringComparer.Ordinal))
                .ToList();

        // An overwrite without a version check does not touch the server's columns this run does not send
        List<string> owedByOverwrite =
            result.Forced && !result.Inserted
                ? table.UnboundedBinaryColumnNames.Except(columns, StringComparer.Ordinal).ToList()
                : [];

        if (columns.Count > 0)
        {
            {
                var interim = RunConnection;
                await SyncState
                    .RecordInterimAsync(
                        interim,
                        table.TableName,
                        queued.Row.RawKey,
                        version,
                        result.Inserted ? table.UnboundedBinaryColumnNames : [],
                        owedByOverwrite,
                        cancellationToken
                    )
                    .ConfigureAwait(false);
            }

            owedByOverwrite = [];

            foreach (var column in columns)
            {
                await SendBinaryAsync(table, queued.Key, column, cancellationToken).ConfigureAwait(false);
            }

            if (!table.IsVersionless)
            {
                version = await ReadBackVersionAsync(queued, cancellationToken).ConfigureAwait(false);
            }
        }

        var connection = RunConnection;
        await SyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);

        try
        {
            if (owedByOverwrite.Count > 0)
            {
                await SyncState
                    .AddOwedAsync(connection, table.TableName, queued.Row.RawKey, owedByOverwrite, cancellationToken)
                    .ConfigureAwait(false);
            }

            // The local row takes the version the server gave it, its content left as sent - only while its change number
            // is still the one read: a row edited since keeps what the device wrote
            if (version is not null)
            {
                var current = await SyncState
                    .ReadRowAsync(connection, table.TableName, queued.Row.RawKey, cancellationToken)
                    .ConfigureAwait(false);

                if (
                    current?.ChangeSequence == queued.Row.ChangeSequence
                    && await table.FindAsync(connection, queued.Key, cancellationToken).ConfigureAwait(false) is { } local
                )
                {
                    await SyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false);
                    table.SetVersion(local, version);
                    await table.UpdateAsync(connection, local, cancellationToken).ConfigureAwait(false);
                    await SyncState.SetApplyingAsync(connection, false, cancellationToken).ConfigureAwait(false);
                }
            }

            await SyncState
                .SettleSentAsync(
                    connection,
                    table.TableName,
                    queued.Row.RawKey,
                    version,
                    queued.Row.ChangeSequence,
                    result.Forced,
                    cancellationToken
                )
                .ConfigureAwait(false);
            await SyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);
        }
        catch
        {
            try
            {
                await SyncState.ExecuteAsync(connection, "ROLLBACK", CancellationToken.None).ConfigureAwait(false);
            }
            catch (DbException)
            {
                // The rollback failing must not hide what went wrong first
            }

            throw;
        }
    }

    /// <summary>Reads the version the server holds for a row this run has just written.</summary>
    private static async Task<byte[]?> ReadBackVersionAsync(SyncQueued queued, CancellationToken cancellationToken) =>
        queued.Table.VersionOf(
            await queued.Table.ReadServerAsync(queued.Key, cancellationToken).ConfigureAwait(false)
                ?? throw new InvalidOperationException(
                    $"The row of '{queued.Table.TableName}' with the key '{queued.KeyText}' was written to the server but cannot be read back."
                )
        );

    /// <summary>
    /// Copies one unbounded binary column of a local row up to the server through a temporary file: the local column is read
    /// and the read is closed before the server write, so with no statement and no transaction open on the run's connection
    /// no local lock is held while the bytes travel. A column
    /// NULL locally sets the server's column to NULL, so the two sides end up alike. A row gone locally since it was read
    /// sends nothing: its delete is a later change, which keeps the row unsent and goes next.
    /// </summary>
    private async Task SendBinaryAsync(
        SyncTable table,
        object key,
        string column,
        CancellationToken cancellationToken
    )
    {
        await using var file = CreateTemporaryFile();
        bool present;

        {
            var connection = RunConnection;
            present = await table
                .ReadLocalBinaryAsync(connection, key, column, file, cancellationToken)
                .ConfigureAwait(false);

            if (!present && !await table.ExistsAsync(connection, key, cancellationToken).ConfigureAwait(false))
            {
                return;
            }
        }

        if (!present)
        {
            await table.WriteServerBinaryAsync(column, key, null, null, cancellationToken).ConfigureAwait(false);
            return;
        }

        file.Position = 0;
        await table.WriteServerBinaryAsync(column, key, file, file.Length, cancellationToken).ConfigureAwait(false);
    }

    /// <summary>A temporary file that goes when it is closed (where unbounded binary columns pass between the two sides).</summary>
    private static FileStream CreateTemporaryFile() =>
        new(
            Path.Combine(Path.GetTempPath(), "quicker-sync-" + Guid.NewGuid().ToString("N") + ".tmp"),
            FileMode.CreateNew,
            FileAccess.ReadWrite,
            FileShare.None,
            TemporaryFileBufferSize,
            FileOptions.DeleteOnClose | FileOptions.Asynchronous
        );

    /// <summary>
    /// Why the server refused a write, by its state: a parent the row points at is gone (an insert or update), a row of a
    /// synchronised table still refers to it (a delete of a row the server still holds), or another row holds one of its
    /// unique values; null when none of these holds.
    /// </summary>
    private async Task<SyncConflictReason?> ExplainRefusalAsync(
        SyncQueued queued,
        EntityBaseCore? local,
        CancellationToken cancellationToken
    )
    {
        if (local is not null)
        {
            foreach (var (parentTableName, parentKeyText) in queued.Table.ParentsOf(local))
            {
                if (
                    parentKeyText is not null
                    && TableNamedInEngine(parentTableName) is { } parent
                    && !await parent.ServerHasAsync(parentKeyText, cancellationToken).ConfigureAwait(false)
                )
                {
                    return SyncConflictReason.ParentMissingOnServer;
                }
            }

            return await queued.Table.CollidesOnServerAsync(local, cancellationToken).ConfigureAwait(false)
                ? SyncConflictReason.UniqueValueTakenOnServer
                : null;
        }

        if (await queued.Table.ReadServerAsync(queued.Key, cancellationToken).ConfigureAwait(false) is null)
        {
            return null;
        }

        foreach (var table in _tables)
        {
            if (
                await table
                    .ServerReferencesAsync(queued.Table.TableName, queued.KeyText, cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                return SyncConflictReason.DeleteRefusedOnServer;
            }
        }

        return null;
    }

    /// <summary>The position of a table in foreign-key order.</summary>
    private int IndexOf(SyncTable table)
    {
        for (var index = 0; index < _tables.Count; index++)
        {
            if (ReferenceEquals(_tables[index], table))
            {
                return index;
            }
        }

        throw new ArgumentOutOfRangeException(nameof(table));
    }

    /// <summary>The table of the engine with the table name (null when none has).</summary>
    private SyncTable? TableNamedInEngine(string tableName) =>
        _tables.FirstOrDefault(table => string.Equals(table.TableName, tableName, StringComparison.Ordinal));

    /// <summary>
    /// Fetches and applies the server's changes, and - when the apply held rows back - takes the ceiling again and
    /// fetches and applies once more from the resume points.
    /// </summary>
    private async Task<SyncDownload> DownloadCoreAsync(
        List<SyncTable> scope,
        SyncOptions options,
        Dictionary<(string Table, string Key), SyncDiscard> discards,
        bool fetch,
        SyncLocalRowChangeLog? changes,
        CancellationToken cancellationToken
    )
    {
        var first = await DownloadOnceAsync(
                scope,
                options,
                discards,
                fetch,
                changes,
                cancellationToken,
                chunkable: true
            )
            .ConfigureAwait(false);

        if (first.Truncations.Count == 0)
        {
            return first;
        }

        // The second pass does not discard again: the rows the first pass could not put back are marked and carried
        var second = await DownloadOnceAsync(scope, options, [], fetch, changes, cancellationToken, chunkable: true)
            .ConfigureAwait(false);

        return new SyncDownload(
            first.Downloaded + second.Downloaded,
            first.DeletedLocally + second.DeletedLocally,
            second.Truncations
        )
        {
            Discarded = first.Discarded + second.Discarded,
        };
    }

    /// <summary>
    /// One fetch and one apply of every table of the run (the owed binary columns are copied before and after). Without a
    /// fetch, only the rows being discarded are put back, each read from the server by key. A refresh fetches every row
    /// from the start and reads no row by key: a row being discarded that the fetch did not bring only loses its change.
    /// </summary>
    /// <remarks>
    /// When <paramref name="chunkable"/> is set and the rows fetched go over <see cref="ChunkThreshold"/> while the run's
    /// tables hold no unsent change (or over the download row limit with none), the rest of the download is applied a
    /// chunk at a time instead (<see cref="ChunkedDownload"/>).
    /// </remarks>
    private async Task<SyncDownload> DownloadOnceAsync(
        List<SyncTable> scope,
        SyncOptions options,
        Dictionary<(string Table, string Key), SyncDiscard> discards,
        bool fetch,
        SyncLocalRowChangeLog? changes,
        CancellationToken cancellationToken,
        SyncRefresh? refresh = null,
        bool chunkable = false
    )
    {
        if (fetch && options.IncludeUnboundedBinary)
        {
            await CopyOwedBinariesAsync(scope, cancellationToken).ConfigureAwait(false);
        }

        Dictionary<string, byte[]?> anchors;

        {
            var connection = RunConnection;
            anchors = await SyncState.ReadAnchorsAsync(connection, cancellationToken).ConfigureAwait(false);
        }

        // The ceiling is taken once and shared by every table: a ceiling per table would leave a parent written after an
        // earlier table's ceiling out while its child, under a later table's ceiling, comes down
        var versioned = scope.FirstOrDefault(table => !table.IsVersionless);
        var ceiling =
            !fetch || versioned is null
                ? null
                : await versioned.GetCeilingAsync(cancellationToken).ConfigureAwait(false);
        var plans = new List<SyncApplyPlan>(scope.Count);

        // The rows fetched are counted across the tables; the first time the count goes over the limit the unsent
        // changes are read once, and the run is refused before anything is applied when there are any
        var fetchedRowCount = 0;
        var limitChecked = false;

        // A fetch past the chunk threshold reads the unsent changes once (a refresh leaves out the rows it discards): with
        // none, the rest of the download is applied a chunk at a time
        chunkable = chunkable && fetch;
        var thresholdChecked = false;
        ChunkedDownload? chunked = null;

        for (var index = 0; index < scope.Count; index++)
        {
            var table = scope[index];
            var anchor = table.IsVersionless || refresh is not null ? null : anchors.GetValueOrDefault(table.TableName);
            var rows = new List<EntityBaseCore>();
            IReadOnlySet<string>? serverKeys = null;

            if (fetch)
            {
                await foreach (
                    var page in table
                        .FetchPagesAsync(anchor, ceiling, options.DownloadBatchSize, cancellationToken)
                        .ConfigureAwait(false)
                )
                {
                    if (chunked is not null)
                    {
                        await chunked.AddAsync(table, page, cancellationToken).ConfigureAwait(false);
                        continue;
                    }

                    rows.AddRange(page);
                    fetchedRowCount += page.Count;

                    if (chunkable && !thresholdChecked && fetchedRowCount > ChunkThreshold)
                    {
                        thresholdChecked = true;

                        if (
                            (
                                await ReadUnsentInScopeAsync(scope, discards, refresh is not null, cancellationToken)
                                    .ConfigureAwait(false)
                            ).Count == 0
                        )
                        {
                            chunked = await EnterChunkedDownloadAsync(
                                    scope,
                                    index,
                                    plans,
                                    rows,
                                    refresh is null ? anchors : [],
                                    options,
                                    changes,
                                    refresh,
                                    discards,
                                    cancellationToken
                                )
                                .ConfigureAwait(false);
                            continue;
                        }
                    }

                    if (!limitChecked && fetchedRowCount > options.DownloadRowLimit)
                    {
                        limitChecked = true;
                        var unsent = await ReadUnsentInScopeAsync(
                                scope,
                                discards,
                                refresh is not null,
                                cancellationToken
                            )
                            .ConfigureAwait(false);

                        if (unsent.Count > 0)
                        {
                            DownloadRouteObserved?.Invoke(SyncDownloadRoute.Refused);

                            throw DownloadTooLarge(scope, unsent, fetchedRowCount, options.DownloadRowLimit);
                        }

                        if (chunkable)
                        {
                            chunked = await EnterChunkedDownloadAsync(
                                    scope,
                                    index,
                                    plans,
                                    rows,
                                    refresh is null ? anchors : [],
                                    options,
                                    changes,
                                    refresh,
                                    discards,
                                    cancellationToken
                                )
                                .ConfigureAwait(false);
                        }
                    }
                }

                if (chunked is not null)
                {
                    await chunked.FinishTableAsync(table, cancellationToken).ConfigureAwait(false);
                    continue;
                }

                if (options.PropagateDeletes)
                {
                    serverKeys = await table.FetchServerKeysAsync(cancellationToken).ConfigureAwait(false);
                }
            }

            // A row being discarded takes the server's row from what was fetched, or else is read from the server by key
            // (a row nobody else changed is not among the changes)
            var tableDiscards = new Dictionary<string, SyncPlanDiscard>(StringComparer.Ordinal);
            var wanted = discards
                .Where(discard => discard.Key.Table == table.TableName)
                .ToDictionary(discard => discard.Key.Key, discard => discard.Value, StringComparer.Ordinal);

            if (wanted.Count > 0)
            {
                var fetchedByKey = new Dictionary<string, EntityBaseCore>(StringComparer.Ordinal);

                foreach (var row in rows)
                {
                    var keyText = table.KeyText(table.KeyOf(row));

                    if (wanted.ContainsKey(keyText))
                    {
                        fetchedByKey[keyText] = row;
                    }
                }

                foreach (var (keyText, discard) in wanted)
                {
                    tableDiscards[keyText] = new SyncPlanDiscard(
                        discard.Key,
                        discard.Sequence,
                        fetchedByKey.TryGetValue(keyText, out var server) ? server
                        : refresh is not null ? null
                        : await table.ReadServerAsync(discard.Key, cancellationToken).ConfigureAwait(false)
                    );
                }
            }

            plans.Add(
                new SyncApplyPlan(table, rows, serverKeys, anchor)
                {
                    Discards = tableDiscards,
                    Refresh = refresh,
                }
            );
        }

        if (chunked is not null)
        {
            var chunkedOutcome = await chunked.FinishAsync(cancellationToken).ConfigureAwait(false);

            if (options.IncludeUnboundedBinary)
            {
                await CopyOwedBinariesAsync(scope, cancellationToken).ConfigureAwait(false);
            }

            return chunkedOutcome;
        }

        if (fetch)
        {
            DownloadRouteObserved?.Invoke(SyncDownloadRoute.Single);
        }

        var outcome = await ApplyAsync(plans, options.IncludeUnboundedBinary, advanceAnchors: fetch, cancellationToken)
            .ConfigureAwait(false);

        // The rows the apply changed on its own are noted right after its commit, so a failed copy below still hands
        // them on
        foreach (var change in outcome.Changes)
        {
            changes?.Add(change.TableName, change.KeyText, change.Reason);
        }

        if (options.IncludeUnboundedBinary)
        {
            await CopyOwedBinariesAsync(scope, cancellationToken).ConfigureAwait(false);
        }

        return outcome;
    }

    /// <summary>
    /// Switches a fetch to applying a chunk at a time: takes the server keys of the tables not keyed yet (the table being
    /// fetched and the ones after it, in order, when delete propagation is on), runs the delete propagation of every table
    /// in a transaction of its own, and then applies the rows fetched so far as chunks, table by table.
    /// </summary>
    /// <remarks>
    /// For a refresh, that transaction also does what a refresh does to the whole of each table: it forgets the rows
    /// neither side holds, gives the unbounded binary columns up when the refresh does, settles the rows it discards that
    /// the server no longer holds, and sets every table's resume point back to nothing fetched, from which the chunks move
    /// it.
    /// </remarks>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="index">The position in <paramref name="scope"/> of the table being fetched.</param>
    /// <param name="plans">The tables fetched in full so far, with their rows and server keys.</param>
    /// <param name="rows">The rows of the table being fetched, so far.</param>
    /// <param name="anchors">The resume points the fetch started from, by table name (empty for a refresh).</param>
    /// <param name="options">The knobs for this run.</param>
    /// <param name="changes">Where the rows the run changes on its own are noted (null for nowhere).</param>
    /// <param name="refresh">The refresh the fetch belongs to (null for an ordinary download).</param>
    /// <param name="discards">The rows the run discards (only a refresh enters with any).</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<ChunkedDownload> EnterChunkedDownloadAsync(
        List<SyncTable> scope,
        int index,
        List<SyncApplyPlan> plans,
        List<EntityBaseCore> rows,
        Dictionary<string, byte[]?> anchors,
        SyncOptions options,
        SyncLocalRowChangeLog? changes,
        SyncRefresh? refresh,
        Dictionary<(string Table, string Key), SyncDiscard> discards,
        CancellationToken cancellationToken
    )
    {
        DownloadRouteObserved?.Invoke(SyncDownloadRoute.Chunked);
        var chunked = new ChunkedDownload(this, anchors, options.IncludeUnboundedBinary, changes, refresh, discards);

        if (options.PropagateDeletes)
        {
            var deletions = plans.Select(plan => chunked.DeletionPlan(plan.Table, plan.ServerKeys)).ToList();

            // The keys of the table being fetched and of the ones after it are taken before the rest of their rows
            for (var later = index; later < scope.Count; later++)
            {
                deletions.Add(
                    chunked.DeletionPlan(
                        scope[later],
                        await scope[later].FetchServerKeysAsync(cancellationToken).ConfigureAwait(false)
                    )
                );
            }

            await chunked.ApplyDeletionsAsync(deletions, cancellationToken).ConfigureAwait(false);
        }

        foreach (var plan in plans)
        {
            await chunked.AddAsync(plan.Table, plan.Rows, cancellationToken).ConfigureAwait(false);
            await chunked.FinishTableAsync(plan.Table, cancellationToken).ConfigureAwait(false);
        }

        await chunked.AddAsync(scope[index], rows, cancellationToken).ConfigureAwait(false);

        return chunked;
    }

    /// <summary>
    /// Reads the unsent changes of the tables of the run (table and key text). The unsent rows of tables outside the run
    /// are not counted. A run counts the rows it is about to discard as unsent; a refresh does not count the rows it
    /// discards when forced, unless they were written again since (their change number is no longer the one the discard
    /// was decided on, so the apply keeps them).
    /// </summary>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="discards">The rows the run discards.</param>
    /// <param name="refreshing">Whether the run is a refresh.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private async Task<HashSet<(string Table, string Key)>> ReadUnsentInScopeAsync(
        List<SyncTable> scope,
        Dictionary<(string Table, string Key), SyncDiscard> discards,
        bool refreshing,
        CancellationToken cancellationToken
    )
    {
        var unsent = new HashSet<(string Table, string Key)>();

        {
            var connection = RunConnection;

            foreach (var row in await SyncState.ReadPendingAsync(connection, cancellationToken).ConfigureAwait(false))
            {
                var table = scope.FirstOrDefault(candidate =>
                    string.Equals(candidate.TableName, row.TableName, StringComparison.Ordinal)
                );

                if (table is null)
                {
                    continue;
                }

                var key = (table.TableName, table.KeyText(table.KeyOfRaw(row.RawKey)));

                // A refresh leaves out a row it discards when forced, only while the row is still at the change the
                // discard was decided on: a row written again since is kept by the apply, so it is unsent
                if (
                    refreshing
                    && discards.TryGetValue(key, out var discard)
                    && discard.Sequence == row.ChangeSequence
                )
                {
                    continue;
                }

                unsent.Add(key);
            }
        }

        if (!refreshing)
        {
            foreach (var key in discards.Keys)
            {
                if (scope.Exists(table => string.Equals(table.TableName, key.Table, StringComparison.Ordinal)))
                {
                    unsent.Add(key);
                }
            }
        }

        return unsent;
    }

    /// <summary>The refusal of a fetch that went over the download row limit while the tables of the run held unsent changes.</summary>
    /// <param name="scope">The tables of the run.</param>
    /// <param name="unsent">The unsent changes of the tables of the run (<see cref="ReadUnsentInScopeAsync"/>).</param>
    /// <param name="fetchedRowCount">The rows fetched so far.</param>
    /// <param name="rowLimit">The limit the fetch went over.</param>
    private static SyncDownloadTooLargeException DownloadTooLarge(
        List<SyncTable> scope,
        HashSet<(string Table, string Key)> unsent,
        int fetchedRowCount,
        int rowLimit
    ) =>
        new(
            fetchedRowCount,
            rowLimit,
            scope
                .Select(table => new SyncPendingChange(
                    table.TableName,
                    unsent.Count(key => string.Equals(key.Table, table.TableName, StringComparison.Ordinal))
                ))
                .Where(change => change.Count > 0)
                .ToList()
        );

    /// <summary>
    /// Applies the fetched rows in one transaction. A foreign key violation rolls the attempt back and starts it again
    /// with the child it wrote held back, or with the parent it deleted kept.
    /// </summary>
    private async Task<SyncDownload> ApplyAsync(
        List<SyncApplyPlan> plans,
        bool owesBinaries,
        bool advanceAnchors,
        CancellationToken cancellationToken
    )
    {
        // Rows held back (table, key text -> the missing parent's table, or null) and parents not to delete
        var held = new Dictionary<(string Table, string Key), string?>();
        var keep = new HashSet<(string Table, string Key)>();

        // The violations the database already had before the apply wrote anything: not this apply's doing, so they do not
        // stop it. Read only once an attempt finds violations (the check scans the whole database, and an apply that
        // leaves none needs one check, not two), and kept across the attempts
        HashSet<(string ChildTable, string ChildKey, string ParentTable, long ForeignKey)>? existing = null;

        for (var attempt = 0; attempt < MaxApplyAttempts; attempt++)
        {
            // Every attempt runs on the run's connection: the attempt before rolled back, so it starts on the state the
            // apply began with
            var connection = RunConnection;
            await SyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);
            var open = true;

            try
            {
                await SyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false);

                var run = new ApplyAttempt(connection, held, keep);

                // Delete propagation runs in every table before any row is written, so a value a removed row holds is
                // free for the server row that takes it
                foreach (var plan in plans)
                {
                    if (plan.ReadsStatesByKey)
                    {
                        // Only the plan's own rows: the transaction reads nothing in proportion to the table
                        var (states, rawKeys) = await SyncState
                            .ReadRowsByKeyAsync(
                                connection,
                                plan.Table.TableName,
                                QualifiedName(plan.Table),
                                Identifier(plan.Table.LocalKeyColumnName),
                                plan
                                    .Rows.Select(plan.Table.KeyOf)
                                    .Concat(plan.Discards.Values.Select(discard => discard.Key))
                                    .ToList(),
                                plan.Table.KeyTextOfRaw,
                                cancellationToken
                            )
                            .ConfigureAwait(false);
                        run.States[plan.Table.TableName] = states;
                        run.KnowRawKeys(plan.Table, rawKeys);
                    }
                    else
                    {
                        run.States[plan.Table.TableName] = await SyncState
                            .ReadRowsAsync(connection, plan.Table.TableName, plan.Table.KeyTextOfRaw, cancellationToken)
                            .ConfigureAwait(false);
                    }

                    await SettleDiscardsWithoutServerRowAsync(run, plan, cancellationToken).ConfigureAwait(false);
                    await PropagateDeletesAsync(run, plan, cancellationToken).ConfigureAwait(false);

                    if (plan.Refresh is not null && plan.RunsTableWideSteps)
                    {
                        await ForgetRowsGoneOnBothSidesAsync(run, plan, cancellationToken).ConfigureAwait(false);
                    }
                }

                foreach (var plan in plans)
                {
                    await WriteRowsAsync(run, plan, owesBinaries, cancellationToken).ConfigureAwait(false);
                }

                var violations = (await ForeignKeyViolationsAsync(connection, cancellationToken).ConfigureAwait(false))
                    .Where(violation => existing is null || !existing.Contains(violation.Identity))
                    .ToList();

                if (violations.Count > 0)
                {
                    await SyncState.ExecuteAsync(connection, "ROLLBACK", CancellationToken.None).ConfigureAwait(false);
                    open = false;

                    // With the attempt rolled back, the database is as it was before the apply wrote anything: what it
                    // reports now is what it already had
                    if (existing is null)
                    {
                        existing = (await ForeignKeyViolationsAsync(connection, cancellationToken).ConfigureAwait(false))
                            .Select(violation => violation.Identity)
                            .ToHashSet();
                        violations = violations.Where(violation => !existing.Contains(violation.Identity)).ToList();

                        if (violations.Count == 0)
                        {
                            continue;
                        }
                    }

                    var changed = false;
                    var lookups = new List<SyncViolation>();

                    foreach (var violation in violations)
                    {
                        if (run.Written.Contains(violation.Child) && !held.ContainsKey(violation.Child))
                        {
                            held[violation.Child] = violation.ParentTable;
                            changed = true;
                        }
                        else if (violation.Parent is { } parent && run.Deleted.Contains(parent) && keep.Add(parent))
                        {
                            changed = true;
                        }
                        else if (violation.Parent is null && violation.LookupColumns is not null)
                        {
                            lookups.Add(violation);
                        }
                    }

                    // A foreign key to a column other than the primary key names its parent by that column's values:
                    // with the delete rolled back the parent is there again, and is looked up by them
                    foreach (var violation in lookups)
                    {
                        if (
                            await FindParentKeyTextAsync(connection, violation, cancellationToken).ConfigureAwait(false)
                                is { } parentKey
                            && run.Deleted.Contains(parentKey)
                            && keep.Add(parentKey)
                        )
                        {
                            changed = true;
                        }
                    }

                    if (!changed)
                    {
                        throw new InvalidOperationException(
                            "The download left foreign key violations it cannot explain: "
                                + string.Join(
                                    "; ",
                                    violations.Select(violation =>
                                        violation.Child.Table
                                        + "/"
                                        + violation.Child.Key
                                        + " -> "
                                        + violation.ParentTable
                                        + "/"
                                        + (violation.Parent?.Key ?? "?")
                                    )
                                )
                        );
                    }

                    continue;
                }

                var truncations = new List<SyncDownloadTruncation>();

                foreach (var plan in plans)
                {
                    await SaveResumePointAsync(run, plan, truncations, advanceAnchors, cancellationToken)
                        .ConfigureAwait(false);
                }

                await SyncState.SetApplyingAsync(connection, false, cancellationToken).ConfigureAwait(false);
                await SyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);
                open = false;

                return new SyncDownload(run.Downloaded, run.DeletedLocally, truncations)
                {
                    Discarded = run.Discarded,
                    Changes = run.Changes,
                    PerTable = plans.ToDictionary(
                        plan => plan.Table.TableName,
                        plan =>
                            (
                                run.Deleted.Count(row => row.Table == plan.Table.TableName),
                                run.Written.Count(row => row.Table == plan.Table.TableName)
                            ),
                        StringComparer.Ordinal
                    ),
                };
            }
            catch
            {
                if (open)
                {
                    try
                    {
                        await SyncState
                            .ExecuteAsync(connection, "ROLLBACK", CancellationToken.None)
                            .ConfigureAwait(false);
                    }
                    catch (DbException)
                    {
                        // The rollback failing must not hide what went wrong first
                    }
                }

                throw;
            }
        }

        throw new InvalidOperationException(
            "The download did not settle within "
                + MaxApplyAttempts.ToString(CultureInfo.InvariantCulture)
                + " attempts."
        );
    }

    /// <summary>
    /// Deletes the local rows of one table the server no longer has, except the rows with an unsent change and the
    /// parents an earlier attempt found it must keep.
    /// </summary>
    private static async Task PropagateDeletesAsync(
        ApplyAttempt run,
        SyncApplyPlan plan,
        CancellationToken cancellationToken
    )
    {
        if (plan.ServerKeys is not { } serverKeys)
        {
            return;
        }

        var table = plan.Table;
        var states = run.States[table.TableName];

        foreach (var key in await table.ListKeysAsync(run.Connection, cancellationToken).ConfigureAwait(false))
        {
            var keyText = table.KeyText(key);

            if (
                serverKeys.Contains(keyText)
                || run.Keep.Contains((table.TableName, keyText))
                || states.GetValueOrDefault(keyText) is { Dirty: true }
            )
            {
                continue;
            }

            await table.DeleteAsync(run.Connection, key, cancellationToken).ConfigureAwait(false);

            if (states.Remove(keyText, out var state))
            {
                await SyncState
                    .RemoveRowAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                    .ConfigureAwait(false);
            }

            run.Deleted.Add((table.TableName, keyText));
            run.DeletedLocally++;
        }
    }

    /// <summary>
    /// For a refresh: removes the states of the rows neither side holds any more (the server does not, and the local table
    /// has no such row), so that a row made later under the same key is not taken for one the server knows; and, when the
    /// refresh gives the unbounded binary columns up, drops what earlier runs left owing.
    /// </summary>
    private static async Task ForgetRowsGoneOnBothSidesAsync(
        ApplyAttempt run,
        SyncApplyPlan plan,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var states = run.States[table.TableName];

        foreach (var (keyText, state) in states.ToList())
        {
            if (
                state.Dirty
                || plan.ServerKeys is { } serverKeys && serverKeys.Contains(keyText)
                || await table
                    .ExistsAsync(run.Connection, table.KeyOfRaw(state.RawKey), cancellationToken)
                    .ConfigureAwait(false)
            )
            {
                continue;
            }

            await SyncState
                .RemoveRowAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                .ConfigureAwait(false);
            states.Remove(keyText);
        }

        if (plan.Refresh is { BlankBinaries: true } && table.UnboundedBinaryColumnNames.Count > 0)
        {
            // Every local row of the table without an unsent change loses its columns here, in the apply's transaction - also
            // a row the refresh does not write (one the server changed after the ceiling) and a row written later by a fetch
            // held back: what a row written afterwards brings carries no columns either. A row with an unsent change keeps
            // them: one the refresh does not discard (it was written while the refresh ran), and one being discarded that
            // the server still holds - whether the server's row can be put over it is not known yet, so it stays as it is,
            // columns and all, until the write that puts the server's row over it empties them (a row that cannot be placed
            // stays unsent with its columns). The rows being discarded the server no longer holds were settled just before,
            // so they are no longer unsent
            await BlankLocalBinariesAsync(
                    run.Connection,
                    table,
                    states.Values.Any(state => state.Dirty),
                    null,
                    cancellationToken
                )
                .ConfigureAwait(false);
            await SyncState
                .ClearTableOwedAsync(run.Connection, table.TableName, cancellationToken)
                .ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Empties the unbounded binary columns of the local rows of a table: NULL in a column that allows it, an empty value
    /// in a NOT NULL column (what a row written without the columns holds).
    /// </summary>
    /// <param name="connection">The apply's connection.</param>
    /// <param name="table">The table.</param>
    /// <param name="keepUnsent">
    /// With no rows given: whether the rows the row state table marks as unsent keep their columns (false when the table
    /// has none, which spares the look-up).
    /// </param>
    /// <param name="onlyRawKeys">The rows to empty, by key as stored; null for every row of the table.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    private static async Task BlankLocalBinariesAsync(
        DbConnection connection,
        SyncTable table,
        bool keepUnsent,
        IReadOnlyList<object>? onlyRawKeys,
        CancellationToken cancellationToken
    )
    {
        if (onlyRawKeys is { Count: 0 })
        {
            return;
        }

        var notNull = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using (var info = connection.CreateCommand())
        {
            info.CommandText =
                "PRAGMA main.table_info("
                + Identifier(table.LocalTableName)
                + ")";
            await using var reader = await info.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                if (reader.GetInt64(3) != 0)
                {
                    notNull.Add(reader.GetString(1));
                }
            }
        }

        var update =
            "UPDATE "
            + QualifiedName(table)
            + " SET "
            + string.Join(
                ", ",
                table.LocalUnboundedBinaryColumnNames.Select(column =>
                    Identifier(column) + " = " + (notNull.Contains(column) ? "X''" : "NULL")
                )
            );
        var keyColumn = QualifiedName(table) + "." + Identifier(table.LocalKeyColumnName);

        if (onlyRawKeys is null)
        {
            await using var blank = connection.CreateCommand();
            blank.CommandText = update;

            if (keepUnsent)
            {
                blank.CommandText += " WHERE " + NotUnsentCondition(keyColumn);
                SyncState.AddParameter(blank, "@table", table.TableName);
            }

            await blank.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);

            return;
        }

        for (var start = 0; start < onlyRawKeys.Count; start += MaxBlankedKeysPerStatement)
        {
            var count = Math.Min(MaxBlankedKeysPerStatement, onlyRawKeys.Count - start);
            await using var blank = connection.CreateCommand();
            blank.CommandText =
                update
                + " WHERE "
                + keyColumn
                + " IN ("
                + string.Join(
                    ", ",
                    Enumerable.Range(0, count).Select(index => "@k" + index.ToString(CultureInfo.InvariantCulture))
                )
                + ")";

            for (var index = 0; index < count; index++)
            {
                SyncState.AddParameter(
                    blank,
                    "@k" + index.ToString(CultureInfo.InvariantCulture),
                    onlyRawKeys[start + index]
                );
            }

            await blank.ExecuteNonQueryAsync(cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>The most keys <see cref="BlankLocalBinariesAsync"/> binds in one statement (well under SQLite's limit on the number of parameters).</summary>
    private const int MaxBlankedKeysPerStatement = 500;

    /// <summary>
    /// The condition that is true for the rows of a synchronised table the row state table does not mark as unsent (the
    /// statement binds the table's name as <c>@table</c>).
    /// </summary>
    /// <remarks>
    /// The unsent rows are read from the row state table inside the statement (it stores each key as the table does), so
    /// their number is never bound as parameters. The subquery does not refer to the outer row: it runs once, and each row
    /// of the table is looked up in its result. Comparing the table's key column against the state table's untyped key
    /// column row by row cannot use the state table's index, and reads every state row of the table for every row of the
    /// table. A NULL among the keys would make the condition true for no row, so the subquery leaves NULL out. A row of
    /// the table whose own key is NULL satisfies the condition only while the table has no unsent row.
    /// </remarks>
    /// <param name="quotedKeyColumn">The synchronised table's key column, quoted (and qualified where needed).</param>
    internal static string NotUnsentCondition(string quotedKeyColumn) =>
        quotedKeyColumn
        + " NOT IN (SELECT s.\"key\" FROM "
        + SyncLocalTracking.RowTableName
        + " AS s WHERE s.table_name = @table AND s.dirty = 1 AND s.\"key\" IS NOT NULL)";

    /// <summary>
    /// Settles the rows of one table that <see cref="SyncConflictPolicy.ServerWins"/> is discarding: only the rows still at
    /// the change number read at the start of the run are discarded (a row written again in the meantime keeps its local
    /// content), and a row the server no longer has only loses its unsent change - the row itself is left to the delete
    /// propagation. After the chunks of a refresh that gives the unbounded binary columns up, such a row loses those
    /// columns along with its change.
    /// </summary>
    private static async Task SettleDiscardsWithoutServerRowAsync(
        ApplyAttempt run,
        SyncApplyPlan plan,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var states = run.States[table.TableName];
        var live = new Dictionary<string, SyncPlanDiscard>(StringComparer.Ordinal);

        foreach (var (keyText, discard) in plan.Discards)
        {
            if (states.TryGetValue(keyText, out var current) && current.ChangeSequence != discard.Sequence)
            {
                continue;
            }

            live[keyText] = discard;
        }

        run.LiveDiscards[table.TableName] = live;

        foreach (var (keyText, discard) in live)
        {
            // A plan that settles only the rows the server no longer holds leaves the others to the chunk that brings them
            if (
                discard.Server is not null
                || run.Held.ContainsKey((table.TableName, keyText))
                || plan.KeepsDiscardsTheServerHas && plan.ServerKeys is { } serverKeys && serverKeys.Contains(keyText)
            )
            {
                continue;
            }

            if (states.TryGetValue(keyText, out var state))
            {
                await SyncState
                    .ClearDiscardedAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                    .ConfigureAwait(false);
                states[keyText] = state with { Dirty = false };

                // After the chunks of a refresh that gives the unbounded binary columns up, a row being discarded that no
                // chunk brought (the server changed it after the ceiling, or deleted it after its key was read) still
                // holds the columns the transaction before the chunks left it: they go with its change, on this row alone
                if (
                    plan.Refresh is { BlankBinaries: true }
                    && !plan.RunsTableWideSteps
                    && table.UnboundedBinaryColumnNames.Count > 0
                )
                {
                    await BlankLocalBinariesAsync(run.Connection, table, false, [state.RawKey], cancellationToken)
                        .ConfigureAwait(false);
                }
            }

            run.NoteDiscarded(table.TableName, keyText);
        }
    }

    /// <summary>
    /// Writes the fetched rows of one table: a row with an unsent change keeps the local content, a row this device
    /// already holds the server's version of is skipped, and a row that collides on a unique value goes after the
    /// others, then into a rotation with the rows left, and is held back when even that cannot place it.
    /// </summary>
    private async Task WriteRowsAsync(
        ApplyAttempt run,
        SyncApplyPlan plan,
        bool owesBinaries,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var states = run.States[table.TableName];
        var owed =
            owesBinaries && table.UnboundedBinaryColumnNames.Count > 0
                ? string.Join(",", table.UnboundedBinaryColumnNames)
                : string.Empty;
        var writes = new List<SyncRowWrite>();
        var discards = run.LiveDiscards[table.TableName];
        var fetchedKeys = new HashSet<string>(StringComparer.Ordinal);

        foreach (var row in plan.Rows)
        {
            var key = table.KeyOf(row);
            var keyText = table.KeyText(key);
            fetchedKeys.Add(keyText);

            if (run.Held.ContainsKey((table.TableName, keyText)))
            {
                continue;
            }

            states.TryGetValue(keyText, out var state);

            // A row ServerWins is discarding takes the server's row whatever the local row holds
            if (discards.ContainsKey(keyText))
            {
                writes.Add(new SyncRowWrite(row, key, keyText, state) { Discard = true });
                continue;
            }

            // A row with an unsent change keeps the local content - unless the local row is gone and the server never
            // had it: then there is nothing to send, and the server row takes its place
            if (
                state is { Dirty: true }
                && (
                    state.Known
                    || table.IsVersionless
                    || await table.ExistsAsync(run.Connection, key, cancellationToken).ConfigureAwait(false)
                )
            )
            {
                // A local row made under a key the server does not know holds the table's resume point before it:
                // past it, the server row would never come down again once the local row goes
                if (!state.Known && !table.IsVersionless)
                {
                    run.UniqueHeld.Add((table.TableName, keyText));
                }

                continue;
            }

            // The echo of what this device sent: the server row carries the version the local content is based on (a refresh
            // skips no echo: it rewrites every row, which brings back the columns a run that did not carry them left out)
            if (
                plan.Refresh is null
                && !table.IsVersionless
                && state?.BaseVersion is { } baseVersion
                && table.VersionOf(row) is { } version
                && baseVersion.AsSpan().SequenceEqual(version)
                && await table.ExistsAsync(run.Connection, key, cancellationToken).ConfigureAwait(false)
            )
            {
                continue;
            }

            writes.Add(new SyncRowWrite(row, key, keyText, state));
        }

        // A row being discarded that was not among the changes takes the server's row read by key
        foreach (var (keyText, discard) in discards)
        {
            if (
                discard.Server is not { } server
                || fetchedKeys.Contains(keyText)
                || run.Held.ContainsKey((table.TableName, keyText))
            )
            {
                continue;
            }

            states.TryGetValue(keyText, out var state);
            writes.Add(new SyncRowWrite(server, discard.Key, keyText, state) { Discard = true });
        }

        // A row that collides on a unique value goes after the others, as long as the others make progress
        var remaining = writes;

        while (remaining.Count > 0)
        {
            var deferred = new List<SyncRowWrite>();

            foreach (var write in remaining)
            {
                if (await TryWriteAsync(run, table, write, owed, cancellationToken).ConfigureAwait(false))
                {
                    run.Note(table, write);
                }
                else
                {
                    deferred.Add(write);
                }
            }

            if (deferred.Count == remaining.Count)
            {
                break;
            }

            remaining = deferred;
        }

        if (remaining.Count > 0)
        {
            // The rows left take values from one another (a swap or a rotation): they are deleted and inserted again
            // together, and a row that still collides is held back
            var stillHeld = await RotateAsync(run, table, remaining, owed, cancellationToken).ConfigureAwait(false);

            foreach (var write in remaining)
            {
                if (stillHeld.Contains(write))
                {
                    run.UniqueHeld.Add((table.TableName, write.KeyText));
                }
                else
                {
                    run.Note(table, write);
                }
            }
        }

        // A refresh that gives the unbounded binary columns up empties them on each row being discarded this apply put the
        // server's row over (until then such a row kept them: it was still unsent). A row being discarded that could not be
        // placed is left as it is - unsent, with its columns
        if (plan.Refresh is { BlankBinaries: true } && table.UnboundedBinaryColumnNames.Count > 0)
        {
            var replaced = writes
                .Where(write =>
                    write.Discard && write.State is not null && run.Written.Contains((table.TableName, write.KeyText))
                )
                .Select(write => write.State!.RawKey)
                .ToList();
            await BlankLocalBinariesAsync(run.Connection, table, false, replaced, cancellationToken).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Writes one row (an update when the local row is there, an insert otherwise) and its state, inside a savepoint;
    /// false, with nothing written, when a unique value is already taken.
    /// </summary>
    private async Task<bool> TryWriteAsync(
        ApplyAttempt run,
        SyncTable table,
        SyncRowWrite write,
        string owed,
        CancellationToken cancellationToken
    )
    {
        var connection = run.Connection;
        await SyncState
            .ExecuteAsync(connection, "SAVEPOINT " + WriteSavepoint, cancellationToken)
            .ConfigureAwait(false);

        try
        {
            var exists = await table.ExistsAsync(connection, write.Key, cancellationToken).ConfigureAwait(false);

            if (exists)
            {
                await table.UpdateAsync(connection, write.Row, cancellationToken).ConfigureAwait(false);
            }
            else
            {
                await table.InsertAsync(connection, write.Row, cancellationToken).ConfigureAwait(false);
            }

            var rawKey =
                write.State?.RawKey
                ?? await run.RawKeyAsync(table, write.KeyText, inserted: !exists, cancellationToken).ConfigureAwait(false);
            await SyncState
                .WriteAppliedRowAsync(
                    connection,
                    table.TableName,
                    rawKey,
                    table.VersionOf(write.Row),
                    owed,
                    cancellationToken
                )
                .ConfigureAwait(false);
            await SyncState
                .ExecuteAsync(connection, "RELEASE " + WriteSavepoint, cancellationToken)
                .ConfigureAwait(false);

            return true;
        }
        catch (DbException failure) when (_rows.IsUniqueViolation(failure))
        {
            await SyncState
                .ExecuteAsync(connection, "ROLLBACK TO " + WriteSavepoint, CancellationToken.None)
                .ConfigureAwait(false);
            await SyncState
                .ExecuteAsync(connection, "RELEASE " + WriteSavepoint, CancellationToken.None)
                .ConfigureAwait(false);

            return false;
        }
    }

    /// <summary>
    /// Deletes the local rows of the set and inserts the whole set again inside a savepoint; when a row still collides,
    /// goes back to the savepoint and tries again without it. Returns the rows held back.
    /// </summary>
    /// <remarks>
    /// The rows written carry no unbounded binary columns, so the local rows' columns are kept in a table of the
    /// connection's temporary schema before the rows go (copied inside the database, never through memory) and written back
    /// onto the rows inserted again; the temporary schema leaves the main database's schema version alone. A row the
    /// savepoint puts back keeps its own columns.
    /// </remarks>
    private async Task<HashSet<SyncRowWrite>> RotateAsync(
        ApplyAttempt run,
        SyncTable table,
        List<SyncRowWrite> rows,
        string owed,
        CancellationToken cancellationToken
    )
    {
        var connection = run.Connection;
        var heldBack = new HashSet<SyncRowWrite>();
        var set = rows.ToList();
        var kept = new Dictionary<SyncRowWrite, object>();

        if (table.UnboundedBinaryColumnNames.Count > 0)
        {
            await SyncState.ExecuteAsync(connection, CreateRotateTableSql, cancellationToken).ConfigureAwait(false);

            foreach (var write in set)
            {
                if (!await table.ExistsAsync(connection, write.Key, cancellationToken).ConfigureAwait(false))
                {
                    continue;
                }

                var rawKey = await run
                    .RawKeyAsync(table, write.KeyText, inserted: false, cancellationToken)
                    .ConfigureAwait(false);

                foreach (var column in table.LocalUnboundedBinaryColumnNames)
                {
                    await SyncState
                        .ExecuteAsync(
                            connection,
                            "INSERT INTO temp."
                                + RotateTableName
                                + " (table_name, k, column_name, v) SELECT @table, "
                                + Identifier(table.LocalKeyColumnName)
                                + ", @column, "
                                + Identifier(column)
                                + " FROM "
                                + QualifiedName(table)
                                + " WHERE "
                                + Identifier(table.LocalKeyColumnName)
                                + " = @key",
                            cancellationToken,
                            ("@table", table.TableName),
                            ("@column", column),
                            ("@key", rawKey)
                        )
                        .ConfigureAwait(false);
                }

                kept[write] = rawKey;
            }
        }

        while (set.Count > 0)
        {
            await SyncState
                .ExecuteAsync(connection, "SAVEPOINT " + RotateSavepoint, cancellationToken)
                .ConfigureAwait(false);

            foreach (var write in set)
            {
                await table.DeleteAsync(connection, write.Key, cancellationToken).ConfigureAwait(false);
            }

            var failing = new List<SyncRowWrite>();

            foreach (var write in set)
            {
                if (!await TryWriteAsync(run, table, write, owed, cancellationToken).ConfigureAwait(false))
                {
                    failing.Add(write);
                }
            }

            if (failing.Count == 0)
            {
                // The rows inserted again take back the unbounded binary columns their local rows had
                foreach (var write in set)
                {
                    if (kept.TryGetValue(write, out var rawKey))
                    {
                        await RestoreKeptBinariesAsync(connection, table, rawKey, cancellationToken)
                            .ConfigureAwait(false);
                    }
                }

                await SyncState
                    .ExecuteAsync(connection, "RELEASE " + RotateSavepoint, CancellationToken.None)
                    .ConfigureAwait(false);
                break;
            }

            // CancellationToken.None: a canceled token must not be able to leave the savepoint half undone
            await SyncState
                .ExecuteAsync(connection, "ROLLBACK TO " + RotateSavepoint, CancellationToken.None)
                .ConfigureAwait(false);
            await SyncState
                .ExecuteAsync(connection, "RELEASE " + RotateSavepoint, CancellationToken.None)
                .ConfigureAwait(false);
            heldBack.UnionWith(failing);
            set = set.Except(failing).ToList();
        }

        // The kept copies go with the rotation; on a failure the apply's rollback takes them back with everything else
        if (kept.Count > 0)
        {
            await SyncState
                .ExecuteAsync(
                    connection,
                    "DELETE FROM temp." + RotateTableName + " WHERE table_name = @table",
                    cancellationToken,
                    ("@table", table.TableName)
                )
                .ConfigureAwait(false);
        }

        return heldBack;
    }

    /// <summary>Writes the kept unbounded binary columns back onto a row the rotation inserted again.</summary>
    private static async Task RestoreKeptBinariesAsync(
        DbConnection connection,
        SyncTable table,
        object rawKey,
        CancellationToken cancellationToken
    )
    {
        foreach (var column in table.LocalUnboundedBinaryColumnNames)
        {
            await SyncState
                .ExecuteAsync(
                    connection,
                    "UPDATE "
                        + QualifiedName(table)
                        + " SET "
                        + Identifier(column)
                        + " = (SELECT v FROM temp."
                        + RotateTableName
                        + " WHERE table_name = @table AND column_name = @column AND k = @key) WHERE "
                        + Identifier(table.LocalKeyColumnName)
                        + " = @key",
                    cancellationToken,
                    ("@table", table.TableName),
                    ("@column", column),
                    ("@key", rawKey)
                )
                .ConfigureAwait(false);
        }
    }

    /// <summary>The table of the connection's temporary schema that keeps the unbounded binary columns of rotated rows.</summary>
    private const string RotateTableName = "quicker_sync_rotate";

    /// <summary>Creates the table that keeps the unbounded binary columns of rotated rows (in the temporary schema).</summary>
    private const string CreateRotateTableSql =
        "CREATE TEMP TABLE IF NOT EXISTS quicker_sync_rotate (table_name TEXT NOT NULL, k, column_name TEXT NOT NULL, v BLOB)";

    /// <summary>
    /// Reports the rows of one table held back, and saves its resume point: just before the first row held back, or the
    /// last fetched version when nothing was (never the ceiling itself, which is exclusive).
    /// </summary>
    private static async Task SaveResumePointAsync(
        ApplyAttempt run,
        SyncApplyPlan plan,
        List<SyncDownloadTruncation> truncations,
        bool advanceAnchors,
        CancellationToken cancellationToken
    )
    {
        var table = plan.Table;
        var firstHeld = -1;

        for (var index = 0; index < plan.Rows.Count; index++)
        {
            var keyText = table.KeyText(table.KeyOf(plan.Rows[index]));
            var heldForParent = run.Held.TryGetValue((table.TableName, keyText), out var missingParent);

            if (!heldForParent && !run.UniqueHeld.Contains((table.TableName, keyText)))
            {
                continue;
            }

            truncations.Add(
                new SyncDownloadTruncation(table.TableName, keyText)
                {
                    MissingParentTableName = heldForParent ? missingParent : null,
                }
            );

            if (firstHeld < 0)
            {
                firstHeld = index;
            }
        }

        // A row ServerWins could not put back keeps its unsent change, marked so that later runs carry the decision out
        var states = run.States[table.TableName];
        var fetched = plan.Rows.Select(row => table.KeyText(table.KeyOf(row))).ToHashSet(StringComparer.Ordinal);

        foreach (var keyText in run.LiveDiscards[table.TableName].Keys)
        {
            var heldForParent = run.Held.TryGetValue((table.TableName, keyText), out var missingParent);

            if (!heldForParent && !run.UniqueHeld.Contains((table.TableName, keyText)))
            {
                continue;
            }

            if (!fetched.Contains(keyText))
            {
                truncations.Add(
                    new SyncDownloadTruncation(table.TableName, keyText)
                    {
                        MissingParentTableName = heldForParent ? missingParent : null,
                    }
                );
            }

            if (states.TryGetValue(keyText, out var state))
            {
                await SyncState
                    .MarkServerWinsAsync(run.Connection, table.TableName, state.RawKey, cancellationToken)
                    .ConfigureAwait(false);
            }
        }

        if (!advanceAnchors || table.IsVersionless || !plan.AdvancesAnchor)
        {
            return;
        }

        var anchor =
            firstHeld >= 0 ? plan.VersionBefore(firstHeld)
            : plan.Rows.Count > 0 ? plan.ThroughVersion ?? table.VersionOf(plan.Rows[^1])
            : plan.OldAnchor;

        await SyncState
            .WriteAnchorAsync(run.Connection, table.TableName, anchor, cancellationToken)
            .ConfigureAwait(false);
    }

    /// <summary>
    /// The foreign key violations the local database has now (<c>PRAGMA foreign_key_check</c>), each with the child row's
    /// key and, when the foreign key refers to the parent's primary key, the parent row's key.
    /// </summary>
    private async Task<List<SyncViolation>> ForeignKeyViolationsAsync(
        DbConnection connection,
        CancellationToken cancellationToken
    )
    {
        var found = new List<(string Table, object RowId, string Parent, long ForeignKey)>();

        await using (var check = connection.CreateCommand())
        {
            check.CommandText = "PRAGMA foreign_key_check";
            await using var reader = await check.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                found.Add((reader.GetString(0), reader.GetValue(1), reader.GetString(2), reader.GetInt64(3)));
            }
        }

        var violations = new List<SyncViolation>(found.Count);

        foreach (var (tableName, rowId, parentName, foreignKey) in found)
        {
            var child = TableNamed(tableName);
            var parent = TableNamed(parentName);
            var childTable = child?.TableName ?? tableName;
            var parentTable = parent?.TableName ?? parentName;
            var columns = new List<(string From, string? To)>();

            await using (var list = connection.CreateCommand())
            {
                list.CommandText = "PRAGMA foreign_key_list(" + Identifier(tableName) + ")";
                await using var reader = await list.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

                while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
                {
                    if (reader.GetInt64(0) == foreignKey)
                    {
                        columns.Add((reader.GetString(3), reader.IsDBNull(4) ? null : reader.GetString(4)));
                    }
                }
            }

            if (rowId is DBNull || columns.Count == 0)
            {
                violations.Add(
                    new SyncViolation((childTable, "?"), parentTable, foreignKey, null, null, null, parent)
                );
                continue;
            }

            var referencesKey =
                parent is not null
                && columns.Count == 1
                && (
                    columns[0].To is null
                    || string.Equals(columns[0].To, parent.LocalKeyColumnName, StringComparison.OrdinalIgnoreCase)
                );

            await using var read = connection.CreateCommand();
            read.CommandText =
                "SELECT "
                + (child is null ? "rowid" : Identifier(child.LocalKeyColumnName))
                + ", "
                + string.Join(", ", columns.Select(column => Identifier(column.From)))
                + " FROM "
                + Identifier(tableName)
                + " WHERE rowid = @rowid";
            SyncState.AddParameter(read, "@rowid", rowId);
            await using var values = await read.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

            if (!await values.ReadAsync(cancellationToken).ConfigureAwait(false))
            {
                violations.Add(
                    new SyncViolation((childTable, "?"), parentTable, foreignKey, null, null, null, parent)
                );
                continue;
            }

            var childKey = child is null
                ? "rowid:" + Convert.ToString(values.GetValue(0), CultureInfo.InvariantCulture)
                : child.KeyTextOfRaw(values.GetValue(0));
            (string Table, string Key)? parentKey =
                referencesKey && !values.IsDBNull(1) ? (parentTable, parent!.KeyTextOfRaw(values.GetValue(1))) : null;
            var lookupColumns =
                !referencesKey && parent is not null && columns.All(column => column.To is not null)
                    ? columns.Select(column => column.To!).ToArray()
                    : null;
            var lookupValues = lookupColumns is null
                ? null
                : columns.Select((_, index) => values.GetValue(index + 1)).ToArray();
            violations.Add(
                new SyncViolation(
                    (childTable, childKey),
                    parentTable,
                    foreignKey,
                    parentKey,
                    lookupColumns,
                    lookupValues,
                    parent
                )
            );
        }

        return violations;
    }

    /// <summary>The key of the parent row a violation's foreign key names by the values of columns other than the primary key (null when no such row is there).</summary>
    private static async Task<(string Table, string Key)?> FindParentKeyTextAsync(
        DbConnection connection,
        SyncViolation violation,
        CancellationToken cancellationToken
    )
    {
        var parent = violation.ParentDescriptor!;
        var columns = violation.LookupColumns!;
        var values = violation.LookupValues!;

        await using var find = connection.CreateCommand();
        find.CommandText =
            "SELECT "
            + Identifier(parent.LocalKeyColumnName)
            + " FROM "
            + QualifiedName(parent)
            + " WHERE "
            + string.Join(
                " AND ",
                columns.Select((column, index) => Identifier(column) + " = @v" + index.ToString(CultureInfo.InvariantCulture))
            );

        for (var index = 0; index < values.Length; index++)
        {
            SyncState.AddParameter(find, "@v" + index.ToString(CultureInfo.InvariantCulture), values[index]);
        }

        return await find.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false) is { } rawKey and not DBNull
            ? (parent.TableName, parent.KeyTextOfRaw(rawKey))
            : null;
    }

    /// <summary>
    /// Copies the owed unbounded binary columns down from the server: each row's columns go through temporary files,
    /// then into the local row in a short transaction of their own, and the row stops owing them. A column the local
    /// device wrote since (still unsent) is not copied; a column NULL on the server clears the local column; a row the
    /// server no longer has, or a row gone locally, only stops owing.
    /// </summary>
    private async Task CopyOwedBinariesAsync(List<SyncTable> scope, CancellationToken cancellationToken)
    {
        foreach (var table in scope)
        {
            if (table.UnboundedBinaryColumnNames.Count == 0)
            {
                continue;
            }

            IReadOnlyList<SyncRowState> owedRows;

            {
                var connection = RunConnection;
                owedRows = await SyncState
                    .ReadOwedAsync(connection, table.TableName, cancellationToken)
                    .ConfigureAwait(false);
            }

            foreach (var owedRow in owedRows)
            {
                await CopyOwedRowAsync(table, owedRow, cancellationToken).ConfigureAwait(false);
            }
        }
    }

    /// <summary>Copies the owed columns of one row (see <see cref="CopyOwedBinariesAsync"/>).</summary>
    private async Task CopyOwedRowAsync(
        SyncTable table,
        SyncRowState owedRow,
        CancellationToken cancellationToken
    )
    {
        var key = table.KeyOfRaw(owedRow.RawKey);
        var owed = SplitColumns(owedRow.BlobOwed);
        var written = SplitColumns(owedRow.BlobColumns);
        var wanted = owed.Where(column => !written.Contains(column)).ToList();

        // A column NULL on the server comes down as null and clears the local column, so the two sides end up alike rather
        // than a stale blob staying under the row
        var files = new List<(string Column, FileStream? File)>();

        try
        {
            foreach (var column in wanted)
            {
                var file = CreateTemporaryFile();

                if (await table.ReadServerBinaryAsync(column, key, file, cancellationToken).ConfigureAwait(false))
                {
                    file.Position = 0;
                    files.Add((column, file));
                }
                else
                {
                    await file.DisposeAsync().ConfigureAwait(false);
                    files.Add((column, null));
                }
            }

            // A row the server no longer has leaves the local columns as they are (the row goes with the delete propagation
            // or stays because something refers to it, and a NOT NULL column cannot be cleared); it only stops owing
            if (
                files.Any(entry => entry.File is null)
                && !await table.ServerHasAsync(table.KeyText(key), cancellationToken).ConfigureAwait(false)
            )
            {
                foreach (var (_, file) in files)
                {
                    if (file is not null)
                    {
                        await file.DisposeAsync().ConfigureAwait(false);
                    }
                }

                files.Clear();
            }

            var connection = RunConnection;
            await SyncState.ExecuteAsync(connection, "BEGIN IMMEDIATE", cancellationToken).ConfigureAwait(false);

            try
            {
                await SyncState.SetApplyingAsync(connection, true, cancellationToken).ConfigureAwait(false);

                // Read again under the write lock: the device may have written a column, or an apply may have added one
                var current = await SyncState
                    .ReadRowAsync(connection, table.TableName, owedRow.RawKey, cancellationToken)
                    .ConfigureAwait(false);

                if (current is not null)
                {
                    var currentOwed = SplitColumns(current.BlobOwed);
                    var currentWritten = SplitColumns(current.BlobColumns);

                    foreach (var (column, file) in files)
                    {
                        if (currentOwed.Contains(column) && !currentWritten.Contains(column))
                        {
                            await table
                                .WriteLocalBinaryAsync(connection, key, column, file, file?.Length, cancellationToken)
                                .ConfigureAwait(false);
                        }
                    }

                    await SyncState
                        .WriteOwedAsync(
                            connection,
                            table.TableName,
                            owedRow.RawKey,
                            string.Join(",", currentOwed.Where(column => !owed.Contains(column))),
                            cancellationToken
                        )
                        .ConfigureAwait(false);
                }

                await SyncState.SetApplyingAsync(connection, false, cancellationToken).ConfigureAwait(false);
                await SyncState.ExecuteAsync(connection, "COMMIT", cancellationToken).ConfigureAwait(false);
            }
            catch
            {
                try
                {
                    await SyncState
                        .ExecuteAsync(connection, "ROLLBACK", CancellationToken.None)
                        .ConfigureAwait(false);
                }
                catch (DbException)
                {
                    // The rollback failing must not hide what went wrong first
                }

                throw;
            }
        }
        finally
        {
            foreach (var (_, file) in files)
            {
                if (file is not null)
                {
                    await file.DisposeAsync().ConfigureAwait(false);
                }
            }
        }
    }

    /// <summary>
    /// Opens a dedicated connection with foreign keys checked off (it is not pooled, so the setting goes with it). Only two
    /// places open one: the run's entry (<see cref="RunExclusiveAsync{T}"/>, whose connection the run's body borrows through
    /// <see cref="RunConnection"/>) and the list of unsent changes (<see cref="GetPendingChangesAsync"/>, which reads
    /// outside the run lock).
    /// </summary>
    private async Task<DbConnection> OpenDedicatedAsync(CancellationToken cancellationToken)
    {
        var connection = _rows.CreateDedicatedConnection();

        try
        {
            await connection.OpenAsync(cancellationToken).ConfigureAwait(false);
            await SyncState
                .ExecuteAsync(connection, "PRAGMA foreign_keys = OFF", cancellationToken)
                .ConfigureAwait(false);

            return connection;
        }
        catch
        {
            await connection.DisposeAsync().ConfigureAwait(false);
            throw;
        }
    }

    /// <summary>The table of the engine whose local table has the name (null when none has).</summary>
    private SyncTable? TableNamed(string localTableName) =>
        _tables.FirstOrDefault(table =>
            string.Equals(table.LocalTableName, localTableName, StringComparison.OrdinalIgnoreCase)
        );

    /// <summary>The columns of a comma-separated list.</summary>
    private static HashSet<string> SplitColumns(string columns) =>
        columns.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.Ordinal);

    /// <summary>A name quoted as an SQLite identifier.</summary>
    internal static string Identifier(string name) => "\"" + name.Replace("\"", "\"\"", StringComparison.Ordinal) + "\"";

    /// <summary>The local table's name, quoted (the table lives in the main database).</summary>
    internal static string QualifiedName(SyncTable table) => Identifier(table.LocalTableName);

    /// <summary>
    /// A download applied a chunk at a time: each chunk - at most <see cref="ChunkSize"/> consecutive fetched rows of one
    /// table, in fetch order - is applied in a transaction of its own with the parts of a single apply, and the rows a
    /// chunk holds back are carried in memory to one last apply of them all.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A chunk reads the row states of its own rows only, and gets no server keys (the delete propagation ran before the
    /// first chunk). A row it holds back - for a missing parent, for a unique value, or as an unsent local row under a key
    /// the server does not know - is not written; it is carried, together with the version just before it in fetch order.
    /// </para>
    /// <para>
    /// A chunk moves its table's resume point while the table carries no row: to the last row it wrote or skipped, or to
    /// just before the first row it holds back. Once the table carries a row, the later chunks leave the resume point there,
    /// so a run that stops half-way fetches the carried rows again (the rows written after them come back as echoes).
    /// </para>
    /// <para>
    /// The last apply writes the carried rows of every table in one transaction, the way a single apply writes a download,
    /// so a cycle or a swap of unique values across chunks is settled there. It moves the resume point of each table it
    /// writes to the table's last fetched version, or to just before the first row it still holds back; those rows are the
    /// download's truncations.
    /// </para>
    /// <para>
    /// A refresh does what it does to the whole of a table in the transaction before the first chunk, which also sets
    /// every table's resume point back to nothing fetched; its chunks rewrite every row (none is skipped as an echo) and
    /// put the server's row over a row it discards in the chunk that brings it. The last apply also settles the rows it
    /// discards that neither a chunk brought nor that transaction settled (the server held them then): they only lose
    /// their change.
    /// </para>
    /// <para>
    /// Its transactions - the delete propagation, each chunk and the last apply - are spaced at least
    /// <see cref="ChunkWriteGap"/> apart (from one commit to the next start), so another connection waiting to write gets
    /// in between them instead of waiting for them all.
    /// </para>
    /// </remarks>
    /// <param name="engine">The engine applying the download.</param>
    /// <param name="anchors">The resume points the fetch started from, by table name (empty for a refresh).</param>
    /// <param name="owesBinaries">Whether the rows written owe their unbounded binary columns.</param>
    /// <param name="changes">Where the rows the run changes on its own are noted, right after each commit (null for nowhere).</param>
    /// <param name="refresh">The refresh the download belongs to (null for an ordinary download).</param>
    /// <param name="discards">The rows the run discards (only a refresh has any here).</param>
    private sealed class ChunkedDownload(
        SyncEngine engine,
        Dictionary<string, byte[]?> anchors,
        bool owesBinaries,
        SyncLocalRowChangeLog? changes,
        SyncRefresh? refresh,
        Dictionary<(string Table, string Key), SyncDiscard> discards
    )
    {
        /// <summary>The discards of each table the server held when the transaction before the first chunk ran, by table name.</summary>
        private readonly Dictionary<string, HashSet<string>> _discardsTheServerHad = new(StringComparer.Ordinal);

        /// <summary>
        /// The plan of one table for the transaction before the first chunk: its server keys (the delete propagation),
        /// and for a refresh what it does to the whole table and its discards, settling those the server no longer holds.
        /// </summary>
        public SyncApplyPlan DeletionPlan(SyncTable table, IReadOnlySet<string>? serverKeys)
        {
            var tableDiscards = DiscardsOf(table, keyText => true, keyText => null);

            if (serverKeys is not null)
            {
                _discardsTheServerHad[table.TableName] = tableDiscards
                    .Keys.Where(serverKeys.Contains)
                    .ToHashSet(StringComparer.Ordinal);
            }

            return new SyncApplyPlan(table, [], serverKeys, null)
            {
                Refresh = refresh,
                Discards = tableDiscards,
                KeepsDiscardsTheServerHas = true,
            };
        }

        /// <summary>The discards of a table whose key text the filter takes, each with the server row the lookup gives.</summary>
        private Dictionary<string, SyncPlanDiscard> DiscardsOf(
            SyncTable table,
            Func<string, bool> takes,
            Func<string, EntityBaseCore?> server
        )
        {
            var found = new Dictionary<string, SyncPlanDiscard>(StringComparer.Ordinal);

            foreach (var ((tableName, keyText), discard) in discards)
            {
                if (string.Equals(tableName, table.TableName, StringComparison.Ordinal) && takes(keyText))
                {
                    found[keyText] = new SyncPlanDiscard(discard.Key, discard.Sequence, server(keyText));
                }
            }

            return found;
        }
        /// <summary>Each table's progress, by table name.</summary>
        private readonly Dictionary<string, TableProgress> _progress = new(StringComparer.Ordinal);

        /// <summary>The tables in the order they were first given (the run's order).</summary>
        private readonly List<TableProgress> _order = [];

        /// <summary>The local rows the applies changed on their own, in order.</summary>
        private readonly List<SyncLocalRowChange> _changes = [];

        /// <summary>The rows deleted and written in each table by every apply so far.</summary>
        private readonly Dictionary<string, (int Deleted, int Written)> _perTable = new(StringComparer.Ordinal);

        private int _downloaded;
        private int _deletedLocally;
        private int _discarded;

        /// <summary>
        /// Runs the delete propagation of every table in one transaction (no row is written). The resume points do not move,
        /// except that a refresh sets them back to nothing fetched.
        /// </summary>
        public async Task ApplyDeletionsAsync(List<SyncApplyPlan> plans, CancellationToken cancellationToken) =>
            Take(
                await ApplyAfterGapAsync(plans, advanceAnchors: refresh is not null, cancellationToken)
                    .ConfigureAwait(false)
            );

        /// <summary>The time of the last commit of this download's transactions (null before the first).</summary>
        private long? _lastCommit;

        /// <summary>
        /// Applies one transaction of this download, after waiting for what is left of <see cref="ChunkWriteGap"/> since the
        /// last one committed (no wait before the first, nor when the fetch in between took longer). The wait holds no
        /// transaction and no statement open, so another connection's write gets in during it.
        /// </summary>
        private async Task<SyncDownload> ApplyAfterGapAsync(
            List<SyncApplyPlan> plans,
            bool advanceAnchors,
            CancellationToken cancellationToken
        )
        {
            var clock = engine.TimeProvider;

            if (_lastCommit is { } lastCommit)
            {
                var rest = engine.ChunkWriteGap - clock.GetElapsedTime(lastCommit);

                if (rest > TimeSpan.Zero)
                {
                    await Task.Delay(rest, clock, cancellationToken).ConfigureAwait(false);
                }
            }

            var outcome = await engine
                .ApplyAsync(plans, owesBinaries, advanceAnchors, cancellationToken)
                .ConfigureAwait(false);
            _lastCommit = clock.GetTimestamp();

            return outcome;
        }

        /// <summary>Adds fetched rows of a table, applying a chunk each time the table's buffer is full.</summary>
        public async Task AddAsync(
            SyncTable table,
            IReadOnlyList<EntityBaseCore> rows,
            CancellationToken cancellationToken
        )
        {
            var progress = ProgressOf(table);

            foreach (var row in rows)
            {
                progress.Buffer.Add(new CarriedRow(row, progress.LastVersion));
                progress.LastVersion = table.VersionOf(row);
                progress.Fetched.Add(table.KeyText(table.KeyOf(row)));

                if (progress.Buffer.Count >= engine.ChunkSize)
                {
                    await FlushAsync(progress, cancellationToken).ConfigureAwait(false);
                }
            }
        }

        /// <summary>Applies what is left in the table's buffer once its rows are all fetched (a chunk never spans tables).</summary>
        public Task FinishTableAsync(SyncTable table, CancellationToken cancellationToken) =>
            FlushAsync(ProgressOf(table), cancellationToken);

        /// <summary>
        /// Applies the carried rows of every table in one transaction (with a refresh's discards no chunk brought), and
        /// returns what the whole download did.
        /// </summary>
        public async Task<SyncDownload> FinishAsync(CancellationToken cancellationToken)
        {
            var plans = new List<SyncApplyPlan>();

            foreach (var progress in _order)
            {
                var table = progress.Table;
                var carriedKeys = progress
                    .Carried.Select(carried => table.KeyText(table.KeyOf(carried.Row)))
                    .ToHashSet(StringComparer.Ordinal);
                var serverHad = _discardsTheServerHad.GetValueOrDefault(table.TableName);

                // A carried row being discarded takes its fetched row; a discard the server held but no chunk brought only
                // loses its change (and, in a refresh that gives the unbounded binary columns up, those columns)
                var tableDiscards = DiscardsOf(
                    table,
                    keyText =>
                        carriedKeys.Contains(keyText)
                        || serverHad is not null && serverHad.Contains(keyText) && !progress.Fetched.Contains(keyText),
                    keyText =>
                        progress
                            .Carried.FirstOrDefault(carried =>
                                string.Equals(table.KeyText(table.KeyOf(carried.Row)), keyText, StringComparison.Ordinal)
                            )
                            ?.Row
                );

                if (progress.Carried.Count == 0 && tableDiscards.Count == 0)
                {
                    continue;
                }

                plans.Add(
                    new SyncApplyPlan(
                        table,
                        progress.Carried.Select(carried => carried.Row).ToList(),
                        null,
                        progress.Carried.Count > 0 ? progress.Carried[0].Before : null
                    )
                    {
                        Refresh = refresh,
                        Discards = tableDiscards,
                        ReadsStatesByKey = true,
                        RunsTableWideSteps = false,
                        AdvancesAnchor = progress.Carried.Count > 0,
                        BeforeVersions = progress.Carried.Select(carried => carried.Before).ToList(),
                        ThroughVersion = progress.LastVersion,
                    }
                );
            }

            IReadOnlyList<SyncDownloadTruncation> truncations = [];

            if (plans.Count > 0)
            {
                if (plans.Sum(plan => plan.Rows.Count) is var carriedRows and > 0)
                {
                    engine.CarriedRowsApplied?.Invoke(carriedRows);
                }

                var outcome = await ApplyAfterGapAsync(plans, advanceAnchors: true, cancellationToken)
                    .ConfigureAwait(false);
                Take(outcome);
                truncations = outcome.Truncations;
            }

            return new SyncDownload(_downloaded, _deletedLocally, truncations)
            {
                Discarded = _discarded,
                Changes = _changes,
                PerTable = _perTable,
            };
        }

        /// <summary>Applies the table's buffered rows as one chunk, and carries the rows it held back.</summary>
        private async Task FlushAsync(TableProgress progress, CancellationToken cancellationToken)
        {
            if (progress.Buffer.Count == 0)
            {
                return;
            }

            var table = progress.Table;
            var chunk = progress.Buffer.ToList();
            progress.Buffer.Clear();

            var rowsByKey = chunk.ToDictionary(
                carried => table.KeyText(table.KeyOf(carried.Row)),
                carried => carried.Row,
                StringComparer.Ordinal
            );
            var plan = new SyncApplyPlan(table, chunk.Select(carried => carried.Row).ToList(), null, chunk[0].Before)
            {
                Refresh = refresh,
                Discards = DiscardsOf(table, rowsByKey.ContainsKey, keyText => rowsByKey[keyText]),
                ReadsStatesByKey = true,
                RunsTableWideSteps = false,
                AdvancesAnchor = progress.Carried.Count == 0,
            };
            var outcome = await ApplyAfterGapAsync([plan], advanceAnchors: true, cancellationToken)
                .ConfigureAwait(false);
            Take(outcome);

            var held = outcome
                .Truncations.Where(truncation =>
                    string.Equals(truncation.TableName, table.TableName, StringComparison.Ordinal)
                )
                .Select(truncation => truncation.PendingKeyText)
                .ToHashSet(StringComparer.Ordinal);

            foreach (var carried in chunk)
            {
                if (held.Contains(table.KeyText(table.KeyOf(carried.Row))))
                {
                    progress.Carried.Add(carried);
                }
            }
        }

        /// <summary>Adds what one committed apply did to the totals, and notes the rows it changed on its own.</summary>
        private void Take(SyncDownload outcome)
        {
            _downloaded += outcome.Downloaded;
            _deletedLocally += outcome.DeletedLocally;
            _discarded += outcome.Discarded;

            foreach (var change in outcome.Changes)
            {
                _changes.Add(change);
                changes?.Add(change.TableName, change.KeyText, change.Reason);
            }

            foreach (var (tableName, (deleted, written)) in outcome.PerTable)
            {
                var sum = _perTable.GetValueOrDefault(tableName);
                _perTable[tableName] = (sum.Deleted + deleted, sum.Written + written);
            }
        }

        /// <summary>The progress of a table, created the first time the table is given.</summary>
        private TableProgress ProgressOf(SyncTable table)
        {
            if (!_progress.TryGetValue(table.TableName, out var progress))
            {
                progress = new TableProgress(table)
                {
                    LastVersion =
                        table.IsVersionless || refresh is not null ? null : anchors.GetValueOrDefault(table.TableName),
                };
                _progress[table.TableName] = progress;
                _order.Add(progress);
            }

            return progress;
        }

        /// <summary>One table's rows waiting for their chunk, the rows it carries, and the version last fetched.</summary>
        private sealed class TableProgress(SyncTable table)
        {
            /// <summary>The table.</summary>
            public SyncTable Table { get; } = table;

            /// <summary>The fetched rows waiting for their chunk, in fetch order.</summary>
            public List<CarriedRow> Buffer { get; } = [];

            /// <summary>The rows the chunks held back, in fetch order.</summary>
            public List<CarriedRow> Carried { get; } = [];

            /// <summary>The key texts of every row fetched for the table.</summary>
            public HashSet<string> Fetched { get; } = new(StringComparer.Ordinal);

            /// <summary>The version of the last fetched row (the resume point the fetch started from before any row).</summary>
            public byte[]? LastVersion { get; set; }
        }

        /// <summary>A fetched row and the version just before it in fetch order.</summary>
        /// <param name="Row">The server row.</param>
        /// <param name="Before">The version of the row fetched just before it in its table (the resume point the fetch started from for the first row).</param>
        private sealed record CarriedRow(EntityBaseCore Row, byte[]? Before);
    }

    /// <summary>What one apply attempt has done so far, on its connection.</summary>
    private sealed class ApplyAttempt(
        DbConnection connection,
        Dictionary<(string Table, string Key), string?> held,
        HashSet<(string Table, string Key)> keep
    )
    {
        /// <summary>The connection of the attempt (inside its transaction).</summary>
        public DbConnection Connection { get; } = connection;

        /// <summary>The rows held back for a missing parent (kept across attempts).</summary>
        public Dictionary<(string Table, string Key), string?> Held { get; } = held;

        /// <summary>The parents the delete propagation must not delete (kept across attempts).</summary>
        public HashSet<(string Table, string Key)> Keep { get; } = keep;

        /// <summary>The rows held back in this attempt for a unique value, or for an unsent change under a key the server does not know.</summary>
        public HashSet<(string Table, string Key)> UniqueHeld { get; } = [];

        /// <summary>The rows this attempt wrote.</summary>
        public HashSet<(string Table, string Key)> Written { get; } = [];

        /// <summary>The rows this attempt deleted.</summary>
        public HashSet<(string Table, string Key)> Deleted { get; } = [];

        /// <summary>The row states of each table, by table name and key text.</summary>
        public Dictionary<string, Dictionary<string, SyncRowState>> States { get; } =
            new(StringComparer.Ordinal);

        /// <summary>The number of server rows written.</summary>
        public int Downloaded { get; set; }

        /// <summary>The number of local rows deleted by the delete propagation.</summary>
        public int DeletedLocally { get; set; }

        /// <summary>The raw keys of each table's rows read so far, by key text.</summary>
        private readonly Dictionary<string, Dictionary<string, object>> _rawKeys = new(StringComparer.Ordinal);

        /// <summary>The raw keys of the rows of a plan read by key, by table name and key text (read before every table's keys).</summary>
        private readonly Dictionary<string, Dictionary<string, object>> _knownRawKeys = new(StringComparer.Ordinal);

        /// <summary>Records the raw keys of a plan's rows, read with their row states, so that no write needs every key of the table.</summary>
        public void KnowRawKeys(SyncTable table, Dictionary<string, object> rawKeys) =>
            _knownRawKeys[table.TableName] = rawKeys;

        /// <summary>The rows ServerWins discards in this attempt, by table name and key text (still at the change number read).</summary>
        public Dictionary<string, Dictionary<string, SyncPlanDiscard>> LiveDiscards { get; } =
            new(StringComparer.Ordinal);

        /// <summary>The number of rows whose unsent change ServerWins discarded.</summary>
        public int Discarded { get; private set; }

        /// <summary>The local rows the attempt changed on its own, in the order they were changed.</summary>
        public List<SyncLocalRowChange> Changes { get; } = [];

        /// <summary>Notes a row written.</summary>
        public void Note(SyncTable table, SyncRowWrite write)
        {
            if (!Written.Add((table.TableName, write.KeyText)))
            {
                return;
            }

            if (write.Discard)
            {
                NoteDiscarded(table.TableName, write.KeyText);
            }
            else
            {
                Downloaded++;
            }
        }

        /// <summary>Notes a row whose unsent change ServerWins discarded.</summary>
        public void NoteDiscarded(string tableName, string keyText)
        {
            Changes.Add(new SyncLocalRowChange(tableName, keyText, SyncLocalRowChangeReason.DiscardedByServerWins));
            Discarded++;
        }

        /// <summary>
        /// The key of a row just written, exactly as the table stores it: read through the rowid of an insert, or else
        /// from a read of the table's keys.
        /// </summary>
        public async Task<object> RawKeyAsync(
            SyncTable table,
            string keyText,
            bool inserted,
            CancellationToken cancellationToken
        )
        {
            if (inserted)
            {
                await using var last = Connection.CreateCommand();
                last.CommandText =
                    "SELECT "
                    + Identifier(table.LocalKeyColumnName)
                    + " FROM "
                    + QualifiedName(table)
                    + " WHERE rowid = last_insert_rowid()";

                if (await last.ExecuteScalarAsync(cancellationToken).ConfigureAwait(false) is { } rawKey and not DBNull)
                {
                    return rawKey;
                }
            }

            if (
                _knownRawKeys.TryGetValue(table.TableName, out var known)
                && known.TryGetValue(keyText, out var knownRawKey)
            )
            {
                return knownRawKey;
            }

            if (!_rawKeys.TryGetValue(table.TableName, out var keys))
            {
                keys = new Dictionary<string, object>(StringComparer.Ordinal);

                await using var read = Connection.CreateCommand();
                read.CommandText =
                    "SELECT " + Identifier(table.LocalKeyColumnName) + " FROM " + QualifiedName(table);
                await using var reader = await read.ExecuteReaderAsync(cancellationToken).ConfigureAwait(false);

                while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
                {
                    var rawKey = reader.GetValue(0);
                    keys[table.KeyTextOfRaw(rawKey)] = rawKey;
                }

                _rawKeys[table.TableName] = keys;
            }

            return keys.TryGetValue(keyText, out var found)
                ? found
                : throw new InvalidOperationException(
                    $"The row of '{table.TableName}' with the key '{keyText}' was written but cannot be read back."
                );
        }
    }
}

/// <summary>One table's fetched rows, ready to apply.</summary>
/// <param name="Table">The table.</param>
/// <param name="Rows">The fetched server rows, in fetch order.</param>
/// <param name="ServerKeys">The server's key texts (null when delete propagation is off).</param>
/// <param name="OldAnchor">The resume point the fetch started from.</param>
internal sealed record SyncApplyPlan(
    SyncTable Table,
    IReadOnlyList<EntityBaseCore> Rows,
    IReadOnlySet<string>? ServerKeys,
    byte[]? OldAnchor
)
{
    /// <summary>The rows of the table <see cref="SyncConflictPolicy.ServerWins"/> discards, by key text.</summary>
    public IReadOnlyDictionary<string, SyncPlanDiscard> Discards { get; init; } =
        new Dictionary<string, SyncPlanDiscard>(StringComparer.Ordinal);

    /// <summary>The refresh the plan belongs to (null for an ordinary download).</summary>
    public SyncRefresh? Refresh { get; init; }

    /// <summary>Whether the apply reads the row states of the plan's rows and discards only (by key), rather than every row state of the table.</summary>
    public bool ReadsStatesByKey { get; init; }

    /// <summary>
    /// Whether a refresh's apply does what it does to the whole of the table (forgets the rows neither side holds, gives
    /// the unbounded binary columns up); false for a chunk, whose download did that before its first chunk.
    /// </summary>
    public bool RunsTableWideSteps { get; init; } = true;

    /// <summary>
    /// Whether the apply settles only the discards the server no longer holds (their keys are not in
    /// <see cref="ServerKeys"/>), leaving the others to the chunk that brings their server rows.
    /// </summary>
    public bool KeepsDiscardsTheServerHas { get; init; }

    /// <summary>Whether the apply saves the table's resume point (when the apply moves resume points at all).</summary>
    public bool AdvancesAnchor { get; init; } = true;

    /// <summary>
    /// The version just before each row, in the same order as <see cref="Rows"/> (null: the version of the row before it,
    /// and <see cref="OldAnchor"/> for the first).
    /// </summary>
    public IReadOnlyList<byte[]?>? BeforeVersions { get; init; }

    /// <summary>The version the resume point moves to when no row is held back (null: the version of the last row).</summary>
    public byte[]? ThroughVersion { get; init; }

    /// <summary>The version just before the row at the index (where the resume point stops when that row is held back).</summary>
    /// <param name="index">The row's index in <see cref="Rows"/>.</param>
    public byte[]? VersionBefore(int index) =>
        BeforeVersions is { } before ? before[index]
        : index == 0 ? OldAnchor
        : Table.VersionOf(Rows[index - 1]);
}

/// <summary>How one fetch of a run is applied, once that is decided.</summary>
internal enum SyncDownloadRoute
{
    /// <summary>Every fetched row is applied in one transaction.</summary>
    Single,

    /// <summary>The fetched rows are applied a chunk at a time.</summary>
    Chunked,

    /// <summary>The fetch went over the download row limit while the run's tables held unsent changes, and is refused.</summary>
    Refused,
}

/// <summary>How a refresh writes the rows it fetched.</summary>
/// <param name="BlankBinaries">Whether the refresh gives the unbounded binary columns up (the rows it writes come in with them empty).</param>
internal sealed record SyncRefresh(bool BlankBinaries);

/// <summary>An unsent row <see cref="SyncConflictPolicy.ServerWins"/> discards.</summary>
/// <param name="Key">The row's key.</param>
/// <param name="Sequence">The change number read at the start of the run (a row written again since is not discarded).</param>
internal sealed record SyncDiscard(object Key, long Sequence);

/// <summary>An unsent row <see cref="SyncConflictPolicy.ServerWins"/> discards, with the server's row to put back.</summary>
/// <param name="Key">The row's key.</param>
/// <param name="Sequence">The change number read at the start of the run.</param>
/// <param name="Server">The server's row (null when the server no longer has it).</param>
internal sealed record SyncPlanDiscard(object Key, long Sequence, EntityBaseCore? Server);

/// <summary>One unsent row queued for the upload.</summary>
/// <param name="Table">The row's table.</param>
/// <param name="Row">The row's state as read.</param>
/// <param name="Key">The row's key.</param>
/// <param name="KeyText">The row's key text.</param>
internal sealed record SyncQueued(
    SyncTable Table,
    SyncUnsentRow Row,
    object Key,
    string KeyText
);

/// <summary>One server row to write locally.</summary>
/// <param name="Row">The server row.</param>
/// <param name="Key">Its key.</param>
/// <param name="KeyText">Its key text.</param>
/// <param name="State">The row state the local database holds for it (null when it holds none).</param>
internal sealed record SyncRowWrite(EntityBaseCore Row, object Key, string KeyText, SyncRowState? State)
{
    /// <summary>Whether the write puts the server's row back over a row <see cref="SyncConflictPolicy.ServerWins"/> discards.</summary>
    public bool Discard { get; init; }
}

/// <summary>What a download did.</summary>
/// <param name="Downloaded">The number of server rows written locally.</param>
/// <param name="DeletedLocally">The number of local rows the delete propagation removed.</param>
/// <param name="Truncations">The rows held back, one per row.</param>
internal sealed record SyncDownload(
    int Downloaded,
    int DeletedLocally,
    IReadOnlyList<SyncDownloadTruncation> Truncations
)
{
    /// <summary>The number of rows whose unsent change <see cref="SyncConflictPolicy.ServerWins"/> discarded.</summary>
    public int Discarded { get; init; }

    /// <summary>The local rows the download changed on its own (the rows ServerWins discarded).</summary>
    public IReadOnlyList<SyncLocalRowChange> Changes { get; init; } = [];

    /// <summary>The rows deleted and written in each table, by table name.</summary>
    public IReadOnlyDictionary<string, (int Deleted, int Written)> PerTable { get; init; } =
        new Dictionary<string, (int Deleted, int Written)>(StringComparer.Ordinal);
}

/// <summary>One foreign key violation of the local database.</summary>
/// <param name="Child">The child row's table and key text (the key is "?" when it cannot be read).</param>
/// <param name="ParentTable">The parent's table.</param>
/// <param name="ForeignKey">The foreign key's number in its table.</param>
/// <param name="Parent">The parent row's table and key text, when the foreign key refers to the parent's primary key.</param>
/// <param name="LookupColumns">The parent's columns the foreign key refers to, when they are not the primary key.</param>
/// <param name="LookupValues">The child row's values for those columns.</param>
/// <param name="ParentDescriptor">The parent's table, when the engine synchronises it.</param>
internal sealed record SyncViolation(
    (string Table, string Key) Child,
    string ParentTable,
    long ForeignKey,
    (string Table, string Key)? Parent,
    string[]? LookupColumns,
    object?[]? LookupValues,
    SyncTable? ParentDescriptor
)
{
    /// <summary>What tells one violation from another across two checks (not the rowid, which a rewrite can change).</summary>
    public (string ChildTable, string ChildKey, string ParentTable, long ForeignKey) Identity =>
        (Child.Table, Child.Key, ParentTable, ForeignKey);
}
{{~ if remote_services || runtime_package_export ~}}

/// <summary>The operation names of the sync-only endpoints (<c>POST {prefix}/{entity}/{operation}</c>).</summary>
/// <remarks>
/// The server maps them and the client posts to them, so both sides read the route from here and cannot drift apart.
/// They are additions to the same endpoint group as the CRUD operations, which is what makes authorization applied to
/// the group (<c>RemoteAccess.RequireAuthorization</c> at mapping time) cover them as well - and it has to: the
/// changed-rows endpoint hands out whole rows and the key endpoint hands out the entire key set of a table.
/// </remarks>
public static class RemoteSyncOperations
{
    /// <summary>Reads the exclusive upper bound for a sync pass (<c>MIN_ACTIVE_ROWVERSION()</c> on SQL Server).</summary>
    public const string Ceiling = "SyncCeiling";

    /// <summary>Reads one ascending batch of rows above an anchor and below a ceiling.</summary>
    public const string Changes = "SyncChanges";

    /// <summary>Reads every primary key the server holds for a table.</summary>
    public const string Keys = "SyncKeys";

    /// <summary>Reads one ascending batch of rows above a primary key (the versionless full scan; mapped only for tables without a version column).</summary>
    public const string Page = "SyncPage";
}

/// <summary>The response of <see cref="RemoteSyncOperations.Ceiling"/>.</summary>
/// <param name="Ceiling">The exclusive upper bound, or null when the server applies none.</param>
public sealed record RemoteSyncCeilingResult(byte[]? Ceiling);

/// <summary>The request of <see cref="RemoteSyncOperations.Changes"/>.</summary>
/// <param name="Anchor">The resume point (null takes everything below the ceiling).</param>
/// <param name="Ceiling">The exclusive upper bound the caller obtained for this pass (null applies none).</param>
/// <param name="BatchSize">The maximum number of rows to return (must be greater than zero).</param>
/// <remarks>
/// The ceiling travels from the client rather than being read again per request, because one pass has to use a single
/// bound: a bound re-read between two tables would let a row committed in between fall into the gap between them. The
/// consequence is that the guarantee behind the resume point only holds while the client sends the value
/// <see cref="RemoteSyncOperations.Ceiling"/> returned for the same pass. A ceiling above the server's own lowest
/// active version skips the rows still in flight beneath it permanently - the anchor moves past them and no later pass
/// looks below it again - so the value is not something a caller should invent.
/// </remarks>
public sealed record RemoteSyncChangesRequest(byte[]? Anchor, byte[]? Ceiling, int BatchSize);

/// <summary>The response of <see cref="RemoteSyncOperations.Changes"/>.</summary>
/// <param name="Rows">The changed rows, in ascending version order.</param>
/// <param name="HasMore">Whether asking again from the last row's version can still return something.</param>
/// <typeparam name="TEntity">The entity type.</typeparam>
public sealed record RemoteSyncChangesResult<TEntity>(IReadOnlyList<TEntity> Rows, bool HasMore)
    where TEntity : EntityBaseCore, new();

/// <summary>The response of <see cref="RemoteSyncOperations.Keys"/>.</summary>
/// <param name="Keys">Every primary key the server holds for the table.</param>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record RemoteSyncKeysResult<TKey>(IReadOnlyList<TKey> Keys);

/// <summary>The request of <see cref="RemoteSyncOperations.Page"/> (the response is a <see cref="RemoteSyncChangesResult{TEntity}"/>).</summary>
/// <param name="HasAfterKey">Whether <paramref name="AfterKey"/> carries a cursor (false asks for the first page).</param>
/// <param name="AfterKey">The last key of the previous batch (the exclusive lower bound), meaningful only when <paramref name="HasAfterKey"/> is true.</param>
/// <param name="BatchSize">The maximum number of rows to return (must be greater than zero).</param>
/// <remarks>
/// The cursor travels beside a flag rather than as a nullable value, because the key type is generic: a value-typed
/// key has no null to stand for "from the beginning", and a default value (zero, say) is a legitimate key.
/// </remarks>
/// <typeparam name="TKey">The primary key type.</typeparam>
public sealed record RemoteSyncPageRequest<TKey>(bool HasAfterKey, TKey? AfterKey, int BatchSize);

/// <summary>
/// The differential source for one entity type over HTTP: the sync-only endpoints for reading, and the ordinary remote
/// endpoints for replaying the local changes.
/// </summary>
/// <remarks>
/// <para>
/// It is an <see cref="HttpRemoteRepositoryCore{TEntity, TKey}"/> as well as a source, so <see cref="Writer"/> is the very
/// same client: the reads and the writes of one pass travel over one connection with one configuration, and every
/// failure - a conflict restored as <see cref="SaveConflictException"/>, a body that could not be read, a withheld
/// server message and its correlation id - is classified exactly as it is for any other remote call.
/// </para>
/// <para>
/// Nothing here is stateful. The resume point travels as the anchor in each request and the bound as the ceiling, so a
/// run interrupted at any point resumes by asking again with the anchor the local database now holds; the server keeps no
/// per-client bookkeeping and two clients on the same table do not interfere.
/// </para>
/// <para>
/// The wire format these endpoints speak is not promised to stay compatible across QuickER versions while the tool is
/// at 0.x, and nothing on the wire announces a mismatch, so regenerate the client and the server from the same diagram
/// and deploy them together.
/// </para>
/// </remarks>
/// <typeparam name="TEntity">The entity type.</typeparam>
/// <typeparam name="TKey">The primary key type.</typeparam>
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
public sealed class HttpSyncServerSource<TEntity, TKey>
    : HttpRemoteRepositoryCore<TEntity, TKey>,
        ISyncServerSource<TEntity, TKey>,
        ISyncBinaryColumns<TKey>
    where TEntity : EntityBaseCore, new()
{
{{~ else ~}}
public sealed class HttpSyncServerSource<TEntity, TKey>
    : HttpRemoteRepositoryCore<TEntity, TKey>, ISyncServerSource<TEntity, TKey>
    where TEntity : EntityBaseCore, new()
{
{{~ end ~}}
{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    private readonly SyncTableDescriptor<TEntity, TKey> _descriptor;

    /// <summary>Initializes a new instance with the HTTP client and the table's descriptor (which names the route).</summary>
    public HttpSyncServerSource(
        HttpClient httpClient,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(httpClient, RouteOf(descriptor))
    {
        _descriptor = descriptor;
    }
{{~ else ~}}
    /// <summary>Initializes a new instance with the HTTP client and the table's descriptor (which names the route).</summary>
    public HttpSyncServerSource(
        HttpClient httpClient,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        : base(httpClient, RouteOf(descriptor)) { }
{{~ end ~}}

    /// <summary>Reads the route off the descriptor before the base constructor runs (which is why it is static).</summary>
    private static string RouteOf(SyncTableDescriptor<TEntity, TKey> descriptor)
    {
        ArgumentNullException.ThrowIfNull(descriptor);

        return descriptor.RemoteRouteName;
    }

    /// <inheritdoc />
    /// <remarks>The client itself: the same connection, the same configuration, and the same failure classification.</remarks>
    public IRemoteRepositoryCore<TEntity, TKey> Writer => this;

{{~ if exclude_unbounded_binary || runtime_package_export ~}}
    /// <inheritdoc />
    /// <remarks>
    /// The client itself again, when the table has such columns: they stream over the same binary endpoints the remote
    /// repository uses, so no second connection or configuration is involved.
    /// </remarks>
    public ISyncBinaryColumns<TKey>? BinaryColumns =>
        _descriptor.UnboundedBinaryColumnNames.Count == 0 ? null : this;

    /// <inheritdoc />
    public IReadOnlyList<string> UnboundedBinaryColumnNames =>
        _descriptor.UnboundedBinaryColumnNames;

    /// <inheritdoc />
    public Task<bool> ReadUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream destination,
        CancellationToken cancellationToken = default
    ) =>
        DownloadUnboundedBinaryColumnAsync(
            KnownColumn(columnName),
            id,
            destination,
            cancellationToken
        );

    /// <inheritdoc />
    public Task<bool> WriteUnboundedBinaryAsync(
        string columnName,
        TKey id,
        Stream? source,
        long? length,
        CancellationToken cancellationToken = default
    ) =>
        UploadUnboundedBinaryColumnAsync(
            KnownColumn(columnName),
            id,
            source,
            length,
            cancellationToken
        );

    /// <summary>Refuses a column name the table does not have, rather than asking the server for a route that has none.</summary>
    private string KnownColumn(string columnName) =>
        _descriptor.UnboundedBinaryColumnNames.Contains(columnName)
            ? columnName
            : throw new ArgumentOutOfRangeException(
                nameof(columnName),
                columnName,
                "The column is not an unbounded binary column of this table."
            );
{{~ end ~}}

    /// <inheritdoc />
    public async Task<byte[]?> GetChangeCeilingAsync(CancellationToken cancellationToken = default)
    {
        var result = await InvokeAsync<RemoteSyncCeilingResult>(
            RemoteSyncOperations.Ceiling,
            null,
            cancellationToken
        ).ConfigureAwait(false);

        return result.Ceiling;
    }

    /// <inheritdoc />
    public async Task<SyncChangeBatch<TEntity>> GetChangesAsync(
        byte[]? anchor,
        byte[]? ceiling,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Changes,
            new RemoteSyncChangesRequest(anchor, ceiling, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }

    /// <inheritdoc />
    public async Task<IReadOnlyList<TKey>> GetAllKeysAsync(
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncKeysResult<TKey>>(
            RemoteSyncOperations.Keys,
            null,
            cancellationToken
        ).ConfigureAwait(false);

        return result.Keys;
    }

    /// <inheritdoc />
    /// <remarks>The server maps the page endpoint only for tables without a version column; nothing asks a versioned table for it.</remarks>
    public async Task<SyncChangeBatch<TEntity>> GetFirstPageAsync(
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Page,
            new RemoteSyncPageRequest<TKey>(false, default, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }

    /// <inheritdoc />
    public async Task<SyncChangeBatch<TEntity>> GetPageAfterAsync(
        TKey afterKey,
        int batchSize,
        CancellationToken cancellationToken = default
    )
    {
        var result = await InvokeAsync<RemoteSyncChangesResult<TEntity>>(
            RemoteSyncOperations.Page,
            new RemoteSyncPageRequest<TKey>(true, afterKey, batchSize),
            cancellationToken
        ).ConfigureAwait(false);

        return new SyncChangeBatch<TEntity>(result.Rows, result.HasMore);
    }
}
{{~ end ~}}
{{~ end ~}}
{{~ if render_sync && emit_schema_dependent ~}}

/// <summary>The descriptors of the synchronised tables.</summary>
/// <remarks>
/// <para>
/// This is the whole of what a table contributes to the sync support: its name, the SQL that carries its identity, and
/// the accessors that read a key, a mirrored version, and an unbounded binary column off it. The behaviour lives once in
/// the fixed engine, which takes a descriptor rather than being subclassed per table.
/// </para>
/// <para>
/// <see cref="All"/> holds every synchronised table, in foreign-key order (parents first), whatever a particular engine
/// was built to exclude.
/// </para>
/// </remarks>
public static class GeneratedSyncTables
{
{{~ for sync in sync_tables ~}}
    /// <summary>The descriptor of {{ sync.table_name_xml_doc }}.</summary>
    public static SyncTableDescriptor<{{ sync.entity_class_name }}, {{ sync.key_type_name }}> {{ sync.descriptor_property_name }} { get; } =
        new()
        {
            TableName = "{{ sync.table_name }}",
            LocalTableName = "{{ sync.local_table_name }}",
            LocalKeyColumnName = "{{ sync.local_key_column_name }}",
            RemoteRouteName = "{{ sync.remote_route_name }}",
            IsVersionless = {{ sync.is_versionless }},
            ReadKey = entity => entity.{{ sync.key_property_name }},
            WriteKey = (entity, key) => entity.{{ sync.key_property_name }} = key,
            FormatKey = key => {{ sync.format_key_expression }},
            ParseKey = keyText => {{ sync.parse_key_expression }},
{{~ if !sync.is_versionless ~}}
            ReadRowVersion = entity => {{ sync.row_version_read_expression }},
            WriteRowVersion = (entity, rowVersion) => {{ sync.row_version_write_expression }},
{{~ end ~}}
            ServerKeysSql = {{ sync.server_keys_sql }},
{{~ if sync.is_versionless ~}}
            ServerPageFirstSql = {{ sync.server_page_first_sql }},
            ServerPageAfterSql = {{ sync.server_page_after_sql }},
{{~ else ~}}
            ServerChangesSql = {{ sync.server_changes_sql }},
{{~ end ~}}
{{~ if sync.binary_accessors_block != "" ~}}
{{ sync.binary_accessors_block }}
{{~ end ~}}
{{~ if sync.local_unbounded_binary_column_names != "" ~}}
            LocalUnboundedBinaryColumnNames = [{{ sync.local_unbounded_binary_column_names }}],
{{~ end ~}}
{{~ if sync.fill_unset_unbounded_binaries_block != "" ~}}
{{ sync.fill_unset_unbounded_binaries_block }}
{{~ end ~}}
{{~ if sync.parent_references_block != "" ~}}
{{ sync.parent_references_block }}
{{~ end ~}}
{{~ if sync.unlisted_referencing_table_names_block != "" ~}}
{{ sync.unlisted_referencing_table_names_block }}
{{~ end ~}}
{{~ if sync.local_references_block != "" ~}}
{{ sync.local_references_block }}
{{~ end ~}}
        };

{{~ end ~}}
    /// <summary>Every synchronised table's descriptor, in foreign-key order (parents first).</summary>
    public static IReadOnlyList<ISyncTableDescriptor> All { get; } =
    [
{{~ for sync in sync_tables ~}}
        {{ sync.descriptor_property_name }},
{{~ end ~}}
    ];
}

/// <summary>DI registration for the bidirectional sync support.</summary>
/// <remarks>
/// <para>
/// The registration comes in two halves, and which half is combined with which is the only thing that decides how the
/// server is reached. The local half - <c>AddGeneratedSyncEngine</c> - wraps the registration of the local connection
/// factory, so that every time a connection opens the triggers that record the local changes and the state tables are
/// checked and put in place if they are missing, and registers the engine. A local write is recorded by the triggers of
/// the synchronised tables whichever entry point writes it - a repository or raw SQL. The server half registers the
/// differential sources, either
/// <c>AddGeneratedDirectSyncSources</c> (a database connection this process holds){{ if remote_services }} or
/// <c>AddGeneratedHttpSyncSources</c> (a server reached over HTTP){{ end }}. Swapping direct for remote is a change of that
/// one line and of nothing else: the engine resolves <c>ISyncServerSource&lt;,&gt;</c> either way.
/// </para>
/// <para>
/// <c>AddGeneratedSyncSupport</c> is the two halves together for the all-direct setup, which is the common case when both
/// databases are reachable from the same process.
/// </para>
/// <para>
/// Every key argument accepts <c>null</c>, which means the ordinary non-keyed registration rather than a key whose value
/// is null - the two never collide, because a keyed registration cannot be made with a null key. A server process that
/// registers its repositories plainly therefore passes <c>null</c>, while a hybrid client that holds two engines at once
/// passes the keys it registered them under.
/// </para>
/// <para>
/// The wrapping keeps the way the original registration builds the connection factory - its factory, its implementation
/// type or its instance - and its lifetime, so the local repositories still get the connection factory their own
/// registration built, keyed or not.
/// </para>
/// </remarks>
public static class GeneratedSyncServiceCollectionExtensions
{
    /// <summary>Registers the sync engine and the direct server sources together (the all-direct setup).</summary>
    /// <param name="services">The service collection.</param>
    /// <param name="serverServiceKey">The key the server (SQL Server) repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="localServiceKey">The key the local (SQLite) repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="excludeFromSync">Entity types this engine never synchronises (see <c>AddGeneratedSyncEngine</c>).</param>
    public static IServiceCollection AddGeneratedSyncSupport(
        this IServiceCollection services,
        object? serverServiceKey,
        object? localServiceKey,
        IReadOnlyCollection<Type>? excludeFromSync = null
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        AddGeneratedDirectSyncSources(services, serverServiceKey);

        return AddGeneratedSyncEngine(services, localServiceKey, excludeFromSync);
    }

    /// <summary>Registers the differential sources that read the server over a direct database connection.</summary>
    /// <remarks>
    /// This is also what a server process registers before mapping the sync endpoints: those endpoints are a thin
    /// remoting of this very interface, so the server answers them from the same source a co-located client would use.
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="serverServiceKey">The key the server (SQL Server) repositories were registered under (null for the non-keyed registration).</param>
    public static IServiceCollection AddGeneratedDirectSyncSources(
        this IServiceCollection services,
        object? serverServiceKey
    )
    {
        ArgumentNullException.ThrowIfNull(services);
{{~ for sync in sync_tables ~}}

        AddDirectSource<{{ sync.entity_class_name }}, {{ sync.key_type_name }}, {{ sync.interface_name }}>(
            services,
            serverServiceKey,
            GeneratedSyncTables.{{ sync.descriptor_property_name }}
        );
{{~ end ~}}

        return services;
    }

    /// <summary>Registers one table's differential source over a direct database connection.</summary>
    /// <remarks>
    /// The server repository stands in two places at once: it is the writer local changes are replayed against, and -
    /// for a table with unbounded binary columns - the surface those columns are copied through.
    /// </remarks>
    /// <typeparam name="TEntity">The entity type.</typeparam>
    /// <typeparam name="TKey">The primary key type.</typeparam>
    /// <typeparam name="TRepository">The generated repository contract of the entity.</typeparam>
    /// <param name="services">The service collection.</param>
    /// <param name="serverServiceKey">The key the server repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="descriptor">The table's descriptor.</param>
    private static void AddDirectSource<TEntity, TKey, TRepository>(
        IServiceCollection services,
        object? serverServiceKey,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        where TEntity : EntityBaseCore, new()
        where TRepository : class, IRepository<TEntity, TKey> =>
        services.AddScoped<ISyncServerSource<TEntity, TKey>>(provider =>
        {
            var serverSqlExecutor = Resolve<ISqlExecutor>(provider, serverServiceKey);
            var serverRepository = Resolve<TRepository>(provider, serverServiceKey);

            if (descriptor.IsVersionless)
            {
                return new VersionlessDirectSyncSource<TEntity, TKey>(
                    serverSqlExecutor,
                    serverRepository,
                    descriptor
                );
            }

            return new DirectSyncSource<TEntity, TKey>(
                serverSqlExecutor,
                serverRepository,
                descriptor
            );
        });
{{~ if remote_services ~}}

    /// <summary>Registers the differential sources that read - and write - the server over HTTP.</summary>
    /// <remarks>
    /// <para>
    /// The client it builds recycles pooled connections every five minutes and carries no deadline of its own, exactly as
    /// the base-address overload of <c>AddGeneratedHttpRemoteRepositories</c> does, and the container owns it. Pass the
    /// same base address the remote repositories were given: both talk to the endpoints of one group.
    /// </para>
    /// <para>
    /// A server that needs authentication headers, a handler chain, or a shared <c>IHttpClientFactory</c> client is served
    /// by the factory overload instead - hand it the same factory the remote repositories were registered with, and the
    /// sync traffic inherits that configuration rather than bypassing it.
    /// </para>
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="baseAddress">The base address including the server prefix - the one <c>MapGeneratedRemoteEndpoints</c> was mapped under, <see cref="RemotePaths.DefaultPrefix"/> unless it was passed another (a trailing / is appended automatically)</param>
    public static IServiceCollection AddGeneratedHttpSyncSources(
        this IServiceCollection services,
        string baseAddress
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        ArgumentException.ThrowIfNullOrWhiteSpace(baseAddress);

        // A trailing / is required to resolve relative paths ("Order/SyncChanges" etc.), so append it
        var normalized = baseAddress.EndsWith('/') ? baseAddress : baseAddress + "/";

        // Registered as a factory-produced singleton so the container owns it: it disposes only the singletons it
        // created itself, which is what makes the shared client go away with the provider
        services.AddSingleton(_ => new OwnedSyncHttpClient(
            new HttpClient(
                new SocketsHttpHandler { PooledConnectionLifetime = TimeSpan.FromMinutes(5) },
                disposeHandler: true
            )
            {
                BaseAddress = new Uri(normalized),
                // No client-wide deadline: the 100-second default covers a whole request including its body, and a
                // download batch of a large table can outlast it. The per-call CancellationToken is the timeout instead
                Timeout = Timeout.InfiniteTimeSpan,
            }
        ));

        return AddGeneratedHttpSyncSources(
            services,
            provider => provider.GetRequiredService<OwnedSyncHttpClient>().Client
        );
    }

    /// <summary>Registers the differential sources over HTTP using an HttpClient factory (authentication handlers and the like).</summary>
    /// <remarks>
    /// The factory runs every time a source is resolved, and the HttpClient it returns is disposed by neither the
    /// generated code nor the container. Return a shared instance or one managed by <c>IHttpClientFactory</c>; a new
    /// HttpClient per call exhausts sockets. Its BaseAddress must include the prefix and end with a trailing /.
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="httpClientFactory">A factory returning the HttpClient the sources talk through</param>
    public static IServiceCollection AddGeneratedHttpSyncSources(
        this IServiceCollection services,
        Func<IServiceProvider, HttpClient> httpClientFactory
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        ArgumentNullException.ThrowIfNull(httpClientFactory);
{{~ for sync in sync_tables ~}}

        AddHttpSource<{{ sync.entity_class_name }}, {{ sync.key_type_name }}>(
            services,
            httpClientFactory,
            GeneratedSyncTables.{{ sync.descriptor_property_name }}
        );
{{~ end ~}}

        return services;
    }

    /// <summary>Registers one table's differential source over HTTP.</summary>
    /// <remarks>
    /// One class serves both shapes of table here, because the wire format already distinguishes them: the versionless
    /// scan asks the page endpoint, which the server maps only for the tables that have one.
    /// </remarks>
    /// <typeparam name="TEntity">The entity type.</typeparam>
    /// <typeparam name="TKey">The primary key type.</typeparam>
    /// <param name="services">The service collection.</param>
    /// <param name="httpClientFactory">A factory returning the HttpClient the source talks through.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    private static void AddHttpSource<TEntity, TKey>(
        IServiceCollection services,
        Func<IServiceProvider, HttpClient> httpClientFactory,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        where TEntity : EntityBaseCore, new() =>
        services.AddScoped<ISyncServerSource<TEntity, TKey>>(provider =>
            new HttpSyncServerSource<TEntity, TKey>(httpClientFactory(provider), descriptor)
        );
{{~ end ~}}

    /// <summary>Registers the local half: wraps the local connection factory in the change tracking check and registers the engine.</summary>
    /// <remarks>
    /// <para>
    /// The differential sources are resolved rather than registered here, so exactly one of
    /// <c>AddGeneratedDirectSyncSources</c>{{ if remote_services }} / <c>AddGeneratedHttpSyncSources</c>{{ end }} has to be
    /// called as well. Leaving that out is not a silent failure: resolving the engine then fails on the missing source.
    /// </para>
    /// <para>
    /// <c>excludeFromSync</c> is the local-only declaration: an excluded table is not one of the engine's tables (no run
    /// downloads it, propagates deletes into it, or rebuilds it in a refresh), and it gets no triggers, so its writes are not
    /// recorded. Triggers an earlier registration put on it are not removed here: they keep recording, and the rows they
    /// record are never sent. It is not a per-run scope - that is <see cref="SyncOptions.ExcludedEntityTypes"/>. A type
    /// that is not a synchronised entity type, or an exclusion that leaves no table at all, is rejected here rather than
    /// discovered at the first run.
    /// </para>
    /// <para>
    /// Register the local repositories - their connection factory - before this call. A connection factory registered
    /// again after it is refused when the engine is resolved: its connections would open without the check, and the local
    /// changes would go unrecorded.
    /// </para>
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="localServiceKey">The key the local (SQLite) repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="excludeFromSync">Entity types this engine never synchronises (null or empty keeps every table).</param>
    public static IServiceCollection AddGeneratedSyncEngine(
        this IServiceCollection services,
        object? localServiceKey,
        IReadOnlyCollection<Type>? excludeFromSync = null
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        var excluded = ValidatedSyncExclusions(excludeFromSync);

        // The triggers go on the tables this registration synchronises, and on no other
        ISyncTableDescriptor[] synchronised =
        [
            .. GeneratedSyncTables.All.Where(descriptor => !excluded.Contains(descriptor.EntityType)),
        ];
        var guard = new SyncLocalTrackingGuard(synchronised);

        ObserveLocalConnections(services, localServiceKey, guard);

        services.AddScoped(provider =>
        {
            var rows = new SqliteLocalRowStore(ObservedLocalConnectionFactory(provider, localServiceKey));
            var tables = new List<SyncTable>();
{{~ for sync in sync_tables ~}}

            if (!excluded.Contains(typeof({{ sync.entity_class_name }})))
            {
                tables.Add(
                    new SyncTable<{{ sync.entity_class_name }}, {{ sync.key_type_name }}>(
                        GeneratedSyncTables.{{ sync.descriptor_property_name }},
                        provider.GetRequiredService<ISyncServerSource<{{ sync.entity_class_name }}, {{ sync.key_type_name }}>>(),
                        rows
                    )
                );
            }
{{~ end ~}}

            return new SyncEngine(tables);
        });

        return services;
    }

    /// <summary>Validates the construction-time exclusions: every named type must be synchronised, and at least one table must remain.</summary>
    /// <remarks>
    /// A name outside the synchronised set is rejected rather than skipped - a silently ignored exclusion would read
    /// as if it had worked - and excluding everything is rejected because an engine with no table is a configuration
    /// error wearing a valid registration.
    /// </remarks>
    private static HashSet<Type> ValidatedSyncExclusions(
        IReadOnlyCollection<Type>? excludeFromSync
    )
    {
        Type[] synchronised =
        [
            .. GeneratedSyncTables.All.Select(descriptor => descriptor.EntityType),
        ];
        var excluded = new HashSet<Type>(excludeFromSync ?? []);
        var unknown = excluded.Where(type => !synchronised.Contains(type)).ToList();

        if (unknown.Count > 0)
        {
            throw new ArgumentException(
                "excludeFromSync names types that are not synchronised entity types: "
                    + string.Join(", ", unknown.Select(type => type.Name))
                    + ".",
                nameof(excludeFromSync)
            );
        }

        if (excluded.Count >= synchronised.Length)
        {
            throw new ArgumentException(
                "excludeFromSync excludes every synchronised table, which leaves the engine nothing to do. "
                    + "Generate without sync support instead of excluding everything.",
                nameof(excludeFromSync)
            );
        }

        return excluded;
    }

    /// <summary>Resolves a service that was registered either under a key or plainly (<c>null</c> means the plain one).</summary>
    private static TService Resolve<TService>(IServiceProvider provider, object? serviceKey)
        where TService : notnull =>
        serviceKey is null
            ? provider.GetRequiredService<TService>()
            : provider.GetRequiredKeyedService<TService>(serviceKey);

    /// <summary>
    /// Replaces the registration of the local connection factory with one that wraps it in the change tracking check,
    /// keeping the way it was built and its lifetime.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The last registration for the key is the one the container resolves, so it is the one replaced. The inner
    /// connection factory is produced the way the registration produced it: a factory registration (the registrations
    /// the generated code makes) by calling that same factory, an instance registration by wrapping that instance, and a
    /// type registration by an activator built once here from the implementation type, which fills the constructor from
    /// the container the way the container itself would. The wrapper keeps the lifetime of the registration it replaces.
    /// </para>
    /// <para>
    /// A non-keyed registration is found by the same predicate as a keyed one, because a plain descriptor carries a
    /// null service key and a keyed one can never be made with a null key.
    /// </para>
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="serviceKey">The key the local connection factory was registered under (null for the non-keyed registration).</param>
    /// <param name="guard">The check that runs every time a local connection opens.</param>
    private static void ObserveLocalConnections(
        IServiceCollection services,
        object? serviceKey,
        SyncLocalTrackingGuard guard
    )
    {
        var descriptor =
            services.LastOrDefault(candidate =>
                candidate.ServiceType == typeof(ISqlConnectionFactory)
                && Equals(candidate.ServiceKey, serviceKey)
            )
            ?? throw new InvalidOperationException(
                $"No registration of {nameof(ISqlConnectionFactory)} was found for the service key "
                    + $"'{serviceKey}'. Register the local repositories before calling AddGeneratedSyncEngine."
            );
        var create = LocalConnectionFactoryOf(descriptor);
        var lifetime = descriptor.Lifetime;

        services.Remove(descriptor);

        if (serviceKey is null)
        {
            services.Add(
                new ServiceDescriptor(
                    typeof(ISqlConnectionFactory),
                    provider => new ObservedSqlConnectionFactory(
                        create(provider, null),
                        guard.OnStateChange
                    ),
                    lifetime
                )
            );

            return;
        }

        services.Add(
            new ServiceDescriptor(
                typeof(ISqlConnectionFactory),
                serviceKey,
                (provider, key) => new ObservedSqlConnectionFactory(
                    create(provider, key),
                    guard.OnStateChange
                ),
                lifetime
            )
        );
    }

    /// <summary>Builds what produces the connection factory a registration stands for, whatever form the registration takes.</summary>
    /// <param name="descriptor">The registration the wrapper replaces.</param>
    /// <returns>A function of the provider and the service key that returns the inner connection factory.</returns>
    private static Func<IServiceProvider, object?, ISqlConnectionFactory> LocalConnectionFactoryOf(
        ServiceDescriptor descriptor
    )
    {
        if (descriptor.IsKeyedService)
        {
            if (descriptor.KeyedImplementationFactory is { } keyedFactory)
            {
                return (provider, key) => (ISqlConnectionFactory)keyedFactory(provider, key);
            }

            if (descriptor.KeyedImplementationInstance is { } keyedInstance)
            {
                return (_, _) => (ISqlConnectionFactory)keyedInstance;
            }

            return Activate(descriptor.KeyedImplementationType);
        }

        if (descriptor.ImplementationFactory is { } factory)
        {
            return (provider, _) => (ISqlConnectionFactory)factory(provider);
        }

        if (descriptor.ImplementationInstance is { } instance)
        {
            return (_, _) => (ISqlConnectionFactory)instance;
        }

        return Activate(descriptor.ImplementationType);

        Func<IServiceProvider, object?, ISqlConnectionFactory> Activate(Type? implementationType)
        {
            if (implementationType is null)
            {
                throw new InvalidOperationException(
                    $"The registration of {nameof(ISqlConnectionFactory)} for the service key '{descriptor.ServiceKey}' "
                        + "names no factory, instance or implementation type, so AddGeneratedSyncEngine cannot build the "
                        + "connection factory it wraps."
                );
            }

            var activator = ActivatorUtilities.CreateFactory(implementationType, Type.EmptyTypes);

            return (provider, _) => (ISqlConnectionFactory)activator(provider, null);
        }
    }

    /// <summary>Resolves the local connection factory and checks that it is the one <c>AddGeneratedSyncEngine</c> wrapped.</summary>
    /// <remarks>
    /// A connection factory registered again after <c>AddGeneratedSyncEngine</c> takes the place of the wrapped one, and
    /// its connections open without the change tracking check. The engine is refused here, by name, rather than built
    /// over local changes that would go unrecorded.
    /// </remarks>
    /// <param name="provider">The service provider.</param>
    /// <param name="serviceKey">The key the local connection factory was registered under (null for the non-keyed registration).</param>
    private static ObservedSqlConnectionFactory ObservedLocalConnectionFactory(
        IServiceProvider provider,
        object? serviceKey
    ) =>
        Resolve<ISqlConnectionFactory>(provider, serviceKey) as ObservedSqlConnectionFactory
        ?? throw new InvalidOperationException(
            $"The local connection factory for the service key '{serviceKey}' is not the one AddGeneratedSyncEngine "
                + "wrapped, so the change tracking is not checked when its connections open and the local changes would "
                + "go unrecorded. Register the connection factory before calling AddGeneratedSyncEngine."
        );
{{~ if remote_services ~}}

    /// <summary>Container-owned holder for the shared HttpClient created by the base-address overload.</summary>
    /// <remarks>
    /// Registering the holder as a singleton produced by a factory is what makes the DI container the owner: the
    /// container disposes the singletons it creates itself, so the wrapped HttpClient goes away with the
    /// <see cref="IServiceProvider"/>. It is a holder of its own rather than the one the remote repositories use,
    /// because the two registrations are independent - either can be present without the other, and a setup that wants
    /// one shared client for both passes the same factory to both factory overloads.
    /// </remarks>
    private sealed class OwnedSyncHttpClient(HttpClient client) : IDisposable
    {
        /// <summary>Gets the shared client handed to the generated sync sources.</summary>
        public HttpClient Client { get; } = client;

        /// <summary>Disposes the shared client (called by the DI container when the provider is disposed).</summary>
        public void Dispose() => Client.Dispose();
    }
{{~ end ~}}
}
{{~ end ~}}
{{~ if block_namespace ~}}
}
{{~ end ~}}

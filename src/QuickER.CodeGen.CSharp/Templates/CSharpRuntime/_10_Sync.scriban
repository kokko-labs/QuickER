/// <summary>DI registration for the bidirectional sync support.</summary>
/// <remarks>
/// <para>
/// The registration comes in two halves, and which half is combined with which is the only thing that decides how the
/// server is reached. The local half - <c>AddGeneratedSyncEngine</c> - registers the journal, the per-table descriptors,
/// and the engine, and wraps the local repositories with their journaling decorators so every local write is recorded no
/// matter which entry point the application uses. The server half registers the differential sources, either
/// <c>AddGeneratedDirectSyncSources</c> (a database connection this process holds){{ if remote_services }} or
/// <c>AddGeneratedHttpSyncSources</c> (a server reached over HTTP){{ end }}. Swapping direct for remote is a change of that
/// one line and of nothing else: the engine resolves <c>ISyncServerSource&lt;,&gt;</c> either way.
/// </para>
/// <para>
/// <c>AddGeneratedSyncSupport</c> is the two halves together for the all-direct setup, which is the common case when both
/// databases are reachable from the same process.
/// </para>
/// <para>
/// Every key argument accepts <c>null</c>, which means the ordinary non-keyed registration rather than a key whose value
/// is null - the two never collide, because a keyed registration cannot be made with a null key. A server process that
/// registers its repositories plainly therefore passes <c>null</c>, while a hybrid client that holds two engines at once
/// passes the keys it registered them under.
/// </para>
/// <para>
/// The decoration keeps the original registration's factory and calls it for the inner instance, so the local
/// repositories are still built exactly as their own registration built them.
/// </para>
/// </remarks>
public static class GeneratedSyncServiceCollectionExtensions
{
    /// <summary>Registers the sync engine and the direct server sources together (the all-direct setup).</summary>
    /// <param name="services">The service collection.</param>
    /// <param name="serverServiceKey">The key the server (SQL Server) repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="localServiceKey">The key the local (SQLite) repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="excludeFromSync">Entity types this engine never synchronises (see <c>AddGeneratedSyncEngine</c>).</param>
    public static IServiceCollection AddGeneratedSyncSupport(
        this IServiceCollection services,
        object? serverServiceKey,
        object? localServiceKey,
        IReadOnlyCollection<Type>? excludeFromSync = null
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        AddGeneratedDirectSyncSources(services, serverServiceKey);

        return AddGeneratedSyncEngine(services, localServiceKey, excludeFromSync);
    }

    /// <summary>Registers the differential sources that read the server over a direct database connection.</summary>
    /// <remarks>
    /// This is also what a server process registers before mapping the sync endpoints: those endpoints are a thin
    /// remoting of this very interface, so the server answers them from the same source a co-located client would use.
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="serverServiceKey">The key the server (SQL Server) repositories were registered under (null for the non-keyed registration).</param>
    public static IServiceCollection AddGeneratedDirectSyncSources(
        this IServiceCollection services,
        object? serverServiceKey
    )
    {
        ArgumentNullException.ThrowIfNull(services);
{{~ for sync in sync_tables ~}}

        AddDirectSource<{{ sync.entity_class_name }}, {{ sync.key_type_name }}, {{ sync.interface_name }}>(
            services,
            serverServiceKey,
            GeneratedSyncTables.{{ sync.descriptor_property_name }}
        );
{{~ end ~}}

        return services;
    }

    /// <summary>Registers one table's differential source over a direct database connection.</summary>
    /// <remarks>
    /// The server repository stands in two places at once: it is the writer local changes are replayed against, and -
    /// for a table with unbounded binary columns - the surface those columns are copied through.
    /// </remarks>
    /// <typeparam name="TEntity">The entity type.</typeparam>
    /// <typeparam name="TKey">The primary key type.</typeparam>
    /// <typeparam name="TRepository">The generated repository contract of the entity.</typeparam>
    /// <param name="services">The service collection.</param>
    /// <param name="serverServiceKey">The key the server repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="descriptor">The table's descriptor.</param>
    private static void AddDirectSource<TEntity, TKey, TRepository>(
        IServiceCollection services,
        object? serverServiceKey,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        where TEntity : EntityBaseCore, new()
        where TRepository : class, IRepository<TEntity, TKey> =>
        services.AddScoped<ISyncServerSource<TEntity, TKey>>(provider =>
        {
            var serverSqlExecutor = Resolve<ISqlExecutor>(provider, serverServiceKey);
            var serverRepository = Resolve<TRepository>(provider, serverServiceKey);

            if (descriptor.IsVersionless)
            {
                return new VersionlessDirectSyncSource<TEntity, TKey>(
                    serverSqlExecutor,
                    serverRepository,
                    descriptor
                );
            }

            return new DirectSyncSource<TEntity, TKey>(
                serverSqlExecutor,
                serverRepository,
                descriptor
            );
        });
{{~ if remote_services ~}}

    /// <summary>Registers the differential sources that read - and write - the server over HTTP.</summary>
    /// <remarks>
    /// <para>
    /// The client it builds recycles pooled connections every five minutes and carries no deadline of its own, exactly as
    /// the base-address overload of <c>AddGeneratedHttpRemoteRepositories</c> does, and the container owns it. Pass the
    /// same base address the remote repositories were given: both talk to the endpoints of one group.
    /// </para>
    /// <para>
    /// A server that needs authentication headers, a handler chain, or a shared <c>IHttpClientFactory</c> client is served
    /// by the factory overload instead - hand it the same factory the remote repositories were registered with, and the
    /// sync traffic inherits that configuration rather than bypassing it.
    /// </para>
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="baseAddress">The base address including the server prefix - the one <c>MapGeneratedRemoteEndpoints</c> was mapped under, <see cref="RemotePaths.DefaultPrefix"/> unless it was passed another (a trailing / is appended automatically)</param>
    public static IServiceCollection AddGeneratedHttpSyncSources(
        this IServiceCollection services,
        string baseAddress
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        ArgumentException.ThrowIfNullOrWhiteSpace(baseAddress);

        // A trailing / is required to resolve relative paths ("Order/SyncChanges" etc.), so append it
        var normalized = baseAddress.EndsWith('/') ? baseAddress : baseAddress + "/";

        // Registered as a factory-produced singleton so the container owns it: it disposes only the singletons it
        // created itself, which is what makes the shared client go away with the provider
        services.AddSingleton(_ => new OwnedSyncHttpClient(
            new HttpClient(
                new SocketsHttpHandler { PooledConnectionLifetime = TimeSpan.FromMinutes(5) },
                disposeHandler: true
            )
            {
                BaseAddress = new Uri(normalized),
                // No client-wide deadline: the 100-second default covers a whole request including its body, and a
                // download batch of a large table can outlast it. The per-call CancellationToken is the timeout instead
                Timeout = Timeout.InfiniteTimeSpan,
            }
        ));

        return AddGeneratedHttpSyncSources(
            services,
            provider => provider.GetRequiredService<OwnedSyncHttpClient>().Client
        );
    }

    /// <summary>Registers the differential sources over HTTP using an HttpClient factory (authentication handlers and the like).</summary>
    /// <remarks>
    /// The factory runs every time a source is resolved, and the HttpClient it returns is disposed by neither the
    /// generated code nor the container. Return a shared instance or one managed by <c>IHttpClientFactory</c>; a new
    /// HttpClient per call exhausts sockets. Its BaseAddress must include the prefix and end with a trailing /.
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="httpClientFactory">A factory returning the HttpClient the sources talk through</param>
    public static IServiceCollection AddGeneratedHttpSyncSources(
        this IServiceCollection services,
        Func<IServiceProvider, HttpClient> httpClientFactory
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        ArgumentNullException.ThrowIfNull(httpClientFactory);
{{~ for sync in sync_tables ~}}

        AddHttpSource<{{ sync.entity_class_name }}, {{ sync.key_type_name }}>(
            services,
            httpClientFactory,
            GeneratedSyncTables.{{ sync.descriptor_property_name }}
        );
{{~ end ~}}

        return services;
    }

    /// <summary>Registers one table's differential source over HTTP.</summary>
    /// <remarks>
    /// One class serves both shapes of table here, because the wire format already distinguishes them: the versionless
    /// scan asks the page endpoint, which the server maps only for the tables that have one.
    /// </remarks>
    /// <typeparam name="TEntity">The entity type.</typeparam>
    /// <typeparam name="TKey">The primary key type.</typeparam>
    /// <param name="services">The service collection.</param>
    /// <param name="httpClientFactory">A factory returning the HttpClient the source talks through.</param>
    /// <param name="descriptor">The table's descriptor.</param>
    private static void AddHttpSource<TEntity, TKey>(
        IServiceCollection services,
        Func<IServiceProvider, HttpClient> httpClientFactory,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        where TEntity : EntityBaseCore, new() =>
        services.AddScoped<ISyncServerSource<TEntity, TKey>>(provider =>
            new HttpSyncServerSource<TEntity, TKey>(httpClientFactory(provider), descriptor)
        );
{{~ end ~}}

    /// <summary>Registers the local half: the journal, the journaling decorators, the table descriptors, and the engine.</summary>
    /// <remarks>
    /// <para>
    /// The differential sources are resolved rather than registered here, so exactly one of
    /// <c>AddGeneratedDirectSyncSources</c>{{ if remote_services }} / <c>AddGeneratedHttpSyncSources</c>{{ end }} has to be
    /// called as well. Leaving that out is not a silent failure: resolving the engine then fails on the missing source.
    /// </para>
    /// <para>
    /// <c>excludeFromSync</c> is the local-only declaration: an excluded table gets no journaling decorator (its
    /// writes are not recorded, and cost nothing extra) and no descriptor (no run downloads it, propagates deletes
    /// into it, or wipes it in a refresh). It is not a per-run scope - that is
    /// <see cref="SyncOptions.ExcludedEntityTypes"/> - and entries recorded before a table was excluded are never
    /// replayed; <see cref="SyncJournal.RemoveTableAsync"/> is how they are cleaned up. A type that is not a
    /// synchronised entity type, or an exclusion that leaves no table at all, is rejected here rather than
    /// discovered at the first run.
    /// </para>
    /// </remarks>
    /// <param name="services">The service collection.</param>
    /// <param name="localServiceKey">The key the local (SQLite) repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="excludeFromSync">Entity types this engine never synchronises (null or empty keeps every table).</param>
    public static IServiceCollection AddGeneratedSyncEngine(
        this IServiceCollection services,
        object? localServiceKey,
        IReadOnlyCollection<Type>? excludeFromSync = null
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        var excluded = ValidatedSyncExclusions(excludeFromSync);

        services.AddScoped(provider => new SyncJournal(
            Resolve<ISqlExecutor>(provider, localServiceKey)
        ));
{{~ for sync in sync_tables ~}}

        if (!excluded.Contains(typeof({{ sync.entity_class_name }})))
        {
            Decorate<{{ sync.interface_name }}>(
                services,
                localServiceKey,
                (inner, provider) => new {{ sync.decorator_class_name }}(
                    inner,
                    provider.GetRequiredService<SyncJournal>()
                )
            );
            AddSyncTable<{{ sync.entity_class_name }}, {{ sync.key_type_name }}, {{ sync.interface_name }}>(
                services,
                localServiceKey,
                GeneratedSyncTables.{{ sync.descriptor_property_name }}
            );
        }
{{~ end ~}}

        services.AddScoped(provider => new SyncEngine(
            provider.GetServices<ISyncTable>(),
            provider.GetRequiredService<SyncJournal>()
        ));

        return services;
    }

    /// <summary>Registers one table with the engine, over the local repository the journaling decorator now wraps.</summary>
    /// <remarks>
    /// The local repository stands in two places here as well: the engine writes rows through it, and - for a table with
    /// unbounded binary columns - the copy reaches those columns through the same instance.
    /// </remarks>
    /// <typeparam name="TEntity">The entity type.</typeparam>
    /// <typeparam name="TKey">The primary key type.</typeparam>
    /// <typeparam name="TRepository">The generated repository contract of the entity.</typeparam>
    /// <param name="services">The service collection.</param>
    /// <param name="localServiceKey">The key the local repositories were registered under (null for the non-keyed registration).</param>
    /// <param name="descriptor">The table's descriptor.</param>
    private static void AddSyncTable<TEntity, TKey, TRepository>(
        IServiceCollection services,
        object? localServiceKey,
        SyncTableDescriptor<TEntity, TKey> descriptor
    )
        where TEntity : EntityBaseCore, new()
        where TRepository : class, IRepository<TEntity, TKey> =>
        services.AddScoped<ISyncTable>(provider =>
        {
            var local = Resolve<TRepository>(provider, localServiceKey);
            var localSqlExecutor = Resolve<ISqlExecutor>(provider, localServiceKey);
            var server = provider.GetRequiredService<ISyncServerSource<TEntity, TKey>>();

            // The registry the generated repositories are given (keyed or not, they resolve the one non-keyed registry)
            var localSaveHooks = provider.GetService<ISaveHookRegistry>();

            if (descriptor.IsVersionless)
            {
                return new VersionlessSyncTable<TEntity, TKey>(
                    local,
                    localSqlExecutor,
                    server,
                    descriptor,
                    localSaveHooks
                );
            }

            return new SyncTable<TEntity, TKey>(
                local,
                localSqlExecutor,
                server,
                descriptor,
                localSaveHooks
            );
        });

    /// <summary>Validates the construction-time exclusions: every named type must be synchronised, and at least one table must remain.</summary>
    /// <remarks>
    /// A name outside the synchronised set is rejected rather than skipped - a silently ignored exclusion would read
    /// as if it had worked - and excluding everything is rejected because an engine with no table is a configuration
    /// error wearing a valid registration.
    /// </remarks>
    private static HashSet<Type> ValidatedSyncExclusions(
        IReadOnlyCollection<Type>? excludeFromSync
    )
    {
        Type[] synchronised =
        [
            .. GeneratedSyncTables.All.Select(descriptor => descriptor.EntityType),
        ];
        var excluded = new HashSet<Type>(excludeFromSync ?? []);
        var unknown = excluded.Where(type => !synchronised.Contains(type)).ToList();

        if (unknown.Count > 0)
        {
            throw new ArgumentException(
                "excludeFromSync names types that are not synchronised entity types: "
                    + string.Join(", ", unknown.Select(type => type.Name))
                    + ".",
                nameof(excludeFromSync)
            );
        }

        if (excluded.Count >= synchronised.Length)
        {
            throw new ArgumentException(
                "excludeFromSync excludes every synchronised table, which leaves the engine nothing to do. "
                    + "Generate without sync support instead of excluding everything.",
                nameof(excludeFromSync)
            );
        }

        return excluded;
    }

    /// <summary>Resolves a service that was registered either under a key or plainly (<c>null</c> means the plain one).</summary>
    private static TService Resolve<TService>(IServiceProvider provider, object? serviceKey)
        where TService : notnull =>
        serviceKey is null
            ? provider.GetRequiredService<TService>()
            : provider.GetRequiredKeyedService<TService>(serviceKey);

    /// <summary>
    /// Replaces an existing registration with one that wraps the original instance, keeping the original factory.
    /// </summary>
    /// <remarks>
    /// The registration this decorates is a factory registration, so the inner instance can be produced by calling that
    /// same factory - the decorated repository is built exactly the way its own registration builds it. A non-keyed
    /// registration is found by the same predicate as a keyed one, because a plain descriptor carries a null service key
    /// and a keyed one can never be made with a null key.
    /// </remarks>
    private static void Decorate<TService>(
        IServiceCollection services,
        object? serviceKey,
        Func<TService, IServiceProvider, TService> decorate
    )
        where TService : class
    {
        var descriptor =
            services.LastOrDefault(candidate =>
                candidate.ServiceType == typeof(TService)
                && Equals(candidate.ServiceKey, serviceKey)
            )
            ?? throw new InvalidOperationException(
                $"No registration of {typeof(TService).Name} was found for the service key "
                    + $"'{serviceKey}'. Register the local repositories before calling AddGeneratedSyncEngine."
            );

        if (serviceKey is null)
        {
            var plainFactory =
                descriptor.ImplementationFactory ?? throw NotAFactoryRegistration<TService>(null);

            services.Remove(descriptor);
            services.Add(
                new ServiceDescriptor(
                    typeof(TService),
                    provider => decorate((TService)plainFactory(provider), provider),
                    descriptor.Lifetime
                )
            );

            return;
        }

        var keyedFactory =
            descriptor.KeyedImplementationFactory
            ?? throw NotAFactoryRegistration<TService>(serviceKey);

        services.Remove(descriptor);
        services.Add(
            new ServiceDescriptor(
                typeof(TService),
                serviceKey,
                (provider, key) => decorate((TService)keyedFactory(provider, key), provider),
                descriptor.Lifetime
            )
        );
    }

    /// <summary>Builds the failure for a registration the decorator cannot rebuild (an instance or a type registration).</summary>
    private static InvalidOperationException NotAFactoryRegistration<TService>(object? serviceKey) =>
        new(
            $"The registration of {typeof(TService).Name} for the service key '{serviceKey}' is not a "
                + "factory registration, so the journaling decorator cannot build the instance it wraps."
        );
{{~ if remote_services ~}}

    /// <summary>Container-owned holder for the shared HttpClient created by the base-address overload.</summary>
    /// <remarks>
    /// Registering the holder as a singleton produced by a factory is what makes the DI container the owner: the
    /// container disposes the singletons it creates itself, so the wrapped HttpClient goes away with the
    /// <see cref="IServiceProvider"/>. It is a holder of its own rather than the one the remote repositories use,
    /// because the two registrations are independent - either can be present without the other, and a setup that wants
    /// one shared client for both passes the same factory to both factory overloads.
    /// </remarks>
    private sealed class OwnedSyncHttpClient(HttpClient client) : IDisposable
    {
        /// <summary>Gets the shared client handed to the generated sync sources.</summary>
        public HttpClient Client { get; } = client;

        /// <summary>Disposes the shared client (called by the DI container when the provider is disposed).</summary>
        public void Dispose() => Client.Dispose();
    }
{{~ end ~}}
}
{{~ end ~}}
{{~ if block_namespace ~}}
}
{{~ end ~}}

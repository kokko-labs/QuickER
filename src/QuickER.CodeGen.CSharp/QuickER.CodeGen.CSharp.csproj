<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 中立（既定）リソースのカルチャ＝英語。日本語は Strings.ja.resx サテライトで賦与する -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\CSharpRuntime\*.scriban" />
    <EmbeddedResource Include="Templates\ApiReferenceDoc.scriban" />
    <!--
      ファイル名の ".ja." 中置きを MSBuild がサテライト（カルチャ別）リソースとみなすのを抑止する。
      WithCulture=false で主アセンブリへ埋め込み、LogicalName で完全なリソース名（.ja を保持）を固定する。
    -->
    <EmbeddedResource Include="Templates\ApiReferenceDoc.ja.scriban">
      <WithCulture>false</WithCulture>
      <LogicalName>QuickER.CodeGen.CSharp.Templates.ApiReferenceDoc.ja.scriban</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    多言語リソース: Strings.resx（中立＝英語）と Strings.ja.resx（日本語サテライト）。
    厳密型アクセサ（Strings.Designer.cs）は VS 以外でも確実に通るよう手書きでチェックイン済み。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

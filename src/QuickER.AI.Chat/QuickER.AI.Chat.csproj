<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 中立（既定）リソースのカルチャ＝英語。日本語は Strings.ja.resx サテライトで賦与する -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.AI\QuickER.AI.csproj" />
    <ProjectReference Include="..\QuickER.AI.UI\QuickER.AI.UI.csproj" />
    <ProjectReference Include="..\QuickER.Extensibility\QuickER.Extensibility.csproj" />
    <ProjectReference Include="..\QuickER.Gui.Abstractions\QuickER.Gui.Abstractions.csproj" />
    <ProjectReference Include="..\QuickER.Gui.Common\QuickER.Gui.Common.csproj" />
    <ProjectReference Include="..\QuickER.Mcp\QuickER.Mcp.csproj" />
    <!-- 名前付きクエリツールの面非依存な実行コア（QueryToolCore）と構造化結果（QueryToolOutcome）を、
         チャット面のインターセプト（ErDiagramHostChatAdapter）と日本語フォーマッタで利用する。 -->
    <ProjectReference Include="..\QuickER.Mcp.Tools\QuickER.Mcp.Tools.csproj" />
  </ItemGroup>

  <!--
    多言語リソース: Strings.resx（中立＝英語）と Strings.ja.resx（日本語サテライト）。
    厳密型アクセサ（Strings.Designer.cs）は VS 以外でも確実に通るよう手書きでチェックイン済み。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

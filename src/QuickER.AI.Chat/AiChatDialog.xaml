<Window
  x:Class="QuickER.AI.Chat.AiChatDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chat="clr-namespace:QuickER.AI;assembly=QuickER.AI"
  xmlns:ui="clr-namespace:QuickER.AI.UI;assembly=QuickER.AI.UI"
  xmlns:common="clr-namespace:QuickER.Gui.Common;assembly=QuickER.Gui.Common"
  xmlns:res="clr-namespace:QuickER.AI.Chat.Resources"
  Title="{x:Static res:Strings.Chat_WindowTitle}"
  Width="860"
  Height="720"
  MinWidth="640"
  MinHeight="520"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色・ボタン・入力欄等の共通スタイルは共有テーマ辞書から取り込む -->
        <ResourceDictionary Source="pack://application:,,,/QuickER.Gui.Common;component/Themes/DialogTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Codex プロバイダー表示名コンバータ（AI 固有） -->
      <ui:CodexProviderDisplayNameConverter x:Key="CodexProviderDisplayNameConverter" />

      <!-- API キー接続プロバイダー表示名コンバータ（enum 名 LocalLlm を "Local LLM" と見せる） -->
      <ui:AiProviderDisplayNameConverter x:Key="AiProviderDisplayNameConverter" />

      <!-- ── 入力欄（角丸・フォーカスでアクセント。チャット用でこのダイアログ固有） ── -->
      <Style x:Key="ChatInputBox" TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,9"
              >
                <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── セグメント風タブ ── -->
      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border
                x:Name="Bd"
                Background="Transparent"
                CornerRadius="8"
                Padding="16,8"
                Margin="0,0,6,0"
              >
                <ContentPresenter
                  ContentSource="Header"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#E8F0FE" />
                  <Setter Property="Foreground" Value="{StaticResource Accent}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SettingsTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabPanel
                  Grid.Row="0"
                  IsItemsHost="True"
                  Margin="0,0,0,8"
                  HorizontalAlignment="Left"
                />
                <Border
                  Grid.Row="1"
                  Background="{StaticResource CardBg}"
                  BorderBrush="{StaticResource Divider}"
                  BorderThickness="1"
                  CornerRadius="10"
                >
                  <ContentPresenter ContentSource="SelectedContent" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── チャット吹き出しテンプレート ── -->
      <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="80,5,2,5"
          Padding="13,9"
          Background="{StaticResource Accent}"
          CornerRadius="16,16,4,16"
          HorizontalAlignment="Right"
          MaxWidth="600"
        >
          <StackPanel>
            <TextBox
              Text="{Binding Content, Mode=OneWay}"
              TextWrapping="Wrap"
              IsReadOnly="True"
              BorderThickness="0"
              Background="Transparent"
              Foreground="White"
              FontSize="13"
            />
            <!-- 添付要約（📎 name。添付ありのメッセージのみ表示） -->
            <TextBlock
              Margin="0,6,0,0"
              Text="{Binding AttachmentSummary}"
              TextWrapping="Wrap"
              Foreground="#DCE9FF"
              FontSize="12"
              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"
            />
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="2,5,80,5"
          Padding="13,9"
          Background="{StaticResource CardBg}"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="1"
          CornerRadius="16,16,16,4"
          HorizontalAlignment="Left"
          MaxWidth="600"
        >
          <TextBox
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="#1F2937"
            FontSize="13"
          />
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="SystemMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="40,6"
          Padding="12,5"
          Background="#EEF2F7"
          CornerRadius="12"
          HorizontalAlignment="Center"
          MaxWidth="640"
        >
          <TextBox
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="{StaticResource MutedText}"
            FontSize="12"
            TextAlignment="Center"
          />
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="ToolCallMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="2,5,80,5"
          CornerRadius="10"
          Background="#F8FAFC"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="1"
          HorizontalAlignment="Left"
          MaxWidth="600"
        >
          <Expander
            IsExpanded="{Binding IsExpanded}"
            Padding="10,4"
            Foreground="{StaticResource MutedText}"
          >
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛠" FontSize="13" Margin="0,0,6,0" />
                <TextBlock
                  Text="{x:Static res:Strings.Chat_ToolCallHeader}"
                  FontSize="12"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center"
                />
              </StackPanel>
            </Expander.Header>
            <TextBox
              Margin="2,4,2,8"
              Text="{Binding Content, Mode=OneWay}"
              TextWrapping="Wrap"
              IsReadOnly="True"
              BorderThickness="0"
              Background="Transparent"
              Foreground="#475569"
              FontSize="12"
              FontFamily="Consolas, Courier New"
            />
          </Expander>
        </Border>
      </DataTemplate>

      <ui:ChatMessageTemplateSelector
        x:Key="ChatMessageTemplateSelector"
        UserTemplate="{StaticResource UserMessageTemplate}"
        AssistantTemplate="{StaticResource AssistantMessageTemplate}"
        SystemTemplate="{StaticResource SystemMessageTemplate}"
        ToolCallTemplate="{StaticResource ToolCallMessageTemplate}"
      />
    </ResourceDictionary>
  </Window.Resources>

  <!--
    D&D はトンネル段（Preview*）で受ける: メッセージバブルはコピー可能にするため TextBox で実装しており、
    TextBox の組み込みドラッグ処理がバブリング段の DragOver/Drop を飲み込むため、
    バブルの上へのファイルドロップがバブリングでは親 Grid に届かない
  -->
  <Grid
    Margin="16"
    AllowDrop="True"
    PreviewDragOver="ChatArea_PreviewDragOver"
    PreviewDrop="ChatArea_PreviewDrop"
  >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── 上部: 接続方式タブ + 設定カード ── -->
    <TabControl
      x:Name="BackendTabs"
      Grid.Row="0"
      Style="{StaticResource SettingsTabs}"
      SelectionChanged="BackendTabs_SelectionChanged"
    >
      <TabItem Header="{x:Static res:Strings.Chat_TabApiKey}">
        <StackPanel Margin="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_Provider}"
            />
            <ComboBox
              Grid.Column="1"
              Margin="0,0,16,0"
              Padding="6,4"
              ItemsSource="{Binding Connection.ApiProviders}"
              SelectedItem="{Binding Connection.ApiProvider}"
              ToolTip="{x:Static res:Strings.Chat_ProviderTooltip}"
            >
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource AiProviderDisplayNameConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
              Grid.Column="2"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_ModelName}"
            />
            <ComboBox
              x:Name="ApiModelBox"
              Grid.Column="3"
              Padding="6,4"
              IsEditable="True"
              TextSearch.TextPath="Name"
              Text="{Binding Connection.ApiModel, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Connection.ApiModelCandidates}"
            >
              <!-- ドロップダウン項目を横いっぱいに広げ、× ボタンを右端へ寄せる -->
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <!-- 右端の × は履歴由来（IsRemovable=true）の候補だけ表示し、履歴から個別削除する -->
                    <Button
                      DockPanel.Dock="Right"
                      Content="✕"
                      Padding="6,0"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      Foreground="{StaticResource MutedText}"
                      ToolTip="{x:Static res:Strings.Chat_RemoveModelFromHistory}"
                      Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}"
                      Command="{Binding DataContext.Connection.RemoveApiModelHistoryCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                      CommandParameter="{Binding Name}"
                    />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  </DockPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid
            Margin="0,12,0,0"
            Visibility="{Binding Connection.ShowApiKey, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_ApiKey}"
            />
            <PasswordBox
              x:Name="ApiKeyBox"
              Grid.Column="1"
              Padding="4,5"
              Margin="0,0,8,0"
              ToolTip="{x:Static res:Strings.Chat_ApiKeyTooltip}"
              common:PasswordBoxBehavior.BoundPassword="{Binding Connection.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
            <CheckBox
              Grid.Column="2"
              VerticalAlignment="Center"
              Content="{x:Static res:Strings.Chat_Save}"
              IsChecked="{Binding Connection.SaveApiKey}"
            />
          </Grid>

          <!-- ローカル LLM はキーが任意なので、その旨を欄の直下に注記する -->
          <TextBlock
            Margin="0,4,0,0"
            TextWrapping="Wrap"
            Foreground="{StaticResource MutedText}"
            Text="{x:Static res:Strings.Chat_ApiKeyOptionalNote}"
            Visibility="{Binding Connection.IsLocalLlmProvider, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <Grid
            Margin="0,12,0,0"
            Visibility="{Binding Connection.ShowEndpoint, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_Endpoint}"
            />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              Text="{Binding Connection.EndpointOverride, UpdateSourceTrigger=PropertyChanged}"
              ToolTip="{x:Static res:Strings.Chat_EndpointTooltip}"
            />
          </Grid>
        </StackPanel>
      </TabItem>

      <TabItem Header="{x:Static res:Strings.Chat_TabCodex}">
        <StackPanel Margin="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_Provider}"
            />
            <!-- プロバイダーはリスト選択のみ（自由入力不可）。内部値 "openai" は表示のみ "OpenAI" にする -->
            <ComboBox
              x:Name="CodexProviderBox"
              Grid.Column="1"
              Margin="0,0,16,0"
              Padding="6,4"
              SelectedItem="{Binding Connection.CodexModelProvider}"
              ItemsSource="{Binding Connection.CodexModelProviderCandidates}"
            >
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource CodexProviderDisplayNameConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
              Grid.Column="2"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_ModelName}"
            />
            <ComboBox
              x:Name="CodexModelBox"
              Grid.Column="3"
              Padding="6,4"
              IsEditable="True"
              TextSearch.TextPath="Name"
              Text="{Binding Connection.CodexModel, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Connection.CodexModelCandidates}"
            >
              <!-- ドロップダウン項目を横いっぱいに広げ、× ボタンを右端へ寄せる -->
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <!-- 右端の × は履歴由来（IsRemovable=true）の候補だけ表示し、履歴から個別削除する -->
                    <Button
                      DockPanel.Dock="Right"
                      Content="✕"
                      Padding="6,0"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      Foreground="{StaticResource MutedText}"
                      ToolTip="{x:Static res:Strings.Chat_RemoveModelFromHistory}"
                      Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}"
                      Command="{Binding DataContext.Connection.RemoveCodexModelHistoryCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                      CommandParameter="{Binding Name}"
                    />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  </DockPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <ui:ConnectionStatusPanel
            Margin="0,12,0,0"
            StatusLevel="{Binding CodexStatusLevel}"
            SummaryText="{Binding CodexAccountSummary}"
            RefreshCommand="{Binding CodexRefreshCommand}"
          >
            <ui:ConnectionStatusPanel.Body>
              <StackPanel>
                <!-- 状態依存の案内（CLI 未検出時のインストール案内・接続失敗理由）。空なら行ごと隠す -->
                <TextBlock
                  Margin="0,10,0,0"
                  Foreground="{StaticResource MutedText}"
                  TextWrapping="Wrap"
                  Text="{Binding CodexGuidance}"
                  Visibility="{Binding ShowCodexGuidance, Converter={StaticResource BoolToVisibilityConverter}}"
                />
                <!-- 未ログイン: 案内 + ChatGPT ログイン -->
                <StackPanel
                  Margin="0,10,0,0"
                  Visibility="{Binding ShowCodexLoginPanel, Converter={StaticResource BoolToVisibilityConverter}}"
                >
                  <TextBlock
                    Foreground="{StaticResource MutedText}"
                    TextWrapping="Wrap"
                    Text="{x:Static res:Strings.Chat_CodexLoginGuidance}"
                  />
                  <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButton}"
                    Content="{x:Static res:Strings.Chat_CodexLoginButton}"
                    Command="{Binding CodexStartChatGptLoginCommand}"
                  />
                </StackPanel>
                <!-- ログイン済み: ログアウト -->
                <Button
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Style="{StaticResource SecondaryButton}"
                  Content="{x:Static res:Strings.Chat_Logout}"
                  Command="{Binding CodexLogoutCommand}"
                  Visibility="{Binding ShowCodexLogout, Converter={StaticResource BoolToVisibilityConverter}}"
                />
              </StackPanel>
            </ui:ConnectionStatusPanel.Body>
          </ui:ConnectionStatusPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="{x:Static res:Strings.Chat_TabClaude}">
        <StackPanel Margin="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Chat_Model}"
            />
            <ComboBox
              Grid.Column="1"
              Padding="6,4"
              IsEditable="True"
              Text="{Binding Connection.ClaudeCodeModel, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Connection.ClaudeCodeModelCandidates}"
            />
          </Grid>

          <ui:ConnectionStatusPanel
            Margin="0,12,0,0"
            StatusLevel="{Binding Connection.ClaudeCodeStatusLevel}"
            SummaryText="{Binding Connection.ClaudeCodeStatusSummary}"
            RefreshCommand="{Binding ClaudeCodeRefreshCommand}"
          >
            <ui:ConnectionStatusPanel.Body>
              <TextBlock
                Margin="0,10,0,0"
                Foreground="{StaticResource MutedText}"
                TextWrapping="Wrap"
                Text="{Binding Connection.ClaudeCodeGuidance}"
              />
            </ui:ConnectionStatusPanel.Body>
          </ui:ConnectionStatusPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- ── 中部: チャットカード ── -->
    <Border
      Grid.Row="1"
      Margin="0,12,0,0"
      Background="{StaticResource CardBg}"
      BorderBrush="{StaticResource Divider}"
      BorderThickness="1"
      CornerRadius="10"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーバー -->
        <Border
          Grid.Row="0"
          Background="#FBFCFE"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="0,0,0,1"
          CornerRadius="10,10,0,0"
        >
          <Grid Margin="14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{StaticResource HeaderText}"
              Text="{x:Static res:Strings.Chat_ChatHeader}"
            />
            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
            >
              <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource Accent}" />
              <TextBlock
                Text="{x:Static res:Strings.Chat_Responding}"
                Foreground="{StaticResource Accent}"
                FontSize="12"
                VerticalAlignment="Center"
              />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,0"
                Content="{x:Static res:Strings.Chat_Interrupt}"
                Command="{Binding InterruptCommand}"
                Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Button
                Style="{StaticResource SecondaryButton}"
                Content="{x:Static res:Strings.Chat_NewConversation}"
                Command="{Binding StartConversationCommand}"
              />
            </StackPanel>
          </Grid>
        </Border>

        <!-- メッセージ一覧 -->
        <ScrollViewer
          x:Name="ChatScrollViewer"
          Grid.Row="1"
          Padding="8,6"
          VerticalScrollBarVisibility="Auto"
        >
          <ItemsControl
            ItemsSource="{Binding Messages}"
            ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
            HorizontalContentAlignment="Stretch"
          >
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ── 下部: 入力エリア ── -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 添付チップ列＋クリップボタン（入力欄の上） -->
      <ui:AttachmentPanel
        x:Name="Attachments"
        Grid.Row="0"
        Margin="0,0,0,6"
        AttachmentList="{Binding Attachments}"
        AttachRequested="Attachments_AttachRequested"
      />

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          x:Name="UserInputBox"
          Grid.Column="0"
          Style="{StaticResource ChatInputBox}"
          Margin="0,0,8,0"
          MinHeight="52"
          MaxHeight="140"
          TextWrapping="Wrap"
          AcceptsReturn="True"
          Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
          ToolTip="{x:Static res:Strings.Chat_InputTooltip}"
          PreviewKeyDown="UserInputBox_PreviewKeyDown"
        >
          <TextBox.InputBindings>
            <KeyBinding Modifiers="Control" Key="Return" Command="{Binding SendMessageCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button
          Grid.Column="1"
          Style="{StaticResource PrimaryButton}"
          Width="96"
          VerticalAlignment="Stretch"
          Content="{x:Static res:Strings.Chat_Send}"
          Command="{Binding SendMessageCommand}"
        />
      </Grid>

      <TextBlock
        Grid.Row="2"
        Margin="4,6,0,0"
        Foreground="{StaticResource MutedText}"
        FontSize="12"
        TextWrapping="Wrap"
        Text="{Binding StatusMessage}"
      />
    </Grid>
  </Grid>
</Window>

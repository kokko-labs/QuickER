<Window
  x:Class="QuickER.AI.Chat.AiChatDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chat="clr-namespace:QuickER.AI;assembly=QuickER.AI"
  xmlns:ui="clr-namespace:QuickER.AI.UI;assembly=QuickER.AI.UI"
  Title="AI チャット"
  Width="860"
  Height="720"
  MinWidth="640"
  MinHeight="520"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
>
  <Window.Resources>
    <ui:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- ── 配色 ── -->
    <SolidColorBrush x:Key="Accent" Color="#1A73E8" />
    <SolidColorBrush x:Key="AccentHover" Color="#1769D6" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#E5E7EB" />
    <SolidColorBrush x:Key="HeaderText" Color="#374151" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="FieldBorder" Color="#D1D5DB" />

    <!-- ── 主要ボタン（アクセント） ── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{StaticResource AccentHover}"
                />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 副ボタン（白・枠線） ── -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{StaticResource FieldBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 入力欄（角丸・フォーカスでアクセント） ── -->
    <Style x:Key="ChatInputBox" TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="12,9"
            >
              <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── セグメント風タブ ── -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="8"
              Padding="16,8"
              Margin="0,0,6,0"
            >
              <ContentPresenter
                ContentSource="Header"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="False" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsTabs" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TabPanel
                Grid.Row="0"
                IsItemsHost="True"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
              />
              <Border
                Grid.Row="1"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="1"
                CornerRadius="10"
              >
                <ContentPresenter ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ── チャット吹き出しテンプレート ── -->
    <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="80,5,2,5"
        Padding="13,9"
        Background="{StaticResource Accent}"
        CornerRadius="16,16,4,16"
        HorizontalAlignment="Right"
        MaxWidth="600"
      >
        <StackPanel>
          <TextBox
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            FontSize="13"
          />
          <!-- 添付要約（📎 name。添付ありのメッセージのみ表示） -->
          <TextBlock
            Margin="0,6,0,0"
            Text="{Binding AttachmentSummary}"
            TextWrapping="Wrap"
            Foreground="#DCE9FF"
            FontSize="12"
            Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"
          />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="2,5,80,5"
        Padding="13,9"
        Background="{StaticResource CardBg}"
        BorderBrush="{StaticResource Divider}"
        BorderThickness="1"
        CornerRadius="16,16,16,4"
        HorizontalAlignment="Left"
        MaxWidth="600"
      >
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="#1F2937"
          FontSize="13"
        />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SystemMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="40,6"
        Padding="12,5"
        Background="#EEF2F7"
        CornerRadius="12"
        HorizontalAlignment="Center"
        MaxWidth="640"
      >
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="{StaticResource MutedText}"
          FontSize="12"
          TextAlignment="Center"
        />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ToolCallMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="2,5,80,5"
        CornerRadius="10"
        Background="#F8FAFC"
        BorderBrush="{StaticResource Divider}"
        BorderThickness="1"
        HorizontalAlignment="Left"
        MaxWidth="600"
      >
        <Expander
          IsExpanded="{Binding IsExpanded}"
          Padding="10,4"
          Foreground="{StaticResource MutedText}"
        >
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🛠" FontSize="13" Margin="0,0,6,0" />
              <TextBlock
                Text="作業ログ"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Expander.Header>
          <TextBox
            Margin="2,4,2,8"
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="#475569"
            FontSize="12"
            FontFamily="Consolas, Courier New"
          />
        </Expander>
      </Border>
    </DataTemplate>

    <ui:ChatMessageTemplateSelector
      x:Key="ChatMessageTemplateSelector"
      UserTemplate="{StaticResource UserMessageTemplate}"
      AssistantTemplate="{StaticResource AssistantMessageTemplate}"
      SystemTemplate="{StaticResource SystemMessageTemplate}"
      ToolCallTemplate="{StaticResource ToolCallMessageTemplate}"
    />
  </Window.Resources>

  <!--
    D&D はトンネル段（Preview*）で受ける: メッセージバブルはコピー可能にするため TextBox で実装しており、
    TextBox の組み込みドラッグ処理がバブリング段の DragOver/Drop を飲み込むため、
    バブルの上へのファイルドロップがバブリングでは親 Grid に届かない
  -->
  <Grid
    Margin="16"
    AllowDrop="True"
    PreviewDragOver="ChatArea_PreviewDragOver"
    PreviewDrop="ChatArea_PreviewDrop"
  >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── 上部: 接続方式タブ + 設定カード ── -->
    <TabControl
      x:Name="BackendTabs"
      Grid.Row="0"
      Style="{StaticResource SettingsTabs}"
      SelectionChanged="BackendTabs_SelectionChanged"
    >
      <TabItem Header="API キー接続">
        <StackPanel Margin="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="モデルプロバイダー"
            />
            <ComboBox
              Grid.Column="1"
              Margin="0,0,16,0"
              Padding="6,4"
              ItemsSource="{Binding ApiProviders}"
              SelectedItem="{Binding ApiProvider}"
            />
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="モデル名" />
            <ComboBox
              Grid.Column="3"
              Padding="6,4"
              IsEditable="True"
              Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding ApiModelCandidates}"
            />
          </Grid>

          <Grid
            Margin="0,12,0,0"
            Visibility="{Binding ShowApiKey, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="API キー" />
            <PasswordBox
              x:Name="ApiKeyBox"
              Grid.Column="1"
              Padding="4,5"
              Margin="0,0,8,0"
              ToolTip="API キー（OpenAI: sk-... / Claude: sk-ant-...）"
              ui:PasswordBoxBehavior.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
            <CheckBox
              Grid.Column="2"
              VerticalAlignment="Center"
              Content="保存"
              IsChecked="{Binding SaveApiKey}"
            />
          </Grid>

          <Grid
            Margin="0,12,0,0"
            Visibility="{Binding ShowEndpoint, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="エンドポイント" />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              Text="{Binding EndpointOverride, UpdateSourceTrigger=PropertyChanged}"
              ToolTip="OpenAI 互換エンドポイント（Ollama 等）"
            />
          </Grid>
        </StackPanel>
      </TabItem>

      <TabItem Header="Codex 接続">
        <StackPanel Margin="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="モデルプロバイダー"
            />
            <ComboBox
              Grid.Column="1"
              Margin="0,0,16,0"
              Padding="6,4"
              IsEditable="True"
              Text="{Binding CodexModelProvider, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding CodexModelProviderCandidates}"
            />
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="モデル名" />
            <ComboBox
              Grid.Column="3"
              Padding="6,4"
              IsEditable="True"
              Text="{Binding CodexModel, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding CodexModelCandidates}"
            />
          </Grid>

          <ui:ConnectionStatusPanel
            Margin="0,12,0,0"
            StatusLevel="{Binding CodexStatusLevel}"
            SummaryText="{Binding CodexAccountSummary}"
            RefreshCommand="{Binding CodexRefreshCommand}"
          >
            <ui:ConnectionStatusPanel.Body>
              <StackPanel>
                <!-- 未ログイン: 案内 + ChatGPT ログイン -->
                <StackPanel
                  Margin="0,10,0,0"
                  Visibility="{Binding ShowCodexLoginPanel, Converter={StaticResource BoolToVisibilityConverter}}"
                >
                  <TextBlock
                    Foreground="{StaticResource MutedText}"
                    TextWrapping="Wrap"
                    Text="ChatGPT アカウントでログインしてください。API キーで利用する場合は「API キー接続」タブを使用します。"
                  />
                  <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButton}"
                    Content="ChatGPT ブラウザでログイン"
                    Command="{Binding CodexStartChatGptLoginCommand}"
                  />
                </StackPanel>
                <!-- ログイン済み: ログアウト -->
                <Button
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Style="{StaticResource SecondaryButton}"
                  Content="ログアウト"
                  Command="{Binding CodexLogoutCommand}"
                  Visibility="{Binding ShowCodexLogout, Converter={StaticResource BoolToVisibilityConverter}}"
                />
              </StackPanel>
            </ui:ConnectionStatusPanel.Body>
          </ui:ConnectionStatusPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="Claude 接続">
        <StackPanel Margin="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="モデル" />
            <ComboBox
              Grid.Column="1"
              Padding="6,4"
              IsEditable="True"
              Text="{Binding ClaudeCodeModel, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding ClaudeCodeModelCandidates}"
            />
          </Grid>

          <ui:ConnectionStatusPanel
            Margin="0,12,0,0"
            StatusLevel="{Binding ClaudeCodeStatusLevel}"
            SummaryText="{Binding ClaudeCodeStatusSummary}"
            RefreshCommand="{Binding ClaudeCodeRefreshCommand}"
          >
            <ui:ConnectionStatusPanel.Body>
              <TextBlock
                Margin="0,10,0,0"
                Foreground="{StaticResource MutedText}"
                TextWrapping="Wrap"
                Text="{Binding ClaudeCodeGuidance}"
              />
            </ui:ConnectionStatusPanel.Body>
          </ui:ConnectionStatusPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- ── 中部: チャットカード ── -->
    <Border
      Grid.Row="1"
      Margin="0,12,0,0"
      Background="{StaticResource CardBg}"
      BorderBrush="{StaticResource Divider}"
      BorderThickness="1"
      CornerRadius="10"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーバー -->
        <Border
          Grid.Row="0"
          Background="#FBFCFE"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="0,0,0,1"
          CornerRadius="10,10,0,0"
        >
          <Grid Margin="14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{StaticResource HeaderText}"
              Text="チャット"
            />
            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
            >
              <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource Accent}" />
              <TextBlock
                Text="応答中..."
                Foreground="{StaticResource Accent}"
                FontSize="12"
                VerticalAlignment="Center"
              />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,0"
                Content="中断"
                Command="{Binding InterruptCommand}"
                Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Button
                Style="{StaticResource SecondaryButton}"
                Content="＋ 新しい会話"
                Command="{Binding StartConversationCommand}"
              />
            </StackPanel>
          </Grid>
        </Border>

        <!-- メッセージ一覧 -->
        <ScrollViewer
          x:Name="ChatScrollViewer"
          Grid.Row="1"
          Padding="8,6"
          VerticalScrollBarVisibility="Auto"
        >
          <ItemsControl
            ItemsSource="{Binding Messages}"
            ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
            HorizontalContentAlignment="Stretch"
          >
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ── 下部: 入力エリア ── -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 添付チップ列＋クリップボタン（入力欄の上） -->
      <ui:AttachmentPanel
        x:Name="Attachments"
        Grid.Row="0"
        Margin="0,0,0,6"
        AttachmentList="{Binding Attachments}"
        AttachRequested="Attachments_AttachRequested"
      />

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          x:Name="UserInputBox"
          Grid.Column="0"
          Style="{StaticResource ChatInputBox}"
          Margin="0,0,8,0"
          MinHeight="52"
          MaxHeight="140"
          TextWrapping="Wrap"
          AcceptsReturn="True"
          Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
          ToolTip="Ctrl+Enter で送信 / Ctrl+V で画像を添付"
          PreviewKeyDown="UserInputBox_PreviewKeyDown"
        >
          <TextBox.InputBindings>
            <KeyBinding Modifiers="Control" Key="Return" Command="{Binding SendMessageCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button
          Grid.Column="1"
          Style="{StaticResource PrimaryButton}"
          Width="96"
          VerticalAlignment="Stretch"
          Content="送信"
          Command="{Binding SendMessageCommand}"
        />
      </Grid>

      <TextBlock
        Grid.Row="2"
        Margin="4,6,0,0"
        Foreground="{StaticResource MutedText}"
        FontSize="12"
        TextWrapping="Wrap"
        Text="{Binding StatusMessage}"
      />
    </Grid>
  </Grid>
</Window>

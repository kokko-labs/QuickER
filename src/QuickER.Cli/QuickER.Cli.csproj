<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuickER.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quicker</ToolCommandName>
    <!--
      Directory.Build.props の RuntimeIdentifiers=win-x64（release の GUI publish 用に
      ロックファイルへ RID グラフを含めるための宣言）をこのプロジェクトだけ打ち消す。
      .NET 10 では RuntimeIdentifiers 付きの tool プロジェクトの pack が RID 別パッケージ
      （QuickER.Cli.win-x64）を追加生成するが、配布は 8 パッケージ構成（ポータブルな tool 1 本）が正。
      Cli は RID 付きで publish されないため RID グラフも不要。
    -->
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <!-- 中立（既定）リソースのカルチャ＝英語。日本語は Strings.ja.resx サテライト。表示言語は OS カルチャに従う -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <PackageId>QuickER.Cli</PackageId>
    <Description>The QuickER CLI as a dotnet tool: C# code generation from an ER diagram JSON (generate), database-direct diagram scaffolding (scaffold), C# reverse import (reverse), and a stdio MCP server for AI agents (mcp). QuickER is an ER diagram designer that turns a single reviewed model into DDL, C# data access, and documentation.</Description>
    <PackageTags>quicker;er-diagram;entity-relationship;code-generation;scaffolding;ddl;database;sql-server;postgresql;mysql;oracle;sqlite;mcp;dotnet-tool;entity-framework-core;efcore</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <!-- PolyForm Noncommercial は OSI/FSF 承認外のため license expression が使えず、ライセンスファイル同梱方式にする -->
    <PackageLicenseFile>LICENSE-NC.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>quicker-icon-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE-NC.md" Pack="true" PackagePath="LICENSE-NC.md" Visible="false" />
    <!-- サードパーティ帰属。ツールパッケージは依存 DLL（Oracle 等）を同梱するため、Oracle 条項（ライセンス全文の同梱が配布条件）に対応して必ずパックする -->
    <None
      Include="..\..\THIRD-PARTY-NOTICES.md"
      Pack="true"
      PackagePath="THIRD-PARTY-NOTICES.md"
      Visible="false"
    />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None
      Include="../../assets/quicker-icon-128.png"
      Pack="true"
      PackagePath="quicker-icon-128.png"
      Visible="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!--
    多言語リソース: Strings.resx（中立＝英語）と Strings.ja.resx（日本語サテライト）。
    厳密型アクセサ（Strings.Designer.cs）は VS 以外でも確実に通るよう手書きでチェックイン済み。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- ツールパッケージへ .pdb を同梱しない（配布サイズ削減。参照プロジェクト分を含む全 .pdb を publish 収集から除外する） -->
  <Target Name="ExcludePdbsFromToolPackage" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'"
      />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Document\QuickER.Document.csproj" />
    <ProjectReference Include="..\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\QuickER.CodeReverse.CSharp\QuickER.CodeReverse.CSharp.csproj" />
    <ProjectReference Include="..\QuickER.Mcp\QuickER.Mcp.csproj" />
    <ProjectReference Include="..\QuickER.Mcp.Tools\QuickER.Mcp.Tools.csproj" />
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.MySql\QuickER.MySql.csproj" />
    <ProjectReference Include="..\QuickER.Oracle\QuickER.Oracle.csproj" />
    <ProjectReference Include="..\QuickER.PostgreSql\QuickER.PostgreSql.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\QuickER.Sqlite\QuickER.Sqlite.csproj" />
    <ProjectReference Include="..\QuickER.SqlServer\QuickER.SqlServer.csproj" />
  </ItemGroup>
</Project>

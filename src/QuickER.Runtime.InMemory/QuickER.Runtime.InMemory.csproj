<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime.InMemory</PackageId>
    <Description>Runtime for C# code generated by QuickER (an ER diagram designer): the DB-independent in-memory engine for the QuickER Repository, implementing the dialect-neutral contracts of QuickER.Runtime for unit testing without a database.</Description>
    <PackageTags>quicker;runtime;repository;data-access;in-memory;testing;code-generation</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>quicker-icon-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../assets/quicker-icon-128.png" Pack="true" PackagePath="quicker-icon-128.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- インメモリエンジンは DB へ触らないため ADO への依存を持たない（BCL のみ）。
         DI 登録拡張（AddGeneratedInMemoryRepositories）はスキーマ依存物として生成側に出力されるため、
         本パッケージは Microsoft.Extensions.DependencyInjection 系にも依存しない（依存排他ガードテストで検証） -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Runtime\QuickER.Runtime.csproj" />
  </ItemGroup>
</Project>

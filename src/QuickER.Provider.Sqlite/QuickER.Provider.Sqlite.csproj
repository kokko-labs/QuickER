<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Microsoft.Data.Sqlite が推移的に持ち込む SQLitePCLRaw（2.1 系）でなく、3.0 系の版（Directory.Packages.props）を
         明示参照して SQLite の版をそろえる（理由は Directory.Packages.props のコメントを参照） -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
  </ItemGroup>
</Project>

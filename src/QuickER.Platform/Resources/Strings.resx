  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <data name="PathSegment_Empty" xml:space="preserve">
    <value>an empty name or an empty path segment</value>
  </data>
  <data name="PathSegment_DotSegment" xml:space="preserve">
    <value>'.' or '..'</value>
  </data>
  <data name="PathSegment_Separator" xml:space="preserve">
    <value>a path separator ('/' or '')</value>
  </data>
  <data name="PathSegment_Rooted" xml:space="preserve">
    <value>an absolute path or a drive letter</value>
  </data>
  <data name="PathSegment_InvalidCharacter" xml:space="preserve">
    <value>a character not allowed in file names (control characters and " * : &lt; &gt; ? |)</value>
  </data>
  <data name="PathSegment_LeadingWhitespace" xml:space="preserve">
    <value>leading whitespace</value>
  </data>
  <data name="PathSegment_TrailingDotOrWhitespace" xml:space="preserve">
    <value>a trailing '.' or whitespace</value>
  </data>
  <data name="PathSegment_Tilde" xml:space="preserve">
    <value>'~' (it can form a short 8.3 name)</value>
  </data>
  <data name="PathSegment_ReservedDeviceName" xml:space="preserve">
    <value>a reserved device name (CON, PRN, AUX, NUL, CONIN$, CONOUT$, COM1 to COM9, LPT1 to LPT9, and COM or LPT followed by a superscript 1 to 3)</value>
  </data>
  <data name="PathSegment_TooLong" xml:space="preserve">
    <value>a name longer than 255 characters</value>
  </data>
</root>
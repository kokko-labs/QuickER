<Window
  x:Class="QuickER.AI.Mock.MockGenerationDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chat="clr-namespace:QuickER.AI;assembly=QuickER.AI"
  xmlns:ui="clr-namespace:QuickER.AI.UI;assembly=QuickER.AI.UI"
  xmlns:common="clr-namespace:QuickER.Gui.Common;assembly=QuickER.Gui.Common"
  xmlns:local="clr-namespace:QuickER.AI.Mock"
  xmlns:res="clr-namespace:QuickER.AI.Mock.Resources"
  Title="{x:Static res:Strings.Mock_WindowTitle}"
  Width="1160"
  Height="760"
  MinWidth="900"
  MinHeight="560"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色・ボタン・入力欄等の共通スタイルは共有テーマ辞書から取り込む -->
        <ResourceDictionary Source="pack://application:,,,/QuickER.Gui.Common;component/Themes/DialogTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Codex プロバイダー表示名コンバータ（AI 固有） -->
      <ui:CodexProviderDisplayNameConverter x:Key="CodexProviderDisplayNameConverter" />

      <!-- API キー接続プロバイダー表示名コンバータ（enum 名 LocalLlm を "Local LLM" と見せる） -->
      <ui:AiProviderDisplayNameConverter x:Key="AiProviderDisplayNameConverter" />

      <!-- ── 入力欄（チャット用でこのダイアログ固有） ── -->
      <Style x:Key="ChatInputBox" TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,9"
              >
                <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border
                x:Name="Bd"
                Background="Transparent"
                CornerRadius="8"
                Padding="14,7"
                Margin="0,0,6,0"
              >
                <ContentPresenter
                  ContentSource="Header"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#E8F0FE" />
                  <Setter Property="Foreground" Value="{StaticResource Accent}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SettingsTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabPanel
                  Grid.Row="0"
                  IsItemsHost="True"
                  Margin="0,0,0,8"
                  HorizontalAlignment="Left"
                />
                <Border
                  Grid.Row="1"
                  Background="{StaticResource CardBg}"
                  BorderBrush="{StaticResource Divider}"
                  BorderThickness="1"
                  CornerRadius="10"
                >
                  <ContentPresenter ContentSource="SelectedContent" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── チャット吹き出しテンプレート ── -->
      <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="50,5,2,5"
          Padding="13,9"
          Background="{StaticResource Accent}"
          CornerRadius="16,16,4,16"
          HorizontalAlignment="Right"
          MaxWidth="440"
        >
          <StackPanel>
            <TextBox
              Text="{Binding Content, Mode=OneWay}"
              TextWrapping="Wrap"
              IsReadOnly="True"
              BorderThickness="0"
              Background="Transparent"
              Foreground="White"
              FontSize="13"
            />
            <!-- 添付要約（📎 name。添付ありのメッセージのみ表示） -->
            <TextBlock
              Margin="0,6,0,0"
              Text="{Binding AttachmentSummary}"
              TextWrapping="Wrap"
              Foreground="#DCE9FF"
              FontSize="12"
              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"
            />
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="2,5,50,5"
          Padding="13,9"
          Background="{StaticResource CardBg}"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="1"
          CornerRadius="16,16,16,4"
          HorizontalAlignment="Left"
          MaxWidth="440"
        >
          <TextBox
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="#1F2937"
            FontSize="13"
          />
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="SystemMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
        <Border
          Margin="20,6"
          Padding="12,5"
          Background="#EEF2F7"
          CornerRadius="12"
          HorizontalAlignment="Center"
          MaxWidth="460"
        >
          <TextBox
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="Wrap"
            IsReadOnly="True"
            BorderThickness="0"
            Background="Transparent"
            Foreground="{StaticResource MutedText}"
            FontSize="12"
            TextAlignment="Center"
          />
        </Border>
      </DataTemplate>

      <ui:ChatMessageTemplateSelector
        x:Key="ChatMessageTemplateSelector"
        UserTemplate="{StaticResource UserMessageTemplate}"
        AssistantTemplate="{StaticResource AssistantMessageTemplate}"
        SystemTemplate="{StaticResource SystemMessageTemplate}"
        ToolCallTemplate="{StaticResource SystemMessageTemplate}"
      />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── 本体: 左チャット / スプリッタ / 右プレビュー ── -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" MinWidth="360" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <!--
        左: チャット + 接続設定。D&D はトンネル段（Preview*）で受ける
        （メッセージバブル＝コピー可能な TextBox の組み込みドラッグ処理に飲み込まれないように）
      -->
      <Grid
        Grid.Column="0"
        AllowDrop="True"
        PreviewDragOver="ChatArea_PreviewDragOver"
        PreviewDrop="ChatArea_PreviewDrop"
      >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- モックフォルダ（会話開始前に指定する動線・テキストボックス＋参照ボタン） -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            Style="{StaticResource FieldLabel}"
            Text="{x:Static res:Strings.Mock_MockFolder}"
          />
          <TextBox
            Grid.Column="1"
            Padding="6,4"
            Margin="0,0,8,0"
            VerticalContentAlignment="Center"
            Text="{Binding MockFolder, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="{x:Static res:Strings.Mock_MockFolderTooltip}"
          />
          <Button
            Grid.Column="2"
            Style="{StaticResource SecondaryButton}"
            Content="{x:Static res:Strings.Mock_Browse}"
            Command="{Binding BrowseMockFolderCommand}"
          />
        </Grid>

        <!-- 接続方式タブ + 設定カード -->
        <TabControl
          x:Name="BackendTabs"
          Grid.Row="1"
          Style="{StaticResource SettingsTabs}"
          SelectionChanged="BackendTabs_SelectionChanged"
        >
          <TabItem Header="{x:Static res:Strings.Mock_TabApiKey}">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_Provider}"
                />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  ItemsSource="{Binding Connection.ApiProviders}"
                  SelectedItem="{Binding Connection.ApiProvider}"
                  ToolTip="{x:Static res:Strings.Mock_ProviderTooltip}"
                >
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource AiProviderDisplayNameConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_ModelName}"
                />
                <ComboBox
                  x:Name="ApiModelBox"
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  TextSearch.TextPath="Name"
                  Text="{Binding Connection.ApiModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Connection.ApiModelCandidates}"
                >
                  <!-- ドロップダウン項目を横いっぱいに広げ、× ボタンを右端へ寄せる -->
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel LastChildFill="True">
                        <!-- 右端の × は履歴由来（IsRemovable=true）の候補だけ表示し、履歴から個別削除する -->
                        <Button
                          DockPanel.Dock="Right"
                          Content="✕"
                          Padding="6,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Foreground="{StaticResource MutedText}"
                          ToolTip="{x:Static res:Strings.Mock_RemoveModelFromHistory}"
                          Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}"
                          Command="{Binding DataContext.Connection.RemoveApiModelHistoryCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          CommandParameter="{Binding Name}"
                        />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid
                Margin="0,10,0,0"
                Visibility="{Binding Connection.ShowApiKey, Converter={StaticResource BoolToVisibilityConverter}}"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_ApiKey}"
                />
                <PasswordBox
                  x:Name="ApiKeyBox"
                  Grid.Column="1"
                  Padding="4,5"
                  Margin="0,0,8,0"
                  ToolTip="{x:Static res:Strings.Mock_ApiKeyTooltip}"
                  common:PasswordBoxBehavior.BoundPassword="{Binding Connection.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                />
                <CheckBox
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Content="{x:Static res:Strings.Mock_Save}"
                  IsChecked="{Binding Connection.SaveApiKey}"
                />
              </Grid>
              <!-- ローカル LLM はキーが任意なので、その旨を欄の直下に注記する -->
              <TextBlock
                Margin="0,4,0,0"
                TextWrapping="Wrap"
                Foreground="{StaticResource MutedText}"
                Text="{x:Static res:Strings.Mock_ApiKeyOptionalNote}"
                Visibility="{Binding Connection.IsLocalLlmProvider, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Grid
                Margin="0,10,0,0"
                Visibility="{Binding Connection.ShowEndpoint, Converter={StaticResource BoolToVisibilityConverter}}"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_Endpoint}"
                />
                <TextBox
                  Grid.Column="1"
                  Padding="6,4"
                  Text="{Binding Connection.EndpointOverride, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="{x:Static res:Strings.Mock_EndpointTooltip}"
                />
              </Grid>
            </StackPanel>
          </TabItem>

          <TabItem Header="Codex">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_Provider}"
                />
                <!-- プロバイダーはリスト選択のみ（自由入力不可）。内部値 "openai" は表示のみ "OpenAI" にする -->
                <ComboBox
                  x:Name="CodexProviderBox"
                  Grid.Column="1"
                  Padding="6,4"
                  SelectedItem="{Binding Connection.CodexModelProvider}"
                  ItemsSource="{Binding Connection.CodexModelProviderCandidates}"
                >
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource CodexProviderDisplayNameConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_ModelName}"
                />
                <ComboBox
                  x:Name="CodexModelBox"
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  TextSearch.TextPath="Name"
                  Text="{Binding Connection.CodexModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Connection.CodexModelCandidates}"
                >
                  <!-- ドロップダウン項目を横いっぱいに広げ、× ボタンを右端へ寄せる -->
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel LastChildFill="True">
                        <!-- 右端の × は履歴由来（IsRemovable=true）の候補だけ表示し、履歴から個別削除する -->
                        <Button
                          DockPanel.Dock="Right"
                          Content="✕"
                          Padding="6,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Foreground="{StaticResource MutedText}"
                          ToolTip="{x:Static res:Strings.Mock_RemoveModelFromHistory}"
                          Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}"
                          Command="{Binding DataContext.Connection.RemoveCodexModelHistoryCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          CommandParameter="{Binding Name}"
                        />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <ui:ConnectionStatusPanel
                Margin="0,10,0,0"
                StatusLevel="{Binding CodexStatusLevel}"
                SummaryText="{Binding CodexAccountSummary}"
                RefreshCommand="{Binding CodexRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              >
                <ui:ConnectionStatusPanel.Body>
                  <!-- 状態依存の案内（CLI 未検出時のインストール案内・接続失敗理由）。空なら行ごと隠す -->
                  <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{StaticResource MutedText}"
                    TextWrapping="Wrap"
                    Text="{Binding CodexGuidance}"
                    Visibility="{Binding ShowCodexGuidance, Converter={StaticResource BoolToVisibilityConverter}}"
                  />
                </ui:ConnectionStatusPanel.Body>
              </ui:ConnectionStatusPanel>
            </StackPanel>
          </TabItem>

          <TabItem Header="Claude Code">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_Model}"
                />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  Text="{Binding Connection.ClaudeCodeModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Connection.ClaudeCodeModelCandidates}"
                />
              </Grid>
              <ui:ConnectionStatusPanel
                Margin="0,10,0,0"
                StatusLevel="{Binding Connection.ClaudeCodeStatusLevel}"
                SummaryText="{Binding Connection.ClaudeCodeStatusSummary}"
                RefreshCommand="{Binding ClaudeCodeRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              >
                <ui:ConnectionStatusPanel.Body>
                  <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{StaticResource MutedText}"
                    TextWrapping="Wrap"
                    Text="{Binding Connection.ClaudeCodeGuidance}"
                  />
                </ui:ConnectionStatusPanel.Body>
              </ui:ConnectionStatusPanel>
            </StackPanel>
          </TabItem>

          <TabItem Header="Copilot">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="{x:Static res:Strings.Mock_Model}"
                />
                <!-- 候補は接続後の実行時列挙（削除不可）＋カタログ外の MRU 履歴（× で削除可能）。空＝CLI 既定 -->
                <ComboBox
                  x:Name="CopilotModelBox"
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  TextSearch.TextPath="Name"
                  Text="{Binding Connection.CopilotModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Connection.CopilotModelCandidates}"
                  ToolTip="{x:Static res:Strings.Mock_CopilotModelTooltip}"
                >
                  <!-- ドロップダウン項目を横いっぱいに広げ、× ボタンを右端へ寄せる -->
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel LastChildFill="True">
                        <!-- 右端の × は履歴由来（IsRemovable=true）の候補だけ表示し、履歴から個別削除する -->
                        <Button
                          DockPanel.Dock="Right"
                          Content="✕"
                          Padding="6,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Foreground="{StaticResource MutedText}"
                          ToolTip="{x:Static res:Strings.Mock_RemoveModelFromHistory}"
                          Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}"
                          Command="{Binding DataContext.Connection.RemoveCopilotModelHistoryCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          CommandParameter="{Binding Name}"
                        />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <ui:ConnectionStatusPanel
                Margin="0,10,0,0"
                StatusLevel="{Binding Connection.CopilotStatusLevel}"
                SummaryText="{Binding Connection.CopilotStatusSummary}"
                RefreshCommand="{Binding CopilotRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              >
                <ui:ConnectionStatusPanel.Body>
                  <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{StaticResource MutedText}"
                    TextWrapping="Wrap"
                    Text="{Binding Connection.CopilotGuidance}"
                  />
                </ui:ConnectionStatusPanel.Body>
              </ui:ConnectionStatusPanel>
            </StackPanel>
          </TabItem>
        </TabControl>

        <!-- チャットカード -->
        <Border
          Grid.Row="2"
          Margin="0,12,0,0"
          Background="{StaticResource CardBg}"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="1"
          CornerRadius="10"
        >
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
              Grid.Row="0"
              Background="#FBFCFE"
              BorderBrush="{StaticResource Divider}"
              BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0"
            >
              <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource HeaderText}"
                  Text="{x:Static res:Strings.Mock_ConversationHeader}"
                />
                <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                >
                  <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource Accent}" />
                  <TextBlock
                    Text="{x:Static res:Strings.Mock_Generating}"
                    Foreground="{StaticResource Accent}"
                    FontSize="12"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Content="{x:Static res:Strings.Mock_Interrupt}"
                    Command="{Binding InterruptCommand}"
                    Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                  />
                  <Button
                    Style="{StaticResource SecondaryButton}"
                    Content="{x:Static res:Strings.Mock_NewConversation}"
                    Command="{Binding StartConversationCommand}"
                  />
                  <!-- 画面全体の初期化（確認後に会話・フォルダ選択・第2ステップ入力をクリア） -->
                  <Button
                    Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"
                    Content="{x:Static res:Strings.Mock_Clear}"
                    Command="{Binding ClearCommand}"
                  />
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer
              x:Name="ChatScrollViewer"
              Grid.Row="1"
              Padding="8,6"
              VerticalScrollBarVisibility="Auto"
            >
              <ItemsControl
                ItemsSource="{Binding Messages}"
                ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
                HorizontalContentAlignment="Stretch"
              >
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- 入力エリア（添付チップ列＋クリップ + 入力欄 + 送信） -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 添付チップ列＋クリップボタン（入力欄の上） -->
          <ui:AttachmentPanel
            x:Name="Attachments"
            Grid.Row="0"
            Margin="0,0,0,6"
            AttachmentList="{Binding Attachments}"
            AttachRequested="Attachments_AttachRequested"
          />

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="UserInputBox"
              Grid.Column="0"
              Style="{StaticResource ChatInputBox}"
              Margin="0,0,8,0"
              MinHeight="48"
              MaxHeight="140"
              TextWrapping="Wrap"
              AcceptsReturn="True"
              IsEnabled="{Binding CanEditInput}"
              Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
              ToolTip="{x:Static res:Strings.Mock_InputTooltip}"
              PreviewKeyDown="UserInputBox_PreviewKeyDown"
            >
              <TextBox.InputBindings>
                <KeyBinding
                  Modifiers="Control"
                  Key="Return"
                  Command="{Binding SendMessageCommand}"
                />
              </TextBox.InputBindings>
            </TextBox>
            <Button
              Grid.Column="1"
              Style="{StaticResource PrimaryButton}"
              Width="96"
              VerticalAlignment="Stretch"
              Content="{x:Static res:Strings.Mock_Send}"
              Command="{Binding SendMessageCommand}"
            />
          </Grid>
        </Grid>
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        ResizeBehavior="PreviousAndNext"
      />

      <!-- 右: プレビュー -->
      <Border
        Grid.Column="2"
        Background="{StaticResource CardBg}"
        BorderBrush="{StaticResource Divider}"
        BorderThickness="1"
        CornerRadius="10"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border
            Grid.Row="0"
            Background="#FBFCFE"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0"
          >
            <Grid Margin="14,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{StaticResource HeaderText}"
                Text="{x:Static res:Strings.Mock_PreviewHeader}"
              />
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                  Style="{StaticResource SecondaryButton}"
                  Content="{x:Static res:Strings.Mock_ExportDesignDoc}"
                  Command="{Binding ExportDesignDocCommand}"
                />
                <Button
                  Margin="8,0,0,0"
                  Style="{StaticResource SecondaryButton}"
                  Content="{x:Static res:Strings.Mock_ExportHtml}"
                  Command="{Binding ExportBundleCommand}"
                />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 画面一覧サイドバー + プレビュー -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" MinWidth="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
              Grid.Column="0"
              BorderBrush="{StaticResource Divider}"
              BorderThickness="0,0,1,0"
            >
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                  Grid.Row="0"
                  Margin="8,6"
                  FontWeight="SemiBold"
                  FontSize="12"
                  Foreground="{StaticResource MutedText}"
                  Text="{x:Static res:Strings.Mock_ScreensHeader}"
                />
                <!-- 画面一覧: 表示は Name・ツールチップに File/Description -->
                <ListBox
                  Grid.Row="1"
                  BorderThickness="0"
                  Background="Transparent"
                  ItemsSource="{Binding Screens}"
                  SelectedItem="{Binding SelectedScreen, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                >
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock
                        Padding="4,3"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <!-- プレビュー領域: 周囲より一段強い枠線（FieldBorder）で表示範囲を明示する -->
            <Border
              Grid.Column="1"
              Margin="8"
              Background="White"
              BorderBrush="{StaticResource FieldBorder}"
              BorderThickness="1"
            >
              <local:MockPreviewPanel x:Name="Preview" />
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ── 第2ステップ: モックプロジェクト生成（Claude Code / Codex / API キー） ── -->
    <Border
      Grid.Row="1"
      Margin="0,12,0,0"
      Background="{StaticResource CardBg}"
      BorderBrush="{StaticResource Divider}"
      BorderThickness="1"
      CornerRadius="10"
    >
      <!-- 初期表示は閉じた状態（第1ステップに集中させ、必要になったら開く） -->
      <Expander Padding="14,10" IsExpanded="False">
        <Expander.Header>
          <TextBlock
            FontWeight="SemiBold"
            Foreground="{StaticResource HeaderText}"
            Text="{x:Static res:Strings.Mock_Step2Header}"
          />
        </Expander.Header>

        <StackPanel Margin="4,10,4,4">
          <!-- API キー方式のときだけ出す注記（一発生成＝自己修正なしのため失敗し得る） -->
          <TextBlock
            Margin="0,0,0,10"
            Foreground="#B45309"
            FontSize="12"
            TextWrapping="Wrap"
            Text="{x:Static res:Strings.Mock_ApiKeyOneShotNote}"
            Visibility="{Binding IsApiKeyMockGenBackend, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <!-- ターゲット（生成プラットフォーム: WPF / Blazor Web App） -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Mock_TargetLabel}"
            />
            <ComboBox
              Grid.Column="1"
              Padding="6,4"
              ItemsSource="{Binding MockProjectTargets}"
              SelectedItem="{Binding SelectedMockProjectTarget}"
              DisplayMemberPath="DisplayName"
              IsEnabled="{Binding CanEditMockGenInput}"
            />
          </Grid>

          <!-- 出力フォルダ -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Mock_OutputFolder}"
            />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              Margin="0,0,8,0"
              VerticalContentAlignment="Center"
              Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
              IsEnabled="{Binding CanEditMockGenInput}"
            />
            <Button
              Grid.Column="2"
              Style="{StaticResource SecondaryButton}"
              Content="{x:Static res:Strings.Mock_Browse}"
              Command="{Binding BrowseOutputFolderCommand}"
            />
          </Grid>

          <!-- プロジェクト名 -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              Text="{x:Static res:Strings.Mock_ProjectName}"
            />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              VerticalContentAlignment="Center"
              Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
              IsEnabled="{Binding CanEditMockGenInput}"
            />
          </Grid>

          <!-- 追加指示（任意・複数行。選択中バックエンドへのプロンプト末尾に連結される） -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Style="{StaticResource FieldLabel}"
              VerticalAlignment="Top"
              Margin="0,4,0,0"
              Text="{x:Static res:Strings.Mock_MockGenInstructions}"
            />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              MinHeight="48"
              MaxHeight="120"
              TextWrapping="Wrap"
              AcceptsReturn="True"
              VerticalScrollBarVisibility="Auto"
              Text="{Binding MockGenInstructions, UpdateSourceTrigger=PropertyChanged}"
              IsEnabled="{Binding CanEditMockGenInput}"
              ToolTip="{x:Static res:Strings.Mock_MockGenInstructionsTooltip}"
            />
          </Grid>

          <!-- 操作行: 生成／中断／フォルダを開く／案内 -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              Foreground="{StaticResource MutedText}"
              FontSize="12"
              TextWrapping="Wrap"
              Text="{Binding MockGenDisabledReason}"
            />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button
                Style="{StaticResource SecondaryButton}"
                Content="{x:Static res:Strings.Mock_OpenFolder}"
                Margin="0,0,8,0"
                Command="{Binding OpenOutputFolderCommand}"
                Visibility="{Binding ShowOpenFolder, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Button
                Style="{StaticResource SecondaryButton}"
                Content="{x:Static res:Strings.Mock_Interrupt}"
                Margin="0,0,8,0"
                Command="{Binding InterruptMockGenCommand}"
                Visibility="{Binding IsMockGenInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Button
                Style="{StaticResource PrimaryButton}"
                Width="150"
                Content="{x:Static res:Strings.Mock_GenerateProject}"
                Command="{Binding GenerateMockProjectCommand}"
                ToolTip="{Binding MockGenDisabledReason}"
              />
            </StackPanel>
          </Grid>

          <!-- 進捗ログ（読み取り専用・自動スクロール） -->
          <Border
            Margin="0,10,0,0"
            Height="150"
            Background="#0B1021"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsMockGenInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <ScrollViewer
              x:Name="MockGenLogScroll"
              Padding="10,8"
              VerticalScrollBarVisibility="Auto"
            >
              <TextBox
                Text="{Binding MockGenLog, Mode=OneWay}"
                IsReadOnly="True"
                BorderThickness="0"
                Background="Transparent"
                Foreground="#D6E2FF"
                FontFamily="Consolas, Cascadia Mono, monospace"
                FontSize="12"
                TextWrapping="Wrap"
              />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Expander>
    </Border>

    <!-- ステータスバー -->
    <TextBlock
      Grid.Row="2"
      Margin="4,10,0,0"
      Foreground="{StaticResource MutedText}"
      FontSize="12"
      TextWrapping="Wrap"
      Text="{Binding StatusMessage}"
    />
  </Grid>
</Window>

<UserControl
  x:Class="QuickER.AI.Mock.MockPreviewPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
  xmlns:res="clr-namespace:QuickER.AI.Mock.Resources"
>
  <Grid>
    <!-- HTML プレビュー本体 -->
    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

    <!-- 空表示（まだモックが生成されていないとき） -->
    <Border x:Name="EmptyPlaceholder" Background="#F8FAFC">
      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="#6B7280"
        FontSize="13"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Text="{x:Static res:Strings.MockPreview_EmptyText}"
      />
    </Border>

    <!-- ランタイム未導入などプレビュー不可時の案内 -->
    <Border x:Name="UnavailablePanel" Background="#FFF7ED" Visibility="Collapsed" Padding="24">
      <StackPanel VerticalAlignment="Center" MaxWidth="460">
        <TextBlock
          FontWeight="SemiBold"
          FontSize="14"
          Foreground="#9A3412"
          Text="{x:Static res:Strings.MockPreview_UnavailableTitle}"
        />
        <TextBlock
          x:Name="UnavailableMessage"
          Margin="0,10,0,0"
          Foreground="#7C2D12"
          FontSize="13"
          TextWrapping="Wrap"
          Text="{x:Static res:Strings.MockPreview_UnavailableMessage}"
        />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

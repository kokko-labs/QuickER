<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- プロジェクト名は QuickER.Gui（QuickER.Cli と対称）だが、実行ファイル名と namespace は QuickER ブランドを維持する -->
    <AssemblyName>QuickER</AssemblyName>
    <RootNamespace>QuickER</RootNamespace>
    <!-- アプリアイコン（正本は assets/ 直下。exe 埋め込み＝タイトルバー・タスクバー・エクスプローラーに反映） -->
    <ApplicationIcon>..\..\assets\QuickER.ico</ApplicationIcon>
    <!-- 中立（既定）リソースのカルチャ＝英語。日本語は Strings.ja.resx サテライトで賦与する -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <!--
      Velopack のインストール/更新フックを WPF 初期化より前に処理するため、エントリポイントを
      自前の QuickER.Program.Main に差し替える。既定の App.xaml 由来 Main は生成させない
      （EnableDefaultApplicationDefinition=false で App.xaml を ApplicationDefinition ではなく
      Page としてコンパイルし、InitializeComponent のみ生成させる）。
    -->
    <StartupObject>QuickER.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!--
      AI フィーチャーモジュール（チャット・モック生成）の同梱可否。
      false にすると AI 系プロジェクトへの参照ごと外れた「AI なし構成」をビルドできる
      （FeatureModuleCatalog の QUICKER_AI_MODULES 定数と連動）。
    -->
    <IncludeAiModules Condition="'$(IncludeAiModules)' == ''">true</IncludeAiModules>
    <DefineConstants Condition="'$(IncludeAiModules)' == 'true'"
      >$(DefineConstants);QUICKER_AI_MODULES</DefineConstants>
    <!--
      コード生成・クエリ定義フィーチャーモジュールの同梱可否（AI とは独立に着脱できる）。
      false にすると CodeGen.UI（ダイアログ層）への参照ごと外れた構成をビルドできる
      （FeatureModuleCatalog の QUICKER_CODEGEN_MODULES 定数と連動）。
      生成エンジン CodeGen.CSharp は型解決（CSharpTypeInfo）のためプロバイダ層が参照しており、
      このスイッチでは外れない（外れるのは機能 UI のみ）。
    -->
    <IncludeCodeGenModules Condition="'$(IncludeCodeGenModules)' == ''">true</IncludeCodeGenModules>
    <DefineConstants Condition="'$(IncludeCodeGenModules)' == 'true'"
      >$(DefineConstants);QUICKER_CODEGEN_MODULES</DefineConstants>
    <!--
      DB 取込・DB 同期フィーチャーモジュールの同梱可否（他スイッチと独立に着脱できる）。
      false にすると Db.UI（接続ダイアログ・同期ダイアログ・接続プロファイル）への参照ごと外れた
      構成をビルドできる（FeatureModuleCatalog の QUICKER_DBTOOL_MODULES 定数と連動）。
      スキーマ取込・差分・同期のエンジンはプロバイダ層在住（CLI の scaffold と共有）のため外れない。
    -->
    <IncludeDbToolModules Condition="'$(IncludeDbToolModules)' == ''">true</IncludeDbToolModules>
    <DefineConstants Condition="'$(IncludeDbToolModules)' == 'true'"
      >$(DefineConstants);QUICKER_DBTOOL_MODULES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\QuickER.AI.Chat\QuickER.AI.Chat.csproj"
      Condition="'$(IncludeAiModules)' == 'true'"
    />
    <ProjectReference
      Include="..\QuickER.AI.Mock\QuickER.AI.Mock.csproj"
      Condition="'$(IncludeAiModules)' == 'true'"
    />
    <ProjectReference Include="..\QuickER.Extensibility\QuickER.Extensibility.csproj" />
    <ProjectReference Include="..\QuickER.Gui.Abstractions\QuickER.Gui.Abstractions.csproj" />
    <ProjectReference Include="..\QuickER.Gui.Common\QuickER.Gui.Common.csproj" />
    <ProjectReference
      Include="..\QuickER.Db.UI\QuickER.Db.UI.csproj"
      Condition="'$(IncludeDbToolModules)' == 'true'"
    />
    <ProjectReference Include="..\QuickER.Document\QuickER.Document.csproj" />
    <ProjectReference
      Include="..\QuickER.CodeGen.UI\QuickER.CodeGen.UI.csproj"
      Condition="'$(IncludeCodeGenModules)' == 'true'"
    />
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.MySql\QuickER.MySql.csproj" />
    <ProjectReference Include="..\QuickER.Oracle\QuickER.Oracle.csproj" />
    <ProjectReference Include="..\QuickER.PostgreSql\QuickER.PostgreSql.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\QuickER.Settings\QuickER.Settings.csproj" />
    <ProjectReference Include="..\QuickER.Sqlite\QuickER.Sqlite.csproj" />
    <ProjectReference Include="..\QuickER.SqlServer\QuickER.SqlServer.csproj" />
  </ItemGroup>

  <!--
    多言語リソース: Strings.resx（中立＝英語）と Strings.ja.resx（日本語サテライト）。
    厳密型アクセサ（Strings.Designer.cs）は Visual Studio 以外でも確実に通るよう手書きでチェックイン済み
    （PublicResXFileCodeGenerator 相当の public クラス）。VS 上での再生成整合のためにメタデータも付与する。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

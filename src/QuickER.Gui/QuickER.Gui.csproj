<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- プロジェクト名は QuickER.Gui（QuickER.Cli と対称）だが、実行ファイル名と namespace は QuickER ブランドを維持する -->
    <AssemblyName>QuickER</AssemblyName>
    <RootNamespace>QuickER</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.AI\QuickER.AI.csproj" />
    <ProjectReference Include="..\QuickER.Document\QuickER.Document.csproj" />
    <ProjectReference Include="..\QuickER.Generator\QuickER.Generator.csproj" />
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.PostgreSql\QuickER.PostgreSql.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\QuickER.SqlServer\QuickER.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ViewModels\CSharpGenerationDialogViewModel.cs" />
    <Compile Update="Views\CSharpGenerationDialog.xaml.cs">
      <DependentUpon>CSharpGenerationDialog.xaml</DependentUpon>
    </Compile>
    <Page Update="Views\CSharpGenerationDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>

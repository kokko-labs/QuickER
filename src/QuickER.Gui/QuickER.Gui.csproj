<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- プロジェクト名は QuickER.Gui（QuickER.Cli と対称）だが、実行ファイル名と namespace は QuickER ブランドを維持する -->
    <AssemblyName>QuickER</AssemblyName>
    <RootNamespace>QuickER</RootNamespace>
    <!-- 中立（既定）リソースのカルチャ＝日本語。英語は Strings.en.resx サテライトで賦与する -->
    <NeutralResourcesLanguage>ja</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.AI\QuickER.AI.csproj" />
    <ProjectReference Include="..\QuickER.AI.UI\QuickER.AI.UI.csproj" />
    <ProjectReference Include="..\QuickER.AI.Chat\QuickER.AI.Chat.csproj" />
    <ProjectReference Include="..\QuickER.AI.Mock\QuickER.AI.Mock.csproj" />
    <ProjectReference Include="..\QuickER.Gui.Abstractions\QuickER.Gui.Abstractions.csproj" />
    <ProjectReference Include="..\QuickER.Document\QuickER.Document.csproj" />
    <ProjectReference Include="..\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\QuickER.CodeGen.UI\QuickER.CodeGen.UI.csproj" />
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.MySql\QuickER.MySql.csproj" />
    <ProjectReference Include="..\QuickER.Oracle\QuickER.Oracle.csproj" />
    <ProjectReference Include="..\QuickER.PostgreSql\QuickER.PostgreSql.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
    <ProjectReference Include="..\QuickER.Settings\QuickER.Settings.csproj" />
    <ProjectReference Include="..\QuickER.Sqlite\QuickER.Sqlite.csproj" />
    <ProjectReference Include="..\QuickER.SqlServer\QuickER.SqlServer.csproj" />
  </ItemGroup>

  <!--
    多言語リソース: Strings.resx（中立＝日本語）と Strings.en.resx（英語サテライト）。
    厳密型アクセサ（Strings.Designer.cs）は Visual Studio 以外でも確実に通るよう手書きでチェックイン済み
    （PublicResXFileCodeGenerator 相当の public クラス）。VS 上での再生成整合のためにメタデータも付与する。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

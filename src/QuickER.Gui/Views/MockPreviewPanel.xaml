<UserControl
  x:Class="QuickER.Views.MockPreviewPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
>
  <Grid>
    <!-- HTML プレビュー本体 -->
    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

    <!-- 空表示（まだモックが生成されていないとき） -->
    <Border x:Name="EmptyPlaceholder" Background="#F8FAFC">
      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="#6B7280"
        FontSize="13"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Text="ここに生成されたモック画面が表示されます。&#x0a;左のチャットで「＋新しい会話」を開始し、モックへの要望を送信してください。"
      />
    </Border>

    <!-- ランタイム未導入などプレビュー不可時の案内 -->
    <Border x:Name="UnavailablePanel" Background="#FFF7ED" Visibility="Collapsed" Padding="24">
      <StackPanel VerticalAlignment="Center" MaxWidth="460">
        <TextBlock
          FontWeight="SemiBold"
          FontSize="14"
          Foreground="#9A3412"
          Text="プレビューを表示できません"
        />
        <TextBlock
          x:Name="UnavailableMessage"
          Margin="0,10,0,0"
          Foreground="#7C2D12"
          FontSize="13"
          TextWrapping="Wrap"
          Text="WebView2 ランタイムが見つかりませんでした。Microsoft Edge WebView2 Runtime（Evergreen）をインストールすると、生成したモックをこの画面でプレビューできます。生成された HTML は「HTML を保存」から書き出せます。"
        />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

<Window
  x:Class="QuickER.Views.AboutDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:resources="clr-namespace:QuickER.Resources"
  Title="{x:Static resources:Strings.About_Title}"
  Width="580"
  SizeToContent="Height"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="{DynamicResource WindowBackground}"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色・ボタンの共通スタイルは共有テーマ辞書から取り込む -->
        <ResourceDictionary Source="pack://application:,,,/QuickER.Gui.Common;component/Themes/DialogTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="14">
    <TextBlock Text="QuickER" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="VersionText" Margin="0,4,0,0" />

    <TextBlock x:Name="RuntimeText" Margin="0,12,0,0" TextWrapping="Wrap" />
    <TextBlock x:Name="CopyrightText" Margin="0,4,0,0" TextWrapping="Wrap" />

    <!-- リポジトリとドキュメントの目次（クリックで既定のブラウザーで開く） -->
    <TextBlock x:Name="RepositoryLine" Margin="0,12,0,0" TextWrapping="Wrap">
      <Run Text="{x:Static resources:Strings.About_Repository}" />
      <Hyperlink x:Name="RepositoryLink" RequestNavigate="OnLinkNavigate">
        <Run x:Name="RepositoryLinkText" />
      </Hyperlink>
    </TextBlock>
    <TextBlock x:Name="DocumentationLine" Margin="0,4,0,0" TextWrapping="Wrap">
      <Run Text="{x:Static resources:Strings.About_Documentation}" />
      <Hyperlink x:Name="DocumentationLink" RequestNavigate="OnLinkNavigate">
        <Run x:Name="DocumentationLinkText" />
      </Hyperlink>
    </TextBlock>

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <!-- コピー結果の一時表示（成功・失敗）。ボタンの左に出す -->
      <TextBlock
        x:Name="CopyStatusText"
        DockPanel.Dock="Left"
        VerticalAlignment="Center"
        Foreground="{DynamicResource MutedText}"
      />
      <Button
        DockPanel.Dock="Right"
        Content="{x:Static resources:Strings.Common_Close}"
        MinWidth="80"
        IsDefault="True"
        IsCancel="True"
        Style="{StaticResource PrimaryButton}"
      />
      <Button
        DockPanel.Dock="Right"
        Content="{x:Static resources:Strings.About_CopyVersionInfo}"
        MinWidth="80"
        Margin="0,0,8,0"
        Style="{StaticResource SecondaryButton}"
        Click="OnCopyClick"
      />
    </DockPanel>
  </StackPanel>
</Window>

<Window
  x:Class="QuickER.Views.CSharpGenerationDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="C# コード生成"
  Width="720"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
>
  <Window.Resources>
    <!-- ── 配色 ── -->
    <SolidColorBrush x:Key="Accent" Color="#1A73E8" />
    <SolidColorBrush x:Key="AccentHover" Color="#1769D6" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#E5E7EB" />
    <SolidColorBrush x:Key="HeaderText" Color="#374151" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="FieldBorder" Color="#D1D5DB" />

    <!-- ── カード ── -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ── セクション見出し ── -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ── 項目ラベル ── -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── 入力欄（角丸・フォーカスでアクセント） ── -->
    <Style x:Key="FormInput" TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7"
            >
              <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 主要ボタン（アクセント） ── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{StaticResource AccentHover}"
                />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 副ボタン（白・枠線） ── -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{StaticResource FieldBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="18">
    <!-- 出力モード -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="出力モード" />
        <StackPanel Orientation="Horizontal">
          <RadioButton
            Margin="0,0,28,0"
            Content="1 ファイルにまとめる"
            GroupName="OutputMode"
            IsChecked="{Binding MergeIntoSingleFile}"
          />
          <RadioButton
            Content="レイヤごとに分割する"
            GroupName="OutputMode"
            IsChecked="{Binding SplitFilesByCategory}"
          />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 生成内容 -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="生成内容" />

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="namespace" />
          <TextBox
            Grid.Column="1"
            Style="{StaticResource FormInput}"
            Text="{Binding BaseNamespace, UpdateSourceTrigger=PropertyChanged}"
          />
        </Grid>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            Style="{StaticResource FieldLabel}"
            VerticalAlignment="Top"
            Margin="0,2,0,0"
            Text="生成対象"
          />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <CheckBox
              Margin="0,0,18,0"
              Content="Entity"
              IsChecked="{Binding GenerateEntityClasses, Mode=OneWay}"
              IsEnabled="False"
              ToolTip="Entity は全カテゴリの前提のため常に生成されます"
            />
            <CheckBox
              Margin="0,0,18,0"
              Content="EditModel"
              IsChecked="{Binding GenerateEditModels}"
            />
            <CheckBox Content="Mapper" IsChecked="{Binding GenerateMappers}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            Style="{StaticResource FieldLabel}"
            VerticalAlignment="Top"
            Margin="0,2,0,0"
            Text="値オブジェクト"
          />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <CheckBox
              Margin="0,0,18,0"
              Content="全カラムを値オブジェクト化"
              IsChecked="{Binding GenerateValueObjects}"
            />
            <CheckBox
              Content="string 主キーを GuidKey 化"
              IsChecked="{Binding UseGuidKeyForStringPrimaryKey}"
              IsEnabled="{Binding GenerateValueObjects}"
            />
          </StackPanel>
        </Grid>

        <!-- DB アクセス（排他選択。自作 Repository は対応方言限定のため現在の DB を隣に提示する） -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            Style="{StaticResource FieldLabel}"
            VerticalAlignment="Top"
            Margin="0,2,0,0"
            Text="DB アクセス"
          />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock
              Margin="0,0,18,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{StaticResource HeaderText}"
              Text="{Binding CurrentDatabaseDisplayName}"
              ToolTip="アプリで現在選択している DB（プロバイダ）"
            />
            <RadioButton
              Margin="0,0,18,0"
              Content="なし"
              GroupName="DbAccess"
              IsChecked="{Binding DbAccessNone}"
            />
            <RadioButton
              Margin="0,0,18,0"
              Content="Repository (EF Core)"
              GroupName="DbAccess"
              IsChecked="{Binding DbAccessEfCore}"
              ToolTip="EF Core 実装の Repository と方言非依存の DbContext を生成します（接続先はアプリ側の UseSqlServer / UseNpgsql 等で選択）"
            />
            <RadioButton
              Content="Repository (QuickER)"
              GroupName="DbAccess"
              IsChecked="{Binding DbAccessRepository}"
              ToolTip="{Binding QuickErRepositoryToolTip}"
            />
          </StackPanel>
        </Grid>

        <!-- 自作 Repository の対象方言（Repository (QuickER) 選択時のみ表示。表示順固定: SQL Server → SQLite） -->
        <Grid
          Margin="0,10,0,0"
          Visibility="{Binding ShowRepositoryDialectTargets, Converter={StaticResource BoolToVisibilityConverter}}"
        >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="対象方言" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <CheckBox
              Margin="0,0,18,0"
              Content="SQL Server"
              IsChecked="{Binding TargetSqlServer}"
            />
            <CheckBox Content="SQLite" IsChecked="{Binding TargetSqlite}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- モード①: 出力ファイル -->
    <Border
      Style="{StaticResource Card}"
      Visibility="{Binding ShowSingleFileOutput, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="出力先" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="ファイル" />
          <TextBox
            Grid.Column="1"
            Style="{StaticResource FormInput}"
            Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}"
          />
          <Button
            Grid.Column="2"
            Margin="8,0,0,0"
            Content="参照..."
            Style="{StaticResource SecondaryButton}"
            Command="{Binding BrowseOutputFileCommand}"
          />
        </Grid>
      </StackPanel>
    </Border>

    <!-- モード②: 分割設定 -->
    <Border
      Style="{StaticResource Card}"
      Visibility="{Binding ShowSplitOptions, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="出力先 / 分割設定" />

        <!-- 出力フォルダ -->
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="フォルダ" />
          <TextBox
            Grid.Column="1"
            Style="{StaticResource FormInput}"
            Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
          />
          <Button
            Grid.Column="2"
            Margin="8,0,0,0"
            Content="参照..."
            Style="{StaticResource SecondaryButton}"
            Command="{Binding BrowseOutputFolderCommand}"
          />
        </Grid>

        <!-- カテゴリ別 namespace -->
        <TextBlock
          Margin="0,0,0,6"
          Foreground="{StaticResource MutedText}"
          Text="カテゴリ別 namespace"
        />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,4"
            Style="{StaticResource FieldLabel}"
            Text="Entity"
            Visibility="{Binding ShowEntityNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
          <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource FormInput}"
            Text="{Binding EntityNamespace, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowEntityNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,4"
            Style="{StaticResource FieldLabel}"
            Text="EditModel"
            Visibility="{Binding ShowEditModelNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
          <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource FormInput}"
            Text="{Binding EditModelNamespace, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowEditModelNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,4"
            Style="{StaticResource FieldLabel}"
            Text="Mapper"
            Visibility="{Binding ShowMapperNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
          <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource FormInput}"
            Text="{Binding MapperNamespace, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowMapperNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,4"
            Style="{StaticResource FieldLabel}"
            Text="ValueObject"
            Visibility="{Binding ShowValueObjectNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
          <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource FormInput}"
            Text="{Binding ValueObjectNamespace, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowValueObjectNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <!-- DB アクセス系は「生成内容」の並びに合わせて末尾。EF Core 選択時は契約（Repository）＋EfCore の 2 欄が並ぶ -->
          <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,4"
            Style="{StaticResource FieldLabel}"
            Text="Repository"
            Visibility="{Binding ShowRepositoryNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
          <TextBox
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource FormInput}"
            Text="{Binding RepositoryNamespace, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowRepositoryNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />

          <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Margin="0,4"
            Style="{StaticResource FieldLabel}"
            Text="EF Core"
            Visibility="{Binding ShowEfCoreNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
          <TextBox
            Grid.Row="5"
            Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource FormInput}"
            Text="{Binding EfCoreNamespace, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowEfCoreNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
          />
        </Grid>

        <!-- Runtime（共通基盤: 基底クラス・属性・JSON コンバータなど全カテゴリが使う土台） -->
        <Grid
          Margin="0,8,0,0"
          Visibility="{Binding ShowRuntimeNamespace, Converter={StaticResource BoolToVisibilityConverter}}"
        >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            ToolTip="全カテゴリが共通して使う土台（基底クラス・属性・値オブジェクト基底・JSON コンバータなど）"
          >
            <TextBlock Foreground="{StaticResource HeaderText}" Text="Runtime" />
            <TextBlock FontSize="11" Foreground="{StaticResource MutedText}" Text="(共通基盤)" />
          </StackPanel>
          <TextBox
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource FormInput}"
            Text="{Binding RuntimeNamespace, UpdateSourceTrigger=PropertyChanged}"
          />
        </Grid>

        <!-- プレビュー -->
        <TextBlock
          Margin="0,14,0,6"
          Foreground="{StaticResource MutedText}"
          Text="生成されるファイル"
        />
        <Border
          Background="#F9FAFB"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="1"
          CornerRadius="8"
        >
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="12,10" ItemsSource="{Binding PreviewFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Margin="0,2"
                    FontFamily="Consolas, Cascadia Mono, monospace"
                    FontSize="12"
                    Foreground="{StaticResource HeaderText}"
                    Text="{Binding}"
                  />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Border>

    <!-- 説明 -->
    <TextBlock
      Margin="2,0,2,4"
      Foreground="{StaticResource MutedText}"
      TextWrapping="Wrap"
      Text="生成される .g.cs は自動生成ファイルです。再生成で上書きされるため直接編集せず、追加実装は別ファイルの partial クラスで行ってください。"
    />

    <!-- フッタ -->
    <DockPanel Margin="0,10,0,0">
      <TextBlock
        DockPanel.Dock="Left"
        VerticalAlignment="Center"
        Foreground="#B91C1C"
        TextWrapping="Wrap"
        Text="{Binding StatusMessage}"
      />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          Margin="0,0,8,0"
          Content="初期設定に戻す"
          Style="{StaticResource SecondaryButton}"
          Command="{Binding ClearCommand}"
        />
        <Button
          Margin="0,0,8,0"
          IsDefault="True"
          Content="生成"
          Style="{StaticResource PrimaryButton}"
          Command="{Binding OkCommand}"
        />
        <Button
          Content="キャンセル"
          IsCancel="True"
          Style="{StaticResource SecondaryButton}"
          Command="{Binding CancelCommand}"
        />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>

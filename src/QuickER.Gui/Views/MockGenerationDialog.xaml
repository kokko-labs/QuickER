<Window
  x:Class="QuickER.Views.MockGenerationDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:QuickER.Converters"
  xmlns:chat="clr-namespace:QuickER.AI;assembly=QuickER.AI"
  xmlns:local="clr-namespace:QuickER.Views"
  Title="AI モック生成"
  Width="1160"
  Height="760"
  MinWidth="900"
  MinHeight="560"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
>
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- ── 配色 ── -->
    <SolidColorBrush x:Key="Accent" Color="#1A73E8" />
    <SolidColorBrush x:Key="AccentHover" Color="#1769D6" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#E5E7EB" />
    <SolidColorBrush x:Key="HeaderText" Color="#374151" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="FieldBorder" Color="#D1D5DB" />

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{StaticResource AccentHover}"
                />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{StaticResource FieldBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChatInputBox" TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="12,9"
            >
              <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="8"
              Padding="14,7"
              Margin="0,0,6,0"
            >
              <ContentPresenter
                ContentSource="Header"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="False" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsTabs" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TabPanel
                Grid.Row="0"
                IsItemsHost="True"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
              />
              <Border
                Grid.Row="1"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="1"
                CornerRadius="10"
              >
                <ContentPresenter ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ── チャット吹き出しテンプレート ── -->
    <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="50,5,2,5"
        Padding="13,9"
        Background="{StaticResource Accent}"
        CornerRadius="16,16,4,16"
        HorizontalAlignment="Right"
        MaxWidth="440"
      >
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="White"
          FontSize="13"
        />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="2,5,50,5"
        Padding="13,9"
        Background="{StaticResource CardBg}"
        BorderBrush="{StaticResource Divider}"
        BorderThickness="1"
        CornerRadius="16,16,16,4"
        HorizontalAlignment="Left"
        MaxWidth="440"
      >
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="#1F2937"
          FontSize="13"
        />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SystemMessageTemplate" DataType="{x:Type chat:ErChatMessage}">
      <Border
        Margin="20,6"
        Padding="12,5"
        Background="#EEF2F7"
        CornerRadius="12"
        HorizontalAlignment="Center"
        MaxWidth="460"
      >
        <TextBox
          Text="{Binding Content, Mode=OneWay}"
          TextWrapping="Wrap"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Foreground="{StaticResource MutedText}"
          FontSize="12"
          TextAlignment="Center"
        />
      </Border>
    </DataTemplate>

    <local:ChatMessageTemplateSelector
      x:Key="ChatMessageTemplateSelector"
      UserTemplate="{StaticResource UserMessageTemplate}"
      AssistantTemplate="{StaticResource AssistantMessageTemplate}"
      SystemTemplate="{StaticResource SystemMessageTemplate}"
      ToolCallTemplate="{StaticResource SystemMessageTemplate}"
    />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── 本体: 左チャット / スプリッタ / 右プレビュー ── -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" MinWidth="360" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <!-- 左: チャット + 接続設定 -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 接続方式タブ + 設定カード -->
        <TabControl
          x:Name="BackendTabs"
          Grid.Row="0"
          Style="{StaticResource SettingsTabs}"
          SelectionChanged="BackendTabs_SelectionChanged"
        >
          <TabItem Header="API キー">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="プロバイダー"
                />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  ItemsSource="{Binding ApiProviders}"
                  SelectedItem="{Binding ApiProvider}"
                />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="モデル名" />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding ApiModelCandidates}"
                />
              </Grid>
              <Grid
                Margin="0,10,0,0"
                Visibility="{Binding ShowApiKey, Converter={StaticResource BoolToVisibilityConverter}}"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="API キー" />
                <PasswordBox
                  x:Name="ApiKeyBox"
                  Grid.Column="1"
                  Padding="4,5"
                  Margin="0,0,8,0"
                  ToolTip="API キー（OpenAI: sk-... / Claude: sk-ant-...）"
                  local:PasswordBoxBehavior.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                />
                <CheckBox
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Content="保存"
                  IsChecked="{Binding SaveApiKey}"
                />
              </Grid>
              <Grid
                Margin="0,10,0,0"
                Visibility="{Binding ShowEndpoint, Converter={StaticResource BoolToVisibilityConverter}}"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="エンドポイント"
                />
                <TextBox
                  Grid.Column="1"
                  Padding="6,4"
                  Text="{Binding EndpointOverride, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="OpenAI 互換エンドポイント（Ollama 等）"
                />
              </Grid>
            </StackPanel>
          </TabItem>

          <TabItem Header="Codex">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Style="{StaticResource FieldLabel}"
                  Text="プロバイダー"
                />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  Text="{Binding CodexModelProvider, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding CodexModelProviderCandidates}"
                />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="モデル名" />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  Text="{Binding CodexModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding CodexModelCandidates}"
                />
              </Grid>
              <local:ConnectionStatusPanel
                Margin="0,10,0,0"
                StatusLevel="{Binding CodexStatusLevel}"
                SummaryText="{Binding CodexAccountSummary}"
                RefreshCommand="{Binding CodexRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              />
            </StackPanel>
          </TabItem>

          <TabItem Header="Claude">
            <StackPanel Margin="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="モデル" />
                <ComboBox
                  Grid.Column="1"
                  Padding="6,4"
                  IsEditable="True"
                  Text="{Binding ClaudeCodeModel, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding ClaudeCodeModelCandidates}"
                />
              </Grid>
              <local:ConnectionStatusPanel
                Margin="0,10,0,0"
                StatusLevel="{Binding ClaudeCodeStatusLevel}"
                SummaryText="{Binding ClaudeCodeStatusSummary}"
                RefreshCommand="{Binding ClaudeCodeRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              >
                <local:ConnectionStatusPanel.Body>
                  <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{StaticResource MutedText}"
                    TextWrapping="Wrap"
                    Text="{Binding ClaudeCodeGuidance}"
                  />
                </local:ConnectionStatusPanel.Body>
              </local:ConnectionStatusPanel>
            </StackPanel>
          </TabItem>
        </TabControl>

        <!-- チャットカード -->
        <Border
          Grid.Row="1"
          Margin="0,12,0,0"
          Background="{StaticResource CardBg}"
          BorderBrush="{StaticResource Divider}"
          BorderThickness="1"
          CornerRadius="10"
        >
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
              Grid.Row="0"
              Background="#FBFCFE"
              BorderBrush="{StaticResource Divider}"
              BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0"
            >
              <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource HeaderText}"
                  Text="会話"
                />
                <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                >
                  <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource Accent}" />
                  <TextBlock
                    Text="生成中..."
                    Foreground="{StaticResource Accent}"
                    FontSize="12"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Content="中断"
                    Command="{Binding InterruptCommand}"
                    Visibility="{Binding IsTurnInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                  />
                  <Button
                    Style="{StaticResource SecondaryButton}"
                    Content="＋ 新しい会話"
                    Command="{Binding StartConversationCommand}"
                  />
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer
              x:Name="ChatScrollViewer"
              Grid.Row="1"
              Padding="8,6"
              VerticalScrollBarVisibility="Auto"
            >
              <ItemsControl
                ItemsSource="{Binding Messages}"
                ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
                HorizontalContentAlignment="Stretch"
              >
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- 入力エリア（入力欄 1 つ + 送信） -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="UserInputBox"
            Grid.Column="0"
            Style="{StaticResource ChatInputBox}"
            Margin="0,0,8,0"
            MinHeight="48"
            MaxHeight="140"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            IsEnabled="{Binding CanEditInput}"
            Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="モックへの要望・修正指示（Ctrl+Enter で送信）"
          >
            <TextBox.InputBindings>
              <KeyBinding Modifiers="Control" Key="Return" Command="{Binding SendMessageCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button
            Grid.Column="1"
            Style="{StaticResource PrimaryButton}"
            Width="96"
            VerticalAlignment="Stretch"
            Content="送信"
            Command="{Binding SendMessageCommand}"
          />
        </Grid>
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        ResizeBehavior="PreviousAndNext"
      />

      <!-- 右: プレビュー -->
      <Border
        Grid.Column="2"
        Background="{StaticResource CardBg}"
        BorderBrush="{StaticResource Divider}"
        BorderThickness="1"
        CornerRadius="10"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border
            Grid.Row="0"
            Background="#FBFCFE"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0"
          >
            <Grid Margin="14,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{StaticResource HeaderText}"
                Text="プレビュー"
              />
              <Button
                Grid.Column="2"
                Style="{StaticResource SecondaryButton}"
                Content="HTML を保存"
                Command="{Binding SaveHtmlCommand}"
              />
            </Grid>
          </Border>
          <local:MockPreviewPanel x:Name="Preview" Grid.Row="1" Margin="1" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── 第2ステップ: WPF モックプロジェクト生成（Claude Code 限定） ── -->
    <Border
      Grid.Row="1"
      Margin="0,12,0,0"
      Background="{StaticResource CardBg}"
      BorderBrush="{StaticResource Divider}"
      BorderThickness="1"
      CornerRadius="10"
    >
      <Expander Padding="14,10" IsExpanded="True">
        <Expander.Header>
          <TextBlock
            FontWeight="SemiBold"
            Foreground="{StaticResource HeaderText}"
            Text="WPF モックプロジェクトを生成（Claude Code）"
          />
        </Expander.Header>

        <StackPanel Margin="4,10,4,4">
          <!-- 出力フォルダ -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="出力フォルダ" />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              Margin="0,0,8,0"
              VerticalContentAlignment="Center"
              Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
              IsEnabled="{Binding CanEditMockGenInput}"
            />
            <Button
              Grid.Column="2"
              Style="{StaticResource SecondaryButton}"
              Content="参照..."
              Command="{Binding BrowseOutputFolderCommand}"
            />
          </Grid>

          <!-- プロジェクト名 -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="プロジェクト名" />
            <TextBox
              Grid.Column="1"
              Padding="6,4"
              VerticalContentAlignment="Center"
              Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
            />
          </Grid>

          <!-- 操作行: 生成／中断／フォルダを開く／案内 -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              Foreground="{StaticResource MutedText}"
              FontSize="12"
              TextWrapping="Wrap"
              Text="{Binding MockGenDisabledReason}"
            />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button
                Style="{StaticResource SecondaryButton}"
                Content="フォルダを開く"
                Margin="0,0,8,0"
                Command="{Binding OpenOutputFolderCommand}"
                Visibility="{Binding ShowOpenFolder, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Button
                Style="{StaticResource SecondaryButton}"
                Content="中断"
                Margin="0,0,8,0"
                Command="{Binding InterruptMockGenCommand}"
                Visibility="{Binding IsMockGenInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
              />
              <Button
                Style="{StaticResource PrimaryButton}"
                Width="150"
                Content="WPF モックを生成"
                Command="{Binding GenerateMockProjectCommand}"
                ToolTip="{Binding MockGenDisabledReason}"
              />
            </StackPanel>
          </Grid>

          <!-- 進捗ログ（読み取り専用・自動スクロール） -->
          <Border
            Margin="0,10,0,0"
            Height="150"
            Background="#0B1021"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsMockGenInProgress, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <ScrollViewer
              x:Name="MockGenLogScroll"
              Padding="10,8"
              VerticalScrollBarVisibility="Auto"
            >
              <TextBox
                Text="{Binding MockGenLog, Mode=OneWay}"
                IsReadOnly="True"
                BorderThickness="0"
                Background="Transparent"
                Foreground="#D6E2FF"
                FontFamily="Consolas, Cascadia Mono, monospace"
                FontSize="12"
                TextWrapping="Wrap"
              />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Expander>
    </Border>

    <!-- ステータスバー -->
    <TextBlock
      Grid.Row="2"
      Margin="4,10,0,0"
      Foreground="{StaticResource MutedText}"
      FontSize="12"
      TextWrapping="Wrap"
      Text="{Binding StatusMessage}"
    />
  </Grid>
</Window>

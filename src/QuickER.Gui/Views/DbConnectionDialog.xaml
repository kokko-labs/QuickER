<Window
  x:Class="QuickER.Views.DbConnectionDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:QuickER.ViewModels"
  xmlns:local="clr-namespace:QuickER.Views"
  xmlns:ui="clr-namespace:QuickER.AI.UI;assembly=QuickER.AI.UI"
  xmlns:prov="clr-namespace:QuickER.Provider;assembly=QuickER.Provider"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  Title="データベースに接続"
  Width="520"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
>
  <Window.Resources>
    <ObjectDataProvider x:Key="AuthModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="prov:DbAuthMode" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 保存済みプロファイル -->
    <TextBlock
      Grid.Row="0"
      Grid.Column="0"
      Text="保存済み接続"
      VerticalAlignment="Center"
      Margin="0,4"
    />
    <Grid Grid.Row="0" Grid.Column="1" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox
        ItemsSource="{Binding Profiles}"
        SelectedItem="{Binding SelectedProfileItem}"
        DisplayMemberPath="Display"
      />
      <Button
        Grid.Column="1"
        Margin="6,0,0,0"
        Width="60"
        Content="🗑 削除"
        Command="{Binding DeleteProfileCommand}"
        ToolTip="選択中のプロファイルを削除"
      />
    </Grid>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="保存名" VerticalAlignment="Center" Margin="0,4" />
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
      <Button
        Grid.Column="1"
        Margin="6,0,0,0"
        Width="60"
        Content="💾 保存"
        Command="{Binding SaveProfileCommand}"
        ToolTip="現在の入力内容を保存名で保存"
      />
    </Grid>

    <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="対象DB" VerticalAlignment="Center" Margin="0,4" />
    <ComboBox
      Grid.Row="3"
      Grid.Column="1"
      Margin="0,4"
      ItemsSource="{Binding Providers}"
      SelectedItem="{Binding SelectedProvider}"
      DisplayMemberPath="DisplayName"
      IsEnabled="{Binding CanSelectDbms}"
    />

    <!-- SQLite: データベースファイルのパス（参照ボタン付き。SQLite 選択時のみ表示） -->
    <TextBlock
      Grid.Row="4"
      Grid.Column="0"
      Text="ファイルパス"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowFilePath, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <Grid
      Grid.Row="4"
      Grid.Column="1"
      Margin="0,4"
      Visibility="{Binding ShowFilePath, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
      <Button
        Grid.Column="1"
        Margin="6,0,0,0"
        Width="70"
        Content="参照..."
        Command="{Binding BrowseFileCommand}"
        ToolTip="既存の SQLite データベースファイルを選択"
      />
    </Grid>

    <TextBlock
      Grid.Row="5"
      Grid.Column="0"
      Text="ホスト"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <TextBox
      Grid.Row="5"
      Grid.Column="1"
      Margin="0,4"
      Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
      Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock
      Grid.Row="6"
      Grid.Column="0"
      Text="ポート"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <TextBox
      Grid.Row="6"
      Grid.Column="1"
      Margin="0,4"
      Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="空欄の場合は方言の既定ポートを使用します"
      Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock
      Grid.Row="7"
      Grid.Column="0"
      Text="データベース"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <TextBox
      Grid.Row="7"
      Grid.Column="1"
      Margin="0,4"
      Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
      Visibility="{Binding ShowServerFields, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock
      Grid.Row="8"
      Grid.Column="0"
      Text="認証方式"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowAuthMode, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <ComboBox
      Grid.Row="8"
      Grid.Column="1"
      Margin="0,4"
      ItemsSource="{Binding Source={StaticResource AuthModes}}"
      SelectedItem="{Binding AuthMode}"
      Visibility="{Binding ShowAuthMode, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock
      Grid.Row="9"
      Grid.Column="0"
      Text="ユーザー名"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowUserId, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <TextBox
      Grid.Row="9"
      Grid.Column="1"
      Margin="0,4"
      Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
      Visibility="{Binding ShowUserId, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock
      Grid.Row="10"
      Grid.Column="0"
      Text="パスワード"
      VerticalAlignment="Center"
      Margin="0,4"
      Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibilityConverter}}"
    />
    <Grid
      Grid.Row="10"
      Grid.Column="1"
      Margin="0,4"
      Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <PasswordBox
        x:Name="PasswordBoxControl"
        ui:PasswordBoxBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      />
      <CheckBox
        Grid.Column="1"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Content="保存"
        IsChecked="{Binding SavePassword}"
        ToolTip="Windows DPAPI で暗号化してプロファイルとともに保存"
      />
    </Grid>

    <CheckBox
      Grid.Row="11"
      Grid.Column="1"
      Margin="0,8"
      IsChecked="{Binding TrustServerCertificate}"
      Content="サーバー証明書を信頼する (TrustServerCertificate)"
      Visibility="{Binding ShowTrustServerCertificate, Converter={StaticResource BoolToVisibilityConverter}}"
    />

    <TextBlock
      Grid.Row="12"
      Grid.ColumnSpan="2"
      Margin="0,6"
      TextWrapping="Wrap"
      Foreground="#374151"
      Text="{Binding StatusMessage}"
    />

    <StackPanel
      Grid.Row="13"
      Grid.ColumnSpan="2"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,8,0,0"
    >
      <Button
        Content="接続テスト"
        Width="100"
        Margin="0,0,8,0"
        Command="{Binding TestConnectionCommand}"
      />
      <Button
        Content="OK"
        Width="80"
        Margin="0,0,8,0"
        IsDefault="True"
        Command="{Binding OkCommand}"
      />
      <Button Content="キャンセル" Width="80" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>

<Window
  x:Class="QuickER.Views.PrintOptionsDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:resources="clr-namespace:QuickER.Resources"
  Title="{x:Static resources:Strings.Print_Title}"
  Width="420"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="{DynamicResource WindowBackground}"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色・ボタン・入力欄の共通スタイルは共有テーマ辞書から取り込む -->
        <ResourceDictionary Source="pack://application:,,,/QuickER.Gui.Common;component/Themes/DialogTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="14">
    <TextBlock Text="{x:Static resources:Strings.Print_DiagramTitle}" Margin="0,0,0,4" />
    <TextBox x:Name="TitleTextBox" Style="{StaticResource FormInput}" />

    <TextBlock
      Text="{x:Static resources:Strings.Print_SizeSection}"
      Margin="0,14,0,4"
      FontWeight="SemiBold"
    />
    <RadioButton x:Name="FitToPageRadio" IsChecked="True" Margin="0,4">
      <TextBlock Text="{x:Static resources:Strings.Print_FitToPage}" TextWrapping="Wrap" />
    </RadioButton>
    <RadioButton x:Name="ActualSizeRadio" Margin="0,4">
      <TextBlock Text="{x:Static resources:Strings.Print_ActualSize}" TextWrapping="Wrap" />
    </RadioButton>

    <CheckBox x:Name="TimestampCheckBox" IsChecked="True" Margin="0,14,0,0">
      <TextBlock Text="{x:Static resources:Strings.Print_Timestamp}" TextWrapping="Wrap" />
    </CheckBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button
        Content="OK"
        MinWidth="80"
        Margin="0,0,8,0"
        IsDefault="True"
        Style="{StaticResource PrimaryButton}"
        Click="OnOkClick"
      />
      <Button
        Content="{x:Static resources:Strings.Common_Cancel}"
        MinWidth="80"
        IsCancel="True"
        Style="{StaticResource SecondaryButton}"
      />
    </StackPanel>
  </StackPanel>
</Window>

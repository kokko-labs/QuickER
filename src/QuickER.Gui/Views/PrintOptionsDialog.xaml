<Window
  x:Class="QuickER.Views.PrintOptionsDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="印刷オプション"
  Width="420"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
>
  <StackPanel Margin="14">
    <TextBlock Text="図のタイトル" Margin="0,0,0,4" />
    <TextBox x:Name="TitleTextBox" Padding="4,3" />

    <TextBlock Text="印刷サイズ" Margin="0,14,0,4" FontWeight="SemiBold" />
    <RadioButton x:Name="FitToPageRadio" IsChecked="True" Margin="0,4">
      <TextBlock Text="用紙 1 ページに縮小して印刷" TextWrapping="Wrap" />
    </RadioButton>
    <RadioButton x:Name="ActualSizeRadio" Margin="0,4">
      <TextBlock
        Text="原寸大で印刷（用紙サイズを図の実寸に合わせる・PDF 出力向け）"
        TextWrapping="Wrap"
      />
    </RadioButton>

    <CheckBox x:Name="TimestampCheckBox" IsChecked="True" Margin="0,14,0,0">
      <TextBlock Text="印刷日時をヘッダに印字する" TextWrapping="Wrap" />
    </CheckBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
      <Button Content="キャンセル" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>

<Window
  x:Class="QuickER.Views.PrintOptionsDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:resources="clr-namespace:QuickER.Resources"
  Title="{x:Static resources:Strings.Print_Title}"
  Width="420"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
>
  <StackPanel Margin="14">
    <TextBlock Text="{x:Static resources:Strings.Print_DiagramTitle}" Margin="0,0,0,4" />
    <TextBox x:Name="TitleTextBox" Padding="4,3" />

    <TextBlock
      Text="{x:Static resources:Strings.Print_SizeSection}"
      Margin="0,14,0,4"
      FontWeight="SemiBold"
    />
    <RadioButton x:Name="FitToPageRadio" IsChecked="True" Margin="0,4">
      <TextBlock Text="{x:Static resources:Strings.Print_FitToPage}" TextWrapping="Wrap" />
    </RadioButton>
    <RadioButton x:Name="ActualSizeRadio" Margin="0,4">
      <TextBlock Text="{x:Static resources:Strings.Print_ActualSize}" TextWrapping="Wrap" />
    </RadioButton>

    <CheckBox x:Name="TimestampCheckBox" IsChecked="True" Margin="0,14,0,0">
      <TextBlock Text="{x:Static resources:Strings.Print_Timestamp}" TextWrapping="Wrap" />
    </CheckBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
      <Button Content="{x:Static resources:Strings.Common_Cancel}" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>

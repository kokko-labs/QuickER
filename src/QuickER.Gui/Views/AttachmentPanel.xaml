<UserControl
  x:Class="QuickER.Views.AttachmentPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:QuickER.Converters"
  xmlns:vm="clr-namespace:QuickER.ViewModels"
  xmlns:local="clr-namespace:QuickER.Views"
  x:Name="Root"
  d:DesignHeight="80"
  d:DesignWidth="400"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
>
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <SolidColorBrush x:Key="Divider" Color="#E5E7EB" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="ChipBg" Color="#F1F5F9" />

    <!-- クリップ（添付追加）ボタン: 丸みのあるアイコンボタン -->
    <Style x:Key="ClipButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="White"
              BorderBrush="{StaticResource Divider}"
              BorderThickness="1"
              CornerRadius="10"
            >
              <TextBlock
                Text="📎"
                FontSize="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel DataContext="{Binding AttachmentList, ElementName=Root}">
    <!-- 添付チップ列（画像はサムネイル＋名前・PDF はアイコン＋名前・× で削除）。折返し横並び -->
    <ItemsControl
      ItemsSource="{Binding Items}"
      Margin="0,0,0,6"
      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PendingAttachmentItem}">
          <Border
            Margin="0,0,6,6"
            Padding="6,4"
            Background="{StaticResource ChipBg}"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="1"
            CornerRadius="8"
          >
            <StackPanel Orientation="Horizontal">
              <!-- 画像サムネイル -->
              <Border
                Width="28"
                Height="28"
                Margin="0,0,6,0"
                CornerRadius="4"
                ClipToBounds="True"
                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibilityConverter}}"
              >
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
              </Border>
              <!-- 非画像アイコン（PDF=📄・テキスト=📃・バイナリ=📦。種別で切替） -->
              <TextBlock
                Text="{Binding KindIcon}"
                FontSize="16"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
              >
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsImage}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock
                Text="{Binding FileName}"
                VerticalAlignment="Center"
                MaxWidth="180"
                TextTrimming="CharacterEllipsis"
                Foreground="#374151"
                FontSize="12"
                ToolTip="{Binding FileName}"
              />
              <!-- × 削除ボタン -->
              <Button
                Margin="6,0,0,0"
                Padding="0"
                Width="18"
                Height="18"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0"
                Content="✕"
                FontSize="11"
                Foreground="{StaticResource MutedText}"
                Command="{Binding AttachmentList.RemoveCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                ToolTip="削除"
              />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- クリップボタン（添付追加）。非対応時は無効化＋理由ツールチップ -->
    <Button
      x:Name="AttachButton"
      HorizontalAlignment="Left"
      Style="{StaticResource ClipButton}"
      IsEnabled="{Binding IsEnabled}"
      Click="AttachButton_Click"
      ToolTip="{Binding ButtonTooltip}"
    />
  </StackPanel>
</UserControl>

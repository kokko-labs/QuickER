<Application
  x:Class="QuickER.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:QuickER"
  ShutdownMode="OnMainWindowClose"
>
  <!--
    ShutdownMode: 既定の OnLastWindowClose では、AI チャット・モック生成のモードレスウィンドウ
    （× で閉じず Hide する）が終了処理の失敗で閉じ残ったとき、見えるウィンドウが 1 つも無いまま
    プロセスが残る（タスクマネージャーでしか終わらせられない）。メインウィンドウが閉じた時点で
    終了させ、残ったウィンドウは Application.Shutdown に閉じさせる。
    モジュールの後始末は Closing の中で走り終えているので、この時点で待つものは無い。
  -->
  <Application.Resources>
    <ResourceDictionary xmlns:conv="clr-namespace:QuickER.Converters">
      <SolidColorBrush x:Key="EntityBorderBrush" Color="#8AB4F8" />
      <SolidColorBrush x:Key="EntityHeaderBrush" Color="#E8F0FE" />
      <SolidColorBrush x:Key="EntitySelectedBrush" Color="#1A73E8" />
      <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FAFAFA" />
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <conv:NullToBooleanConverter x:Key="NullToBooleanConverter" />
      <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>

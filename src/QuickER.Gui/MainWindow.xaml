<Window
  x:Class="QuickER.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:QuickER.ViewModels"
  xmlns:models="clr-namespace:QuickER.Model;assembly=QuickER.Model"
  xmlns:beh="clr-namespace:QuickER.Behaviors"
  xmlns:views="clr-namespace:QuickER.Views"
  xmlns:resources="clr-namespace:QuickER.Resources"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="{Binding WindowTitle, FallbackValue=QuickER}"
  Height="1000"
  Width="1880"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
  d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
>
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDiagramCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedEntityCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCopiedEntityCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateSelectedEntityCommand}" />
    <!-- 全選択（Ctrl+A）／選択解除（Esc）。TextBox フォーカス中は各コントロールの標準動作が優先される -->
    <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllEntitiesCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintDiagramCommand}" />

    <!-- ズーム: Ctrl+0=100% / Ctrl+Shift+0=fit / Ctrl+Plus・Minus でズーム（OemPlus/Add・OemMinus/Subtract 両対応） -->
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    <KeyBinding Key="D0" Modifiers="Control+Shift" Command="{Binding FitToWindowCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBg" Color="#FAFBFD" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="HeaderText" Color="#374151" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="EntityHeaderBlue" Color="#DCEBFF" />
    <SolidColorBrush x:Key="EntityBorder" Color="#9DB7DD" />
    <SolidColorBrush x:Key="EntityBorderSelected" Color="#1A73E8" />
    <SolidColorBrush x:Key="LineBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="LineSelectedBrush" Color="#1A73E8" />

    <Style x:Key="ToolBarLabelButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- 幅は固定せず MinWidth とし、英語など長いキャプションでもボタンが伸びて文字が切れないようにする -->
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolBarLabelToggleButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- 幅は固定せず MinWidth とし、英語など長いキャプションでもボタンが伸びて文字が切れないようにする -->
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#DCE7F5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolBarIcon" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#374151" />
    </Style>
    <Style x:Key="ToolBarCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ステータスバー右端のズームコントロール用の小ぶりなボタン -->
    <Style x:Key="ZoomControlButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ステータスバー右端のズームコントロールと同トーンの小ぶりなトグルボタン（ミニマップ表示切替用） -->
    <Style x:Key="ZoomControlToggleButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#DCE7F5" />
                <Setter Property="Foreground" Value="#1A73E8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  ツールバー区切り線  -->
    <Style x:Key="ToolBarSeparator" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="#D1D5DB" />
      <Setter Property="Margin" Value="6,6" />
    </Style>

    <Style x:Key="ToolboxItemButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="10"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF4FF" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolboxSectionCard" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ToolboxSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="ToolboxItemIcon" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="ToolboxItemTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PropertyCard" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PropertyCardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PropertyFieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="PropertyHintText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PropertyInputTextBox" TargetType="TextBox">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PropertyInputComboBox" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PropertyIconButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PropertyDangerButton" TargetType="Button">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="#FFF1F2" />
      <Setter Property="BorderBrush" Value="#FBCDD3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#B42318" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="PropertyDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PropertyDataGridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#EEF4FF" />
          <Setter Property="Foreground" Value="#111827" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PropertyDataGridCheckBox" TargetType="CheckBox">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PropertyDataGridTextDisplay" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style
      x:Key="PropertyDataGridTextEditor"
      TargetType="TextBox"
      BasedOn="{StaticResource PropertyInputTextBox}"
    >
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PropertyDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5" />
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource PropertyDataGridColumnHeader}" />
      <Setter Property="CellStyle" Value="{StaticResource PropertyDataGridCell}" />
      <Setter Property="HeadersVisibility" Value="All" />
      <Setter Property="RowHeaderWidth" Value="22" />
    </Style>

    <!-- リレーション線本体のスタイル: 選択時に青く太く、関連ハイライト時に軽く強調 -->
    <Style x:Key="RelationLineStyle" TargetType="Line">
      <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Style.Triggers>
        <!-- 関連ハイライトの強調（選択エンティティに接続された線）: 既定より強く、選択の青より弱い -->
        <!-- IsSelected を後段に置き、選択リレーションの青 2.5 が後勝ちで優先されるようにする -->
        <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
          <Setter Property="Stroke" Value="#374151" />
          <Setter Property="StrokeThickness" Value="2.2" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Stroke" Value="{StaticResource LineSelectedBrush}" />
          <Setter Property="StrokeThickness" Value="2.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- マーカー共通スタイル（選択時は線と同様に青へ DataContext は MarkerKind enum のため親 ContentControl 経由で参照） -->
    <Style x:Key="MarkerStrokeStyle" TargetType="Shape">
      <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
      <Setter Property="StrokeThickness" Value="2.2" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger
          Binding="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=ContentControl}}"
          Value="True"
        >
          <Setter Property="Stroke" Value="{StaticResource LineSelectedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- リレーション端点マーカー (One: 縦棒, Many: 鳥の足) のテンプレート -->
    <!-- ローカル X = 24 がエンティティ境界に一致するよう配置・回転され、鳥の足の先端が枠に接地する -->
    <DataTemplate x:Key="EndpointMarkerTemplate">
      <!-- DataContext = MarkerKind enum -->
      <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
        <!-- One: |─ (縦棒) -->
        <Line X1="12" Y1="3" X2="12" Y2="21">
          <Line.Style>
            <Style TargetType="Line" BasedOn="{StaticResource MarkerStrokeStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="One">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Line.Style>
        </Line>
        <!-- Many: 鳥の足 (先端 X=24 がエンティティ枠に接地) -->
        <Path Data="M 6,12 L 24,3 M 6,12 L 24,12 M 6,12 L 24,21">
          <Path.Style>
            <Style TargetType="Path" BasedOn="{StaticResource MarkerStrokeStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="Many">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- 上部: ツールバー -->
    <Border
      DockPanel.Dock="Top"
      Background="{StaticResource PanelBg}"
      BorderBrush="{StaticResource DividerBrush}"
      BorderThickness="0,0,0,1"
    >
      <StackPanel Orientation="Horizontal" Margin="6,4">
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding NewDiagramCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_NewTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="🗒" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_New}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding OpenCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_OpenTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="📂" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Open}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding SaveCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_SaveTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="💾" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Save}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding UndoCommand}"
          IsEnabled="{Binding UndoRedo.CanUndo}"
          ToolTip="{x:Static resources:Strings.Toolbar_UndoTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="↶" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Undo}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding RedoCommand}"
          IsEnabled="{Binding UndoRedo.CanRedo}"
          ToolTip="{x:Static resources:Strings.Toolbar_RedoTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="↷" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Redo}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding DuplicateSelectedEntityCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_DuplicateTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="❏" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Duplicate}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <ToggleButton
          Style="{StaticResource ToolBarLabelToggleButton}"
          IsChecked="{Binding ShowColumnDescriptionsInDiagram, Mode=TwoWay}"
          ToolTip="{x:Static resources:Strings.Toolbar_ShowDescriptionsTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="💬" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_ShowDescriptions}"
            />
          </StackPanel>
        </ToggleButton>
        <ToggleButton
          Style="{StaticResource ToolBarLabelToggleButton}"
          IsChecked="{Binding ShowNullabilityInDiagram, Mode=TwoWay}"
          ToolTip="{x:Static resources:Strings.Toolbar_ShowNullabilityTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="∅" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_ShowNullability}"
            />
          </StackPanel>
        </ToggleButton>
        <ToggleButton
          Style="{StaticResource ToolBarLabelToggleButton}"
          IsChecked="{Binding IsCompactViewInDiagram, Mode=TwoWay}"
          ToolTip="{x:Static resources:Strings.Toolbar_CompactViewTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="▤" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_CompactView}"
            />
          </StackPanel>
        </ToggleButton>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding AutoLayoutGridCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_ArrangeGridTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="▦" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_ArrangeGrid}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding AutoLayoutTreeCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_ArrangeTreeTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="⌬" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_ArrangeTree}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding AutoLayoutForceCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_ArrangeForceTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="✺" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_ArrangeForce}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding AutoFitEntityWidthsCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_AutoWidthTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="↔" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_AutoWidth}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding PrintDiagramCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_PrintTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="🖨" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Print}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding ExportDiagramCommand}"
          CommandParameter="{Binding ElementName=DiagramCanvas}"
          ToolTip="{x:Static resources:Strings.Toolbar_ExportTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="📤" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Export}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding ImportDiagramCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_ImportTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="📥" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_Import}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
          <TextBlock
            Text="{x:Static resources:Strings.Toolbar_TargetDbLabel}"
            VerticalAlignment="Center"
            Foreground="#374151"
            Margin="0,0,4,0"
          />
          <ComboBox
            MinWidth="120"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Padding="6,3"
            Background="White"
            BorderBrush="#D1D5DB"
            ItemsSource="{Binding AvailableProviders}"
            SelectedItem="{Binding SelectedProvider}"
            DisplayMemberPath="DisplayName"
            ToolTip="{x:Static resources:Strings.Toolbar_TargetDbTooltip}"
          />
        </StackPanel>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding ImportFromDatabaseCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_ImportFromDbTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="🛢" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_ImportFromDb}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding SyncToDatabaseCommand}"
          ToolTip="{Binding SyncToDatabaseTooltip}"
          ToolTipService.ShowOnDisabled="True"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="⇪" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_SyncToDb}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <!--
          フィーチャーモジュールが寄与するツールバーボタン群（AI チャット・モック生成など）。
          モジュール 0 個のときは何も描画されず、直後のセパレータも下の DataTrigger で畳まれる。
        -->
        <ItemsControl ItemsSource="{Binding FeatureToolbarItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                Style="{StaticResource ToolBarLabelButton}"
                Command="{Binding Command}"
                ToolTip="{Binding Tooltip}"
              >
                <StackPanel>
                  <TextBlock Style="{StaticResource ToolBarIcon}" Text="{Binding Icon}" />
                  <TextBlock Style="{StaticResource ToolBarCaption}" Text="{Binding Label}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- モジュールが 1 つも無いときはセパレータの二重表示を避けて畳む -->
        <Rectangle>
          <Rectangle.Style>
            <Style TargetType="Rectangle" BasedOn="{StaticResource ToolBarSeparator}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding FeatureToolbarItems.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Rectangle.Style>
        </Rectangle>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding GenerateCSharpCodeCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_GenerateCSharpTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="⌘" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_GenerateCSharp}"
            />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource ToolBarLabelButton}"
          Command="{Binding OpenQueryDefinitionsCommand}"
          ToolTip="{x:Static resources:Strings.Toolbar_QueryDefinitionsTooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="🔎" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Toolbar_QueryDefinitions}"
            />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource ToolBarSeparator}" />
        <!--
          言語切替: クリックで ContextMenu（日本語 / English）を開く。選択で設定を保存し、
          再起動反映方式のため「再起動後に反映」を通知する。キャプション・ツールチップは resx 参照。
          ContextMenu は配置対象の DataContext（MainViewModel）を引き継いでチェック状態を束縛する。
        -->
        <Button
          x:Name="LanguageButton"
          Style="{StaticResource ToolBarLabelButton}"
          Click="LanguageButton_Click"
          ToolTip="{x:Static resources:Strings.Language_Tooltip}"
        >
          <StackPanel>
            <TextBlock Style="{StaticResource ToolBarIcon}" Text="🌐" />
            <TextBlock
              Style="{StaticResource ToolBarCaption}"
              Text="{x:Static resources:Strings.Language_Caption}"
            />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem
                Header="{x:Static resources:Strings.Language_English}"
                IsCheckable="True"
                IsChecked="{Binding LanguageSwitch.IsEnglishChecked, Mode=OneWay}"
                Command="{Binding LanguageSwitch.SelectLanguageCommand}"
                CommandParameter="en"
              />
              <MenuItem
                Header="{x:Static resources:Strings.Language_Japanese}"
                IsCheckable="True"
                IsChecked="{Binding LanguageSwitch.IsJapaneseChecked, Mode=OneWay}"
                Command="{Binding LanguageSwitch.SelectLanguageCommand}"
                CommandParameter="ja"
              />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Border>

    <!-- 下部: ステータスバー -->
    <Border
      DockPanel.Dock="Bottom"
      Background="{StaticResource PanelBg}"
      BorderBrush="{StaticResource DividerBrush}"
      BorderThickness="0,1,0,0"
      Padding="10,4"
    >
      <DockPanel>
        <TextBlock
          DockPanel.Dock="Left"
          Text="{x:Static resources:Strings.Status_Ready}"
          Foreground="{StaticResource MutedText}"
        />

        <!-- 右端: ズームコントロール（− / 倍率表示（クリックで 100%）/ ＋ / fit） -->
        <StackPanel
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Margin="16,0,0,0"
        >
          <ToggleButton
            Style="{StaticResource ZoomControlToggleButton}"
            IsChecked="{Binding IsMiniMapEnabled, Mode=TwoWay}"
            Content="⊞"
            ToolTip="{x:Static resources:Strings.Status_MiniMapTooltip}"
          />
          <Rectangle Style="{StaticResource ToolBarSeparator}" Margin="4,3" />
          <Button
            Style="{StaticResource ZoomControlButton}"
            Command="{Binding ZoomOutCommand}"
            Content="−"
            ToolTip="{x:Static resources:Strings.Status_ZoomOutTooltip}"
          />
          <Button
            Style="{StaticResource ZoomControlButton}"
            Command="{Binding ResetZoomCommand}"
            Content="{Binding ZoomPercentText}"
            MinWidth="44"
            ToolTip="{x:Static resources:Strings.Status_ZoomResetTooltip}"
          />
          <Button
            Style="{StaticResource ZoomControlButton}"
            Command="{Binding ZoomInCommand}"
            Content="＋"
            ToolTip="{x:Static resources:Strings.Status_ZoomInTooltip}"
          />
          <Button
            Style="{StaticResource ZoomControlButton}"
            Command="{Binding FitToWindowCommand}"
            Content="⛶"
            ToolTip="{x:Static resources:Strings.Status_FitTooltip}"
          />
        </StackPanel>

        <TextBlock
          DockPanel.Dock="Right"
          HorizontalAlignment="Right"
          Foreground="{StaticResource MutedText}"
        >
          <Run Text="{x:Static resources:Strings.Status_EntitiesLabel}" />
          <Run Text="{Binding Entities.Count, Mode=OneWay}" />
          <Run Text="{x:Static resources:Strings.Status_RelationshipsLabel}" />
          <Run Text="{Binding Relationships.Count, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="560" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- GridSplitter: ER図とプロパティパネルの境界ドラッグ -->
      <GridSplitter
        Grid.Column="2"
        Width="5"
        HorizontalAlignment="Stretch"
        Background="{StaticResource DividerBrush}"
        Cursor="SizeWE"
      />

      <!-- 左: ツールボックス -->
      <Border
        Grid.Column="0"
        Background="{StaticResource SidebarBg}"
        BorderBrush="{StaticResource DividerBrush}"
        BorderThickness="0,0,1,0"
      >
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,10,12,12">
            <TextBlock
              Text="{x:Static resources:Strings.Toolbox_Title}"
              FontWeight="Bold"
              Foreground="{StaticResource HeaderText}"
              Margin="0,0,0,10"
            />

            <Border Style="{StaticResource ToolboxSectionCard}">
              <StackPanel>
                <TextBlock
                  Text="{x:Static resources:Strings.Toolbox_EntitySection}"
                  Style="{StaticResource ToolboxSectionTitle}"
                />
                <Button
                  Style="{StaticResource ToolboxItemButton}"
                  Command="{Binding AddEntityCommand}"
                  ToolTip="{x:Static resources:Strings.Toolbox_AddEntityTooltip}"
                >
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▭" Style="{StaticResource ToolboxItemIcon}" />
                    <TextBlock
                      Text="{x:Static resources:Strings.Toolbox_AddEntity}"
                      Style="{StaticResource ToolboxItemTitle}"
                      VerticalAlignment="Center"
                    />
                  </StackPanel>
                </Button>
                <Button
                  Style="{StaticResource ToolboxItemButton}"
                  Command="{Binding RemoveSelectedEntityCommand}"
                  ToolTip="{x:Static resources:Strings.Toolbox_RemoveEntityTooltip}"
                >
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" Style="{StaticResource ToolboxItemIcon}" />
                    <TextBlock
                      Text="{x:Static resources:Strings.Toolbox_RemoveEntity}"
                      Style="{StaticResource ToolboxItemTitle}"
                      VerticalAlignment="Center"
                    />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolboxSectionCard}">
              <StackPanel>
                <TextBlock
                  Text="{x:Static resources:Strings.Toolbox_RelationshipSection}"
                  Style="{StaticResource ToolboxSectionTitle}"
                />
                <Button
                  Style="{StaticResource ToolboxItemButton}"
                  Command="{Binding StartAddOneToOneCommand}"
                  ToolTip="{x:Static resources:Strings.Toolbox_OneToOneTooltip}"
                >
                  <!-- アイコンを左固定し、タイトルは残り幅で折り返す（英語など長いラベルの切れを防ぐ） -->
                  <DockPanel>
                    <TextBlock
                      Text="│─│"
                      Style="{StaticResource ToolboxItemIcon}"
                      DockPanel.Dock="Left"
                    />
                    <TextBlock
                      Text="{x:Static resources:Strings.Toolbox_OneToOne}"
                      Style="{StaticResource ToolboxItemTitle}"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                    />
                  </DockPanel>
                </Button>
                <Button
                  Style="{StaticResource ToolboxItemButton}"
                  Command="{Binding StartAddOneToManyCommand}"
                  ToolTip="{x:Static resources:Strings.Toolbox_OneToManyTooltip}"
                >
                  <!-- アイコンを左固定し、タイトルは残り幅で折り返す（英語など長いラベルの切れを防ぐ） -->
                  <DockPanel>
                    <TextBlock
                      Text="│─≪"
                      Style="{StaticResource ToolboxItemIcon}"
                      DockPanel.Dock="Left"
                    />
                    <TextBlock
                      Text="{x:Static resources:Strings.Toolbox_OneToMany}"
                      Style="{StaticResource ToolboxItemTitle}"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                    />
                  </DockPanel>
                </Button>
                <Button
                  Style="{StaticResource ToolboxItemButton}"
                  Command="{Binding StartAddManyToManyCommand}"
                  ToolTip="{x:Static resources:Strings.Toolbox_ManyToManyTooltip}"
                >
                  <!-- アイコンを左固定し、タイトルは残り幅で折り返す（英語など長いラベルの切れを防ぐ） -->
                  <DockPanel>
                    <TextBlock
                      Text="≫─≪"
                      Style="{StaticResource ToolboxItemIcon}"
                      DockPanel.Dock="Left"
                    />
                    <TextBlock
                      Text="{x:Static resources:Strings.Toolbox_ManyToMany}"
                      Style="{StaticResource ToolboxItemTitle}"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                    />
                  </DockPanel>
                </Button>
                <Button
                  Style="{StaticResource ToolboxItemButton}"
                  Command="{Binding RemoveSelectedRelationshipCommand}"
                  ToolTip="{x:Static resources:Strings.Toolbox_RemoveRelationshipTooltip}"
                >
                  <!-- アイコンを左固定し、タイトルは残り幅で折り返す（英語など長いラベルの切れを防ぐ） -->
                  <DockPanel>
                    <TextBlock
                      Text="🗑"
                      Style="{StaticResource ToolboxItemIcon}"
                      DockPanel.Dock="Left"
                    />
                    <TextBlock
                      Text="{x:Static resources:Strings.Toolbox_RemoveRelationship}"
                      Style="{StaticResource ToolboxItemTitle}"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                    />
                  </DockPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border
              Margin="0,12,0,0"
              Padding="8"
              CornerRadius="4"
              Background="#FFF7E0"
              Visibility="{Binding IsRelationshipMode, Converter={StaticResource BoolToVisibilityConverter}}"
            >
              <StackPanel>
                <TextBlock
                  TextWrapping="Wrap"
                  Foreground="#7A5F00"
                  FontSize="11"
                  Text="{x:Static resources:Strings.Toolbox_RelationshipModeHint}"
                />
                <Button
                  Margin="0,6,0,0"
                  Content="{x:Static resources:Strings.Common_Cancel}"
                  Command="{Binding CancelRelationshipModeCommand}"
                />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 中央: キャンバス -->
      <Border Grid.Column="1" Background="#F2F4F8">
        <Border.Resources>
          <DrawingBrush
            x:Key="GridBrush"
            TileMode="Tile"
            Viewport="0,0,20,20"
            ViewportUnits="Absolute"
          >
            <DrawingBrush.Drawing>
              <GeometryDrawing>
                <GeometryDrawing.Pen>
                  <Pen Brush="#E2E6EC" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                  <GeometryGroup>
                    <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                    <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                  </GeometryGroup>
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Resources>

        <!--
          キャンバス本体と検索オーバーレイを同一 Grid に重ねる。
          DiagramScrollViewer / DiagramZoomHost / DiagramCanvas の入れ子構造・名前は
          PNG 出力とズームが依存するため変更しない。
        -->
        <Grid>
          <ScrollViewer
            x:Name="DiagramScrollViewer"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Focusable="True"
            beh:CanvasViewportBehavior.IsEnabled="True"
            ScrollChanged="DiagramScrollViewer_ScrollChanged"
          >
            <!--
            ズーム用ラッパー: LayoutTransform(ScaleTransform) をこの外側 Grid に掛ける。
            DiagramCanvas 自体は無変換のまま保ち、PNG 出力（ExportDiagramCommand）が
            ズーム倍率の影響を受けないようにする。LayoutTransform なので ScrollViewer の
            スクロール範囲は自動追従し、DragBehavior のヒットテストも無改修で成立する。
          -->
            <Grid x:Name="DiagramZoomHost">
              <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
              </Grid.LayoutTransform>
              <Grid
                x:Name="DiagramCanvas"
                Width="{Binding CanvasWidth}"
                Height="{Binding CanvasHeight}"
                Background="{StaticResource GridBrush}"
                beh:RubberBandBehavior.IsEnabled="True"
              >
                <Grid.InputBindings>
                  <MouseBinding MouseAction="LeftClick" Command="{Binding CanvasClickCommand}" />
                </Grid.InputBindings>

                <!-- リレーションレイヤ -->
                <ItemsControl ItemsSource="{Binding Relationships}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RelationshipViewModel}">
                      <!-- 関連ハイライトの減光: 選択に無関係なリレーション（線・マーカー・ラベル・自己ループ）をまとめて減光する -->
                      <Canvas>
                        <Canvas.Style>
                          <Style TargetType="Canvas">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Canvas.Style>
                        <!-- 線本体 (太いヒット領域 + 見た目) -->
                        <Line
                          X1="{Binding X1}"
                          Y1="{Binding Y1}"
                          X2="{Binding X2}"
                          Y2="{Binding Y2}"
                          Stroke="Transparent"
                          StrokeThickness="14"
                          Cursor="Hand"
                        >
                          <Line.Style>
                            <Style TargetType="Line">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSelfLoop}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Line.Style>
                          <Line.InputBindings>
                            <MouseBinding
                              MouseAction="LeftClick"
                              Command="{Binding DataContext.RelationshipClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                            />
                          </Line.InputBindings>
                        </Line>
                        <Line
                          X1="{Binding X1}"
                          Y1="{Binding Y1}"
                          X2="{Binding X2}"
                          Y2="{Binding Y2}"
                          IsHitTestVisible="False"
                        >
                          <Line.Style>
                            <Style TargetType="Line" BasedOn="{StaticResource RelationLineStyle}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSelfLoop}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Line.Style>
                        </Line>

                        <Ellipse
                          Canvas.Left="{Binding SelfLoopLeft}"
                          Canvas.Top="{Binding SelfLoopTop}"
                          Width="{Binding SelfLoopWidth}"
                          Height="{Binding SelfLoopHeight}"
                          Stroke="Transparent"
                          StrokeThickness="14"
                          Cursor="Hand"
                        >
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSelfLoop}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                          <Ellipse.InputBindings>
                            <MouseBinding
                              MouseAction="LeftClick"
                              Command="{Binding DataContext.RelationshipClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                            />
                          </Ellipse.InputBindings>
                        </Ellipse>
                        <Ellipse
                          Canvas.Left="{Binding SelfLoopLeft}"
                          Canvas.Top="{Binding SelfLoopTop}"
                          Width="{Binding SelfLoopWidth}"
                          Height="{Binding SelfLoopHeight}"
                          Fill="Transparent"
                          IsHitTestVisible="False"
                        >
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
                              <Setter Property="StrokeThickness" Value="1.6" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSelfLoop}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- 関連ハイライトの強調（自己ループ）: 線本体と同水準に揃える。IsSelected を後段に置き青が後勝ちで優先されるようにする -->
                                <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
                                  <Setter Property="Stroke" Value="#374151" />
                                  <Setter Property="StrokeThickness" Value="2.2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter
                                    Property="Stroke"
                                    Value="{StaticResource LineSelectedBrush}"
                                  />
                                  <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>

                        <!-- 起点マーカー -->
                        <ContentControl
                          Canvas.Left="{Binding SourceMarkerLeft}"
                          Canvas.Top="{Binding SourceMarkerTop}"
                          Width="24"
                          Height="24"
                          Content="{Binding SourceMarker}"
                          ContentTemplate="{StaticResource EndpointMarkerTemplate}"
                          IsHitTestVisible="False"
                        >
                          <ContentControl.Style>
                            <Style TargetType="ContentControl">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEndpointMarkers}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ContentControl.Style>
                          <ContentControl.RenderTransform>
                            <RotateTransform
                              Angle="{Binding SourceMarkerAngle}"
                              CenterX="12"
                              CenterY="12"
                            />
                          </ContentControl.RenderTransform>
                        </ContentControl>

                        <!-- 終点マーカー -->
                        <ContentControl
                          Canvas.Left="{Binding TargetMarkerLeft}"
                          Canvas.Top="{Binding TargetMarkerTop}"
                          Width="24"
                          Height="24"
                          Content="{Binding TargetMarker}"
                          ContentTemplate="{StaticResource EndpointMarkerTemplate}"
                          IsHitTestVisible="False"
                        >
                          <ContentControl.Style>
                            <Style TargetType="ContentControl">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEndpointMarkers}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ContentControl.Style>
                          <ContentControl.RenderTransform>
                            <RotateTransform
                              Angle="{Binding TargetMarkerAngle}"
                              CenterX="12"
                              CenterY="12"
                            />
                          </ContentControl.RenderTransform>
                        </ContentControl>

                        <!-- ラベル -->
                        <Border
                          CornerRadius="3"
                          Padding="4,1"
                          Background="White"
                          BorderBrush="#9AA0A6"
                          BorderThickness="1"
                          Canvas.Left="{Binding LabelX}"
                          Canvas.Top="{Binding LabelY}"
                          Cursor="Hand"
                        >
                          <Border.RenderTransform>
                            <TranslateTransform X="-15" Y="-9" />
                          </Border.RenderTransform>
                          <Border.InputBindings>
                            <MouseBinding
                              MouseAction="LeftClick"
                              Command="{Binding DataContext.RelationshipClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                            />
                          </Border.InputBindings>
                          <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#374151" />
                        </Border>
                      </Canvas>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- エンティティレイヤ -->
                <ItemsControl ItemsSource="{Binding Entities}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding X}" />
                      <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EntityViewModel}">
                      <!-- EntityCardBorder: UIA へは単一要素として露出（大きい図で常駐 UIA クライアントの走査が UI を固めるのを防ぐ） -->
                      <views:EntityCardBorder
                        Width="{Binding Width}"
                        Background="White"
                        CornerRadius="6"
                        beh:DragBehavior.IsEnabled="True"
                        beh:DragBehavior.UndoRedoManager="{Binding DataContext.UndoRedo, RelativeSource={RelativeSource AncestorType=Window}}"
                      >
                        <Border.Effect>
                          <DropShadowEffect
                            Color="#88AABB"
                            BlurRadius="6"
                            ShadowDepth="1"
                            Opacity="0.35"
                          />
                        </Border.Effect>
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource EntityBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                              <!-- 関連ハイライトの減光: 選択に無関係なエンティティの不透明度を下げる -->
                              <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter
                                  Property="BorderBrush"
                                  Value="{StaticResource EntityBorderSelected}"
                                />
                                <Setter Property="BorderThickness" Value="2" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <Border
                            Background="{Binding TitleBackgroundColor}"
                            CornerRadius="6,6,0,0"
                            Padding="10,6"
                          >
                            <StackPanel>
                              <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#1F2937"
                                Text="{Binding TableName}"
                              />
                              <TextBlock
                                Text="{Binding Description}"
                                Foreground="#6B7280"
                                FontStyle="Italic"
                                FontSize="11"
                                TextWrapping="Wrap"
                              >
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition
                                            Binding="{Binding DataContext.ShowColumnDescriptionsInDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Value="True"
                                          />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                      </MultiDataTrigger>
                                      <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Columns}" Margin="6,4,6,6">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Margin="0,2">
                                  <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                      <Setter Property="Visibility" Value="Visible" />
                                      <Style.Triggers>
                                        <!-- 簡易表示中は PK/FK 以外のカラム行を非表示にする（PK でも FK でもないとき折りたたむ） -->
                                        <MultiDataTrigger>
                                          <MultiDataTrigger.Conditions>
                                            <Condition
                                              Binding="{Binding DataContext.IsCompactViewInDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Value="True"
                                            />
                                            <Condition
                                              Binding="{Binding IsPrimaryKey}"
                                              Value="False"
                                            />
                                            <Condition
                                              Binding="{Binding IsForeignKey}"
                                              Value="False"
                                            />
                                          </MultiDataTrigger.Conditions>
                                          <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </StackPanel.Style>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="34" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="Bold">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Text" Value="" />
                                          <Setter Property="Foreground" Value="#374151" />
                                          <Style.Triggers>
                                            <DataTrigger
                                              Binding="{Binding IsPrimaryKey}"
                                              Value="True"
                                            >
                                              <Setter Property="Text" Value="PK" />
                                              <Setter Property="Foreground" Value="#D93025" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition
                                                  Binding="{Binding IsPrimaryKey}"
                                                  Value="False"
                                                />
                                                <Condition
                                                  Binding="{Binding IsForeignKey}"
                                                  Value="True"
                                                />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Text" Value="FK" />
                                              <Setter Property="Foreground" Value="#1A73E8" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                      Grid.Column="1"
                                      Text="{Binding Name}"
                                      Foreground="#1F2937"
                                    />
                                    <TextBlock
                                      Grid.Column="2"
                                      Margin="0,0,8,0"
                                      Foreground="#6B7280"
                                    >
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Setter Property="Text" Value="" />
                                          <Style.Triggers>
                                            <DataTrigger
                                              Binding="{Binding DataContext.ShowNullabilityInDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Value="True"
                                            >
                                              <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition
                                                  Binding="{Binding DataContext.ShowNullabilityInDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Value="True"
                                                />
                                                <Condition
                                                  Binding="{Binding IsNullable}"
                                                  Value="True"
                                                />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Text" Value="NULL" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition
                                                  Binding="{Binding DataContext.ShowNullabilityInDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Value="True"
                                                />
                                                <Condition
                                                  Binding="{Binding IsNullable}"
                                                  Value="False"
                                                />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Text" Value="NOT NULL" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                      Grid.Column="3"
                                      Text="{Binding DataType}"
                                      Foreground="#6B7280"
                                    />
                                  </Grid>
                                  <TextBlock
                                    Text="{Binding Description}"
                                    Foreground="#6B7280"
                                    FontStyle="Italic"
                                    FontSize="11"
                                    Margin="34,0,0,0"
                                    TextWrapping="Wrap"
                                  >
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                              <Condition
                                                Binding="{Binding DataContext.ShowColumnDescriptionsInDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="True"
                                              />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                          </MultiDataTrigger>
                                          <DataTrigger Binding="{Binding Description}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                          <DataTrigger
                                            Binding="{Binding Description}"
                                            Value="{x:Null}"
                                          >
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </views:EntityCardBorder>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                  ラバーバンド（矩形選択）レイヤ: DiagramCanvas 内に描くため LayoutTransform（ズーム）へ
                  透過的に追従する。ヒットテストは無効（ドラッグ判定はビヘイビアが担う）。
                -->
                <Canvas IsHitTestVisible="False">
                  <Rectangle
                    Canvas.Left="{Binding RubberBandX}"
                    Canvas.Top="{Binding RubberBandY}"
                    Width="{Binding RubberBandWidth}"
                    Height="{Binding RubberBandHeight}"
                    Fill="#1A1A73E8"
                    Stroke="{StaticResource EntityBorderSelected}"
                    StrokeThickness="1"
                    StrokeDashArray="3 2"
                    Visibility="{Binding IsRubberBandVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  />
                </Canvas>
              </Grid>
            </Grid>
          </ScrollViewer>

          <!-- 検索オーバーレイ（Ctrl+F）: キャンバス右上に浮かべるカード。普段は非表示 -->
          <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,12,12,0"
            Width="300"
            Background="White"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10"
            Visibility="{Binding IsSearchOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <Border.Effect>
              <DropShadowEffect Color="#88AABB" BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
              <!-- 入力行: 検索ボックス + 件数表示 + 閉じるボタン -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                  Grid.Column="0"
                  x:Name="SearchTextBox"
                  Style="{StaticResource PropertyInputTextBox}"
                  MinHeight="30"
                  Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="{x:Static resources:Strings.Search_Tooltip}"
                  PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                >
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoToNextMatchCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding MatchCountText}"
                  VerticalAlignment="Center"
                  Margin="8,0,4,0"
                  Foreground="{StaticResource MutedText}"
                  FontSize="12"
                />
                <Button
                  Grid.Column="2"
                  Style="{StaticResource ZoomControlButton}"
                  Command="{Binding CloseSearchCommand}"
                  Content="✕"
                  ToolTip="{x:Static resources:Strings.Search_CloseTooltip}"
                />
              </Grid>

              <!-- 候補リスト: DisplayText を表示。クリックで該当エンティティへジャンプ -->
              <ListBox
                Margin="0,8,0,0"
                MaxHeight="200"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                ItemsSource="{Binding SearchResults}"
                SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                DisplayMemberPath="DisplayText"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibilityConverter}}"
              />
            </StackPanel>
          </Border>

          <!--
            ミニマップ（キャンバス右下の浮きカード）: 図がビューポートに収まらないときだけ自動表示。
            エンティティ矩形＋リレーション線＋現在の表示範囲を示すビューポート枠を投影して描く（文字なし）。
            MouseDown/Move/Up は押下地点を視点中心へジャンプ＋ドラッグ追従させる（コードビハインド）。
          -->
          <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,12,12"
            Background="White"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            Visibility="{Binding IsMiniMapVisible, Converter={StaticResource BoolToVisibilityConverter}}"
          >
            <Border.Effect>
              <DropShadowEffect Color="#88AABB" BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <!-- 固定サイズの描画面。幅・高さは MainViewModel.MiniMapWidth/Height と一致させる -->
            <Border
              x:Name="MiniMapSurface"
              Width="200"
              Height="140"
              Background="#F7F9FC"
              BorderBrush="#E2E6EC"
              BorderThickness="1"
              CornerRadius="4"
              ClipToBounds="True"
              Cursor="Hand"
              MouseLeftButtonDown="MiniMap_MouseLeftButtonDown"
              MouseMove="MiniMap_MouseMove"
              MouseLeftButtonUp="MiniMap_MouseLeftButtonUp"
              LostMouseCapture="MiniMap_LostMouseCapture"
            >
              <Grid>
                <!-- リレーション線レイヤ -->
                <ItemsControl ItemsSource="{Binding MiniMapLines}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Line
                        X1="{Binding X1}"
                        Y1="{Binding Y1}"
                        X2="{Binding X2}"
                        Y2="{Binding Y2}"
                        Stroke="#9AA6B4"
                        StrokeThickness="0.7"
                      />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- エンティティ矩形レイヤ（タイトル背景色を反映） -->
                <ItemsControl ItemsSource="{Binding MiniMapEntities}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding X}" />
                      <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Fill="{Binding TitleBackgroundColor}"
                        Stroke="#7C8CA0"
                        StrokeThickness="0.5"
                      />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 現在の表示範囲を示すビューポート枠（半透明塗り＋枠線） -->
                <Canvas IsHitTestVisible="False">
                  <Rectangle
                    Canvas.Left="{Binding MiniMapViewport.X}"
                    Canvas.Top="{Binding MiniMapViewport.Y}"
                    Width="{Binding MiniMapViewport.Width}"
                    Height="{Binding MiniMapViewport.Height}"
                    Fill="#331A73E8"
                    Stroke="#1A73E8"
                    StrokeThickness="1"
                  />
                </Canvas>
              </Grid>
            </Border>
          </Border>
        </Grid>
      </Border>

      <!-- 右: プロパティパネル -->
      <Border
        Grid.Column="3"
        Background="{StaticResource SidebarBg}"
        BorderBrush="{StaticResource DividerBrush}"
        BorderThickness="1,0,0,0"
      >
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,10,12,12">
            <TextBlock
              Text="{x:Static resources:Strings.Property_Title}"
              FontWeight="Bold"
              Foreground="{StaticResource HeaderText}"
              Margin="0,0,0,10"
            />

            <Border>
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PropertyCard}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedEntity}" Value="{x:Null}" />
                        <Condition Binding="{Binding SelectedRelationship}" Value="{x:Null}" />
                        <!-- 複数選択中は一括操作カードが出るため未選択プレースホルダーは出さない -->
                        <Condition Binding="{Binding IsMultiSelectionActive}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock
                Style="{StaticResource PropertyHintText}"
                Text="{x:Static resources:Strings.Property_Placeholder}"
              />
            </Border>

            <!-- 単一選択時の詳細パネル: 主選択があり、かつ複数選択（2 個以上）でないときのみ表示 -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition
                          Binding="{Binding SelectedEntity, Converter={StaticResource NullToBooleanConverter}}"
                          Value="True"
                        />
                        <Condition Binding="{Binding IsMultiSelectionActive}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Border Style="{StaticResource PropertyCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                      Grid.Row="0"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_TableName}"
                    />
                    <TextBox
                      Grid.Row="0"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Style="{StaticResource PropertyInputTextBox}"
                      Text="{Binding SelectedEntity.TableName, UpdateSourceTrigger=LostFocus}"
                    />

                    <TextBlock
                      Grid.Row="2"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_Description}"
                    />
                    <TextBox
                      Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Style="{StaticResource PropertyInputTextBox}"
                      Text="{Binding SelectedEntity.Description, UpdateSourceTrigger=LostFocus}"
                      ToolTip="{x:Static resources:Strings.Property_DescriptionTooltip}"
                    />

                    <TextBlock
                      Grid.Row="4"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_TitleBackground}"
                    />
                    <ComboBox
                      Grid.Row="4"
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputComboBox}"
                      ItemsSource="{Binding EntityTitleColorOptions}"
                      SelectedValuePath="ColorHex"
                      SelectedValue="{Binding SelectedEntity.TitleBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    >
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <Border
                              Width="34"
                              Height="14"
                              CornerRadius="7"
                              Background="{Binding ColorHex}"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              Margin="0,0,8,0"
                            />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border
                      Grid.Row="4"
                      Grid.Column="2"
                      Width="36"
                      Height="24"
                      CornerRadius="6"
                      Background="{Binding SelectedEntity.TitleBackgroundColor}"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      Margin="10,5,0,5"
                      VerticalAlignment="Center"
                    />
                  </Grid>
                </Grid>
              </Border>

              <Border Style="{StaticResource PropertyCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Grid.Column="0"
                      Style="{StaticResource PropertyCardTitle}"
                      Text="{x:Static resources:Strings.Property_ColumnsHeader}"
                      Margin="0"
                      VerticalAlignment="Center"
                    />
                    <StackPanel
                      Grid.Column="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                    >
                      <Button
                        Style="{StaticResource PropertyIconButton}"
                        ToolTip="{x:Static resources:Strings.Property_AddColumnTooltip}"
                        Command="{Binding AddColumnCommand}"
                      >
                        <TextBlock
                          Text="+"
                          FontSize="16"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          TextAlignment="Center"
                        />
                      </Button>
                      <Button
                        Style="{StaticResource PropertyIconButton}"
                        ToolTip="{x:Static resources:Strings.Property_RemoveColumnTooltip}"
                        Command="{Binding RemoveSelectedColumnCommand}"
                      >
                        <TextBlock
                          Text="-"
                          FontSize="18"
                          FontWeight="Bold"
                          Margin="0,-2,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          TextAlignment="Center"
                        />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource PropertyHintText}"
                    Margin="0,0,0,0"
                    Text="{x:Static resources:Strings.Property_ReorderHint}"
                  />

                  <DataGrid
                    Grid.Row="3"
                    x:Name="ColumnsDataGrid"
                    Style="{StaticResource PropertyDataGrid}"
                    ItemsSource="{Binding SelectedEntity.Columns}"
                    SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    CanUserResizeRows="False"
                    CanUserAddRows="False"
                    VerticalAlignment="Stretch"
                    beh:DataGridRowReorderBehavior.IsEnabled="True"
                    beh:DataGridRowReorderBehavior.UndoRedoManager="{Binding UndoRedo}"
                  >
                    <DataGrid.InputBindings>
                      <KeyBinding
                        Key="C"
                        Modifiers="Control"
                        Command="{Binding CopySelectedColumnCommand}"
                      />
                      <KeyBinding
                        Key="V"
                        Modifiers="Control"
                        Command="{Binding PasteCopiedColumnCommand}"
                      />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="PK" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox
                              Style="{StaticResource PropertyDataGridCheckBox}"
                              IsChecked="{Binding IsPrimaryKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsPrimaryKeyEditable}"
                            />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="FK" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox
                              Style="{StaticResource PropertyDataGridCheckBox}"
                              IsChecked="{Binding IsForeignKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsForeignKeyEditable}"
                            />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="NULL" Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox
                              Style="{StaticResource PropertyDataGridCheckBox}"
                              IsChecked="{Binding IsNullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsNullableEditable}"
                            />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn
                        Header="{x:Static resources:Strings.Grid_ColumnName}"
                        Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                        Width="*"
                        ElementStyle="{StaticResource PropertyDataGridTextDisplay}"
                        EditingElementStyle="{StaticResource PropertyDataGridTextEditor}"
                      />
                      <DataGridTemplateColumn
                        Header="{x:Static resources:Strings.Grid_Type}"
                        Width="120"
                      >
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock
                              Text="{Binding DataType}"
                              VerticalAlignment="Center"
                              Margin="4,0"
                            />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                          <DataTemplate>
                            <ComboBox
                              Style="{StaticResource PropertyInputComboBox}"
                              IsEditable="True"
                              ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                            />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn
                        Header="{x:Static resources:Strings.Property_Description}"
                        Width="*"
                        Binding="{Binding Description, UpdateSourceTrigger=LostFocus}"
                        ElementStyle="{StaticResource PropertyDataGridTextDisplay}"
                        EditingElementStyle="{StaticResource PropertyDataGridTextEditor}"
                      />
                      <DataGridTemplateColumn Header="" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Button
                              Style="{StaticResource PropertyIconButton}"
                              ToolTip="{x:Static resources:Strings.Grid_RemoveColumnTooltip}"
                              Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                            >
                              <TextBlock
                                Text="-"
                                FontSize="18"
                                FontWeight="Bold"
                                Margin="0,-2,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                              />
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>

              <Border Style="{StaticResource PropertyCard}">
                <StackPanel>
                  <TextBlock
                    Style="{StaticResource PropertyCardTitle}"
                    Text="{x:Static resources:Strings.Property_Memo}"
                  />
                  <TextBox
                    Style="{StaticResource PropertyInputTextBox}"
                    Text="{Binding SelectedEntity.Memo, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="120"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                  />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 複数選択（2 個以上）時の一括操作パネル: 件数表示＋タイトル色一括変更＋一括削除 -->
            <StackPanel Visibility="{Binding IsMultiSelectionActive, Converter={StaticResource BoolToVisibilityConverter}}">
              <Border Style="{StaticResource PropertyCard}">
                <StackPanel>
                  <TextBlock
                    Style="{StaticResource PropertyCardTitle}"
                    Text="{Binding SelectedEntityCountText}"
                  />

                  <TextBlock
                    Style="{StaticResource PropertyFieldLabel}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Text="{x:Static resources:Strings.Property_BulkTitleBackground}"
                  />

                  <!-- 色パレット: スウォッチ押下で選択中全員の TitleBackgroundColor を一括変更 -->
                  <ItemsControl ItemsSource="{Binding EntityTitleColorOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                          Margin="0,0,8,8"
                          Padding="0"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          ToolTip="{Binding Label}"
                          Command="{Binding DataContext.BulkChangeTitleColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding ColorHex}"
                        >
                          <Border
                            Width="40"
                            Height="24"
                            CornerRadius="6"
                            Background="{Binding ColorHex}"
                          />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button
                    Margin="0,14,0,0"
                    Style="{StaticResource PropertyDangerButton}"
                    Content="{x:Static resources:Strings.Property_RemoveAllSelected}"
                    Command="{Binding RemoveSelectedEntityCommand}"
                  />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding SelectedRelationship, Converter={StaticResource NullToVisibilityConverter}}">
              <Border Style="{StaticResource PropertyCard}">
                <StackPanel DataContext="{Binding SelectedRelationship}">
                  <TextBlock
                    Style="{StaticResource PropertyCardTitle}"
                    Text="{x:Static resources:Strings.Property_RelationshipTitle}"
                  />

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="12" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                      Grid.Row="0"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_RelationType}"
                    />
                    <ComboBox
                      Grid.Row="0"
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputComboBox}"
                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    >
                      <models:RelationshipType>OneToOne</models:RelationshipType>
                      <models:RelationshipType>OneToMany</models:RelationshipType>
                      <models:RelationshipType>ManyToMany</models:RelationshipType>
                    </ComboBox>

                    <TextBlock
                      Grid.Row="2"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_ConstraintName}"
                    />
                    <TextBox
                      Grid.Row="2"
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputTextBox}"
                      Text="{Binding ConstraintName, UpdateSourceTrigger=LostFocus}"
                    />

                    <TextBlock
                      Grid.Row="4"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_SourceEndpoint}"
                    />
                    <TextBlock
                      Grid.Row="4"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource MutedText}"
                      Text="{Binding Source.TableName}"
                    />

                    <TextBlock
                      Grid.Row="6"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_ReferencedColumn}"
                    />
                    <ComboBox
                      Grid.Row="6"
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputComboBox}"
                      ItemsSource="{Binding AvailableSourceColumns}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SourceColumnId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanSelectForeignKeyColumns}"
                    />

                    <TextBlock
                      Grid.Row="8"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_TargetEndpoint}"
                    />
                    <TextBlock
                      Grid.Row="8"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource MutedText}"
                      Text="{Binding Target.TableName}"
                    />

                    <TextBlock
                      Grid.Row="10"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="{x:Static resources:Strings.Property_ForeignKeyColumn}"
                    />
                    <ComboBox
                      Grid.Row="10"
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputComboBox}"
                      ItemsSource="{Binding AvailableTargetColumns}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding TargetColumnId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanSelectForeignKeyColumns}"
                    />

                    <TextBlock
                      Grid.Row="12"
                      Style="{StaticResource PropertyFieldLabel}"
                      Text="ON DELETE"
                    />
                    <ComboBox
                      Grid.Row="12"
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputComboBox}"
                      ItemsSource="{Binding ReferentialActions}"
                      SelectedItem="{Binding OnDelete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanConfigureReferentialActions}"
                    />
                  </Grid>

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PropertyFieldLabel}" Text="ON UPDATE" />
                    <ComboBox
                      Grid.Column="1"
                      Style="{StaticResource PropertyInputComboBox}"
                      ItemsSource="{Binding ReferentialActions}"
                      SelectedItem="{Binding OnUpdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanConfigureReferentialActions}"
                    />
                  </Grid>

                  <Button
                    Margin="0,14,0,0"
                    Style="{StaticResource PropertyDangerButton}"
                    Content="{x:Static resources:Strings.Property_RemoveRelationship}"
                    Command="{Binding DataContext.RemoveSelectedRelationshipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>

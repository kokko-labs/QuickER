<Window
  x:Class="QuickER.CodeGen.UI.QueryDefinitionDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:res="clr-namespace:QuickER.CodeGen.UI.Resources"
  Title="{x:Static res:Strings.QueryDialog_WindowTitle}"
  Width="960"
  Height="720"
  MinWidth="820"
  MinHeight="560"
  ResizeMode="CanResizeWithGrip"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="#F5F7FA"
>
  <Window.Resources>
    <!-- ローカル定義（App レベルに依存せず単体でも動くように） -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- ── 配色 ── -->
    <SolidColorBrush x:Key="Accent" Color="#1A73E8" />
    <SolidColorBrush x:Key="AccentHover" Color="#1769D6" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#E5E7EB" />
    <SolidColorBrush x:Key="HeaderText" Color="#374151" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
    <SolidColorBrush x:Key="FieldBorder" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ErrorText" Color="#B91C1C" />
    <SolidColorBrush x:Key="OkText" Color="#15803D" />

    <!-- ── カード ── -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ── セクション見出し ── -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ── 項目ラベル ── -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── 入力欄（角丸・フォーカスでアクセント） ── -->
    <Style x:Key="FormInput" TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7"
            >
              <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 複数行入力欄 ── -->
    <Style x:Key="MultilineInput" TargetType="TextBox" BasedOn="{StaticResource FormInput}">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7"
            >
              <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 主要ボタン（アクセント） ── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{StaticResource AccentHover}"
                />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 副ボタン（白・枠線） ── -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{StaticResource FieldBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 行操作の小ボタン（追加・削除） ── -->
    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="30" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource HeaderText}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="18">
    <!-- フッタ -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock
        DockPanel.Dock="Left"
        VerticalAlignment="Center"
        Foreground="{StaticResource ErrorText}"
        TextWrapping="Wrap"
        Text="{Binding StatusMessage}"
      />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          Margin="0,0,8,0"
          IsDefault="True"
          Content="{x:Static res:Strings.QueryDialog_Ok}"
          Style="{StaticResource PrimaryButton}"
          Command="{Binding OkCommand}"
        />
        <Button
          Content="{x:Static res:Strings.QueryDialog_Cancel}"
          IsCancel="True"
          Style="{StaticResource SecondaryButton}"
          Command="{Binding CancelCommand}"
        />
      </StackPanel>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左ペイン: クエリ一覧（エンティティでグループ化） -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource SectionHeader}"
            Text="{x:Static res:Strings.QueryDialog_QueriesHeader}"
          />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button
              Margin="0,0,8,0"
              Content="{x:Static res:Strings.QueryDialog_Add}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding AddQueryCommand}"
            />
            <Button
              Content="{x:Static res:Strings.QueryDialog_Remove}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding RemoveQueryCommand}"
            />
          </StackPanel>
          <ListBox
            x:Name="QueryList"
            BorderThickness="0"
            Background="Transparent"
            ItemsSource="{Binding Queries}"
            SelectedItem="{Binding SelectedQuery}"
            HorizontalContentAlignment="Stretch"
          >
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4">
                  <TextBlock Text="{Binding GeneratedMethodName}" FontWeight="SemiBold" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock
                      Margin="0,8,0,2"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource MutedText}"
                      Text="{Binding Name}"
                    />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 右ペイン: 選択クエリのフォーム -->
      <Grid Grid.Column="1">
        <!-- 未選択時のプレースホルダ -->
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{StaticResource MutedText}"
          Text="{x:Static res:Strings.QueryDialog_NoSelection}"
        >
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedQuery}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <!-- 未選択時はフォームごと非表示にする（プレースホルダのみ残す。空フォームへの入力を防ぐ） -->
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedQuery}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <ContentControl Content="{Binding SelectedQuery}">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <StackPanel>
                  <!-- 基本情報 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource FieldLabel}"
                          Text="{x:Static res:Strings.QueryDialog_Entity}"
                        />
                        <ComboBox
                          Grid.Column="1"
                          DisplayMemberPath="TableName"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding EntityId}"
                          ItemsSource="{Binding DataContext.Entities, RelativeSource={RelativeSource AncestorType=Window}}"
                        />
                      </Grid>

                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource FieldLabel}"
                          Text="{x:Static res:Strings.QueryDialog_MethodName}"
                        />
                        <TextBox
                          Grid.Column="1"
                          Style="{StaticResource FormInput}"
                          Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        />
                      </Grid>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="1"
                          FontSize="11"
                          Foreground="{StaticResource MutedText}"
                        >
                          <Run Text="{x:Static res:Strings.QueryDialog_GeneratedNameLabel}" />
                          <Run
                            Text="{Binding GeneratedMethodName, Mode=OneWay}"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                          />
                        </TextBlock>
                      </Grid>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource FieldLabel}"
                          VerticalAlignment="Top"
                          Margin="0,7,0,0"
                          Text="{x:Static res:Strings.QueryDialog_Description}"
                        />
                        <TextBox
                          Grid.Column="1"
                          Style="{StaticResource MultilineInput}"
                          MinHeight="40"
                          Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- 実装方式（この画面の起点＝以降の項目の出し分けを決める） -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{x:Static res:Strings.QueryDialog_Implementation}"
                      />
                      <StackPanel Orientation="Horizontal">
                        <RadioButton
                          GroupName="Implementation"
                          Content="{x:Static res:Strings.QueryDialog_ImplDsl}"
                          IsChecked="{Binding ImplementationDsl}"
                        />
                        <RadioButton
                          GroupName="Implementation"
                          Content="{x:Static res:Strings.QueryDialog_ImplSql}"
                          IsChecked="{Binding ImplementationSql}"
                        />
                        <RadioButton
                          GroupName="Implementation"
                          Content="{x:Static res:Strings.QueryDialog_ImplManual}"
                          IsChecked="{Binding ImplementationManual}"
                        />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- 戻り値の型（スカラーは DSL では選べない＝生 SQL / 手動実装 専用） -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{x:Static res:Strings.QueryDialog_ReturnShape}"
                      />
                      <WrapPanel>
                        <RadioButton
                          GroupName="ReturnShape"
                          Content="{x:Static res:Strings.QueryDialog_ReturnList}"
                          IsChecked="{Binding ReturnsList}"
                        />
                        <RadioButton
                          GroupName="ReturnShape"
                          Content="{x:Static res:Strings.QueryDialog_ReturnSingle}"
                          IsChecked="{Binding ReturnsSingle}"
                        />
                        <RadioButton
                          GroupName="ReturnShape"
                          Content="{x:Static res:Strings.QueryDialog_ReturnCount}"
                          IsChecked="{Binding ReturnsCount}"
                        />
                        <RadioButton
                          GroupName="ReturnShape"
                          Content="{x:Static res:Strings.QueryDialog_ReturnScalar}"
                          IsChecked="{Binding ReturnsScalar}"
                          IsEnabled="{Binding CanSelectScalar}"
                        />
                        <RadioButton
                          GroupName="ReturnShape"
                          Content="{x:Static res:Strings.QueryDialog_ReturnProjection}"
                          IsChecked="{Binding ReturnsProjection}"
                        />
                      </WrapPanel>

                      <Grid
                        Margin="0,10,0,0"
                        Visibility="{Binding ShowScalarType, Converter={StaticResource BoolToVisibilityConverter}}"
                      >
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource FieldLabel}"
                          Text="{x:Static res:Strings.QueryDialog_ScalarType}"
                        />
                        <TextBox
                          Grid.Column="1"
                          Style="{StaticResource FormInput}"
                          Text="{Binding ScalarType, UpdateSourceTrigger=PropertyChanged}"
                        />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- 射影（戻り形＝射影のときのみ） -->
                  <Border
                    Style="{StaticResource Card}"
                    Visibility="{Binding ShowProjection, Converter={StaticResource BoolToVisibilityConverter}}"
                  >
                    <StackPanel>
                      <DockPanel>
                        <Button
                          DockPanel.Dock="Right"
                          Content="{x:Static res:Strings.QueryDialog_Add}"
                          Style="{StaticResource RowButton}"
                          Command="{Binding AddFieldCommand}"
                        />
                        <TextBlock
                          Style="{StaticResource SectionHeader}"
                          Text="{x:Static res:Strings.QueryDialog_Projection}"
                        />
                      </DockPanel>
                      <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource FieldLabel}"
                          Text="{x:Static res:Strings.QueryDialog_ResultTypeName}"
                        />
                        <TextBox
                          Grid.Column="1"
                          Style="{StaticResource FormInput}"
                          Text="{Binding ResultTypeName, UpdateSourceTrigger=PropertyChanged}"
                        />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{StaticResource FormInput}"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                              />
                              <ComboBox
                                Grid.Column="1"
                                Margin="0,0,6,0"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding SourceColumnId}"
                                ItemsSource="{Binding DataContext.AvailableColumnsWithNone, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              />
                              <TextBox
                                Grid.Column="2"
                                Margin="0,0,6,0"
                                Style="{StaticResource FormInput}"
                                IsEnabled="{Binding IsTypeEditable}"
                                Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                              />
                              <Button
                                Grid.Column="3"
                                Content="✕"
                                Style="{StaticResource RowButton}"
                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                              />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- パラメータ定義（全方式共通＝シグネチャに効く） -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel>
                        <Button
                          DockPanel.Dock="Right"
                          Content="{x:Static res:Strings.QueryDialog_Add}"
                          Style="{StaticResource RowButton}"
                          Command="{Binding AddParameterCommand}"
                        />
                        <TextBlock
                          Style="{StaticResource SectionHeader}"
                          Text="{x:Static res:Strings.QueryDialog_Parameters}"
                        />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{StaticResource FormInput}"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                              />
                              <!-- 型付けの参照元列（「なし」＝型トークンで手入力。列を選ぶと VO 有効時は VO 型の引数になる） -->
                              <ComboBox
                                Grid.Column="1"
                                Margin="0,0,6,0"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding SourceColumnId}"
                                ItemsSource="{Binding DataContext.AvailableColumnsWithNone, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              />
                              <TextBox
                                Grid.Column="2"
                                Margin="0,0,6,0"
                                Style="{StaticResource FormInput}"
                                IsEnabled="{Binding IsTypeEditable}"
                                Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                              />
                              <CheckBox
                                Grid.Column="3"
                                Margin="0,0,6,0"
                                Content="{x:Static res:Strings.QueryDialog_ParamIsList}"
                                IsChecked="{Binding IsList}"
                              />
                              <Button
                                Grid.Column="4"
                                Content="✕"
                                Style="{StaticResource RowButton}"
                                Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                              />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- 条件（簡易 DSL のときのみ） -->
                  <Border
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsDslImplementation, Converter={StaticResource BoolToVisibilityConverter}}"
                  >
                    <StackPanel>
                      <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{x:Static res:Strings.QueryDialog_Condition}"
                      />
                      <TextBox
                        Style="{StaticResource MultilineInput}"
                        FontFamily="Consolas, Cascadia Mono, monospace"
                        Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource OkText}"
                        Text="{x:Static res:Strings.QueryDialog_ConditionValid}"
                        Visibility="{Binding IsConditionValid, Converter={StaticResource BoolToVisibilityConverter}}"
                      />
                      <ItemsControl ItemsSource="{Binding ConditionDiagnostics}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock
                              Margin="0,2"
                              Foreground="{StaticResource ErrorText}"
                              TextWrapping="Wrap"
                              Text="{Binding}"
                            />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- 並び順（簡易 DSL のときのみ） -->
                  <Border
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsDslImplementation, Converter={StaticResource BoolToVisibilityConverter}}"
                  >
                    <StackPanel>
                      <DockPanel>
                        <Button
                          DockPanel.Dock="Right"
                          Content="{x:Static res:Strings.QueryDialog_Add}"
                          Style="{StaticResource RowButton}"
                          Command="{Binding AddOrderingCommand}"
                        />
                        <TextBlock
                          Style="{StaticResource SectionHeader}"
                          Text="{x:Static res:Strings.QueryDialog_OrderBy}"
                        />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding OrderBy}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <ComboBox
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding ColumnId}"
                                ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              />
                              <CheckBox
                                Grid.Column="1"
                                Margin="0,0,6,0"
                                Content="{x:Static res:Strings.QueryDialog_Descending}"
                                IsChecked="{Binding Descending}"
                              />
                              <Button
                                Grid.Column="2"
                                Content="✕"
                                Style="{StaticResource RowButton}"
                                Command="{Binding DataContext.RemoveOrderingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                              />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- SQL 入力欄（生 SQL のときのみ） -->
                  <Border
                    Style="{StaticResource Card}"
                    Visibility="{Binding ShowSqlEditors, Converter={StaticResource BoolToVisibilityConverter}}"
                  >
                    <StackPanel>
                      <TextBlock
                        Margin="0,0,0,4"
                        Foreground="{StaticResource MutedText}"
                        Text="{x:Static res:Strings.QueryDialog_SqlServerSql}"
                      />
                      <TextBox
                        Style="{StaticResource MultilineInput}"
                        FontFamily="Consolas, Cascadia Mono, monospace"
                        Text="{Binding SqlServerSql, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <TextBlock
                        Margin="0,10,0,4"
                        Foreground="{StaticResource MutedText}"
                        Text="{x:Static res:Strings.QueryDialog_SqliteSql}"
                      />
                      <TextBox
                        Style="{StaticResource MultilineInput}"
                        FontFamily="Consolas, Cascadia Mono, monospace"
                        Text="{Binding SqliteSql, UpdateSourceTrigger=PropertyChanged}"
                      />
                    </StackPanel>
                  </Border>

                  <!-- ページング（全方式共通＝シグネチャに効く） -->
                  <Border Style="{StaticResource Card}">
                    <CheckBox
                      Content="{x:Static res:Strings.QueryDialog_Paging}"
                      IsChecked="{Binding HasPaging}"
                    />
                  </Border>

                  <!-- メソッド定義プレビュー -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{x:Static res:Strings.QueryDialog_SignaturePreview}"
                      />
                      <Border
                        Background="#F9FAFB"
                        BorderBrush="{StaticResource Divider}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                      >
                        <TextBlock
                          FontFamily="Consolas, Cascadia Mono, monospace"
                          FontSize="12"
                          Foreground="{StaticResource HeaderText}"
                          TextWrapping="Wrap"
                          Text="{Binding SignaturePreview, Mode=OneWay}"
                        />
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>

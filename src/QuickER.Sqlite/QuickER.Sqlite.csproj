<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Microsoft.Data.Sqlite が推移的に持ち込む SQLitePCLRaw には既知の脆弱性
         (GHSA-2m69-gcr7-jv3q) があるため、修正済みの版（Directory.Packages.props）を明示参照して上書きする -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime.AspNetCore</PackageId>
    <Description>Runtime for C# code generated by QuickER (an ER diagram designer): the fixed server-side engine behind the generated remote endpoints (Minimal API mapping, error classification, error-detail exposure policy, binary streaming), serving the dialect-neutral remote contracts of QuickER.Runtime over ASP.NET Core.</Description>
    <PackageTags>quicker;runtime;repository;data-access;aspnetcore;remote;minimal-api</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- サーバー固定部は Minimal API（RouteGroupBuilder / HttpContext）・DI・ロギングを使うため ASP.NET Core を参照する。
       FrameworkReference は NuGet 依存ではなく共有フレームワークの参照のため、PackageReference はゼロのまま
       （DI・ロギング抽象も ASP.NET Core が推移的に持ち込む）。per-entity のエンドポイント（GeneratedRemoteEndpoints）・
       DI 登録はスキーマ依存物として生成側に出力されるため、本パッケージには入らない（依存排他ガードテストで検証） -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Runtime\QuickER.Runtime.csproj" />
  </ItemGroup>
</Project>

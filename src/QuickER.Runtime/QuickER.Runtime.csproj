<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 生成ソース（.g.cs）は using を明示するため ImplicitUsings は無効にする（暗黙 using との重複警告を避ける） -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet パッケージメタデータ。バージョンは Directory.Build.props の VersionPrefix に一元化 -->
    <IsPackable>true</IsPackable>
    <!-- パッケージ参照モードの利用者に IntelliSense 説明を届けるため XML ドキュメントを同梱する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickER.Runtime</PackageId>
    <Description>Runtime for C# code generated by QuickER (an ER diagram designer): the shared foundation, the dialect-neutral Repository contracts, and the HTTP client for the generated three-tier configuration. Depends only on the BCL.</Description>
    <PackageTags>quicker;runtime;repository;data-access;code-generation</PackageTags>
    <RepositoryUrl>https://github.com/kokko-labs/QuickER</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- シンボルは .snupkg として別パッケージで公開する（nuget.org のシンボルサーバが配信し、
         必要な利用者だけがデバッガ経由で取得する）。dll へ埋め込む方式は本体サイズと restore 時間を
         増やすため、ライブラリ設計ガイドの第一推奨に従ってこちらを採る。dotnet nuget push は
         対応する .snupkg を自動で同時に push する -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>quicker-icon-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None
      Include="../../assets/quicker-icon-128.png"
      Pack="true"
      PackagePath="quicker-icon-128.png"
      Visible="false"
    />
  </ItemGroup>
</Project>

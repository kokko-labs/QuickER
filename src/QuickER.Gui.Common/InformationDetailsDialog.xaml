<Window
  x:Class="QuickER.Gui.Common.InformationDetailsDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="640"
  Height="420"
  MinWidth="520"
  MinHeight="280"
  ResizeMode="CanResizeWithGrip"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="{DynamicResource WindowBackground}"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色・ボタンの共通スタイルは共有テーマ辞書から取り込む（同一アセンブリ内） -->
        <ResourceDictionary Source="pack://application:,,,/QuickER.Gui.Common;component/Themes/DialogTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ヘッダ: 情報／エラーを表すアイコンと要約メッセージ（アイコン色・記号はコードビハインドで設定） -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="HeaderIcon"
        Grid.Column="0"
        FontSize="18"
        VerticalAlignment="Top"
        Margin="0,0,8,0"
      />
      <TextBlock
        x:Name="MessageText"
        Grid.Column="1"
        TextWrapping="Wrap"
        VerticalAlignment="Center"
      />
    </Grid>

    <!-- 詳細: 読み取り専用・選択可能な一覧領域（横幅を広く取りコピー可能にする） -->
    <Border
      Grid.Row="1"
      BorderBrush="{StaticResource FieldBorder}"
      BorderThickness="1"
      Background="#FAFAFA"
    >
      <TextBox
        x:Name="DetailsText"
        IsReadOnly="True"
        BorderThickness="0"
        Background="Transparent"
        Padding="6,4"
        FontFamily="Consolas, Courier New"
        FontSize="12"
        AcceptsReturn="True"
        TextWrapping="NoWrap"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto"
      />
    </Border>

    <Button
      Grid.Row="2"
      Content="OK"
      MinWidth="88"
      HorizontalAlignment="Right"
      Margin="0,12,0,0"
      IsDefault="True"
      IsCancel="True"
      Style="{StaticResource PrimaryButton}"
      Click="OnOkClick"
    />
  </Grid>
</Window>

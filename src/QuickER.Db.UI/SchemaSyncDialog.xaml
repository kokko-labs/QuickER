<Window
  x:Class="QuickER.Db.UI.SchemaSyncDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:resources="clr-namespace:QuickER.Db.UI.Resources"
  Title="{x:Static resources:Strings.SchemaSync_Title}"
  Width="900"
  Height="600"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
  FontSize="13"
  Background="{DynamicResource WindowBackground}"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色・ボタン等の共通スタイルは共有テーマ辞書から取り込む -->
        <ResourceDictionary Source="pack://application:,,,/QuickER.Gui.Common;component/Themes/DialogTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="10">
    <!-- 上部ツールバー -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button
        Content="{x:Static resources:Strings.SchemaSync_Recalculate}"
        Margin="0,0,8,0"
        Padding="8,3"
        Style="{StaticResource SecondaryButton}"
        Command="{Binding RefreshCommand}"
      />
      <Button
        Content="{x:Static resources:Strings.SchemaSync_SelectAll}"
        Margin="0,0,4,0"
        Padding="8,3"
        Style="{StaticResource SecondaryButton}"
        Command="{Binding SelectAllCommand}"
      />
      <Button
        Content="{x:Static resources:Strings.SchemaSync_DeselectAll}"
        Margin="0,0,16,0"
        Padding="8,3"
        Style="{StaticResource SecondaryButton}"
        Command="{Binding DeselectAllCommand}"
      />
      <!-- 実行は肯定アクション＝アクセント（旧: 緑背景 #DCFCE7 直書き）。テーマの PrimaryButton へ統一 -->
      <Button
        Content="{x:Static resources:Strings.SchemaSync_Execute}"
        Padding="14,3"
        Style="{StaticResource PrimaryButton}"
        Command="{Binding ExecuteCommand}"
      />
    </StackPanel>

    <!-- 下部ステータス -->
    <Border
      DockPanel.Dock="Bottom"
      BorderBrush="{StaticResource Divider}"
      BorderThickness="0,1,0,0"
      Padding="0,6,0,0"
      Margin="0,8,0,0"
    >
      <DockPanel>
        <Button
          DockPanel.Dock="Right"
          Content="{x:Static resources:Strings.Common_Close}"
          MinWidth="80"
          Style="{StaticResource SecondaryButton}"
          Command="{Binding CloseCommand}"
          IsCancel="True"
        />
        <TextBlock
          Text="{Binding StatusMessage}"
          Foreground="{StaticResource HeaderText}"
          VerticalAlignment="Center"
          TextWrapping="Wrap"
        />
      </DockPanel>
    </Border>

    <!-- 中央: 差分リスト + プレビュー -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock
          DockPanel.Dock="Top"
          Text="{x:Static resources:Strings.SchemaSync_DiffList}"
          FontWeight="Bold"
          Margin="0,0,0,4"
        />
        <ListBox ItemsSource="{Binding DiffItems}" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <CheckBox
                  DockPanel.Dock="Left"
                  IsChecked="{Binding IsSelected}"
                  IsEnabled="{Binding IsSelectable}"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                />
                <TextBlock
                  Text="{Binding Kind}"
                  Width="110"
                  Foreground="{StaticResource MutedText}"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Text="{Binding Description}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center"
                />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#F3F4F6" />

      <DockPanel Grid.Column="2">
        <TextBlock
          DockPanel.Dock="Top"
          Text="{x:Static resources:Strings.SchemaSync_SqlPreview}"
          FontWeight="Bold"
          Margin="0,0,0,4"
        />
        <TextBox
          Text="{Binding ScriptPreview, Mode=OneWay}"
          IsReadOnly="True"
          FontFamily="Consolas, Courier New"
          FontSize="12"
          AcceptsReturn="True"
          TextWrapping="NoWrap"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
        />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

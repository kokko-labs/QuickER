<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 中立（既定）リソースのカルチャ＝英語。日本語は Strings.ja.resx サテライトで賦与する -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <!-- インプロセス MCP サーバー（HTTP/SSE）をホストするため ASP.NET Core を参照する -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    GitHub Copilot SDK は既定でビルド時に Copilot CLI を npm から取得してアプリ出力へ同梱するが、
    QuickER はユーザーがインストール済みの copilot 実行ファイルを PATH から検出して使う方針のため
    ダウンロードをオプトアウトする（ビルドのネットワーク依存と配布サイズ肥大を避ける）。
  -->
  <PropertyGroup>
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.42.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.11" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="OpenAI" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Mcp\QuickER.Mcp.csproj" />
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.Settings\QuickER.Settings.csproj" />
  </ItemGroup>

  <!--
    多言語リソース: Strings.resx（中立＝英語）と Strings.ja.resx（日本語サテライト）。
    厳密型アクセサ（Strings.Designer.cs）は VS 以外でも確実に通るよう手書きでチェックイン済み。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

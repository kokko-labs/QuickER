<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Microsoft.Data.SqlClient が推移的に持ち込む System.Security.Cryptography.Pkcs には既知の脆弱性
         (GHSA-846f-f764-76mx・GHSA-2fmv-rv2c-59x7) があるため、修正済みの版（Directory.Packages.props）を明示参照して上書きする -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickER.Model\QuickER.Model.csproj" />
    <ProjectReference Include="..\QuickER.CodeGen.CSharp\QuickER.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\QuickER.Provider\QuickER.Provider.csproj" />
  </ItemGroup>
</Project>

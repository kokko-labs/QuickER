{
  "stryker-config": {
    "project": "QuickER.Provider.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "additional-timeout": 300000,
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": ["json", "html", "progress", "cleartext"],
    "ignore-methods": ["*.ThrowIfNull", "*Exception.ctor"],
    "mutate": [
      "**/SyncPlanner.cs",
      "**/SchemaIds.cs",
      "**/LiveSchema.cs",
      "**/PostSyncSchema.cs",
      "**/SelectionContext.cs",
      "**/SelectionRule.cs",
      "**/SelectionWithdrawals.cs",
      "**/Withdrawal.cs",
      "**/ImplicitStepReason.cs",
      "**/PlanItemMark.cs",
      "**/ReaddPair.cs",
      "**/StepLowering.cs",
      "**/StepOrigin.cs",
      "**/StepPlan.cs",
      "**/SyncStep.cs"
    ]
  }
}

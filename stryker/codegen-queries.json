{
  "stryker-config": {
    "project": "QuickER.CodeGen.CSharp.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "additional-timeout": 120000,
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": ["json", "html", "progress", "cleartext"],
    "ignore-methods": ["*.ThrowIfNull", "*Exception.ctor"],
    "mutate": [
      "**/Queries/QueryConditionTypeChecker.cs",
      "**/Queries/QueryConditionCSharpEmitter.cs"
    ]
  }
}

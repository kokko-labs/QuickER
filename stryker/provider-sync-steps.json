      "**/TableRebuildRowidAlias.cs",
      "**/TableRebuildDialects.cs",
      "**/TableRebuildScheduler.cs",
      "**/AssessmentRules.TableRebuildsDroppingColumnAttributes.cs",
      "**/AssessmentRules.ForeignKeysLosingCandidateKeyByTableRebuild.cs"
    ]
  }
}

{
  "stryker-config": {
    "project": "QuickER.Provider.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "additional-timeout": 300000,
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": ["json", "html", "progress", "cleartext"],
    "ignore-methods": ["*.ThrowIfNull", "*Exception.ctor"],
    "mutate": [
      "**/SchemaIds.cs",
      "**/LiveSchema.cs",
      "**/PostSyncSchema.cs",
      "**/ImplicitStepReason.cs",
      "**/PlanItemMark.cs",
      "**/ReaddPair.cs",
      "**/StepOrigin.cs",
      "**/StepSections.cs",
      "**/SyncStep.cs",
      "**/ForeignKeyAddOrder.cs",
      "**/ForeignKeyPairOrder.cs",
      "**/Readds.cs",
      "**/RebuildDeclarations.AlteredColumns.cs",
      "**/RebuildDeclarations.AlteredKeyColumns.cs",
      "**/RebuildDeclarations.DivergingColumnChanges.cs",
      "**/RebuildDeclarations.DroppedPrimaryKeys.cs",
      "**/RebuildDeclarations.LostIndexes.cs",
      "**/RebuildDeclarations.UniquesReplacedByPrimaryKey.cs",
      "**/RebuildDeclarations.cs",
      "**/ScheduledStep.cs",
      "**/SelectedSteps.cs",
      "**/SequentialScheduler.cs",
      "**/StepOrder.cs",
      "**/UnreaddableConstraints.cs",
      "**/AssessmentFacts.cs",
      "**/AssessmentRule.cs",
      "**/PlanAssessment.cs",
      "**/StepPlanner.cs",
      "**/AssessmentRules.DetachedForeignKeysAtRisk.cs",
      "**/AssessmentRules.ImplicitUniqueConstraintDrops.cs",
      "**/AssessmentRules.LiveForeignKeysWithPostSyncTypeMismatch.cs",
      "**/AssessmentRules.cs",
      "**/AssessmentRules.AddedForeignKeysNotOnCandidateKey.cs",
      "**/AssessmentRules.DefaultsOnColumnTypeKindChange.cs",
      "**/AssessmentRules.DescriptionCharactersReplaced.cs",
      "**/AssessmentRules.SchemaQualifiedTableNames.cs",
      "**/AssessmentRules.SetDefaultOnNotNullColumns.cs",
      "**/AssessmentRules.SetNullForeignKeysOnNotNullColumns.cs",
      "**/AssessmentRules.SetNullOnNotNullLiveForeignKeys.cs",
      "**/AssessmentRules.UniqueConstraintDropsBreakingForeignKeys.cs",
      "**/ConstraintState.cs",
      "**/ConstraintIdentity.cs",
      "**/PlanWalk.cs",
      "**/WalkPosition.cs",
      "**/ForeignKeyStepNames.cs",
      "**/Refusals.cs",

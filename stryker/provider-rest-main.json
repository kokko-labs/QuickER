{
  "stryker-config": {
    "project": "QuickER.Provider.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "additional-timeout": 300000,
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": ["json", "html", "progress", "cleartext"],
    "ignore-methods": ["*.ThrowIfNull", "*Exception.ctor"],
    "mutate": [
      "**/*.cs",
      "!**/SyncPlanner.cs",
      "!**/SchemaIds.cs",
      "!**/LiveSchema.cs",
      "!**/PostSyncSchema.cs",
      "!**/SelectionContext.cs",
      "!**/SelectionRule.cs",
      "!**/SelectionWithdrawals.cs",
      "!**/Withdrawal.cs",
      "!**/SelectionState.cs",
      "!**/RemainingLiveConstraints.cs",
      "!**/SelectionRules.cs",
      "!**/SelectionRules.ChangesBreakingLiveDependents.cs",
      "!**/SelectionRules.DropsLeavingNoColumns.cs",
      "!**/SelectionRules.ForeignKeysWithPostSyncTypeMismatch.cs",
      "!**/SelectionRules.ItemsRequiringUnselected.cs",
      "!**/SelectionRules.RebuildsOfProtectedTables.cs",
      "!**/SelectionRules.SetNullForeignKeysOnNotNullColumns.cs",
      "!**/SelectionRules.TablesWithCollidingConstraintNames.cs",
      "!**/SelectionRules.TablesWithoutColumns.cs",
      "!**/ImplicitStepReason.cs",
      "!**/PlanItemMark.cs",
      "!**/ReaddPair.cs",
      "!**/StepLowering.cs",
      "!**/StepOrigin.cs",
      "!**/StepPlan.cs",
      "!**/SyncStep.cs",
      "!**/SchemaDiffService.cs",
      "!**/SchemaSignature.cs",
      "!**/DiagramMergeReconciler.cs",
      "!**/NameMatching.cs",
      "!**/SchemaDiff.cs",
      "!**/TableRebuildAttributeDetector.cs",
      "!**/CanonicalTypeToken.cs",
      "!**/SqlTypeText.cs",
      "!**/SqlComment.cs",
      "!**/SqlNameText.cs",
      "!**/DdlGeneratorBase.cs",
      "!**/DatabaseProviderRegistry.cs",
      "!**/SchemaTableEntry.cs",
      "!**/QueryParameterTypeResolver.cs"
    ]
  }
}
